        },
        {
          "feature": "4.\u65b0\u589e\u5e55\u540e\u82b1\u7d6e\n\u6211\u4eec\u8fd8\u65b0\u589e\u4e86\u4e00\u4e2a\u5c0f\u5f69\u86cb\u5267\u60c5\u4f9b\u5927\u5bb6\u4f53\u9a8c\uff0c\u6e38\u620f\u5168\u90e8\u901a\u5173\u540e\u53ef\u89e3\u9501\u89c2\u770b\uff0c\u770b\u770b\u6c5f\u534e\u53f7\u7684\u5927\u5bb6\u6700\u540e\u662f\u600e\u4e48\u590d\u76d8\u7684\u5427\uff01"
        }
