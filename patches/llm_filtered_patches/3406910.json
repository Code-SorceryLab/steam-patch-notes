        },
        {
          "feature": "\u73a9\u5bb6\u9700\u901a\u8fc7\u5f00\u7bb1\u5f00\u51fa\u5bf9\u5e94\u5361\u724c\uff08\u4e0d\u5305\u542b\u4ea4\u6613\u548c\u8d60\u9001\u83b7\u5f97\u7684\u5361\u724c\uff09\uff0c\u7b26\u5408\u4ee5\u4e0a\u6761\u4ef6\u5373\u53ef\u5151\u6362\u5bf9\u5e94\u6d3b\u52a8\u5468\u8fb9\u3002"
