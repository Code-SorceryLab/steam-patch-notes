        },
        {
          "feature": "\u5370\u7b7e\u8272\u7eb8\u5151\u6362\u6761\u4ef61\uff1a\u5728\u6d3b\u52a8\u671f\u95f4\u5185\uff0c\u73a9\u5bb6\u5f00\u7bb1\u5f00\u51fa\u5bf9\u5e94\u89d2\u8272\u52a8\u7269\u91d1\uff08\u666e\u901a\uff09\u6216\u52a8\u7269\u91d1(\u6ce2\u7eb9) ,\u4e14\u6309\u7167\u62a5\u540d\u65f6\u95f4\u6700\u65e9\u83b7\u5f97\u5bf9\u5e94\u89d2\u8272\u5361\u724c\u7684\u524d30\u540d\u3002"
