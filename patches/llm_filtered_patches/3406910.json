        {
          "feature": "\u5151\u6362\u6761\u4ef62\uff1a\u5728\u6d3b\u52a8\u671f\u95f4\u5185\uff0c\u73a9\u5bb6\u5f00\u7bb1\u5f00\u51fa\u5bf9\u5e94\u89d2\u82721 \u5f20\u95ea\u5361(\u666e\u901a) \u6216 1\u5f20\u95ea\u5361(\u6ce2\u7eb9)\u62161\u5f20\u4e92\u52a8\u5361(\u666e\u901a) \u6216 1\u5f20\u4e92\u52a8\u5361(\u6ce2\u7eb9)\uff0c\u4e14\u62a5\u540d\u6392\u540d\u5728\u7b2c21\u53ca\u4e4b\u540e\u7684\u6392\u540d\u5151\u63621\u5f20\u5370\u7b7e\u5468\u8fb9\u3002"
        },
        {
          "feature": "\u5168\u5bb6\u798f\u8272\u7eb8 \u5151\u6362\u6761\u4ef6\uff1a \u5728\u6d3b\u52a8\u671f\u95f4\u5185\uff0c\u73a9\u5bb6\u5f00\u7bb1\u5f00\u51fa 1 \u5f20\u52a8\u7269\u94f6\u5361(\u6ce2\u7eb9) \u6216 1\u5f20\u52a8\u7269\u94f6\u5361(\u666e\u901a)\uff0c\u4e14\u6309\u7167\u62a5\u540d\u65f6\u95f4\u6700\u65e9\u83b7\u5f97\u5bf9\u5e94\u89d2\u8272\u5361\u724c\u7684\u524d100\u540d\u3002"
