          "feature": "\u6218\u4e2d\u7f16\u961f\u5982\u679c\u6ca1\u6709\u5b9e\u9645\u8c03\u6574\u961f\u4f0d\u5219\u4e0d\u7a7a\u8fc7\u56de\u5408\uff08\u6307\u6211\u65b9\u672c\u56de\u5408\u65e0\u4efb\u4f55\u64cd\u4f5c\u6328\u6253\u4e00\u56de\u5408\uff09"
        }
      ]
