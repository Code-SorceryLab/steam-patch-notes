        },
        {
          "feature": "\u201c\u6863\u6848\u201d\u529f\u80fd\u5185\uff0c\u66f4\u65b0\u90e8\u5206\u82b1\u7d6e\u89c6\u9891\u3002"
        },
        {
          "feature": "\u66f4\u65b0\u81f3\u6700\u65b0\u7248\u672c\u540e\uff0c\u9996\u6b21\u767b\u5f55\u5c06\u4f1a\u83b7\u5f9750\u4e2a\u80fd\u91cf\u9053\u5177\uff0c\u9053\u5177\u81ea\u52a8\u53d1\u653e\u3002"
