      "date": "2024-10-22 21:44:15",
      "url": "https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/6212245217911773837",
      "content": "[h3]\u70b9\u5230\u5373\u6b62\u8bf4\u8bf4\u524d\u4f20\u5427[/h3]\n\n\u201c\u987e\u6613\u201d\u4ed6\u53c8\u56de\u6765\u4e86\uff0c2023\u5e74\u5e74\u5e95\u81f3\u4eca\uff0c\u4f5c\u4e3a\u201c\u987e\u6613\u201d\u7684\u4f60\u4ee5\u53ca\u4f60\u5728\u201c\u5b8c\u86cb\u201d\u4e2d\u7684\u8eab\u8fb9\u4eba\uff0c\u662f\u4e00\u4e2a\u88ab\u4e92\u8054\u7f51\u63d0\u53ca\u8d85\u8fc724\u4ebf\u6b21\u7684\u6545\u4e8b\u3002\u800c\u8fd9\u4e00\u6b21\uff0c\u6211\u4eec\u56de\u5230\u6545\u4e8b\u7684\u8d77\u70b9\uff0c\u5bfb\u627e\u201c\u6d88\u5931\u5728\u6ca1\u843d\u4eba\u6d77\u201d\uff0c\u201c\u8bb0\u5fc6\u91cc\u6a21\u7cca\u7684\u8eab\u5f71\u201d\u4ee5\u53ca\u90a3\u4e9b\u201c\u8f6c\u8eab\u800c\u9519\u8fc7\u7684\u4eba\u201d\u3002\n\n\u6211\u4e00\u76f4\u89c9\u5f97\u201c\u524d\u4f20\u201d\u662f\u7ea2\u73ab\u7470\u4e0e\u767d\u73ab\u7470\u7684\u6545\u4e8b\uff0c\u56db\u4f4d\u6027\u683c\u8fe5\u5f02\u7684\u7ea2\u73ab\u7470\uff0c\u968f\u7740\u548c\u987e\u6613\u7684\u6df1\u5165\u4ea4\u5f80\uff0c\u5728\u7231\u4e2d\u9010\u6b65\u7099\u70ed\uff0c\u8868\u8fbe\u7231\u610f\uff1b\u4e00\u4f4d\u8f6c\u8eab\u9519\u8fc7\uff0c\u5c31\u60f3\u518d\u89c1\u4e00\u9762\u7684\u4eba\uff0c\u5982\u6708\u4e0b\u7684\u767d\u73ab\u7470\uff0c\u8ba9\u201c\u987e\u6613\u201d\u6267\u7740\u5728\u56de\u5fc6\u4e0e\u65f6\u95f4\u4e4b\u4e2d\u3002\u8fd9\u6b21\u4f5c\u4e3a\u201c\u987e\u6613\u201d\u7684\u4f60\u5c06\u5982\u4f55\u9009\u62e9\uff0c\u8d70\u51fa\u81ea\u5df1\u7684\u8bb0\u5fc6\u3002\n\n\u524d\u4f20\u4f5c\u4e3a\u7cfb\u5217\u7684\u8d77\u70b9\u53c8\u4e0e\u5929\u6d25\u7bc7\u3001\u53a6\u95e8\u7bc7\u6709\u5404\u81ea\u7684\u5173\u8054\uff0c\u5305\u62ec\u4e00\u4e9b\u4e00\u76f4\u4ee5\u6765\u6211\u4eec\u8bef\u89e3\u7684\u5bd3\u610f\uff0c\u8fd9\u6b21\u90fd\u4f1a\u6709\u98a0\u8986\u6027\u7684\u89e3\u8bfb\u3002\u5982\u679c\u4f60\u80fd\u8fde\u8d77\u6765\u770b\uff0c\u4f1a\u5bf9\u6574\u4e2a\u201c\u5b8c\u86cb\u201d\u7684\u6545\u4e8b\u6709\u65b0\u7684\u8ba4\u8bc6\uff0c\u5bf9\u201c\u987e\u6613\u201d\u6709\u65b0\u7684\u8ba4\u8bc6\uff0c\u4ed6\u771f\u7684\u4e0d\u662f\u5e9f\u7269\uff0c\u800c\u662f\u201c\u5e78\u8fd0\u7684\u5927\u591a\u6570\u201d\u3002\n\n\u8fd9\u6b21\u524d\u4f20\u4e5f\u5c1d\u8bd5\u4e86\u5f88\u591a\u7cfb\u7edf\u548c\u73a9\u6cd5\u3002\u5728\u4e00\u4e9b\u73a9\u6cd5\u4e2d\uff0c\u4e0d\u540c\u7684\u7ed3\u679c\u4f1a\u6709\u4e0d\u540c\u7684\u53cd\u9988\uff0c\u4e5f\u80fd\u89e6\u53d1\u4e0d\u540c\u7684\u8def\u7ebf\u548c\u7ed3\u679c\uff1b\u800c\u9053\u5177\u7cfb\u7edf\u7684\u52a0\u5165\uff0c\u4f1a\u5de6\u53f3\u5f88\u591a\u8def\u7ebf\u7684\u8fdb\u7a0b\uff0c\u9700\u8981\u8c28\u614e\u9009\u62e9\u3002\u7ed3\u5c40\u53ef\u80fd\u4e0d\u4f1a\u90fd\u90a3\u4e48\u5b8c\u7f8e \uff0c\u53ef\u8fd9\u5c31\u662f\u4f60\u6211\u7684\u9752\u6625\u554a\u3002\u53ea\u8981\u8bb0\u4f4f\u7b11\u656c\u8fc7\u5f80\uff0c\u4f60\u522b\u54ed\u554a\u3002\n\n[h3]\u5c55\u5f00\u8bf4\u8bf4\u8fd9\u4e00\u5e74[/h3]\n\n\u6709\u5f88\u591a\u670b\u53cb\u8bf4\uff0c10\u670818\u65e5\u4e00\u5468\u5e74\u600e\u4e48\u6ca1\u529e\u7eaa\u5ff5\u3002\u786e\u5b9e\u4e00\u5468\u5e74\u7684\u65f6\u5019\uff0c\u5b98\u65b9\u6ca1\u6709\u7279\u610f\u53bb\u53d1\u5e03\u4e00\u4e9b\u7eaa\u5ff5\u3002\u56e0\u4e3a\u6211\u4eec\u89c9\u5f97\u53ea\u8981\u76f8\u9047\uff0c\u6bcf\u4e00\u5929\u90fd\u662f\u7eaa\u5ff5\u65e5\u3002\u8fd9\u4e00\u5e74\u6240\u505a\u7684\u6240\u6709\u52aa\u529b\uff0c\u90fd\u662f\u8ba9\u6211\u4eec\u672a\u6765\u80fd\u4e00\u76f4\u76f8\u9047\uff0c\u4e0d\u4e00\u5b9a\u662f\u5728\u201c\u5b8c\u86cb\u201d\u7cfb\u5217\uff0c\u8fd8\u53ef\u80fd\u662f\u5728\u201c\u5c0f\u6709\u5185\u5bb9\uff08intiny\uff09\u201d\u7684\u66f4\u591a\u771f\u4eba\u4e92\u52a8\u5f71\u50cf\u4ea7\u54c1\u4e2d\u76f8\u9047\u3002\n\n\u8fd9\u4e00\u5e74\uff0c\u6211\u4eec\u5b8c\u6210\u4e86\u5168\u5e73\u53f0\u4e0a\u7ebf\uff0c\u5728\u56fd\u5185\u6765\u8bf4\u80fd\u4e0a\u5168\u5e73\u53f0\u7684\u4ea7\u54c1\u4e0d\u591a\u3002\u65f6\u4ee3\u7ed9\u4e86\u6211\u4eec\u8fd9\u4e2a\u673a\u9047\uff0c\u6211\u4eec\u4e5f\u4f1a\u73cd\u60dc\u8fd9\u4e2a\u673a\u9047\u6765\u63a2\u7d22\u201c\u771f\u4eba\u4e92\u52a8\u5f71\u50cf\u201d\u4ea7\u54c1\u7684\u66f4\u591a\u53ef\u80fd\uff1a\u8fd9\u4e00\u5e74\uff0c\u6211\u4eec\u505a\u4e86\u65e5\u8bed\u914d\u97f3\u7248\uff0c\u4e00\u65b9\u9762\u662f\u6211\u4eec\u5728\u6d77\u5916\u7684\u4e00\u79cd\u5c1d\u8bd5\uff0c\u53e6\u4e00\u65b9\u9762\u4e5f\u662f\u6211\u4eec\u5728\u6d77\u5916\u7684\u8fdb\u4e00\u6b65\u63a2\u7d22\uff0c\u76f8\u4fe1\u672a\u6765\u4f1a\u6709\u66f4\u591a\u60ca\u559c\u7ed9\u5230\u5927\u5bb6\uff1b\u8fd9\u4e00\u5e74\uff0c\u6211\u4eec\u4e5f\u6709\u5f88\u591a\u65b0\u9879\u76ee\uff0c\u5728\u5408\u9002\u7684\u65f6\u95f4\uff0c\u90fd\u5c06\u4f1a\u4e0e\u5927\u5bb6\u89c1\u9762\uff1b\u8fd9\u4e00\u5e74\uff0c\u6211\u4eec\u83b7\u5f97\u4e86steam\u5e74\u5ea6\u6700\u4f73\u5267\u60c5\u5956\u63d0\u540d\uff0c\u8fd9\u662f\u6700\u9b54\u5e7b\u7684\u4e00\u96c6\u3002\u8fd8\u597d\u6211\u4eec\u81ea\u77e5\u4e4b\u660e\uff0c\u6211\u4eec\u4f9d\u7136\u662f\u90a3\u4e2a\u5e78\u8fd0\u513f\u4e86\uff0c\u5f97\u5230\u4e86\u8fd9\u4e48\u591a\u4eba\u7684\u652f\u6301\uff1b\u8fd9\u4e00\u5e74\uff0c\u8fd8\u53d1\u751f\u4e86\u5f88\u591a\u5f88\u591a\u6545\u4e8b\uff0c\u5bf9\u4e8e\u6211\u4eec\u6765\u8bf4\uff0c\u524d\u4f20\u4e5f\u662f\u5bf9\u6211\u4eec\u81ea\u5df1\u7684\u201c\u656c\u8fc7\u5f80\u201d\u3002\n\n[h3]\u798f\u5229\u4e0e\u66f4\u65b0[/h3]\n\n\u8fd9\u6b21\u524d\u4f20\u9996\u53d1\uff0c\u4f1a\u6709\u8d85\u7ea7\u591a\u7684\u798f\u5229\u6d3b\u52a8\uff0c\u4e00\u5b9a\u8981\u5173\u6ce8\u6211\u4eec\u7684\u5b98\u65b9\u81ea\u5a92\u4f53\uff0c\u4e86\u89e3\u7b2c\u4e00\u624b\u4fe1\u606f\u3002\n\n\u66f4\u65b0\u4f1a\u5728\u524d\u671f\u6bd4\u8f83\u9891\u7e41\uff0c\u4e00\u4e9b\u5c0fBUG\u548c\u4f18\u5316\u4f1a\u4e00\u76f4\u66f4\u65b0\uff1b\u7136\u540e\u662f2K\u7248\u672c\u7684\u66f4\u65b0\u4e5f\u4f1a\u5728\u8fd1\u671f\u4e0a\u7ebf\uff0c\u63a5\u7740\u5c31\u662f\u591a\u8bed\u8a00\u5b57\u5e55\u4f1a\u9010\u6b65\u66f4\u65b0\uff0c\u65b9\u4fbf\u6e2f\u6fb3\u4ee5\u53ca\u4e2d\u56fd\u53f0\u6e7e\u7701\u7684\u7e41\u4f53\u533a\u670b\u53cb\u4ee5\u53ca\u6d77\u5916\u7684\u591a\u8bed\u8a00\u670b\u53cb\u3002\u603b\u4e4b\u6211\u4eec\u5148\u4e0a\u7ebf\uff0c\u8be5\u6709\u7684\u90fd\u4f1a\u6709\u3002\n\n[h3]\u6700\u540e\u5570\u55e6\u4e0b[/h3]\n\n1\u3001\u8fd9\u6b21\u7565\u5fae\u4e0a\u6da8\u4e863\u5757\u94b1\uff0c\u539f\u56e0\u662f\u5236\u4f5c\u6210\u672c\u771f\u7684\u5f88\u9ad8\uff08\u522b\u8001\u8bf4\u6709\u4eba\u6253\u94b1\u4e86\uff0c\u8fd9\u79cd\u54c1\u724c\u8054\u52a8\u662f\u53cc\u65b9\u90fd\u6ca1\u94b1\u7684\uff0c\u61c2\u5f97\u90fd\u61c2\uff09\u3002\u4e0d\u8fc7\u9996\u53d1\u6298\u6263\u540e\uff0c\u8fd8\u662f\u4ea4\u4e2a\u670b\u53cb\u3002\u4e00\u5f20\u7535\u5f71\u7968\u7684\u5b9a\u4f4d\u4f9d\u65e7\u6ca1\u6709\u53d8\u3002\n\n2\u3001\u611f\u8c22\u4e00\u5e74\u6765\u5927\u5bb6\u7684\u652f\u6301\u4e0e\u539a\u7231\uff0c\u611f\u8c22\u90a3\u4e9b\u4e0d\u65ad\u4e3a\u201c\u5b8c\u86cb\u201d\u6b63\u540d\u7684\u670b\u53cb\u4eec\uff0c\u56fd\u5185\u505a\u771f\u4eba\u4e92\u52a8\u5f71\u50cf\u4ea7\u54c1\u7684\u4eba\u7edd\u5927\u591a\u6570\u90fd\u4e0d\u662f\u5728\u505a\u64e6\u8fb9\u4f4e\u52a3\u7684\u4ea7\u54c1\uff0c\u800c\u662f\u5728\u4e0d\u65ad\u63a2\u7d22\u548c\u8fdb\u6b65\u3001\u4f18\u5316\u4e0e\u8c03\u6574\uff0c\u6240\u6709\u4ece\u4e1a\u8005\u90fd\u60f3\u505a\u51fa\u6765\u4e00\u6b3e\u5927\u5bb6\u8ba4\u53ef\u7684\u4ea7\u54c1\u3002\u4e3a\u6240\u6709\u5728\u8fd9\u6761\u9053\u8def\u4e0a\u63a2\u7d22\u7684\u540c\u4ec1\u4eec\u81f4\u656c\u3002\u5e0c\u671b\u6765\u5e74\uff0c\u6211\u4eec\u771f\u7684\u5728\u5377\u5185\u5bb9\uff0c\u8ba9\u8fd9\u4e2a\u8d5b\u9053\u8d8a\u53d1\u5bbd\u9614\u3002\n\u597d\u5566\uff0c\u51c6\u5907\u5f00\u59cb\u8fd9\u6bb5\u524d\u4f20\u7684\u6545\u4e8b\u5427\u3002\n\u7b11\u656c\u8fc7\u5f80\uff0c\u4f60\u522b\u54ed\u554a\u3002",
      "key": "3099660::03b956717dc8b5b2a9a51d8333ba1e3a3306763b",
      "tags": [
        {
          "feature": "\u8fd9\u6b21\u524d\u4f20\u4e5f\u5c1d\u8bd5\u4e86\u5f88\u591a\u7cfb\u7edf\u548c\u73a9\u6cd5\u3002\u5728\u4e00\u4e9b\u73a9\u6cd5\u4e2d\uff0c\u4e0d\u540c\u7684\u7ed3\u679c\u4f1a\u6709\u4e0d\u540c\u7684\u53cd\u9988\uff0c\u4e5f\u80fd\u89e6\u53d1\u4e0d\u540c\u7684\u8def\u7ebf\u548c\u7ed3\u679c\uff1b\u800c\u9053\u5177\u7cfb\u7edf\u7684\u52a0\u5165\uff0c\u4f1a\u5de6\u53f3\u5f88\u591a\u8def\u7ebf\u7684\u8fdb\u7a0b\uff0c\u9700\u8981\u8c28\u614e\u9009\u62e9\u3002"
        },
        {
          "feature": "\u8fd9\u4e00\u5e74\uff0c\u6211\u4eec\u5b8c\u6210\u4e86\u5168\u5e73\u53f0\u4e0a\u7ebf\uff0c\u5728\u56fd\u5185\u6765\u8bf4\u80fd\u4e0a\u5168\u5e73\u53f0\u7684\u4ea7\u54c1\u4e0d\u591a\u3002"
        },
        {
          "feature": "\u8fd9\u4e00\u5e74\uff0c\u6211\u4eec\u505a\u4e86\u65e5\u8bed\u914d\u97f3\u7248\uff0c\u4e00\u65b9\u9762\u662f\u6211\u4eec\u5728\u6d77\u5916\u7684\u4e00\u79cd\u5c1d\u8bd5\uff0c\u53e6\u4e00\u65b9\u9762\u4e5f\u662f\u6211\u4eec\u5728\u6d77\u5916\u7684\u8fdb\u4e00\u6b65\u63a2\u7d22\uff0c\u76f8\u4fe1\u672a\u6765\u4f1a\u6709\u66f4\u591a\u60ca\u559c\u7684\u5230\u5927\u5bb6\uff1b"
        },
        {
          "bug": "\u66f4\u65b0\u4f1a\u5728\u524d\u671f\u6bd4\u8f83\u9891\u7e41\uff0c\u4e00\u4e9b\u5c0fBUG\u548c\u4f18\u5316\u4f1a\u4e00\u76f4\u66f4\u65b0\uff1b"
        },
        {
          "feature": "\u63a5\u7740\u5c31\u662f\u591a\u8bed\u8a00\u5b57\u5e55\u4f1a\u9010\u6b65\u66f4\u65b0\uff0c\u65b9\u4fbf\u6e2f\u6fb3\u4ee5\u53ca\u4e2d\u56fd\u53f0\u6e7e\u7701\u7684\u7e41\u4f53\u533a\u670b\u53cb\u4ee5\u53ca\u6d77\u5916\u7684\u591a\u8bed\u8a00\u670b\u53cb\u3002"
        }
      ]
    }
  ]
}