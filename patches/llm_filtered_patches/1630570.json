        },
        {
          "feature": "3.\u5bf9\u7d20\u6750\u6f14\u51fa\u6548\u679c\u4e5f\u8fdb\u884c\u4e86\u53cd\u590d\u786e\u8ba4\u4e0e\u91cd\u65b0\u7f16\u6392\uff0c\u4f7f\u4ee5\u4e0a\u4fee\u6539\u90fd\u5bf9\u6574\u90e8\u4f5c\u54c1\u5728\u8868\u73b0\u529b\u4e0a\u7efc\u5408\u8d77\u6765\u90fd\u6709\u4e86\u5f88\u5927\u63d0\u5347."
        },
        {
          "feature": "4.\u589e\u52a0\u4e861\u5f20CG\uff0c\u611f\u8c22\u753b\u5e08@\u7acb\u82b1\u7206\u7206\u6d46 \u7684\u4f5c\u56fe\u4e0e\u65e0\u507f\u8d21\u732e."
        }
