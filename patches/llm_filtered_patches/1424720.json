    {
      "title": "Dear\u58a8\u6b66\u8005\u4eec\uff1a\u60a8\u6709\u4e00\u4efd\u66f4\u65b0\u8bf7\u67e5\u6536\uff01",
      "date": "2020-11-29 22:53:12",
      "url": "https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/3856733252019152045",
      "content": "\u66f4\u65b0\u65e5\u5fd7\u5982\u4e0b\uff1a\n1.\u91cd\u65b0\u5236\u4f5c\u66ff\u6362\u4e86\u6574\u4f53\u7684UI\n2.\u589e\u52a0\u7247\u5934\u52a8\u753b\u300a\u58a8\u5fc3\u4f20\u8bf4\u300b\n3.\u4f18\u5316\u66ff\u6362\u4e86\u90e8\u5206\u7d20\u6750\n4.\u4f18\u5316\u4e86\u90e8\u5206\u6f14\u51fa\u6548\u679c\u548c\u6587\u5b57\n5.\u4fee\u590d\u4e86\u6545\u4e8b\u7ebf\u754c\u9762\u90e8\u5206\u8282\u70b9\u548c\u8fde\u7ebf\u663e\u793a\u9519\u8bef\u7684\u95ee\u9898\n6.\u4fee\u590d\u4e86\u91cd\u590d\u8f7d\u5165\u53ef\u80fd\u5bfc\u81f4\u56fe\u7247\u5c55\u793a\u9519\u8bef\u7684\u95ee\u9898\n7.\u4fee\u590d\u4e86\u9057\u843d\u4e4b\u8ff9\u70b9\u51fb\u53ef\u80fd\u672a\u88ab\u7edf\u8ba1\u7684\u95ee\u9898\n8.\u4fee\u590d\u4e86\u90e8\u5206\u597d\u611f\u5ea6\u7edf\u8ba1\u5224\u65ad\u53ef\u80fd\u51fa\u9519\u7684\u95ee\u9898\n9.\u4fee\u590d\u4e86\u67d0\u4e9b\u60c5\u51b5\u5f00\u573a\u97f3\u4e50\u53ef\u80fd\u64ad\u653e\u9519\u8bef\u7684\u95ee\u9898\n\n\u9664\u6b64\u4e4b\u5916\uff0c\u201c\u5df2\u8bfb\u5feb\u8fdb\u201d\u529f\u80fd\u4e5f\u5728\u5f00\u53d1\u4e2d\uff0c\u7b2c\u4e94\u7ae0&\u300a\u5979\u7684\u6545\u4e8b\u300b\u7684\u5236\u4f5c\u4e5f\u5c31\u5feb\u597d\u4e86\uff0c\u5c06\u4e8e\u8fd1\u671f\u5448\u4e0a\uff01",
