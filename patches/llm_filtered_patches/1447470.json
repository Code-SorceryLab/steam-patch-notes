        },
        {
          "feature": "\u6280\u80fd\u63cf\u8ff0\u66f4\u65b0\u4e3a\uff1a\u9526\u9a6c\u8d85\u5a01\u9707\u897f\u51c9\uff0c\u81ea\u5df1\u6574\u573a\u6218\u6597\u4e2d\u666e\u653b\u90fd\u80fd\u9020\u6210\u6e85\u5c04\u6548\u679c\u3002\u7f8c\u4eba\u5c06\u5176\u5949\u4e3a\u201c\u795e\u5a01\u5929\u5c06\u519b\u201d\uff0c\u81ea\u8eab\u514d\u75ab\u6d41\u8840\uff0c\u4f46\u5168\u7a0b\u7981\u7597\u72b6\u6001\u65e0\u6cd5\u6062\u590d\u5175\u529b"
        }
      ]
