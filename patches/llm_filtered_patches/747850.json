          "feature": "2.\u795e\u5668\u7cfb\u7edf\uff0c\u795e\u5668\u5c06\u4e0d\u518d\u662f\u6446\u8bbe\uff0c\u5c06\u4f1a\u662f\u6574\u4e2a\u6e38\u620f\u7684\u6838\u5fc3\u73a9\u6cd5\uff0c\u627f\u8f7d\u4e86\u6574\u4e2a\u6e38\u620f\u7684\u4e3b\u7ebf\u4efb\u52a1\u7ebf\uff0c\u800c\u4e14\u4f1a\u6302\u8f7d\u79d1\u6280\u7ebf\u548c\u6280\u80fd\u7ebf\uff1a\u7814\u7a76\u79d1\u6280\u7ebf\u9700\u8981\u4f7f\u7528\u7814\u7a76\u70b9\uff0c\u7814\u7a76\u70b9\u901a\u8fc7\u7814\n\n\u7a76\u6240\u7814\u7a76\u7269\u54c1\u83b7\u5f97\u3002\u6280\u80fd\u7ebf\u9700\u8981\u7528\u5230\u795d\u798f\u70b9\u6570\uff0c\u5728\u6696\u6696\u6751\u505a\u4e00\u5207\u4e8b\uff08\u6536\u83dc\uff0c\u9493\u9c7c\uff0c\u6253\u602a\uff0c\u5236\u4f5c\u7269\u54c1\uff0c\u52a0\u5de5\u7269\u54c1\u7b49\u7b49\uff09\u90fd\u4f1a\u83b7\u5f97\u795d\u798f\u7ecf\u9a8c\uff0c\u795d\u798f\u7ecf\u9a8c\u6ee1\u8db3\u7b49\u7ea7\u63d0\u5347\u4ee5\u540e\u4f1a\u83b7\n\n\u5f97\u795d\u798f\u70b9\u6570\uff0c\u4f7f\u7528\u795d\u798f\u70b9\u6570\u53ef\u4ee5\u6fc0\u6d3b\u81ea\u5df1\u60f3\u8981\u6fc0\u6d3b\u7684\u795d\u798f\u3002"
        },
        {
          "feature": "3.\u65b0\u589e\u4e86NPC\u4efb\u52a1\u66f4\u660e\u786e\u7684\u63d0\u793a\uff1a\u5f53\u4f60\u63a5\u53d6\u4e86NPC\u4efb\u52a1\uff0c\u5e76\u6ca1\u6709\u6ee1\u8db3\u5b8c\u6210\u6761\u4ef6\u7684\u65f6\u5019\uff0c\u76f8\u5e94NPC\u5934\u4e0a\u4f1a\u51fa\u73b0\u7ea2\u8272\u611f\u53f9\u53f7\u3002\u5f53\u4f60\u63a5\u53d6\u4e86NPC\u4efb\u52a1\uff0c\u5e76\u6ee1\u8db3\u5b8c\u6210\u6761\u4ef6\u7684\u65f6\u5019\uff0c\u4f1a\u5728\n\n\u76f8\u5e94NPC\u5934\u4e0a\u51fa\u73b0\u84dd\u8272\u611f\u53f9\u53f7\u3002"
        },
        {
          "feature": "4.\u690d\u7269\u72b6\u6001\u5c5e\u6027\u9762\u677f\uff1a\u5f53\u4f60\u6709\u690d\u7269\u5904\u4e8e\u5bd2\u51b7\uff0c\u708e\u70ed\uff0c\u6216\u8005\u4e0d\u826f\u72b6\u6001\u7684\u65f6\u5019\uff0c\u5c06\u4f1a\u6536\u5230\u7cfb\u7edf\u63d0\u793a\uff0c\u73a9\u5bb6\u53ef\u901a\u8fc7\u5feb\u6377\u680f\u5de6\u4e0b\u89d2\u7684\u611f\u53f9\u53f7\u70b9\u51fb\u67e5\u770b\u8be6\u7ec6\u63d0\u793a\u3002\u66f4\u65b9\u4fbf\u73a9\u5bb6\u53ca\u65f6\u4e86\n\n\u89e3\u4f5c\u7269\u72b6\u6001\uff0c\u7528\u6700\u77ed\u7684\u65f6\u95f4\u5904\u7406\u8fd9\u4e9b\u4e0d\u826f\u72b6\u6001\u3002"
        },
        {
          "feature": "5.\u5f00\u653e\u4e86MOD\u529f\u80fd\uff1a\u8be6\u7ec6\u4f7f\u7528\u6216\u8005\u5236\u4f5c\u65b9\u6cd5\uff0c\u6211\u4eec\u5c06\u4f1a\u5728\u540e\u671f\u589e\u52a0\u6559\u7a0b\uff0c\u65b9\u4fbf\u73a9\u5bb6\u5b66\u4e60\u3002\u52a0\u8f7d\u7684\u6a21\u7ec4\u53ef\u4ee5\u901a\u8fc7\u6e38\u620f\u4e3b\u83dc\u5355\u53f3\u4e0a\u89d2\u67e5\u770b\u5e76\u52a0\u8f7d\u3002"
        },
        {
          "feature": "6.\u65b0\u589e\u516c\u544a\u67e5\u770b\u529f\u80fd\uff1a\u73a9\u5bb6\u53ef\u4ee5\u901a\u8fc7\u6e38\u620f\u4e3b\u83dc\u5355\u53f3\u4e0a\u89d2\u7684\u5587\u53ed\u6309\u94ae\u67e5\u770b\u672c\u6b21\u66f4\u65b0\u5185\u5bb9\u4ee5\u53ca\u5386\u53f2\u66f4\u65b0\u5185\u5bb9\uff0c\u6700\u591a\u4fdd\u7559\u6700\u8fd110\u4e2a\u7248\u672c\u7684\u5185\u5bb9\u3002"
