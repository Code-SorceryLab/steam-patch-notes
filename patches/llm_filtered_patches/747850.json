        {
          "feature": "1.\u5feb\u6377\u680f\uff1a\u5feb\u6377\u680f\u589e\u52a0\u89c2\u5bdf\u8005\u6a21\u5f0f\uff0c\u53ef\u4ee5\u901a\u8fc7\u5feb\u6377\u952e\u6216\u8005\u9f20\u6807\u70b9\u51fb\u89e6\u53d1\uff0c\u4ece\u800c\u66f4\u65b9\u4fbf\u5feb\u6377\u7684\u67e5\u770b\u690d\u7269\u72b6\u6001\u3002"
