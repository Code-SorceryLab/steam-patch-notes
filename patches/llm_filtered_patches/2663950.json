        },
        {
          "feature": "\u6211\u4eec\u6b63\u5f0f\u5728Steam\u793e\u533a\u5e02\u573a\u4e0a\u67b6\u4e86\u793e\u533a\u7269\u54c1\uff01\u5185\u5bb9\u5305\u542b\u201c\u6536\u85cf\u5361\u724c\u201d\u3001\u201c\u5fbd\u7ae0\u201d\u3001\u201c\u8868\u60c5\u5305\u201d\u548c\u201c\u4e2a\u4eba\u8d44\u6599\u9875\u80cc\u666f\u201d\u3002\u73b0\u5728\u542f\u52a8\u6e38\u620f\u5373\u53ef\u6389\u843d\u5361\u724c\uff0c\u5e0c\u671b\u8fd9\u4e9b\u7269\u54c1\u80fd\u4e3a\u4f60\u7684Steam\u4e2a\u4eba\u4e3b\u9875\u6dfb\u8272\uff5e"
