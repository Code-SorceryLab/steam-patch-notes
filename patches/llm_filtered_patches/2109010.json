    {
      "title": "2023.01.15\u7b2c\u4e03\u7ae0\u7248\u672c\u66f4\u65b0",
      "date": "2023-01-15 07:42:49",
      "url": "https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/5035620840541902518",
      "content": "\u672c\u6b21\u66f4\u65b0\u65b0\u589e\u4e86\u7b2c\u4e03\u7ae0\u7684\u6240\u6709\u5185\u5bb9\uff0c\u9664\u6b64\u5916\uff0c\u9700\u8981\u8bf4\u660e\u4ee5\u4e0b\u51e0\u70b9\u3002\n\u8fdb\u5165\u7b2c\u4e03\u7ae0\u6e38\u620f\u6b63\u5f0f\u8fdb\u5165\u4e86\u4e2d\u671f\uff0c\u6218\u6597\u7684\u673a\u5236\u5f00\u59cb\u9010\u6b65\u5b8c\u5584\uff0c\u6570\u503c\u548c\u7269\u54c1\u83b7\u53d6\u4e5f\u5f97\u5230\u4e86\u8fdb\u4e00\u6b65\u7684\u8c03\u6574\uff0c\u5176\u4e2d\uff0c\u5fc5\u987b\u8bf4\u660e\u4ee5\u4e0b\u51e0\u70b9\u66f4\u6539\uff1a\n1.\u66b4\u51fb\u4f24\u5bb3\uff1a3\u500d\u21922\u500d\uff08\u4f46\u65b0\u589e\u4e86\u589e\u52a0\u66b4\u51fb\u4f24\u5bb3\u7684\u7269\u54c1\u3001\u88ab\u52a8\u7b49\u5728\u672a\u6765\u589e\u52a0\u5176\u4e0a\u9650\uff09\n2.\u77ac\u53d1\uff1a\u901f\u5ea6\u63d0\u53471000%\u2192\u901f\u5ea6\u63d0\u5347100%\u3002\n\u6211\u4eec\u6ce8\u610f\u5230\u5728\u89d2\u8272\u591a\u52a8\u7684\u60c5\u51b5\u4e0b\uff0c\u82e5\u6bcf\u4e00\u4e2a\u56de\u5408\u9009\u62e9\u4e00\u6b21\u77ac\u53d1\u6280\u80fd\uff0c\u5c06\u4f1a\u6709\u975e\u5e38imba\u7684\u884c\u4e3a\u3002\u77ac\u53d1\u7684\u4f5c\u7528\u5e94\u662f\u8282\u7701\u4e00\u56de\u5408\u7684\u884c\u52a8\uff0c\u56e0\u6b64\u901f\u5ea6\u63d0\u5347100%\u5373\u53ef\u3002\n3.\u4e25\u683c\u9650\u5236\u591a\u52a8\u7269\u54c1\u3001\u88ab\u52a8\n\u6211\u4eec\u53d1\u73b0\u591a\u52a8\u5bf9\u4e8e\u6e38\u620f\u524d\u671f\u589e\u52a0\u7684\u4e0a\u9650\u8fc7\u5927\uff0c\u4ee5\u81f4\u4e8e\u62e5\u6709\u591a\u52a8\u548c\u6ca1\u6709\u62e5\u6709\u591a\u52a8\u4ea7\u751f\u7684\u5dee\u8ddd\u592a\u5927\uff0c\u56e0\u6b64\u9650\u5236\u4e86\u591a\u79cd\u591a\u52a8\u7684\u884c\u4e3a\n4.\u4f18\u5316\u654c\u4eba\u7684\u72b6\u6001\u663e\u793a\uff08\u4ee5\u5f80\u7684\u72b6\u6001\u6709\u65f6\u4f1a\u56e0\u4e3a\u654c\u4eba\u8eab\u6750\u592a\u5927\u800c\u88ab\u6321\u4f4f\uff09\n5.\u8c03\u6574\u4e86\u5404\u79cd\u5f3a\u5316\u7684\u6301\u7eed\u56de\u5408\u6570\uff0c\u4ece5/4\u56de\u5408\u4e0d\u7b49\u8c03\u6574\u4e3a4/3\u56de\u5408\u4e0d\u7b49\n6.\u8c03\u6574\u547d\u4e2d\u7387\u516c\u5f0f\n\u4ee5\u5f80\u7684\u89d2\u8272\u95ea\u907f\u5f53\u8fbe\u5230100%\u540e\uff0c\u65e0\u8bba\u654c\u4eba\u547d\u4e2d\u7387\u591a\u9ad8\u90fd\u662fmiss\uff0c\u73b0\u5728\u5df2\u8c03\u6574\u4e3a\u51cf\u6cd5\u516c\u5f0f\n7.\u4e25\u683c\u9650\u5236\u5c3b\u5b50\u7389\n\u6211\u4eec\u53d1\u73b0\uff0c\u5f53\u5c3b\u5b50\u7389\u592a\u591a\u540e\uff0c\u89d2\u8272\u7684\u6570\u503c\u5c06\u4f1a\u6307\u6570\u7ea7\u7684\u6050\u6016\u589e\u957f\u3002\u4ee5\u81f4\u4e8e\u5931\u53bb\u6218\u6597\u7684\u4f53\u9a8c\u3002\u56e0\u6b64\u8c03\u6574\u4e86\u4ee5\u5f80\u5c3b\u5b50\u7389\u7684\u83b7\u53d6\u9014\u5f84\uff0c\u65e0\u6cd5\u83b7\u5f97\u592a\u591a\u5c3b\u5b50\u7389\u3002\n8.TP\u4e0d\u518d\u4fdd\u7559\n\u6211\u4eec\u53d1\u73b0TP\u4fdd\u7559\u5bf9\u4e8e\u89d2\u8272\u7684\u589e\u5e45\u592a\u5927\u4e14\u5931\u53bb\u4e86TP\u6280\u80fd\u7684\u7279\u8272\uff0c\u56e0\u6b64\u53d6\u6d88\u4e86\u89d2\u8272TP\u4fdd\u7559\u7684\u673a\u5236\uff0c\u4f46\u65b0\u589e\u4e86\u80fd\u591f\u4fdd\u7559TP\u7684\u88ab\u52a8\u548c\u88c5\u5907\n9.\u589e\u52a0\u4e86\u89d2\u8272\u72b6\u6001\u8be6\u60c5\u754c\u9762\uff0c\u73b0\u5728\u53ef\u4ee5\u5728\u83dc\u5355\u7684\u72b6\u6001\u754c\u9762\u67e5\u770b\u89d2\u8272\u7684\u8be6\u7ec6\u6570\u636e\u4e86\n10.\u5176\u4ed6\u82e5\u5e72\u4f18\u5316\n\u9700\u8981\u8bf4\u660e\u7684\u662f\uff0c\u4ee5\u4e0a\u8c03\u6574\u662f\u4e3a\u4e86\u7aed\u529b\u5e73\u8861\u5e76\u63d0\u5347\u73a9\u5bb6\u7684\u6218\u6597\u4f53\u9a8c\u800c\u8bbe\u8ba1\uff0c\u4f46\u662f\uff0c\u5f88\u591a\u65e7\u6863\u4f1a\u4fdd\u7559\u5404\u79cd\u6280\u80fd\u3001\u88c5\u5907\u3001\u89d2\u8272\u6570\u503c\u7b49\u7684\u9057\u7559\u95ee\u9898\uff0c\u4ee5\u81f4\u4e8e\u53ef\u80fd\u56e0\u89d2\u8272\u6570\u503c\u78be\u538b\u800c\u65e0\u6cd5\u4f53\u9a8c\u5230\u672c\u6b21\u66f4\u65b0\u7684\u5185\u5bb9\u3002\u5982\u679c\u9700\u8981\u4f53\u9a8c\u53ef\u80fd\u53ea\u80fd\u4ee5\u65b0\u6863\u8fdb\u884c\uff0c\u5bf9\u6b64\u6211\u6df1\u8868\u6b49\u610f\uff0c\u4e5f\u5e0c\u671b\u6700\u7ec8\u6210\u719f\u7684\u6b63\u5f0f\u7248\u80fd\u591f\u5c3d\u5feb\u548c\u5927\u5bb6\u89c1\u9762\u3002",
