        },
        {
          "feature": "- \uc0c8\ub85c\uc6b4 \uc758\uc0c1 \uc2a4\ud0e0\ub529 CG\uc640 \uc0c8\ub85c\uc6b4 \uc774\ubca4\ud2b8 CG"
        },
