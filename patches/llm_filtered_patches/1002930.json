    {
      "title": "Upcoming Update on Dec.24 (Version 1.0.86)",
      "date": "2019-12-23 03:29:44",
      "url": "https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/2592316573861103323",
      "content": "Dear Commanders,\nWar of Tanks: Blitzkrieg will have a maintenance on December 24th between 10:30~12:00(GMT+8). Please login after the update is over. The event that was originally scheduled on December 24th 00:00(GMT+8) will be postponed until the end of the update. Please pay close attention to the opening time of the event.\n\n[h2]Change log:[/h2]\n1. New Tanks: Light Prismer, Fraudster, War Fortress\n2. New Commanders: Natasha, Goodrian\n3. Added a Lucky Chest containing the latest tanks and commanders.\n4. Adjusted Tanya, Terminator and Desert Storm skills\n5. Terminator growth attribute ratio adjusted\n6. Carnival event: daily reward on the 3rd day is increased by 50 VIP EXP and 7th day by 70 VIP EXP",
      "key": "1002930::a1528c752c7a20d0321044234faf0c148a6422a6",
      "tags": [
        {
          "feature": "New Tanks: Light Prismer, Fraudster, War Fortress"
        },
        {
          "feature": "New Commanders: Natasha, Goodrian"
        },
        {
          "feature": "Added a Lucky Chest containing the latest tanks and commanders."
        },
        {
          "balance_change": "Adjusted Tanya, Terminator and Desert Storm skills"
        },
        {
          "balance_change": "Terminator growth attribute ratio adjusted"
        },
        {
          "balance_change": "Carnival event: daily reward on the 3rd day is increased by 50 VIP EXP and 7th day by 70 VIP EXP"
        }
      ]
    },
