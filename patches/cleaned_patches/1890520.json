  "notes": [
    {
      "title": "\uc2a4\ud2b8\ub9ac\ubc0d \uac00\uc774\ub4dc\ub77c\uc778",
      "date": "2022-03-11 04:31:33",
      "url": "https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/5631194088561251382",
      "content": "\uc2e4\ud669\uc740 \uc790\uc720\ub86d\uac8c \ud558\uc2dc\uba74 \ub429\ub2c8\ub2e4. \uadf8\ub7ec\ub098 \uacf5\uac1c\ud55c \uc0ac\uc6b4\ub4dc \ud2b8\ub799\uc744 2\ucc28 \uc5c5\ub85c\ub4dc \ubc0f, \uac8c\uc784 \ud0c0\uc774\ub4dc \uc5c5\uacfc \uad00\uacc4 \uc5c6\ub294 \uac83\uc5d0 \uc0ac\uc6a9\ud558\ub294 \uac83\uc5d0 \ub300\ud574 \uae08\uc9c0\ud569\ub2c8\ub2e4. \n\n\n\ub2e4\uc74c\uc740 \uac15\uc81c\uc131 \uc5c6\ub294 \ubd80\ud0c1\ub4dc\ub9ac\uace0\uc790\ud558\ub294 \ub0b4\uc6a9\uc785\ub2c8\ub2e4.\n\n1.\uac8c\uc784\uc758 \uc911\uc694\ud55c \ubd80\ubd84, \uc790\uadf9\uc801\uc778 \ubd80\ubd84 \uadf8\ub300\ub85c\ub97c \uc5c5\ub85c\ub4dc \uc601\uc0c1 \uc12c\ub124\uc77c\ub85c \uc548\ud574\uc8fc\uc168\uc73c\uba74 \uc88b\uaca0\uc2b5\ub2c8\ub2e4.\n\n2.\uc5b4\ub518\uac00\uc5d0 \ubcf8 \uac8c\uc784\uc758 \uc0c1\uc810 \ud398\uc774\uc9c0 \ub9c1\ud06c\ub97c \ub9c8\ub828\ud574\uc8fc\uc2dc\uba74 \uac10\uc0ac\ud558\uaca0\uc2b5\ub2c8\ub2e4.\n\n3.\uac8c\uc784\uc5d0 \uad00\ud55c \uc758\uacac, \uac10\uc0c1, \ud574\uc11d, \ub17c\ud3c9\uc774 \ud3ec\ud568\ub41c \ub3d9\uc601\uc0c1\uc744 \ub9cc\ub4dc\ub294 \uac83\uc744, \n\ucc38\uc5ec\uc790 \ubd84\ub4e4\uc774 \uadf8 \ubd84\uc704\uae30\ub97c \ucd94\uad6c\ud55c\ub2e4\uba74 \uae30\uc069\ub2c8\ub2e4!\n\n\uc774\ud574\ud574\uc8fc\uc2dc\uba74 \uc815\ub9d0 \uac10\uc0ac\ud558\uaca0\uc2b5\ub2c8\ub2e4."
    }
  ]
}