65f6\u56fe\u6807\u6d88\u5931\u7684\u95ee\u9898\n\n\u4fee\u590d UI \u63d0\u793a\u9519\u8bef\u4ee5\u53ca\u5b57\u4f53\u5c3a\u5bf8\u4f18\u5316\n\n\u4fee\u590d\u8840\u91cf\u6bd4\u4f8b\u4e24\u4e2a 1500 \u7684\u95ee\u9898\n\n\u4fee\u590d\u6c14\u6ce1\u63d0\u793a\u6846\u4f4d\u7f6e\u9519\u8bef\u95ee\u9898\n\n\u4fee\u590d\u5bf9\u8bdd\u6846\u64ad\u653e\u97f3\u6548\u548c\u97f3\u4e50\u7684\u5904\u7406\u95ee\u9898\n\n\u4f18\u5316\u5730\u56fe\u97f3\u4e50\u7684\u968f\u673a\u7b97\u6cd5, \u4e0d\u518d\u4f7f\u7528\u5b8c\u5168\u968f\u673a\n\n\u7834\u9635\u65a9\u6548\u679c\u524a\u5f31\u4e3a 12%\n\n\u8c03\u6574\u7ec8\u7109\u6280\u80fd\u7684\u6548\u679c, \u4e0d\u518d\u6839\u636e\u56de\u5408\u6570\u8fdb\u884c\u8ba1\u7b97, \u800c\u662f\u5185\u7f6e\u8ba1\u6570\u5668\n\n\u81ea\u5b9a\u4e49\u6a21\u5f0f\u589e\u52a0\u65b0\u7684\u8840\u91cf\u6bd4\u4f8b\u548c\u8010\u4e45\u6bd4\u4f8b\n\n\u8c03\u6574\u6e38\u620f\u7684\u5b57\u4f53, \u56e0\u4e3a\u4e4b\u524d\u7684\u5b57\u4f53\u5e93\u5e76\u4e0d\u662f\u5f88\u5168, \u5f88\u591a\u504f\u50fb\u5b50\u6ca1\u6709, \u5bfc\u81f4\u6a21\u7ec4\u5f00\u53d1\u8005\u4f7f\u7528\u504f\u50fb\u5b57\u4f1a\u65e0\u6cd5\u663e\u793a\n\n\u8d44\u6e90\u6807\u8bc6\u91cd\u5199, \u4f7f\u7528\u65b0\u7684\u6784\u9020\u89c4\u5219, \u672c\u4f53\u4ee5 \"core.\" \u5f00\u5934, \u6a21\u7ec4\u4ee5 \"mod.\" \u5f00\u5934\n\n\u81ea\u5b9a\u4e49\u6a21\u5f0f\u79fb\u9664\u6700\u5927\u7b49\u7ea7\u9009\u9879, \u65b0\u589e\u7ecf\u9a8c\u503c\u7cfb\u6570\u9009\u9879\n\n\u5173\u5361 21 \u4e2d \"\u8c1c\u4e4b\u9b54\u5251\" \u4e0d\u518d\u635f\u574f\n\n\u79fb\u9664\u5173\u5361 2 \u4e2d\u53f3\u4fa7\u623f\u5b50\u7684 \"\u6cbb\u7597\u5242\"\n\n\"\u884c\u4e91\u6d41\u6c34\" \u8c03\u6574: \u4ec5\u53cc\u65b9\u90fd\u53ef\u8fdb\u884c\u653b\u51fb\u65f6\u89e6\u53d1\n\n\"\u8fde\u51fb\u5c01\u5370\" \u8c03\u6574: \u4ec5\u53cc\u65b9\u90fd\u53ef\u8fdb\u884c\u653b\u51fb\u65f6\u89e6\u53d1\n\n\"\u4e8c\u8fde\u51fb\" \u548c\" \u8fde\u821e\" \u8c03\u6574: \u4f1a\u88ab\u8fde\u51fb\u5c01\u5370\u514b\u5236\n\n\u5b58\u6863\u6269\u5145\u81f3 12 \u9875, \u5f00\u653e\u5faa\u73af\u7ffb\u9875\n\n\u4f7f\u7528\u6a21\u7ec4\u65f6\u4e0d\u5f00\u653e\u6392\u884c\u699c\n\n\u4e0b\u8c03\u683c\u6321\u7684\u57fa\u7840\u53d1\u52a8\u7387, 20 > 12\n\n\u5927\u5e45\u5ea6\u964d\u4f4e\u5267\u60c5\u6a21\u5f0f\u7684\u96be\u5ea6\n\n[img src=\"{STEAM_CLAN_IMAGE}/45268071/f03ba2aed4b2f0113ea9d98762bacb6e678aa6cc.gif\"]\n\\[v1.21.3.47] (2025-04-22)\n\u65b0\u589e MOD \u673a\u5236, \u4e0d\u8fc7\u76ee\u524d\u4ec5\u652f\u6301\u53d8\u66f4\u89d2\u8272\u7684\u5934\u50cf\u7acb\u7ed8\u4ee5\u53ca\u804c\u4e1a\u7684\u53ef\u7528\u6b66\u5668\u7c7b\u578b, \u540e\u7eed\u4f1a\u652f\u6301\u66f4\u591a\n\n\u6e38\u620f\u5267\u60c5\u4e8b\u4ef6\u5f00\u59cb\u533a\u5206\u6a21\u5f0f, \u5267\u60c5\u6a21\u5f0f\u51cf\u5c11\u5927\u91cf\u4f0f\u5175, \u66f4\u52a0\u7b80\u5355, \u5176\u4ed6\u6a21\u5f0f\u65e0\u53d8\u5316\n\n\u53ef\u6218\u6597\u7684\u804c\u4e1a\u73b0\u5728\u5747\u652f\u6301\u9b54\u6cd5\u6b66\u5668, \u4e0d\u8fc7\u4fee\u6539\u6b66\u5668\u7c7b\u578b\u9700\u8981\u4f7f\u7528 MOD\n\n\u4fee\u590d\u51ef\u7279\u6280\u80fd\u63cf\u8ff0\u5f39\u7a97\u62a5\u9519\u7684\u95ee\u9898\n\n\u5267\u60c5\u6a21\u5f0f\u4e0b\u53d6\u6d88\u90e8\u5206\u63f4\u5175\u4e8b\u4ef6\n\n[img src=\"{STEAM_CLAN_IMAGE}/45268071/ebd45dbf9a20574e3710c6d2508ff5e6ed7da7eb.gif\"]\n\\[v1.21.2.46] (2025-04-13)\n\u65b0\u589e\u8bbe\u7f6e\u9009\u9879: \u6218\u6597\u52a0\u901f, \u540c\u65f6\u79fb\u9664\u654c\u65b9\u56de\u5408\u52a0\u901f\u7684\u529f\u80fd (\u4e24\u8005\u51b2\u7a81)\n\n\u4fee\u590d\u6d41\u5f71\u8fd4\u65a9 buff \u56fe\u6807\u9519\u8bef\u95ee\u9898\n\n\u4fee\u590d\u6d41\u5f71\u8fd4\u65a9\u6280\u80fd\u6846\u9519\u8bef\u95ee\u9898\n\n\u4fee\u590d\u6280\u80fd\u8d22\u5b9d\u730e\u624b\u63cf\u8ff0\u9519\u8bef\u7684\u95ee\u9898\n\n\u4fee\u590d\u590f\u4fac\u6280\u80fd\u63cf\u8ff0\u9519\u8bef\u7684\u95ee\u9898\n\n\u4fee\u590d\u51ef\u7279\u6280\u80fd\u63cf\u8ff0\u9519\u8bef\u7684\u95ee\u9898\n\n\u4fee\u590d\u8d1d\u4e1d\u6280\u80fd\u63cf\u8ff0\u9519\u8bef\u7684\u95ee\u9898\n\n\u4fee\u590d\u654c\u4eba\u56de\u5408\u52a0\u901f\u529f\u80fd\u5bfc\u81f4\u6218\u6597\u4e2d\u70b9\u51fb buff \u6309\u94ae\u4f1a\u5361\u4f4f\u7684\u95ee\u9898\n\n\u4fee\u590d\u5728\u9009\u62e9\u51fa\u51fb\u4eba\u7269\u548c\u9009\u62e9\u51fa\u51fb\u4f4d\u7f6e\u7684\u9875\u9762\u4e5f\u53ef\u4ee5\u6253\u5f00\u63a7\u5236\u53f0\u7684\u95ee\u9898\n\n\u4fee\u590d\u6e38\u620f\u624b\u518c\u4e2d\u6280\u80fd\u53d1\u52a8\u7387\u63cf\u8ff0\u9519\u8bef\u7684\u95ee\u9898\n\n\n\\[v1.21.2.45] (2025-04-08)\n\u4eba\u7269\u72b6\u6001\u9875\u9762\u6570\u6027\u503c\u4f4d\u7f6e\u65b0\u589e\u60ac\u6d6e\u7a97\u63d0\u793a (\u5176\u4ed6\u4f4d\u7f6e\u540e\u7eed\u4f1a\u6162\u6162\u6dfb\u52a0)\n\n\u65b0\u589e\u4e13\u5c5e\u6280\u80fd: \u3010\u7834\u9635\u65a9\u3011, \u89c1\u51ef\u7279\n\n\u65b0\u589e\u4e13\u5c5e\u6280\u80fd: \u3010\u6d41\u5f71\u8fd4\u65a9\u3011, \u89c1\u590f\u4fac\n\n\u65b0\u589e\u4e13\u5c5e\u6280\u80fd: \u3010\u6781\u81f4\u6280\u827a\u3011, \u89c1\u8398\n\n\u65b0\u589e\u4e13\u5c5e\u6280\u80fd: \u3010\u745f\u7f07\u4e9a\u7684\u542f\u793a\u3011, \u89c1\u8d1d\u4e1d\n\n\u56e0\u4e3a\u56f0\u96be\u548c\u6311\u6218\u6a21\u5f0f\u4e0b\u5b58\u5728\u6392\u884c\u699c, \u6240\u4ee5\u7981\u7528\u63a7\u5236\u53f0\n\n\u8c03\u6574\u89c9\u9192\u7248\u6280\u80fd\u3010\u8d22\u5b9d\u730e\u624b\u3011\u7684\u6548\u679c, \u5177\u4f53\u89c1\u6280\u80fd\u63cf\u8ff0\n\n\u4f18\u5316\u5206\u5305, \u5927\u5e45\u5ea6\u964d\u4f4e PC \u7248\u672c\u66f4\u65b0\u7684\u5927\u5c0f, \u4f46\u7531\u4e8e Android \u5b89\u88c5\u5305\u7684\u5b58\u5728, \u4f9d\u7136\u4e0d\u4f1a\u5c0f\u4e8e 100MB\n\n\u7075\u836f\u4ef7\u683c\u8c03\u6574 2250 > 2750\n\n\u7075\u836f\u6062\u590d\u91cf\u8c03\u6574 100 > 120\n\n\u8c03\u6574\u5723\u5251\u548c\u5723\u65a7\u7684\u547d\u4e2d\u7387\n\n\u8c03\u6574\u90e8\u5206\u9875\u9762\u7684\u6570\u5b57\u5b57\u4f53\n\n\u8c03\u6574\u6280\u80fd\u3010\u7834\u7532\u3011 \u7684\u6587\u5b57\u63cf\u8ff0\n\n\u8398\u79fb\u9664\u6280\u80fd\u3010\u5fc5\u6740\u3011\n\n\u51ef\u7279\u79fb\u9664\u6280\u80fd\u3010\u5148\u5236\u653b\u51fb\u3011\n\n\u590f\u4fac\u79fb\u9664\u6280\u80fd\u3010\u5148\u5236\u653b\u51fb\u3011\n\n\u8d1d\u4e1d\u79fb\u9664\u6280\u80fd\u3010\u97e7\u6027\u3011\n\n\u8c03\u6574\u3010\u8398\u3011\u548c\u3010\u51ef\u7279\u3011\u7684\u89d2\u8272\u6570\u503c\n\n\u4fee\u590d\u5173\u5361 11 \u4e2d\u67d0\u4e2a\u5bf9\u767d\u7684\u8bf4\u8bdd\u5bf9\u8c61\u9519\u8bef\u7684\u95ee\u9898\n\n\u4fee\u590d\u6280\u80fd\u7f6e\u7070\u540e\u4e0d\u6062\u590d\u7684\u95ee\u9898\n\n\u4fee\u590d\u517b\u6210\u754c\u9762 + - \u6807\u8bc6\u9519\u8bef\u7684\u95ee\u9898\n\n\u5220\u9664\u5bf9\u7425\u73c0\u9879\u94fe\u7684\u63d0\u793a, \u76ee\u524d\u53d1\u73b0\u6b64\u4efb\u52a1\u5df2\u8131\u79bb\u8bbe\u8ba1\u521d\u8877, \u56e0\u6b64\u51b3\u5b9a\u5220\u9664\u63d0\u793a\n\n\u4fee\u590d\u5173\u95ed\u4fe1\u606f\u63d0\u793a\u65f6, \u4e00\u65e6\u6b66\u5668\u635f\u574f\u6e38\u620f\u4fbf\u4f1a\u5361\u4f4f\u7684\u95ee\u9898\n\n\u4fee\u590d\u63a7\u5236\u53f0\u5173\u4e8e add-item \u547d\u4ee4\u63cf\u8ff0\u9519\u8bef\u7684\u95ee\u9898\n\n\u4fee\u590d\u5173\u5361 13 \u5931\u8d25\u540e\u9009\u62e9\u7ee7\u7eed\u6e38\u620f, \u65e0\u6cd5\u6b63\u5e38\u6e38\u73a9\u7684\u95ee\u9898"
