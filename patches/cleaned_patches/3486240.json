    },
    {
      "title": "\u6700\u540e\u7684\u4fee\u4ed9\u8005[\u5e38\u89c4\u66f4\u65b0]",
      "date": "2025-03-12 20:44:05",
      "url": "https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1794102528056055",
      "content": "1.\u52a0\u5165\u7b80\u6613\u7684\u5728\u7ebf\u73a9\u5bb6\u5217\u8868\u663e\u793a\n2.\u521d\u6b65\u642d\u5efa\u79cd\u690d\u7cfb\u7edf\u7684\u571f\u5730,\u5361\u69fd,\u79cd\u690d,\u6b7b\u4ea1,\u4ea7\u51fa\u903b\u8f91.\n3.\u5f15\u5165\u7b80\u6613\u5bf9\u8bdd\u7cfb\u7edf\n4.\u589e\u52a0\u4e00\u4e2a\u57fa\u4e8e\u5bf9\u8bdd\u7cfb\u7edf\u7684\u8bf4\u660e,\u589e\u52a0\u4e00\u4e2a\u57fa\u4e8e\u5bf9\u8bdd\u7cfb\u7edf\u7684\u7b80\u6613\u73a9\u5bb6\u653b\u7565\n5.\u5c06\u6b8b\u7f3a\u5185\u5bb9\u5168\u90e8\u6574\u5408\u4e3a \u5b9e\u9a8c\u5185\u5bb9 \u9762\u677f"
    },
    {
      "title": "\u6700\u540e\u7684\u4fee\u4ed9\u8005[UI\u754c\u9762\u7ec4\u5408\u4f18\u5316]\u66f4\u65b0",
      "date": "2025-03-10 20:49:11",
      "url": "https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1793384379517566",
      "content": "1.\u5c06\u65b0\u73a9\u5bb6\u7684\u9ed8\u8ba4\u5b57\u4f53\u8bbe\u4e3a\u6e29\u6da6,\u9ed8\u8ba4\u7f29\u653e\u8bbe\u4e3a0.8,\u9ed8\u8ba4\u7f29\u653e\u6a21\u5f0f\u4e3a\u9ad8\u8d28\u91cf\u7f29\u653e\n2.\u5c06\u5730\u56fe\u9762\u677f,\u6218\u6597\u9762\u677f,\u64ad\u62a5\u9762\u677f,\u7edf\u8ba1\u9762\u677f,\u96be\u5ea6\u9009\u9879\u7b49\u7ec4\u5408\u4e3a\u6218\u573a\u9762\u677f\n3.\u5c06\u7b26\u6587/BOSS\u56fe\u9274/\u5750\u9a91/\u7fc5\u8180/\u65f6\u88c5/\u5929\u8d4b/\u7b7e\u5230/\u5143\u5b9d\u5546\u57ce\u7ec4\u5408\u4e3a\u6536\u85cf\u9762\u677f\n4.\u4f18\u5316\u6218\u573a\u663e\u793a\u6548\u679c\n5.\u4e3a\u901a\u5929\u5854\u589e\u52a0x100,x500\u5151\u6362\u9879\n6.\u4f18\u5316\u90e8\u5206\u6570\u5b57\u663e\u793a\u7684\u5c0f\u6570\u70b9\u60c5\u51b5\n7.\u66f4\u6362\u77ff\u6d1e\u5b9d\u7269\u7684\u56fe\u7247\n8.\u4fee\u590d\u6ee1\u8db3\u8981\u6c42\u7684\u88c5\u5907\u4e0d\u80fd\u9644\u9b54\u7684\u95ee\u9898\n9.\u4f18\u5316\u64ad\u62a5\u9762\u677f\u6d88\u606f\u5bb9\u7eb3\u548c\u663e\u793a\n10.\u73a9\u5bb6\u5c5e\u6027\u9762\u677f\u989d\u5916\u663e\u793a\u7ecf\u9a8c\u52a0\u6210,\u91d1\u5e01\u52a0\u6210\u5c5e\u6027\n11.\u4f18\u5316\u5546\u5e97\u622a\u56fe"
    },
