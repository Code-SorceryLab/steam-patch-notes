      "content": "1.\u4f18\u5316BOSS\u56fe\u9274\u663e\u793a\u8fdb\u5ea6\n2.\u4fee\u590d\u5750\u9a91\u754c\u9762\u97f3\u6548\n3.\u589e\u52a0\u65f6\u88c5\u9762\u677f\n4.\u89d2\u8272\u6280\u80fd\u56fe\u6807\u66f4\u6362\n5.\u5929\u8d4b\u73b0\u5728\u4f1a\u63d0\u793a\u524d\u7f6e\u5929\u8d4b\u540d\n6.\u4f18\u5316\u6392\u884c\u699c\u6eda\u52a8\u8bbe\u7f6e\n7.\u4fee\u590d\u6392\u884c\u699c\u4fe1\u606f\u663e\u793a\u9519\u4e71\u95ee\u9898\n8.\u589e\u52a0\u4e24\u4e2a\u5973\u5ba0,3\u4e2a\u517d\u5ba0,2\u4e2a\u7c7b\u4eba\u5ba0\n9.\u589e\u5f3a\u793c\u5305\u7801\u7684\u80fd\u529b\n10.\u4f18\u5316\u6e38\u620f\u7f51\u7edc\u80fd\u529b,\u5c24\u5176\u662f\u521a\u8fdb\u5165\u6e38\u620f\u65f6\n11.\u4fee\u590d\u7fc5\u8180\u754c\u9762\u6570\u636e\u5f02\u5e38\u7684\u6076\u6027\u95ee\u9898\n12.\u4fee\u590d\u5750\u9a91\u754c\u9762\u6570\u636e\u5f02\u5e38\u7684\u6076\u6027\u95ee\u9898"
    },
