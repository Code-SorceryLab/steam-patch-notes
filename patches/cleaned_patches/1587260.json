      "content": "\u66f4\u65b0\u8bf4\u660e\uff1a\n1.\u5f00\u653e\u4e86\u9ad8\u96be\u5ea6\u526f\u672c  \u67af\u6811\u6797\n2.\u89d2\u8272 \u827e\u4e3d\u00b7\u8bfa\u62c9\u514b \u7684\u6280\u80fd \u5492\u672f\u6bc1\u706d \u51b7\u5374\u65f6\u95f4\u7531 6 \u8c03\u6574\u4e3a 7 \u3002\u65b0\u589e\u52a0\u7279\u6548\uff0c\u6b64\u6280\u80fd\u4f1a\u51c0\u5316\u654c\u4eba\u589e\u76caBUFF\u3002\n3.\u9ad8\u96be\u5ea6\u526f\u672c  \u745e\u683c\u65af\u706b\u5c71  \u7684\u602a\u7269\u8840\u91cf\u6574\u4f53\u4e0a\u8c0310%\u3002\n4.\u5728\u4e1d\u8482\u843d\u57ce\u5185\u7684\u5173\u952e\u8bbe\u65bd\u9644\u8fd1\u589e\u52a0\u4e86\u5feb\u901f\u79fb\u52a8\u70b9\u3002"
    },
