    {
      "title": "\u041e\u0431\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0435 \u043e\u0442 23 \u0430\u0432\u0433\u0443\u0441\u0442\u0430",
      "date": "2021-08-23 12:33:57",
      "url": "https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/4022264629326381780",
      "content": "\u0418\u0441\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u043e \u043c\u043d\u043e\u0436\u0435\u0441\u0442\u0432\u043e \u043e\u0440\u0444\u043e\u0433\u0440\u0430\u0444\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043e\u0448\u0438\u0431\u043e\u043a \u0430\u043d\u0433\u043b\u0438\u0439\u0441\u043a\u043e\u0439 \u0432\u0435\u0440\u0441\u0438\u0438.\n\n***\n\nFixed a lot of spelling errors in the English version."
    },
    {
      "title": "\u041e\u0431\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0435 \u043e\u0442 21 \u0430\u0432\u0433\u0443\u0441\u0442\u0430",
      "date": "2021-08-21 11:12:55",
      "url": "https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/4022264629318897426",
      "content": "\u0418\u0441\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u043e \u043e\u043a\u043e\u043b\u043e 40 \u043d\u043e\u0432\u044b\u0445 \u043e\u0440\u0444\u043e\u0433\u0440\u0430\u0444\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0438 \u043f\u0443\u043d\u043a\u0442\u0443\u0430\u0446\u0438\u043e\u043d\u043d\u044b\u0445 \u043e\u0448\u0438\u0431\u043e\u043a \u0432 \u0440\u0443\u0441\u0441\u043a\u043e\u0439 \u0432\u0435\u0440\u0441\u0438\u0438 \u0438\u0433\u0440\u044b. \u0417\u0430 \u0438\u0445 \u043e\u0442\u0441\u043b\u0435\u0436\u0438\u0432\u0430\u043d\u0438\u0435 \u0431\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u043d\u043e\u0441\u0442\u044c \u0410\u043d\u0434\u0440\u0435\u044e \u041d\u0435\u043c\u043a\u043e\u0432\u0443.\n\u041f\u043e\u043c\u0438\u043c\u043e \u044d\u0442\u043e\u0433\u043e \u0438\u0441\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u043e 2 \u0441\u044e\u0436\u0435\u0442\u043d\u044b\u0435 \u0448\u0435\u0440\u043e\u0445\u043e\u0432\u0430\u0442\u043e\u0441\u0442\u0438:\n\n1. \u0421\u0430\u0448\u0430 \u043d\u0435 \u0434\u043e\u043b\u0436\u0435\u043d \u0431\u044b\u043b \u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u044c\u0441\u044f \u0445\u043e\u0437\u044f\u0438\u043d\u043e\u043c \u041d\u0435\u0441\u0441\u0438, \u0432\u0435\u0434\u044c \u0421\u043a\u043e\u0440\u043e\u0431\u043e\u0433\u0430\u0442\u043e\u0432 \u043d\u0435 \u0434\u0430\u0432\u0430\u043b \u0441\u043e\u0433\u043b\u0430\u0441\u0438\u044f.\n\u041d\u0435\u0441\u0441\u0438 \u0438 \u0412\u0430\u043b\u0435\u0440\u0438 \u0440\u0430\u0437\u043b\u0438\u0447\u0430\u0435\u0442 \u0442\u043e, \u0447\u0442\u043e \u0410\u043d\u0442\u043e\u043d \u0440\u0430\u0437\u0440\u0435\u0448\u0438\u043b \u0436\u0443\u0440\u0443-\u043f\u0430\u0440\u0438  \u0432\u0437\u044f\u0442\u044c \u0441\u0435\u0431\u0435 \u043d\u043e\u0432\u043e\u0433\u043e \u0445\u043e\u0437\u044f\u0438\u043d\u0430, \u0435\u0441\u043b\u0438 \u043d\u0430\u0439\u0434\u0451\u0442\u0441\u044f \u0442\u043e\u0442, \u043a\u0442\u043e \u043e\u0442\u0433\u0430\u0434\u0430\u0435\u0442 \u0435\u0451 \u0438\u043c\u044f. \u0421\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044e\u0449\u0430\u044f \u0441\u0442\u0440\u043e\u043a\u0430 \u0432 \u0434\u0438\u0430\u043b\u043e\u0433\u0435 \u0432\u0435\u0442\u0435\u0440\u0430\u043d\u0430 \u0438 \u041d\u0435\u0441\u0441\u0438 \u043f\u043e\u044f\u0432\u0438\u043b\u0430\u0441\u044c \u0432 \u0442\u0435\u043a\u0441\u0442\u0435: \u041d\u0435\u0441\u0441\u0438 \"\u0425\u043e\u0437\u044f\u0438\u043d \u043f\u043e\u043e\u0431\u0435\u0449\u0430\u043b, \u0447\u0442\u043e \u043e\u0442\u0434\u0430\u0441\u0442 \u043c\u0435\u043d\u044f \u043d\u043e\u0432\u043e\u043c\u0443 \u0432\u043b\u0430\u0434\u0435\u043b\u044c\u0446\u0443, \u0435\u0441\u043b\u0438 \u0442\u043e\u0442 \u043e\u0442\u0433\u0430\u0434\u0430\u0435\u0442 \u0438\u043c\u044f. \u0418\u0449\u0438\u0442\u0435 \u043d\u0430 \u0444\u043e\u0440\u0437\u0430\u0446\u0435.\"\n\n2. \u0412 \u043e\u0434\u043d\u043e\u0439 \u0438\u0437 \u043a\u043e\u043d\u0446\u043e\u0432\u043e\u043a \u0410\u0440 \u043d\u0430\u0447\u0438\u043d\u0430\u043b\u0430 \u0431\u0435\u0437\u0440\u043e\u043f\u043e\u0442\u043d\u043e \u0441\u043b\u0443\u0448\u0430\u0442\u044c\u0441\u044f \u043f\u0440\u0438\u043a\u0430\u0437\u043e\u0432 \u0421\u0430\u0448\u0438, \u0445\u043e\u0442\u044f \u043e\u043d \u0431\u044b\u043b \u0442\u0430\u043a\u0438\u043c \u0436\u0435 \u0434\u0435\u043c\u043e\u043d\u043e\u043c. \u0412\u0441\u0451 \u0434\u0435\u043b\u043e \u0432 \u043f\u0440\u0438\u043a\u0430\u0437\u0435 \u0435\u0451 \u043e\u0442\u0446\u0430, \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044e\u0449\u0438\u0435 \u0441\u0442\u0440\u043e\u043a\u0438 \u043f\u043e\u044f\u0432\u0438\u043b\u0438\u0441\u044c \u0432 \u0442\u0435\u043a\u0441\u0442\u0435: \n\u0421\u0430\u0448\u0430 \"\u0417\u0430 \u044d\u0442\u0438\u043c \u0442\u0432\u043e\u0439 \u043e\u0442\u0435\u0446 \u0438 \u0445\u043e\u0442\u0435\u043b \u043f\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u0442\u044c \u043c\u0435\u043d\u044f \u0432 \u043b\u0430\u043c\u0430\u0441\u0443? \u0425\u043e\u0442\u0435\u043b \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u0438\u0440\u043e\u0432\u0430\u0442\u044c?\"\n\u0410\u0440 \"\u041d\u0435\u0442, \u043e\u043d \u043f\u0440\u043e\u0441\u0442\u043e \u0445\u043e\u0442\u0435\u043b, \u0447\u0442\u043e\u0431\u044b \u0435\u0433\u043e \u0434\u043e\u0447\u044c \u0436\u0438\u043b\u0430 \u0441 \u0440\u0430\u0432\u043d\u044b\u043c.\"\n\u0421\u0430\u0448\u0430 \"\u042f \u0432\u0441\u0435\u0433\u0434\u0430 \u0431\u044b\u043b \u0440\u0430\u0432\u043d\u044b\u043c \u0442\u0435\u0431\u0435. \u041d\u043e \u043f\u043e\u0441\u043c\u043e\u0442\u0440\u0438 \u2014 \u0441\u0435\u0439\u0447\u0430\u0441 \u0442\u044b \u043f\u043e\u0434\u0447\u0438\u043d\u044f\u0435\u0448\u044c\u0441\u044f \u043f\u0440\u0438\u043a\u0430\u0437\u0443 \u0442\u0430\u043a\u043e\u0433\u043e \u0436\u0435 \u0434\u0435\u043c\u043e\u043d\u0430.\"\n\u0410\u0440 \"\u0422\u0430\u043a\u043e\u0439 \u0431\u044b\u043b\u0430 \u0432\u043e\u043b\u044f \u043e\u0442\u0446\u0430.\"\n\"\u042e\u043d\u043e\u0448\u0430 \u0432\u0437\u0434\u043e\u0445\u043d\u0443\u043b.\"\ns \"\u0417\u043d\u0430\u0447\u0438\u0442, \u043e\u043d \u0446\u0435\u043d\u0438\u043b \u0432\u0430\u0441 \u0435\u0449\u0451 \u043c\u0435\u043d\u044c\u0448\u0435 \u0447\u0435\u043c \u044f \u043f\u0440\u0435\u0434\u043f\u043e\u043b\u0430\u0433\u0430\u043b. \u041d\u0430\u0448\u0435 \u0431\u0435\u0433\u0441\u0442\u0432\u043e \u0442\u043e\u043b\u044c\u043a\u043e \u043a \u043b\u0443\u0447\u0448\u0435\u043c\u0443.\""
    },
    {
      "title": "\u041e\u0431\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0435 \u043e\u0442 17 \u0438\u044e\u043d\u044f",
      "date": "2021-06-17 06:28:17",
      "url": "https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/4056035920054388104",
      "content": "1. \u0415\u0441\u043b\u0438 \u0433\u0435\u0440\u043e\u0439 \u0437\u0430\u0441\u0442\u0430\u0432\u043b\u044f\u043b \u0412\u0430\u043b\u0435\u0440\u0438 \u043d\u043e\u0441\u0438\u0442\u044c \u0440\u0443\u043a\u0430\u043c\u0438 \u0440\u0430\u0441\u043a\u0430\u043b\u0451\u043d\u043d\u044b\u0435 \u043f\u0440\u0435\u0434\u043c\u0435\u0442\u044b \u043e\u0431 \u044d\u0442\u043e\u043c \u0431\u044b\u0441\u0442\u0440\u043e \u0437\u0430\u0431\u044b\u0432\u0430\u043b\u043e\u0441\u044c. \u0418\u0441\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u043e. \u0422\u0435\u043f\u0435\u0440\u044c \u0440\u0443\u043a\u0438 \u0434\u0435\u0432\u0443\u0448\u043a\u0438 \u0431\u0443\u0434\u0443\u0442 \u0431\u043e\u043b\u0435\u0442\u044c \u0434\u043e \u043a\u043e\u043d\u0446\u0430 \u0438\u0433\u0440\u044b.\n\n2. \u0422\u0435\u043b\u0435\u0436\u043a\u0430 \u043e\u0440\u0444\u043e\u0433\u0440\u0430\u0444\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u043e\u0448\u0438\u0431\u043e\u043a:\n\u0427\u0442\u043e\u0431\u044b \u0432\u044b\u0441\u0442\u0430\u0432\u0438\u0442\u044c \u043c\u0435\u043d\u044f \u0433\u0435\u0440\u043e\u0435\u043c \u0432 \u0441\u043e\u0441\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0445 \u0433\u043b\u0430\u0437\u0430\u0445 (\u0441\u043e\u0411\u0421\u0442\u0432\u0435\u043d\u043d\u044b\u0445)\n\u0432\u043d\u0443\u0448\u0430\u0442\u044c \u043b\u044e\u0434\u044f\u043c \u043b\u0435\u0434\u044f\u043d\u044f\u0449\u0438\u0439 \u043a\u0440\u043e\u0432\u044c \u0443\u0436\u0430\u0441 (\u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u043e - \u043b\u0435\u0434\u0415\u043d\u044f\u0449\u0438\u0439)\n\u0420\u0430\u0437\u0432\u0438\u0442\u0438\u0435 \u0434\u0430\u043d\u043d\u043e\u0439 \u043d\u0430\u0443\u043a\u0438 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u043b\u0438 \u0434\u0440\u0443\u0433\u0438\u0435 \u0434\u0440\u0435\u0432\u043d\u0435\u0433\u0440\u0435\u0447\u0435\u0441\u043a\u0438 \u0443\u0447\u0435\u043d\u044b\u0435 (\u0434\u0440\u0435\u0432\u043d\u0435\u0433\u0440\u0435\u0447\u0435\u0441\u043a\u0438\u0415)\n\u041f\u0440\u0438\u043d\u044f\u0442\u043e \u0441\u0447\u0438\u0442\u0430\u0442\u044c, \u0447\u0442\u043e \u0432 \u0414\u0440\u0435\u0432\u043d\u0438\u0435\u0439 \u0413\u0440\u0435\u0446\u0438\u0438 \u0441\u0430\u043c\u044b\u043c\u0438 (\u0414\u0440\u0435\u0432\u043d\u0435\u0439)\n\u041e\u0434\u043d\u0430\u043a\u0430 \u0441\u0430\u043c\u0430\u044f \u0431\u043e\u043b\u044c\u0448\u0430\u044f \u0442\u0430\u0439\u043d\u0430 \u043e\u0442 \u043c\u043d\u043e\u0433\u0438\u0445 \u0441\u043a\u0440\u044b\u0442\u0430 (\u041e\u0434\u043d\u0430\u043a\u043e)\n\u041a\u043e\u0433\u0434\u0430 \u0443\u0436\u0435 \u043d\u0430\u0447\u0430\u043b\u043e \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0430\u0442\u044c, \u0443\u0441\u0442\u0430\u043b\u043e\u0441\u044c-\u0442\u0430\u043a\u0438 \u043e\u0434\u043e\u043b\u0435\u043b\u0430 \u0435\u0433\u043e (\u0443\u0441\u0442\u0430\u043b\u043e\u0441\u0422\u044c-\u0442\u0430\u043a\u0438)\n\u043e\u0442\u0447\u0435\u0433\u043e \u0442\u043e\u0442 \u043f\u043e\u0448\u0430\u0442\u043d\u0443\u043b\u0441\u044f \u0438 \u0441 \u0442\u0440\u0443\u0434\u043e\u043c \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u043b \u0440\u043e\u0432\u043d\u043e\u0432\u0435\u0441\u0438\u0435 (\u0440\u0410\u0432\u043d\u043e\u0432\u0435\u0441\u0438\u0435)\n\u0421\u0430\u0448\u0430 \u0432\u043e\u0448\u0451\u043b \u0432 \u0432 \u043a\u0443\u043f\u0435, \u043e\u0442\u0447\u0435\u0433\u043e-\u0442\u043e \u0434\u043e\u0433\u0430\u0434\u044b\u0432\u0430\u044f\u0441\u044c (\u0434\u0432\u0430 \u043f\u0440\u0435\u0434\u043b\u043e\u0433\u0430 \"\u0432\" \u043f\u043e\u0434\u0440\u044f\u0434)\n\u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440 \u0431\u0440\u043e\u0441\u0438\u043b \u0432\u0433\u043b\u044f\u0434 \u043d\u0430 \u0436\u0443\u0440\u0443-\u043f\u0430\u0440\u0438 (\u0432\u0417\u0433\u043b\u044f\u0434)\n\u0418\u0434\u0438-\u043a\u0430 \u0442\u044b \u043f\u043e\u0434\u043e\u0431\u0440\u0443-\u043f\u043e\u0437\u0434\u043e\u0440\u043e\u0432\u043e\u043c\u0443 (\u043f\u043e\u0434\u043e\u0431\u0440\u0443-\u043f\u043e\u0437\u0434\u043e\u0440\u043e\u0432\u0443)\n\n3. \u041f\u0443\u043d\u043a\u0442\u0443\u0430\u0446\u0438\u044f \u0442\u043e\u0436\u0435 \u043d\u0430\u0448\u043b\u0430 \u043c\u0435\u0441\u0442\u043e: \u041f\u0440\u043e\u043f\u0430\u0432\u0448\u0430\u044f \u043f\u0435\u0440\u0435\u0434 \"\u0410\u043b\u0438\u0441\u043e\u0439\" \u0437\u0430\u043f\u044f\u0442\u0430\u044f \u0432\u0435\u0440\u043d\u0443\u043b\u0430\u0441\u044c \u043d\u0430 \u043c\u0435\u0441\u0442\u043e.\n\n4. \u041d\u0435\u0431\u043e\u043b\u044c\u0448\u0430\u044f \u043d\u0435\u0442\u043e\u0447\u043d\u043e\u0441\u0442\u044c \u0432 \"\u041b\u0435\u0433\u0435\u043d\u0434\u0435 \u043e \u043f\u0435\u0440\u0432\u043e\u043c \u0434\u0435\u043c\u043e\u043d\u0435\" \u0442\u043e\u0436\u0435 \u0438\u0441\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0430. \u0420\u0430\u043d\u0435\u0435 \u0434\u0432\u0430 \u043f\u043e\u0442\u043e\u043a\u0430 \u0441\u043b\u0438\u0432\u0430\u043b\u0438\u0441\u044c \u0432\u043c\u0435\u0441\u0442\u0435, \u0442\u0435\u043f\u0435\u0440\u044c \u043e\u043d\u0438 \"\u043b\u0438\u043b\u0438\u0441\u044c\" \u0432\u043c\u0435\u0441\u0442\u0435."
    },
    {
      "title": "\u041e\u0431\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0435 \u043e\u0442 15 \u0438\u044e\u043d\u044f",
      "date": "2021-06-15 08:15:28",
      "url": "https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/5019805792179110238",
      "content": "1. \u0418\u0441\u043f\u0440\u0430\u0432\u043b\u0435\u043d \u0431\u0430\u0433 \u0441 \u043a\u043e\u0441\u0442\u044e\u043c\u043e\u043c \u0433\u043b\u0430\u0432\u043d\u043e\u0433\u043e \u0433\u0435\u0440\u043e\u044f, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0442\u043e\u0442 \u043c\u043e\u0433 \u0432\u044b\u0438\u0433\u0440\u0430\u0442\u044c \u0443 \u043e\u0434\u043d\u043e\u0433\u043e \u0438\u0437 \u043f\u0430\u0441\u0441\u0430\u0436\u0438\u0440\u043e\u0432. \u041f\u043e \u0442\u0435\u043a\u0441\u0442\u0443 \u0438\u0433\u0440\u044b \u0432\u044b\u0445\u043e\u0434\u0438\u043b\u043e, \u0447\u0442\u043e \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440 \u043f\u043e\u0431\u0435\u0434\u0438\u043b, \u043e\u0434\u043d\u0430\u043a\u043e \u043f\u043e \u0444\u0430\u043a\u0442\u0443, \u0438\u0433\u0440\u044b \u0432 \u043a\u0430\u0440\u0442\u044b \u043d\u0435 \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0434\u0438\u043b\u043e, \u0438 \u0433\u0435\u0440\u043e\u0439 \u043d\u0435 \u043f\u0435\u0440\u0435\u043e\u0434\u0435\u0432\u0430\u043b\u0441\u044f. \u0422\u0435\u043f\u0435\u0440\u044c \u0437\u0430 \u043d\u043e\u0432\u044b\u0439 \u043a\u043e\u0441\u0442\u044e\u043c \u043f\u0440\u0438\u0434\u0451\u0442\u0441\u044f \u043f\u043e\u043f\u043e\u0442\u0435\u0442\u044c, \u043e\u0434\u043d\u0430\u043a\u043e \u0438 \u043d\u0430\u0433\u0440\u0430\u0434\u0430 \u0441\u0442\u0430\u043d\u0435\u0442 \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u043e\u0439: \u0436\u0435\u043d\u0438\u0445 \u0441\u0435\u0441\u0442\u0440\u044b \u0431\u0443\u0434\u0435\u0442 \u043a\u0443\u0434\u0430 \u043f\u0440\u0438\u0432\u043b\u0435\u043a\u0430\u0442\u0435\u043b\u044c\u043d\u0435\u0435 \u0432 \u043c\u043e\u0434\u043d\u043e\u043c \u043a\u043e\u0441\u0442\u044e\u043c\u0435 \u0434\u043b\u044f \u0425\u0430\u043b\u044c\u0446\u044b. \n2. \u0421\u043d\u043e\u0432\u0430 \u043e\u0440\u0444\u043e\u0433\u0440\u0430\u0444\u0438\u044f. \u0421\u043b\u043e\u0432\u043e \"\u043e\u0441\u0442\u0440\u043e\u0436\u043d\u044b\" \u0438\u0441\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u043e \u043d\u0430 \"\u043e\u0441\u0442\u043e\u0440\u043e\u0436\u043d\u044b\".\n3. \u0421\u044e\u0436\u0435\u0442\u043d\u0430\u044f \u043d\u0435\u0442\u043e\u0447\u043d\u043e\u0441\u0442\u044c. \u041c\u0438\u043c\u0451\u043d\u0433\u0432\u0438 \u0432 \u043e\u0434\u043d\u043e\u0439 \u0438\u0437 \u043a\u043d\u0438\u0433 \u0431\u0438\u0431\u043b\u0438\u043e\u0442\u0435\u043a\u0438 \u0437\u043d\u0430\u0447\u0438\u043b\u0438\u0441\u044c \u043a\u0430\u043a \u0440\u0430\u0437\u0443\u043c\u043d\u044b\u0435 \u0434\u0435\u043c\u043e\u043d\u044b. \u0418\u0441\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u043e.\n4. \u041d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043a\u043e\u0434\u043e\u0432\u044b\u0435 \u043f\u0440\u0430\u0432\u043a\u0438.\n\nPS \u0411\u043b\u0430\u0433\u043e\u0434\u0430\u0440\u043d\u043e\u0441\u0442\u044c \u0437\u0430 \u0441\u0442\u0440\u0438\u043c \u0438 \u0431\u0430\u0433-\u0440\u0435\u043f\u043e\u0440\u0442, Faanka! \u0416\u0434\u0451\u043c \u043d\u043e\u0432\u044b\u0445 \u0432\u0438\u0434\u0435\u043e \u043e\u0442 Night Lynx =)"
    },
    {
      "title": "\u041e\u0431\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0435 \u043e\u0442 6 \u0438\u044e\u043d\u044f",
      "date": "2021-06-06 13:17:10",
      "url": "https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/4093189347054471573",
      "content": "1. \u041a\u043e\u0440\u0440\u0435\u043a\u0442\u0438\u0440\u043e\u0432\u043a\u0430 \u043c\u0443\u0437\u044b\u043a\u0430\u043b\u044c\u043d\u043e\u0439 \u0447\u0430\u0441\u0442\u0438: \nHelly Tree - Hope(\u0418\u0441\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0430 \u0433\u0440\u043e\u043c\u043a\u043e\u0441\u0442\u044c)\nHelly Tree- White Silence(\u0418\u0441\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0430 \u0433\u0440\u043e\u043c\u043a\u043e\u0441\u0442\u044c)\nHelly Tree - Mindful (\u0438\u0441\u043f\u0440\u0430\u0432\u043b\u0435\u043d \u0440\u0435\u0437\u043a\u0438\u0439 \u043e\u0431\u0440\u044b\u0432 \u0432 \u043a\u043e\u043d\u0446\u0435)\nHelly Tree - Scared (\u0443\u0431\u0440\u0430\u043d\u0430 \u043b\u0438\u0448\u043d\u044f\u044f \u0442\u0438\u0448\u0438\u043d\u0430 \u0432 \u043a\u043e\u043d\u0446\u0435)\nHelly Tree - Blue Light (\u0443\u0431\u0440\u0430\u043d\u0430 \u043b\u0438\u0448\u043d\u044f\u044f \u0442\u0438\u0448\u0438\u043d\u0430)\nHelly Tree - Winter Waltz (\u0443\u0431\u0440\u0430\u043d\u0430 \u0442\u0438\u0448\u0438\u043d\u0430 \u0432 \u043a\u043e\u043d\u0446\u0435)\n2. \u041f\u0443\u043d\u043a\u0442\u0443\u0430\u0446\u0438\u044f. \u0412 \u043a\u043e\u043d\u0446\u0435 \u0432\u0435\u0442\u043a\u0438 \u0421\u0430\u0432\u0438\u0442\u0440\u0438 \u0440\u0430\u0437\u0433\u043e\u0432\u043e\u0440 \u0441 \u043f\u043e\u0432\u0430\u0440\u043e\u043c \u043d\u0435 \u0438\u043c\u0435\u043b \u0442\u043e\u0447\u043a\u0438. \u0422\u0435\u043f\u0435\u0440\u044c \u0442\u0430\u043c \u0432\u043e\u0441\u043a\u043b\u0438\u0446\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u0437\u043d\u0430\u043a.\n3. \"\u041d\u0438\u043d\u044c\u044f\" \u0442\u0435\u043f\u0435\u0440\u044c \u043d\u0430\u0437\u044b\u0432\u0430\u0435\u0442\u0441\u044f \u0432 \u0447\u0435\u0441\u0442\u044c \u041a\u0430\u0440\u0430\u0432\u0435\u043b\u043b\u044b \u041a\u043e\u043b\u0443\u043c\u0431\u0430. \u0410 \u043d\u0435 \u0432 \"\u0447\u0430\u0441\u0442\u044c\", \u043a\u0430\u043a \u044d\u0442\u043e \u0431\u044b\u043b\u043e \u0440\u0430\u043d\u0435\u0435.\n4. \u0411\u0430\u0433 \u0441 \u0440\u0435\u0447\u044c\u044e \u0441\u0442\u0430\u0440\u0448\u0435\u0433\u043e \u043f\u043e\u0447\u0442\u043c\u0435\u0439\u0441\u0442\u0435\u0440\u0430 \u0432 \u0432\u0435\u0442\u043a\u0435 \u0410\u0440. \u0422\u0435\u043f\u0435\u0440\u044c \u043c\u0443\u0436\u0447\u0438\u043d\u0430 \u0440\u0443\u0433\u0430\u0435\u0442\u0441\u044f \u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u043e. (\"\u041d\u0435 \u0438\u043c\u0435\u043b \u043d\u0438\u043a\u043e\u0433\u043e \u043f\u0440\u0430\u0432\u0430\" \u0438\u0441\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u043e \u043d\u0430 \"\u041d\u0435 \u0438\u043c\u0435\u043b \u043d\u0438\u043a\u0430\u043a\u043e\u0433\u043e \u043f\u0440\u0430\u0432\u0430\"."
    },
    {
      "title": "\u041e\u0431\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0435 \u043e\u0442 27 \u0434\u0435\u043a\u0430\u0431\u0440\u044f",
      "date": "2021-05-27 02:02:54",
      "url": "https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/4069544815355192742",
      "content": "1.  \u041e\u0431\u043b\u0435\u0433\u0447\u0451\u043d \u0432\u0445\u043e\u0434 \u043d\u0430 \u0432\u0435\u0442\u043a\u0443 \u0410\u043b\u0438\u0441\u044b. \u0420\u0430\u043d\u0435\u0435 \u0431\u044b\u043b\u043e \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e \u0438\u043c\u0435\u0442\u044c \u043f\u043b\u043e\u0445\u0438\u0435 \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f \u0441 \u0412\u0430\u043b\u0435\u0440\u0438 \u0438 \u0445\u043e\u0440\u043e\u0448\u0438\u0435 \u0441 \u0410\u043b\u0438\u0441\u043e\u0439. \u0422\u0435\u043f\u0435\u0440\u044c \u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u044f \u0441 \u0412\u0430\u043b\u0435\u0440\u0438 \u043d\u0435 \u0432\u0430\u0436\u043d\u044b, \u043f\u0440\u043e\u0441\u0442\u043e \u043d\u0435 \u043e\u0431\u0438\u0436\u0430\u0439\u0442\u0435 \u0437\u0432\u0435\u0440\u044c\u043a\u0430, \u0432\u044b\u043f\u0443\u0441\u0442\u0438\u0432 \u0435\u0433\u043e \u0438\u0437 \u043a\u043e\u0440\u043e\u0431\u043a\u0438. \n2.\u0418\u0441\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0430 \u0441\u044e\u0436\u0435\u0442\u043d\u0430\u044f \u043e\u0448\u0438\u0431\u043a\u0430 \u0432 \u0432\u0435\u0442\u043a\u0435 \u0421\u0430\u0432\u0438\u0442\u0440\u0438, \u043a\u043e\u0433\u0434\u0430 \u043e\u0434\u0435\u0436\u0434\u0430 \u0432\u043e\u0437\u043b\u0435 \u0434\u0443\u0448\u0430 \u043f\u043e\u0432\u0442\u043e\u0440\u043d\u043e \u043f\u043e\u044f\u0432\u043b\u044f\u043b\u0430\u0441\u044c \u0432 \u043f\u043e\u043c\u0435\u0449\u0435\u043d\u0438\u0438.\n3. \u0421 \u0410\u0440 \u0432\u0441\u0451 \u0442\u0435\u043f\u0435\u0440\u044c \u043d\u0435 \u0442\u0430\u043a \u043f\u0440\u043e\u0441\u0442\u043e. \u0415\u0441\u043b\u0438 \u043c\u044b \u043d\u0435 \u0441\u043f\u0430\u0441\u0430\u043b\u0438 \u0434\u0435\u0432\u0443\u0448\u043a\u0443, \u0437\u0430\u0433\u043e\u0432\u043e\u0440\u0438\u0442\u044c \u0441 \u043d\u0435\u0439 \u0432\u0435\u0447\u0435\u0440\u043e\u043c \u0431\u0443\u0434\u0435\u0442 \u043d\u0435\u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e.\n4. \u041e\u0440\u0444\u043e\u0433\u0440\u0430\u0444\u0438\u044f. \u0421\u0430\u0432\u0438\u0442\u0440\u0438 \u0432 \u043e\u0434\u043d\u043e\u043c \u043c\u0435\u0441\u0442\u0435 \u043d\u0430\u0437\u044b\u0432\u0430\u043b\u0430\u0441\u044c \"\u0421\u0430\u0432\u0438\u0440\u0438\".\n5. \u041d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043a\u043e\u0434\u043e\u0432\u044b\u0435 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f."
    },
    {
      "title": "\u041e\u0431\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0435 \u043e\u0442 26 \u043c\u0430\u044f",
      "date": "2021-05-26 04:27:22",
      "url": "https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/4069544815351919048",
      "content": "1. \u041e\u0440\u0444\u043e\u0433\u0440\u0430\u0444\u0438\u044f. \u0412\u043e \u0432\u0442\u043e\u0440\u043e\u0439 \u043c\u0438\u043d\u0438-\u0438\u0433\u0440\u0435 \u0441 \u0410\u043b\u0435\u043a\u0441\u0435\u0435\u043c \"\u0441\u041d\u0435\u043d\u0443\u0436\u043d\u043e\" ; \u041d\u0435\u0441\u0441\u0438 \u043d\u0430\u0437\u044b\u0432\u0430\u043b\u0430 \u0421\u0430\u0448\u0443 \"\u0425\u043e\u044f\u0437\u0438\u043d\" \u0432\u043c\u0435\u0441\u0442\u043e \"\u0425\u043e\u0437\u044f\u0438\u043d\".\n2. \u041f\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u0430\u044f \u043e\u0442\u0432\u0435\u0447\u0430\u044e\u0449\u0438\u0435 \u0437\u0430 \u0442\u043e\u043b\u0441\u0442\u0443\u044e \u043f\u0430\u0441\u0441\u0430\u0436\u0438\u0440\u043a\u0443 s400 \u0438\u043d\u043e\u0433\u0434\u0430 \u043f\u0443\u0442\u0430\u043b\u0430\u0441\u044c \u0441 \u043f\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0439 \u043e\u0442\u0432\u0435\u0447\u0430\u044e\u0449\u0435\u0439 \u0437\u0430 \u0425\u0430\u043b\u044c\u0446\u044b s44. \u0412 \u0441\u0432\u044f\u0437\u0438 \u0441 \u0447\u0435\u043c \u043f\u0435\u0440\u0441\u043e\u043d\u0430\u0436\u0438 \u043d\u0430\u0447\u0438\u043d\u0430\u043b\u0438 \u0433\u043e\u0432\u043e\u0440\u0438\u0442\u044c \u0447\u0443\u0436\u0438\u043c\u0438 \u0433\u043e\u043b\u043e\u0441\u0430\u043c\u0438. \u0418\u0441\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u043e. \n3. \u041c\u043e\u0442\u044b\u043b\u0451\u0432 \u0432 \u0432\u0435\u0442\u043a\u0435 \u0412\u0430\u043b\u0435\u0440\u0438 \u0432\u0441\u0451 \u043d\u0438\u043a\u0430\u043a \u043d\u0435 \u043c\u043e\u0433 \u0437\u0430\u043f\u043e\u043c\u043d\u0438\u0442\u044c \u0438\u043c\u044f \u0421\u0430\u0448\u0438, \u043d\u0430\u0437\u044b\u0432\u0430\u044f \u0435\u0433\u043e \u0421\u0435\u0440\u0433\u0435\u0435\u043c. \u0422\u0435\u043f\u0435\u0440\u044c \u043e\u043d \u0431\u043e\u0436\u0438\u0442\u0441\u044f, \u0447\u0442\u043e \u043d\u0435 \u043f\u0435\u0440\u0435\u043f\u0443\u0442\u0430\u0435\u0442. \n4. \u041d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043a\u043e\u0434\u043e\u0432\u044b\u0435 \u043f\u0440\u0430\u0432\u043a\u0438."
    },
