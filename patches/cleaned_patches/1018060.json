    {
      "title": "3\u670816\u53f7\u66f4\u65b0\u8bf4\u660e",
      "date": "2019-03-16 03:12:38",
      "url": "https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/3140604542247684333",
      "content": "\u672c\u66f4\u65b0\u6d89\u53ca\u6570\u636e\u4fee\u6539\uff0c\u8bf7\u91cd\u65b0\u5f00\u6863\u4eab\u53d7\u66f4\u597d\u7684\u6e38\u620f\u4f53\u9a8c\u3002\r\n1.\u4f18\u5316\u652f\u7ebf\u548c\u4e3b\u7ebf\u4efb\u52a1\u8bf4\u660e\u3002\r\n2.\u4fee\u590d\u652f\u7ebf\u4efb\u52a1\u91cd\u590d\u89e6\u53d1\u3002\r\n3.\u4f18\u5316\u4eba\u7269\u5c5e\u6027\u6570\u503c\u663e\u793a\uff0c\u73b0\u5728\u53ef\u4ee5\u770b\u5230\u6bcf\u4e2a\u4f63\u5175\u5f53\u524d\u7ecf\u9a8c\u3002\r\n4.\u4fee\u590d\u56fd\u738b\u7684\u6069\u8d50\u4efb\u52a1\u89e6\u53d1\u95ee\u9898\u3002\r\n5.\u4fee\u590d\u5b58\u6863\u8bfb\u53d6\u540e\u961f\u4f0d\u6210\u5458\u51fa\u9519\u7684bug\u3002\r\n6.\u4fee\u590d\u66b4\u51fb\u673a\u5236\u8ba1\u7b97\u504f\u9ad8\u7684\u95ee\u9898\u3002\r\n7.\u5f00\u653e\u7b2c\u4e09\u4e2a\u56fd\u5bb6\u5df4\u5fb7\uff0c\u4f46\u5267\u60c5\u548c\u652f\u7ebf\u4f9d\u7136\u9501\u6b7b\u3002\u968f\u4e4b\u5f00\u653e\u4e24\u4e2a\u65b0\u7684\u4f63\u5175\u3002\r\n8.\u5c1d\u8bd5\u4fee\u590d\u8fdb\u5165\u6218\u573a\u7b49\u7ea7\u663e\u793a\u4e3a1\u7684\u95ee\u9898\u3002"
    },
    {
      "title": "3\u670815\u53f7\u4e0b\u5348\u66f4\u65b0\u8bf4\u660e",
      "date": "2019-03-15 05:39:49",
      "url": "https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/3140604542244439630",
      "content": "1.\u4fee\u590d\u70ed\u9500\u54c1\u7684\u5356\u51fa\u4ef7\u683c\u4e3a0\u7684\u95ee\u9898\u3002\r\n2. \u4fee\u6539\u521d\u59cb\u80cc\u5305\u5bb9\u91cf\u4e3a500,\u63d0\u5347\u6bcf\u7ea7\u5546\u961f\u7684\u80cc\u5305\u5bb9\u91cf\u3002\r\n3.\u589e\u52a0\u5357\u9521\u56fd\u5185\u5546\u4e1a\u7ebf\u8def\u5339\u914d\uff0c\u66f4\u5bb9\u6613\u7ecf\u5546\u8d5a\u94b1\u3002\r\n4.\u4fee\u6539\u57ce\u5e02\u4fe1\u606f\u754c\u9762\uff0c\u73b0\u5728\u7684\u57ce\u5e02\u4fe1\u606f\u66f4\u52a0\u76f4\u89c2\u3002\r\n5.\u4fee\u6539\u56fd\u5bb6\u89e3\u9501\u903b\u8f91\uff0c\u4e0d\u4f1a\u51fa\u73b0\u62dc\u5229\u56fd\u89e3\u9501\u540e\u65e0\u6cd5\u8fdb\u5165\u7684\u95ee\u9898\u3002"
    }
  ]
