      "content": "1.\u589e\u5f3a\u5578\u5929\u3001\u5510\u5f6c\u3001\u4ed8\u8f7b\u6b4c\u3001\u82cf\u4e03\u4e03\u3001\u5510\u98ce\u7b49\u89d2\u8272\n2.\u8c03\u6574\u7cd6\u679c\u548c\u9ece\u66ae\u82b8\u7684\u7f81\u7eca\u548c\u4e13\u5c5e\n3.\u8c03\u6574\u6467\u57ce\u63a0\u9635\u67aa\u7684\u8ba4\u4e3b\u6548\u679c\n4.\u526f\u672c\u85cf\u5b9d\u56fe\u4e8b\u4ef6\uff0c\u5c06\u6709\u51e0\u7387\u83b7\u5f97\u5b9a\u7075\u77f3\u548c\u661f\u77f3\n5.\u526f\u672c\u5b9d\u7bb1\u9677\u9631\u3001\u5de8\u77f3\u62e6\u8def\u3001\u5b89\u846c\u5c38\u4f53\u3001\u83b7\u5f97\u9b42\u77f3\u788e\u7247\u3001\u8001\u4e5e\u4e10\u7b49\u4e8b\u4ef6\u5fae\u8c03\n6.\u589e\u52a0NPC\u643a\u5e26\u7684\u7269\u54c1\u4e2d\u51fa\u73b0\u7a00\u6709\u7269\u54c1\u7684\u51e0\u7387"
