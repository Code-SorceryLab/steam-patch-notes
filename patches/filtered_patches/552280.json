\u00a0of\u00a0Sugar\uff08\u65b9\u7cd6\u793e\uff09\u7684\u5b98\u65b9\u7f51\u7ad9\u83b7\u53d6\u3002\n\n\u00a0\u300a\u96ea\u5883\u8ff7\u9014\u9047\u4ed9\u8e2a\u300b\u662f\u7531\u65e5\u672c\u77e5\u540d\u7f8e\u5c11\u5973\u6e38\u620f\u54c1\u724c\u00a0Lump\u00a0of\u00a0Sugar\u00a0\u6700\u65b0\u5236\u4f5c\u7684\u5947\u5e7b\u604b\u7231\u4f5c\u54c1\u3002\u672c\u4f5c\u7531\u77e5\u540d\u753b\u5e08\u840c\u6728\u539f\u6587\u6b66\uff08\u4ee3\u8868\u4f5c\u300a\u6e38\u9b42\u300b\u7cfb\u5217\uff09\u62c5\u5f53\u6e38\u620f\u539f\u753b\u4e0e\u89d2\u8272\u8bbe\u8ba1\uff0c\u7531\u591a\u4f4d\u4e1a\u5185\u8d44\u6df1\u5199\u624b\u5171\u540c\u521b\u4f5c\u5267\u672c\uff0c\u7531\u77e5\u540d\u97f3\u4e50\u4eba\u65b0\u4e95\u5065\u53f2\u62c5\u5f53\u97f3\u4e50\u5236\u4f5c\uff0c\u4e3b\u9898\u6b4c\u7531\u65b9\u7cd6\u793e\u5f53\u5bb6\u6b4c\u59ecKicco\u4e0e\u65b0\u9510\u521b\u4f5c\u578b\u6b4c\u624b\u9022\u6fd1\u6676\u8054\u8882\u732e\u5531\u3002\u00a0\n[/h2]\n\n[img]{STEAM_CLAN_IMAGE}/41576605/781f09a218cef8b76b2ccd3133c4504180ce73f9.jpg[/img]",
