    {
      "title": "2023\u5e743\u670816\u65e5\u66f4\u65b0\u8bb0\u5f55",
      "date": "2023-03-16 03:59:46",
      "url": "https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/5125698536853106466",
      "content": "2023\u5e743\u670816\u65e5\u66f4\u65b0\u8bb0\u5f55\n1.\u89e3\u9664\u4e86\u4f7f\u7528\u961f\u53cb\u7269\u54c1\u7684\u597d\u611f\u5ea6\u9650\u5236\u3002\n2.\u4f18\u5316\u4e86ai\u81ea\u52a8\u6218\u6597\u7684\u903b\u8f91\u3002\n3.\u4f18\u5316\u4e86\u751f\u6210\u6280\u80fd\u7684\u7b97\u6cd5\uff0c\u589e\u52a0\u4e86\u4e0d\u540c\u6280\u80fd\u7684\u76f8\u5f02\u6027\u3002\n4.\u4fee\u590d\u4e86\u90e8\u5206\u6587\u672c\u9519\u8bef\u3002\n5.\u4fee\u590d\u4e86\u5728\u6709npc\u8fdb\u5165\u5f53\u524d\u5730\u56fe\u65f6\u6253\u5f00\u8be6\u7ec6\u4fe1\u606f\u754c\u9762\u4f1a\u5361\u6b7b\u7684bug\u3002\n6.\u4fee\u590d\u4e86\u90e8\u5206\u60c5\u666f\u4e0d\u80fd\u4e0enpc\u5bf9\u8bdd\u7684bug\u3002\n7.\u4fee\u590d\u4e86\u6280\u80fd\u7684\u6548\u679c\u4e0e\u63cf\u8ff0\u4e0d\u7b26\u7684bug\u3002\n8.\u4fee\u590d\u4e86\u4e0e\u961f\u53cb\u5bf9\u8bdd\u65f6\u4f1a\u5076\u73b0\u7a7a\u767d\u7684bug\u3002\n9.\u4fee\u590d\u4e86\u88c5\u5907\u7684\u5883\u754c\u9650\u5236\u4e0e\u63cf\u8ff0\u4e0d\u7b26\u7684bug\u3002\n10.\u4fee\u590d\u4e86\u4e0e\u975e\u95f2\u901b\u72b6\u6001\u4e0b\u7684npc\u5bf9\u8bdd\u65f6\u6709\u6982\u7387\u95ea\u9000\u7684bug\u3002\n11.\u4fee\u590d\u4e86\u8be2\u95ee\u961f\u53cb\u60f3\u8fdb\u884c\u7684\u4e8b\u4ef6\u65f6\u6709\u6709\u6982\u7387\u95ea\u9000\u7684bug\u3002\n12.\u4fee\u590d\u4e86\u6218\u6597\u4e2d\u56de\u5408\u5207\u6362\u65f6\u8fdb\u884c\u5bf9\u8bdd\u6709\u6982\u7387\u4f1a\u95ea\u9000\u7684bug\u3002\n13.\u4fee\u590d\u4e86\u4e0enpc\u5bf9\u8bdd\u65f6\u5bf9\u65b9\u5934\u50cf\u53ef\u80fd\u663e\u793a\u7a7a\u767d\u7684bug\u3002"
    },
