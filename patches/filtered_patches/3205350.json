    {
      "title": "Release Notes for Version 1.1",
      "date": "2025-01-03 11:34:50",
      "url": "https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1787858252752578",
      "content": "[h2]Features[/h2]\n[list]\n[*] Achievement tracking with 18 new achievements\n[*] Stats tracking with 40+ new player stats\n[*] New Character Mastery system, featuring XP and levels\n[*] New Stats and Mastery display menu\n[*] Added Steam Cloud Saving support\n[/list]\n[h2]Adjustments[/h2]\n[list]\n[*] Ophelia: -1 HP\n[*] Ophelia: Passive now loses Health on collision\n[*] Ophelia: Passive grants 1 extra DMG when at 1 HP\n[/list]",
      "key": "3205350::eb8226447a97a2b6761569e8677a9b5b19988ca5",
      "tags": null
    },
    {
      "title": "Release Notes for Version 1.0.2",
      "date": "2024-12-30 18:53:43",
      "url": "https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1786573930986355",
      "content": "[list]\n[*] Resolved a bug that caused CPU difficulty settings to not update correctly. Each difficulty level has also been fully reworked.\n[*] Achievements now appear on the store page! While they can't be unlocked yet, they'll be available in version 1.1\u2014stay tuned!\n[/list]\n",
      "key": "3205350::b87fc755e04bebd5260a441eec6f59e437aa885d",
      "tags": null
    },
    {
      "title": "Release Notes for Version 1.0.1",
      "date": "2024-12-30 09:49:17",
      "url": "https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1786573930974397",
      "content": "[list]\n[*] Added tracking of in-game stats in preparation for future updates.\n[*] Don Gordo now only steals as many bullets as he can hold.\n[*] Slightly lowered all CPU difficulties.\n[*] Fixed visual effects for stats exceeding their limit.\n[*] Fixed damage overlay showing the wrong color for healing.\n[*] Enhanced visual elements in the tutorial.\n[*] Made the tutorial replayable.\n[*] Default health bars setting reduced to 1\n[*] Custom song loader now supports MP3 files.\n[/list]",
      "key": "3205350::d8dd20c06a697050127b65c7485aa80f81b03e61",
      "tags": null
    },
