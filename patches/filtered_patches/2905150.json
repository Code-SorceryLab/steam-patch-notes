      "content": "\n1.\u4fee\u6539350+\u5c42\u4ee5\u4e0a\u88c5\u5907\u6389\u843d\u533a\u95f4\u53bb\u9664\u4f4e\u9636\u88c5\u5907\n2.\u8865\u507f\u53e3\u4ee4\"\u516d\u6708\u52a0\u6cb9\"\n3.400\u5c42BOSS\u989d\u5916 \u6982\u7387\u83b7\u5f97\u8d24\u8005\u548c\u5947\u8ff9\u5b9d\u77f3 \u6df1\u6e0a\u7ffb\u500d\n4.\u65b0\u589e\u5c42\u6570\u81f3400\u5c42\u6570\n5.\u65b0\u589e\u7b49\u7ea7\u4e0a\u9650\u81f390\u7ea7\n6.\u65b0\u589e\u6570\u4e2a\u65b0\u5929\u8d4b\n7.\u9b54\u529b\u589e\u5e45\u6280\u80fd\u589e\u4f24\u6539\u4e3a\u6bcf12\u70b9\u589e\u5e451%\u589e\u4f24\n8.\u90e8\u5206\u5929\u8d4b\u5206\u652f\u6811\u70b9\u51fb\u9519\u8bef\u65e0\u6cd5\u63d0\u5347\u95ee\u9898\n9.\u90e8\u5206\u53cd\u9988\u7ec6\u8282\u95ee\u9898\n10.\u52a0\u5f3a\u53ec\u5524\u7c7b\u5929\u8d4b\u63d0\u5347\u4f24\u5bb3\u6570\u503c\n"
    },
