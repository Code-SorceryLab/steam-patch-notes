      "content": "1.\u52a0\u5165\u4e86\u7262\u623f\u3001\u9601\u697c\u4e24\u4e2a\u5efa\u7b51\uff1b\r\n2.\u6b66\u5c06\u6280\u80fd\u8c03\u6574\uff0c\u5e73\u8861\u4e86\u6b66\u5c06\u7684\u6570\u503c\uff1b\r\n3.\u6b66\u5668\u7cfb\u7edf\u52a0\u5165\uff0c\u6b66\u5c06\u53ef\u4ee5\u88c5\u5907\u6b66\u5668\u548c\u9632\u5177\uff1b\r\n4.\u65b0\u589e\u4e86\u5916\u4ea4\u6a21\u5757\uff0c\u53ef\u4ee5\u7ed3\u76df\uff0c\u4e5f\u53ef\u4ee5\u6253\u538b\u5176\u4ed6\u52bf\u529b\uff0c\u904f\u5236\u5176\u5feb\u901f\u53d1\u5c55\uff1b\r\n5.\u4e89\u9738\u6a21\u5f0f\u4e2d\u65b0\u52a0\u4e86\u5e7b\u60f3\u6a21\u5f0f\uff0c\u6b66\u5c06\u968f\u673a\u52a0\u5165\u5404\u4e2a\u52bf\u529b\uff0c\u8be5\u6a21\u5f0f\u66f4\u9002\u5408\u4e00\u4e9b\u559c\u6b22\u51b7\u95e8\u52bf\u529b\u7684\u73a9\u5bb6\uff1b\r\n6.\u5176\u5b83\u4e00\u4e9b\u7ec6\u8282\u4f18\u5316\u3002\r\n\u6e38\u620f\u5f00\u53d1\u8fc7\u7a0b\u4e2d\uff0c\u6536\u5230\u8bb8\u591a\u4e09\u56fd\u73a9\u5bb6\u7684\u4f18\u8d28\u53cd\u9988\u3002\r\n\u6700\u540e\u611f\u8c22\u73a9\u5bb6\u4eec\u7684\u652f\u6301\u4e0e\u539a\u7231\uff0c\u611f\u8c22\u73a9\u5bb6\u4eec\u7684\u65e0\u79c1\u5e2e\u52a9\u3002"
    }
  ]
