    {
      "title": "v0.23\uff08Demo v1.24\u6d4b\u8bd5\u7248\uff09\u66f4\u65b0",
      "date": "2024-08-21 01:23:08",
      "url": "https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/5875595438683356036",
      "content": "\u867d\u7136\u5bf9\u4f60\u4eec\u6765\u8bf4\u8fd9\u6b21\u66f4\u65b0\u6ca1\u4ec0\u4e48\u5185\u5bb9\u4f46\u5176\u5b9e\u51b3\u5b9a\u4e86\u540e\u7eed\u6e38\u620f\u5236\u4f5c\u65b9\u5411\uff08\n\u672c\u6b21\u66f4\u65b0\u5185\u5bb9\u5982\u4e0b\n1. \u5bf9\u7b2c\u4e00\u7ae0\u6e38\u620f\u6d41\u7a0b\u8fdb\u884c\u4e86\u5c0f\u5e45\u5ea6\u4fee\u6539\uff0c\u73b0\u5728\u4e0d\u53ea\u6709\u4e00\u79cd\u89e3\n2. \u5bf9\u7b2c\u4e8c\u7ae0\u94a2\u7434\u4fee\u590d\u6311\u6218\u7684\u5e73\u8861\u505a\u51fa\u4e86\u8c03\u6574\uff0c\u5c31\u522b\u60f3\u7740\u9b3c\u9b42\u6478\u9c7c\u4f60\u5c31\u53ef\u4ee5\u4e00\u76f4\u6309\u6b7b\u4e86\n3. \u52a0\u5165\u4e86\u4e00\u4e2a\u5168\u65b0\u7ec4\u4ef6\uff0c\u7b14\u8bb0\u672c\uff0c\u5b83\u662f\u4e00\u4e2a\u96c6\u6210\u5de5\u5177\uff0c\u5305\u542b\u4e86\u4efb\u52a1\u63d0\u793a\uff0c\u6536\u96c6\u54c1\uff0c\u624b\u52a8\u5b58\u6863\uff0c\u76ae\u80a4\u7b49\u5185\u5bb9\uff0c\u76ee\u524d\u7248\u672c\u5f00\u653e\u5236\u4f5c\u96be\u5ea6\u6700\u5927\u4e14\u6700\u91cd\u8981\u7684\u6536\u85cf\u54c1\u548c\u4efb\u52a1\u63d0\u793a\u529f\u80fd\uff0c\u5b83\u4eec\u4e0d\u591f\u5b8c\u5584\uff0c\u9700\u8981\u591a\u6b21\u4f18\u5316\uff0c\u5f88\u613f\u610f\u503e\u542c\u5927\u5bb6\u610f\u89c1\n4. \u5bf9\u90e8\u5206\u610f\u4e49\u4e0d\u660e\u5bb9\u6613\u6b7b\u4ea1\u7684\u5730\u65b9\u505a\u4e86\u989d\u5916\u7684\u5f15\u5bfc\u548c\u63d0\u793a\uff0c\u518d\u6b7b\u7684\u8bdd\u5f97\u6000\u7591\u662f\u4e0d\u662f\u6709\u70b9\u624b\u6b20\u4e86\u554a( \u0361\u00b0 \u035c\u0296 \u0361\u00b0)",
      "key": "3107630::dfce71dabfb00b82f66dfcee8a4854ca71766fea",
      "tags": null
    },
