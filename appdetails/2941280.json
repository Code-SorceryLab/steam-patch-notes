    "about_the_game": "<p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2941280/extras/2811ba303a2ba429c38c0002b7c1643f.avif?t=1755318950\" width=494 height=100 /></span> </p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><strong>\u201c\u7b49\u5019\u5343\u5e74\uff0c\u7ec8\u4e8e\u4e0e\u4f60\u76f8\u9047\u4e86\uff0c\u6211\u7684\u4e3b\u4eba\u3002\u201d</strong> </p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2941280/extras/386e72c561b2582d70da286f573943bd.avif?t=1755318950\" width=1028 height=734 /></span></p><p class=\"bb_paragraph\" >\u5373\u4f7f\u6ca1\u6709\u624d\u80fd\uff0c\u4e5f\u6e34\u671b\u6210\u4e3a\u672f\u58eb\u7684\u4e3b\u4eba\u516c\uff0c<strong>\u9646\u98de\u9e64</strong>\u3002 <br>\u5979\u5f3a\u884c\u5f00\u542f\u5951\u7ea6\u4eea\u5f0f\uff0c\u53ec\u5524\u51fa\u5c5e\u4e8e\u81ea\u5df1\u7684\u5996\u602a\u4ec6\u4ece </p><p class=\"bb_paragraph\" >\u90a3\u7adf\u7136\u662f\u8fd9\u5ea7\u65b0\u6708\u57ce\u8fd1\u5343\u5e74\u5386\u53f2\u4e2d\uff0c\u6700\u5f3a\u5927\uff0c\u6700\u6709\u624d\u80fd\u7684\u732b\u5996\uff0c<strong>\u6e0a\u4e4b</strong></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2941280/extras/e32c8a06df700a76ab9a61d4a4808828.webp?t=1755318950\" width=1000 height=42 /></span></p><p class=\"bb_paragraph\" >\u73b0\u4ee3\u56fd\u98ce\u5947\u5e7b\u9898\u6750 \u00d7 \u738b\u9053\u5192\u9669\u604b\u7231\u6545\u4e8b\u3002</p><p class=\"bb_paragraph\" ><strong>\u5973\u4e3b\u4eba\u516c</strong>\u4e3a\u7b2c\u4e00\u89c6\u89d2\uff0c\u53ef\u653b\u7565\u7537\u6027\u4e3b\u8981\u89d2\u8272\u6682\u5b9a1\u540d\uff0c\u7537\u6027\u6b21\u8981\u89d2\u8272\u6682\u5b9a3\u540d\u3002  </p><p class=\"bb_paragraph\" >\u6574\u4f53\u65f6\u957f\u6682\u5b9a\u7ea65h\uff08\u4e3b\u7ebf\u5267\u60c5\u6587\u672c\u7ea620~30\u4e07\u5b57\uff09\uff0c\u6b63\u5f0f\u7ed3\u5c40\u6570\u91cf3\u4e2a\u6216\u4ee5\u4e0a\u3002</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2941280/extras/e32c8a06df700a76ab9a61d4a4808828.webp?t=1755318950\" width=1000 height=42 /></span></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2941280/extras/42af6357bcab6fabe2a6925b2259e408.avif?t=1755318950\" width=494 height=100 /></span></p><p class=\"bb_paragraph\" ></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>\u6e38\u620f\u4e3b\u6807\u9898\uff1a</strong>\u9065\u5cb8\u706f\u6d77</p></li><li><p class=\"bb_paragraph\" ><strong>\u6e38\u620f\u526f\u6807\u9898\uff1a</strong>\u5343\u5e74\u5996\u7eee\u8c2d</p><p class=\"bb_paragraph\" ></p></li><li><p class=\"bb_paragraph\" ><strong>\u9898\u6750\u5143\u7d20\uff1a</strong>\u73b0\u4ee3\u56fd\u98ce\u5947\u5e7b\u00d7\u4eba\u4e0e\u5996\u602a\u00d7\u4e3b\u4ec6</p></li><li><p class=\"bb_paragraph\" ><strong>\u98ce\u683c\u7279\u70b9\uff1a</strong>\u738b\u9053\u5192\u9669\u604b\u7231\u00d7\u5973\u6027\u4e3b\u4eba\u516c</p></li><li><p class=\"bb_paragraph\" ><strong>\u7c7b\u578b\u73a9\u6cd5\uff1a</strong>\u89c6\u89c9\u5c0f\u8bf4\uff08\u542b\u63a2\u7d22\u6536\u96c6\u53ca\u8f7b\u5ea6\u89e3\u8c1c\u8981\u7d20\uff09</p><p class=\"bb_paragraph\" ></p></li><li><p class=\"bb_paragraph\" ><strong>\u6587\u672c\u4f53\u91cf\uff1a</strong>\u4e3b\u7ebf\u5267\u60c520\u4e07\u5b57\uff08\u6682\uff09</p></li><li><p class=\"bb_paragraph\" ><strong>CG\u63d2\u56fe\uff1a</strong>10\u5f20\uff08\u6682\uff09</p><p class=\"bb_paragraph\" ></p></li><li><p class=\"bb_paragraph\" ><strong>\u53d1\u5e03\u65f6\u671f\uff1a</strong>2026\u5e74\u7b2c\u4e8c\u5b63\u5ea6\uff08\u6682\uff09</p></li></ul><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2941280/extras/70902ebd408c6656514db761bd3338ce.avif?t=1755318950\" width=494 height=100 /></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2941280/extras/328740114a4dc6cefc98efc05612e496.avif?t=1755318950\" width=1000 height=4000 /></span></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2941280/extras/a0f0985110a378c24151425f983cda12.avif?t=1755318950\" width=1000 height=4000 /></span></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2941280/extras/0caaaa070fb16f345343818b82a4e13a.avif?t=1755318950\" width=1000 height=4000 /></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2941280/extras/fe7a39b61b4b3223fac68e35941cd986.avif?t=1755318950\" width=494 height=100 /></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>\u4fe1\u4efb\u5ea6\u9009\u9879\uff1a</strong>\u90e8\u5206\u540e\u7eed\u5267\u60c5\u53ca\u9009\u9879\uff0c\u9700\u8981\u4fe1\u4efb\u5ea6\u79ef\u7d2f\u5230\u4e00\u5b9a\u7a0b\u5ea6\u624d\u80fd\u89e3\u9501</p></li><li><p class=\"bb_paragraph\" ><strong>\u7ed3\u5c40\u5206\u6b67\u9009\u9879\uff1a</strong>\u90e8\u5206\u9009\u9879\u76f4\u63a5\u901a\u5f80\u4e2a\u522b\u7ed3\u5c40\u3002</p><p class=\"bb_paragraph\" ></p></li><li><p class=\"bb_paragraph\" ><strong>\u97f3\u9636\u987a\u5e8f\u8bb0\u5fc6\uff1a</strong>\u542c\u77ed\u97f3\u9891\uff0c\u53ca\u9605\u8bfb\u6587\u5b57\u63d0\u793a\uff0c\u6309\u987a\u5e8f\u6309\u952e\u3002</p></li><li><p class=\"bb_paragraph\" ><strong>\u8ff7\u4f60\u5730\u56fe\uff1a</strong>\u90e8\u5206\u5267\u60c5\u4e2d\u53ef\u524d\u5f80\u652f\u7ebf\u5267\u60c5\u5730\u70b9\u3002</p><p class=\"bb_paragraph\" ></p></li><li><p class=\"bb_paragraph\" ><strong>\u63a2\u7d22\u6536\u96c6\uff1a</strong>\u5728\u5730\u56fe\u4e2d\u9009\u62e9\u89c2\u770b\u77ed\u7bc7\u5267\u60c5\uff0c\u6536\u96c6\u9053\u5177\u53ca\u6709\u6587\u5b57\u5185\u5bb9\u7684\u4e66\u9875\u3002</p></li><li><p class=\"bb_paragraph\" ><strong>\u6536\u85cf\u6a21\u5f0f\uff1a</strong>\u5305\u542b\u63d2\u56fe\u753b\u5eca\u3001\u989d\u5916\u5267\u60c5\u7b49\u3002</p></li></ul><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2941280/extras/e32c8a06df700a76ab9a61d4a4808828.webp?t=1755318950\" width=1000 height=42 /></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><strong>\u5236\u4f5c\u4eba\u5458\u540d\u5355</strong>  </p><p class=\"bb_paragraph\" >\u7b56\u5212/\u6587\u6848\u5267\u672c/\u5ba3\u4f20\u8bbe\u8ba1\uff1a\u672a\u6765\u8f68\u8ff9</p><p class=\"bb_paragraph\" >\u89d2\u8272\u8bbe\u8ba1\uff1a\u6e05\u9c7c/\u7535\u7535DD</p><p class=\"bb_paragraph\" >\u7acb\u7ed8/\u63d2\u56fe\uff1a\u6e05\u9c7c</p><p class=\"bb_paragraph\" >\u80cc\u666f\u63d2\u56fe\uff1a\u9690\u5c71\u6da7\u3010\u7d20\u6750\u3011/\u5341\u4e8c\u96c0\u9152\u3010\u7d20\u6750\u3011/\u58f9\u4eba\u7ec4-\u98ce\u516e\u3010\u7d20\u6750\u3011/\u5747\u6db5\u3010\u7d20\u6750\u3011/\u307f\u306b\u304f\u308b\u3010\u7d20\u6750\u3011</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >LOGO\u8bbe\u8ba1\uff1a\u6625\u5c71</p><p class=\"bb_paragraph\" >UI\u8bbe\u8ba1\uff1a\u672a\u6765\u8f68\u8ff9 </p><p class=\"bb_paragraph\" >UI\u7d20\u6750\u6765\u6e90\uff1a\u5154\u5494\u3010\u7d20\u6750\u3011/\u95f2\u4eba\u534a\u751f\u3010\u7d20\u6750\u3011 </p><p class=\"bb_paragraph\" > </p><p class=\"bb_paragraph\" >\u80cc\u666f\u97f3\u4e50\uff1aalpaca\u5495\u565c/PeriTune\u3010\u7d20\u6750\u3011</p><p class=\"bb_paragraph\" >\u97f3\u4e50\u534f\u529b\uff1a\u697d\u51b0</p><p class=\"bb_paragraph\" >\u97f3\u6548\uff1a\u52b9\u679c\u97f3\u30e9\u30dc\u3010\u7d20\u6750\u3011/On-Jin ~\u97f3\u4eba\u3010\u7d20\u6750\u3011/\u2026\u2026</p><p class=\"bb_paragraph\" >\u7a0b\u5e8f\uff1a\u672a\u6765\u8f68\u8ff9/joh/\u8c46\u5362\u53f6\u82bd </p><p class=\"bb_paragraph\" >\u7279\u522b\u611f\u8c22\uff1a\u6240\u6709\u66fe\u5728\u5236\u4f5c\u8fc7\u7a0b\u4e2d\u5e2e\u52a9\u8fc7\u5236\u4f5c\u7ec4\u7684\u8001\u5e08\uff0c\u4ee5\u53ca\u6b63\u5728\u9605\u8bfb\u8fd9\u4e2a\u9875\u9762\u7684\u4f60</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2941280/extras/e32c8a06df700a76ab9a61d4a4808828.webp?t=1755318950\" width=1000 height=42 /></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><strong>\u5982\u60a8\u5bf9\u672c\u6e38\u620f\u611f\u5174\u8da3\uff0c\u6b22\u8fce\u60a8\u5c06\u672c\u6e38\u620f\u52a0\u5165\u613f\u671b\u5355\uff0c\u5728\u6469\u70b9\u521b\u610f\u70b9\u51fb\u770b\u597d\uff0c\u6216\u5728\u5404\u5927\u5e73\u53f0\u7559\u8a00\u6709\u5173\u672c\u6e38\u620f\u7684\u5efa\u8bae\u53cd\u9988\uff01</strong></p><p class=\"bb_paragraph\" >\u90e8\u5206\u5b98\u65b9\u8054\u7cfb\u6e20\u9053\u53c2\u89c1\u9875\u9762\u53f3\u4fa7\u793e\u5a92\u5e73\u53f0\u4fe1\u606f\u3002</p>",
    "short_description": "\u51fa\u8eab\u672f\u58eb\u540d\u95e8\u5374\u6ca1\u6709\u5929\u8d4b\u7684\u4eba\u7c7b\u5c11\u5973\uff0c\u5728\u673a\u7f18\u5de7\u5408\u4e4b\u4e0b\u5f97\u5230\u4e86\u548c\u57ce\u5185\u6700\u5f3a\u5927\u7684\u732b\u5996\u7b7e\u8ba2\u5951\u7ea6\u7684\u673a\u4f1a\u3002\u76f4\u5230\u67d0\u4e2a\u671f\u9650\u2014\u2014\u706f\u6d77\u8282\u2014\u2014\u5230\u6765\u524d\uff0c\u5979\u90fd\u4e3a\u4e86\u6210\u4e3a\u51fa\u8272\u7684\u672f\u58eb\u800c\u4e0d\u65ad\u52aa\u529b\u3002\u5c3d\u7ba1\u5979\u8eab\u8fb9\u7684\u732b\u5996\uff0c\u4f3c\u4e4e\u5e76\u4e0d\u7406\u89e3\u5979\u7684\u5fc3\u613f\u3002",
