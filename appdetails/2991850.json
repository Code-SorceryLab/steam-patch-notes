uted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2991850/extras/7107fdb62f20b77db41457486ee211eb.poster.avif?t=1740917100\" width=598 height=262 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2991850/extras/7107fdb62f20b77db41457486ee211eb.webm?t=1740917100\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2991850/extras/7107fdb62f20b77db41457486ee211eb.mp4?t=1740917100\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >&quot;</p>",
