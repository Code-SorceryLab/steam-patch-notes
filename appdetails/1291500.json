ay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1291500/extras/299a273429f2112eb84e3e6046144aaa.poster.avif?t=1713279729\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1291500/extras/299a273429f2112eb84e3e6046144aaa.webm?t=1713279729\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1291500/extras/299a273429f2112eb84e3e6046144aaa.mp4?t=1713279729\" type=\"video/mp4\"></video></div><br><div class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1291500/extras/eb3898cb30e939660ab2e80b4aa8e05a.poster.avif?t=1713279729\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1291500/extras/eb3898cb30e939660ab2e80b4aa8e05a.webm?t=1713279729\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1291500/extras/eb3898cb30e939660ab2e80b4aa8e05a.mp4?t=1713279729\" type=\"video/mp4\"></video></div><br><div class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1291500/extras/84a8b1623350ffbcb76b066338c80810.poster.avif?t=1713279729\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1291500/extras/84a8b1623350ffbcb76b066338c80810.webm?t=1713279729\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1291500/extras/84a8b1623350ffbcb76b066338c80810.mp4?t=1713279729\" type=\"video/mp4\"></video></div><br><div class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1291500/extras/d6b9bd3d8954a29496dcf91fc8e6e1b3.poster.avif?t=1713279729\" ><source src=\"https://