deo class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1367300/extras/0b8040c94509f0e40731e18ca7ce1e14.poster.avif?t=1723790386\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1367300/extras/0b8040c94509f0e40731e18ca7ce1e14.webm?t=1723790386\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1367300/extras/0b8040c94509f0e40731e18ca7ce1e14.mp4?t=1723790386\" type=\"video/mp4\"></video></div>",
