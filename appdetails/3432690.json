{
    "type": "game",
    "name": "\u63a8\u7406\u5c0f\u8bf4\u7684\u5173\u952e\u4e00\u5b9a\u4f1a\u51fa\u73b0\u4e24\u6b21",
    "steam_appid": 3432690,
    "required_age": 0,
    "is_free": false,
    "detailed_description": "<h2 class=\"bb_tag\" >\u25a0 \u6545\u4e8b\u7b80\u4ecb</h2><p class=\"bb_paragraph\" >\u4eca\u65e5\u7684\u5357\u5317\u5927\u5b66\u63a8\u7406\u534f\u4f1a\uff0c\u98ce\u513f\u683c\u5916\u55a7\u56a3\u3002</p><p class=\"bb_paragraph\" >    \u6c89\u8ff7\u63a8\u7406\u5c0f\u8bf4\u7684\u4f1a\u957f\u7adf\u7136\u906d\u5230\u4e86\u4e66\u8bb0\u7684\u63a8\u7406\u6311\u6218\u3002</p><p class=\"bb_paragraph\" >    \u4ed6\u80fd\u5728\u96f6\u96f6\u661f\u661f\u7684\u7ebf\u7d22\u4e2d\u627e\u5230\u8c1c\u56e2\u7684\u7b54\u6848\u5417\uff1f</p><p class=\"bb_paragraph\" >\u7075\u6d3b\u5229\u7528\u201d\u4e24\u4e2a\u7ebf\u7d22\u201c\u4e4b\u95f4\u7684\u7ec4\u5408\uff0c\u53d1\u73b0\u53cd\u590d\u51fa\u73b0\u7684\u5173\u952e\u4fe1\u606f\uff01</p><p class=\"bb_paragraph\" >\u53d1\u73b0\u5173\u8054\uff01\u6307\u51fa\u77db\u76fe\uff01</p><p class=\"bb_paragraph\" >\u800c\u66f4\u591a\u7684\u6545\u4e8b\uff0c\u8fd8\u5c06\u5728\u4e4b\u540e\u5c55\u5f00\u2014\u2014</p><p class=\"bb_paragraph\" >    </p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" >\u25a0 \u6e38\u620f\u6982\u8ff0</h2><p class=\"bb_paragraph\" >\u300a\u63a8\u7406\u5c0f\u8bf4\u7684\u5173\u952e\u4e00\u5b9a\u4f1a\u51fa\u73b0\u4e24\u6b21\u300b\u662f\u4e00\u90e8\u4ee5\u65e5\u5e38\u63a8\u7406\u4e3a\u6838\u5fc3\u7684\u89c6\u89c9\u5c0f\u8bf4\u3002\u73a9\u5bb6\u5c06\u626e\u6f14<strong>\u5357\u5317\u5927\u5b66\u63a8\u7406\u534f\u4f1a</strong>\u7684<strong>\u5218\u5915\u58f0</strong>\u3002\u9700\u8981\u5728\u573a\u666f\u4e2d\u8c03\u67e5\u3001\u4ea4\u8c08\u3001\u601d\u8003\u83b7\u5f97\u7ebf\u7d22\uff0c\u5e76\u901a\u8fc7\u201c\u53d1\u73b0\u5173\u8054\u201d\u6216\u662f\u201c\u6307\u51fa\u77db\u76fe\u201d\u5bf9\u7ebf\u7d22\u4eec\u8fdb\u884c\u7ec4\u5408\uff0c\u5e76\u9009\u62e9\u5408\u9002\u7684\u7ebf\u7d22\u56de\u7b54\u7ae0\u8282\u5185\u7684\u95ee\u9898\u63a8\u8fdb\u6545\u4e8b\u53d1\u5c55\u3002</p><p class=\"bb_paragraph\" >\u4e0e\u5927\u591a\u6570\u4ee5\u5211\u4e8b\u6848\u4ef6\u4e3a\u63a8\u7406\u5bf9\u8c61\u7684\u6545\u4e8b\u4e0d\u540c\uff0c\u6211\u4eec\u81f4\u529b\u4ee5\u5927\u5b66\u6821\u56ed\u5185\u5916\u4e3a\u821e\u53f0\uff0c\u53d1\u73b0\u90a3\u4e9b\u201c\u4e0d\u89e3\u51b3\u4e5f\u53ef\u4ee5\u201d\u7684\u5c0f\u5c0f\u8c1c\u9898\uff0c\u521b\u9020\u8f7b\u677e\u6709\u8da3\u7684\u4f53\u9a8c\u3002\u5e0c\u671b\u60a8\u80fd\u5728\u4eab\u53d7\u63a8\u7406\u8fc7\u7a0b\u7684\u540c\u65f6\uff0c\u4e5f\u80fd\u4f53\u4f1a\u5230\u7531\u5f62\u5f62\u8272\u8272\u4eba\u7269\u4ea4\u7ec7\u800c\u6210\u7684\u201c\u65e5\u5e38\u201d\u4e4b\u9b45\u529b\u3002</p><h2 class=\"bb_tag\" ></h2><h2 class=\"bb_tag\" >\u25a0 \u6e38\u620f\u7279\u8272</h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>\u76f4\u767d\u7ecf\u5178\u7684\u7ec4\u5408\u73a9\u6cd5</strong></p><p class=\"bb_paragraph\" >\u601d\u8003\u7ebf\u7d22\u95f4\u7684\u5173\u7cfb\uff0c\u53d1\u73b0\u5b83\u4eec\u7684\u5173\u8054\u6216\u662f\u77db\u76fe\uff0c\u4ee5\u6b64\u521b\u9020\u65b0\u7684\u7ebf\u7d22\u3002\u5728\u903b\u8f91\u94fe\u6761\u7684\u7ec8\u70b9\u4e00\u5b9a\u80fd\u627e\u5230\u8c1c\u9898\u95ee\u9898\u7684\u7b54\u6848\uff01\u4e0d\u5fc5\u62c5\u5fc3\u96be\u5ea6\u8fc7\u5927\uff0c\u6216\u8bb8\u5c0f\u5c0f\u7684\u732b\u5934\u9e70\u52a9\u624b\u6b63\u5728\u7b49\u5f85\u5e2e\u52a9\u4f60~\uff08\u63d0\u793a\u529f\u80fd\u53ef\u5173\u95ed\uff09</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3432690/extras/a6f82cadda5c1981924fc517444d3678.avif?t=1747479555\" width=382 height=250 /></span></p></li><li><p class=\"bb_paragraph\" ><strong>\u6e05\u65b0\u660e\u5feb\u7684\u7f8e\u672f\u98ce\u683c</strong></p><p class=\"bb_paragraph\" >\u6211\u4eec\u4f7f\u7528Live2D\u6280\u672f\u5236\u4f5c\u7684\u4eba\u7269\u7acb\u7ed8\u751f\u52a8\u800c\u5bcc\u4e8e\u8868\u60c5\u3002\u800c\u5728\u5267\u60c5\u4e2d\u8fd8\u6709\u7b80\u5355\u7684\u5c0f\u6f2b\u753b\u683c\u5e2e\u52a9\u7406\u89e3\u6545\u4e8b\u3002</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3432690/extras/aff13f148e11e973c203b22007010d79.avif?t=1747479555\" width=800 height=430 /></span></p></li><li><p class=\"bb_paragraph\" ><strong>\u5404\u5177\u751f\u547d\u7684\u591a\u5f69\u89d2\u8272</strong></p></li></ul><p class=\"bb_paragraph\" >\u00a0 \u00a0 \u5728\u6570\u4e2a\u5c0f\u65f6\u7684\u6e38\u620f\u65f6\u957f\u4e2d\uff0c\u89d2\u8272\u4eec\u5c06\u8f6e\u756a\u4e0a\u573a\uff0c\u5feb\u53bb\u53d1\u6398\u4ed6\u4eec\u5404\u81ea\u7684\u53ef\u7231\u4e4b\u5904\u5427~</p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" >\u25a0 \u90e8\u5206\u89d2\u8272\u4ecb\u7ecd</h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>\u5218\u5915\u58f0</strong></p></li></ul><p class=\"bb_paragraph\" >\u6545\u4e8b\u7684\u4e3b\u4eba\u516c\u3002\u5357\u5317\u5927\u5b66\u63a8\u7406\u534f\u4f1a\u4f1a\u957f\uff0c\u81ea\u8ba4\u4e3a\u904d\u89c8\u63a8\u7406\u5c0f\u8bf4\u3002\u5b9e\u9645\u4e0a\u5f85\u4eba\u63a5\u7269\u5e38\u6709\u8fdf\u949d\u6216\u53e4\u602a\u4e4b\u5904\u3002\u5076\u5c14\u7684\u7075\u5149\u4e00\u73b0\u65e2\u53ef\u4ee5\u89e3\u51b3\u96be\u9898\uff0c\u4e5f\u53ef\u4ee5\u8ba9\u4eba\u65e0\u8bed\u81f3\u6781\u3002</p><p class=\"bb_paragraph\" ></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u201c<strong>\u4e66\u8bb0\u201d</strong></p></li></ul><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3432690/extras/064dbb35d8119e10ed367770d769d87b.avif?t=1747479555\" width=198 height=208 /></span></p><p class=\"bb_paragraph\" >\u7531\u4e8e\u67d0\u79cd\u7f18\u7531\u52a0\u5165\u63a8\u7406\u534f\u4f1a\u4efb\u804c\u4e66\u8bb0\uff0c\u56e0\u800c\u88ab\u4f1a\u957f\u4ee5\u53ca\u5927\u5bb6\u79f0\u4e3a\u201c\u4e66\u8bb0\u201d\u3002\u5341\u5206\u7231\u8bfb\u63a8\u7406\u5c0f\u8bf4\uff0c\u800c\u4e14\u4f3c\u4e4e\u79c1\u5e95\u4e0b\u6709\u5728\u5077\u5077\u521b\u4f5c\u3002\u6027\u683c\u6587\u9759\uff0c\u6709\u65f6\u5374\u613f\u610f\u548c\u4f1a\u957f\u4e00\u8d77\u80e1\u95f9\uff0c\u5927\u6982\u662f\u4e3a\u4e86\u5145\u5f53\u5410\u69fd\u5f79\u3002\u601d\u8003\u65b9\u5f0f\u7406\u6027\u800c\u5b9e\u9645\uff0c\u5076\u5c14\u4e5f\u6709\u6d41\u9732\u611f\u60c5\u7684\u4e00\u9762\u3002\u559c\u6b22\u53ef\u7231\u7684\u4e1c\u897f\uff0c\u6bd4\u5982\u5154\u5b50\u548c\u718a\u3002</p><p class=\"bb_paragraph\" >-----------------------------------------------------------------------</p><p class=\"bb_paragraph\" >\u203b\u6e38\u620f\u4ecd\u5728\u5f00\u53d1\u4e2d\uff0c\u4e00\u5207\u4ee5\u5b9e\u9645\u53d1\u5e03\u5185\u5bb9\u4e3a\u51c6</p><p class=\"bb_paragraph\" >\u203b\u6b63\u5f0f\u7248\u9884\u8ba1\u4f1a\u6709\u4e94\u4e2a\u7ae0\u8282\u7684\u5185\u5bb9</p>",
    "about_the_game": "<h2 class=\"bb_tag\" >\u25a0 \u6545\u4e8b\u7b80\u4ecb</h2><p class=\"bb_paragraph\" >\u4eca\u65e5\u7684\u5357\u5317\u5927\u5b66\u63a8\u7406\u534f\u4f1a\uff0c\u98ce\u513f\u683c\u5916\u55a7\u56a3\u3002</p><p class=\"bb_paragraph\" >    \u6c89\u8ff7\u63a8\u7406\u5c0f\u8bf4\u7684\u4f1a\u957f\u7adf\u7136\u906d\u5230\u4e86\u4e66\u8bb0\u7684\u63a8\u7406\u6311\u6218\u3002</p><p class=\"bb_paragraph\" >    \u4ed6\u80fd\u5728\u96f6\u96f6\u661f\u661f\u7684\u7ebf\u7d22\u4e2d\u627e\u5230\u8c1c\u56e2\u7684\u7b54\u6848\u5417\uff1f</p><p class=\"bb_paragraph\" >\u7075\u6d3b\u5229\u7528\u201d\u4e24\u4e2a\u7ebf\u7d22\u201c\u4e4b\u95f4\u7684\u7ec4\u5408\uff0c\u53d1\u73b0\u53cd\u590d\u51fa\u73b0\u7684\u5173\u952e\u4fe1\u606f\uff01</p><p class=\"bb_paragraph\" >\u53d1\u73b0\u5173\u8054\uff01\u6307\u51fa\u77db\u76fe\uff01</p><p class=\"bb_paragraph\" >\u800c\u66f4\u591a\u7684\u6545\u4e8b\uff0c\u8fd8\u5c06\u5728\u4e4b\u540e\u5c55\u5f00\u2014\u2014</p><p class=\"bb_paragraph\" >    </p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" >\u25a0 \u6e38\u620f\u6982\u8ff0</h2><p class=\"bb_paragraph\" >\u300a\u63a8\u7406\u5c0f\u8bf4\u7684\u5173\u952e\u4e00\u5b9a\u4f1a\u51fa\u73b0\u4e24\u6b21\u300b\u662f\u4e00\u90e8\u4ee5\u65e5\u5e38\u63a8\u7406\u4e3a\u6838\u5fc3\u7684\u89c6\u89c9\u5c0f\u8bf4\u3002\u73a9\u5bb6\u5c06\u626e\u6f14<strong>\u5357\u5317\u5927\u5b66\u63a8\u7406\u534f\u4f1a</strong>\u7684<strong>\u5218\u5915\u58f0</strong>\u3002\u9700\u8981\u5728\u573a\u666f\u4e2d\u8c03\u67e5\u3001\u4ea4\u8c08\u3001\u601d\u8003\u83b7\u5f97\u7ebf\u7d22\uff0c\u5e76\u901a\u8fc7\u201c\u53d1\u73b0\u5173\u8054\u201d\u6216\u662f\u201c\u6307\u51fa\u77db\u76fe\u201d\u5bf9\u7ebf\u7d22\u4eec\u8fdb\u884c\u7ec4\u5408\uff0c\u5e76\u9009\u62e9\u5408\u9002\u7684\u7ebf\u7d22\u56de\u7b54\u7ae0\u8282\u5185\u7684\u95ee\u9898\u63a8\u8fdb\u6545\u4e8b\u53d1\u5c55\u3002</p><p class=\"bb_paragraph\" >\u4e0e\u5927\u591a\u6570\u4ee5\u5211\u4e8b\u6848\u4ef6\u4e3a\u63a8\u7406\u5bf9\u8c61\u7684\u6545\u4e8b\u4e0d\u540c\uff0c\u6211\u4eec\u81f4\u529b\u4ee5\u5927\u5b66\u6821\u56ed\u5185\u5916\u4e3a\u821e\u53f0\uff0c\u53d1\u73b0\u90a3\u4e9b\u201c\u4e0d\u89e3\u51b3\u4e5f\u53ef\u4ee5\u201d\u7684\u5c0f\u5c0f\u8c1c\u9898\uff0c\u521b\u9020\u8f7b\u677e\u6709\u8da3\u7684\u4f53\u9a8c\u3002\u5e0c\u671b\u60a8\u80fd\u5728\u4eab\u53d7\u63a8\u7406\u8fc7\u7a0b\u7684\u540c\u65f6\uff0c\u4e5f\u80fd\u4f53\u4f1a\u5230\u7531\u5f62\u5f62\u8272\u8272\u4eba\u7269\u4ea4\u7ec7\u800c\u6210\u7684\u201c\u65e5\u5e38\u201d\u4e4b\u9b45\u529b\u3002</p><h2 class=\"bb_tag\" ></h2><h2 class=\"bb_tag\" >\u25a0 \u6e38\u620f\u7279\u8272</h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>\u76f4\u767d\u7ecf\u5178\u7684\u7ec4\u5408\u73a9\u6cd5</strong></p><p class=\"bb_paragraph\" >\u601d\u8003\u7ebf\u7d22\u95f4\u7684\u5173\u7cfb\uff0c\u53d1\u73b0\u5b83\u4eec\u7684\u5173\u8054\u6216\u662f\u77db\u76fe\uff0c\u4ee5\u6b64\u521b\u9020\u65b0\u7684\u7ebf\u7d22\u3002\u5728\u903b\u8f91\u94fe\u6761\u7684\u7ec8\u70b9\u4e00\u5b9a\u80fd\u627e\u5230\u8c1c\u9898\u95ee\u9898\u7684\u7b54\u6848\uff01\u4e0d\u5fc5\u62c5\u5fc3\u96be\u5ea6\u8fc7\u5927\uff0c\u6216\u8bb8\u5c0f\u5c0f\u7684\u732b\u5934\u9e70\u52a9\u624b\u6b63\u5728\u7b49\u5f85\u5e2e\u52a9\u4f60~\uff08\u63d0\u793a\u529f\u80fd\u53ef\u5173\u95ed\uff09</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3432690/extras/a6f82cadda5c1981924fc517444d3678.avif?t=1747479555\" width=382 height=250 /></span></p></li><li><p class=\"bb_paragraph\" ><strong>\u6e05\u65b0\u660e\u5feb\u7684\u7f8e\u672f\u98ce\u683c</strong></p><p class=\"bb_paragraph\" >\u6211\u4eec\u4f7f\u7528Live2D\u6280\u672f\u5236\u4f5c\u7684\u4eba\u7269\u7acb\u7ed8\u751f\u52a8\u800c\u5bcc\u4e8e\u8868\u60c5\u3002\u800c\u5728\u5267\u60c5\u4e2d\u8fd8\u6709\u7b80\u5355\u7684\u5c0f\u6f2b\u753b\u683c\u5e2e\u52a9\u7406\u89e3\u6545\u4e8b\u3002</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3432690/extras/aff13f148e11e973c203b22007010d79.avif?t=1747479555\" width=800 height=430 /></span></p></li><li><p class=\"bb_paragraph\" ><strong>\u5404\u5177\u751f\u547d\u7684\u591a\u5f69\u89d2\u8272</strong></p></li></ul><p class=\"bb_paragraph\" >\u00a0 \u00a0 \u5728\u6570\u4e2a\u5c0f\u65f6\u7684\u6e38\u620f\u65f6\u957f\u4e2d\uff0c\u89d2\u8272\u4eec\u5c06\u8f6e\u756a\u4e0a\u573a\uff0c\u5feb\u53bb\u53d1\u6398\u4ed6\u4eec\u5404\u81ea\u7684\u53ef\u7231\u4e4b\u5904\u5427~</p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" >\u25a0 \u90e8\u5206\u89d2\u8272\u4ecb\u7ecd</h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>\u5218\u5915\u58f0</strong></p></li></ul><p class=\"bb_paragraph\" >\u6545\u4e8b\u7684\u4e3b\u4eba\u516c\u3002\u5357\u5317\u5927\u5b66\u63a8\u7406\u534f\u4f1a\u4f1a\u957f\uff0c\u81ea\u8ba4\u4e3a\u904d\u89c8\u63a8\u7406\u5c0f\u8bf4\u3002\u5b9e\u9645\u4e0a\u5f85\u4eba\u63a5\u7269\u5e38\u6709\u8fdf\u949d\u6216\u53e4\u602a\u4e4b\u5904\u3002\u5076\u5c14\u7684\u7075\u5149\u4e00\u73b0\u65e2\u53ef\u4ee5\u89e3\u51b3\u96be\u9898\uff0c\u4e5f\u53ef\u4ee5\u8ba9\u4eba\u65e0\u8bed\u81f3\u6781\u3002</p><p class=\"bb_paragraph\" ></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u201c<strong>\u4e66\u8bb0\u201d</strong></p></li></ul><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3432690/extras/064dbb35d8119e10ed367770d769d87b.avif?t=1747479555\" width=198 height=208 /></span></p><p class=\"bb_paragraph\" >\u7531\u4e8e\u67d0\u79cd\u7f18\u7531\u52a0\u5165\u63a8\u7406\u534f\u4f1a\u4efb\u804c\u4e66\u8bb0\uff0c\u56e0\u800c\u88ab\u4f1a\u957f\u4ee5\u53ca\u5927\u5bb6\u79f0\u4e3a\u201c\u4e66\u8bb0\u201d\u3002\u5341\u5206\u7231\u8bfb\u63a8\u7406\u5c0f\u8bf4\uff0c\u800c\u4e14\u4f3c\u4e4e\u79c1\u5e95\u4e0b\u6709\u5728\u5077\u5077\u521b\u4f5c\u3002\u6027\u683c\u6587\u9759\uff0c\u6709\u65f6\u5374\u613f\u610f\u548c\u4f1a\u957f\u4e00\u8d77\u80e1\u95f9\uff0c\u5927\u6982\u662f\u4e3a\u4e86\u5145\u5f53\u5410\u69fd\u5f79\u3002\u601d\u8003\u65b9\u5f0f\u7406\u6027\u800c\u5b9e\u9645\uff0c\u5076\u5c14\u4e5f\u6709\u6d41\u9732\u611f\u60c5\u7684\u4e00\u9762\u3002\u559c\u6b22\u53ef\u7231\u7684\u4e1c\u897f\uff0c\u6bd4\u5982\u5154\u5b50\u548c\u718a\u3002</p><p class=\"bb_paragraph\" >-----------------------------------------------------------------------</p><p class=\"bb_paragraph\" >\u203b\u6e38\u620f\u4ecd\u5728\u5f00\u53d1\u4e2d\uff0c\u4e00\u5207\u4ee5\u5b9e\u9645\u53d1\u5e03\u5185\u5bb9\u4e3a\u51c6</p><p class=\"bb_paragraph\" >\u203b\u6b63\u5f0f\u7248\u9884\u8ba1\u4f1a\u6709\u4e94\u4e2a\u7ae0\u8282\u7684\u5185\u5bb9</p>",
    "short_description": "\u300a\u63a8\u7406\u5c0f\u8bf4\u7684\u5173\u952e\u4e00\u5b9a\u4f1a\u51fa\u73b0\u4e24\u6b21\u300b\u662f\u4e00\u90e8\u4ee5\u65e5\u5e38\u63a8\u7406\u4e3a\u6838\u5fc3\u7684\u89c6\u89c9\u5c0f\u8bf4\u3002\u65e5\u5e38\u6df7\u6c8c\u7eb7\u4e71\uff0c\u800c\u201c\u4fa6\u63a2\u201d\u72ec\u5177\u6167\u773c\u3002\u5e26\u4e0a\u4f60\u7684\u597d\u5947\u5fc3\u5427\uff0c\u53bb\u548c\u63a8\u7406\u534f\u4f1a\u4e00\u540c\u8c03\u67e5\u3001\u601d\u8003\uff0c\u6700\u7ec8\u89e3\u5f00\u4e00\u4e2a\u4e2a\u8f7b\u677e\u5374\u4e0d\u5931\u6709\u8da3\u7684\u65e5\u5e38\u4e4b\u8c1c\u3002",
