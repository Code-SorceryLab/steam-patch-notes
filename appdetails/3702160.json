    "about_the_game": "<p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\u25bd\u3042\u3089\u3059\u3058</p><p class=\"bb_paragraph\" > \u6642\u306f\u5927\u6b63\u2015\u2015 \u4e3b\u4eba\u516c\u306f\u9280\u5ea7\u306e\u30ab\u30d5\u30a7\u30fc\u3067\u5973\u7d66\u3068\u3057\u3066\u50cd\u3044\u3066\u305f\u3002</p><p class=\"bb_paragraph\" > \u3042\u308b\u65e5\u3001\u3044\u3064\u3082\u901a\u308a\u306e\u51fa\u52e4\u3092\u3059\u308b\u3068\u5e97\u9577\u306b\u3068\u3093\u3067\u3082\u306a\u3044\u304a\u9858\u3044\u3092\u3055\u308c\u308b\u2026\u2026 </p><p class=\"bb_paragraph\" >\u300e\u7f8e\u7537\u5b50\u3092\u7d39\u4ecb\u3057\u3066\u304f\u308c\u306a\u3044\u304b\uff01\u300f</p><p class=\"bb_paragraph\" >\u7a81\u7136\u306e\u304a\u9858\u3044\u306b\u6238\u60d1\u3046\u4e3b\u4eba\u516c\u3060\u3063\u305f\u304c\u3001\u304a\u5e97\u306e\u305f\u3081\u306b\u3068\u5f15\u304d\u53d7\u3051\u308b\u3053\u3068\u306b\u3002</p><p class=\"bb_paragraph\" > \u3057\u304b\u3057\u3001\u601d\u3044\u5f53\u305f\u308b\u3088\u3046\u306a\u77e5\u308a\u5408\u3044\u306f\u3044\u306a\u3044\u3002 \u305d\u3053\u3067\u982d\u306b\u6d6e\u304b\u3093\u3060\u306e\u306f\u5e38\u9023\u306e\uff16\u4eba\u2026\u2026\u3002 </p><p class=\"bb_paragraph\" >\u5f7c\u3089\u306e\u8ab0\u304b\u306b\u304a\u9858\u3044\u3067\u304d\u306a\u3044\u304b\u2026\u2026\u3068\u8003\u3048\u305f\u4e3b\u4eba\u516c\u306f\u3001\u5f7c\u3089\u306b\u58f0\u639b\u3051\u3092\u3057\u3088\u3046\u3068\u3059\u308b\u306e\u3060\u304c\u2015\u2015 </p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\u25b2\u6982\u8981 </p><p class=\"bb_paragraph\" >\u30d5\u30eb\u30dc\u30a4\u30b9\u306e\u30ce\u30b9\u30bf\u30eb\u30b8\u30c3\u30af\u4e59\u5973\u30b2\u30fc\u30e0 </p><p class=\"bb_paragraph\" >\u30d7\u30ec\u30a4\u6642\u9593\uff1a\uff11\u30eb\u30fc\u30c8\uff11\u6642\u9593\u7a0b\u5ea6 </p><p class=\"bb_paragraph\" >\u30b9\u30c1\u30eb\u6570\uff1a27\u679a\uff08\u5dee\u5206\u542b\u3081\u305a\uff09</p><p class=\"bb_paragraph\" >\u30a8\u30f3\u30c9\uff1a\uff16</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3702160/extras/a7aee0da65d6d17b330914abe62a667f.avif?t=1755566327\" data-has-big width=800 height=1132 /></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><strong>\u4e3b\u4eba\u516c\uff08\u6cc9\u3000\u4e00\u82b1(\u540d\u5b57\u306f\u56fa\u5b9a)\uff09\uff08\u3044\u305a\u307f\u3000\u3044\u3061\u304b\uff09\u3000\uff0a\u30dc\u30a4\u30b9\u7121\u3057</strong></p><p class=\"bb_paragraph\" ><strong>\u30ab\u30d5\u30a7\u300e\u30d0\u30a6\u30ea\u30b9\u30bf\u300f\u306e\u5e97\u54e1\u3002\uff0818\u6b73\uff09</strong></p><p class=\"bb_paragraph\" ><strong>\u7d30\u3084\u304b\u306a\u6c17\u9063\u3044\u304c\u3067\u304d\u3001\u304a\u5ba2\u3055\u3093\u304b\u3089\u306e\u4eba\u6c17\u304c\u9ad8\u3044\u3002</strong></p><p class=\"bb_paragraph\" ><strong>\u7a81\u7136\u5e97\u9577\u304b\u3089\u7f8e\u7537\u5b50\u5927\u4f1a\u306e\u5019\u88dc\u8005\u63a2\u3057\u3092\u4efb\u3055\u308c\u308b\u3053\u3068\u306b\u2026\u2026\u3002</strong></p><p class=\"bb_paragraph\" ><strong>\u30b3\u30fc\u30d2\u30fc\u3092\u5165\u308c\u308b\u306e\u304c\u597d\u304d\u3067\u3001\u6642\u3005\u53a8\u623f\u3092\u624b\u4f1d\u3063\u3066\u3044\u308b\u3002</strong></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3702160/extras/498e912ecaa6aa64402af51f3319614c.avif?t=1755566327\" data-has-big width=800 height=1132 /></span></p><p class=\"bb_paragraph\" ><strong>\u82a5\u5ddd\u3000\u9f8d\u592a\u90ce\uff08\u3042\u304f\u305f\u304c\u308f\u3000\u308a\u3085\u3046\u305f\u308d\u3046\uff09CV\uff1a\u4e2d\u5d8b\u3000\u6709\u5fd7</strong></p><p class=\"bb_paragraph\" ><strong>\u83ef\u9053\u306e\u5bb6\u5143\u3067\u5973\u6027\u304b\u3089\u306e\u4eba\u6c17\u304c\u9ad8\u3044\u3002\uff0824\u6b73\uff09</strong></p><p class=\"bb_paragraph\" ><strong>\u53e3\u6570\u304c\u5c11\u306a\u304f\u3001\u4f55\u3092\u8003\u3048\u3066\u3044\u308b\u304b\u5206\u304b\u3089\u306a\u3044\u3068\u601d\u308f\u308c\u308b\u3053\u3068\u304c\u591a\u3044\u3002</strong></p><p class=\"bb_paragraph\" ><strong>\u771f\u9762\u76ee\u3067\u5805\u7269\u3002</strong></p><p class=\"bb_paragraph\" ><strong>\u30b3\u30fc\u30d2\u30fc\u597d\u304d\u3067\u3001\u9031\u306b\u6570\u56de\u30ab\u30d5\u30a7\u30fc\u306b\u901a\u3046\u3002</strong></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3702160/extras/6a572328acc8f0449bad1c55531eb8b9.avif?t=1755566327\" data-has-big width=800 height=1132 /></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><strong>\u5e73\u585a\u3000\u4f86\uff08\u3072\u3089\u3064\u304b\u3000\u3089\u3044\uff09CV\uff1a\u6802\u4e95\u3000\u6804\u4eba</strong></p><p class=\"bb_paragraph\" ><strong>\u4eba\u6c17\u306e\u821e\u53f0\u4ff3\u512a\u3002\uff0824\u6b73\uff09</strong></p><p class=\"bb_paragraph\" ><strong>\u6027\u683c\u306f\u4ffa\u69d8\u3060\u304c\u3001\u5b9f\u529b\u304c\u9ad8\u3044\u306e\u3067\u8a8d\u3081\u3089\u308c\u3066\u3044\u308b\u3002</strong></p><p class=\"bb_paragraph\" ><strong>\u5287\u5834\u304c\u8fd1\u304f\u306b\u3042\u308b\u305f\u3081\u3001\u9031\u306b\u4f55\u5ea6\u304b\u6765\u5e97\u3059\u308b\u3002</strong></p><p class=\"bb_paragraph\" ><strong>\u82a5\u5ddd\u3068\u306f\u5e7c\u99b4\u67d3\u3067\u3001\u72ac\u733f\u306e\u4ef2\u3002</strong></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3702160/extras/53e853ad4c618581b203fd16ce50e6c4.avif?t=1755566327\" data-has-big width=800 height=1132 /></span></p><p class=\"bb_paragraph\" ><strong>\u8c37\u5d0e\u3000\u4e8c\u90ce\uff08\u305f\u306b\u3056\u304d\u3000\u3058\u308d\u3046\uff09CV\uff1a\u3061\u3087\u3059\u3084\u307e</strong></p><p class=\"bb_paragraph\" ><strong>\u4eba\u6c17\u304c\u51fa\u3066\u304d\u3066\u3044\u308b\u98a8\u666f\u753b\u5bb6\u3002\uff0823\u6b73\uff09</strong></p><p class=\"bb_paragraph\" ><strong>\u5e38\u306b\u5973\u6027\u306e\u6070\u597d\u3092\u3057\u3066\u3001\u558b\u308a\u65b9\u3082\u52d5\u4f5c\u3082\u5973\u6027\u305d\u306e\u3082\u306e\u3002\u58f0\u3082\u9ad8\u3044\u305f\u3081\u3001\u7537\u6027\u3060\u3068\u6c17\u3065\u304f\u4eba\u306f\u5c11\u306a\u3044\u3002</strong></p><p class=\"bb_paragraph\" ><strong>\u30ab\u30a6\u30f3\u30bb\u30ea\u30f3\u30b0\u306e\u4e00\u74b0\u3067\u68ee\u3068\u5171\u306b\u30ab\u30d5\u30a7\u30fc\u306b\u901a\u3063\u3066\u3044\u308b\u3002</strong></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3702160/extras/6aa8700c86e034f32e2305e655c1c2f5.avif?t=1755566327\" data-has-big width=800 height=1132 /></span></p><p class=\"bb_paragraph\" ><strong>\u68ee\u3000\u9d3b\uff08\u3082\u308a\u3000\u3053\u3046\uff09CV\uff1a\u307a\u3051\u4e38</strong></p><p class=\"bb_paragraph\" ><strong>\u7cbe\u795e\u79d1\u533b\u3067\u8c37\u5d0e\u306e\u4e3b\u6cbb\u533b\u3002\uff0829\u6b73\uff09</strong></p><p class=\"bb_paragraph\" ><strong>\u7a4f\u3084\u304b\u306a\u53e3\u8abf\u3068\u6027\u683c\u3067\u4eba\u6c17\u306e\u533b\u5e2b\u3002</strong></p><p class=\"bb_paragraph\" ><strong>\u30ab\u30d5\u30a7\u30fc\u306b\u306f\u30ab\u30a6\u30f3\u30bb\u30ea\u30f3\u30b0\u3092\u884c\u3046\u305f\u3081\u306b\u3001</strong></p><p class=\"bb_paragraph\" ><strong>\u8c37\u5d0e\u3068\u5171\u306b\u6765\u308b\u3053\u3068\u304c\u591a\u3044\u3002</strong></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3702160/extras/30f0ce39cf1d89b5d1a7be51f2558180.avif?t=1755566327\" data-has-big width=800 height=1132 /></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><strong>\u4e2d\u539f\u3000\u660c\u4e5f\uff08\u306a\u304b\u306f\u3089\u3000\u3057\u3087\u3046\u3084\uff09CV\uff1a\u795e\u5d0e\u3000\u667a\u4e5f</strong></p><p class=\"bb_paragraph\" ><strong>\u5c3e\u5d0e\u3068\u5171\u306b\u5e97\u306b\u3088\u304f\u6765\u308b\u5ba2\u3002\uff0826\u6b73\uff09</strong></p><p class=\"bb_paragraph\" ><strong>\u3068\u3066\u3082\u8fd1\u3065\u304d\u306b\u304f\u3044\u96f0\u56f2\u6c17\u3092\u653e\u3064\u602a\u3057\u3044\u4eba\u7269\u3002</strong></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3702160/extras/2526f6b1c9c9fcc693912de60677b072.avif?t=1755566327\" data-has-big width=800 height=1132 /></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><strong>\u5c3e\u5d0e\uff08\u304a\u3056\u304d\uff09\u3000CV\uff1a\u4f50\u91ce\u3000\u88d5\u7406</strong></p><p class=\"bb_paragraph\" ><strong>\u5546\u4eba\u98a8\u306e\u98a8\u8c8c\u306e\u8b0e\u306e\u4eba\u7269\u3002</strong></p><p class=\"bb_paragraph\" ><strong>\u656c\u8a9e\u3092\u8a71\u3057\u3001\u7269\u8170\u67d4\u3089\u304b\u3044\u304c\u3069\u3053\u304b\u8aad\u3081\u306a\u3044\u4e0d\u601d\u8b70\u306a\u4eba\u7269\u3002</strong></p><p class=\"bb_paragraph\" ><strong>\u7cf8\u76ee\u3067\u3044\u3064\u3082\u306b\u3053\u306b\u3053\u3057\u3066\u3044\u308b\u3002</strong></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><strong>\u4f01\u753b\u30fb\u30a4\u30e9\u30b9\u30c8\u30fb\u30b7\u30ca\u30ea\u30aa</strong></p><p class=\"bb_paragraph\" ><strong>Camellia</strong></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><strong>\u30b9\u30af\u30ea\u30d7\u30c8</strong></p><p class=\"bb_paragraph\" ><strong>\u658e\u5834\u3000\u698a\u30fb\u3068\u304d\u306a\u3057</strong></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><strong>\u4e2d\u56fd\u8a9e\u7ffb\u8a33</strong></p><p class=\"bb_paragraph\" ><strong>\u65e0\u745f</strong></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><strong>\u4e3b\u984c\u6b4c</strong></p><p class=\"bb_paragraph\" ><strong>\u300e\u30de\u30c9\u30ce\u30ab\u30df\u300f</strong></p><p class=\"bb_paragraph\" ><strong>\u6b4c\u5531\u2026\u82b1\u6458\u85cd</strong></p><p class=\"bb_paragraph\" ><strong>\u4f5c\u8a5e\u30fb\u4f5c\u66f2\u2026\u7070\u8272Logic(\u516d\u6b4c)</strong></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><strong>OP\u52d5\u753b\u2026\u307f\u3084\u3002</strong></p>",
    "short_description": "\u6642\u306f\u5927\u6b63\u6642\u4ee3\u2015\u2015 \u4e3b\u4eba\u516c\u306f\u9280\u5ea7\u306e\u30ab\u30d5\u30a7\u30fc\u3067\u5973\u7d66\u3068\u3057\u3066\u50cd\u3044\u3066\u305f\u3002 \u3042\u308b\u65e5\u3001\u3044\u3064\u3082\u901a\u308a\u306e\u51fa\u52e4\u3092\u3059\u308b\u3068\u5e97\u9577\u306b\u3068\u3093\u3067\u3082\u306a\u3044\u304a\u9858\u3044\u3092\u3055\u308c\u308b\u2026\u2026 \u300e\u7f8e\u7537\u5b50\u3092\u7d39\u4ecb\u3057\u3066\u304f\u308c\u306a\u3044\u304b\uff01\u300f \u7a81\u7136\u306e\u304a\u9858\u3044\u306b\u6238\u60d1\u3046\u4e3b\u4eba\u516c\u3060\u3063\u305f\u304c\u3001\u304a\u5e97\u306e\u305f\u3081\u306b\u3068\u5f15\u304d\u53d7\u3051\u308b\u3053\u3068\u306b\u3002 \u3057\u304b\u3057\u3001\u601d\u3044\u5f53\u305f\u308b\u3088\u3046\u306a\u77e5\u308a\u5408\u3044\u306f\u3044\u306a\u3044\u3002 \u305d\u3053\u3067\u982d\u306b\u6d6e\u304b\u3093\u3060\u306e\u306f\u5e38\u9023\u306e\uff16\u4eba\u2026\u2026\u3002 \u5f7c\u3089\u306e\u8ab0\u304b\u306b\u304a\u9858\u3044\u3067\u304d\u306a\u3044\u304b\u2026\u2026\u3068\u8003\u3048\u305f\u4e3b\u4eba\u516c\u306f\u3001\u5f7c\u3089\u306b\u58f0\u639b\u3051\u3092\u3057\u3088\u3046\u3068\u3059\u308b\u306e\u3060\u304c\u2015\u2015",
