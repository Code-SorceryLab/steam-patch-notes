laysinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3445410/extras/5c660ebf499c8ac12fb85f97fb49c468.poster.avif?t=1750265141\" width=738 height=414 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3445410/extras/5c660ebf499c8ac12fb85f97fb49c468.webm?t=1750265141\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3445410/extras/5c660ebf499c8ac12fb85f97fb49c468.mp4?t=1750265141\" type=\"video/mp4\"></video></span></p>",
