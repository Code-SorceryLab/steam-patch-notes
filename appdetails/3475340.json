    "type": "game",
    "name": "\u5e1d\u5929\u4e4b\u6218",
    "steam_appid": 3475340,
    "required_age": 0,
    "is_free": true,
    "detailed_description": "<h2 class=\"bb_tag\" ><strong>\u300a\u5e1d\u5929\u4e4b\u6218\u300b\u91cd\u5927\u66f4\u65b0\u516c\u544a</strong></h2><p class=\"bb_paragraph\" ><strong>\u4eb2\u7231\u7684\u52c7\u58eb\u4eec</strong>\uff1a</p><p class=\"bb_paragraph\" >\u81ea\u4e0a\u6b21\u56e0\u91cd\u5927BUG\u7d27\u6025\u7ef4\u62a4\u540e\uff0c\u7ecf\u8fc7\u6570\u6708\u7684\u6f5c\u5fc3\u4fee\u590d\u4e0e\u4f18\u5316\uff0c\u6211\u4eec\u7ec8\u4e8e\u5e26\u7740<strong>\u53f2\u8bd7\u7ea7\u66f4\u65b0</strong>\u56de\u5f52\uff01\u6b64\u6b21\u66f4\u65b0\u4e0d\u4ec5\u5f7b\u5e95\u89e3\u51b3\u4e86<strong>\u88c5\u5907\u5c5e\u6027\u5f02\u5e38\u3001\u5730\u56fe\u52a0\u8f7d\u5d29\u6e83\u3001BOSS\u5237\u65b0\u673a\u5236\u9519\u4e71</strong>\u7b49\u6838\u5fc3\u95ee\u9898\uff0c\u66f4\u65b0\u589e\u4e86<strong>\u8d85\u591a\u786c\u6838\u73a9\u6cd5</strong>\u4e0e<strong>\u5e73\u6c11\u798f\u5229</strong>\uff0c\u771f\u6b63\u5b9e\u73b0<strong>\u201c\u6563\u4eba\u540a\u6253\u571f\u8c6a\uff0c\u5c0f\u602a\u7206\u7ec8\u6781\u201d</strong>\u7684\u6c5f\u6e56\u76db\u51b5\uff01</p><h2 class=\"bb_tag\" ><strong>\u4e00\u3001\u91cd\u5927BUG\u4fee\u590d\uff1a\u6c5f\u6e56\u79e9\u5e8f\u5168\u9762\u91cd\u6574</strong></h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>\u88c5\u5907\u7cfb\u7edf\u7a33\u5b9a\u5316</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u5f7b\u5e95\u4fee\u590d<strong>\u201c\u55dc\u8840\u8bcd\u6761\u5438\u8840\u6548\u679c\u53e0\u52a0\u5f02\u5e38\u201d</strong>\u7684\u6f0f\u6d1e\uff0c\u73b0\u6539\u4e3a<strong>\u5168\u8eab\u55dc\u8840\u8bcd\u6761\u6570\u91cf\u8fbe\u6807\u65f6\u89e6\u53d1\u201c\u8840\u9b54\u72c2\u66b4\u201d</strong>\uff083\u8bcd\u6761\uff1a\u5438\u8840+10%\uff1b7\u8bcd\u6761\uff1a\u5438\u8840+30%\u4e14\u6bcf\u79d2\u56de\u590d1%\u751f\u547d\uff09\u3002</p></li><li><p class=\"bb_paragraph\" >\u4fee\u6b63<strong>\u201c\u4e09\u5927\u9646BOSS\u4e13\u5c5e\u88c5\u5907\u5c5e\u6027\u4e22\u5931\u201d</strong>\u7684\u95ee\u9898\uff0c\u5171\u5de5\u3001\u795d\u878d\u7b49BOSS\u6389\u843d\u7684\u4e13\u5c5e\u88c5\u5907\u73b0\u53ef\u7a33\u5b9a\u6fc0\u6d3b<strong>\u201c\u5143\u7d20\u6495\u88c2\u201d\u201c\u795e\u529b\u704c\u6ce8\u201d</strong>\u7b49\u7279\u6548\u3002</p></li></ul></li><li><p class=\"bb_paragraph\" ><strong>\u5730\u56fe\u4e0e\u4efb\u52a1\u673a\u5236\u4f18\u5316</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u89e3\u5c01<strong>\u201c\u6ce3\u8840\u6d1e\u7a9f\u201d</strong>\u6210\u5c31\u79f0\u53f7\u7684\u9690\u85cf\u89e6\u53d1\u6761\u4ef6\uff0c\u73b0\u5b8c\u6210\u6d1e\u7a9f\u5185\u6240\u6709\u7cbe\u82f1\u602a\u51fb\u6740\u5373\u53ef100%\u83b7\u5f97\u79f0\u53f7\u3002</p></li><li><p class=\"bb_paragraph\" >\u4fee\u590d<strong>\u201c\u4e8c\u5927\u9646\u8fd0\u52bf\u5360\u535c\u201d</strong>\u5361\u987f\u5bfc\u81f4\u65e0\u6cd5\u83b7\u53d6\u9876\u7ea7\u4f1a\u5458\u7684BUG\uff0c\u73b0\u6bcf\u65e5\u53ef\u514d\u8d39\u5360\u535c3\u6b21\uff0c\u5fc5\u51fa<strong>\u201c\u5929\u8fd0\u81f3\u5c0a\u201d</strong>\u4f1a\u5458\uff08\u6301\u7eed24\u5c0f\u65f6\uff09\u3002</p></li></ul></li><li><p class=\"bb_paragraph\" ><strong>\u6218\u6597\u5e73\u8861\u6027\u8c03\u6574</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u524a\u5f31<strong>\u201c\u571f\u8c6a\u73a9\u5bb6\u4e13\u5c5e\u5149\u73af\u201d</strong>\u7684\u7206\u7387\u52a0\u6210\uff0c\u6539\u4e3a<strong>\u5168\u670d\u5171\u4eab\u7206\u7387\u63d0\u5347</strong>\uff08\u6839\u636e\u5728\u7ebf\u4eba\u6570\u52a8\u6001\u8c03\u6574\uff0c\u6563\u4eba\u73a9\u5bb6\u6536\u76ca\u66f4\u9ad8\uff09\u3002</p></li><li><p class=\"bb_paragraph\" >\u589e\u5f3a<strong>\u201c\u5207\u5272\u7cfb\u7edf\u201d</strong>\u7684\u57fa\u7840\u653b\u901f\uff0c\u73b0\u6240\u6709\u73a9\u5bb6\u8d77\u6b65\u5373\u53ef\u4eab\u53d7<strong>\u201c\u5200\u5200\u70c8\u706b\u201d</strong>\u7684\u7545\u5feb\u4f53\u9a8c\u3002</p></li></ul></li></ul><h2 class=\"bb_tag\" ><strong>\u4e8c\u3001\u5168\u65b0\u73a9\u6cd5\uff1a\u786c\u6838\u6c5f\u6e56\uff0c\u667a\u8005\u4e3a\u738b</strong></h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>\u201c\u4e13\u5c5e\u9274\u5b9a2.0\u201d\u7cfb\u7edf\u4e0a\u7ebf</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u65b0\u589e<strong>\u201c\u8bcd\u6761\u5b54\u4f4d\u878d\u5408\u201d</strong>\u673a\u5236\uff1a\u4f4e\u7ea7\u88c5\u5907\u53ef\u62c6\u89e3\u4e3a\u3010\u8bcd\u6761\u788e\u7247\u3011\uff0c\u7528\u4e8e\u5728\u9ad8\u7ea7\u88c5\u5907\u4e0a\u989d\u5916\u5f00\u5b54\uff08\u6700\u591a\u989d\u5916\u5f003\u5b54\uff09\u3002</p></li><li><p class=\"bb_paragraph\" >\u5f15\u5165<strong>\u201c\u5143\u7d20\u5171\u9e23\u201d</strong>\u7279\u6548\uff1a\u5f53\u5168\u8eab\u88c5\u5907\u643a\u5e26\u540c\u7c7b\u578b\u5143\u7d20\uff08\u5982\u706b\u7130\u3001\u51b0\u51bb\uff09\u8fbe\u52305\u4ef6\u65f6\uff0c\u89e6\u53d1<strong>\u201c\u5143\u7d20\u98ce\u66b4\u201d</strong>\uff08\u8303\u56f4\u4f24\u5bb3+\u51cf\u901f\uff09\u3002</p></li></ul></li><li><p class=\"bb_paragraph\" ><strong>\u201c\u4e09\u5927\u9646\u00b7\u6df7\u6c8c\u79d8\u5883\u201d</strong>\u5f00\u653e</p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u5168\u65b0\u5730\u56fe<strong>\u201c\u9f99\u708e\u754c\u00b7\u6df1\u6e0a\u201d</strong>\uff1a\u602a\u7269\u6389\u843d\u3010\u5929\u9f99\u9707\u8361\u6ce2\u00b7\u6539\u3011\uff08\u8303\u56f4\u6269\u592750%\uff0c\u6495\u88c2\u6548\u679c\u6301\u7eed\u65f6\u95f4\u7ffb\u500d\uff09\u3002</p></li><li><p class=\"bb_paragraph\" >\u9690\u85cfBOSS<strong>\u201c\u866b\u5de2\u6bcd\u7687\u201d</strong>\uff1a\u51fb\u8d25\u540e\u5fc5\u6389\u3010\u6697\u884c\u6495\u88c2\u722a\u00b7\u6781\u3011\uff08\u767e\u5206\u6bd4\u5207\u5272+\u5438\u8840\u53cc\u7279\u6548\uff0c\u6563\u4eba\u795e\u5668\uff09\u3002</p></li></ul></li><li><p class=\"bb_paragraph\" ><strong>\u201c\u8de8\u670d\u6563\u4eba\u4e89\u9738\u8d5b\u201d</strong>\u5f00\u542f</p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u6bcf\u5468\u516d20:00\u5f00\u542f\uff0c\u6240\u6709\u73a9\u5bb6<strong>\u96f6\u95e8\u69db\u53c2\u4e0e</strong>\uff0c\u901a\u8fc7\u51fb\u6740\u602a\u7269\u79ef\u7d2f\u79ef\u5206\u5151\u6362<strong>\u201c\u6563\u4eba\u81f3\u5c0a\u201d</strong>\u9650\u5b9a\u79f0\u53f7\uff08\u653b\u51fb+500\uff0c\u7206\u7387+20%\uff09\u3002</p></li><li><p class=\"bb_paragraph\" >\u8d5b\u4e8b\u5956\u52b1\u65b0\u589e<strong>\u201c\u81ea\u9009\u4e13\u5c5e\u88c5\u5907\u7bb1\u201d</strong>\uff0c\u53ef\u4efb\u9009\u4e09\u5927\u9646\u4efb\u610fBOSS\u4e13\u5c5e\u88c5\u5907\uff08\u542b\u5171\u5de5\u3001\u795d\u878d\u7b49\u7ec8\u6781\u795e\u5668\uff09\u3002</p></li></ul></li></ul><h2 class=\"bb_tag\" ><strong>\u4e09\u3001\u5e73\u6c11\u798f\u5229\u5927\u653e\u9001\uff1a\u96f6\u6c2a\u4e5f\u80fd\u5236\u9738\u5168\u670d</strong></h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>\u201c\u4e03\u65e5\u53d8\u5f3a\u8ba1\u5212\u201d\u5347\u7ea7</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u5b8c\u6210\u6bcf\u65e5\u4efb\u52a1\u5373\u53ef\u9886\u53d6<strong>\u201c\u7075\u5143\u5b9d\u7bb1\u201d</strong>\uff08\u5fc5\u51fa1000-5000\u7075\u5143\uff0c\u53ef\u7528\u4e8e\u5207\u5272\u7cfb\u7edf\u5347\u7ea7\uff09\u3002</p></li><li><p class=\"bb_paragraph\" >\u7d2f\u8ba1\u767b\u5f557\u5929\u8d60\u9001<strong>\u201c\u5e73\u6c11\u6218\u795e\u793c\u5305\u201d</strong>\uff1a\u542b\u3010\u55dc\u8840\u9879\u94fe\u00b7\u521d\u9636\u3011\uff083\u8bcd\u6761\u55dc\u8840\uff09\u3001\u3010\u5730\u9996\u4e4b\u5fa1\u00b7\u788e\u7247\u3011\u00d710\uff08\u5408\u6210\u9632\u9ebb\u75f9\u88c5\u5907\uff09\u3002</p></li></ul></li><li><p class=\"bb_paragraph\" ><strong>\u201c\u5e7b\u7fbd\u5e7d\u83b2\u201d\u4e3b\u7ebf\u4efb\u52a1\u4f18\u5316</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u65b0\u589e<strong>\u201c\u81ea\u52a8\u5bfc\u822a\u201d</strong>\u529f\u80fd\uff0c\u70b9\u51fb\u4efb\u52a1\u76ee\u6807\u5373\u53ef\u76f4\u63a5\u4f20\u9001\u81f3\u5bf9\u5e94\u5730\u56fe\uff0c\u544a\u522b\u8dd1\u56fe\u70e6\u607c\u3002</p></li><li><p class=\"bb_paragraph\" >\u4efb\u52a1\u5956\u52b1\u7ffb\u500d\uff1a\u5b8c\u6210\u4e8c\u5927\u9646\u4e3b\u7ebf\u4efb\u52a1\u989d\u5916\u8d60\u9001<strong>\u201c\u5207\u5272\u503c+1000\u201d</strong>\u7684\u6c38\u4e45BUFF\u3002</p></li></ul></li><li><p class=\"bb_paragraph\" ><strong>\u201c\u5c0f\u602a\u7206\u7ec8\u6781\u201d\u673a\u5236\u5f3a\u5316</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u4e09\u5927\u9646\u666e\u901a\u602a\u7269\u73b0\u5728\u4e5f\u6709\u6982\u7387\u6389\u843d<strong>\u201c\u5b87\u5b99\u529b\u91cf\u201d\u201c\u7cbe\u795e\u529b\u91cf\u201d</strong>\u7b49\u5408\u6210\u53c1\u5143\u529b\u91cf\u7684\u6838\u5fc3\u90e8\u4ef6\u3002</p></li><li><p class=\"bb_paragraph\" >\u8c03\u6574<strong>\u201c\u6d1b\u6cb3\u591c\u9b54\u5760\u201d</strong>\u7684\u6389\u843d\u8303\u56f4\uff1a\u6d1b\u6cb3\u533a\u57df\u6240\u6709\u602a\u7269\uff08\u5305\u62ec\u5c0f\u602a\uff09\u5747\u6709\u673a\u4f1a\u6389\u843d\uff0c\u9632\u51b0\u51bb\u6548\u679c\u5fc5\u5907\u3002</p></li></ul></li></ul><h2 class=\"bb_tag\" ><strong>\u56db\u3001\u89c6\u89c9\u4e0e\u64cd\u4f5c\u4f18\u5316\uff1a\u6c89\u6d78\u5f0f\u4f20\u5947\u4f53\u9a8c</strong></h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>\u6280\u80fd\u7279\u6548\u91cd\u5236</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>\u201c\u55dc\u8840\u72c2\u66b4\u201d</strong>\u7279\u6548\u5347\u7ea7\uff1a\u89e6\u53d1\u65f6\u5168\u8eab\u7b3c\u7f69\u8840\u8272\u5149\u8292\uff0c\u9644\u5e26<strong>\u201c\u8840\u96fe\u5f25\u6f2b\u201d</strong>\u8303\u56f4\u4f24\u5bb3\u3002</p></li><li><p class=\"bb_paragraph\" ><strong>\u201c\u5929\u9f99\u9707\u8361\u6ce2\u201d</strong>\u65b0\u589e<strong>\u201c\u9f99\u5f71\u7a7f\u68ad\u201d</strong>\u52a8\u753b\uff0c\u653b\u51fb\u8f68\u8ff9\u66f4\u6e05\u6670\uff0c\u6253\u51fb\u611f\u62c9\u6ee1\u3002</p></li></ul></li><li><p class=\"bb_paragraph\" ><strong>\u64cd\u4f5c\u4fbf\u6377\u6027\u63d0\u5347</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u65b0\u589e<strong>\u201c\u4e00\u952e\u9274\u5b9a\u201d</strong>\u529f\u80fd\uff1a\u80cc\u5305\u5185\u6240\u6709\u4e13\u5c5e\u88c5\u5907\u53ef\u6279\u91cf\u9274\u5b9a\uff0c\u8282\u7701\u5927\u91cf\u65f6\u95f4\u3002</p></li><li><p class=\"bb_paragraph\" >\u4f18\u5316<strong>\u201c\u60ac\u8d4f\u4efb\u52a1\u201d</strong>\u754c\u9762\uff1a\u73b0\u5728\u53ef\u540c\u65f6\u63a5\u53d65\u4e2a\u4efb\u52a1\uff0c\u81ea\u52a8\u89c4\u5212\u6700\u4f18\u5237\u602a\u8def\u7ebf\u3002</p></li></ul></li></ul><p class=\"bb_paragraph\" ><strong>\u5f00\u53d1\u8005\u5bc4\u8bed</strong>\uff1a <br>\u201c\u6b64\u6b21\u66f4\u65b0\u4e0d\u4ec5\u662f\u5bf9BUG\u7684\u5f7b\u5e95\u7ec8\u7ed3\uff0c\u66f4\u662f\u6211\u4eec\u5bf9\u2018\u5e73\u6c11\u4f20\u5947\u2019\u7406\u5ff5\u7684\u6df1\u5ea6\u8df5\u884c\u3002\u4ece\u8bcd\u6761\u878d\u5408\u7cfb\u7edf\u5230\u6563\u4eba\u4e89\u9738\u8d5b\uff0c\u6bcf\u4e00\u5904\u8bbe\u8ba1\u90fd\u65e8\u5728\u8ba9\u6240\u6709\u73a9\u5bb6\u2014\u2014\u65e0\u8bba\u6c2a\u91d1\u4e0e\u5426\u2014\u2014\u90fd\u80fd\u5728\u8fd9\u7247\u6c5f\u6e56\u4e2d\u627e\u5230\u5c5e\u4e8e\u81ea\u5df1\u7684\u4f20\u5947\uff01\u613f\u8bf8\u4f4d\u52c7\u58eb\u4ee5\u667a\u7834\u654c\uff0c\u4ee5\u52c7\u79f0\u738b\uff0c\u5171\u4e66\u300a\u5e1d\u5929\u4e4b\u6218\u300b\u7684\u65b0\u7bc7\u7ae0\uff01\u201d</p><p class=\"bb_paragraph\" ><strong>\u2014\u300a\u5e1d\u5929\u4e4b\u6218\u300b\u8fd0\u8425\u56e2\u961f \u656c\u4e0a</strong></p>",
    "about_the_game": "<h2 class=\"bb_tag\" ><strong>\u300a\u5e1d\u5929\u4e4b\u6218\u300b\u91cd\u5927\u66f4\u65b0\u516c\u544a</strong></h2><p class=\"bb_paragraph\" ><strong>\u4eb2\u7231\u7684\u52c7\u58eb\u4eec</strong>\uff1a</p><p class=\"bb_paragraph\" >\u81ea\u4e0a\u6b21\u56e0\u91cd\u5927BUG\u7d27\u6025\u7ef4\u62a4\u540e\uff0c\u7ecf\u8fc7\u6570\u6708\u7684\u6f5c\u5fc3\u4fee\u590d\u4e0e\u4f18\u5316\uff0c\u6211\u4eec\u7ec8\u4e8e\u5e26\u7740<strong>\u53f2\u8bd7\u7ea7\u66f4\u65b0</strong>\u56de\u5f52\uff01\u6b64\u6b21\u66f4\u65b0\u4e0d\u4ec5\u5f7b\u5e95\u89e3\u51b3\u4e86<strong>\u88c5\u5907\u5c5e\u6027\u5f02\u5e38\u3001\u5730\u56fe\u52a0\u8f7d\u5d29\u6e83\u3001BOSS\u5237\u65b0\u673a\u5236\u9519\u4e71</strong>\u7b49\u6838\u5fc3\u95ee\u9898\uff0c\u66f4\u65b0\u589e\u4e86<strong>\u8d85\u591a\u786c\u6838\u73a9\u6cd5</strong>\u4e0e<strong>\u5e73\u6c11\u798f\u5229</strong>\uff0c\u771f\u6b63\u5b9e\u73b0<strong>\u201c\u6563\u4eba\u540a\u6253\u571f\u8c6a\uff0c\u5c0f\u602a\u7206\u7ec8\u6781\u201d</strong>\u7684\u6c5f\u6e56\u76db\u51b5\uff01</p><h2 class=\"bb_tag\" ><strong>\u4e00\u3001\u91cd\u5927BUG\u4fee\u590d\uff1a\u6c5f\u6e56\u79e9\u5e8f\u5168\u9762\u91cd\u6574</strong></h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>\u88c5\u5907\u7cfb\u7edf\u7a33\u5b9a\u5316</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u5f7b\u5e95\u4fee\u590d<strong>\u201c\u55dc\u8840\u8bcd\u6761\u5438\u8840\u6548\u679c\u53e0\u52a0\u5f02\u5e38\u201d</strong>\u7684\u6f0f\u6d1e\uff0c\u73b0\u6539\u4e3a<strong>\u5168\u8eab\u55dc\u8840\u8bcd\u6761\u6570\u91cf\u8fbe\u6807\u65f6\u89e6\u53d1\u201c\u8840\u9b54\u72c2\u66b4\u201d</strong>\uff083\u8bcd\u6761\uff1a\u5438\u8840+10%\uff1b7\u8bcd\u6761\uff1a\u5438\u8840+30%\u4e14\u6bcf\u79d2\u56de\u590d1%\u751f\u547d\uff09\u3002</p></li><li><p class=\"bb_paragraph\" >\u4fee\u6b63<strong>\u201c\u4e09\u5927\u9646BOSS\u4e13\u5c5e\u88c5\u5907\u5c5e\u6027\u4e22\u5931\u201d</strong>\u7684\u95ee\u9898\uff0c\u5171\u5de5\u3001\u795d\u878d\u7b49BOSS\u6389\u843d\u7684\u4e13\u5c5e\u88c5\u5907\u73b0\u53ef\u7a33\u5b9a\u6fc0\u6d3b<strong>\u201c\u5143\u7d20\u6495\u88c2\u201d\u201c\u795e\u529b\u704c\u6ce8\u201d</strong>\u7b49\u7279\u6548\u3002</p></li></ul></li><li><p class=\"bb_paragraph\" ><strong>\u5730\u56fe\u4e0e\u4efb\u52a1\u673a\u5236\u4f18\u5316</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u89e3\u5c01<strong>\u201c\u6ce3\u8840\u6d1e\u7a9f\u201d</strong>\u6210\u5c31\u79f0\u53f7\u7684\u9690\u85cf\u89e6\u53d1\u6761\u4ef6\uff0c\u73b0\u5b8c\u6210\u6d1e\u7a9f\u5185\u6240\u6709\u7cbe\u82f1\u602a\u51fb\u6740\u5373\u53ef100%\u83b7\u5f97\u79f0\u53f7\u3002</p></li><li><p class=\"bb_paragraph\" >\u4fee\u590d<strong>\u201c\u4e8c\u5927\u9646\u8fd0\u52bf\u5360\u535c\u201d</strong>\u5361\u987f\u5bfc\u81f4\u65e0\u6cd5\u83b7\u53d6\u9876\u7ea7\u4f1a\u5458\u7684BUG\uff0c\u73b0\u6bcf\u65e5\u53ef\u514d\u8d39\u5360\u535c3\u6b21\uff0c\u5fc5\u51fa<strong>\u201c\u5929\u8fd0\u81f3\u5c0a\u201d</strong>\u4f1a\u5458\uff08\u6301\u7eed24\u5c0f\u65f6\uff09\u3002</p></li></ul></li><li><p class=\"bb_paragraph\" ><strong>\u6218\u6597\u5e73\u8861\u6027\u8c03\u6574</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u524a\u5f31<strong>\u201c\u571f\u8c6a\u73a9\u5bb6\u4e13\u5c5e\u5149\u73af\u201d</strong>\u7684\u7206\u7387\u52a0\u6210\uff0c\u6539\u4e3a<strong>\u5168\u670d\u5171\u4eab\u7206\u7387\u63d0\u5347</strong>\uff08\u6839\u636e\u5728\u7ebf\u4eba\u6570\u52a8\u6001\u8c03\u6574\uff0c\u6563\u4eba\u73a9\u5bb6\u6536\u76ca\u66f4\u9ad8\uff09\u3002</p></li><li><p class=\"bb_paragraph\" >\u589e\u5f3a<strong>\u201c\u5207\u5272\u7cfb\u7edf\u201d</strong>\u7684\u57fa\u7840\u653b\u901f\uff0c\u73b0\u6240\u6709\u73a9\u5bb6\u8d77\u6b65\u5373\u53ef\u4eab\u53d7<strong>\u201c\u5200\u5200\u70c8\u706b\u201d</strong>\u7684\u7545\u5feb\u4f53\u9a8c\u3002</p></li></ul></li></ul><h2 class=\"bb_tag\" ><strong>\u4e8c\u3001\u5168\u65b0\u73a9\u6cd5\uff1a\u786c\u6838\u6c5f\u6e56\uff0c\u667a\u8005\u4e3a\u738b</strong></h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>\u201c\u4e13\u5c5e\u9274\u5b9a2.0\u201d\u7cfb\u7edf\u4e0a\u7ebf</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u65b0\u589e<strong>\u201c\u8bcd\u6761\u5b54\u4f4d\u878d\u5408\u201d</strong>\u673a\u5236\uff1a\u4f4e\u7ea7\u88c5\u5907\u53ef\u62c6\u89e3\u4e3a\u3010\u8bcd\u6761\u788e\u7247\u3011\uff0c\u7528\u4e8e\u5728\u9ad8\u7ea7\u88c5\u5907\u4e0a\u989d\u5916\u5f00\u5b54\uff08\u6700\u591a\u989d\u5916\u5f003\u5b54\uff09\u3002</p></li><li><p class=\"bb_paragraph\" >\u5f15\u5165<strong>\u201c\u5143\u7d20\u5171\u9e23\u201d</strong>\u7279\u6548\uff1a\u5f53\u5168\u8eab\u88c5\u5907\u643a\u5e26\u540c\u7c7b\u578b\u5143\u7d20\uff08\u5982\u706b\u7130\u3001\u51b0\u51bb\uff09\u8fbe\u52305\u4ef6\u65f6\uff0c\u89e6\u53d1<strong>\u201c\u5143\u7d20\u98ce\u66b4\u201d</strong>\uff08\u8303\u56f4\u4f24\u5bb3+\u51cf\u901f\uff09\u3002</p></li></ul></li><li><p class=\"bb_paragraph\" ><strong>\u201c\u4e09\u5927\u9646\u00b7\u6df7\u6c8c\u79d8\u5883\u201d</strong>\u5f00\u653e</p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u5168\u65b0\u5730\u56fe<strong>\u201c\u9f99\u708e\u754c\u00b7\u6df1\u6e0a\u201d</strong>\uff1a\u602a\u7269\u6389\u843d\u3010\u5929\u9f99\u9707\u8361\u6ce2\u00b7\u6539\u3011\uff08\u8303\u56f4\u6269\u592750%\uff0c\u6495\u88c2\u6548\u679c\u6301\u7eed\u65f6\u95f4\u7ffb\u500d\uff09\u3002</p></li><li><p class=\"bb_paragraph\" >\u9690\u85cfBOSS<strong>\u201c\u866b\u5de2\u6bcd\u7687\u201d</strong>\uff1a\u51fb\u8d25\u540e\u5fc5\u6389\u3010\u6697\u884c\u6495\u88c2\u722a\u00b7\u6781\u3011\uff08\u767e\u5206\u6bd4\u5207\u5272+\u5438\u8840\u53cc\u7279\u6548\uff0c\u6563\u4eba\u795e\u5668\uff09\u3002</p></li></ul></li><li><p class=\"bb_paragraph\" ><strong>\u201c\u8de8\u670d\u6563\u4eba\u4e89\u9738\u8d5b\u201d</strong>\u5f00\u542f</p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u6bcf\u5468\u516d20:00\u5f00\u542f\uff0c\u6240\u6709\u73a9\u5bb6<strong>\u96f6\u95e8\u69db\u53c2\u4e0e</strong>\uff0c\u901a\u8fc7\u51fb\u6740\u602a\u7269\u79ef\u7d2f\u79ef\u5206\u5151\u6362<strong>\u201c\u6563\u4eba\u81f3\u5c0a\u201d</strong>\u9650\u5b9a\u79f0\u53f7\uff08\u653b\u51fb+500\uff0c\u7206\u7387+20%\uff09\u3002</p></li><li><p class=\"bb_paragraph\" >\u8d5b\u4e8b\u5956\u52b1\u65b0\u589e<strong>\u201c\u81ea\u9009\u4e13\u5c5e\u88c5\u5907\u7bb1\u201d</strong>\uff0c\u53ef\u4efb\u9009\u4e09\u5927\u9646\u4efb\u610fBOSS\u4e13\u5c5e\u88c5\u5907\uff08\u542b\u5171\u5de5\u3001\u795d\u878d\u7b49\u7ec8\u6781\u795e\u5668\uff09\u3002</p></li></ul></li></ul><h2 class=\"bb_tag\" ><strong>\u4e09\u3001\u5e73\u6c11\u798f\u5229\u5927\u653e\u9001\uff1a\u96f6\u6c2a\u4e5f\u80fd\u5236\u9738\u5168\u670d</strong></h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>\u201c\u4e03\u65e5\u53d8\u5f3a\u8ba1\u5212\u201d\u5347\u7ea7</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u5b8c\u6210\u6bcf\u65e5\u4efb\u52a1\u5373\u53ef\u9886\u53d6<strong>\u201c\u7075\u5143\u5b9d\u7bb1\u201d</strong>\uff08\u5fc5\u51fa1000-5000\u7075\u5143\uff0c\u53ef\u7528\u4e8e\u5207\u5272\u7cfb\u7edf\u5347\u7ea7\uff09\u3002</p></li><li><p class=\"bb_paragraph\" >\u7d2f\u8ba1\u767b\u5f557\u5929\u8d60\u9001<strong>\u201c\u5e73\u6c11\u6218\u795e\u793c\u5305\u201d</strong>\uff1a\u542b\u3010\u55dc\u8840\u9879\u94fe\u00b7\u521d\u9636\u3011\uff083\u8bcd\u6761\u55dc\u8840\uff09\u3001\u3010\u5730\u9996\u4e4b\u5fa1\u00b7\u788e\u7247\u3011\u00d710\uff08\u5408\u6210\u9632\u9ebb\u75f9\u88c5\u5907\uff09\u3002</p></li></ul></li><li><p class=\"bb_paragraph\" ><strong>\u201c\u5e7b\u7fbd\u5e7d\u83b2\u201d\u4e3b\u7ebf\u4efb\u52a1\u4f18\u5316</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u65b0\u589e<strong>\u201c\u81ea\u52a8\u5bfc\u822a\u201d</strong>\u529f\u80fd\uff0c\u70b9\u51fb\u4efb\u52a1\u76ee\u6807\u5373\u53ef\u76f4\u63a5\u4f20\u9001\u81f3\u5bf9\u5e94\u5730\u56fe\uff0c\u544a\u522b\u8dd1\u56fe\u70e6\u607c\u3002</p></li><li><p class=\"bb_paragraph\" >\u4efb\u52a1\u5956\u52b1\u7ffb\u500d\uff1a\u5b8c\u6210\u4e8c\u5927\u9646\u4e3b\u7ebf\u4efb\u52a1\u989d\u5916\u8d60\u9001<strong>\u201c\u5207\u5272\u503c+1000\u201d</strong>\u7684\u6c38\u4e45BUFF\u3002</p></li></ul></li><li><p class=\"bb_paragraph\" ><strong>\u201c\u5c0f\u602a\u7206\u7ec8\u6781\u201d\u673a\u5236\u5f3a\u5316</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u4e09\u5927\u9646\u666e\u901a\u602a\u7269\u73b0\u5728\u4e5f\u6709\u6982\u7387\u6389\u843d<strong>\u201c\u5b87\u5b99\u529b\u91cf\u201d\u201c\u7cbe\u795e\u529b\u91cf\u201d</strong>\u7b49\u5408\u6210\u53c1\u5143\u529b\u91cf\u7684\u6838\u5fc3\u90e8\u4ef6\u3002</p></li><li><p class=\"bb_paragraph\" >\u8c03\u6574<strong>\u201c\u6d1b\u6cb3\u591c\u9b54\u5760\u201d</strong>\u7684\u6389\u843d\u8303\u56f4\uff1a\u6d1b\u6cb3\u533a\u57df\u6240\u6709\u602a\u7269\uff08\u5305\u62ec\u5c0f\u602a\uff09\u5747\u6709\u673a\u4f1a\u6389\u843d\uff0c\u9632\u51b0\u51bb\u6548\u679c\u5fc5\u5907\u3002</p></li></ul></li></ul><h2 class=\"bb_tag\" ><strong>\u56db\u3001\u89c6\u89c9\u4e0e\u64cd\u4f5c\u4f18\u5316\uff1a\u6c89\u6d78\u5f0f\u4f20\u5947\u4f53\u9a8c</strong></h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>\u6280\u80fd\u7279\u6548\u91cd\u5236</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>\u201c\u55dc\u8840\u72c2\u66b4\u201d</strong>\u7279\u6548\u5347\u7ea7\uff1a\u89e6\u53d1\u65f6\u5168\u8eab\u7b3c\u7f69\u8840\u8272\u5149\u8292\uff0c\u9644\u5e26<strong>\u201c\u8840\u96fe\u5f25\u6f2b\u201d</strong>\u8303\u56f4\u4f24\u5bb3\u3002</p></li><li><p class=\"bb_paragraph\" ><strong>\u201c\u5929\u9f99\u9707\u8361\u6ce2\u201d</strong>\u65b0\u589e<strong>\u201c\u9f99\u5f71\u7a7f\u68ad\u201d</strong>\u52a8\u753b\uff0c\u653b\u51fb\u8f68\u8ff9\u66f4\u6e05\u6670\uff0c\u6253\u51fb\u611f\u62c9\u6ee1\u3002</p></li></ul></li><li><p class=\"bb_paragraph\" ><strong>\u64cd\u4f5c\u4fbf\u6377\u6027\u63d0\u5347</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u65b0\u589e<strong>\u201c\u4e00\u952e\u9274\u5b9a\u201d</strong>\u529f\u80fd\uff1a\u80cc\u5305\u5185\u6240\u6709\u4e13\u5c5e\u88c5\u5907\u53ef\u6279\u91cf\u9274\u5b9a\uff0c\u8282\u7701\u5927\u91cf\u65f6\u95f4\u3002</p></li><li><p class=\"bb_paragraph\" >\u4f18\u5316<strong>\u201c\u60ac\u8d4f\u4efb\u52a1\u201d</strong>\u754c\u9762\uff1a\u73b0\u5728\u53ef\u540c\u65f6\u63a5\u53d65\u4e2a\u4efb\u52a1\uff0c\u81ea\u52a8\u89c4\u5212\u6700\u4f18\u5237\u602a\u8def\u7ebf\u3002</p></li></ul></li></ul><p class=\"bb_paragraph\" ><strong>\u5f00\u53d1\u8005\u5bc4\u8bed</strong>\uff1a <br>\u201c\u6b64\u6b21\u66f4\u65b0\u4e0d\u4ec5\u662f\u5bf9BUG\u7684\u5f7b\u5e95\u7ec8\u7ed3\uff0c\u66f4\u662f\u6211\u4eec\u5bf9\u2018\u5e73\u6c11\u4f20\u5947\u2019\u7406\u5ff5\u7684\u6df1\u5ea6\u8df5\u884c\u3002\u4ece\u8bcd\u6761\u878d\u5408\u7cfb\u7edf\u5230\u6563\u4eba\u4e89\u9738\u8d5b\uff0c\u6bcf\u4e00\u5904\u8bbe\u8ba1\u90fd\u65e8\u5728\u8ba9\u6240\u6709\u73a9\u5bb6\u2014\u2014\u65e0\u8bba\u6c2a\u91d1\u4e0e\u5426\u2014\u2014\u90fd\u80fd\u5728\u8fd9\u7247\u6c5f\u6e56\u4e2d\u627e\u5230\u5c5e\u4e8e\u81ea\u5df1\u7684\u4f20\u5947\uff01\u613f\u8bf8\u4f4d\u52c7\u58eb\u4ee5\u667a\u7834\u654c\uff0c\u4ee5\u52c7\u79f0\u738b\uff0c\u5171\u4e66\u300a\u5e1d\u5929\u4e4b\u6218\u300b\u7684\u65b0\u7bc7\u7ae0\uff01\u201d</p><p class=\"bb_paragraph\" ><strong>\u2014\u300a\u5e1d\u5929\u4e4b\u6218\u300b\u8fd0\u8425\u56e2\u961f \u656c\u4e0a</strong></p>",
    "short_description": "\u5728\u300a\u5e1d\u5929\u4e4b\u6218\u300b\uff0c\u6211\u4eec\u6495\u788e\u4e86\u201c\u6c2a\u91d1\u4e3a\u738b\u201d\u7684\u865a\u4f2a\u9762\u5177\uff01\u8fd9\u91cc\u6ca1\u6709\u78be\u538b\u5f0f\u7684\u6570\u503c\u5dee\u8ddd\uff0c\u53ea\u6709\u201c\u64cd\u4f5c\u4e0e\u667a\u6167\u201d\u7684\u5dc5\u5cf0\u8f83\u91cf\u3002\u4e13\u5c5e\u88c5\u5907\u5168\u56fe\u7206\u3001\u5c0f\u602a\u6389\u843d\u7ec8\u6781\u795e\u5668\u3001\u6563\u4eba\u540a\u6253\u571f\u8c6a\u4e0d\u518d\u662f\u5e7b\u60f3\uff01\u65e0\u8bba\u662f\u671d\u4e5d\u665a\u4e94\u7684\u4e0a\u73ed\u65cf\uff0c\u8fd8\u662f\u95f2\u6563\u72ec\u884c\u7684\u6c5f\u6e56\u5ba2\uff0c\u90fd\u80fd\u5728\u8fd9\u7247\u6df7\u6c8c\u5927\u9646\u4e2d\uff0c\u7528\u5b9e\u529b\u4e66\u5199\u5c5e\u4e8e\u81ea\u5df1\u7684\u4f20\u5947\uff01",
