/apps/3323610/extras/d15783515c5f6e9f7263ab54de0088f8.poster.avif?t=1753204354\" width=800 height=450 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3323610/extras/d15783515c5f6e9f7263ab54de0088f8.webm?t=1753204354\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3323610/extras/d15783515c5f6e9f7263ab54de0088f8.mp4?t=1753204354\" type=\"video/mp4\"></video></span></h2><h2 class=\"bb_tag\" ><strong>Upgrade. Evolve. Dominate.</strong></h2><p class=\"bb_paragraph\" >Collect DNA to supercharge your arsenal, upgrade ModBots, boost your stats, and unlock new weaponry. Every mission makes you stronger, deadlier, and better equipped to face the ever-growing threat.</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3323610/extras/ad93581b2e3895fe3065de28d7d87499.poster.avif?t=1753204354\" width=800 height=450 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3323610/extras/ad93581b2e3895fe3065de28d7d87499.webm?t=1753204354\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3323610/extras/ad93581b2e3895fe3065de28d7d87499.mp4?t=1753204354\" type=\"video/mp4\"></video></span></p><h2 class=\"bb_tag\" ><strong>Call in the Cavalry</strong></h2><p class=\"bb_paragraph\" >Summon crushing laser strikes, deploy your loyal BulletBuddy drone, and bring in supplies from orbit with strategic ModBot drops. Master the battlefield by combining air support with relentless firepower.<span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3323610/extras/cf7ed6dc77518e4a6723b93865447e1b.poster.avif?t=1753204354\" width=800 height=450 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3323610/extras/cf7ed6dc77518e4a6723b93865447e1b.webm?t=1753204354\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3323610/extras/cf7ed6dc77518e4a6723b93865447e1b.mp4?t=1753204354\" type=\"video/mp4\"></video></span></p><h2 class=\"bb_tag\" ><strong>Rescue the Lost</strong></h2><p class=\"bb_paragraph\" >Hunt down the missing crew of the\u00a0<i>Empress of Discovery</i>. Each survivor saved grants access to new weapons and critical intel to unravel the chilling mystery of what happened on Pluto.</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3323610/extras/75ae621c79be41fadb9da294170ed74d.poster.avif?t=1753204354\" width=800 height=450 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3323610/extras/75ae621c79be41fadb9da294170ed74d.webm?t=1753204354\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3323610/extras/75ae621c79be41fadb9da294170ed74d.mp4?t=1753204354\" type=\"video/mp4\"></video></span></p><h2 class=\"bb_tag\" ><strong>Die. Upgrade. Return Stronger.</strong></h2><p class=\"bb_paragraph\" >Failure isn\u2019t the end \u2014 it\u2019s fuel for your comeback. Return to the\u00a0<i>Gilded Seeker</i>, unlock permanent upgrades, grab new gear, and dive back in with a vengeance.</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3323610/extras/80a1f519c88dce7969a436f1237beff7.poster.avif?t=1753204354\" width=800 height=450 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3323610/extras/80a1f519c88dce7969a436f1237beff7.webm?t=1753204354\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3323610/extras/80a1f519c88dce7969a436f1237beff7.mp4?t=1753204354\" type=\"video/mp4\"></video></span></p><h2 class=\"bb_tag\" ><strong>Exterminate the Swarm. Save Pluto. Become a Legend.</strong></h2><p class=\"bb_paragraph\" >Battle your way through monstrous hordes and towering bosses across five deadly biomes. Rescue the lost, reclaim Pluto, and crush the Swarm before it spreads to the rest of the system.</p><p class=\"bb_paragraph\" ><strong>Suit up, Commander. The fate of the outer colonies is in your hands.</strong><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3323610/extras/9a4afe883aa1fb217b7d83944c76bfa7.poster.avif?t=1753204354\" width=800 height=450 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3323610/extras/9a4afe883aa1fb217b7d83944c76bfa7.webm?t=1753204354\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3323610/extras/9a4afe883aa1fb217b7d83944c76bfa7.mp4?t=1753204354\" type=\"video/mp4\"></video></span></p>",
