{
    "type": "game",
    "name": "Spider Canyon",
    "steam_appid": 3451200,
    "required_age": 0,
    "is_free": false,
    "controller_support": "full",
    "detailed_description": "<p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3451200/extras/6281d2304ad644e1eff1920fe239f344.poster.avif?t=1749469441\" width=320 height=180 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3451200/extras/6281d2304ad644e1eff1920fe239f344.webm?t=1749469441\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3451200/extras/6281d2304ad644e1eff1920fe239f344.mp4?t=1749469441\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><i>Spider Canyon </i>is a 3D physics platformer game set in the dangerous <i>Mojave</i> desert. Jump through hand-crafted environments to test your wits and parkour skills to reach the finish the line the fastest. Bounce, leap, and survive. <strong>Gravity is your playground!</strong></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3451200/extras/ee4c0fedcec27d86a74d362f64bfe145.poster.avif?t=1749469441\" width=320 height=180 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3451200/extras/ee4c0fedcec27d86a74d362f64bfe145.webm?t=1749469441\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3451200/extras/ee4c0fedcec27d86a74d362f64bfe145.mp4?t=1749469441\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" >Key Features</h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >Shoot webs that turn once hard and dangerous surfaces of the desert into bounce pads to navigate the environment with.</p></li><li><p class=\"bb_paragraph\" >Precise physics based movement to master.</p></li><li><p class=\"bb_paragraph\" >Use the in-game timer to track your progress and chase the time down.</p></li><li><p class=\"bb_paragraph\" >In-game free movement mode to explore the level and plot your path.</p></li><li><p class=\"bb_paragraph\" ><strong>24</strong> hand made levels.</p></li><li><p class=\"bb_paragraph\" >Minimalist and clean UI and graphics.</p></li><li><p class=\"bb_paragraph\" >Desert themed soundtrack and sound effects.</p></li></ul><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3451200/extras/b0a1b0ac94bca60a730d8b12d1de7202.poster.avif?t=1749469441\" width=320 height=180 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3451200/extras/b0a1b0ac94bca60a730d8b12d1de7202.webm?t=1749469441\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3451200/extras/b0a1b0ac94bca60a730d8b12d1de7202.mp4?t=1749469441\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p>",
    "about_the_game": "<p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3451200/extras/6281d2304ad644e1eff1920fe239f344.poster.avif?t=1749469441\" width=320 height=180 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3451200/extras/6281d2304ad644e1eff1920fe239f344.webm?t=1749469441\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3451200/extras/6281d2304ad644e1eff1920fe239f344.mp4?t=1749469441\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><i>Spider Canyon </i>is a 3D physics platformer game set in the dangerous <i>Mojave</i> desert. Jump through hand-crafted environments to test your wits and parkour skills to reach the finish the line the fastest. Bounce, leap, and survive. <strong>Gravity is your playground!</strong></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3451200/extras/ee4c0fedcec27d86a74d362f64bfe145.poster.avif?t=1749469441\" width=320 height=180 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3451200/extras/ee4c0fedcec27d86a74d362f64bfe145.webm?t=1749469441\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3451200/extras/ee4c0fedcec27d86a74d362f64bfe145.mp4?t=1749469441\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" >Key Features</h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >Shoot webs that turn once hard and dangerous surfaces of the desert into bounce pads to navigate the environment with.</p></li><li><p class=\"bb_paragraph\" >Precise physics based movement to master.</p></li><li><p class=\"bb_paragraph\" >Use the in-game timer to track your progress and chase the time down.</p></li><li><p class=\"bb_paragraph\" >In-game free movement mode to explore the level and plot your path.</p></li><li><p class=\"bb_paragraph\" ><strong>24</strong> hand made levels.</p></li><li><p class=\"bb_paragraph\" >Minimalist and clean UI and graphics.</p></li><li><p class=\"bb_paragraph\" >Desert themed soundtrack and sound effects.</p></li></ul><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3451200/extras/b0a1b0ac94bca60a730d8b12d1de7202.poster.avif?t=1749469441\" width=320 height=180 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3451200/extras/b0a1b0ac94bca60a730d8b12d1de7202.webm?t=1749469441\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3451200/extras/b0a1b0ac94bca60a730d8b12d1de7202.mp4?t=1749469441\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p>",
    "short_description": "Set in an unforgiving desert world, SPIDER CANYON is a first person physics-based puzzle platformer where you play as a spider. Use your trusty spiderweb to scale the dangerous desert terrain and reach the finish line. Good luck!",
