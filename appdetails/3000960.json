    "name": "\u5438\u8840\u9b3c\u306e\u82b1\u5ac1 \u30f4\u30a1\u30f3\u30d7\u30c9\u30fc\u30eb\u306e\u306f\u306a\u3088\u3081 The Novel Game",
    "steam_appid": 3000960,
