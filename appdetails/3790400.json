    "detailed_description": "<h2 class=\"bb_tag\" ><strong>\u904a\u6232\u7279\u8272</strong></h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u4e3b\u8981\u5287\u60c5\u6bb5\u843d\u7686\u642d\u914d<strong>\u5168\u65e5\u6587\u8a9e\u97f3</strong>\u6f14\u51fa\u3002</p></li><li><p class=\"bb_paragraph\" >\u7ae5\u8a71\u98a8\u683c\u8207\u548c\u98a8\u5e7b\u60f3\u4ea4\u7e54\u7684\u4e16\u754c\u89c0\u3002</p></li><li><p class=\"bb_paragraph\" >\u4ee5\u89d2\u8272\u9593\u7684\u4e92\u52d5\u8207\u611f\u60c5\u8b8a\u5316\u70ba\u6838\u5fc3\uff0c\u8457\u91cd\u6c1b\u570d\u8207\u7d30\u81a9\u60c5\u611f\u7684\u63cf\u5beb\u3002</p></li><li><p class=\"bb_paragraph\" >\u7c21\u55ae\u7684\u4e92\u52d5\u7cfb\u7d71\uff0c\u8b93\u73a9\u5bb6\u5c08\u6ce8\u65bc\u6545\u4e8b\u672c\u8eab\u7684\u9ad4\u9a57\u3002</p></li></ul><h2 class=\"bb_tag\" ><strong>\u80cc\u666f\u6545\u4e8b</strong></h2><p class=\"bb_paragraph\" >\u6f02\u6cca\u7684\u5deb\u5973\u300c\u827e\u8299\u300d\uff0c\u5728\u5922\u4e2d\u807d\u898b\u4e86\u795e\u660e\u7684\u547c\u559a\u3002</p><p class=\"bb_paragraph\" >\u9192\u4f86\u5f8c\uff0c\u5979\u6c7a\u5b9a\u5faa\u8457\u5922\u4e2d\u7684\u6307\u5f15\uff0c\u524d\u5f80\u9727\u6c23\u7e5a\u7e5e\u7684\u795e\u660e\u6240\u5728\u4e4b\u8655\u2014\u2014\u9727\u96b1\u5c71\u3002</p><p class=\"bb_paragraph\" >\u5979\u5faa\u8457\u611f\u61c9\uff0c\u7a7f\u8d8a\u4e86\u5c71\u4e0a\u7684\u7d50\u754c\u2014\u2014\u4f86\u5230\u4e86\u6df1\u5c71\u7684\u795e\u793e\u4e4b\u4e2d\u3002</p><p class=\"bb_paragraph\" >\u5728\u90a3\u88e1\uff0c\u5979\u8207\u88ab\u85cf\u533f\u7684\u795e\u660e\u300c\u5e0c\u723e\u300d\u76f8\u9047\u4e86\u2026\u2026</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\u7942\u662f\u795e\u660e\uff0c\u4e5f\u662f\u56da\u5f92\u3002</p><p class=\"bb_paragraph\" >\u5979\u662f\u65c5\u4eba\uff0c\u4ea6\u662f\u5f15\u5c0e\u8005\u3002</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\u9019\u662f\u4e00\u6bb5\u95dc\u65bc\u7121\u540d\u795e\u660e\u8207\u6f02\u6cca\u5deb\u5973\u7684\u6545\u4e8b\u2026\u2026</p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" ><strong>\u904a\u6232\u985e\u578b</strong></h2><p class=\"bb_paragraph\" >\u5287\u60c5\u63a2\u7d22\u4e92\u52d5\u5c0f\u8aaa</p><h2 class=\"bb_tag\" ><strong>\u64cd\u4f5c\u65b9\u5f0f</strong></h2><p class=\"bb_paragraph\" >\u9375\u76e4\u64cd\u4f5c\u89d2\u8272\u79fb\u52d5\u3001\u4e92\u52d5</p><h2 class=\"bb_tag\" ><strong>\u904a\u6232\u8aaa\u660e\u3000</strong></h2><p class=\"bb_paragraph\" >\u73a9\u5bb6\u5c07\u64cd\u4f5c\u89d2\u8272\u4f86\u63a2\u7d22\u5169\u4eba\u4e4b\u9593\u7684\u6545\u4e8b\u53ca\u89c0\u8cde\u6f14\u51fa</p><p class=\"bb_paragraph\" >\u904a\u6232\u4e2d\u6703\u7a7f\u63d2 QTE \u5c0f\u904a\u6232\u8ddf\u5730\u5716\u63a2\u7d22\u7684\u4e92\u52d5</p><p class=\"bb_paragraph\" >\u4e0d\u7528\u64d4\u5fc3\u904a\u6232\u5931\u6557\uff0c\u53ef\u4ee5\u8f15\u9b06\u7684\u9ad4\u9a57\u904a\u6232\u5287\u60c5</p><p class=\"bb_paragraph\" ></p>",
