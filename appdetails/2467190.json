    "about_the_game": "\u7ecf\u5178\u56de\u5408\u5236\u89d2\u8272\u7b56\u7565\u6e38\u620f\u3010\u4e09\u56fd\u7acb\u5fd7\u4f203\u3011\uff0c\u4ee5\u5176\u4e00\u8d2f\u7684\u641e\u7b11\u98ce\u683c\u3001\u98a0\u8986\u5386\u53f2\u7684\u5267\u60c5\u8bbe\u8ba1\u3001\uff31\u7248\u660e\u4eae\u7684\u753b\u98ce\u3001\u4ee5\u53ca\u9ad8\u81ea\u7531\u5ea6\u7684\u4efb\u52a1\u9009\u62e9\uff0c\u5448\u73b0\u7ed9\u73a9\u5bb6\u8f7b\u677e\u73a9\u4e50\u3001\u72c2\u60f3\u6709\u8da3\u7684\u6e38\u620f\u98ce\u683c\u3002<br><br><strong><h2 class=\"bb_tag\" > \u25c6\u6253\u9020\u4e13\u5c5e\u6700\u5f3a\u961f\u4f0d</h2></strong><br> 3\u4ee3\u4e2d\u5f3a\u5316\u4e86\u6bcf\u4e2a\u4eba\u7269\u72ec\u7279\u7684\u6280\u80fd\uff0c\u4f8b\u5982\u5f53\u4f53\u529b\u4e3a\u96f6\u65f6\uff0c\u4f1a\u53d8\u6210\u732b\u718a\u7684\u300c\u53d8\u8eab\u6280\u300d\u3001\u5728\u5546\u5e97\u4e70\u4e1c\u897f\u4eab\u6709\u6298\u6263\u7684\u300c\u8bae\u4ef7\u6280\u300d\u3001\u6709\u4e00\u5b9a\u673a\u7387\u65bd\u5c55\u4e24\u6b21\u653b\u51fb\u7684\u300c\u8fde\u51fb\u6280\u300d\uff0c\u8fd8\u6709\u65b0\u589e\u7684\u94fe\u5175\u5668\u653b\u51fb\u7cfb\u53ca\u591a\u6837\u6cd5\u672f\u7b49\u73a9\u5bb6\u63a2\u7d22\uff0c\u5728\u5192\u9669\u8fc7\u7a0b\u4e2d\u53ef\u9047\u523050\u591a\u4f4d\u5404\u5177\u7279\u8272\u7684\u4f19\u4f34\uff0c\u5feb\u6765\u7ec4\u7ec7\u81ea\u5df1\u4e13\u5c5e\u7684\u5192\u9669\u961f\u4f0d\u5427\uff01<h2 class=\"bb_tag\" > <strong>\u25c6\u4e30\u5bcc\u7684\u4efb\u52a1\u5173\u5361\u53ca\u79fb\u52a8\u7684\u5730\u56fe</strong></h2>3\u4ee3\u63d0\u4f9b\u4e86\u66f4\u591a\u4e0d\u540c\u7684\u5173\u5361\u53ca\u6570\u4e2a\u4f1a\u52a8\u7684\u5730\u56fe\u5173\uff0c\u4f8b\u5982\u5728\u901a\u5929\u6797\uff0c\u73a9\u5bb6\u5f97\u722c\u4e0a\u5927\u6811\uff0c\u5728\u5f71\u54cd\u79fb\u52a8\u8303\u56f4\u968f\u98ce\u5439\u52a8\u7684\u4e91\u6735\u4e2d\u4f5c\u6218\u3002\u5728\u5de8\u874e\u4e4b\u4e18\u4f5c\u6218\u4e4b\u4f59\u8fd8\u8981\u7559\u610f\u7ad9\u4f4d\uff0c\u903c\u514d\u5de8\u874e\u5c3e\u90e8\u7684\u6bd2\u9488\u653b\u51fb\u3002\u8c82\u8749\u548c\u5415\u5e03\u5c0f\u4e24\u53e3\u5435\u67b6\u4e86\uff0c\u60f3\u8981\u5c06\u8c82\u5927\u7f8e\u4eba\u7eb3\u5165\u9ebe\u4e0b\uff0c\u73a9\u5bb6\u5219\u5fc5\u987b\u8981\u300c\u5355\u6311\u5415\u5e03\u300d!?\u4e30\u5bcc\u7684\u8fc7\u5173\u578b\u6001\u914d\u5408\u957f\u3001\u77ed\u3001\u5f13\u3001\u94fe\u56db\u7cfb\u5175\u5668\uff0c\u8ba9\u73a9\u5bb6\u6311\u6218\u8d77\u6765\u66f4\u6709\u4e50\u8da3\u3002<h2 class=\"bb_tag\" > <strong>\u25c6\u5f00\u653e\u7684\u4e16\u754c\u89c2\u8003\u9a8c\u73a9\u5bb6\u6218\u7565\u5934\u8111</strong></h2>3\u4ee3\u4e5f\u8ba9\u6bcf\u5ea7\u57ce\u6c60\u6dfb\u52a0\u4e86\u72ec\u7279\u6027\uff0c\u65b0\u589e\u591a\u79cd\u573a\u6240\u3001\u72ec\u5bb6\u5546\u54c1\u8fd8\u6709\u5404\u79cd\u6253\u5de5\uff0c\u8fde\u5b66\u5802\u4e5f\u53d8\u6210\u4e86\u73a9\u5bb6\u53ef\u4ee5\u64cd\u4f5c\u7684\u5c0f\u6e38\u620f\uff0c\u8ba9\u73a9\u5bb6\u5728\u9009\u62e9\u5730\u56fe\u79fb\u52a8\u65f6\u66f4\u589e\u6218\u7565\u610f\u4e49\u3002<h2 class=\"bb_tag\" > <strong>\u25c6\u641c\u96c6\u795e\u79d8\u53e4\u6587\u7ec4\u5408\u9ad8\u7ea7\u88c5\u5907</strong></h2>\u3010\u4e09\u56fd\u7acb\u5fd7\u4f203\u3011steam\u7248\u4e2d\u4ee5\u300c\u9690\u85cf\u5173\u5361\u300d\u7684\u65b9\u5f0f\u4fdd\u7559\u4e86\u4ee5\u524d\u8054\u673a\u6253\u5b9d\u6a21\u5f0f\u4e0b\u624d\u80fd\u641c\u96c6\u7684\u53e4\u6587\u5b57\u795e\u79d8\u88c5\u5907\uff0c\u8fd9\u4e9b\u88c5\u5907\u4e0a\u90fd\u6709 1 \u4e2a\u53e4\u6587\u5b57\uff0c\u53ea\u8981\u8eab\u4e0a\u88c5\u5907\u7b26\u5408\u53e4\u6587\u5b57\u7ec4\uff0c\u5c31\u4f1a\u542f\u52a8\u795e\u79d8\u7684\u53e4\u6587\u7ec4\u6548\u679c\u3002\u4e5f\u4fdd\u7559\u4e86\u516c\u5171\u4ed3\u5e93\uff0c\u5fc5\u5b9a\u80fd\u6ee1\u8db3\u559c\u7231\u6536\u96c6\u88c5\u5907\u7684\u73a9\u5bb6\uff01",
