    "detailed_description": "<p class=\"bb_paragraph\" ><i>\u8996\u754c\u3092\u906e\u65ad\uff08\u3068\u3056\uff09\u3057\u3066\u2015\u2015\u6575\u3092\u8a0e\u3066</i></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\u8996\u754c\u3092\u9589\u3056\u3059\u3068\u3001\u6575\u306e\u653b\u6483\u4e88\u5146\u304c\u898b\u3048\u308b\u3002</p><p class=\"bb_paragraph\" >\u6575\u306e\u8996\u754c\u3092\u6f5c\u308a\u629c\u3051\u3066\u6226\u3046\u3001\u65b0\u611f\u899a\u30fb\u30b9\u30c6\u30eb\u30b9\u5f3e\u5e55\u30b7\u30e5\u30fc\u30c6\u30a3\u30f3\u30b0\u30b2\u30fc\u30e0\u3002</p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" >\u30b9\u30c8\u30fc\u30ea\u30fc</h2><p class=\"bb_paragraph\" >\u592e\u5dde\u304b\u3089\u3001\u5317\u6771\u3078\u4e09\u5341\u4f59\u91cc\u3002\u4e16\u3092\u5fcd\u3076\u3001\u5996\u8853\u4f7f\u3044\u306e\u96a0\u308c\u91cc\u3002</p><p class=\"bb_paragraph\" >\u305d\u306e\u5730\u3067\u80b2\u3063\u305f\u30aa\u30ec\u306f\u3001\u7523\u307e\u308c\u3064\u304d\u3010\u9b54\u773c\u3011\u3092\u6301\u3063\u3066\u3044\u305f\u3002</p><p class=\"bb_paragraph\" >\u3042\u306e\u65e5\u3001\u8a0e\u4f10\u4efb\u52d9\u3092\u53d7\u3051\u305f\u30aa\u30ec\u306f\u3010\u30e4\u30c4\u3011\u3068\u306e\u95d8\u3044\u3067\u4e0d\u899a\u3092\u53d6\u3063\u305f\u3002</p><p class=\"bb_paragraph\" >\u3010\u9b54\u773c\u3011\u306f\u3010\u546a\u3044\u3011\u306b\u4e0a\u66f8\u304d\u3055\u308c\u3001\u8996\u754c\u306b\u5165\u308b\u5168\u3066\u3092\u3001\u618e\u60aa\u306b\u99c6\u308a\u7acb\u3066\u305f\u3002</p><p class=\"bb_paragraph\" >\u91cc\u306e\u9577\u8001\u8846\u306f\u3001\u3053\u306e\u4e8b\u614b\u3092\u53d7\u3051\u3066\u3001\u90aa\u773c\u306e\u546a\u3044\u3092\u89e3\u304f\u305d\u306e\u65e5\u307e\u3067\u3001</p><p class=\"bb_paragraph\" >\u30aa\u30ec\u306b\u300c\u6545\u90f7\u300d\u3078\u5e30\u308b\u3053\u3068\u3092\u3001\u56fa\u304f\u7981\u3058\u308b\u3053\u3068\u3068\u3057\u305f\u2015\u2015\u3002</p><p class=\"bb_paragraph\" >\u618e\u3057\u307f\u306b\u7e0b\u308a\u3001\u751f\u304d\u9577\u3089\u3048\u308b\u4e2d\u3001\u4e0d\u610f\u306b\u3001\u3055\u3055\u3084\u304b\u306a\u5e0c\u671b\u306f\u3082\u305f\u3089\u3055\u308c\u305f\u3002</p><p class=\"bb_paragraph\" >\u80e1\u4e71\u306a\u5642\u306b\u3082\u7e0b\u308b\u3001\u81ea\u5206\u306b\u82e6\u7b11\u3057\u3064\u3064\u3001\u30aa\u30ec\u306f\u3010\u9b3c\u821e\u5dba\u3011\u306e\u796d\u58c7\u3078\u3068\u5411\u304b\u3063\u305f\u2015\u2015\u3002</p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" >\u30ad\u30e3\u30e9\u30af\u30bf\u30fc</h2><p class=\"bb_paragraph\" ><strong>\u96ea\u51ea</strong>\uff08Setsuna\uff09</p><p class=\"bb_paragraph\" >\u53f3\u76ee\u306b\u546a\u3044\u3092\u5bbf\u3059\u5c11\u5e74\u3002</p><p class=\"bb_paragraph\" >\u305d\u306e\u53f3\u76ee\u3092\u76f4\u8996\u3059\u308b\u3068\u3001\u5f31\u304d\u8005\u306f\u8ca0\u306e\u611f\u60c5\u306b\u652f\u914d\u3055\u308c\u3066\u3057\u307e\u3046\u3002</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><strong>\u516d\u82b1</strong>\uff08Rikka\uff09</p><p class=\"bb_paragraph\" >\u9b54\u773c\u93e1\u3092\u304b\u3051\u305f\u76f2\u76ee\u306e\u5c11\u5973\u3002</p><p class=\"bb_paragraph\" >\u30ec\u30f3\u30ba\u304b\u3089\u653e\u51fa\u3055\u308c\u308b\u9b54\u529b\u306e\u652f\u914d\u304b\u3089\u8996\u529b\u3092\u5f97\u3066\u3044\u308b\u304c\u3001</p><p class=\"bb_paragraph\" >\u305d\u306e\u9b54\u529b\u306f\u529b\u306a\u304d\u8005\u3092\u523a\u6fc0\u3057\u3066\u3057\u307e\u3046\u3002</p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" >\u30b2\u30fc\u30e0\u30b7\u30b9\u30c6\u30e0</h2><p class=\"bb_paragraph\" >\u672c\u4f5c\u306f\u7e26\u30b9\u30af\u30ed\u30fc\u30eb\u578b\u306e\u5f3e\u5e55\u30b7\u30e5\u30fc\u30c6\u30a3\u30f3\u30b0\u30b2\u30fc\u30e0\u3067\u3059\u3002</p><p class=\"bb_paragraph\" >\u4e00\u90e8\u306e\u6575\u306b\u306f\u300c\u8996\u754c\u300d\u304c\u5b58\u5728\u3057\u3001\u8996\u754c\u306b\u5165\u308b\u3068\u5f3e\u5e55\u304c\u6fc0\u3057\u304f\u306a\u3063\u3066\u3057\u307e\u3044\u307e\u3059\u3002</p><p class=\"bb_paragraph\" >\u6575\u306e\u8996\u754c\u306f\u666e\u6bb5\u306f\u898b\u3048\u305a\u3001\u300c\u5fc3\u773c\u300d\u3092\u4f7f\u3046\u3053\u3068\u3067\u6575\u306e\u8996\u754c\u304c\u898b\u3048\u308b\u3088\u3046\u306b\u306a\u308a\u307e\u3059\u304c\u3001</p><p class=\"bb_paragraph\" >\u305d\u306e\u4ee3\u308f\u308a\u306b\u5f3e\u5e55\u304c\u898b\u3048\u308b\u7bc4\u56f2\u304c\u72ed\u304f\u306a\u3063\u3066\u3057\u307e\u3044\u307e\u3059\u3002</p><p class=\"bb_paragraph\" >\u306a\u308b\u3079\u304f\u6575\u306b\u898b\u3064\u304b\u3089\u306a\u3044\u3088\u3046\u306b\u8996\u754c\u3092\u304f\u3050\u308a\u629c\u3051\u306a\u304c\u3089\u6575\u3092\u5012\u3057\u307e\u3057\u3087\u3046\u3002</p><p class=\"bb_paragraph\" >\u8a73\u3057\u304f\u306f\u30b2\u30fc\u30e0\u5185\u306e\u30c1\u30e5\u30fc\u30c8\u30ea\u30a2\u30eb\u3092\u3054\u78ba\u8a8d\u304f\u3060\u3055\u3044\u3002</p>",
    "about_the_game": "<p class=\"bb_paragraph\" ><i>\u8996\u754c\u3092\u906e\u65ad\uff08\u3068\u3056\uff09\u3057\u3066\u2015\u2015\u6575\u3092\u8a0e\u3066</i></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\u8996\u754c\u3092\u9589\u3056\u3059\u3068\u3001\u6575\u306e\u653b\u6483\u4e88\u5146\u304c\u898b\u3048\u308b\u3002</p><p class=\"bb_paragraph\" >\u6575\u306e\u8996\u754c\u3092\u6f5c\u308a\u629c\u3051\u3066\u6226\u3046\u3001\u65b0\u611f\u899a\u30fb\u30b9\u30c6\u30eb\u30b9\u5f3e\u5e55\u30b7\u30e5\u30fc\u30c6\u30a3\u30f3\u30b0\u30b2\u30fc\u30e0\u3002</p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" >\u30b9\u30c8\u30fc\u30ea\u30fc</h2><p class=\"bb_paragraph\" >\u592e\u5dde\u304b\u3089\u3001\u5317\u6771\u3078\u4e09\u5341\u4f59\u91cc\u3002\u4e16\u3092\u5fcd\u3076\u3001\u5996\u8853\u4f7f\u3044\u306e\u96a0\u308c\u91cc\u3002</p><p class=\"bb_paragraph\" >\u305d\u306e\u5730\u3067\u80b2\u3063\u305f\u30aa\u30ec\u306f\u3001\u7523\u307e\u308c\u3064\u304d\u3010\u9b54\u773c\u3011\u3092\u6301\u3063\u3066\u3044\u305f\u3002</p><p class=\"bb_paragraph\" >\u3042\u306e\u65e5\u3001\u8a0e\u4f10\u4efb\u52d9\u3092\u53d7\u3051\u305f\u30aa\u30ec\u306f\u3010\u30e4\u30c4\u3011\u3068\u306e\u95d8\u3044\u3067\u4e0d\u899a\u3092\u53d6\u3063\u305f\u3002</p><p class=\"bb_paragraph\" >\u3010\u9b54\u773c\u3011\u306f\u3010\u546a\u3044\u3011\u306b\u4e0a\u66f8\u304d\u3055\u308c\u3001\u8996\u754c\u306b\u5165\u308b\u5168\u3066\u3092\u3001\u618e\u60aa\u306b\u99c6\u308a\u7acb\u3066\u305f\u3002</p><p class=\"bb_paragraph\" >\u91cc\u306e\u9577\u8001\u8846\u306f\u3001\u3053\u306e\u4e8b\u614b\u3092\u53d7\u3051\u3066\u3001\u90aa\u773c\u306e\u546a\u3044\u3092\u89e3\u304f\u305d\u306e\u65e5\u307e\u3067\u3001</p><p class=\"bb_paragraph\" >\u30aa\u30ec\u306b\u300c\u6545\u90f7\u300d\u3078\u5e30\u308b\u3053\u3068\u3092\u3001\u56fa\u304f\u7981\u3058\u308b\u3053\u3068\u3068\u3057\u305f\u2015\u2015\u3002</p><p class=\"bb_paragraph\" >\u618e\u3057\u307f\u306b\u7e0b\u308a\u3001\u751f\u304d\u9577\u3089\u3