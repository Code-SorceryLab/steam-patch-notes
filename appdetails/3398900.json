{
    "type": "game",
    "name": "The Turkish Bazaar",
    "steam_appid": 3398900,
    "required_age": 0,
    "is_free": true,
    "detailed_description": "<p class=\"bb_paragraph\" ><strong>Experience the excitement of being a real market vendor with &quot;The Turkish Bazaar&quot;!</strong></p><p class=\"bb_paragraph\" ><strong>Game Features:</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>Wholesale Product Purchasing from the Market Halls:</strong> Buy vegetables, fruits, and other goods wholesale from the central market halls of cities. Carefully evaluate the price and quality of each product.</p></li><li><p class=\"bb_paragraph\" ><strong>Realistic Vehicle Loading Mechanics:</strong> Load your van with goods carefully and balanced to prevent spills on the road.</p></li><li><p class=\"bb_paragraph\" ><strong>Detailed Stall Setup System:</strong> Organize your stall freely and display your products in a way that attracts customers\u2019 attention.</p></li><li><p class=\"bb_paragraph\" ><strong>Dynamic Customer Interactions:</strong> Use your bargaining skills to make deals with customers and meet their needs to gain loyal buyers.</p></li><li><p class=\"bb_paragraph\" ><strong>Realistic Economy System:</strong> Adjust product prices according to market conditions, optimize your profit margins, and become the most successful vendor in the market!</p></li></ul>",
    "about_the_game": "<p class=\"bb_paragraph\" ><strong>Experience the excitement of being a real market vendor with &quot;The Turkish Bazaar&quot;!</strong></p><p class=\"bb_paragraph\" ><strong>Game Features:</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>Wholesale Product Purchasing from the Market Halls:</strong> Buy vegetables, fruits, and other goods wholesale from the central market halls of cities. Carefully evaluate the price and quality of each product.</p></li><li><p class=\"bb_paragraph\" ><strong>Realistic Vehicle Loading Mechanics:</strong> Load your van with goods carefully and balanced to prevent spills on the road.</p></li><li><p class=\"bb_paragraph\" ><strong>Detailed Stall Setup System:</strong> Organize your stall freely and display your products in a way that attracts customers\u2019 attention.</p></li><li><p class=\"bb_paragraph\" ><strong>Dynamic Customer Interactions:</strong> Use your bargaining skills to make deals with customers and meet their needs to gain loyal buyers.</p></li><li><p class=\"bb_paragraph\" ><strong>Realistic Economy System:</strong> Adjust product prices according to market conditions, optimize your profit margins, and become the most successful vendor in the market!</p></li></ul>",
    "short_description": "&quot;The Turkish Bazaar&quot; offers players a true bazaar vendor experience. Purchase products wholesale from the hal, load your vehicle, set up your stall, and engage with dynamic customers to become the most successful vendor in the bazaar!",
