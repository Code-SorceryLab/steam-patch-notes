    "steam_appid": 3199080,
    "required_age": 0,
    "is_free": false,
    "controller_support": "full",
    "detailed_description": "<p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3199080/extras/d115ae082ed4df57164c493a70c4a717.avif?t=1752222293\" data-has-big width=800 height=450 /></span></p><h2 class=\"bb_tag\" >HellPunk - Gore Action Roguelite Game</h2><p class=\"bb_paragraph\" >HellPunk is a gore action roguelite game based in a steampunk-flavored hell. Blast your way through the horrific foes and inhabitants of Hell to reach the final chamber.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3199080/extras/254b242cc66a595f919adab970e9ec73.avif?t=1752222293\" data-has-big width=800 height=524 /></span></p><h2 class=\"bb_tag\" >The Story</h2><p class=\"bb_paragraph\" >Asher Drake, the protagonist, lives a rough life.</p><p class=\"bb_paragraph\" >His younger sister, the only family he had left, disappeared 20 years ago and he still travels the country trying to find out the truth behind her disappearance.</p><p class=\"bb_paragraph\" >But one day, a freak accident strikes.</p><p class=\"bb_paragraph\" >When he opened his eyes, all he saw was steam, running machinery, and... The tower.</p><p class=\"bb_paragraph\" >Realizing that his sister is in the giant tower in front of him, he starts a death race up and down the hellish tower to find the truth about his missing sister.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3199080/extras/ddeec2db275fc37d1ba123fe74b82bf9.poster.avif?t=1752222293\" width=800 height=450 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3199080/extras/ddeec2db275fc37d1ba123fe74b82bf9.webm?t=1752222293\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3199080/extras/ddeec2db275fc37d1ba123fe74b82bf9.mp4?t=1752222293\" type=\"video/mp4\"></video></span></p><h2 class=\"bb_tag\" >side-scrolling platformer action roguelite game</h2><p class=\"bb_paragraph\" >HellPunk is a roguelite-style action and platformer game with a different map and enemy composition every time.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3199080/extras/69b754aedd0215d9bc8426fb709c7421.poster.avif?t=1752222293\" width=800 height=450 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3199080/extras/69b754aedd0215d9bc8426fb709c7421.webm?t=1752222293\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3199080/extras/69b754aedd0215d9bc8426fb709c7421.mp4?t=1752222293\" type=\"video/mp4\"></video></span></p><h2 class=\"bb_tag\" >Blood splattering, flesh falling gore action</h2><p class=\"bb_paragraph\" >Experience the essence of gore and grotesqueness as limbs are ripped off and blown away with every monster you kill.</p><p class=\"bb_paragraph\" >Blast your way to the end of the Tower as you explode monsters with human flesh on top, ripped open, and exposed veins.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3199080/extras/fcd1629c34cbc7523e50d139f1f652db.poster.avif?t=1752222293\" width=800 height=450 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3199080/extras/fcd1629c34cbc7523e50d139f1f652db.webm?t=1752222293\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3199080/extras/fcd1629c34cbc7523e50d139f1f652db.mp4?t=1752222293\" type=\"video/mp4\"></video></span></p><h2 class=\"bb_tag\" >Stylish action with real-time weapon swapping</h2><p class=\"bb_paragraph\" >Pick up 2 of 7 different weapons themed to the 7 deadly sins and take on the challenge of conquering the tower.</p><p class=\"bb_paragraph\" >Switch between weapons and combine your skills to take down monsters.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3199080/extras/d3192e2b1bd7f0cc41c18a7701434ed7.avif?t=1752222293\" data-has-big width=800 height=450 /></span></p><h2 class=\"bb_tag\" >Customize your build with a variety of upgrades</h2><p class=\"bb_paragraph\" >'Gears' with different buffs inspired by Solomon's 72 Demons</p><p class=\"bb_paragraph\" >'Skill Swap' to switch out and enhance skills to your taste</p><p class=\"bb_paragraph\" >'Operating Table' to grant permanent physical enhancements with bloodstones</p><p class=\"bb_paragraph\" >Customize your build with a wide variety of compelling upgrades that match the unique atmosphere of HellPunk.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3199080/extras/5082aef14b8adc922d61a255854d43f7.avif?t=1752222293\" data-has-big width=800 height=450 /></span></p><h2 class=\"bb_tag\" >Diverse side stories</h2><p class=\"bb_paragraph\" >You'll meet a variety of interesting NPCs in your basecamp.</p><p class=\"bb_paragraph\" >Each NPC has their own story and will ask you to help them with various tasks.</p><p class=\"bb_paragraph\" >Their requests can be as simple as asking you to kill a monster, or as complex as forcing you to make a difficult, brutal choice.</p><p class=\"bb_paragraph\" >Experience a unique and delicately crafted hell through quests.</p>",
    "about_the_game": "<p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3199080/extras/d115ae082ed4df57164c493a70c4a717.avif?t=1752222293\" data-has-big width=800 height=450 /></span></p><h2 class=\"bb_tag\" >HellPunk - Gore Action Roguelite Game</h2><p class=\"bb_paragraph\" >HellPunk is a gore action roguelite game based in a steampunk-flavored hell. Blast your way through the horrific foes and inhabitants of Hell to reach the final chamber.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3199080/extras/254b242cc66a595f919adab970e9ec73.avif?t=1752222293\" data-has-big width=800 height=524 /></span></p><h2 class=\"bb_tag\" >The Story</h2><p class=\"bb_paragraph\" >Asher Drake, the protagonist, lives a rough life.</p><p class=\"bb_paragraph\" >His younger sister, the only family he had left, disappeared 20 years ago and he still travels the country trying to find out the truth behind her disappearance.</p><p class=\"bb_paragraph\" >But one day, a freak accident strikes.</p><p class=\"bb_paragraph\" >When he opened his eyes, all he saw was steam, running machinery, and... The tower.</p><p class=\"bb_paragraph\" >Realizing that his sister is in the giant tower in front of him, he starts a death race up and down the hellish tower to find the truth about his missing sister.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3199080/extras/ddeec2db275fc37d1ba123fe74b82bf9.poster.avif?t=1752222293\" width=800 height=450 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3199080/extras