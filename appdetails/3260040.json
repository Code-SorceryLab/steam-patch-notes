    "controller_support": "full",
    "detailed_description": "<p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3260040/extras/edcdf4cb9dc69a5f9670edb453e7bf9e.poster.avif?t=1754449216\" width=622 height=100 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3260040/extras/edcdf4cb9dc69a5f9670edb453e7bf9e.webm?t=1754449216\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3260040/extras/edcdf4cb9dc69a5f9670edb453e7bf9e.mp4?t=1754449216\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" >How deep will you go?\u00a0</p><p class=\"bb_paragraph\" ><strong>COLD ABYSS</strong> is a relaxing and atmospheric exploration game set on the bottom of the ocean. Your objective is simple: repair all broken network cables.</p><p class=\"bb_paragraph\" >The Director\u2019s Cut version features new levels, an expanded story, and a completely rebuilt movement system.</p><p class=\"bb_paragraph\" >Whether it\u2019s peace you\u2019re looking for, or something else-</p><p class=\"bb_paragraph\" >The dark depths of the ocean are the perfect place to unwind after a long day.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\u00a0<span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3260040/extras/41a543993243a6b8c6f9a334068d0e5f.poster.avif?t=1754449216\" width=622 height=200 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3260040/extras/41a543993243a6b8c6f9a334068d0e5f.webm?t=1754449216\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3260040/extras/41a543993243a6b8c6f9a334068d0e5f.mp4?t=1754449216\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" >Features:</p><p class=\"bb_paragraph\" ></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >Take a dive to the ocean floor, a place where you can truly be alone.</p></li><li><p class=\"bb_paragraph\" >An expanded version of the original <strong>COLD ABYSS</strong>, featuring new levels and story segments.</p></li><li><p class=\"bb_paragraph\" >Improved visuals and gameplay.</p></li><li><p class=\"bb_paragraph\" >Gather artifacts that flesh out the game's setting.</p></li></ul><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3260040/extras/06b0e41dd2b2876d393e74038e5d0fb3.poster.avif?t=1754449216\" width=622 height=288 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3260040/extras/06b0e41dd2b2876d393e74038e5d0fb3.webm?t=1754449216\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3260040/extras/06b0e41dd2b2876d393e74038e5d0fb3.mp4?t=1754449216\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p>",
    "about_the_game": "<p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3260040/extras/edcdf4cb9dc69a5f9670edb453e7bf9e.poster.avif?t=1754449216\" width=622 height=100 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3260040/extras/edcdf4cb9dc69a5f9670edb453e7bf9e.webm?t=1754449216\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3260040/extras/edcdf4cb9dc69a5f9670edb453e7bf9e.mp4?t=1754449216\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" >How deep will you go?\u00a0</p><p class=\"bb_paragraph\" ><strong>COLD ABYSS</strong> is a relaxing and atmospheric exploration game set on the bottom of the ocean. Your objective is simple: repair all broken network cables.</p><p class=\"bb_paragraph\" >The Director\u2019s Cut version features new levels, an expanded story, and a completely rebuilt movement system.</p><p class=\"bb_paragraph\" >Whether it\u2019s peace you\u2019re looking for, or something else-</p><p class=\"bb_paragraph\" >The dark depths of the ocean are the perfect place to unwind after a long day.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\u00a0<span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3260040/extras/41a543993243a6b8c6f9a334068d0e5f.poster.avif?t=1754449216\" width=622 height=200 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3260040/extras/41a543993243a6b8c6f9a334068d0e5f.webm?t=1754449216\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3260040/extras/41a543993243a6b8c6f9a334068d0e5f.mp4?t=1754449216\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" >Features:</p><p class=\"bb_paragraph\" ></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >Take a dive to the ocean floor, a place where you can truly be alone.</p></li><li><p class=\"bb_paragraph\" >An expanded version of the original <strong>COLD ABYSS</strong>, featuring new levels and story segments.</p></li><li><p class=\"bb_paragraph\" >Improved visuals and gameplay.</p></li><li><p class=\"bb_paragraph\" >Gather artifacts that flesh out the game's setting.</p></li></ul><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3260040/extras/06b0e41dd2b2876d393e74038e5d0fb3.poster.avif?t=1754449216\" width=622 height=288 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3260040/extras/06b0e41dd2b2876d393e74038e5d0fb3.webm?t=1754449216\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3260040/extras/06b0e41dd2b2876d393e74038e5d0fb3.mp4?t=1754449216\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p>",
