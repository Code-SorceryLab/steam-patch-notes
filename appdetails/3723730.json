{
    "type": "game",
    "name": "\u5ba1\u5224\u8005",
    "steam_appid": 3723730,
    "required_age": 0,
    "is_free": false,
    "detailed_description": "<p class=\"bb_paragraph\" ><strong><u>\u5267\u60c5\u7b80\u4ecb</u></strong></p><p class=\"bb_paragraph\" ><strong>\u300e\u00a0\u4e00\u573a\u201c\u4e0d\u53ef\u80fd\u72af\u7f6a\u201d\u62c9\u5f00\u8840\u8272\u5e37\u5e55\u00a0\u300f </strong><br>\u5929\u624d\u5211\u8b66\u90a2\u5cf0\uff08\u9ec4\u4fca\u9e4f \u9970\uff09\u8c03\u67e5\u79bb\u5947\u73bb\u7483\u7bb1\u6eba\u4ea1\u6848\uff0c\u73b0\u573a\u65e0\u704c\u6c34\u8bbe\u5907\uff0c\u51f6\u624b\u4eff\u4f5b\u51ed\u7a7a\u9020\u6d6a\u3002\u5f53\u4ed6\u7834\u89e3\u7cbe\u5bc6\u673a\u5173\uff0c\u5acc\u7591\u4eba\u5374\u6b7b\u4e8e\u53e6\u4e00\u573a\u8fde\u9501\u8c0b\u6740\u3002\u591a\u7c73\u8bfa\u9aa8\u724c\u5f0f\u7684\u6b7b\u4ea1\u63a5\u8e35\u800c\u81f3\uff0c\u53d7\u5bb3\u8005\u8eab\u4efd\u6beb\u65e0\u5173\u8054\uff0c\u52a8\u673a\u6210\u8c1c\u3002 <br>\u4e34\u9000\u8001\u5211\u8b66\u96f7\u5b87\u9e23\uff08\u5f20\u5fd7\u575a \u9970\uff09\u88ab\u8feb\u5165\u5c40\uff0c\u4e00\u8001\u4e00\u5c11\u5f62\u6210\u201c\u51b0\u4e0e\u706b\u201d\u642d\u6863\uff1a\u90a2\u5cf0\u75f4\u8ff7\u8be1\u8ba1\u62c6\u89e3\uff0c\u96f7\u5b87\u9e23\u6df1\u6316\u4eba\u6027\u6697\u7f51\u3002\u4e24\u4eba\u9010\u6e10\u53d1\u73b0\uff0c\u51f6\u624b\u7adf\u4ee5\u201c\u5ba1\u5224\u8005\u201d\u81ea\u5c45\uff0c\u4e13\u730e\u7f51\u7edc\u66b4\u529b\u5236\u9020\u8005\u3002\u5f53\u8206\u8bba\u5316\u4f5c\u51f6\u5668\uff0c\u771f\u76f8\u4e0e\u9053\u5fb7\u6fc0\u70c8\u78b0\u649e\u2014\u2014<strong> </strong><br><strong>\u5f53\u7f6a\u6076\u7a7f\u4e0a\u6b63\u4e49\u7684\u5916\u8863\uff0c\u4f60\u662f\u5426\u6709\u52c7\u6c14\u6263\u4e0b\u5ba1\u5224\u7684\u6273\u673a\uff1f</strong></p><p class=\"bb_paragraph\" ><strong>\u662f\u4f38\u5f20\u6b63\u4e49\uff0c\u8fd8\u662f\u6ca6\u4e3a\u5171\u72af\uff1f</strong></p><p class=\"bb_paragraph\" >\u00a0</p><p class=\"bb_paragraph\" ><strong><u>\u4e3b\u521b\u9635\u5bb9</u></strong></p><p class=\"bb_paragraph\" ><strong>\u9ec4\u4fca\u9e4f \u9970 \u90a2\u5cf0</strong> <br>\u300a\u4eba\u6c11\u7684\u540d\u4e49\u300b\u201c\u53cd\u8d2a\u5c40\u957f\u9648\u6d77\u201d\u89c9\u9192\u5f52\u6765\uff01\u9ad8\u667a\u5546\u3001\u4f4e\u60c5\u5546\u7684\u5929\u624d\u5211\u8b66\uff0c\u79d1\u6280\u5211\u4fa6\u4e0e\u72af\u7f6a\u5fc3\u7406\u4e13\u5bb6\uff0c\u751f\u6d3b\u4e2d\u5b64\u50fb\u5be1\u8a00\uff0c\u552f\u72ec\u5bf9\u91d1\u9c7c\u503e\u8bc9\u79d8\u5bc6\u3002\u4ee3\u8868\u4f5c\uff1a\u300a\u4eba\u6c11\u7684\u540d\u4e49\u300b\u300a\u89c9\u9192\u5e74\u4ee3\u300b\u300a\u4eba\u4e16\u95f4\u300b\u300a\u96ea\u8c79\u300b\u300a\u7406\u60f3\u7167\u8000\u4e2d\u56fd\u300b\u300a\u540e\u6d6a\u300b\u300a\u5618\uff0c\u56fd\u738b\u5728\u51ac\u7720\u300b\u3002</p><p class=\"bb_paragraph\" ><strong>\u5f20\u5fd7\u575a \u9970 \u96f7\u5b87\u9e23</strong> <br>\u300a\u4eba\u6c11\u7684\u540d\u4e49\u300b\u201c\u9ad8\u80b2\u826f\u201d\u53d8\u8eab\u94c1\u9762\u8001\u8b66\uff01\u7ecf\u9a8c\u8001\u8fa3\u3001\u6d1e\u5bdf\u4eba\u6027\uff0c\u64c5\u4ece\u52a8\u673a\u6495\u5f00\u7f6a\u6848\u7f3a\u53e3\u3002\u4e34\u8fd1\u9000\u4f11\u5374\u5377\u5165\u8fde\u73af\u6740\u5c40\uff0c\u4e0e\u90a2\u5cf0\u4e0a\u6f14\u4ea6\u5e08\u4ea6\u654c\u7684\u81f4\u547d\u535a\u5f08\u3002\u4ee3\u8868\u4f5c\uff1a\u300a\u4eba\u6c11\u7684\u540d\u4e49\u300b\u300a\u4eba\u95f4\u6b63\u9053\u662f\u6ca7\u6851\u300b\u300a\u5927\u660e\u738b\u671d1566\u300b\u300a\u98ce\u58f0\u300b\u300a\u72c2\u98d9\u300b\u300a\u4e5d\u5dde\u7f25\u7f08\u5f55\u300b\u300a\u730e\u72d0\u884c\u52a8\u300b\u3002</p><p class=\"bb_paragraph\" ><strong>\u7f16\u5267\uff1a\u51b7\u5c0f\u5f20</strong> <br>\u56fd\u5185\u7a00\u7f3a\u7684\u672c\u683c\u63a8\u7406\u65d7\u624b\uff0c\u51fa\u7248\u300a\u6211\u4e4b\u654c\u300b\u300a\u4e5d\u5bab\u730e\u5c40\u300b\u7b49\u786c\u6838\u5c0f\u8bf4\uff0c\u7f16\u5267\u4f5c\u54c1\u300a\u706d\u7f6a\u5e08\u300b\u5960\u5b9a\u60ac\u7591\u53e3\u7891\u3002\u9996\u5ea6\u72ec\u7acb\u64cd\u5200\u5f71\u89c6IP\uff0c\u6253\u9020\u201c\u4e2d\u5f0f\u793e\u4f1a\u6d3e\u63a8\u7406\u201d\u65b0\u8303\u5f0f\u3002</p><p class=\"bb_paragraph\" >\u00a0</p><p class=\"bb_paragraph\" ><strong><u>\u6838\u5fc3\u4eae\u70b9</u></strong></p><p class=\"bb_paragraph\" ><strong>\u300e\u00a0\u6c89\u6d78\u5f0f\u89e3\u8c1c\u00a0\u300f</strong> <br>\u52d8\u67e5\u73b0\u573a\u3001\u5ba1\u8baf\u5acc\u7591\u4eba\u3001\u63a8\u6f14\u72af\u7f6a\u903b\u8f91\u2014\u2014\u6307\u7eb9\u3001\u8840\u8ff9\u3001\u76d1\u63a7\u788e\u7247\u7686\u53ef\u4ea4\u4e92\uff0c\u4eb2\u624b\u62c6\u7a7f\u201c\u4e0d\u53ef\u80fd\u72af\u7f6a\u201d\u673a\u5173\uff01</p><p class=\"bb_paragraph\" ><strong>\u300e\u00a0\u591a\u7c73\u8bfa\u5f0f\u591a\u7ebf\u5267\u60c5\u00a0\u300f</strong> <br>\u6bcf\u4e2a\u9009\u62e9\u89e6\u53d1\u8fde\u9501\u53cd\u5e94\uff1a\u6551\u8d4e\u6216\u80cc\u53db\u3001\u63ed\u9732\u6216\u9690\u7792\uff0c\u5bfc\u5411\u622a\u7136\u4e0d\u540c\u7684\u7ed3\u5c40\u3002</p><p class=\"bb_paragraph\" ><strong>\u300e\u00a0\u5f71\u89c6\u7ea7\u6c89\u6d78\u4f53\u9a8c\u00a0\u300f</strong> <br>\u7535\u5f71\u8d28\u611f\u7684\u955c\u5934\u8bed\u8a00 \uff0c\u300a\u4eba\u6c11\u7684\u540d\u4e49\u300b\u539f\u73ed\u8001\u620f\u9aa8\u72c2\u98d9\u6f14\u6280\uff0c\u76f4\u9762\u8206\u8bba\u5ba1\u5224\u4e0e\u4eba\u6027\u8d28\u95ee\u3002</p><p class=\"bb_paragraph\" ><strong>\u300e\u00a0\u793e\u4f1a\u6d3e\u7f6a\u6848\u77e9\u9635\u00a0\u300f</strong> <br>\u7f51\u7edc\u66b4\u529b\u3001\u8206\u8bba\u64cd\u63a7\u3001\u9053\u5fb7\u56f0\u5c40\u2026\u2026\u6848\u4ef6\u76f4\u51fb\u73b0\u5b9e\u75db\u70b9\uff0c\u89e3\u5256\u7834\u89e3\u4eba\u6027\u8be1\u8ba1\u3002</p><p class=\"bb_paragraph\" ><strong>\u00a0</strong></p><p class=\"bb_paragraph\" ><strong><u>\u5f00\u53d1\u8005\u7684\u8bdd</u></strong></p><p class=\"bb_paragraph\" ><strong>\u51b7\u5c0f\u5f20\uff1a\u201c\u300a\u5ba1\u5224\u8005\u300b\u662f\u5199\u7ed9\u63a8\u7406\u8ff7\u7684\u60c5\u4e66\uff0c\u6bcf\u4e00\u6869\u7f6a\u6848\u90fd\u662f\u793e\u4f1a\u75c5\u7076\u7684\u663e\u5fae\u955c\u3002\u201d</strong></p><p class=\"bb_paragraph\" >\u4eb2\u7231\u7684\u73a9\u5bb6\uff1a <br>\u4f60\u597d\uff0c\u6211\u4eec\u662f\u300a\u5ba1\u5224\u8005\u300b\u5f00\u53d1\u7ec4\u3002</p><p class=\"bb_paragraph\" >\u8fd9\u4e0d\u662f\u4e00\u6b3e\u201c\u770b\u6545\u4e8b\u201d\u7684\u6e38\u620f\uff0c\u800c\u662f\u4e00\u573a\u201c\u6210\u4e3a\u6545\u4e8b\u201d\u7684\u5192\u9669\u3002 <br>\u4ece\u6784\u601d\u4e4b\u521d\uff0c\u6211\u4eec\u5c31\u60f3\u6253\u7834\u5c4f\u5e55\u7684\u754c\u9650\u2014\u2014\u5f53\u4f60\u5728\u7f6a\u6848\u73b0\u573a\u62fe\u8d77\u4e00\u679a\u6307\u7eb9\u3001\u5728\u5ba1\u8baf\u4e2d\u903c\u95ee\u4e00\u53e5\u8c0e\u8a00\u3001\u5728\u751f\u6b7b\u5173\u5934\u6309\u4e0b\u6289\u62e9\u952e\u65f6\uff0c\u4f60\u4e0d\u518d\u662f\u65c1\u89c2\u8005\uff0c\u800c\u662f\u90a2\u5cf0\u4e0e\u96f7\u5b87\u9e23\u7684\u201c\u7b2c\u4e09\u4f4d\u642d\u6863\u201d\u3002\u90a3\u4e9b\u88ab\u523b\u610f\u6a21\u7cca\u7684\u9053\u5fb7\u8fb9\u754c\u3001\u90a3\u4e9b\u85cf\u5728\u5bf9\u8bdd\u6846\u5939\u7f1d\u4e2d\u7684\u4eba\u6027\u79c1\u8d27\uff0c\u90fd\u5728\u7b49\u4f60\u4eb2\u624b\u63ed\u5f00\u3002</p><p class=\"bb_paragraph\" >\u6211\u4eec\u4e3a\u786c\u6838\u89e3\u8c1c\u63a8\u7406\u8ff7\u57cb\u4e86\u5f88\u591a\u8c1c\u9898\uff0c\u6211\u4eec\u4e5f\u4e3a\u201c\u975e\u914b\u201d\u73a9\u5bb6\u5f00\u4e86\u6247\u7a97\uff1a\u82e5\u5361\u8c1c\u9898\u4e86\u4f1a\u6709\u4e09\u6b21\u63d0\u793a\u673a\u4f1a\uff0c\u76f4\u5230\u4f60\u89e3\u5f00\u8c1c\u9898\uff08\u5618\uff0c\u522b\u8bf4\u51fa\u53bb\uff09\u3002</p><p class=\"bb_paragraph\" >\u6700\u8ba9\u6211\u4eec\u5931\u7720\u7684\uff0c\u662f\u201c\u9009\u62e9\u7684\u5206\u91cf\u201d\u3002\u8fd9\u4e9b\u9009\u62e9\u6ca1\u6709\u6807\u51c6\u7b54\u6848\uff0c\u53ea\u6709\u4eba\u6027\u7684\u9707\u986b\u3002\u4f46\u8bf7\u76f8\u4fe1\uff0c\u65e0\u8bba\u8d70\u5411\u54ea\u79cd\u7ed3\u5c40\uff0c\u6211\u4eec\u90fd\u4f1a\u4e3a\u4f60\u4fdd\u7559\u6700\u540e\u4e00\u5757\u201c\u540e\u6094\u836f\u201d\uff1a\u968f\u65f6\u91cd\u542f\u65f6\u95f4\u7ebf\uff0c\u53bb\u62ef\u6551\u90a3\u4e2a\u88ab\u4f60\u4eb2\u624b\u846c\u9001\u7684\u89d2\u8272\u3002</p><p class=\"bb_paragraph\" >\u6700\u540e\uff0c\u6b22\u8fce\u52a0\u5165\u201c\u5ba1\u5224\u8005\u201d\u793e\u533a\uff0c\u7528\u9634\u8c0b\u8bba\u8f70\u70b8\u6211\u4eec\u7684\u5b98\u65b9\u8d26\u53f7\uff0c\u6216\u8005\u6652\u51fa\u4f60\u53d1\u73b0\u7684BUG\u3002</p><p class=\"bb_paragraph\" >\u6211\u4eec\u5ba1\u8baf\u5ba4\u89c1\u3002 <br>\u2014\u2014\u300a\u5ba1\u5224\u8005\u300b\u5f00\u53d1\u7ec4\u5168\u4f53</p><p class=\"bb_paragraph\" >\u00a0</p><p class=\"bb_paragraph\" ><strong><u>\u7279\u522b\u63d0\u793a</u></strong> <br><strong>\u26a0\ufe0f \u5185\u542b\u70e7\u8111\u89e3\u8c1c\uff0c\u5efa\u8bae\u64c5\u957f\u89e3\u8c1c\u63a8\u7406\u7684\u73a9\u5bb6\u6311\u6218\u3002</strong></p><p class=\"bb_paragraph\" >\u00a0</p><p class=\"bb_paragraph\" ><strong><u>\u51fa\u54c1\u4e0e\u5f00\u53d1\u8005</u></strong> <br>\u4e2d\u8054\u65b0\u5f71\uff08\u5317\u4eac\uff09\u6587\u5316\u4f20\u5a92\u80a1\u4efd\u6709\u9650\u516c\u53f8 <br>\u5317\u4eac\u6c34\u601d\u7ef4\u79d1\u6280\u53d1\u5c55\u6709\u9650\u516c\u53f8</p><p class=\"bb_paragraph\" >\u00a0</p><p class=\"bb_paragraph\" ><strong><u>\u8054\u7cfb\u65b9\u5f0f</u></strong> <br>\u516c\u4f17\u53f7\uff1a</p><p class=\"bb_paragraph\" >B\u7ad9\uff1a  <br>\u5fae\u535a\uff1a  <br>\u5b98\u65b9QQ\u2460\u7fa4\uff1a  <br>\u5b98\u65b9QQ\u2461\u7fa4\uff1a  </p>",
    "about_the_game": "<p class=\"bb_paragraph\" ><strong><u>\u5267\u60c5\u7b80\u4ecb</u></strong></p><p class=\"bb_paragraph\" ><strong>\u300e\u00a0\u4e00\u573a\u201c\u4e0d\u53ef\u80fd\u72af\u7f6a\u201d\u62c9\u5f00\u8840\u8272\u5e37\u5e55\u00a0\u300f </strong><br>\u5929\u624d\u5211\u8b66\u90a2\u5cf0\uff08\u9ec4\u4fca\u9e4f \u9970\uff09\u8c03\u67e5\u79bb\u5947\u73bb\u7483\u7bb1\u6eba\u4ea1\u6848\uff0c\u73b0\u573a\u65e0\u704c\u6c34\u8bbe\u5907\uff0c\u51f6\u624b\u4eff\u4f5b\u51ed\u7a7a\u9020\u6d6a\u3002\u5f53\u4ed6\u7834\u89e3\u7cbe\u5bc6\u673a\u5173\uff0c\u5acc\u7591\u4eba\u5374\u6b7b\u4e8e\u53e6\u4e00\u573a\u8fde\u9501\u8c0b\u6740\u3002\u591a\u7c73\u8bfa\u9aa8\u724c\u5f0f\u7684\u6b7b\u4ea1\u63a5\u8e35\u800c\u81f3\uff0c\u53d7\u5bb3\u8005\u8eab\u4efd\u6beb\u65e0\u5173\u8054\uff0c\u52a8\u673a\u6210\u8c1c\u3002 <br>\u4e34\u9000\u8001\u5211\u8b66\u96f7\u5b87\u9e23\uff08\u5f20\u5fd7\u575a \u9970\uff09\u88ab\u8feb\u5165\u5c40\uff0c\u4e00\u8001\u4e00\u5c11\u5f62\u6210\u201c\u51b0\u4e0e\u706b\u201d\u642d\u6863\uff1a\u90a2\u5cf0\u75f4\u8ff7\u8be1\u8ba1\u62c6\u89e3\uff0c\u96f7\u5b87\u9e23\u6df1\u6316\u4eba\u6027\u6697\u7f51\u3002\u4e24\u4eba\u9010\u6e10\u53d1\u73b0\uff0c\u51f6\u624b\u7adf\u4ee5\u201c\u5ba1\u5224\u8005\u201d\u81ea\u5c45\uff0c\u4e13\u730e\u7f51\u7edc\u66b4\u529b\u5236\u9020\u8005\u3002\u5f53\u8206\u8bba\u5316\u4f5c\u51f6\u5668\uff0c\u771f\u76f8\u4e0e\u9053\u5fb7\u6fc0\u70c8\u78b0\u649e\u2014\u2014<strong> </strong><br><strong>\u5f53\u7f6a\u6076\u7a7f\u4e0a\u6b63\u4e49\u7684\u5916\u8863\uff0c\u4f60\u662f\u5426\u6709\u52c7\u6c14\u6263\u4e0b\u5ba1\u5224\u7684\u6273\u673a\uff1f</strong></p><p class=\"bb_paragraph\" ><strong>\u662f\u4f38\u5f20\u6b63\u4e49\uff0c\u8fd8\u662f\u6ca6\u4e3a\u5171\u72af\uff1f</strong></p><p class=\"bb_paragraph\" >\u00a0</p><p class=\"bb_paragraph\" ><strong><u>\u4e3b\u521b\u9635\u5bb9</u></strong></p><p class=\"bb_paragraph\" ><strong>\u9ec4\u4fca\u9e4f \u9970 \u90a2\u5cf0</strong> <br>\u300a\u4eba\u6c11\u7684\u540d\u4e49\u300b\u201c\u53cd\u8d2a\u5c40\u957f\u9648\u6d77\u201d\u89c9\u9192\u5f52\u6765\uff01\u9ad8\u667a\u5546\u3001\u4f4e\u60c5\u5546\u7684\u5929\u624d\u5211\u8b66\uff0c\u79d1\u6280\u5211\u4fa6\u4e0e\u72af\u7f6a\u5fc3\u7406\u4e13\u5bb6\uff0c\u751f\u6d3b\u4e2d\u5b64\u50fb\u5be1\u8a00\uff0c\u552f\u72ec\u5bf9\u91d1\u9c7c\u503e\u8bc9\u79d8\u5bc6\u3002\u4ee3\u8868\u4f5c\uff1a\u300a\u4eba\u6c11\u7684\u540d\u4e49\u300b\u300a\u89c9\u9192\u5e74\u4ee3\u300b\u300a\u4eba\u4e16\u95f4\u300b\u300a\u96ea\u8c79\u300b\u300a\u7406\u60f3\u7167\u8000\u4e2d\u56fd\u300b\u300a\u540e\u6d6a\u300b\u300a\u5618\uff0c\u56fd\u738b\u5728\u51ac\u7720\u300b\u3002</p><p class=\"bb_paragraph\" ><strong>\u5f20\u5fd7\u575a \u9970 \u96f7\u5b87\u9e23</strong> <br>\u300a\u4eba\u6c11\u7684\u540d\u4e49\u300b\u201c\u9ad8\u80b2\u826f\u201d\u53d8\u8eab\u94c1\u9762\u8001\u8b66\uff01\u7ecf\u9a8c\u8001\u8fa3\u3001\u6d1e\u5bdf\u4eba\u6027\uff0c\u64c5\u4ece\u52a8\u673a\u6495\u5f00\u7f6a\u6848\u7f3a\u53e3\u3002\u4e34\u8fd1\u9000\u4f11\u5374\u5377\u5165\u8fde\u73af\u6740\u5c40\uff0c\u4e0e\u90a2\u5cf0\u4e0a\u6f14\u4ea6\u5e08\u4ea6\u654c\u7684\u81f4\u547d\u535a\u5f08\u3002\u4ee3\u8868\u4f5c\uff1a\u300a\u4eba\u6c11\u7684\u540d\u4e49\u300b\u300a\u4eba\u95f4\u6b63\u9053\u662f\u6ca7\u6851\u300b\u300a\u5927\u660e\u738b\u671d1566\u300b\u300a\u98ce\u58f0\u300b\u300a\u72c2\u98d9\u300b\u300a\u4e5d\u5dde\u7f25\u7f08\u5f55\u300b\u300a\u730e\u72d0\u884c\u52a8\u300b\u3002</p><p class=\"bb_paragraph\" ><strong>\u7f16\u5267\uff1a\u51b7\u5c0f\u5f20</strong> <br>\u56fd\u5185\u7a00\u7f3a\u7684\u672c\u683c\u63a8\u7406\u65d7\u624b\uff0c\u51fa\u7248\u300a\u6211\u4e4b\u654c\u300b\u300a\u4e5d\u5bab\u730e\u5c40\u300b\u7b49\u786c\u6838\u5c0f\u8bf4\uff0c\u7f16\u5267\u4f5c\u54c1\u300a\u706d\u7f6a\u5e08\u300b\u5960\u5b9a\u60ac\u7591\u53e3\u7891\u3002\u9996\u5ea6\u72ec\u7acb\u64cd\u5200\u5f71\u89c6IP\uff0c\u6253\u9020\u201c\u4e2d\u5f0f\u793e\u4f1a\u6d3e\u63a8\u7406\u201d\u65b0\u8303\u5f0f\u3002</p><p class=\"bb_paragraph\" >\u00a0</p><p class=\"bb_paragraph\" ><strong><u>\u6838\u5fc3\u4eae\u70b9</u></strong></p><p class=\"bb_paragraph\" ><strong>\u300e\u00a0\u6c89\u6d78\u5f0f\u89e3\u8c1c\u00a0\u300f</strong> <br>\u52d8\u67e5\u73b0\u573a\u3001\u5ba1\u8baf\u5acc\u7591\u4eba\u3001\u63a8\u6f14\u72af\u7f6a\u903b\u8f91\u2014\u2014\u6307\u7eb9\u3001\u8840\u8ff9\u3001\u76d1\u63a7\u788e\u7247\u7686\u53ef\u4ea4\u4e92\uff0c\u4eb2\u624b\u62c6\u7a7f\u201c\u4e0d\u53ef\u80fd\u72af\u7f6a\u201d\u673a\u5173\uff01</p><p class=\"bb_paragraph\" ><strong>\u300e\u00a0\u591a\u7c73\u8bfa\u5f0f\u591a\u7ebf\u5267\u60c5\u00a0\u300f</strong> <br>\u6bcf\u4e2a\u9009\u62e9\u89e6\u53d1\u8fde\u9501\u53cd\u5e94\uff1a\u6551\u8d4e\u6216\u80cc\u53db\u3001\u63ed\u9732\u6216\u9690\u7792\uff0c\u5bfc\u5411\u622a\u7136\u4e0d\u540c\u7684\u7ed3\u5c40\u3002</p><p class=\"bb_paragraph\" ><strong>\u300e\u00a0\u5f71\u89c6\u7ea7\u6c89\u6d78\u4f53\u9a8c\u00a0\u300f</strong> <br>\u7535\u5f71\u8d28\u611f\u7684\u955c\u5934\u8bed\u8a00 \uff0c\u300a\u4eba\u6c11\u7684\u540d\u4e49\u300b\u539f\u73ed\u8001\u620f\u9aa8\u72c2\u98d9\u6f14\u6280\uff0c\u76f4\u9762\u8206\u8bba\u5ba1\u5224\u4e0e\u4eba\u6027\u8d28\u95ee\u3002</p><p class=\"bb_paragraph\" ><strong>\u300e\u00a0\u793e\u4f1a\u6d3e\u7f6a\u6848\u77e9\u9635\u00a0\u300f</strong> <br>\u7f51\u7edc\u66b4\u529b\u3001\u8206\u8bba\u64cd\u63a7\u3001\u9053\u5fb7\u56f0\u5c40\u2026\u2026\u6848\u4ef6\u76f4\u51fb\u73b0\u5b9e\u75db\u70b9\uff0c\u89e3\u5256\u7834\u89e3\u4eba\u6027\u8be1\u8ba1\u3002</p><p class=\"bb_paragraph\" ><strong>\u00a0</strong></p><p class=\"bb_paragraph\" ><strong><u>\u5f00\u53d1\u8005\u7684\u8bdd</u></strong></p><p class=\"bb_paragraph\" ><strong>\u51b7\u5c0f\u5f20\uff1a\u201c\u300a\u5ba1\u5224\u8005\u300b\u662f\u5199\u7ed9\u63a8\u7406\u8ff7\u7684\u60c5\u4e66\uff0c\u6bcf\u4e00\u6869\u7f6a\u6848\u90fd\u662f\u793e\u4f1a\u75c5\u7076\u7684\u663e\u5fae\u955c\u3002\u201d</strong></p><p class=\"bb_paragraph\" >\u4eb2\u7231\u7684\u73a9\u5bb6\uff1a <br>\u4f60\u597d\uff0c\u6211\u4eec\u662f\u300a\u5ba1\u5224\u8005\u300b\u5f00\u53d1\u7ec4\u3002</p><p class=\"bb_paragraph\" >\u8fd9\u4e0d\u662f\u4e00\u6b3e\u201c\u770b\u6545\u4e8b\u201d\u7684\u6e38\u620f\uff0c\u800c\u662f\u4e00\u573a\u201c\u6210\u4e3a\u6545\u4e8b\u201d\u7684\u5192\u9669\u3002 <br>\u4ece\u6784\u601d\u4e4b\u521d\uff0c\u6211\u4eec\u5c31\u60f3\u6253\u7834\u5c4f\u5e55\u7684\u754c\u9650\u2014\u2014\u5f53\u4f60\u5728\u7f6a\u6848\u73b0\u573a\u62fe\u8d77\u4e00\u679a\u6307\u7eb9\u3001\u5728\u5ba1\u8baf\u4e2d\u903c\u95ee\u4e00\u53e5\u8c0e\u8a00\u3001\u5728\u751f\u6b7b\u5173\u5934\u6309\u4e0b\u6289\u62e9\u952e\u65f6\uff0c\u4f60\u4e0d\u518d\u662f\u65c1\u89c2\u8005\uff0c\u800c\u662f\u90a2\u5cf0\u4e0e\u96f7\u5b87\u9e23\u7684\u201c\u7b2c\u4e09\u4f4d\u642d\u6863\u201d\u3002\u90a3\u4e9b\u88ab\u523b\u610f\u6a21\u7cca\u7684\u9053\u5fb7\u8fb9\u754c\u3001\u90a3\u4e9b\u85cf\u5728\u5bf9\u8bdd\u6846\u5939\u7f1d\u4e2d\u7684\u4eba\u6027\u79c1\u8d27\uff0c\u90fd\u5728\u7b49\u4f60\u4eb2\u624b\u63ed\u5f00\u3002</p><p class=\"bb_paragraph\" >\u6211\u4eec\u4e3a\u786c\u6838\u89e3\u8c1c\u63a8\u7406\u8ff7\u57cb\u4e86\u5f88\u591a\u8c1c\u9898\uff0c\u6211\u4eec\u4e5f\u4e3a\u201c\u975e\u914b\u201d\u73a9\u5bb6\u5f00\u4e86\u6247\u7a97\uff1a\u82e5\u5361\u8c1c\u9898\u4e86\u4f1a\u6709\u4e09\u6b21\u63d0\u793a\u673a\u4f1a\uff0c\u76f4\u5230\u4f60\u89e3\u5f00\u8c1c\u9898\uff08\u5618\uff0c\u522b\u8bf4\u51fa\u53bb\uff09\u3002</p><p class=\"bb_paragraph\" >\u6700\u8ba9\u6211\u4eec\u5931\u7720\u7684\uff0c\u662f\u201c\u9009\u62e9\u7684\u5206\u91cf\u201d\u3002\u8fd9\u4e9b\u9009\u62e9\u6ca1\u6709\u6807\u51c6\u7b54\u6848\uff0c\u53ea\u6709\u4eba\u6027\u7684\u9707\u986b\u3002\u4f46\u8bf7\u76f8\u4fe1\uff0c\u65e0\u8bba\u8d70\u5411\u54ea\u79cd\u7ed3\u5c40\uff0c\u6211\u4eec\u90fd\u4f1a\u4e3a\u4f60\u4fdd\u7559\u6700\u540e\u4e00\u5757\u201c\u540e\u6094\u836f\u201d\uff1a\u968f\u65f6\u91cd\u542f\u65f6\u95f4\u7ebf\uff0c\u53bb\u62ef\u6551\u90a3\u4e2a\u88ab\u4f60\u4eb2\u624b\u846c\u9001\u7684\u89d2\u8272\u3002</p><p class=\"bb_paragraph\" >\u6700\u540e\uff0c\u6b22\u8fce\u52a0\u5165\u201c\u5ba1\u5224\u8005\u201d\u793e\u533a\uff0c\u7528\u9634\u8c0b\u8bba\u8f70\u70b8\u6211\u4eec\u7684\u5b98\u65b9\u8d26\u53f7\uff0c\u6216\u8005\u6652\u51fa\u4f60\u53d1\u73b0\u7684BUG\u3002</p><p class=\"bb_paragraph\" >\u6211\u4eec\u5ba1\u8baf\u5ba4\u89c1\u3002 <br>\u2014\u2014\u300a\u5ba1\u5224\u8005\u300b\u5f00\u53d1\u7ec4\u5168\u4f53</p><p class=\"bb_paragraph\" >\u00a0</p><p class=\"bb_paragraph\" ><strong><u>\u7279\u522b\u63d0\u793a</u></strong> <br><strong>\u26a0\ufe0f \u5185\u542b\u70e7\u8111\u89e3\u8c1c\uff0c\u5efa\u8bae\u64c5\u957f\u89e3\u8c1c\u63a8\u7406\u7684\u73a9\u5bb6\u6311\u6218\u3002</strong></p><p class=\"bb_paragraph\" >\u00a0</p><p class=\"bb_paragraph\" ><strong><u>\u51fa\u54c1\u4e0e\u5f00\u53d1\u8005</u></strong> <br>\u4e2d\u8054\u65b0\u5f71\uff08\u5317\u4eac\uff09\u6587\u5316\u4f20\u5a92\u80a1\u4efd\u6709\u9650\u516c\u53f8 <br>\u5317\u4eac\u6c34\u601d\u7ef4\u79d1\u6280\u53d1\u5c55\u6709\u9650\u516c\u53f8</p><p class=\"bb_paragraph\" >\u00a0</p><p class=\"bb_paragraph\" ><strong><u>\u8054\u7cfb\u65b9\u5f0f</u></strong> <br>\u516c\u4f17\u53f7\uff1a</p><p class=\"bb_paragraph\" >B\u7ad9\uff1a  <br>\u5fae\u535a\uff1a  <br>\u5b98\u65b9QQ\u2460\u7fa4\uff1a  <br>\u5b98\u65b9QQ\u2461\u7fa4\uff1a  </p>",
    "short_description": "\u300a\u5ba1\u5224\u8005\u300b\u662f\u4e00\u6b3e\u7531\u91d1\u724c\u7f16\u5267\u51b7\u5c0f\u5f20\u6253\u9020\u7684\u4ea4\u4e92\u5f0f\u89e3\u8c1c\u63a8\u7406\u5f71\u6e38\u3002\u300a\u4eba\u6c11\u7684\u540d\u4e49\u300b\u6f14\u5458\u9ec4\u4fca\u9e4f\u00d7\u5f20\u5fd7\u575a\u5316\u8eab\u5211\u8b66\u53cc\u96c4\uff0c\u643a\u624b\u7834\u89e3\u201c\u4e0d\u53ef\u80fd\u72af\u7f6a\u201d\u8c1c\u5c40\uff0c\u591a\u7c73\u8bfa\u9aa8\u724c\u6548\u5e94\u5f15\u53d1\u540e\u7eed\u6848\u4ef6\u73af\u73af\u76f8\u6263\u3002\u5bc6\u5ba4\u63a8\u6f14\u3001\u7591\u72af\u5ba1\u8baf\u3001\u8206\u8bba\u5ba1\u5224\u3001\u591a\u7ebf\u7ed3\u5c40\uff0c\u5f71\u89c6\u7ea7\u6c89\u6d78\uff0c\u89e3\u6784\u4eba\u6027\u56f0\u5c40\u3002\u559c\u6b22\u672c\u683c\u53ca\u793e\u4f1a\u6d3e\u63a8\u7406\u7684\u73a9\u5bb6\u4e0d\u53ef\u9519\u8fc7\u7684\u60ac\u7591\u63a8\u7406\u7f6a\u6848\u5211\u4fa6\u6e38\u620f\u3002",
    "supported_languages": "Simplified Chinese<strong>*</strong><br><strong>*</strong>languages with full audio support",
