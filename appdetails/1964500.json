a7feae68b51e.poster.avif?t=1722601905\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1964500/extras/ee71042ced8e9218750fa7feae68b51e.webm?t=1722601905\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1964500/extras/ee71042ced8e9218750fa7feae68b51e.mp4?t=1722601905\" type=\"video/mp4\"></video></div><br><br><strong>\u3010Fight with comrades\u3011</strong><br>A total of 4 comrades with different backgrounds can choose to go to the battlefield with you<br>Make good use of the special attributes of comrades-in-arms to effectively fight powerful enemies for players<br><br><div class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1964500/extras/0817bad47fb1a1a65c75b4ca6b429f4b.poster.avif?t=1722601905\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1964500/extras/0817bad47fb1a1a65c75b4ca6b429f4b.webm?t=1722601905\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1964500/extras/0817bad47fb1a1a65c75b4ca6b429f4b.mp4?t=1722601905\" type=\"video/mp4\"></video></div><br><br><strong>[Invasion of Chaos Demon Realm]</strong><br>The breath of death will attract the invasion of the devil world, players must fight against the four legions<br>All kinds of sudden monsters will also become a major crisis for the player's survival<br><br><div class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1964500/extras/987aacfb358481cfc0242163e7bab86b.poster.avif?t=1722601905\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1964500/extras/987aacfb358481cfc0242163e7bab86b.webm?t=1722601905\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1964500/extras/987aacfb358481cfc0242163e7bab86b.mp4?t=1722601905\" type=\"video/mp4\"></video></div>",
