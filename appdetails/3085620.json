atic.com/store_item_assets/steam/apps/3085620/extras/c1f444f1d133976d6154ad3ae3eae299.mp4?t=1731113891\" type=\"video/mp4\"></video></span><h2 class=\"bb_tag\" >New Possibilities with Deck Building</h2><strong>&quot;There is no need for only four of the same tile in the deck.&quot; </strong>Your choices can create hands that are impossible in reality!<br><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3085620/extras/eb8a9b1d1415e4b72b95cfd1179810c7.poster.avif?t=1731113891\" width=600 height=150 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3085620/extras/eb8a9b1d1415e4b72b95cfd1179810c7.webm?t=1731113891\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3085620/extras/eb8a9b1d1415e4b72b95cfd1179810c7.mp4?t=1731113891\" type=\"video/mp4\"></video></span><h2 class=\"bb_tag\" >Boost Status</h2>Manipulate the number of draws and discards, and even control the Dora to create the best environment to strengthen your hands.<br><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3085620/extras/1ed23e16b0f4b2a47ad1c65ea59a93e1.poster.avif?t=1731113891\" width=500 height=260 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3085620/extras/1ed23e16b0f4b2a47ad1c65ea59a93e1.webm?t=1731113891\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3085620/extras/1ed23e16b0f4b2a47ad1c65ea59a93e1.mp4?t=1731113891\" type=\"video/mp4\"></video></span><h2 class=\"bb_tag\" >No-Ceiling Scoring System (Ao-Tenjo)</h2>Score calculation is based on the Ao-Tenjo rule, meaning points are not capped, and all the Fu and Han are reflected in the score. Ao-Tenjo means there is no upper limit to