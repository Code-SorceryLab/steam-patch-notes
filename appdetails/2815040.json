ts/steam/apps/2815040/extras/dadfe329e892d55ef65927bb9bc2a1ca.avif?t=1754307256\" width=200 height=65 /></span><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2815040/extras/3c0a59e163147a41c4d55ab14e254169.avif?t=1754307256\" width=200 height=65 /></span> <span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2815040/extras/a6c89c8ba92eada952dfe3d8fe39aef9.avif?t=1754307256\" width=200 height=65 /></span></p>",
