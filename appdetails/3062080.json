    "pc_requirements": {
        "minimum": "<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10 (64-bit)<br></li><li><strong>Processor:</strong> Intel Core i5-3330 (dual-core, 1.8 GHz or equivalent)<br></li><li><strong>Memory:</strong> 4 GB RAM<br></li><li><strong>Graphics:</strong> Intel HD Graphics 4000 or equivalent<br></li><li><strong>Storage:</strong> 500 MB available space<br></li><li><strong>Sound Card:</strong> DirectX-compatible sound card<br></li><li><strong>VR Support:</strong> No<br></li><li><strong>Additional Notes:</strong> Hypothetically equivalent to 2013 Macbook air. Not 100% accurate.</li></ul>"
    },
    "mac_requirements": {
        "minimum": "<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Mac OSX 10.7 &amp; Above*<br></li><li><strong>Processor:</strong> 1,3 GHz<br></li><li><strong>Memory:</strong> 4 GB RAM<br></li><li><strong>Graphics:</strong> 1 GB Video Memory<br></li><li><strong>Storage:</strong> 500 MB available space<br></li><li><strong>Sound Card:</strong> It needs to make the noises but if it can, it should work.<br></li><li><strong>Additional Notes:</strong> *The photo feature in this game does not seem to work on M1 Mac Computers. I'm working on fixing this</li></ul>"
    },
