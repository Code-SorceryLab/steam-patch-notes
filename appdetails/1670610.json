uted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1670610/extras/de0bc37a6ceeb59b56aa47c0cd6b285a.poster.avif?t=1712479701\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1670610/extras/de0bc37a6ceeb59b56aa47c0cd6b285a.webm?t=1712479701\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1670610/extras/de0bc37a6ceeb59b56aa47c0cd6b285a.mp4?t=1712479701\" type=\"video/mp4\"></video></div>",
