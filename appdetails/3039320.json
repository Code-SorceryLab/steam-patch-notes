shared.akamai.steamstatic.com/store_item_assets/steam/apps/3039320/extras/62741dc866c7cb0de4b34238be381841.avif?t=1752830477\" width=600 height=80 /></span> </p><p class=\"bb_paragraph\" ></p><table><tr><td><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3039320/extras/f603d9bf8d46d9f7276b50dafa092134.poster.avif?t=1752830477\" width=300 height=300 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3039320/extras/f603d9bf8d46d9f7276b50dafa092134.webm?t=1752830477\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3039320/extras/f603d9bf8d46d9f7276b50dafa092134.mp4?t=1752830477\" type=\"video/mp4\"></video></span></p></td><td><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3039320/extras/97abacc37de7881b33c82c44896a4335.poster.avif?t=1752830477\" width=300 height=300 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3039320/extras/97abacc37de7881b33c82c44896a4335.webm?t=1752830477\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3039320/extras/97abacc37de7881b33c82c44896a4335.mp4?t=1752830477\" type=\"video/mp4\"></video></span></p></td></tr></table><p class=\"bb_paragraph\" > </p><p class=\"bb_paragraph\" >This game was made by Castical. Follow the development on YouTube! </p>",
