ine poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2471390/extras/de4e124e4b502cd6c8614dc9e420952c.poster.avif?t=1753024141\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2471390/extras/de4e124e4b502cd6c8614dc9e420952c.webm?t=1753024141\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2471390/extras/de4e124e4b502cd6c8614dc9e420952c.mp4?t=1753024141\" type=\"video/mp4\"></video></span></p></li></ul>",
