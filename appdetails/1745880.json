2440df.poster.avif?t=1716658987\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1745880/extras/a68e99a84a1f79a7733d9acb492440df.webm?t=1716658987\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1745880/extras/a68e99a84a1f79a7733d9acb492440df.mp4?t=1716658987\" type=\"video/mp4\"></video></div><br><br><br><strong><i>- 6 Stages, featuring 60 levels to learn and improve your skills.</i></strong><br><br><br><div class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1745880/extras/421a96a3714b6b99c45c9e3d46731f46.poster.avif?t=1716658987\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1745880/extras/421a96a3714b6b99c45c9e3d46731f46.webm?t=1716658987\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1745880/extras/421a96a3714b6b99c45c9e3d46731f46.mp4?t=1716658987\" type=\"video/mp4\"></video></div>",
