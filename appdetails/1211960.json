ic.com/store_item_assets/steam/apps/1211960/extras/8faf579e25a114e92849752e7711f9bf.mp4?t=1709544719\" type=\"video/mp4\"></video></div><br><div class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1211960/extras/726f94986320e5e590ed7d13da9ac1eb.poster.avif?t=1709544719\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1211960/extras/726f94986320e5e590ed7d13da9ac1eb.webm?t=1709544719\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1211960/extras/726f94986320e5e590ed7d13da9ac1eb.mp4?t=1709544719\" type=\"video/mp4\"></video></div><br><br><strong>Features</strong><br>Voiced by famous Japanese voice actors<br>Bubble tea - Bubbles: Ayaka Nanase<br>Experience the interesting story and interact with Bubbles face to face in VR.<br>Learn how to make handshake drinks and help Bubbles solve her problems.<br>Furthermore, we have survival mode and time mode for a real challenge.",
