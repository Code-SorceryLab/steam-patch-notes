{
    "type": "game",
    "name": "G-MODE\u30a2\u30fc\u30ab\u30a4\u30d6\u30b9+ \u7267\u5834\u7269\u8a9e\u30e2\u30d0\u30a4\u30eb Life&Love",
    "steam_appid": 3090940,
