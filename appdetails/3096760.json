ai.steamstatic.com/store_item_assets/steam/apps/3096760/extras/3d587f9eb1c2a6f976f84266f3a69faa.mp4?t=1723648898\" type=\"video/mp4\"></video></span><br><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3096760/extras/815ff8b7f3fd743dfbd327c39ef08e8a.poster.avif?t=1723648898\" width=426 height=240 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3096760/extras/815ff8b7f3fd743dfbd327c39ef08e8a.webm?t=1723648898\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3096760/extras/815ff8b7f3fd743dfbd327c39ef08e8a.mp4?t=1723648898\" type=\"video/mp4\"></video></span><br><br>What are you waiting for? Grab a block... and lay siege!",
