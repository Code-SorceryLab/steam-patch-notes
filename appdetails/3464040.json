    "detailed_description": "<h2 class=\"bb_tag\" >\u25a0\u300c\u30bd\u30a6\u30eb\u30cf\u30f3\u30bf\u30fc\u30fb\u30ce\u30ce\u300d\u300cFirst Sin\u300d\u306a\u3069\u306e\u30d5\u30ea\u30fc\u30b2\u30fc\u30e0\u3092\u5236\u4f5c\u3057\u305f\u79cb\u539f\u5b5d\u592a(\u30a2\u30ad\u30cf\u30e9)\u306b\u3088\u308b\u65b0\u4f5cRPG\u3001Steam\u306b\u3066\u914d\u4fe1\uff01</h2><p class=\"bb_paragraph\" >\u904e\u53bb\u4f5c\u304b\u3089\u5236\u4f5c\u30c4\u30fc\u30eb\u3092\u5909\u66f4\u3057\u3066\u304a\u5c4a\u3051\u3059\u308b\u9577\u7de8RPG\u7b2c1\u5f3e\u306f\u3001\u81ea\u3089\u306b\u79d8\u3081\u3089\u308c\u305f\u529b\u3092\u5de1\u308b\u9a12\u52d5\u306b\u5dfb\u304d\u8fbc\u307e\u308c\u3064\u3064\u3082\u81ea\u5206\u81ea\u8eab\u306e\u6b63\u4f53\u3092\u77e5\u308b\u305f\u3081\u306b\u5192\u967a\u3059\u308bRPG\u3068\u306a\u3063\u3066\u3044\u307e\u3059\u3002</p><h2 class=\"bb_tag\" >\u25a0\u304a\u306f\u306a\u3057</h2><p class=\"bb_paragraph\" >\u4eba\u9593\u304c\u6587\u660e\u3092\u7bc9\u304d\u4e0a\u3052\u305f\u3042\u308b\u661f\u306b\u3066\u2026\u2026\u3002</p><p class=\"bb_paragraph\" >\u7a81\u5982\u3001\u4e16\u754c\u306e\u4e2d\u5fc3\u306b\u4f4d\u7f6e\u3059\u308b\u5927\u9678\u306b\u5de8\u5927\u306a\u7a74\u304c\u958b\u304d\u307e\u3057\u305f\u3002</p><p class=\"bb_paragraph\" >\u305d\u306e\u7a74\u304b\u3089\u3001\u6570\u3048\u5207\u308c\u306a\u3044\u307b\u3069\u306e\u9b54\u7269\u304c\u6e67\u304d\u51fa\u3057\u3001</p><p class=\"bb_paragraph\" >\u5e73\u548c\u3060\u3063\u305f\u4e16\u754c\u306f\u77ac\u304f\u9593\u306b\u6050\u6016\u306b\u8986\u308f\u308c\u307e\u3057\u305f\u3002</p><p class=\"bb_paragraph\" >\u3057\u304b\u3057\u3001\u4eba\u9593\u305f\u3061\u306f\u305f\u3060\u898b\u3066\u3044\u308b\u3060\u3051\u3067\u306f\u3042\u308a\u307e\u305b\u3093\u3067\u3057\u305f\u3002</p><p class=\"bb_paragraph\" >\u4e16\u754c\u5404\u56fd\u306f\u6025\u304e\u5175\u58eb\u3092\u52df\u96c6\u3057\u3001\u3053\u306e\u672a\u66fe\u6709\u306e\u5371\u6a5f\u306b\u7acb\u3061\u5411\u304b\u3046\u3053\u3068\u3092\u6c7a\u610f\u3057\u307e\u3059\u3002</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\u3053\u306e\u5371\u6a5f\u306e\u4e2d\u3001\u4e3b\u4eba\u516c\uff08\u30b2\u30fc\u30e0\u958b\u59cb\u6642\u306b\u540d\u524d\u3068\u898b\u305f\u76ee\u3092\u8a2d\u5b9a\uff09\u306f\u3042\u308b\u56fd\u306e\u5175\u58eb\u3068\u3057\u3066\u5fd7\u9858\u3057\u3001</p><p class=\"bb_paragraph\" >\u8a66\u9a13\u306b\u5408\u683c\u3057\u3066\u5175\u58eb\u3068\u3057\u3066\u306e\u751f\u6d3b\u3092\u30b9\u30bf\u30fc\u30c8\u3055\u305b\u307e\u3059\u3002</p><p class=\"bb_paragraph\" >\u3042\u308b\u65e5\u3001\u5cf6\u3067\u306e\u30d1\u30c8\u30ed\u30fc\u30eb\u4e2d\u306b\u8b0e\u306e\u7537\u306b\u8972\u6483\u3055\u308c\u307e\u3059\u304c</p><p class=\"bb_paragraph\" >\u5371\u6a5f\u7684\u72b6\u6cc1\u306e\u4e2d\u3001\u4e3b\u4eba\u516c\u306f\u77e5\u3089\u305a\u77e5\u3089\u305a\u306e\u3046\u3061\u306b\u79d8\u3081\u3089\u308c\u305f\u529b\u3092\u767a\u63ee\u3057\u3001\u7aae\u5730\u3092\u8131\u3057\u307e\u3059\u3002</p><p class=\"bb_paragraph\" >\u7a81\u7136\u899a\u9192\u3057\u305f\u529b\u306f\u4f55\u306a\u306e\u304b\u3001\u81ea\u5206\u304c\u672c\u5f53\u306f\u4f55\u8005\u306a\u306e\u304b\u2026\u2026\u3002</p><p class=\"bb_paragraph\" >\u8b0e\u3092\u89e3\u304d\u660e\u304b\u3059\u305f\u3081\u3001\u305d\u3057\u3066\u9b54\u7269\u3092\u5012\u3059\u305f\u3081\u3001</p><p class=\"bb_paragraph\" >\u4e3b\u4eba\u516c\u306f\u4ef2\u9593\u305f\u3061\u3068\u5171\u306b\u4e16\u754c\u3092\u65c5\u3059\u308b\u6c7a\u610f\u3092\u56fa\u3081\u307e\u3059\u3002</p><h2 class=\"bb_tag\" >\u25a0\u30b7\u30b9\u30c6\u30e0</h2><p class=\"bb_paragraph\" ><strong>\u30fb\u300c\u6599\u7406\u300d\u30b7\u30b9\u30c6\u30e0</strong></p><p class=\"bb_paragraph\" >\u5192\u967a\u306e\u9014\u4e2d\u3067\u624b\u306b\u5165\u308b<strong>\u300c\u30ec\u30b7\u30d4\u300d</strong>\u3092\u3082\u3068\u306b</p><p class=\"bb_paragraph\" ><strong>\u300c\u8d64\u300d\u300c\u9ec4\u8272\u300d\u300c\u7dd1\u300d</strong>\u306e\u98df\u6750\u3092\u56de\u5fa9\u30dd\u30a4\u30f3\u30c8\u3067\u4f7f\u3046\u3053\u3068\u3067\u3001</p><p class=\"bb_paragraph\" >\u6599\u7406\u3092\u4f5c\u308a\u4e0a\u3052\u308b\u30b7\u30f3\u30d7\u30eb\u306a\u30b7\u30b9\u30c6\u30e0\u3002</p><p class=\"bb_paragraph\" >\u6599\u7406\u306f\u3001\u6226\u95d8\u4e2d\u306bHP\u3084\u30b9\u30c6\u30fc\u30bf\u30b9\u306a\u3069\u3092\u5411\u4e0a\u3055\u305b\u307e\u3059\u3002</p><p class=\"bb_paragraph\" >\u69d8\u3005\u306a\u6599\u7406\u304c\u767b\u5834\u3057\u3001\u30ec\u30b7\u30d4\u3092\u624b\u306b\u5165\u308c\u3066\u6599\u7406\u3092\u884c\u3046\u3053\u3068\u3067\u5192\u967a\u3092\u3088\u308a\u6709\u5229\u306b\u9032\u3081\u3089\u308c\u308b\u3067\u3057\u3087\u3046\u3002</p><p class=\"bb_paragraph\" ><strong>\u30fb\u300c\u8ee2\u8077\u300d\u30b7\u30b9\u30c6\u30e0</strong></p><p class=\"bb_paragraph\" >\u4e3b\u4eba\u516c\u3068\u4ef2\u95931\u540d\u306f\u3001\u7269\u8a9e\u304c\u9032\u3080\u3068\u8ee2\u8077\u3067\u304d\u307e\u3059\u3002  <br>\u7570\u306a\u308b\u30b9\u30ad\u30eb\u3092\u7fd2\u5f97\u3057\u3001\u6226\u95d8\u30b9\u30bf\u30a4\u30eb\u3092\u5909\u5316\u3055\u305b\u308b\u3053\u3068\u3067\u3001\u6226\u7565\u306e\u5e45\u304c\u5e83\u304c\u308a\u307e\u3059\u3002</p><p class=\"bb_paragraph\" ><strong>\u30fb\u6575\u304c\u8ffd\u3044\u304b\u3051\u3066\u3053\u306a\u3044\u30b7\u30f3\u30dc\u30eb\u30a8\u30f3\u30ab\u30a6\u30f3\u30c8</strong></p><p class=\"bb_paragraph\" >\u672c\u4f5c\u306f\u30b7\u30f3\u30dc\u30eb\u30a8\u30f3\u30ab\u30a6\u30f3\u30c8\u3092\u642d\u8f09\u3057\u3066\u3044\u307e\u3059\u304c\u3001\u57fa\u672c\u7684\u306b\u6575\u306f\u52d5\u3044\u305f\u308a\u8ffd\u8de1\u3057\u3066\u304f\u308b\u3053\u3068\u306f\u7121\u3044\u306e\u3067\u306e\u3073\u306e\u3073\u3068\u30d7\u30ec\u30a4\u3067\u304d\u307e\u3059\u3002</p><p class=\"bb_paragraph\" ><strong>\u30fb\u8857\u3084\u30c0\u30f3\u30b8\u30e7\u30f3\u304b\u3089\u306e\u8131\u51fa\u306f\u3044\u3064\u3067\u3082\u30ce\u2015\u30b3\u30b9\u30c8</strong></p><p class=\"bb_paragraph\" >\u8857\u3084\u30c0\u30f3\u30b8\u30e7\u30f3\u304b\u3089\u306e\u8131\u51fa\u306f\u30e1\u30a4\u30f3\u30e1\u30cb\u30e5\u30fc\u304b\u3089\u30ce\u2015\u30b3\u30b9\u30c8\u3067\u53ef\u80fd\uff01</p><p class=\"bb_paragraph\" >(\u7279\u5b9a\u306e\u30a4\u30d9\u30f3\u30c8\u4e2d\u3067\u306f\u8131\u51fa\u3067\u304d\u306a\u3044\u5834\u5408\u304c\u3054\u3056\u3044\u307e\u3059)</p><p class=\"bb_paragraph\" ><strong>\u30fb\u5192\u967a\u304c\u3050\u3063\u3068\u697d\u306b\uff01\u4fbf\u5229\u30b7\u30b9\u30c6\u30e0\u306e\u6570\u3005</strong></p><p class=\"bb_paragraph\" >\u30aa\u30fc\u30c8\u30bb\u30fc\u30d6\u3084\u79fb\u52d5\u901f\u5ea6\u306e\u5909\u66f4\u3001\u30d0\u30c3\u30af\u30ed\u30b0\u642d\u8f09\uff01</p><p class=\"bb_paragraph\" >\u3042\u3089\u3059\u3058\u3082\u5b8c\u5099\uff01</p>",
    "about_the_game": "<h2 class=\"bb_tag\" >\u25a0\u300c\u30bd\u30a6\u30eb\u30cf\u30f3\u30bf\u30fc\u30fb\u30ce\u30ce\u300d\u300cFirst Sin\u300d\u306a\u3069\u306e\u30d5\u30ea\u30fc\u30b2\u30fc\u30e0\u3092\u5236\u4f5c\u3057\u305f\u79cb\u539f\u5b5d\u592a(\u30a2\u30ad\u30cf\u30e9)\u306b\u3088\u308b\u65b0\u4f5cRPG\u3001Steam\u306b\u3066\u914d\u4fe1\uff01</h2><p class=\"bb_paragraph\" >\u904e\u53bb\u4f5c\u304b\u3089\u5236\u4f5c\u30c4\u30fc\u30eb\u3092\u5909\u66f4\u3057\u3066\u304a\u5c4a\u3051\u3059\u308b\u9577\u7de8RPG\u7b2c1\u5f3e\u306f\u3001\u81ea\u3089\u306b\u79d8\u3081\u3089\u308c\u305f\u529b\u3092\u5de1\u308b\u9a12\u52d5\u306b\u5dfb\u304d\u8fbc\u307e\u308c\u3064\u3064\u3082\u81ea\u5206\u81ea\u8eab\u306e\u6b63\u4f53\u3092\u77e5\u308b\u305f\u3081\u306b\u5192\u967a\u3059\u308bRPG\u3068\u306a\u3063\u3066\u3044\u307e\u3059\u3002</p><h2 class=\"bb_tag\" >\u25a0\u304a\u306f\u306a\u3057</h2><p class=\"bb_paragraph\" >\u4eba\u9593\u304c\u6587\u660e\u3092\u7bc9\u304d\u4e0a\u3052\u305f\u3042\u308b\u661f\u306b\u3066\u2026\u2026\u3002</p><p class=\"bb_paragraph\" >\u7a81\u5982\u3001\u4e16\u754c\u306e\u4e2d\u5fc3\u306b\u4f4d\u7f6e\u3059\u308b\u5927\u9678\u306b\u5de8\u5927\u306a\u7a74\u304c\u958b\u304d\u307e\u3057\u305f\u3002</p><p class=\"bb_paragraph\" >\u305d\u306e\u7a74\u304b\u3089\u3001\u6570\u3048\u5207\u308c\u306a\u3044\u307b\u3069\u306e\u9b54\u7269\u304c\u6e67\u304d\u51fa\u3057\u3001</p><p class=\"bb_paragraph\" >\u5e73\u548c\u3060\u3063\u305f\u4e16\u754c\u306f\u77ac\u304f\u9593\u306b\u6050\u6016\u306b\u8986\u308f\u308c\u307e\u3057\u305f\u3002</p><p class=\"bb_paragraph\" >\u3057\u304b\u3057\u3001\u4eba\u9593\u305f\u3061\u306f\u305f\u3060\u898b\u3066\u3044\u308b\u3060\u3051\u3067\u306f\u3042\u308a\u307e\u305b\u3093\u3067\u3057\u305f\u3002</p><p class=\"bb_paragraph\" >\u4e16\u754c\u5404\u56fd\u306f\u6025\u304e\u5175\u58eb\u3092\u52df\u96c6\u3057\u3001\u3053\u306e\u672a\u66fe\u6709\u306e\u5371\u6a5f\u306b\u7acb\u3061\u5411\u304b\u3046\u3053\u3068\u3092\u6c7a\u610f\u3057\u307e\u3059\u3002</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\u3053\u306e\u5371\u6a5f\u306e\u4e2d\u3001\u4e3b\u4eba\u516c\uff08\u30b2\u30fc\u30e0\u958b\u59cb\u6642\u306b\u540d\u524d\u3068\u898b\u305f\u76ee\u3092\u8a2d\u5b9a\uff09\u306f\u3042\u308b\u56fd\u306e\u5175\u58eb\u3068\u3057\u3066\u5fd7\u9858\u3057\u3001</p><p class=\"bb_paragraph\" >\u8a66\u9a13\u306b\u5408\u683c\u3057\u3066\u5175\u58eb\u3068\u3057\u3066\u306e\u751f\u6d3b\u3092\u30b9\u30bf\u30fc\u30c8\u3055\u305b\u307e\u3059\u3002</p><p class=\"bb_paragraph\" >\u3042\u308b\u65e5\u3001\u5cf6\u3067\u306e\u30d1\u30c8\u30ed\u30fc\u30eb\u4e2d\u306b\u8b0e\u306e\u7537\u306b\u8972\u6483\u3055\u308c\u307e\u3059\u304c</p><p class=\"bb_paragraph\" >\u5371\u6a5f\u7684\u72b6\u6cc1\u306e\u4e2d\u3001\u4e3b\u4eba\u516c\u306f\u77e5\u3089\u305a\u77e5\u3089\u305a\u306e\u3046\u3061\u306b\u79d8\u3081\u3089\u308c\u305f\u529b\u3092\u767a\u63ee\u3057\u3001\u7aae\u5730\u3092\u8131\u3057\u307e\u3059\u3002</p><p class=\"bb_paragraph\" >\u7a81\u7136\u899a\u9192\u3057\u305f\u529b\u306f\u4f55\u306a\u306e\u304b\u3001\u81ea\u5206\u304c\u672c\u5f53\u306f\u4f55\u8005\u306a\u306e\u304b\u2026\u2026\u3002</p><p class=\"bb_paragraph\" >\u8b0e\u3092\u89e3\u304d\u660e\u304b\u3059\u305f\u3081\u3001\u305d\u3057\u3066\u9b54\u7269\u3092\u5012\u3059\u305f\u3081\u3001</p><p class=\"bb_paragraph\" >\u4e3b\u4eba\u516c\u306f\u4ef2\u9593\u305f\u3061\u3068\u5171\u306b\u4e16\u754c\u3092\u65c5\u3059\u308b\u6c7a\u610f\u3092\u56fa\u3081\u307e\u3059\u3002</p><h2 class=\"bb_tag\" >\u25a0\u30b7\u30b9\u30c6\u30e0</h2><p class=\"bb_paragraph\" ><strong>\u30fb\u300c\u6599\u7406\u300d\u30b7\u30b9\u30c6\u30e0</strong></p><p class=\"bb_paragraph\" >\u5192\u967a\u306e\u9014\u4e2d\u3067\u624b\u306b\u5165\u308b<strong>\u300c\u30ec\u30b7\u30d4\u300d</strong>\u3092\u3082\u3068\u306b</p><p class=\"bb_paragraph\" ><strong>\u300c\u8d64\u300d\u300c\u9ec4\u8272\u300d\u300c\u7dd1\u300d</strong>\u306e\u98df\u6750\u3092\u56de\u5fa9\u30dd\u30a4\u30f3\u30c8\u3067\u4f7f\u3046\u3053\u3068\u3067\u3001</p><p class=\"bb_paragraph\" >\u6599\u7406\u3092\u4f5c\u308a\u4e0a\u3052\u308b\u30b7\u30f3\u30d7\u30eb\u306a\u30b7\u30b9\u30c6\u30e0\u3002</p><p class=\"bb_paragraph\" >\u6599\u7406\u306f\u3001\u6226\u95d8\u4e2d\u306bHP\u3084\u30b9\u30c6\u30fc\u30bf\u30b9\u306a\u3069\u3092\u5411\u4e0a\u3055\u305b\u307e\u3059\u3002</p><p class=\"bb_paragraph\" >\u69d8\u3005\u306a\u6599\u7406\u304c\u767b\u5834\u3057\u3001\u30ec\u30b7\u30d4\u3092\u624b\u306b\u5165\u308c\u3066\u6599\u7406\u3092\u884c\u3046\u3053\u3068\u3067\u5192\u967a\u3092\u3088\u308a\u6709\u5229\u306b\u9032\u3081\u3089\u308c\u308b\u3067\u3057\u3087\u3046\u3002</p><p class=\"bb_paragraph\" ><strong>\u30fb\u300c\u8ee2\u8077\u300d\u30b7\u30b9\u30c6\u30e0</strong></p><p class=\"bb_paragraph\" >\u4e3b\u4eba\u516c\u3068\u4ef2\u95931\u540d\u306f\u3001\u7269\u8a9e\u304c\u9032\u3080\u3068\u8ee2\u8077\u3067\u304d\u307e\u3059\u3002  <br>\u7570\u306a\u308b\u30b9\u30ad\u30eb\u3092\u7fd2\u5f97\u3057\u3001\u6226\u95d8\u30b9\u30bf\u30a4\u30eb\u3092\u5909\u5316\u3055\u305b\u308b\u3053\u3068\u3067\u3001\u6226\u7565\u306e\u5e45\u304c\u5e83\u304c\u308a\u307e\u3059\u3002</p><p class=\"bb_paragraph\" ><strong>\u30fb\u6575\u304c\u8ffd\u3044\u304b\u3051\u3066\u3053\u306a\u3044\u30b7\u30f3\u30dc\u30eb\u30a8\u30f3\u30ab\u30a6\u30f3\u30c8</strong></p><p class=\"bb_paragraph\" >\u672c\u4f5c\u306f\u30b7\u30f3\u30dc\u30eb\u30a8\u30f3\u30ab\u30a6\u30f3\u30c8\u3092\u642d\u8f09\u3057\u3066\u3044\u307e\u3059\u304c\u3001\u57fa\u672c\u7684\u306b\u6575\u306f\u52d5\u3044\u305f\u308a\u8ffd\u8de1\u3057\u3066\u304f\u308b\u3053\u3068\u306f\u7121\u3044\u306e\u3067\u306e\u3073\u306e\u3073\u3068\u30d7\u30ec\u30a4\u3067\u304d\u307e\u3059\u3002</p><p class=\"bb_paragraph\" ><strong>\u30fb\u8857\u3084\u30c0\u30f3\u30b8\u30e7\u30f3\u304b\u3089\u306e\u8131\u51fa\u306f\u3044\u3064\u3067\u3082\u30ce\u2015\u30b3\u30b9\u30c8</strong></p><p class=\"bb_paragraph\" >\u8857\u3084\u30c0\u30f3\u30b8\u30e7\u30f3\u304b\u3089\u306e\u8131\u51fa\u306f\u30e1\u30a4\u30f3\u30e1\u30cb\u30e5\u30fc\u304b\u3089\u30ce\u2015\u30b3\u30b9\u30c8\u3067\u53ef\u80fd\uff01</p><p class=\"bb_paragraph\" >(\u7279\u5b9a\u306e\u30a4\u30d9\u30f3\u30c8\u4e2d\u3067\u306f\u8131\u51fa\u3067\u304d\u306a\u3044\u5834\u5408\u304c\u3054\u3056\u3044\u307e\u3059)</p><p class=\"bb_paragraph\" ><strong>\u30fb\u5192\u967a\u304c\u3050\u3063\u3068\u697d\u306b\uff01\u4fbf\u5229\u30b7\u30b9\u30c6\u30e0\u306e\u6570\u3005</strong></p><p class=\"bb_paragraph\" >\u30aa\u30fc\u30c8\u30bb\u30fc\u30d6\u3084\u79fb\u52d5\u901f\u5ea6\u306e\u5909\u66f4\u3001\u30d0\u30c3\u30af\u30ed\u30b0\u642d\u8f09\uff01</p><p class=\"bb_paragraph\" >\u3042\u3089\u3059\u3058\u3082\u5b8c\u5099\uff01</p>",
    "short_description": "\u300c\u4eca\u3053\u305d\u8a9e\u308a\u307e\u3057\u3087\u3046\u3002\u300e\u3082\u3057\u3082\u300f\u306e\u7269\u8a9e\u3092\u2026\u2026\uff01\u300d\u672c\u4f5c\u306f\u3001\u300c\u8077\u300d\u3068\u300c\u98df\u300d\u304b\u3089\u529b\u3092\u5f97\u3066\u6226\u3046\u9577\u7de8RPG\u306e\u4f53\u9a13\u7248\u3067\u3059\u3002\u6642\u306b\u306f\u8077\u696d\u3092\u5909\u3048\u3066\u65b0\u305f\u306a\u30b9\u30ad\u30eb\u3084\u80fd\u529b\u3092\u5f97\u3066\u3001\u6642\u306b\u306f\u6599\u7406\u3092\u98df\u3079\u3066\u4e00\u6642\u7684\u306a\u30d0\u30d5\u3092\u5f97\u3066\u5192\u967a\u3057\u307e\u3057\u3087\u3046\u3002",
