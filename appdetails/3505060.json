mai.steamstatic.com/store_item_assets/steam/apps/3505060/extras/b5706c23efb7c95281a5fbc03c068e7c.webm?t=1753154782\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3505060/extras/b5706c23efb7c95281a5fbc03c068e7c.mp4?t=1753154782\" type=\"video/mp4\"></video></span></p>",
