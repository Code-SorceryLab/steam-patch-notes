aysinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3392160/extras/5f4c8bf1e0d336e0dc01413a2cc6b0b4.poster.avif?t=1743501305\" width=600 height=256 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3392160/extras/5f4c8bf1e0d336e0dc01413a2cc6b0b4.webm?t=1743501305\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3392160/extras/5f4c8bf1e0d336e0dc01413a2cc6b0b4.mp4?t=1743501305\" type=\"video/mp4\"></video></span></p>",
