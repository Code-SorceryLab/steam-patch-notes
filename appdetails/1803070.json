ecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1803070/extras/f6c53082c885f47c0d2fae4265dae15d.mp4?t=1752320148\" type=\"video/mp4\"></video></div><h2 class=\"bb_tag\">RESCUE HUMAN SURVIVORS</h2>Search out survivors in captured areas and bring back hope to the humans you liberate.<br><br><div class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1803070/extras/ea27cb6dd34c21ba2622e343d593ba92.poster.avif?t=1752320148\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1803070/extras/ea27cb6dd34c21ba2622e343d593ba92.webm?t=1752320148\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1803070/extras/ea27cb6dd34c21ba2622e343d593ba92.mp4?t=1752320148\" type=\"video/mp4\"></video></div><h2 class=\"bb_tag\">RACK UP HIGH SCORES</h2>Beat the records you set as you improve in your gun-wielding skills.<br><br><div class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1803070/extras/1172ddbca09872f3b52c9db5f39e8ef3.poster.avif?t=1752320148\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1803070/extras/1172ddbca09872f3b52c9db5f39e8ef3.webm?t=1752320148\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1803070/extras/1172ddbca09872f3b52c9db5f39e8ef3.mp4?t=1752320148\" type=\"video/mp4\"></video></div>",
