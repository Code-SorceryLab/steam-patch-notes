"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1206410/extras/ba9f640adc449ed4218c11cc24a524b7.poster.avif?t=1753229600\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1206410/extras/ba9f640adc449ed4218c11cc24a524b7.webm?t=1753229600\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1206410/extras/ba9f640adc449ed4218c11cc24a524b7.mp4?t=1753229600\" type=\"video/mp4\"></video></div></p><p class=\"bb_paragraph\"></p><p class=\"bb_paragraph\"><div class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1206410/extras/5dcd2d1c77f947c04f9becfe45f0f536.webp?t=1753229600\" /></div></p><p class=\"bb_paragraph\"></p><p class=\"bb_paragraph\">Kristala will be released via Chapters, and <strong>purchasing any time during Early Access grants you access to the Deluxe Version of the game.</strong> <br><br>Each Chapter contains 4-12 hours of gameplay, depending on your experience with ARPGs and overall interaction with side quests.   </p><p class=\"bb_paragraph\"> <div class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1206410/extras/1bfc02c437857beceaaded6ba1a2a516.avif?t=1753229600\" data-has-big /></div></p>",
