    "pc_requirements": {
        "minimum": "<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li>Requires a 64-bit processor and operating system<br></li><li><strong>OS:</strong> Windows 10 (64-bit)<br></li><li><strong>Processor:</strong> Intel Core i5-4590 / AMD Ryzen 5 1500X or better<br></li><li><strong>Memory:</strong> 8 GB RAM<br></li><li><strong>Graphics:</strong> NVIDIA GTX 1060 / AMD Radeon RX 580 or better<br></li><li><strong>DirectX:</strong> Version 11<br></li><li><strong>Storage:</strong> 2 GB available space<br></li><li><strong>Sound Card:</strong> Onboard or dedicated sound card<br></li><li><strong>VR Support:</strong> SteamVR, Meta Quest 2 (via Link using OpenXR)<br></li><li><strong>Additional Notes:</strong> At minimum, you need a GPU that can drive VR at 90Hz reliably. For Quest 2 on PC, users can connect via Oculus Link/Air Link and use OpenXR runtime. A consistent USB 3.0 connection or a stable Wi-Fi setup (for Air Link) is recommended.</li></ul>",
        "recommended": "<strong>Recommended:</strong><br><ul class=\"bb_ul\"><li>Requires a 64-bit processor and operating system<br></li><li><strong>OS:</strong> Windows 10/11 (64-bit)<br></li><li><strong>Processor:</strong> Intel Core i7-8700K / AMD Ryzen 5 3600 or better<br></li><li><strong>Memory:</strong> 16 GB RAM<br></li><li><strong>Graphics:</strong> NVIDIA RTX 2070 / AMD Radeon RX 5700 or better<br></li><li><strong>DirectX:</strong> Version 12<br></li><li><strong>Storage:</strong> 2 GB available space<br></li><li><strong>Sound Card:</strong> Onboard or dedicated sound card<br></li><li><strong>VR Support:</strong> SteamVR, Meta Quest 2 (via Link using OpenXR)<br></li><li><strong>Additional Notes:</strong> Recommended for a smoother experience at higher framerates/resolution. Ensures better performance for high\u2010resolution textures and more demanding visual features.</li></ul>"
    },
