    "detailed_description": "<h2 class=\"bb_tag\" ><strong>\u541b\u306e\u300e\u5168\u90e8\u300f\u3092\u300e\u5fc3\u300f\u306b\u5909\u3048\u308b\u306a\u3089</strong></h2><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\u9b54\u738b\u3068\u3057\u3066\u3053\u306e\u4e16\u306b\u751f\u307e\u308c\u305f\u306e\u306b\u3001\u3059\u3067\u306b\u4e16\u754c\u306f\u58ca\u308c\u3066\u3044\u305f\u3002\u4e3b\u4eba\u516c\u306e \u03bc \u306f\u4f55\u304b\u3092\u58ca\u3059\u4e8b\u3067\u3001\u4f55\u3082\u306a\u3044\u4e16\u754c\u306e\u4e2d\u304b\u3089\u4e00\u3064\u305a\u3064\u5927\u5207\u306a\u611f\u60c5\u3092\u624b\u306b\u5165\u308c\u3066\u3044\u304f\u3002</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\u904e\u53bb\u306e\u6b63\u7fa9\u3092\u9061\u308b3D\u30a2\u30c9\u30d9\u30f3\u30c1\u30e3\u30fc\u300e\u03bc of the M World\u300f\u306f\u9023\u8f09\u578b\u306e\u30a2\u30af\u30b7\u30e7\u30f3\u30b2\u30fc\u30e0\u3002<br>\u7269\u8a9e\u3068\u30a2\u30af\u30b7\u30e7\u30f3\u3092\u540c\u6642\u306b\u9032\u3081\u3066\u3044\u304f\u3053\u306e\u30b2\u30fc\u30e0\u306f\u3001\u7121\u6599\u30a2\u30c3\u30d7\u30c7\u30fc\u30c8\u3067\u5f90\u3005\u306b\u4e16\u754c\u304c\u5e83\u304c\u3063\u3066\u3044\u304d\u307e\u3059\u3002</p><p class=\"bb_paragraph\" ></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u69d8\u3005\u306a\u30a2\u30a4\u30c6\u30e0\u3092\u624b\u306b\u63e1\u3063\u3066\u6bb4\u308b</p></li></ul><p class=\"bb_paragraph\" >\u6575\u3092\u5012\u3059\u4e8b\u3067\u624b\u306b\u5165\u308c\u305f\u30a2\u30a4\u30c6\u30e0\u3092\u624b\u306b\u63e1\u3063\u3066\u6bb4\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002<br>\u305d\u3046\u3059\u308b\u3053\u3068\u306b\u3088\u3063\u3066\u3001\u30a2\u30a4\u30c6\u30e0\u306b\u5fdc\u3058\u305f\u5192\u967a\u306b\u5f79\u7acb\u3064\u69d8\u3005\u306a\u52b9\u679c\u304c\u767a\u751f\u3057\u307e\u3059\u3002</p><p class=\"bb_paragraph\" ></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u69d8\u3005\u306a\u7269\u8a9e\u3092\u89e3\u653e\u3059\u308b</p></li></ul><p class=\"bb_paragraph\" >\u30b7\u30ca\u30ea\u30aa\u3092\u9032\u3081\u3066\u3044\u304f\u4e8b\u3067 \u03bc \u306f\u69d8\u3005\u306a\u6c17\u6301\u3061\u3092\u77e5\u3063\u3066\u6210\u9577\u3057\u3066\u3044\u304d\u307e\u3059\u3002<br>\u3053\u306e\u7269\u8a9e\u306e\u30c6\u30fc\u30de\u306f\u300e\u7b11\u9854\u300f\u3067\u3044\u308b\u3068\u3044\u3046\u4e8b\u3002<br>\u751f\u307e\u308c\u305f\u3070\u304b\u308a\u3067\u4f55\u3082\u77e5\u3089\u306a\u3044\u9b54\u738b\u304c\u7b11\u3048\u308b\u69d8\u306b\u306a\u308b\u307e\u3067\u306e\u7269\u8a9e\u3067\u3059\u3002</p>",
    "about_the_game": "<h2 class=\"bb_tag\" ><strong>\u541b\u306e\u300e\u5168\u90e8\u300f\u3092\u300e\u5fc3\u300f\u306b\u5909\u3048\u308b\u306a\u3089</strong></h2><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\u9b54\u738b\u3068\u3057\u3066\u3053\u306e\u4e16\u306b\u751f\u307e\u308c\u305f\u306e\u306b\u3001\u3059\u3067\u306b\u4e16\u754c\u306f\u58ca\u308c\u3066\u3044\u305f\u3002\u4e3b\u4eba\u516c\u306e \u03bc \u306f\u4f55\u304b\u3092\u58ca\u3059\u4e8b\u3067\u3001\u4f55\u3082\u306a\u3044\u4e16\u754c\u306e\u4e2d\u304b\u3089\u4e00\u3064\u305a\u3064\u5927\u5207\u306a\u611f\u60c5\u3092\u624b\u306b\u5165\u308c\u3066\u3044\u304f\u3002</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\u904e\u53bb\u306e\u6b63\u7fa9\u3092\u9061\u308b3D\u30a2\u30c9\u30d9\u30f3\u30c1\u30e3\u30fc\u300e\u03bc of the M World\u300f\u306f\u9023\u8f09\u578b\u306e\u30a2\u30af\u30b7\u30e7\u30f3\u30b2\u30fc\u30e0\u3002<br>\u7269\u8a9e\u3068\u30a2\u30af\u30b7\u30e7\u30f3\u3092\u540c\u6642\u306b\u9032\u3081\u3066\u3044\u304f\u3053\u306e\u30b2\u30fc\u30e0\u306f\u3001\u7121\u6599\u30a2\u30c3\u30d7\u30c7\u30fc\u30c8\u3067\u5f90\u3005\u306b\u4e16\u754c\u304c\u5e83\u304c\u3063\u3066\u3044\u304d\u307e\u3059\u3002</p><p class=\"bb_paragraph\" ></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u69d8\u3005\u306a\u30a2\u30a4\u30c6\u30e0\u3092\u624b\u306b\u63e1\u3063\u3066\u6bb4\u308b</p></li></ul><p class=\"bb_paragraph\" >\u6575\u3092\u5012\u3059\u4e8b\u3067\u624b\u306b\u5165\u308c\u305f\u30a2\u30a4\u30c6\u30e0\u3092\u624b\u306b\u63e1\u3063\u3066\u6bb4\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002<br>\u305d\u3046\u3059\u308b\u3053\u3068\u306b\u3088\u3063\u3066\u3001\u30a2\u30a4\u30c6\u30e0\u306b\u5fdc\u3058\u305f\u5192\u967a\u306b\u5f79\u7acb\u3064\u69d8\u3005\u306a\u52b9\u679c\u304c\u767a\u751f\u3057\u307e\u3059\u3002</p><p class=\"bb_paragraph\" ></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u69d8\u3005\u306a\u7269\u8a9e\u3092\u89e3\u653e\u3059\u308b</p></li></ul><p class=\"bb_paragraph\" >\u30b7\u30ca\u30ea\u30aa\u3092\u9032\u3081\u3066\u3044\u304f\u4e8b\u3067 \u03bc \u306f\u69d8\u3005\u306a\u6c17\u6301\u3061\u3092\u77e5\u3063\u3066\u6210\u9577\u3057\u3066\u3044\u304d\u307e\u3059\u3002<br>\u3053\u306e\u7269\u8a9e\u306e\u30c6\u30fc\u30de\u306f\u300e\u7b11\u9854\u300f\u3067\u3044\u308b\u3068\u3044\u3046\u4e8b\u3002<br>\u751f\u307e\u308c\u305f\u3070\u304b\u308a\u3067\u4f55\u3082\u77e5\u3089\u306a\u3044\u9b54\u738b\u304c\u7b11\u3048\u308b\u69d8\u306b\u306a\u308b\u307e\u3067\u306e\u7269\u8a9e\u3067\u3059\u3002</p>",
    "short_description": "\u9b54\u738b\u3068\u3057\u3066\u3053\u306e\u4e16\u306b\u751f\u307e\u308c\u305f\u306e\u306b\u3001\u3059\u3067\u306b\u4e16\u754c\u306f\u58ca\u308c\u3066\u3044\u305f\u3002\u4e3b\u4eba\u516c\u306e \u03bc \u306f\u4f55\u304b\u3092\u58ca\u3059\u4e8b\u3067\u3001\u4f55\u3082\u306a\u3044\u4e16\u754c\u306e\u4e2d\u304b\u3089\u4e00\u3064\u305a\u3064\u5927\u5207\u306a\u611f\u60c5\u3092\u624b\u306b\u5165\u308c\u3066\u3044\u304f\u3002\u904e\u53bb\u306e\u6b63\u7fa9\u3092\u9061\u308b3D\u30a2\u30c9\u30d9\u30f3\u30c1\u30e3\u30fc\u300e\u03bc of the M World\u300f\u306f\u9023\u8f09\u578b\u306e\u30a2\u30af\u30b7\u30e7\u30f3\u30b2\u30fc\u30e0\u3002\u7269\u8a9e\u3068\u30a2\u30af\u30b7\u30e7\u30f3\u3092\u540c\u6642\u306b\u9032\u3081\u3066\u3044\u304f\u3053\u306e\u30b2\u30fc\u30e0\u306f\u3001\u7121\u6599\u30a2\u30c3\u30d7\u30c7\u30fc\u30c8\u3067\u5f90\u3005\u306b\u4e16\u754c\u304c\u5e83\u304c\u3063\u3066\u3044\u304d\u307e\u3059\u3002",
