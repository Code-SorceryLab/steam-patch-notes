    "name": "\u30dd\u30fc\u30e9\u30fc \u30a8\u30af\u30b9\u30d7\u30ed\u30fc\u30e9\u30fc: \u5317\u6975\u3078\u306e VR \u305d\u308a\u904a\u3073",
