/extras/b6b804ba2715e7cfa5262f1d6b7a46c0.poster.avif?t=1727070275\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/803020/extras/b6b804ba2715e7cfa5262f1d6b7a46c0.webm?t=1727070275\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/803020/extras/b6b804ba2715e7cfa5262f1d6b7a46c0.mp4?t=1727070275\" type=\"video/mp4\"></video></div><br>  - Punching speed ball<br>  - Heavy Bag Training  <br><div class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/803020/extras/d7b4105b3b37487e5fc56d6486c10c88.poster.avif?t=1727070275\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/803020/extras/d7b4105b3b37487e5fc56d6486c10c88.webm?t=1727070275\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/803020/extras/d7b4105b3b37487e5fc56d6486c10c88.mp4?t=1727070275\" type=\"video/mp4\"></video></div><br></li><li> Advanced AI divided by 5 difficulty levels<br><div class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/803020/extras/2c434d2bd8b0981e59c7ca09e9e2655a.poster.avif?t=1727070275\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/803020/extras/2c434d2bd8b0981e59c7ca09e9e2655a.webm?t=1727070275\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/803020/extras/2c434d2bd8b0981e59c7ca09e9e2655a.mp4?t=1727070275\" type=\"video/mp4\"></video></div><br></li><li> Multiplayer boxing in real-time<br><div class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/803020/extras/bce3b7977fe20c8b1654bbb046bb7538.poster.avif?