bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3772060/extras/6c558ca0c811432bc89c935d5a8d62bf.poster.avif?t=1755537048\" width=800 height=460 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3772060/extras/6c558ca0c811432bc89c935d5a8d62bf.webm?t=1755537048\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3772060/extras/6c558ca0c811432bc89c935d5a8d62bf.mp4?t=1755537048\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p>",
