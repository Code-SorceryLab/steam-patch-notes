urce src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2074710/extras/6611f24bf93e8fb65525f3f2d7165793.webm?t=1739142553\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2074710/extras/6611f24bf93e8fb65525f3f2d7165793.mp4?t=1739142553\" type=\"video/mp4\"></video></div><br><br><ul class=\"bb_ul\"><li>Reach the next level.</li></ul><ul class=\"bb_ul\"><li>Get stronger.</li></ul><ul class=\"bb_ul\"><li>Destroy your enemies.</li></ul><div class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2074710/extras/076969e8137824a1316f52b56421865c.poster.avif?t=1739142553\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2074710/extras/076969e8137824a1316f52b56421865c.webm?t=1739142553\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2074710/extras/076969e8137824a1316f52b56421865c.mp4?t=1739142553\" type=\"video/mp4\"></video></div><br><br><ul class=\"bb_ul\"><li>Create your own build in this fun and satisfying roguelite.</li></ul><div class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2074710/extras/88e3265c0b584efe8e2d8cf4c271563b.poster.avif?t=1739142553\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2074710/extras/88e3265c0b584efe8e2d8cf4c271563b.webm?t=1739142553\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2074710/extras/88e3265c0b584efe8e2d8cf4c271563b.mp4?t=1739142553\" type=\"video/mp4\"></video></div>",
