sinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1654150/extras/765c7e491ca31627df934a9e02422915.poster.avif?t=1709237599\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1654150/extras/765c7e491ca31627df934a9e02422915.webm?t=1709237599\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1654150/extras/765c7e491ca31627df934a9e02422915.mp4?t=1709237599\" type=\"video/mp4\"></video></div>",
