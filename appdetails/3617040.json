31\u7684\u6c27\u6c14\u7f50\u5236\u4f5c\u7ec4</p><p class=\"bb_paragraph\" >\u3010B\u7ad9ID\u3011\uff1a\u7231\u7684\u6c27\u6c14\u7f50\u5236\u4f5c\u7ec4</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\u5b9d\u5b9d\u4eec\u53ef\u4ee5\u5173\u6ce8\u8fd9\u4e9b\u5e73\u53f0\u83b7\u5f97\u540e\u7eed\u6e38\u620f\u5185\u5bb9~</p>",
    "about_the_game": "<p class=\"bb_paragraph\" ></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>\u4e59 \u5973 x \u8f7b \u559c \u5267 x \u543b</strong></p></li></ul><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3617040/extras/ad39cec1dc5916964f08f8bf59725bca.avif?t=1746077870\" data-has-big width=800 height=84 /></span></p><p class=\"bb_paragraph\" >\u5e73\u51e1\u7684\u793e\u755c\u4f58\u695a\u695a\uff08\u59d3\u540d\u53ef\u66f4\u6539\uff09\u5de5\u4f5c\u65e5\u665a\u4e0a\u56e2\u5efa\u7ed3\u675f\u65f6\uff0c\u5728\u8def\u8fb9\u88ab\u9152\u9a7e\u8f66\u8f86\u649e\u5230\u8eab\u4ea1\u3002</p><p class=\"bb_paragraph\" >\u672c\u4ee5\u4e3a\u4f1a\u53bb\u76f4\u63a5\u6295\u80ce\u7684\u5979\uff0c\u5374\u88ab\u6b7b\u795e\u544a\u77e5\uff0c\u8fd9\u573a\u8f66\u7978\u53ef\u80fd\u662f\u5730\u5e9c\u5bbf\u547d\u7cfb\u7edf\u8fd0\u884c\u9519\u8bef\u5bfc\u81f4\u7684\u4e4c\u9f99\u3002</p><p class=\"bb_paragraph\" >\u5730\u5e9c\u67e5\u6e05\u9519\u8bef\u5927\u6982\u9700\u898120\u5929\u7684\u65f6\u95f4\uff0c\u5728\u8fd9\u671f\u95f4\uff0c\u4f58\u695a\u695a\u53ef\u4ee5\u7ee7\u7eed\u7559\u5728\u4eba\u95f4\uff0c\u4f46\u5fc5\u987b\u8981\u4f9d\u9644\u751f\u8005\u800c\u6d3b\u3002</p><p class=\"bb_paragraph\" >\u6bcf\u8fc772\u5c0f\u65f6\uff0c\u4f58\u695a\u695a\u5fc5\u987b\u8981\u4e0e\u4f9d\u9644\u8005\u4eb2\u543b\u83b7\u5f97\u5bf9\u65b9\u7684\u201c\u751f\u8005\u4e4b\u6c14\u201d\uff0c\u5426\u5219\u4fbf\u4f1a\u63d0\u524d\u9b42\u98de\u9b44\u6563\u3002</p><p class=\"bb_paragraph\" >\u4fd7\u8bdd\u8bf4\u5f97\u597d\u2014\u2014\u201c\u597d\u6b7b\u4e0d\u5982\u8d56\u6d3b\u7740\u201d\uff0c\u4e3a\u4e86\u80fd\u591f\u6491\u5230\u67e5\u6e05\u4e8b\u6545\u7684\u90a3\u5929\uff0c\u4e0d\u7ba1\u662f\u524d\u7537\u53cb\u8fd8\u662f\u767d\u6708\u5149\uff0c\u4ea6\u6216\u662f\u8def\u8fc7\u7684\u964c\u751f\u7f8e\u9752\u5e74\uff0c\u902e\u5230\u54ea\u4e2a\u662f\u54ea\u4e2a\uff0c\u5979\u4f58\u695a\u695a\uff08\u59d3\u540d\u53ef\u66f4\u6539\uff09\u90fd\u4e0d\u4f1a\u653e\u8fc7\u3002</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3617040/extras/3cd79db4d308535da5287df071aafff1.avif?t=1746077870\" data-has-big width=800 height=1922 /></span></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3617040/extras/0a45f74786578292f2447369481f1833.avif?t=1746077870\" data-has-big width=800 height=84 /></span><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3617040/extras/71ed2df186eb9267fed148e166724ac0.avif?t=1746077870\" width=768 height=400 /></span></p><p class=\"bb_paragraph\" >\u672c\u4f5c\u7684\u4e3b\u4eba\u516c\uff0c\u666e\u901a\u793e\u755c\u4e00\u679a\uff0c\u4e8e\u5de5\u4f5c\u65e5\u665a\u56e2\u5efa\u540e\u4e0d\u5e78\u906d\u9047\u8f66\u7978\u8eab\u4ea1\u3002</p><p class=\"bb_paragraph\" >\u4f46\u662f\u5f53\u4e3b\u4eba\u516c\u518d\u7741\u5f00\u773c\u775b\u65f6\uff0c\u524d\u6765\u63a5\u5f15\u5979\u7684\u6b7b\u795e\u544a\u77e5\u8fd9\u573a\u4e8b\u6545\u53ef\u80fd\u662f\u610f\u5916\u3002</p><p class=\"bb_paragraph\" >\u5728\u5730\u5e9c\u8c03\u67e5\u6e05\u695a\u524d\uff0c\u9700\u8981\u4e3b\u4eba\u516c\u5728\u4eba\u95f4\u5bc4\u751f\u5728\u6d3b\u4eba\u8eab\u4e0a20\u5929\uff0c\u800c\u5bc4\u751f\u7684\u529e\u6cd5\u5219\u662f\u5634\u5bf9\u5634\u6c72\u53d6\u6d3b\u4eba\u7684\u201c\u751f\u6c14\u201d\uff0c\u8fd8\u5fc5\u987b\u6bcf72\u5c0f\u65f6\u4e00\u6b21\u3002</p><p class=\"bb_paragraph\" >\u5149\u60f3\u5c31\u4ee4\u4eba\u5934\u5927\u3002</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><strong><i>\u201c\u628a\u56e2\u5efa\u5b9a\u5728\u5de5\u4f5c\u65e5\u665a\u4e0a\u7684\u4e3b\u7ba1\u90fd\u5e94\u8be5\u88ab\u6293\u8d77\u6765\uff01\u201d</i></strong></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3617040/extras/be9947668a1255f9fcd54a94a04f64ec.avif?t=1746077870\" width=768 height=400 /></span></p><p class=\"bb_paragraph\" ><strong>\u3010\u5927\u5b66\u65f6\u671f\u4ea4\u5f80\u4e24\u5e74\u7684\u524d\u7537\u53cb\u3011</strong></p><p class=\"bb_paragraph\" >\u56e0\u4e3a\u66fe\u7ecf\u7684\u5206\u624b\u5e76\u4e0d\u6109\u5feb\uff0c\u56e0\u6b64\u4e3b\u4eba\u516c\u672c\u6765\u5e76\u6ca1\u6709\u5c06\u8d3a\u4e00\u6657\u4f5c\u4e3a\u4eb2\u543b\u7eed\u547d\u7684\u5907\u9009\u3002</p><p class=\"bb_paragraph\" >\u7136\u800c\u9634\u5dee\u9633\u9519\u4e4b\u4e0b\uff0c\u4e8c\u4eba\u4ecd\u7136\u4ea7\u751f\u4e86\u4ea4\u96c6\u3002</p><p class=\"bb_paragraph\" >\u4e00\u573a\u62c9\u626f\u4e0e\u8bd5\u63a2\u7684\u60c5\u611f\u7ea0\u845b\u518d\u6b21\u62c9\u5f00\u5e37\u5e55\u3002</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><strong><i>\u201c\u8bb0\u4f4f\uff0c\u6211\u4eec\u5df2\u7ecf\u5206\u624b\u4e86\uff01\u201d</i></strong></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3617040/extras/cc3fadb26d4872e0723525319d3f6ac9.avif?t=1746077870\" width=768 height=400 /></span></p><p class=\"bb_paragraph\" ><strong>\u3010\u964c\u751f\u7684\u7f8e\u5c11\u5e74\u3011</strong></p><p class=\"bb_paragraph\" >\u4e3b\u4eba\u516c\u5728\u670b\u53cb\u516c\u53f8\u697c\u4e0b\u5076\u9047\u7684\uff08\u770b\u7740\u5c31\u5bb6\u4e16\u4e0d\u51e1\u7684\uff09\u7f8e\u5c11\u5e74\u3002</p><p class=\"bb_paragraph\" >\u6b7b\u795e\u7ed9\u4e88\u4e3b\u4eba\u516c\u9009\u62e9\u4eb2\u543b\u7eed\u547d\u5bf9\u8c61\u7684\u65f6\u95f4\u6709\u9650\uff0c\u4e3b\u4eba\u516c\u518d\u5ea6\u6fd2\u6b7b\u4e4b\u65f6\uff0c\u6c42\u751f\u7684\u610f\u5fd7\u4ee4\u5979\u4e0d\u5f97\u5df2\u9009\u62e9\u4e86\u8fd9\u4e2a\u5b8c\u5168\u4e0d\u77e5\u9053\u4efb\u4f55\u4fe1\u606f\u7684\u9752\u5e74\u3002</p><p class=\"bb_paragraph\" >\u4e3a\u4e86\u6d3b\u4e0b\u53bb\uff0c\u4e3b\u4eba\u516c\u4e5f\u53ea\u80fd\u786c\u7740\u5934\u76ae\uff0c\u60f3\u529e\u6cd5\u5f97\u5230\u8fd9\u4e2a\u6bd2\u820c\u5c0f\u5b50\u7684\u9752\u7750\u3002</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><strong><i>\u201c\u5e2e\u4e0d\u5e2e\u4f60\u6211\u90fd\u6ca1\u6709\u635f\u5931\uff0c\u90a3\u4e48\u6211\u4e3a\u4ec0\u4e48\u8981\u505a\u6148\u5584\uff1f\u201d</i></strong></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3617040/extras/3fa30e34aa0bf631d844cd495762ff30.avif?t=1746077870\" width=768 height=400 /></span></p><p class=\"bb_paragraph\" ><strong>\u3010\u559c\u7231\u5e76\u61a7\u61ac\u7684\u5c0f\u63d0\u7434\u5bb6\u3011</strong></p><p class=\"bb_paragraph\" >\u51fa\u4e8e\u6700\u574f\u7684\u60c5\u51b5\u8003\u8651\uff0c\u4e3b\u4eba\u516c\u7684\u751f\u547d\u6216\u8bb8\u53ea\u5269\u4e0b20\u5929\uff0c\u56e0\u6b64\u4e3b\u4eba\u516c\u9f13\u8d77\u52c7\u6c14\u51b3\u5b9a\u53bb\u89c1\u4e00\u76f4\u4ee5\u6765\u61a7\u61ac\u7684\u5076\u50cf\u3002</p><p class=\"bb_paragraph\" >\u5374\u6ca1\u60f3\u5230\u5916\u8868\u770b\u4f3c\u6e05\u51b7\u5b64\u50b2\u7684\u7537\u4eba\u5b9e\u9645\u4e0a\u6781\u4e3a\u597d\u8bf4\u8bdd\uff0c\u4e8e\u662f\u4e3b\u4eba\u516c\u505a\u4e86\u4e00\u4e2a\u5927\u80c6\u7684\u51b3\u5b9a\u2026\u2026</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><strong><i>\u201c\u4f60\u4f1a\u53d8\u6210\u8fd9\u6837\uff0c\u6211\u6709\u4e0d\u53ef\u63a8\u5378\u7684\u8d23\u4efb\u201d</i></strong></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3617040/extras/54c998738694600c1b7fa20c5b7a8ad1.avif?t=1746077870\" data-has-big width=800 height=84 /></span></p><p class=\"bb_paragraph\" >\u5236\u4f5c\u7ec4\uff1a\u7231\u7684\u6c27\u6c14\u7f50\u5236\u4f5c\u7ec4</p><p class=\"bb_paragraph\" >\u4e3b\u7b56/\u5267\u672c/\u6f14\u51fa\uff1a\u6e05\u67e0</p><p class=\"bb_paragraph\" >\u89d2\u8272/CG\u539f\u753b\uff1a\u574f\u574f\u4f0f\u4f0f</p><p class=\"bb_paragraph\" >UI/\u7f8e\u5ba3\uff1aQ\u5e03</p><p class=\"bb_paragraph\" >\u7a0b\u5e8f\uff1a\u5495\u5495</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3617040/extras/d0363fac79b531b69ef0e9a9c40f16b5.avif?t=1746077870\" data-has-big width=800 height=84 /></span></p><p class=\"bb_paragraph\" >\u672c\u6e38\u620f\u7c7b\u578b\u4e3a\u89c6\u89c9\u5c0f\u8bf4\uff08AVD/ADV\uff09\u3002</p><p class=\"bb_paragraph\" >\u5373\u901a\u8fc7\u9605\u8bfb\u6587\u5b57\u5267\u60c5\uff0c\u901a\u8fc7\u9009\u9879\u8fdb\u884c\u9009\u62e9\uff0c\u63a8\u52a8\u6545\u4e8b\u60c5\u8282\u4ea7\u751f\u5206\u652f\u7684\u5192\u9669\u6e38\u620f\u3002</p><p class=\"bb_paragraph\" >\uff08\u6ce8\uff1a\u672c\u6e38\u620f\u6240\u6709\u53ef\u653b\u7565\u7537\u89d2\u8272\u5747\u5df2\u6210\u5e74\uff09</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3617040/extras/76c8c1a6fc7bed423207f540541aa060.avif?t=1746077870\" data-has-big width=800 height=84 /></span>\u3010\u6e38\u620f\u8bd5\u73a9\u7248\uff08demo\uff09\u3011</p><p class=\"bb_paragraph\" >\u8d44\u6e90QQ\u7fa4\uff1a107544106\uff08\u5177\u4f53\u89c1\u7fa4\u6587\u4ef6\uff09</p><p class=\"bb_paragraph\" >\uff08\u6ce8\uff1a\u8bd5\u73a9\u7248\u5185\u5bb9\u4e0d\u4ee3\u8868\u6b63\u5f0f\u7248\u5185\u5bb9\uff0c\u4ec5\u4f9b\u53c2\u8003\uff09</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\u3010\u5fae\u535aID\u3011\uff1a\u7231\u7684\u6c27\u6c14\u7f50\u5de5\u4f5c\u5ba4</p><p class=\"bb_paragraph\" >\u3010\u5c0f\u7ea2\u4e66ID\u3011\uff1a\u7231\u7684\u6c27\u6c14\u7f50\u5236\u4f5c\u7ec4</p><p class=\"bb_paragraph\" >\u3010B\u7ad9ID\u3011\uff1a\u7231\u7684\u6c27\u6c14\u7f50\u5236\u4f5c\u7ec4</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\u5b9d\u5b9d\u4eec\u53ef\u4ee5\u5173\u6ce8\u8fd9\u4e9b\u5e73\u53f0\u83b7\u5f97\u540e\u7eed\u6e38\u620f\u5185\u5bb9~</p>",
    "short_description": "\u3010\u4e59\u5973x\u8f7b\u559c\u5267x\u543b\u3011\u8bb2\u8ff0\u4e86\u8eab\u4e3a\u793e\u755c\u7684\u4e3b\u4eba\u516c\u610f\u5916\u53bb\u4e16\u540e\uff0c\u5374\u88ab\u6b7b\u795e\u544a\u77e5\uff0c\u60f3\u8981\u6d3b\u4e0b\u53bb\uff0c\u5c31\u5f97\u60f3\u529e\u6cd5\u6bcf\u4e09\u5929\u548c\u5e05\u54e5\u4eb2\u543b\u6765\u7eed\u547d\u7684\u90fd\u5e02\u5947\u5e7b\u7231\u60c5\u8f7b\u559c\u5267\u3002\u524d\u7537\u53cb\uff0c\u61a7\u61ac\u7684\u4eba\uff0c\u964c\u751f\u7f8e\u9752\u5e74\uff0c\u54ce\u5440\uff0c\u771f\u96be\u9009\u554a\uff01",
