ai.steamstatic.com/store_item_assets/steam/apps/2465930/extras/410432e61360d497fb87fbc1b6af9ff9.mp4?t=1750935343\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >Sometimes things <strong>get a bit weird.</strong></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2465930/extras/66b3e397948debf91408e92c1eb7c86e.poster.avif?t=1750935343\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2465930/extras/66b3e397948debf91408e92c1eb7c86e.webm?t=1750935343\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2465930/extras/66b3e397948debf91408e92c1eb7c86e.mp4?t=1750935343\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >But <strong>always fun.</strong></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2465930/extras/f7dcaead46868cd4bd97748321d948c2.poster.avif?t=1750935343\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2465930/extras/f7dcaead46868cd4bd97748321d948c2.webm?t=1750935343\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2465930/extras/f7dcaead46868cd4bd97748321d948c2.mp4?t=1750935343\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" >Featuring an <strong>original</strong>\u00a0<strong>Vaporwave Soundtrack. </strong><br><br><br><strong></strong><br> </p>",
