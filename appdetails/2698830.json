playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2698830/extras/86615ba6e3cc4d4f50ceec5de2a73e93.poster.avif?t=1749657835\" width=450 height=200 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2698830/extras/86615ba6e3cc4d4f50ceec5de2a73e93.webm?t=1749657835\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2698830/extras/86615ba6e3cc4d4f50ceec5de2a73e93.mp4?t=1749657835\" type=\"video/mp4\"></video></span></p>",
