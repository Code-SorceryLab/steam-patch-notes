    "controller_support": "full",
    "detailed_description": "<p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3018900/extras/d72a991aa86272e4cb2b21266e987727.poster.avif?t=1750837025\" width=452 height=452 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3018900/extras/d72a991aa86272e4cb2b21266e987727.webm?t=1750837025\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3018900/extras/d72a991aa86272e4cb2b21266e987727.mp4?t=1750837025\" type=\"video/mp4\"></video></span></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >This is a twin-stick shooter in the style of The Binding of Isaac.</p></li><li><p class=\"bb_paragraph\" >A Enemy Base producing zombies was found in the Desert and Arctic.</p></li><li><p class=\"bb_paragraph\" >Our hero, a MiniTank, was sent on a mission to destroy this Base.</p></li><li><p class=\"bb_paragraph\" >During the mission, there will be no help from the headquarters, so the player must repair the tank and find upgrades on their own.</p></li><li><p class=\"bb_paragraph\" >Upgrades can be purchased at upgrade stations.</p></li><li><p class=\"bb_paragraph\" >The player will need to find and clear all zombie production stations and the enemy headquarters.</p></li></ul><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3018900/extras/06dc5869a8364c7c4c712d6199e4426a.poster.avif?t=1750837025\" width=240 height=240 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3018900/extras/06dc5869a8364c7c4c712d6199e4426a.webm?t=1750837025\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3018900/extras/06dc5869a8364c7c4c712d6199e4426a.mp4?t=1750837025\" type=\"video/mp4\"></video></span><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3018900/extras/2bb6d6f168c5fe73f34528c9506d4cbc.poster.avif?t=1750837025\" width=240 height=240 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3018900/extras/2bb6d6f168c5fe73f34528c9506d4cbc.webm?t=1750837025\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3018900/extras/2bb6d6f168c5fe73f34528c9506d4cbc.mp4?t=1750837025\" type=\"video/mp4\"></video></span></p>",
    "about_the_game": "<p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3018900/extras/d72a991aa86272e4cb2b21266e987727.poster.avif?t=1750837025\" width=452 height=452 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3018900/extras/d72a991aa86272e4cb2b21266e987727.webm?t=1750837025\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3018900/extras/d72a991aa86272e4cb2b21266e987727.mp4?t=1750837025\" type=\"video/mp4\"></video></span></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >This is a twin-stick shooter in the style of The Binding of Isaac.</p></li><li><p class=\"bb_paragraph\" >A Enemy Base producing zombies was found in the Desert and Arctic.</p></li><li><p class=\"bb_paragraph\" >Our hero, a MiniTank, was sent on a mission to destroy this Base.</p></li><li><p class=\"bb_paragraph\" >During the mission, there will be no help from the headquarters, so the player must repair the tank and find upgrades on their own.</p></li><li><p class=\"bb_paragraph\" >Upgrades can be purchased at upgrade stations.</p></li><li><p class=\"bb_paragraph\" >The player will need to find and clear all zombie production stations and the enemy headquarters.</p></li></ul><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3018900/extras/06dc5869a8364c7c4c712d6199e4426a.poster.avif?t=1750837025\" width=240 height=240 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3018900/extras/06dc5869a8364c7c4c712d6199e4426a.webm?t=1750837025\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3018900/extras/06dc5869a8364c7c4c712d6199e4426a.mp4?t=1750837025\" type=\"video/mp4\"></video></span><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3018900/extras/2bb6d6f168c5fe73f34528c9506d4cbc.poster.avif?t=1750837025\" width=240 height=240 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3018900/extras/2bb6d6f168c5fe73f34528c9506d4cbc.webm?t=1750837025\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3018900/extras/2bb6d6f168c5fe73f34528c9506d4cbc.mp4?t=1750837025\" type=\"video/mp4\"></video></span></p>",
