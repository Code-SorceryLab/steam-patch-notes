e8.poster.avif?t=1727442259\" width=600 height=338 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2980320/extras/aa6c45f0e63b7db0c56a4ef5410d44e8.webm?t=1727442259\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2980320/extras/aa6c45f0e63b7db0c56a4ef5410d44e8.mp4?t=1727442259\" type=\"video/mp4\"></video></span>",
