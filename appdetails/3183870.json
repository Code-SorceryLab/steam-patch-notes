p playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3183870/extras/31ad08dfe484b0cba09ec05bfa25940d.poster.avif?t=1742721561\" width=640 height=360 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3183870/extras/31ad08dfe484b0cba09ec05bfa25940d.webm?t=1742721561\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3183870/extras/31ad08dfe484b0cba09ec05bfa25940d.mp4?t=1742721561\" type=\"video/mp4\"></video></span>",
