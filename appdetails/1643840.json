mg_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1643840/extras/8e2feba1172df5aa517e305fbbe3a60a.poster.avif?t=1738851680\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1643840/extras/8e2feba1172df5aa517e305fbbe3a60a.webm?t=1738851680\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1643840/extras/8e2feba1172df5aa517e305fbbe3a60a.mp4?t=1738851680\" type=\"video/mp4\"></video></div></p><p class=\"bb_paragraph\"></p>",
