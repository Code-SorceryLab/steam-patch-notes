apps/2850110/extras/cb5d4562040ea70fecfe02664704383f.poster.avif?t=1754001226\" width=600 height=222 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2850110/extras/cb5d4562040ea70fecfe02664704383f.webm?t=1754001226\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2850110/extras/cb5d4562040ea70fecfe02664704383f.mp4?t=1754001226\" type=\"video/mp4\"></video></span></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >Fighting</p></li></ul><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2850110/extras/b6eb83a0812a77c23bd28a875123bb8e.poster.avif?t=1754001226\" width=600 height=234 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2850110/extras/b6eb83a0812a77c23bd28a875123bb8e.webm?t=1754001226\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2850110/extras/b6eb83a0812a77c23bd28a875123bb8e.mp4?t=1754001226\" type=\"video/mp4\"></video></span></p><h2 class=\"bb_tag\" >Nightmare</h2><p class=\"bb_paragraph\" >Nightmares comes at regular intervals, dark monsters will attack the base, its challenging fights and players must prepare well and use everything to survive.</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2850110/extras/aee9f503c7f34178cf4baf72abb9d77b.poster.avif?t=1754001226\" width=600 height=232 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2850110/extras/aee9f503c7f34178cf4baf72abb9d77b.webm?t=1754001226\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2850110/extras/aee9f503c7f34178cf4baf7