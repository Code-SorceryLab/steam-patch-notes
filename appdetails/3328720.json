mg\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3328720/extras/0790672157c5fa92d395679b0be90c0e.poster.avif?t=1755135319\" width=600 height=300 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3328720/extras/0790672157c5fa92d395679b0be90c0e.webm?t=1755135319\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3328720/extras/0790672157c5fa92d395679b0be90c0e.mp4?t=1755135319\" type=\"video/mp4\"></video></span></h2>",
