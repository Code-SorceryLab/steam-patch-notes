226280/extras/98d55484844c609cdb54523f49f10dfa.webm?t=1744642739\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2226280/extras/98d55484844c609cdb54523f49f10dfa.mp4?t=1744642739\" type=\"video/mp4\"></video></div></h2><p class=\"bb_paragraph\"></p><p class=\"bb_paragraph\"></p><p class=\"bb_paragraph\"><div class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2226280/extras/67e45e011dddb8ce98e86cbfb4f22339.avif?t=1744642739\" /></div></p><p class=\"bb_paragraph\">Whether it\u2019s the turnaround 1v3, hitting a sweet multi-target knock up or just watching your mates get hit by their own trap \u2013 BAPBAP is here to help you get that sweet hit of dopamine in this increasingly depressing world. <br><div class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2226280/extras/32728e859eb5631aeae9ccf9fa757d01.poster.avif?t=1744642739\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2226280/extras/32728e859eb5631aeae9ccf9fa757d01.webm?t=1744642739\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2226280/extras/32728e859eb5631aeae9ccf9fa757d01.mp4?t=1744642739\" type=\"video/mp4\"></video></div></p><p class=\"bb_paragraph\"></p><p class=\"bb_paragraph\"><strong>Welcome to BAPBAP, where logic goes to die. </strong></p>",
