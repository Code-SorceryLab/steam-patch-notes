eamstatic.com/store_item_assets/steam/apps/2743260/extras/81fbeb02f179ddeee0d2e15f93b54c07.webm?t=1724233650\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2743260/extras/81fbeb02f179ddeee0d2e15f93b54c07.mp4?t=1724233650\" type=\"video/mp4\"></video></span>",
