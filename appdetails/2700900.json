    "name": "Toska",
    "steam_appid": 2700900,
    "required_age": 0,
    "is_free": false,
    "detailed_description": "<p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2700900/extras/5fdd94d023d443aa654a819678560b88.poster.avif?t=1746032827\" width=800 height=450 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2700900/extras/5fdd94d023d443aa654a819678560b88.webm?t=1746032827\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2700900/extras/5fdd94d023d443aa654a819678560b88.mp4?t=1746032827\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ><strong>Get lost in the woods! Find something nice for mom!</strong></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><i>Toska</i> is an atmospheric 2D exploration game spanning five days. Each day presents a limited window during your trip home from school to explore, discover hidden secrets, meet interesting characters, and bring home something nice for your mom. Will you make it home with the perfect gift, or will curiosity lead you to uncover deeper mysteries? </p><p class=\"bb_paragraph\" ></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >Explore abandoned houses and structures</p></li><li><p class=\"bb_paragraph\" >Meet quirky characters</p></li><li><p class=\"bb_paragraph\" >Read people's mail</p></li><li><p class=\"bb_paragraph\" >Complete puzzles and open-ended quests</p></li><li><p class=\"bb_paragraph\" >Find gifts your mom will love</p></li></ul>",
    "about_the_game": "<p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2700900/extras/5fdd94d023d443aa654a819678560b88.poster.avif?t=1746032827\" width=800 height=450 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2700900/extras/5fdd94d023d443aa654a819678560b88.webm?t=1746032827\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2700900/extras/5fdd94d023d443aa654a819678560b88.mp4?t=1746032827\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ><strong>Get lost in the woods! Find something nice for mom!</strong></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><i>Toska</i> is an atmospheric 2D exploration game spanning five days. Each day presents a limited window during your trip home from school to explore, discover hidden secrets, meet interesting characters, and bring home something nice for your mom. Will you make it home with the perfect gift, or will curiosity lead you to uncover deeper mysteries? </p><p class=\"bb_paragraph\" ></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >Explore abandoned houses and structures</p></li><li><p class=\"bb_paragraph\" >Meet quirky characters</p></li><li><p class=\"bb_paragraph\" >Read people's mail</p></li><li><p class=\"bb_paragraph\" >Complete puzzles and open-ended quests</p></li><li><p class=\"bb_paragraph\" >Find gifts your mom will love</p></li></ul>",
    "short_description": "A cozy 2D exploration game. Venture into abandoned buildings, uncover lost secrets, read people's mail, meet interesting characters, and find something nice for your mom.",
