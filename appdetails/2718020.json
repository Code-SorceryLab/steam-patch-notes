ss=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2718020/extras/49921c9abbe808baf87cc072be57fa29.poster.avif?t=1753821585\" width=500 height=204 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2718020/extras/49921c9abbe808baf87cc072be57fa29.webm?t=1753821585\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2718020/extras/49921c9abbe808baf87cc072be57fa29.mp4?t=1753821585\" type=\"video/mp4\"></video></span></p><h2 class=\"bb_tag\" >IMMERSIVE VISUALS</h2><p class=\"bb_paragraph\" >Get lost in a beautifully crafted claymation and stop-motion miniature set-inspired world.</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2718020/extras/1ca703322cd12fa60d555aab5491218b.poster.avif?t=1753821585\" width=500 height=280 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2718020/extras/1ca703322cd12fa60d555aab5491218b.webm?t=1753821585\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2718020/extras/1ca703322cd12fa60d555aab5491218b.mp4?t=1753821585\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p>",
