ai.steamstatic.com/store_item_assets/steam/apps/2335960/extras/0ab061e5fc2ef83a7df389e9316c682b.webm?t=1754453638\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2335960/extras/0ab061e5fc2ef83a7df389e9316c682b.mp4?t=1754453638\" type=\"video/mp4\"></video></span>",
