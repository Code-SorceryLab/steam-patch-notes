5770/extras/eba412465799f80d2a9593694b7c65a3.poster.avif?t=1752482619\" width=600 height=338 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3715770/extras/eba412465799f80d2a9593694b7c65a3.webm?t=1752482619\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3715770/extras/eba412465799f80d2a9593694b7c65a3.mp4?t=1752482619\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3715770/extras/53ca85e6d161b0c97532390dd698a66a.poster.avif?t=1752482619\" width=600 height=338 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3715770/extras/53ca85e6d161b0c97532390dd698a66a.webm?t=1752482619\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3715770/extras/53ca85e6d161b0c97532390dd698a66a.mp4?t=1752482619\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" >\ud83d\udee1\ufe0f <strong>Survival Mode</strong> </p><p class=\"bb_paragraph\" >A mini-game where you must upgrade your weapons and focus on survival until the boss arrives.</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3715770/extras/2ac40808e0ecdf866b531d138795ddca.poster.avif?t=1752482619\" width=600 height=338 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3715770/extras/2ac40808e0ecdf866b531d138795ddca.webm?t=1752482619\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3715770/extras/2ac40808e0ecdf866b531d138795ddca.mp4?t=1752482619\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" >0-Robot! Let's go! \ud83d\ude80</p><p class=\"bb_paragraph\" ></p>",
