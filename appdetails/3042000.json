ne poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3042000/extras/0e7afe9442437d74c7b78f1610edca0e.poster.avif?t=1752855575\" width=616 height=150 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3042000/extras/0e7afe9442437d74c7b78f1610edca0e.webm?t=1752855575\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3042000/extras/0e7afe9442437d74c7b78f1610edca0e.mp4?t=1752855575\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><strong>\u00a0Built for Bragging Rights</strong></p><p class=\"bb_paragraph\" >Clip your dragon kills. Show off your perfect boss run. Every moment is highlight-reel worthy-\u00a0<strong>and your timeline is watching.</strong></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><strong>Welcome to the past. Locked. Loaded. Unleashed.</strong> </p>",
