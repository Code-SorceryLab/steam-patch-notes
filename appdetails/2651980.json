f8ab132fee455927ea.webm?t=1728773788\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2651980/extras/ba91be51dc1185f8ab132fee455927ea.mp4?t=1728773788\" type=\"video/mp4\"></video></span>",
