dcf68e98d82e30645d6b9abeaac6.poster.avif?t=1729086101\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1066390/extras/750cdcf68e98d82e30645d6b9abeaac6.webm?t=1729086101\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1066390/extras/750cdcf68e98d82e30645d6b9abeaac6.mp4?t=1729086101\" type=\"video/mp4\"></video></div>",
