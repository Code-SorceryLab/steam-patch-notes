f6e</strong>\uff1a\u4e3b\u754c\u9762\u53f3\u4e0b\u65b9\u529f\u80fd\u533a\u57df\u3002</p></li><li><p class=\"bb_paragraph\" ><strong>\u6838\u5fc3\u73a9\u6cd5</strong>\uff1a</p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>\u6731\u96c0/\u7384\u6b66\u88c5\u5907</strong>\uff1a\u96c6\u9f50\u4e03\u5bbf\u6fc0\u6d3b\u5171\u9e23\u6280\u80fd\uff08\u5982\u6731\u96c0\u4e4b\u4e3b\u65bd\u52a0\u201c\u79bb\u706b\u201d\u72b6\u6001\uff0c\u7384\u6b66\u63d0\u5347\u9632\u5fa1\uff09\u3002</p></li><li><p class=\"bb_paragraph\" ><strong>\u7b26\u6587\u5f3a\u5316</strong>\uff1a\u88c5\u914d\u7b26\u6587\u89e3\u9501\u95ea\u907f\u3001\u514d\u4f24\u7b49\u7279\u6b8a\u5c5e\u6027\u3002</p></li></ul></li></ul><p class=\"bb_paragraph\" ><strong>\u2463 \u5b98\u804c\u7cfb\u7edf</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>\u5165\u53e3\u4f4d\u7f6e</strong>\uff1a\u4e3b\u754c\u9762\u53f3\u4e0b\u65b9\u529f\u80fd\u533a\u57df\u3002</p></li><li><p class=\"bb_paragraph\" ><strong>\u6838\u5fc3\u673a\u5236</strong>\uff1a</p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u5b8c\u6210\u5b98\u804c\u4efb\u52a1\u2192\u79ef\u7d2f\u653f\u7ee9\u2192\u664b\u5347\u5b98\u9636\u2192\u9886\u53d6\u79f0\u53f7\u4e0e\u4ff8\u7984\u3002</p></li><li><p class=\"bb_paragraph\" >\u524d\u671f\u4f18\u5148\u63a8\u8350\uff0c\u52a9\u529b\u5feb\u901f\u6210\u957f\u3002</p></li></ul></li></ul><p class=\"bb_paragraph\" ><strong>\u2464 \u5e2e\u6d3e\u7cfb\u7edf</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>\u5165\u53e3\u4f4d\u7f6e</strong>\uff1a\u4e3b\u754c\u9762\u53f3\u4e0b\u65b9\u529f\u80fd\u533a\u57df\u3002</p></li><li><p class=\"bb_paragraph\" ><strong>\u6838\u5fc3\u529f\u80fd</strong>\uff1a</p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u521b\u5efa/\u52a0\u5165\u5e2e\u6d3e\uff0c\u53c2\u4e0e\u6350\u732e\u3001\u5efa\u8bbe\u3001\u6311\u6218\uff08\u5982\u83b7\u53d6\u56db\u8c61\u5723\u88c5\uff09\u3002</p></li><li><p class=\"bb_paragraph\" >\u5e2e\u6d3e\u6280\u80fd\u5347\u