    "about_the_game": "<h2 class=\"bb_tag\" ><strong>\u300a\u5343\u519b\u7eb5\u6a2a\u300b\u6e38\u620f\u6982\u8ff0</strong></h2><p class=\"bb_paragraph\" >\u300a\u5343\u519b\u7eb5\u6a2a\u300b\u662f\u4e00\u6b3e\u4ee5\u4ed9\u9b54\u5927\u6218\u540e\u7684\u4e09\u56fd\u4e16\u754c\u4e3a\u80cc\u666f\u7684MMORPG\u6e38\u620f\u3002\u73a9\u5bb6\u5c06\u626e\u6f14\u7eb5\u6a2a\u5927\u9646\u7684\u5192\u9669\u8005\uff0c\u4e0e\u4e09\u56fd\u540d\u5c06\u5e76\u80a9\u4f5c\u6218\uff0c\u4f53\u9a8c\u7b56\u7565\u517b\u6210\u3001\u6218\u6597\u6311\u6218\u3001\u793e\u4ea4\u534f\u4f5c\u7b49\u591a\u5143\u73a9\u6cd5\u3002\u6e38\u620f\u901a\u8fc7\u4e30\u5bcc\u7684\u7cfb\u7edf\u8bbe\u8ba1\uff08\u5982\u5408\u6210\u3001\u56db\u8c61\u3001\u5b98\u804c\u3001\u5e2e\u6d3e\uff09\u548c\u6df1\u5ea6\u4ed8\u8d39\u5f15\u5bfc\u673a\u5236\uff0c\u4e3a\u73a9\u5bb6\u63d0\u4f9b\u6c89\u6d78\u5f0f\u7684\u6210\u957f\u4f53\u9a8c\u3002</p><h2 class=\"bb_tag\" ><strong>\u6838\u5fc3\u73a9\u6cd5\u4e0e\u7cfb\u7edf\u4ecb\u7ecd</strong></h2><h2 class=\"bb_tag\" ><strong>1. \u6e38\u620f\u80cc\u666f</strong></h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u4e16\u754c\u8bbe\u5b9a\uff1a\u4ed9\u9b54\u5927\u6218\u540e\uff0c\u795e\u5668\u548c\u5723\u5730\u6563\u843d\u4eba\u95f4\uff0c\u4e09\u56fd\u82f1\u96c4\u5d1b\u8d77\uff0c\u73a9\u5bb6\u9700\u5728\u4e07\u57df\u57ce\u5f00\u542f\u5f81\u7a0b\uff0c\u4e89\u593a\u8d44\u6e90\u3001\u63d0\u5347\u5b9e\u529b\uff0c\u6210\u4e3a\u5927\u9646\u7684\u9738\u4e3b\u3002</p></li><li><p class=\"bb_paragraph\" >\u7279\u8272\u878d\u5408\uff1a\u4e09\u56fd\u5386\u53f2\u4e0e\u4ed9\u9b54\u5e7b\u60f3\u7ed3\u5408\uff0c\u5267\u60c5\u4e2d\u878d\u5165\u795e\u5175\u3001\u6cd5\u76f8\u7b49\u5947\u5e7b\u5143\u7d20\u3002</p></li></ul><h2 class=\"bb_tag\" ><strong>2. \u5173\u952e\u7cfb\u7edf</strong></h2><p class=\"bb_paragraph\" ><strong>\u2460 \u653b\u7565\u7cfb\u7edf</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>\u529f\u80fd\u5165\u53e3</strong>\uff1a\u6218\u529b\u53f3\u4fa7\u663e\u773c\u4f4d\u7f6e\uff0c\u5f00\u670d7\u5929\u540e\u5173\u95ed\uff0c\u5e76\u5165\u65e5\u5e38\u6d3b\u52a8\u3002</p></li><li><p class=\"bb_paragraph\" ><strong>\u6838\u5fc3\u5185\u5bb9</strong>\uff1a</p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>\u5206\u7c7b\u653b\u7565</strong>\uff1a\u571f\u8c6a\u3001\u5c0f\u8d44\u3001\u5e73\u6c11\u3001\u795e\u8c6a\u73a9\u5bb6\u4e13\u5c5e\u7b56\u7565\uff0c\u63d0\u4f9b\u5145\u503c\u5f15\u5bfc\u548c\u8d44\u6e90\u5206\u914d\u5efa\u8bae\u3002</p></li><li><p class=\"bb_paragraph\" ><strong>\u5956\u52b1\u673a\u5236</strong>\uff1a\u6839\u636e\u653b\u7565\u5b8c\u6210\u5ea6\u9886\u53d6\u9053\u5177\uff08\u5982\u5438\u8840\u6b66\u5668\u201c\u65b9\u5929\u753b\u621f\u201d\uff09\uff0c\u4f18\u5316\u4ed8\u8d39\u73a9\u5bb6\u4f53\u9a8c\u3002</p></li><li><p class=\"bb_paragraph\" ><strong>\u754c\u9762\u8bbe\u8ba1</strong>\uff1a\u5206\u9875\u7b7e\u5c55\u793a\u201c\u9738\u670d\u6307\u5357\u201d\u201c\u795e\u5175\u5229\u5668\u201d\u7b49\u6a21\u5757\uff0c\u652f\u6301\u6587\u672c\u8df3\u8f6c\u548c\u6eda\u52a8\u67e5\u770b\u3002</p></li></ul></li></ul><p class=\"bb_paragraph\" ><strong>\u2461 \u5408\u6210\u7cfb\u7edf</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>\u5165\u53e3\u4f4d\u7f6e</strong>\uff1a\u4e3b\u754c\u9762\u53f3\u4e0b\u65b9\u529f\u80fd\u533a\u57df\u3002</p></li><li><p class=\"bb_paragraph\" ><strong>\u6838\u5fc3\u529f\u80fd</strong>\uff1a</p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u88c5\u5907\u5408\u6210\uff1a\u4f4e\u7ea7\u88c5\u5907+\u6750\u6599\u2192\u9ad8\u7ea7\u6218\u88c5\u3001\u751f\u8096\u88c5\u5907\u3002</p></li><li><p class=\"bb_paragraph\" >\u795e\u88c5/\u6cd5\u76f8\u5408\u6210\uff1a\u4e13\u5c5e\u754c\u9762\u5408\u6210\u795e\u6b66\u5e1d\u88c5\u3001\u4f9b\u5949\u6cd5\u76f8\u7b49\u9876\u7ea7\u88c5\u5907\u3002</p></li></ul></li></ul><p class=\"bb_paragraph\" ><strong>\u2462 \u56db\u8c61\u7cfb\u7edf</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>\u5165\u53e3\u4f4d\u7f6e</strong>\uff1a\u4e3b\u754c\u9762\u53f3\u4e0b\u65b9\u529f\u80fd\u533a\u57df\u3002</p></li><li><p class=\"bb_paragraph\" ><strong>\u6838\u5fc3\u73a9\u6cd5</strong>\uff1a</p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>\u6731\u96c0/\u7384\u6b66\u88c5\u5907</strong>\uff1a\u96c6\u9f50\u4e03\u5bbf\u6fc0\u6d3b\u5171\u9e23\u6280\u80fd\uff08\u5982\u6731\u96c0\u4e4b\u4e3b\u65bd\u52a0\u201c\u79bb\u706b\u201d\u72b6\u6001\uff0c\u7384\u6b66\u63d0\u5347\u9632\u5fa1\uff09\u3002</p></li><li><p class=\"bb_paragraph\" ><strong>\u7b26\u6587\u5f3a\u5316</strong>\uff1a\u88c5\u914d\u7b26\u6587\u89e3\u9501\u95ea\u907f\u3001\u514d\u4f24\u7b49\u7279\u6b8a\u5c5e\u6027\u3002</p></li></ul></li></ul><p class=\"bb_paragraph\" ><strong>\u2463 \u5b98\u804c\u7cfb\u7edf</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>\u5165\u53e3\u4f4d\u7f6e</strong>\uff1a\u4e3b\u754c\u9762\u53f3\u4e0b\u65b9\u529f\u80fd\u533a\u57df\u3002</p></li><li><p class=\"bb_paragraph\" ><strong>\u6838\u5fc3\u673a\u5236</strong>\uff1a</p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u5b8c\u6210\u5b98\u804c\u4efb\u52a1\u2192\u79ef\u7d2f\u653f\u7ee9\u2192\u664b\u5347\u5b98\u9636\u2192\u9886\u53d6\u79f0\u53f7\u4e0e\u4ff8\u7984\u3002</p></li><li><p class=\"bb_paragraph\" >\u524d\u671f\u4f18\u5148\u63a8\u8350\uff0c\u52a9\u529b\u5feb\u901f\u6210\u957f\u3002</p></li></ul></li></ul><p class=\"bb_paragraph\" ><strong>\u2464 \u5e2e\u6d3e\u7cfb\u7edf</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>\u5165\u53e3\u4f4d\u7f6e</strong>\uff1a\u4e3b\u754c\u9762\u53f3\u4e0b\u65b9\u529f\u80fd\u533a\u57df\u3002</p></li><li><p class=\"bb_paragraph\" ><strong>\u6838\u5fc3\u529f\u80fd</strong>\uff1a</p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u521b\u5efa/\u52a0\u5165\u5e2e\u6d3e\uff0c\u53c2\u4e0e\u6350\u732e\u3001\u5efa\u8bbe\u3001\u6311\u6218\uff08\u5982\u83b7\u53d6\u56db\u8c61\u5723\u88c5\uff09\u3002</p></li><li><p class=\"bb_paragraph\" >\u5e2e\u6d3e\u6280\u80fd\u5347\u7ea7\u3001\u4ed3\u5e93\u5171\u4eab\uff0c\u5f3a\u5316\u793e\u4ea4\u534f\u4f5c\u3002</p></li></ul></li></ul><p class=\"bb_paragraph\" ><strong>\u2465 \u6253\u91d1\u5b9d\u5e93</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>\u5165\u53e3\u4f4d\u7f6e</strong>\uff1a\u4e3b\u754c\u9762\u53f3\u4e0a\u65b9\u6d3b\u52a8\u533a\u57df\u3002</p></li><li><p class=\"bb_paragraph\" ><strong>\u6838\u5fc3\u73a9\u6cd5</strong>\uff1a</p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u91ce\u5916\u5730\u56fe\u6311\u6218\u5404\u7b49\u7ea7BOSS\uff0c\u51fb\u6740\u540e\u9886\u53d6\u5143\u5b9d\u3001\u88c5\u5907\u7b49\u5956\u52b1\u3002</p></li><li><p class=\"bb_paragraph\" >\u4e0e\u4efb\u52a1\u7cfb\u7edf\u8054\u52a8\uff0c\u63d0\u5347\u8d44\u6e90\u83b7\u53d6\u6548\u7387\u3002</p></li></ul></li></ul><p class=\"bb_paragraph\" ><strong>\u2466 \u65e5\u5e38\u6d3b\u52a8</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>\u5165\u53e3\u4f4d\u7f6e</strong>\uff1a\u4e3b\u754c\u9762\u53f3\u4e0a\u65b9\u6d3b\u52a8\u533a\u57df\u3002</p></li><li><p class=\"bb_paragraph\" ><strong>\u6838\u5fc3\u6d3b\u52a8</strong>\uff1a</p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>\u9650\u65f6\u73a9\u6cd5</strong>\uff1a\u4e16\u754cBOSS\u3001\u8de8\u670d\u9635\u8425\u6218\u3001\u53cc\u500d\u62a4\u9001\uff08\u5143\u5b9d\u5956\u52b1\uff09\u3002</p></li><li><p class=\"bb_paragraph\" ><strong>\u526f\u672c\u6311\u6218</strong>\uff1a\u4e5d\u91cd\u8bd5\u70bc\uff08\u722c\u5854\uff09\u3001\u56db\u8c61\u79d8\u5883\uff08\u6750\u6599\u83b7\u53d6\uff09\u3002</p></li><li><p class=\"bb_paragraph\" ><strong>\u65e5\u5386\u6574\u5408</strong>\uff1a\u6d3b\u52a8\u65f6\u95f4\u8868\u6e05\u6670\u5c55\u793a\uff0c\u907f\u514d\u9519\u8fc7\u9ad8\u6536\u76ca\u73a9\u6cd5\u3002</p></li></ul></li></ul><h2 class=\"bb_tag\" ><strong>\u6e38\u620f\u7279\u8272\u603b\u7ed3</strong></h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>\u7b56\u7565\u4ed8\u8d39\u5f15\u5bfc</strong>\uff1a\u5206\u9636\u653b\u7565\u7cbe\u51c6\u9002\u914d\u73a9\u5bb6\u6d88\u8d39\u5c42\u7ea7\uff0c\u4f18\u5316\u4ed8\u8d39\u4f53\u9a8c\u3002</p></li><li><p class=\"bb_paragraph\" ><strong>\u6df1\u5ea6\u517b\u6210\u4f53\u7cfb</strong>\uff1a\u5408\u6210\u3001\u56db\u8c61\u3001\u5b98\u804c\u7b49\u591a\u7cfb\u7edf\u4ea4\u53c9\uff0c\u63d0\u4f9b\u957f\u671f\u6210\u957f\u76ee\u6807\u3002</p></li><li><p class=\"bb_paragraph\" ><strong>\u793e\u4ea4\u534f\u4f5c</strong>\uff1a\u5e2e\u6d3e\u6311\u6218\u3001\u4ed3\u5e93\u5171\u4eab\u589e\u5f3a\u73a9\u5bb6\u4e92\u52a8\u3002</p></li><li><p class=\"bb_paragraph\" ><strong>\u9ad8\u81ea\u7531\u5ea6\u6218\u6597</strong>\uff1a\u6253\u91d1\u5b9d\u5e93\u3001\u65e5\u5e38\u6d3b\u52a8\u6ee1\u8db3\u4e0d\u540c\u6218\u6597\u504f\u597d\uff08PVE/PVP\uff09\u3002</p></li></ul><p class=\"bb_paragraph\" > </p>",
