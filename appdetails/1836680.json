    "required_age": 0,
    "is_free": false,
    "detailed_description": "<p class=\"bb_paragraph\"><div class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1836680/extras/4f2609dbd7d3528a08d3c828e11e7787.poster.avif?t=1741646536\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1836680/extras/4f2609dbd7d3528a08d3c828e11e7787.webm?t=1741646536\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1836680/extras/4f2609dbd7d3528a08d3c828e11e7787.mp4?t=1741646536\" type=\"video/mp4\"></video></div></p><p class=\"bb_paragraph\"></p><p class=\"bb_paragraph\">Slidetracked is a minimalist puzzle game where you have to draw paths to make a pair of critters reach their goal without getting in the way of each other. It starts out as simple as it looks, but gets challenging as you dig deeper into the subtelties and consequences of the mechanics.</p><p class=\"bb_paragraph\"></p><h2 class=\"bb_tag\">Features</h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\"> </p><p class=\"bb_paragraph\">A unique simultaneous sliding movement mechanic</p></li><li><p class=\"bb_paragraph\">Discover and get challenged on your understanding of the critters' movement rules</p></li><li><p class=\"bb_paragraph\">Skip levels when you get stuck thanks to branching level selection</p></li><li><p class=\"bb_paragraph\"> Minimalist graphics and smooth animations</p></li><li><p class=\"bb_paragraph\">A dark mode for relaxed late night puzzling</p></li></ul><p class=\"bb_paragraph\"></p><p class=\"bb_paragraph\"></p><p class=\"bb_paragraph\"><div class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1836680/extras/0893a68bf37f9f2f612c6fe06324bd37.poster.avif?t=1741646536\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1836680/extras/0893a68bf37f9f2f612c6fe06324bd37.webm?t=1741646536\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1836680/extras/0893a68bf37f9f2f612c6fe06324bd37.mp4?t=1741646536\" type=\"video/mp4\"></video></div></p>",
    "about_the_game": "<p class=\"bb_paragraph\"><div class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1836680/extras/4f2609dbd7d3528a08d3c828e11e7787.poster.avif?t=1741646536\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1836680/extras/4f2609dbd7d3528a08d3c828e11e7787.webm?t=1741646536\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1836680/extras/4f2609dbd7d3528a08d3c828e11e7787.mp4?t=1741646536\" type=\"video/mp4\"></video></div></p><p class=\"bb_paragraph\"></p><p class=\"bb_paragraph\">Slidetracked is a minimalist puzzle game where you have to draw paths to make a pair of critters reach their goal without getting in the way of each other. It starts out as simple as it looks, but gets challenging as you dig deeper into the subtelties and consequences of the mechanics.</p><p class=\"bb_paragraph\"></p><h2 class=\"bb_tag\">Features</h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\"> </p><p class=\"bb_paragraph\">A unique simultaneous sliding movement mechanic</p></li><li><p class=\"bb_paragraph\">Discover and get challenged on your understanding of the critters' movement rules</p></li><li><p class=\"bb_paragraph\">Skip levels when you get stuck thanks to branching level selection</p></li><li><p class=\"bb_paragraph\"> Minimalist graphics and smooth animations</p></li><li><p class=\"bb_paragraph\">A dark mode for relaxed late night puzzling</p></li></ul><p class=\"bb_paragraph\"></p><p class=\"bb_paragraph\"></p><p class=\"bb_paragraph\"><div class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1836680/extras/0893a68bf37f9f2f612c6fe06324bd37.poster.avif?t=1741646536\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1836680/extras/0893a68bf37f9f2f612c6fe06324bd37.webm?t=1741646536\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1836680/extras/0893a68bf37f9f2f612c6fe06324bd37.mp4?t=1741646536\" type=\"video/mp4\"></video></div></p>",
