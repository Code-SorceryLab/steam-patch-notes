2014740/extras/91a1b99d899adf77c028cfdb057f9c4f.webm?t=1700754722\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2014740/extras/91a1b99d899adf77c028cfdb057f9c4f.mp4?t=1700754722\" type=\"video/mp4\"></video></div><br><br><br><strong>5. Completing the campaign unlocks and infinite challenge mode, with more random events and stronger enemies.\u3010For gamers who relish a challenge\u3011</strong><br><div class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2014740/extras/8f3928cf75a98f7dacb0aed2df701c16.poster.avif?t=1700754722\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2014740/extras/8f3928cf75a98f7dacb0aed2df701c16.webm?t=1700754722\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2014740/extras/8f3928cf75a98f7dacb0aed2df701c16.mp4?t=1700754722\" type=\"video/mp4\"></video></div><br><br><br><strong>6. Take cover using the rich and varied environments, but watch out! Some of them can be destroyed...</strong><br><div class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2014740/extras/05b1aa29599cca68c7010c2400ca7802.poster.avif?t=1700754722\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2014740/extras/05b1aa29599cca68c7010c2400ca7802.webm?t=1700754722\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2014740/extras/05b1aa29599cca68c7010c2400ca7802.mp4?t=1700754722\" type=\"video/mp4\"></video></div>",
