ared.akamai.steamstatic.com/store_item_assets/steam/apps/3828420/extras/be32c1cdbb9a64d3a007dd13f4ff5738.poster.avif?t=1750555498\" width=800 height=450 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3828420/extras/be32c1cdbb9a64d3a007dd13f4ff5738.webm?t=1750555498\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3828420/extras/be32c1cdbb9a64d3a007dd13f4ff5738.mp4?t=1750555498\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><strong>Start a new adventure!</strong></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3828420/extras/2c3ad52d2fb54341bb777689d79a9633.poster.avif?t=1750555498\" width=800 height=450 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3828420/extras/2c3ad52d2fb54341bb777689d79a9633.webm?t=1750555498\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3828420/extras/2c3ad52d2fb54341bb777689d79a9633.mp4?t=1750555498\" type=\"video/mp4\"></video></span></p>",
