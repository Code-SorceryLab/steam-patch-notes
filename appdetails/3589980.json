    "about_the_game": "<p class=\"bb_paragraph\" ></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u5267\u60c5\u4ecb\u7ecd\uff1a</p></li></ul><p class=\"bb_paragraph\" >\u521d\u5165\u5927\u5b66\u6821\u56ed\u7684\u53f6\u4e91\u751f\uff0c\u5728\u81ea\u5df1\u4f4f\u7684\u51fa\u79df\u5c4b\u5355\u5143\u95e8\u53e3\uff0c\u5076\u9047\u4e86\u5b66\u751f\u4f1a\u6d3b\u52a8\u7b56\u5212\u90e8\u7684\u90e8\u957f\u82b1\u66ae\u96ea\u3002\u66f4\u5de7\u7684\u662f\uff0c\u81ea\u5df1\u4f4f\u7684\u51fa\u79df\u5c4b\u6b63\u5728\u82b1\u66ae\u96ea\u7684\u9694\u58c1\u3002\u53c8\u5728\u5404\u79cd\u673a\u9047\u4e0e\u5de7\u5408\u4e4b\u4e0b\uff0c\u52a0\u5165\u5b66\u751f\u4f1a\u6d3b\u52a8\u573a\u7b56\u5212\u90e8\uff0c\u6210\u4e3a\u4e86\u82b1\u66ae\u96ea\u624b\u4e0b\u7684\u5f97\u529b\u5e72\u5c06\u3002 </p><p class=\"bb_paragraph\" >                                                                            \u53ef\u4e00\u76f4\u6709\u4e00\u4e2a\u95ee\u9898\u56f0\u6270\u7740\u53f6\u4e91\u751f\uff1a\u4e3a\u4ec0\u4e48\u82b1\u66ae\u96ea\u7684\u58f0\u97f3\uff0c\u90a3\u4e48\u50cf\u81ea\u5df1\u542c\u7684\u97f3\u58f0up\u201c\u96ea\u82b1yuki\u201d\u2026\u2026</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\u89d2\u8272\u4ecb\u7ecd\uff1a</p><p class=\"bb_paragraph\" >\u82b1\u66ae\u96ea\u00a0</p><p class=\"bb_paragraph\" >cv\uff1a\u95f2\u8e0f\u68a7\u6850</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3589980/extras/80c9100bf5435690bf42b78b89db64a1.avif?t=1747816017\" data-has-big width=800 height=1741 /></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\u4f4f\u5728\u7537\u4e3b\u9694\u58c1\u7684\u76f4\u7cfb\u5b66\u59d0\uff0c\u540c\u65f6\u4e5f\u662f\u6821\u5b66\u751f\u4f1a\u6d3b\u52a8\u7b56\u5212\u90e8\u7684\u90e8\u957f\u3002\u6bd4\u8f83\u81ea\u6765\u719f\uff0c\u5bf9\u8eab\u8fb9\u7684\u4eba\u5f88\u70ed\u60c5\u3002\