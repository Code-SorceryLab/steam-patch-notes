nd.<br><div class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1859940/extras/6bfeaf9bda533aebb79b8e3744fbc428.poster.avif?t=1692407063\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1859940/extras/6bfeaf9bda533aebb79b8e3744fbc428.webm?t=1692407063\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1859940/extras/6bfeaf9bda533aebb79b8e3744fbc428.mp4?t=1692407063\" type=\"video/mp4\"></video></div>",
