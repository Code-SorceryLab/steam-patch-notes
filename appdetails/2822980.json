tatic.com/store_item_assets/steam/apps/2822980/extras/095aac5187357990578522745e3b1654.mp4?t=1753320416\" type=\"video/mp4\"></video></span></p><h2 class=\"bb_tag\" >3 POSSIBLE ENDINGS</h2><p class=\"bb_paragraph\" >Each ending has a <strong><i>unique title screen</i></strong>, revealing a deeper story to the game.</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2822980/extras/15dc423b0e75adb2c665e4b3cf0dda26.poster.avif?t=1753320416\" width=600 height=200 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2822980/extras/15dc423b0e75adb2c665e4b3cf0dda26.webm?t=1753320416\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2822980/extras/15dc423b0e75adb2c665e4b3cf0dda26.mp4?t=1753320416\" type=\"video/mp4\"></video></span></p>",
