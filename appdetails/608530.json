mstatic.com/store_item_assets/steam/apps/608530/extras/2eb6024c2bdf611cf40570ee3b9e2261.webm?t=1514495770\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/608530/extras/2eb6024c2bdf611cf40570ee3b9e2261.mp4?t=1514495770\" type=\"video/mp4\"></video></div><br><br><div class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/608530/extras/5f5f96754a325b8b9fc109178a3516af.webp?t=1514495770\" /></div>",
