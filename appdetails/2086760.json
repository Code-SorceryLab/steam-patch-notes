64319b02220b7b0c09497ec248bbc.poster.avif?t=1754052679\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2086760/extras/89c64319b02220b7b0c09497ec248bbc.webm?t=1754052679\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2086760/extras/89c64319b02220b7b0c09497ec248bbc.mp4?t=1754052679\" type=\"video/mp4\"></video></div><br><br><div class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2086760/extras/f294b46e060a0a54f9cdc72cb9821911.webp?t=1754052679\" /></div> Experience an atmospheric noir-inspired world with unique visuals and a classic noir style with a modern twist. Combined with some smooth jazz to place you in the zone of Quatros Noir.",
