    "about_the_game": "<h2 class=\"bb_tag\" ><strong>DEMO\u300c\u5c01\u795e\u6d4b\u8bd5\u300d\u6b63\u5728\u8fdb\u884c\u4e2d\uff01\u672c\u6b21\u6d4b\u8bd5\u4e2d\uff0c\u60a8\u5c06\u4f53\u9a8c\u5230\uff1a</strong></h2><h2 class=\"bb_tag\" ><strong>\u5c01\u795e\u4e71\u6597\uff0c\u7834\u9664\u5e38\u89c4</strong></h2><p class=\"bb_paragraph\" >\u9009\u4eba\u9650\u5236\uff1f\u6240\u6709\u82f1\u96c4\u5168\u9762\u5f00\u653e\uff0c\u82b1\u5f0f\u5957\u8def\u6c42\u4f60\u5f00\u53d1\uff01</p><p class=\"bb_paragraph\" >\u5fc5\u987b\u8865\u4f4d\uff1f\u4e0d\u5b58\u5728\uff01\u539f\u5730\u6253\u5750\u56de\u8840\uff0c\u591a\u79cd\u6b66\u5668\u9632\u5177\u968f\u65f6\u66f4\u6362\uff0c\u591a\u79cd\u6218\u6597\u9053\u5177\u8f85\u52a9\u6218\u6597\uff0c\u4f60\u4e00\u4e2a\u4eba\u5c31\u662f\u4e00\u652f\u6218\u961f\uff01</p><p class=\"bb_paragraph\" >\u9634\u9669\u5835\u8def\uff1f\u4e0d\u53ef\u80fd\uff01\u539f\u5730\u8d77\u98de~~\u4fa6\u5bdf\uff0c\u7ed5\u540e\uff0c\u8dd1\u8def\uff0c\u961f\u53cb\u6218\u672f\u53d8\u66f4\u592a\u5feb\uff0c\u8bf7\u6ce8\u610f\u4e0d\u8981\u6389\u961f\uff01</p><h2 class=\"bb_tag\" ><strong>\u5957\u8def\u591a\u53d8\uff0c\u6c38\u8fdc\u65b0\u9c9c</strong></h2><p class=\"bb_paragraph\" >\u73a9\u6cd5\u56fa\u5b9a\uff1f\u6bcf\u5c40\u4eba\u6570\u4e0d\u56fa\u5b9a\uff0c\u88c5\u5907\u62fe\u53d6\u968f\u673a\uff0c\u7f29\u5708\u4f4d\u7f6e\u968f\u673a\uff0c\u6bcf\u4e00\u5c40\u90fd\u662f\u65b0\u7684\u4f53\u9a8c\uff01</p><p class=\"bb_paragraph\" >\u7075\u58eb\u6280\u80fd\uff0c\u6b66\u5668\u6280\u80fd\uff0c\u9632\u5177\u6548\u679c\uff0c\u4f7f\u7528\u9053\u5177\uff0c\u914d\u7f6e\u9635\u6cd5\uff0c\u643a\u5e26\u6cd5\u5b9d\uff0c\u591a\u79cd\u7b56\u7565\u7ef4\u5ea6\uff0c\u4f60\u53ef\u4ee5\u4e0d\u53d8\uff0c\u4f46\u654c\u4eba\u6c38\u8fdc\u5728\u53d8\uff01</p><h2 class=\"bb_tag\" ><strong>\u5339\u914d\u79d2\u5f00\uff0c\u52a8\u6001\u6218\u6597</strong></h2><p class=\"bb_paragraph\" >\u5339\u914d\u8fc7\u4e45\uff1f\u6e38\u620f\u5339\u914d\u5141\u8bb8\u4f17\u9053\u53cb\u4e2d\u9014\u52a0\u5165\u5bf9\u5c40\uff0c\u5e76\u83b7\u5f97\u5bf9\u5e94\u7b49\u7ea7\u8865\u507f\uff0c\u62fe\u53d6\u5176\u4ed6\u9053\u53cb\u5728\u6218\u4ea1\u540e\u7559\u4e0b\u7684\u4e30\u76db\u7684\u5305\u88f9\u6216\u8005\u5f97\u5230\u961f\u53cb\u7684\u8d44\u52a9\uff0c\u4e5f\u6709\u673a\u4f1a\u6253\u8fdb\u51b3\u6218\uff0c\u699c\u4e0a\u5c01\u795e\uff0c\u8089\u8eab\u6210\u5723\uff01</p><p class=\"bb_paragraph\" >\u5bf9\u5c40\u524d\u671f\u4eba\u6570\u968f\u65f6\u8865\u5145\uff0c\u795e\u5175\u5929\u964d\uff0c\u4e0d\u6218\u81f3\u6700\u540e\u4e00\u523b\uff0c\u80dc\u8d1f\u96be\u6599\uff0c\u4eba\u5c11\u6218\u6597\u5956\u52b1\u591a\uff0c\u4eba\u591a\u6218\u6597\u5feb\u4e50\u8db3\uff01</p><h2 class=\"bb_tag\" ><strong>\u5feb\u901f\u4e0a\u624b\uff0c\u4fdd\u9001\u5c01\u795e</strong></h2><p class=\"bb_paragraph\" >\u6015\u5751\u961f\u53cb\uff1f\u6d1e\u5e9c\u7ec3\u4e60\u5723\u5730\u3010\u8bd5\u5251\u5d16\u3011\u4f9b\u5404\u4f4d\u9053\u53cb\u94bb\u7814\u6b66\u5668\u9632\u5177\uff0c\u642d\u914d\u6700\u5f3a\u51fa\u88c5\u7ec4\u5408\uff01</p><p class=\"bb_paragraph\" >\u66f4\u6709\u3010\u4ed9\u9014\u6307\u5357\u3011\u5168\u9762\u89e3\u6790\u5730\u56fe\u5143\u7d20\u3001\u573a\u666f\u673a\u5236\u7b49\uff0c\u63d0\u524d\u7814\u8bfb\uff0c\u5982\u6709\u795e\u52a9\uff01</p><h2 class=\"bb_tag\" ><strong>\u573a\u5916\u63f4\u52a9\uff0c\u4fdd\u9a7e\u62a4\u822a</strong></h2><p class=\"bb_paragraph\" >\u51faBUG\u4e86\uff1f\u8bf7\u901a\u8fc7\u6e38\u620f\u5185\u7684\u3010ESC\u3011\u2192\u3010\u5ba2\u670d\u3011\u2192\u3010\u70b9\u6b64\u63d0\u5355\u3011\u63d0\u4ea4\u5de5\u5355\u8054\u7cfb\u6211\u4eec\u3002</p><p class=\"bb_paragraph\" >\u6ca1\u4eba\u4ea4\u6d41\uff1f<strong>\u300a\u51b3\u6218\u5c01\u795e\u699c\u300b\u6d4b\u8bd5\u4ea4\u6d41QQ\u7fa4\uff1a751337042</strong>\uff0c\u804a\u5929\u5439\u6c34\uff0c\u7ec4\u961f\u5f00\u9ed1\uff01</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><i>*\u56e0\u5f53\u524d\u6e38\u620f\u4ecd\u5904\u4e8e\u7814\u53d1\u6253\u78e8\u9636\u6bb5\uff0c\u4f46\u6d4b\u8bd5\u671f\u95f4\u6211\u4eec\u8fd8\u4f1a\u6301\u7eed\u66f4\u65b0\uff0c\u656c\u8bf7\u671f\u5f85~</i></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><strong>\u7531\u4e8e\u6e38\u620f\u4ecd\u5904\u4e8e\u65e9\u671f\u7814\u53d1\u6253\u78e8\u9636\u6bb5\uff0c\u5f53\u524d\u7684UI\u3001\u7279\u6548\u3001\u89d2\u8272\u52a8\u4f5c\u3001\u7f8e\u672f\u8d44\u6e90\u7b49\u5e76\u975e\u6700\u7ec8\u6548\u679c\uff0c\u5e76\u4e14\u5728\u6280\u672f\u7a33\u5b9a\u6027\u3001\u6570\u503c\u5e73\u8861\u7b49\u65b9\u9762\u90fd\u6709\u5f85\u9a8c\u8bc1\uff0c\u975e\u5e38\u9700\u8981\u66f4\u591a\u7684\u5b9e\u673a\u4f53\u9a8c\u548c\u53cd\u9988\u8fdb\u884c\u73a9\u6cd5\u548c\u6e38\u620f\u7a33\u5b9a\u6027\u9a8c\u8bc1\uff0c\u8bda\u9080\u73a9\u5bb6\u4eec\u53c2\u4e0e\uff01</strong></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" ><strong>\u6e38\u620f\u7279\u8272\u73a9\u6cd5\u4ecb\u7ecd</strong></h2><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2739570/extras/8524fdb4dc55f693757c128e9c52fe2f.avif?t=1754383573\" width=618 height=76 /></span></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline crossorigin=\"anonymous\" poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2739570/extras/0821eec3f10ed161d17f78d3700546f1.poster.avif?t=1754383573\" width=618 height=300 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2739570/extras/0821eec3f10ed161d17f78d3700546f1.webm?t=1754383573\" type=\"video/webm; codecs=vp9\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2739570/extras/70fa8f63b43f7e1927400c726adb74