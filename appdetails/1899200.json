ne poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1899200/extras/62e3917be3467792a637c908a9d58ed3.poster.avif?t=1696105768\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1899200/extras/62e3917be3467792a637c908a9d58ed3.webm?t=1696105768\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1899200/extras/62e3917be3467792a637c908a9d58ed3.mp4?t=1696105768\" type=\"video/mp4\"></video></div>",
