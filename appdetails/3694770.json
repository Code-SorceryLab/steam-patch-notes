3694770/extras/4bdccb5600db7590ce3d298db6a6d4b5.webm?t=1754031751\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3694770/extras/4bdccb5600db7590ce3d298db6a6d4b5.mp4?t=1754031751\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3694770/extras/758b913d62b53e680d8fa86b71ca9561.avif?t=1754031751\" data-has-big width=800 height=132 /></span></p><p class=\"bb_paragraph\" >There are a total of 1000 puzzles across 10 different levels. Combine the pieces and win the reward!</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3694770/extras/3092284bc99d771a004f19983c1ee2b5.poster.avif?t=1754031751\" width=600 height=300 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3694770/extras/3092284bc99d771a004f19983c1ee2b5.webm?t=1754031751\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3694770/extras/3092284bc99d771a004f19983c1ee2b5.mp4?t=1754031751\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3694770/extras/799b9d2179ea51592ffb66d3f90e2a2c.avif?t=1754031751\" data-has-big width=800 height=132 /></span></p><p class=\"bb_paragraph\" >Complete 100 different mazes across 10 levels and win rewards. Race against time to pass the mazes. You can leave directional markers to help yourself. If you enter the same maze again, they will guide you.</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_