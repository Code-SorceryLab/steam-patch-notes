urce src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1357990/extras/4e6d37af8ad8622905b48adaf24b4969.webm?t=1617383043\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1357990/extras/4e6d37af8ad8622905b48adaf24b4969.mp4?t=1617383043\" type=\"video/mp4\"></video></div>",
