    "detailed_description": "<p class=\"bb_paragraph\" ><strong>\u3010\u6e38\u620f\u80cc\u666f\u3011</strong><br>\u6e05\u672b\u4e71\u4e16\uff0c\u6b66\u6797\u76df\u4e3b\u5931\u8e2a\uff0c\u6c5f\u6e56\u4f20\u8a00\u300a\u81f3\u5c0a\u79d8\u7c4d\u300b\u73b0\u4e16\uff0c\u5f15\u5404\u65b9\u52bf\u529b\u8840\u6d17\u6b66\u6797\u3002\u73a9\u5bb6\u626e\u6f14\u9690\u4e16\u95e8\u6d3e\u300c\u65e0\u6781\u5b97\u300d\u672b\u4ee3\u5f1f\u5b50\uff0c\u643a\u9547\u6d3e\u7edd\u5b66\u300c\u516b\u5366\u9635\u56fe\u300d\uff0c\u4e8e\u5c71\u95e8\u8981\u9053\u5e03\u4e0b\u5929\u7f57\u5730\u7f51\uff0c\u4ee5\u529f\u592b\u5965\u4e49\u5b88\u62a4\u6b66\u6797\u6700\u540e\u7684\u51c0\u571f\u3002</p><p class=\"bb_paragraph\" ><strong>\u3010\u6838\u5fc3\u73a9\u6cd5\u3011</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>\u529f\u592b\u5854\u9632\u9769\u65b0</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u878d\u5408\u548f\u6625\u5bf8\u52b2\u3001\u592a\u6781\u56db\u4e24\u62e8\u5343\u65a4\u7b49\u767e\u79cd\u6b66\u5b66\u62db\u5f0f\uff0c\u6bcf\u5ea7\u9632\u5fa1\u5854\u5bf9\u5e94\u4e00\u95e8\u529f\u592b\u6d41\u6d3e\uff08\u4f8b\uff1a\u5c11\u6797\u7f57\u6c49\u5854\u53ef\u53ec\u5524\u5341\u516b\u94dc\u4eba\u9635\uff09</p></li><li><p class=\"bb_paragraph\" >\u654c\u4eba\u643a\u5e26\u300c\u5185\u529b\u503c\u300d\u8bbe\u5b9a\uff0c\u9700\u7528\u7279\u5b9a\u62db\u5f0f\u7834\u62db\uff08\u5982\u7528\u300c\u6cbe\u8863\u5341\u516b\u8dcc\u300d\u5316\u89e3\u8499\u53e4\u6454\u8de4\u624b\u51b2\u950b\uff09</p></li></ul></li><li><p class=\"bb_paragraph\" ><strong>\u52a8\u6001\u6c5f\u6e56\u6218\u573a</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u5730\u56fe\u878d\u5408\u4e94\u884c\u516b\u5366\u673a\u5173\uff1a\u5f15\u96f7\u51fb\u7684\u300c\u96f7\u706b\u53f0\u300d\u3001\u51cf\u901f\u654c\u4eba\u7684\u300c\u6cbc\u6cfd\u7634\u6c14\u9635\u300d</p></li><li><p class=\"bb_paragraph\" >\u663c\u591c\u4ea4\u66ff\u5f71\u54cd\u6218\u5c40\uff1a\u591c\u6218\u9700\u70b9\u71c3\u706b\u628a\u9632\u9690\u5f62\u523a\u5ba2\uff0c\u96e8\u5929\u5219\u589e\u5f3a\u5ce8\u7709\u5251\u6cd5</p></li></ul></li><li><p class=\"bb_paragraph\" ><strong>\u5b97\u5e08\u6210\u957f\u4f53\u7cfb</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u53c2\u609f\u300a\u6613\u7b4b\u7ecf\u300b\u300a\u4e5d\u9634\u771f\u7ecf\u300b\u7b49\u79d8\u7c4d\u89e3\u9501\u7ecf\u8109\u7cfb\u7edf\uff0c\u6c38\u4e45\u5f3a\u5316\u5168\u5854\u5c5e\u6027</p></li><li><p class=\"bb_paragraph\" >\u6536\u96c6\u6b66\u6797\u8f76\u4e8b\u788e\u7247\uff0c\u53ec\u5524\u4f20\u8bf4\u4fa0\u5ba2\u52a9\u6218\uff08\u5982\u9ec4\u98de\u9e3f\u72ee\u5934\u70ae\u3001\u53f6\u95ee\u548f\u6625\u8fde\u73af\u638c\uff09</p></li></ul></li></ul><p class=\"bb_paragraph\" ><strong>\u3010\u89c6\u89c9\u7279\u8272\u3011</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>\u6c34\u58a8\u52a8\u6001\u6e32\u67d3</strong>\uff1a\u653b\u51fb\u7279\u6548\u91c7\u7528\u6cfc\u58a8\u98ce\u683c\uff0c\u592a\u6781\u62f3\u6c14\u5316\u4e3a\u9ed1\u9f99\uff0c\u5f62\u610f\u62f3\u52bf\u5982\u5954\u9a6c</p></li><li><p class=\"bb_paragraph\" ><strong>\u6b66\u4fa0\u97f3\u6548\u7cfb\u7edf</strong>\uff1a\u5175\u5668\u78b0\u649e\u58f0\u7531\u771f\u5b9e\u6b66\u672f\u5f55\u97f3\u91c7\u6837\uff0cBOSS\u51fa\u573a\u81ea\u5e26\u5522\u5450BGM</p></li></ul><p class=\"bb_paragraph\" ><strong>\u3010\u793e\u4ea4\u73a9\u6cd5\u3011</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>\u6b66\u6797\u5927\u4f1a</strong>\uff1a\u6bcf\u5468\u9650\u65f6\u5f00\u542f\u8de8\u670d\u5b97\u6218\uff0c\u524d10\u540d\u5b97\u95e8\u96d5\u50cf\u523b\u5165\u300c\u6b66\u6797\u82f1\u8c6a\u699c\u300d</p></li><li><p class=\"bb_paragraph\" ><strong>\u5e08\u5f92\u7cfb\u7edf</strong>\uff1a\u4f20\u6388\u81ea\u521b\u6b66\u529f\u7ec4\u5408\uff0c\u5f92\u5f1f\u901a\u5173\u540e\u5e08\u7236\u83b7\u300c\u6843\u674e\u6ee1\u5929\u4e0b\u300d\u79f0\u53f7</p></li></ul><p class=\"bb_paragraph\" ><strong>\u3010\u5f00\u53d1\u8005\u5bc4\u8bed\u3011</strong><br>&quot;\u6211\u4eec\u60f3\u8ba9\u73a9\u5bb6\u611f\u53d7\u5230\uff0c\u5854\u9632\u4e0d\u4ec5\u662f\u6570\u503c\u6e38\u620f\uff0c\u66f4\u662f\u6b66\u5b66\u667a\u6167\u7684\u8f83\u91cf\u3002\u6bcf\u4e2a\u5173\u5361\u90fd\u662f\u6c5f\u6e56\u4f20\u8bf4\u2014\u2014\u7528\u6d2a\u62f3\u5bf9\u6297\u4e1c\u701b\u5fcd\u8005\uff0c\u4ee5\u5510\u95e8\u6697\u5668\u7834\u8499\u53e4\u94c1\u9a91\uff0c\u8fd9\u4e0d\u6b62\u662f\u6e38\u620f\uff0c\u66f4\u662f\u5bf9\u4e2d\u56fd\u6b66\u4fa0\u6587\u5316\u7684\u6c89\u6d78\u5f0f\u4f53\u9a8c\u3002&quot;</p><p class=\"bb_paragraph\" ><strong>\u76ee\u6807\u7fa4\u4f53</strong>\uff1a\u5854\u9632\u7b56\u7565\u7231\u597d\u8005\u3001\u6b66\u4fa0\u6587\u5316\u7c89\u4e1d\u3001\u8ffd\u6c42\u9ad8\u7b56\u7565\u6df1\u5ea6\u7684\u73a9\u5bb6<br><strong>\u7279\u8272\u6807\u7b7e</strong>\uff1a#\u6b66\u4fa0\u9ed1\u79d1\u6280 #\u529f\u592b\u8fde\u62db\u5854\u9632 #\u52a8\u6001\u6c5f\u6e56\u6218\u573a</p>",
    "about_the_game": "<p class=\"bb_paragraph\" ><strong>\u3010\u6e38\u620f\u80cc\u666f\u3011</strong><br>\u6e05\u672b\u4e71\u4e16\uff0c\u6b66\u6797\u76df\u4e3b\u5931\u8e2a\uff0c\u6c5f\u6e56\u4f20\u8a00\u300a\u81f3\u5c0a\u79d8\u7c4d\u300b\u73b0\u4e16\uff0c\u5f15\u5404\u65b9\u52bf\u529b\u8840\u6d17\u6b66\u6797\u3002\u73a9\u5bb6\u626e\u6f14\u9690\u4e16\u95e8\u6d3e\u300c\u65e0\u6781\u5b97\u300d\u672b\u4ee3\u5f1f\u5b50\uff0c\u643a\u9547\u6d3e\u7edd\u5b66\u300c\u516b\u5366\u9635\u56fe\u300d\uff0c\u4e8e\u5c71\u95e8\u8981\u9053\u5e03\u4e0b\u5929\u7f57\u5730\u7f51\uff0c\u4ee5\u529f\u592b\u5965\u4e49\u5b88\u62a4\u6b66\u6797\u6700\u540e\u7684\u51c0\u571f\u3002</p><p class=\"bb_paragraph\" ><strong>\u3010\u6838\u5fc3\u73a9\u6cd5\u3011</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>\u529f\u592b\u5854\u9632\u9769\u65b0</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u878d\u5408\u548f\u6625\u5bf8\u52b2\u3001\u592a\u6781\u56db\u4e24\u62e8\u5343\u65a4\u7b49\u767e\u79cd\u6b66\u5b66\u62db\u5f0f\uff0c\u6bcf\u5ea7\u9632\u5fa1\u5854\u5bf9\u5e94\u4e00\u95e8\u529f\u592b\u6d41\u6d3e\uff08\u4f8b\uff1a\u5c11\u6797\u7f57\u6c49\u5854\u53ef\u53ec\u5524\u5341\u516b\u94dc\u4eba\u9635\uff09</p></li><li><p class=\"bb_paragraph\" >\u654c\u4eba\u643a\u5e26\u300c\u5185\u529b\u503c\u300d\u8bbe\u5b9a\uff0c\u9700\u7528\u7279\u5b9a\u62db\u5f0f\u7834\u62db\uff08\u5982\u7528\u300c\u6cbe\u8863\u5341\u516b\u8dcc\u300d\u5316\u89e3\u8499\u53e4\u6454\u8de4\u624b\u51b2\u950b\uff09</p></li></ul></li><li><p class=\"bb_paragraph\" ><strong>\u52a8\u6001\u6c5f\u6e56\u6218\u573a</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u5730\u56fe\u878d\u5408\u4e94\u884c\u516b\u5366\u673a\u5173\uff1a\u5f15\u96f7\u51fb\u7684\u300c\u96f7\u706b\u53f0\u300d\u3001\u51cf\u901f\u654c\u4eba\u7684\u300c\u6cbc\u6cfd\u7634\u6c14\u9635\u300d</p></li><li><p class=\"bb_paragraph\" >\u663c\u591c\u4ea4\u66ff\u5f71\u54cd\u6218\u5c40\uff1a\u591c\u6218\u9700\u70b9\u71c3\u706b\u628a\u9632\u9690\u5f62\u523a\u5ba2\uff0c\u96e8\u5929\u5219\u589e\u5f3a\u5ce8\u7709\u5251\u6cd5</p></li></ul></li><li><p class=\"bb_paragraph\" ><strong>\u5b97\u5e08\u6210\u957f\u4f53\u7cfb</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u53c2\u609f\u300a\u6613\u7b4b\u7ecf\u300b\u300a\u4e5d\u9634\u771f\u7ecf\u300b\u7b49\u79d8\u7c4d\u89e3\u9501\u7ecf\u8109\u7cfb\u7edf\uff0c\u6c38\u4e45\u5f3a\u5316\u5168\u5854\u5c5e\u6027</p></li><li><p class=\"bb_paragraph\" >\u6536\u96c6\u6b66\u6797\u8f76\u4e8b\u788e\u7247\uff0c\u53ec\u5524\u4f20\u8bf4\u4fa0\u5ba2\u52a9\u6218\uff08\u5982\u9ec4\u98de\u9e3f\u72ee\u5934\u70ae\u3001\u53f6\u95ee\u548f\u6625\u8fde\u73af\u638c\uff09</p></li></ul></li></ul><p class=\"bb_paragraph\" ><strong>\u3010\u89c6\u89c9\u7279\u8272\u3011</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>\u6c34\u58a8\u52a8\u6001\u6e32\u67d3</strong>\uff1a\u653b\u51fb\u7279\u6548\u91c7\u7528\u6cfc\u58a8\u98ce\u683c\uff0c\u592a\u6781\u62f3\u6c14\u5316\u4e3a\u9ed1\u9f99\uff0c\u5f62\u610f\u62f3\u52bf\u5982\u5954\u9a6c</p></li><li><p class=\"bb_paragraph\" ><strong>\u6b66\u4fa0\u97f3\u6548\u7cfb\u7edf</strong>\uff1a\u5175\u5668\u78b0\u649e\u58f0\u7531\u771f\u5b9e\u6b66\u672f\u5f55\u97f3\u91c7\u6837\uff0cBOSS\u51fa\u573a\u81ea\u5e26\u5522\u5450BGM</p></li></ul><p class=\"bb_paragraph\" ><strong>\u3010\u793e\u4ea4\u73a9\u6cd5\u3011</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>\u6b66\u6797\u5927\u4f1a</strong>\uff1a\u6bcf\u5468\u9650\u65f6\u5f00\u542f\u8de8\u670d\u5b97\u6218\uff0c\u524d10\u540d\u5b97\u95e8\u96d5\u50cf\u523b\u5165\u300c\u6b66\u6797\u82f1\u8c6a\u699c\u300d</p></li><li><p class=\"bb_paragraph\" ><strong>\u5e08\u5f92\u7cfb\u7edf</strong>\uff1a\u4f20\u6388\u81ea\u521b\u6b66\u529f\u7ec4\u5408\uff0c\u5f92\u5f1f\u901a\u5173\u540e\u5e08\u7236\u83b7\u300c\u6843\u674e\u6ee1\u5929\u4e0b\u300d\u79f0\u53f7</p></li></ul><p class=\"bb_paragraph\" ><strong>\u3010\u5f00\u53d1\u8005\u5bc4\u8bed\u3011</strong><br>&quot;\u6211\u4eec\u60f3\u8ba9\u73a9\u5bb6\u611f\u53d7\u5230\uff0c\u5854\u9632\u4e0d\u4ec5\u662f\u6570\u503c\u6e38\u620f\uff0c\u66f4\u662f\u6b66\u5b66\u667a\u6167\u7684\u8f83\u91cf\u3002\u6bcf\u4e2a\u5173\u5361\u90fd\u662f\u6c5f\u6e56\u4f20\u8bf4\u2014\u2014\u7528\u6d2a\u62f3\u5bf9\u6297\u4e1c\u701b\u5fcd\u8005\uff0c\u4ee5\u5510\u95e8\u6697\u5668\u7834\u8499\u53e4\u94c1\u9a91\uff0c\u8fd9\u4e0d\u6b62\u662f\u6e38\u620f\uff0c\u66f4\u662f\u5bf9\u4e2d\u56fd\u6b66\u4fa0\u6587\u5316\u7684\u6c89\u6d78\u5f0f\u4f53\u9a8c\u3002&quot;</p><p class=\"bb_paragraph\" ><strong>\u76ee\u6807\u7fa4\u4f53</strong>\uff1a\u5854\u9632\u7b56\u7565\u7231\u597d\u8005\u3001\u6b66\u4fa0\u6587\u5316\u7c89\u4e1d\u3001\u8ffd\u6c42\u9ad8\u7b56\u7565\u6df1\u5ea6\u7684\u73a9\u5bb6<br><strong>\u7279\u8272\u6807\u7b7e</strong>\uff1a#\u6b66\u4fa0\u9ed1\u79d1\u6280 #\u529f\u592b\u8fde\u62db\u5854\u9632 #\u52a8\u6001\u6c5f\u6e56\u6218\u573a</p>",
