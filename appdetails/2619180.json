    "detailed_description": "<h2 class=\"bb_tag\" >\u8fd9\u662f\u4e00\u6b3e\u600e\u6837\u7684\u6e38\u620f\uff1f</h2><p class=\"bb_paragraph\" >\u8fd9\u662f\u4e00\u6b3e\u6587\u5b57\u7c7b\u604b\u7231\u5192\u9669\u6e38\u620f\u3002 </p><p class=\"bb_paragraph\" >\u8be5\u6e38\u620f\u901a\u8fc7\u70b9\u51fb\u5de6\u952e\u6216\u6309\u7a7a\u683c\u952e\u63a8\u52a8\u5bf9\u8bdd\u5e76\u9009\u62e9\u5206\u652f\uff0c\u6765\u8fbe\u6210\u4e0d\u540c\u7684\u6e38\u620f\u5185\u5bb9\u3002</p><p class=\"bb_paragraph\" >\u6309\u4f4f\u7a7a\u683c\u952e\u53ef\u5feb\u901f\u63a8\u8fdb\u5bf9\u8bdd\u3002</p><h2 class=\"bb_tag\" >\u6545\u4e8b\u4ecb\u7ecd</h2><p class=\"bb_paragraph\" >\u4f60\u5c06\u626e\u6f14\u8eab\u4efd\u795e\u79d8\u7684\u5973\u4e3b\u89d2\u5c0f\u591c\uff0c\u8fb9\u4e0e\u73a5\u73a5\u5c55\u5f00\u5feb\u4e50\u7684\u65e5\u5e38\u751f\u6d3b\uff0c\u8fb9\u7ecf\u5386\u4e00\u4e2a\u4e2a\u602a\u5f02\u4e8b\u4ef6\u3002 </p><p class=\"bb_paragraph\" >\u6e38\u620f\u5177\u6709\u9009\u62e9\u5206\u652f\u3002\u4f60\u7684\u9009\u62e9\uff0c\u53ef\u80fd\u5b8c\u5168\u6539\u53d8\u6545\u4e8b\u7684\u8d70\u5411\u3002 </p><h2 class=\"bb_tag\" >\u6e38\u620f\u7279\u8272</h2><p class=\"bb_paragraph\" >\u4e0e\u901a\u5e38\u6e38\u620f\u7684\u6a2a\u5c4f\u4e0d\u540c\uff0c\u672c\u6e38\u620f\u662f\u4e00\u6b3e\u4ee5\u7ad6\u7248\u754c\u9762\u5448\u73b0\u7684\u6587\u5b57\u6e38\u620f\uff0c\u5177\u6709\u767e\u5408\u4e0e\u5fae\u6050\u6016\u8981\u7d20\u3002 </p><p class=\"bb_paragraph\" >\u672c\u6e38\u620f\u662f\u4ee5\u5bf9\u8bdd\u5c0f\u8bf4\u7684\u65b9\u5f0f\u5199\u4f5c\u800c\u6210\uff0c\u6e38\u73a9\u4f53\u9a8c\u76f8\u6bd4\u666e\u901a\u7684\u6587\u5b57\u6e38\u620f\u4f1a\u6bd4\u8f83\u7279\u522b\u3002 </p><p class=\"bb_paragraph\" >\u76f8\u4fe1\u80fd\u4e3a\u5927\u5bb6\u5e26\u6765\u72ec\u7279\u7684\u6e38\u620f\u4f53\u9a8c\uff01</p><h2 class=\"bb_tag\" >\u5173\u4e8e\u672c\u6e38\u620f\u7684\u6301\u7eed\u66f4\u65b0\u4e0eDLC</h2><p class=\"bb_paragraph\" >\u5728\u67d0\u4e9bDLC\u4e2d\uff08\u5982\u9b54\u5973\u72c2\u75ab\uff09\uff0c\u6e38\u620f\u7684\u673a\u5236\u5c06\u66f4\u52a0\u591a\u6837</p><p class=\"bb_paragraph\" >\u540c\u65f6\uff0c\u4e0d\u540cDLC\u7684\u98ce\u683c\u90fd\u6709\u6240\u533a\u522b\uff0c\u4e3b\u89d2\u4e5f\u5e76\u975e\u4e00\u5b9a\u662f\u5c0f\u591c\u3002\u4f46\u5267\u60c5\u4e0a\u5b58\u5728\u4e00\u5b9a\u8054\u7cfb\u3002</p><p class=\"bb_paragraph\" >\u4ee5\u5df2\u53d1\u552e\u7684\u201c\u9b54\u5973\u72c2\u75ab\u201d\u7cfb\u5217DLC\u6765\u8bf4\uff0c\u5c31\u662f\u53d1\u751f\u5728\u897f\u65b9\u4e2d\u4e16\u7eaa\u65f6\u671f\u7684\u5947\u5e7b\u5192\u9669\uff0c\u4fa7\u91cd\u4e8e\u591a\u5206\u652f\u7684\u5267\u60c5\u4f53\u9a8c\u4e0e\u6218\u6597\u4f53\u9a8c\uff0c\u51e0\u4e4e\u6ca1\u6709\u6050\u6016\u5143\u7d20\u3002</p><p class=\"bb_paragraph\" >\u5728\u8fd9\u4e2aDLC\u7cfb\u5217\u4e2d\uff0c\u65b0\u52a0\u5165\u4e86\u5404\u79cd\u6570\u503c\u7cfb\u7edf\uff08\u5982\u89d2\u8272\u597d\u611f\u5ea6\u3001\u5065\u5eb7\u503c\u3001\u901a\u7f09\u503c\u7b49\uff09\u3001\u7269\u54c1\u7cfb\u7edf\u4e0e\u8de8\u7ae0\u8282\u591a\u5206\u652f\u5267\u60c5\u3002\u5185\u5bb9\u91cf\u6781\u5927\uff0c\u53ef\u73a9\u6027\u4e5f\u5f88\u9ad8\u3002\u5373\u4fbf\u662f\u65e9\u671f\u4e0d\u8d77\u773c\u7684\u9009\u9879\u4e5f\u53ef\u80fd\u5f71\u54cd\u5230\u6570\u5341\u7ae0\u540e\u975e\u5e38\u91cd\u5927\u7684\u4e8b\u4ef6\u3002</p><p class=\"bb_paragraph\" >\u800c\u201c\u4fa6\u63a2\u6e38\u620f\u201dDLC\uff0c\u6545\u4e8b\u4fbf\u53d1\u751f\u5728\u548c\u6b63\u7bc7\u4e00\u6837\u7684\u73b0\u4ee3\u793e\u4f1a\uff0c\u821e\u53f0\u6765\u5230\u4e86\u65e5\u672c\uff0c\u4e3b\u89d2\u5219\u662f\u96ea\u5b50\u548c\u827e\u5e0c\u7b49\u4eba\u3002\u5176\u4e2d\u7684\u827e\u5e0c\u662f\u5c0f\u591c\u7684\u8001\u670b\u53cb\uff0c\u53ef\u4ee5\u5728\u9b54\u5973\u72c2\u75ab\u7b2c\u4e8c\u5b63\u4e2d\u4e86\u89e3\u5230\u5979\u7684\u6545\u4e8b\u3002</p><p class=\"bb_paragraph\" >\u6b63\u5728\u5236\u4f5c\u7684\u201c\u5760\u843d\u201dDLC\uff0c\u5219\u662f\u53d1\u751f\u5728\u8d5b\u535a\u670b\u514b\u4e16\u754c\u7684\u6545\u4e8b\u3002\u4f53\u91cf\u6781\u5176\u5e9e\u5927\uff0c\u6587\u672c\u91cf\u9ad8\u8fbe35\u4e07\u5b57\u5de6\u53f3\u3002</p><p class=\"bb_paragraph\" >\u4ece25\u5e742\u6708\u5f00\u59cb\uff0c\u672c\u6e38\u620f\u5c06\u65f6\u4e0d\u65f6\u66f4\u65b0\u4e00\u4e9b\u514d\u8d39\u5267\u60c5\u56de\u9988\u65b0\u8001\u73a9\u5bb6\uff01</p><p class=\"bb_paragraph\" >\u672c\u6e38\u620f\u5c06\u6301\u7eed\u66f4\u65b0\u65b0\u7684\u5267\u60c5\uff0c\u611f\u8c22\u5927\u5bb6\u7684\u652f\u6301\uff01\u5f53\u7136\uff0c\u6240\u6709\u5267\u60c5\u90fd\u6709\u767e\u5408\u5143\u7d20\u54e6~</p><p class=\"bb_paragraph\" ></p>",
    "about_the_game": "<h2 class=\"bb_tag\" >\u8fd9\u662f\u4e00\u6b3e\u600e\u6837\u7684\u6e38\u620f\uff1f</h2><p class=\"bb_paragraph\" >\u8fd9\u662f\u4e00\u6b3e\u6587\u5b57\u7c7b\u604b\u7231\u5192\u9669\u6e38\u620f\u3002 </p><p class=\"bb_paragraph\" >\u8be5\u6e38\u620f\u901a\u8fc7\u70b9\u51fb\u5de6\u952e\u6216\u6309\u7a7a\u683c\u952e\u63a8\u52a8\u5bf9\u8bdd\u5e76\u9009\u62e9\u5206\u652f\uff0c\u6765\u8fbe\u6210\u4e0d\u540c\u7684\u6e38\u620f\u5185\u5bb9\u3002</p><p class=\"bb_paragraph\" >\u6309\u4f4f\u7a7a\u683c\u952e\u53ef\u5feb\u901f\u63a8\u8fdb\u5bf9\u8bdd\u3002</p><h2 class=\"bb_tag\" >\u6545\u4e8b\u4ecb\u7ecd</h2><p class=\"bb_paragraph\" >\u4f60\u5c06\u626e\u6f14\u8eab\u4efd\u795e\u79d8\u7684\u5973\u4e3b\u89d2\u5c0f\u591c\uff0c\u8fb9\u4e0e\u73a5\u73a5\u5c55\u5f00\u5feb\u4e50\u7684\u65e5\u5e38\u751f\u6d3b\uff0c\u8fb9\u7ecf\u5386\u4e00\u4e2a\u4e2a\u602a\u5f02\u4e8b\u4ef6\u3002 </p><p class=\"bb_paragraph\" >\u6e38\u620f\u5177\u6709\u9009\u62e9\u5206\u652f\u3002\u4f60\u7684\u9009\u62e9\uff0c\u53ef\u80fd\u5b8c\u5168\u6539\u53d8\u6545\u4e8b\u7684\u8d70\u5411\u3002 </p><h2 class=\"bb_tag\" >\u6e38\u620f\u7279\u8272</h2><p class=\"bb_paragraph\" >\u4e0e\u901a\u5e38\u6e38\u620f\u7684\u6a2a\u5c4f\u4e0d\u540c\uff0c\u672c\u6e38\u620f\u662f\u4e00\u6b3e\u4ee5\u7ad6\u7248\u754c\u9762\u5448\u73b0\u7684\u6587\u5b57\u6e38\u620f\uff0c\u5177\u6709\u767e\u5408\u4e0e\u5fae\u6050\u6016\u8981\u7d20\u3002 </p><p class=\"bb_paragraph\" >\u672c\u6e38\u620f\u662f\u4ee5\u5bf9\u8bdd\u5c0f\u8bf4\u7684\u65b9\u5f0f\u5199\u4f5c\u800c\u6210\uff0c\u6e38\u73a9\u4f53\u9a8c\u76f8\u6bd4\u666e\u901a\u7684\u6587\u5b57\u6e38\u620f\u4f1a\u6bd4\u8f83\u7279\u522b\u3002 </p><p class=\"bb_paragraph\" >\u76f8\u4fe1\u80fd\u4e3a\u5927\u5bb6\u5e26\u6765\u72ec\u7279\u7684\u6e38\u620f\u4f53\u9a8c\uff01</p><h2 class=\"bb_tag\" >\u5173\u4e8e\u672c\u6e38\u620f\u7684\u6301\u7eed\u66f4\u65b0\u4e0eDLC</h2><p class=\"bb_paragraph\" >\u5728\u67d0\u4e9bDLC\u4e2d\uff08\u5982\u9b54\u5973\u72c2\u75ab\uff09\uff0c\u6e38\u620f\u7684\u673a\u5236\u5c06\u66f4\u52a0\u591a\u6837</p><p class=\"bb_paragraph\" >\u540c\u65f6\uff0c\u4e0d\u540cDLC\u7684\u98ce\u683c\u90fd\u6709\u6240\u533a\u522b\uff0c\u4e3b\u89d2\u4e5f\u5e76\u975e\u4e00\u5b9a\u662f\u5c0f\u591c\u3002\u4f46\u5267\u60c5\u4e0a\u5b58\u5728\u4e00\u5b9a\u8054\u7cfb\u3002</p><p class=\"bb_paragraph\" >\u4ee5\u5df2\u53d1\u552e\u7684\u201c\u9b54\u5973\u72c2\u75ab\u201d\u7cfb\u5217DLC\u6765\u8bf4\uff0c\u5c31\u662f\u53d1\u751f\u5728\u897f\u65b9\u4e2d\u4e16\u7eaa\u65f6\u671f\u7684\u5947\u5e7b\u5192\u9669\uff0c\u4fa7\u91cd\u4e8e\u591a\u5206\u652f\u7684\u5267\u60c5\u4f53\u9a8c\u4e0e\u6218\u6597\u4f53\u9a8c\uff0c\u51e0\u4e4e\u6ca1\u6709\u6050\u6016\u5143\u7d20\u3002</p><p class=\"bb_paragraph\" >\u5728\u8fd9\u4e2aDLC\u7cfb\u5217\u4e2d\uff0c\u65b0\u52a0\u5165\u4e86\u5404\u79cd\u6570\u503c\u7cfb\u7edf\uff08\u5982\u89d2\u8272\u597d\u611f\u5ea6\u3001\u5065\u5eb7\u503c\u3001\u901a\u7f09\u503c\u7b49\uff09\u3001\u7269\u54c1\u7cfb\u7edf\u4e0e\u8de8\u7ae0\u8282\u591a\u5206\u652f\u5267\u60c5\u3002\u5185\u5bb9\u91cf\u6781\u5927\uff0c\u53ef\u73a9\u6027\u4e5f\u5f88\u9ad8\u3002\u5373\u4fbf\u662f\u65e9\u671f\u4e0d\u8d77\u773c\u7684\u9009\u9879\u4e5f\u53ef\u80fd\u5f71\u54cd\u5230\u6570\u5341\u7ae0\u540e\u975e\u5e38\u91cd\u5927\u7684\u4e8b\u4ef6\u3002</p><p class=\"bb_paragraph\" >\u800c\u201c\u4fa6\u63a2\u6e38\u620f\u201dDLC\uff0c\u6545\u4e8b\u4fbf\u53d1\u751f\u5728\u548c\u6b63\u7bc7\u4e00\u6837\u7684\u73b0\u4ee3\u793e\u4f1a\uff0c\u821e\u53f0\u6765\u5230\u4e86\u65e5\u672c\uff0c\u4e3b\u89d2\u5219\u662f\u96ea\u5b50\u548c\u827e\u5e0c\u7b49\u4eba\u3002\u5176\u4e2d\u7684\u827e\u5e0c\u662f\u5c0f\u591c\u7684\u8001\u670b\u53cb\uff0c\u53ef\u4ee5\u5728\u9b54\u5973\u72c2\u75ab\u7b2c\u4e8c\u5b63\u4e2d\u4e86\u89e3\u5230\u5979\u7684\u6545\u4e8b\u3002</p><p class=\"bb_paragraph\" >\u6b63\u5728\u5236\u4f5c\u7684\u201c\u5760\u843d\u201dDLC\uff0c\u5219\u662f\u53d1\u751f\u5728\u8d5b\u535a\u670b\u514b\u4e16\u754c\u7684\u6545\u4e8b\u3002\u4f53\u91cf\u6781\u5176\u5e9e\u5927\uff0c\u6587\u672c\u91cf\u9ad8\u8fbe35\u4e07\u5b57\u5de6\u53f3\u3002</p><p class=\"bb_paragraph\" >\u4ece25\u5e742\u6708\u5f00\u59cb\uff0c\u672c\u6e38\u620f\u5c06\u65f6\u4e0d\u65f6\u66f4\u65b0\u4e00\u4e9b\u514d\u8d39\u5267\u60c5\u56de\u9988\u65b0\u8001\u73a9\u5bb6\uff01</p><p class=\"bb_paragraph\" >\u672c\u6e38\u620f\u5c06\u6301\u7eed\u66f4\u65b0\u65b0\u7684\u5267\u60c5\uff0c\u611f\u8c22\u5927\u5bb6\u7684\u652f\u6301\uff01\u5f53\u7136\uff0c\u6240\u6709\u5267\u60c5\u90fd\u6709\u767e\u5408\u5143\u7d20\u54e6~</p><p class=\"bb_paragraph\" ></p>",
