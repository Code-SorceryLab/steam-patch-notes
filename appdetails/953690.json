play muted loop playsinline crossorigin=\"anonymous\" poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/953690/extras/ab848b68b5eeb9e8dfee5b88cae9c472.poster.avif?t=1707729301\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/953690/extras/ab848b68b5eeb9e8dfee5b88cae9c472.webm?t=1707729301\" type=\"video/webm; codecs=vp9\"></video></div>",
