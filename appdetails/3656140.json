    "detailed_description": "<ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u524d\u8a00</p><p class=\"bb_paragraph\" >\u672c\u6e38\u620f\u662f\u57fa\u4e8e\u300a\u660e\u65e5\u65b9\u821f\u300b\u4e16\u754c\u89c2\u4e0b\u7684\u6587\u5b57\u5192\u9669\u6e38\u620f\u3002\u4ee5\u6545\u4e8b\u96c6\u300a\u4e4c\u8428\u65af\u7684\u5b69\u5b50\u4eec\u300b\u7684\u5267\u60c5\u4f5c\u4e3a\u84dd\u672c\uff0c\u8be6\u7ec6\u62d3\u5c55\u4e86\u6574\u5408\u8fd0\u52a8\u5165\u4fb5\u5207\u5c14\u8bfa\u4f2f\u683c\u540e\uff0c\u5c06\u5b66\u751f\u4eec\u6c47\u805a\u5728\u5f7c\u5fb7\u6d77\u59c6\u4e2d\u5b66\u7684\u6545\u4e8b\u3002\u6e38\u620f\u4e2d\u5177\u6709\u4e30\u5bcc\u7684\u9009\u62e9\u652f\uff0c\u6839\u636e\u73a9\u5bb6\u9009\u62e9\u7684\u4e0d\u540c\uff0c\u5c06\u4f1a\u8ba9\u6545\u4e8b\u7684\u8d70\u5411\u53d1\u751f\u5de8\u5927\u7684\u53d8\u5316\u3002\u6211\u4eec\u5e0c\u671b\u6bcf\u4e00\u540d\u73a9\u5bb6\u90fd\u80fd\u5728\u8fd9\u4e2a\u6e38\u620f\u4e2d\uff0c\u4ee5\u81ea\u5df1\u7684\u65b9\u5f0f\uff0c\u63a2\u5bfb\u90a3\u4e9b\u85cf\u4e8e\u5207\u57ce\u9634\u4e91\u4e0b\u7684\u79d8\u5bc6\u3002</p></li><li><p class=\"bb_paragraph\" >\u6545\u4e8b\u7b80\u4ecb</p></li></ul><p class=\"bb_paragraph\" >\u00a0 \u00a0 1096\u5e7412\u6708\uff0c\u6574\u5408\u8fd0\u52a8\u5165\u4fb5\u5207\u5c14\u8bfa\u4f2f\u683c\u3002</p><p class=\"bb_paragraph\" >\u00a0 \u00a0 \u8eab\u4e3a\u611f\u67d3\u8005\u7ec4\u7ec7\u7684\u4ed6\u4eec\u4e0d\u77e5\u4e3a\u4f55\u9009\u62e9\u5c06\u4e00\u7fa4\u4e2d\u5b66\u751f\u5173\u5728\u4e86\u540d\u4e3a\u5f7c\u5fb7\u6d77\u59c6\u7684\u9ad8\u4e2d\u4e4b\u4e2d\uff0c\u4efb\u7531\u8fd9\u4e9b\u5b66\u00a0 \u00a0 \u00a0 \u751f\u81ea\u751f\u81ea\u706d\u3002</p><p class=\"bb_paragraph\" >\u00a0 \u00a0 \u4f5c\u4e3a\u88ab\u5e26\u6765\u8fd9\u6240\u5b66\u6821\u7684\u4e00\u540d\u8d35\u65cf\u5b66\u751f\uff0c\u4f60\u7684\u9009\u62e9\u5c06\u4f1a\u6df1\u6df1\u5730\u5f71\u54cd\u53d1\u751f\u5728\u8fd9\u5ea7\u5b66\u6821\u91cc\u7684\u4e00\u5207\u3002</p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u6e38\u620f\u7279\u8272</p></li></ul><p class=\"bb_paragraph\" >\u00a0 \u00a0 \u662f\u770b\u4e0d\u60ef\u8dcb\u6248\u7684\u8d35\u65cf\u5b66\u751f\u6b3a\u8d1f\u5e73\u6c11\u5b66\u751f\u51fa\u624b\u76f8\u52a9\uff0c\u8fd8\u662f\u9009\u62e9\u9075\u4ece\u8eab\u4efd\u4e0e\u4ed6\u4eec\u6c86\u7023\u4e00\u6c14\uff0c\u662f\u9762\u5bf9\u5f3a\u00a0 \u00a0 \u00a0 \u5927\u5a01\u538b\u7684\u654c\u4eba\u594b\u7136\u6297\u4e89\uff0c\u8fd8\u662f\u4f4e\u5934\u88c5\u4f5c\u89c6\u800c\u4e0d\u89c1\u3002\u4f60\u7684\u51b3\u5b9a\u5c06\u4f1a\u6539\u53d8\u8fd9\u6240\u5b66\u6821\u91cc\u8bb8\u591a\u4eba\u7684\u547d\u8fd0\uff0c\u00a0 \u00a0 \u00a0 \u4f60\u4e5f\u4f1a\u4e0e\u660e\u65e5\u65b9\u821f\u4e2d\u7684\u89d2\u8272\u76f8\u9047\uff0c\u53e4\u7c73\uff0c\u65e9\u9732\uff0c\u771f\u7406\uff0c\u70c8\u590f\u8fd8\u6709\u51db\u51ac\uff0c\u5979\u4eec\u5728\u8fd9\u6bb5\u582a\u79f0\u5669\u68a6\u822c\u7684\u00a0 \u00a0 \u00a0 \u65e5\u5b50\u91cc\u7ecf\u5386\u4e86\u4ec0\u4e48\uff1f\u8fd9\u4e9b\u90fd\u4f1a\u5728\u6e38\u620f\u4e2d\u9010\u6e10\u63ed\u79d8\u3002</p><p class=\"bb_paragraph\" >\u00a0 \u00a0 \u53bb\u63ed\u5f00\u63a9\u76d6\u5728\u5f7c\u5fb7\u6d77\u59c6\u4e0a\u65b9\u7684\u8ff7\u96fe\u5427\uff0c\u7f57\u5fb7\u91cc\u683c\u65af\u3002</p>",
    "about_the_game": "<ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u524d\u8a00</p><p class=\"bb_paragraph\" >\u672c\u6e38\u620f\u662f\u57fa\u4e8e\u300a\u660e\u65e5\u65b9\u821f\u300b\u4e16\u754c\u89c2\u4e0b\u7684\u6587\u5b57\u5192\u9669\u6e38\u620f\u3002\u4ee5\u6545\u4e8b\u96c6\u300a\u4e4c\u8428\u65af\u7684\u5b69\u5b50\u4eec\u300b\u7684\u5267\u60c5\u4f5c\u4e3a\u84dd\u672c\uff0c\u8be6\u7ec6\u62d3\u5c55\u4e86\u6574\u5408\u8fd0\u52a8\u5165\u4fb5\u5207\u5c14\u8bfa\u4f2f\u683c\u540e\uff0c\u5c06\u5b66\u751f\u4eec\u6c47\u805a\u5728\u5f7c\u5fb7\u6d77\u59c6\u4e2d\u5b66\u7684\u6545\u4e8b\u3002\u6e38\u620f\u4e2d\u5177\u6709\u4e30\u5bcc\u7684\u9009\u62e9\u652f\uff0c\u6839\u636e\u73a9\u5bb6\u9009\u62e9\u7684\u4e0d\u540c\uff0c\u5c06\u4f1a\u8ba9\u6545\u4e8b\u7684\u8d70\u5411\u53d1\u751f\u5de8\u5927\u7684\u53d8\u5316\u3002\u6211\u4eec\u5e0c\u671b\u6bcf\u4e00\u540d\u73a9\u5bb6\u90fd\u80fd\u5728\u8fd9\u4e2a\u6e38\u620f\u4e2d\uff0c\u4ee5\u81ea\u5df1\u7684\u65b9\u5f0f\uff0c\u63a2\u5bfb\u90a3\u4e9b\u85cf\u4e8e\u5207\u57ce\u9634\u4e91\u4e0b\u7684\u79d8\u5bc6\u3002</p></li><li><p class=\"bb_paragraph\" >\u6545\u4e8b\u7b80\u4ecb</p></li></ul><p class=\"bb_paragraph\" >\u00a0 \u00a0 1096\u5e7412\u6708\uff0c\u6574\u5408\u8fd0\u52a8\u5165\u4fb5\u5207\u5c14\u8bfa\u4f2f\u683c\u3002</p><p class=\"bb_paragraph\" >\u00a0 \u00a0 \u8eab\u4e3a\u611f\u67d3\u8005\u7ec4\u7ec7\u7684\u4ed6\u4eec\u4e0d\u77e5\u4e3a\u4f55\u9009\u62e9\u5c06\u4e00\u7fa4\u4e2d\u5b66\u751f\u5173\u5728\u4e86\u540d\u4e3a\u5f7c\u5fb7\u6d77\u59c6\u7684\u9ad8\u4e2d\u4e4b\u4e2d\uff0c\u4efb\u7531\u8fd9\u4e9b\u5b66\u00a0 \u00a0 \u00a0 \u751f\u81ea\u751f\u81ea\u706d\u3002</p><p class=\"bb_paragraph\" >\u00a0 \u00a0 \u4f5c\u4e3a\u88ab\u5e26\u6765\u8fd9\u6240\u5b66\u6821\u7684\u4e00\u540d\u8d35\u65cf\u5b66\u751f\uff0c\u4f60\u7684\u9009\u62e9\u5c06\u4f1a\u6df1\u6df1\u5730\u5f71\u54cd\u53d1\u751f\u5728\u8fd9\u5ea7\u5b66\u6821\u91cc\u7684\u4e00\u5207\u3002</p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u6e38\u620f\u7279\u8272</p></li></ul><p class=\"bb_paragraph\" >\u00a0 \u00a0 \u662f\u770b\u4e0d\u60ef\u8dcb\u6248\u7684\u8d35\u65cf\u5b66\u751f\u6b3a\u8d1f\u5e73\u6c11\u5b66\u751f\u51fa\u624b\u76f8\u52a9\uff0c\u8fd8\u662f\u9009\u62e9\u9075\u4ece\u8eab\u4efd\u4e0e\u4ed6\u4eec\u6c86\u7023\u4e00\u6c14\uff0c\u662f\u9762\u5bf9\u5f3a\u00a0 \u00a0 \u00a0 \u5927\u5a01\u538b\u7684\u654c\u4eba\u594b\u7136\u6297\u4e89\uff0c\u8fd8\u662f\u4f4e\u5934\u88c5\u4f5c\u89c6\u800c\u4e0d\u89c1\u3002\u4f60\u7684\u51b3\u5b9a\u5c06\u4f1a\u6539\u53d8\u8fd9\u6240\u5b66\u6821\u91cc\u8bb8\u591a\u4eba\u7684\u547d\u8fd0\uff0c\u00a0 \u00a0 \u00a0 \u4f60\u4e5f\u4f1a\u4e0e\u660e\u65e5\u65b9\u821f\u4e2d\u7684\u89d2\u8272\u76f8\u9047\uff0c\u53e4\u7c73\uff0c\u65e9\u9732\uff0c\u771f\u7406\uff0c\u70c8\u590f\u8fd8\u6709\u51db\u51ac\uff0c\u5979\u4eec\u5728\u8fd9\u6bb5\u582a\u79f0\u5669\u68a6\u822c\u7684\u00a0 \u00a0 \u00a0 \u65e5\u5b50\u91cc\u7ecf\u5386\u4e86\u4ec0\u4e48\uff1f\u8fd9\u4e9b\u90fd\u4f1a\u5728\u6e38\u620f\u4e2d\u9010\u6e10\u63ed\u79d8\u3002</p><p class=\"bb_paragraph\" >\u00a0 \u00a0 \u53bb\u63ed\u5f00\u63a9\u76d6\u5728\u5f7c\u5fb7\u6d77\u59c6\u4e0a\u65b9\u7684\u8ff7\u96fe\u5427\uff0c\u7f57\u5fb7\u91cc\u683c\u65af\u3002</p>",
