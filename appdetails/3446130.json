a79de1.webm?t=1751620965\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3446130/extras/6881d6b54c302077c1801db139a79de1.mp4?t=1751620965\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3446130/extras/911e3021b6738877140ebe482fc2dc22.poster.avif?t=1751620965\" width=600 height=334 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3446130/extras/911e3021b6738877140ebe482fc2dc22.webm?t=1751620965\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3446130/extras/911e3021b6738877140ebe482fc2dc22.mp4?t=1751620965\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" >\u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0\u00a0<span class=\"bb_img_ctn\"><picture><source srcset=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3446130/extras/7a30e3a0d0f7ca65a81cda60b03aeb79.poster.avif?t=1751620965\" media=\"(prefers-reduced-motion: reduce)\"><img src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3446130/extras/7a30e3a0d0f7ca65a81cda60b03aeb79.apng?t=1751620965\" class=\"bb_img\" width=74 height=60 /></picture></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >Core gameplay systems encompass farming, mining, exploration, fishing, and foraging - enhanced with Roguelike elements and pet companions.</p></li></ul><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3446130/extras/2175180aed514d9eed4f68ddb517f15e.poster.avif?t=1751620965\" width=600 height=334 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3446130/extras/2175180aed514d9eed4f68ddb517f15e.webm?t=1751620965\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3446130/extras/2175180aed514d9eed4f68ddb517f15e.mp4?t=1751620965\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3446130/extras/5205692cffdbcec6f2ded81eb2fadaaf.poster.avif?t=1751620965\" width=600 height=334 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3446130/extras/5205692cffdbcec6f2ded81eb2fadaaf.webm?t=1751620965\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3446130/extras/5205692cffdbcec6f2ded81eb2fadaaf.mp4?t=1751620965\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3446130/extras/955ce21ca8835b5e17323d9423acf5b2.poster.avif?t=1751620965\" width=600 height=334 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3446130/extras/955ce21ca8835b5e17323d9423acf5b2.webm?t=1751620965\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3446130/extras/955ce21ca8835b5e17323d9423acf5b2.mp4?t=1751620965\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3446130/extras/73828bb54a4487f3650a1d2cbc267082.poster.avif?t=1751620965\" width=600 height=334 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3446130/extras/73828bb54a4487f3650a1d2cbc267082.webm?t=1751620965\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3446130/extras/73828bb54a4487f3650a1d2cbc267082.mp4?t=1751620965\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" >\u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0<span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline crossorigin=\"anonymous\" poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3446130/extras/8c52eb17c293d51f7e4e77dd957cfa14.poster.avif?t=1751620965\" width=130 height=96 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3446130/extras/8c52eb17c293d51f7e4e77dd957cfa14.webm?t=1751620965\" type=\"video/webm; codecs=vp9\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >Dynamic environmental shifts reflect seasonal changes, weather patterns, and the passage of time.</p></li></ul><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3446130/extras/4250e124613c37bde9158e44d76fba62.poster.avif?t=1751620965\" width=600 height=334 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3446130/extras/4250e124613c37bde9158e44d76fba62.webm?t=1751620965\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3446130/extras/4250e124613c37bde9158e44d76fba62.mp4?t=1751620965\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3446130/extras/6553221e7d6de9ca876b489b5e84be56.poster.avif?t=1751620965\" width=600 height=334 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3446130/extras/6553221e7d6de9ca876b489b5e84be56.webm?t=1751620965\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3446130/extras/6553221e7d6de9ca876b489b5e84be56.mp4?t=1751620965\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" >\u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0\u00a0<span class=\"bb_img_ctn\"><picture><source srcset=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3446130/extras/74630bd45ca9856f32d9c68c496c7a3c.poster.avif?t=1751620965\" media=\"(prefers-reduced-motion: reduce)\"><img src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3446130/extras/74630bd45ca9856f32d9c68c496c7a3c.apng?t=1751620965\" class=\"bb_img\" width=106 height=90 /></picture></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >Experience a multi-branching narrative through interactions with villagers: forge friendships, solve local problems, deepen relationships, and unlock special events through interwoven storylines.</p></li></ul><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3446130/extras/4c39882c3902c4ad8b2c07ab0c88bbbb.poster.avif?t=1751620965\" width=600 height=334 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3446130/extras/4c39882c3902c4ad8b2c07ab0c88bbbb.webm?t=1751620965\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3446130/extras/4c39882c3902c4ad8b2c07ab0c88bbbb.mp4?t=1751620965\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" >\u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0<span class=\"bb_img_ctn\"><picture><source srcset=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3446130/extras/681df878133533d3e6cfc6cb2c2e4054.poster.avif?t=1751620965\" media=\"(prefers-reduced-motion: reduce)\"><img src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3446130/extras/681df878133533d3e6cfc6cb2c2e4054.apng?t=1751620965\" class=\"bb_img\" width=60 height=58 /></picture></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >Participate in seasonal festivals and community events, pursue romance with eligible villagers, and ultimately establish your own family through marriage.</p></li></ul><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3446130/extras/2fafe97ca4ae63020cdc7a9df2611ec8.poster.avif?t=1751620965\" width=600 height=334 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3446130/extras/2fafe97ca4ae63020cdc7a9df2611ec8.webm?t=1751620965\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3446130/extras/2fafe97ca4ae63020cdc7a9df2611ec8.mp4?t=1751620965\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" >\u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0 \u00a0<span class=\"bb_img_ctn\"><picture><source srcset=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3446130/extras/7a30e3a0d0f7ca65a81cda60b03aeb79.poster.avif?t=1751620965\" media=\"(prefers-reduced-motion: reduce)\"><img src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3446130/extras/7a30e3a0d0f7ca65a81cda60b03aeb79.apng?t=1751620965\" class=\"bb_img\" width=74 height=60 /></picture></span></p>",
    "short_description": "You inherit forest edge land. Daily, till soil with your hoe grow radishes, rear chicks, bond with oddball neighbors. Spring seeds yield summer gardens; autumn's firelit pumpkins reveal woodland mysteries. Nighttime under trees, fireflies dance like starlit constellations, this is your idyllic life.",
