9454ed5df549be8c92a125fa59d3.poster.avif?t=1590419616\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1239270/extras/52c69454ed5df549be8c92a125fa59d3.webm?t=1590419616\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1239270/extras/52c69454ed5df549be8c92a125fa59d3.mp4?t=1590419616\" type=\"video/mp4\"></video></div>",
