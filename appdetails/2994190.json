190/extras/ff092cb0ea445e94e9146f76b4e80bce.mp4?t=1752136639\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2994190/extras/b8289fd0044394c02bea91226b086873.avif?t=1752136639\" width=600 height=100 /></span></p><p class=\"bb_paragraph\" >Drive various cars!</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2994190/extras/b80fbefbb6b039c161438d37bc70baa1.poster.avif?t=1752136639\" width=600 height=338 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2994190/extras/b80fbefbb6b039c161438d37bc70baa1.webm?t=1752136639\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2994190/extras/b80fbefbb6b039c161438d37bc70baa1.mp4?t=1752136639\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2994190/extras/8d30e4012cabae0ec008a08f4b437473.avif?t=1752136639\" width=600 height=100 /></span></p><p class=\"bb_paragraph\" >Start your own coffee shop, buy goods, make and sell coffees!</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2994190/extras/148f4eed69f650815fa05bfb12b3f8d7.poster.avif?t=1752136639\" width=600 height=338 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2994190/extras/148f4eed69f650815fa05bfb12b3f8d7.webm?t=1752136639\" type=\"video/webm; codecs=vp9\"><source src=\"htt