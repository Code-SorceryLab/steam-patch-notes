assets/steam/apps/1832150/extras/5fb4c2e360adf929ff36ab23c6a74319.mp4?t=1723773126\" type=\"video/mp4\"></video></div><br><br><ul class=\"bb_ul\"><li>Breakable ice</li></ul><div class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1832150/extras/82d6fd62ebd41cb9668777ed977ae26c.poster.avif?t=1723773126\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1832150/extras/82d6fd62ebd41cb9668777ed977ae26c.webm?t=1723773126\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1832150/extras/82d6fd62ebd41cb9668777ed977ae26c.mp4?t=1723773126\" type=\"video/mp4\"></video></div><br><br>Thanks for reading, Freya out!<br><div class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1832150/extras/b09d96e74b5d54ab6122ac7f2dc4ff80.poster.avif?t=1723773126\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1832150/extras/b09d96e74b5d54ab6122ac7f2dc4ff80.webm?t=1723773126\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1832150/extras/b09d96e74b5d54ab6122ac7f2dc4ff80.mp4?t=1723773126\" type=\"video/mp4\"></video></div>",
