oster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3302620/extras/515f63aceac50c1dfa496c6f57d9841b.poster.avif?t=1733704039\" width=426 height=240 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3302620/extras/515f63aceac50c1dfa496c6f57d9841b.webm?t=1733704039\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3302620/extras/515f63aceac50c1dfa496c6f57d9841b.mp4?t=1733704039\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3302620/extras/dd662a14bf34f3a88964d8effa05524c.poster.avif?t=1733704039\" width=426 height=240 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3302620/extras/dd662a14bf34f3a88964d8effa05524c.webm?t=1733704039\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3302620/extras/dd662a14bf34f3a88964d8effa05524c.mp4?t=1733704039\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >The kitchen speaker plays several songs, just add it to the scene and press play, when you delete it from the house it stops playing, or when you press the stop command.</p></li><li><p class=\"bb_paragraph\" >If you like design, interior design, decoration, decorating environments, this game is ideal for you.</p></li></ul>",
