    "pc_requirements": {
        "minimum": "<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li>Requires a 64-bit processor and operating system<br></li><li><strong>OS:</strong> Windows 10 64-bit fully updated or: 1909 revision .1350+, 2004 revision .789+, 20H2 revision .789+<br></li><li><strong>Processor:</strong> Dual-Core Intel/AMD CPU<br></li><li><strong>Memory:</strong> 1 GB RAM<br></li><li><strong>Graphics:</strong> AMD DX12, Nvidia DX12 (not Fermi, Shader Model 6.0 required)<br></li><li><strong>DirectX:</strong> Version 12<br></li><li><strong>Storage:</strong> 50 MB available space<br></li><li><strong>Additional Notes:</strong> Update your GPU drivers if you get &quot;Shader Model 6.0 unsupported&quot; warnings; only tested on Nvidia and AMD GPUs, Intel/Qualcomm might work but untested</li></ul>",
        "recommended": "<strong>Recommended:</strong><br><ul class=\"bb_ul\"><li>Requires a 64-bit processor and operating system<br></li><li><strong>OS:</strong> Windows 11 64-bit fully updated<br></li><li><strong>Processor:</strong> Quad-Core Intel/AMD CPU<br></li><li><strong>Memory:</strong> 4 GB RAM<br></li><li><strong>Graphics:</strong> Shader Model 6.0<br></li><li><strong>DirectX:</strong> Version 12<br></li><li><strong>Network:</strong> Broadband Internet connection<br></li><li><strong>Storage:</strong> 50 MB available space<br></li><li><strong>Sound Card:</strong> 48kHz stereo<br></li><li><strong>Additional Notes:</strong> Online Co-op: 1280+ MTU, 0.3MBps up/down, 200/200 pps</li></ul>"
    },
