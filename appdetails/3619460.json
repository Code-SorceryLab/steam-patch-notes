    "detailed_description": "<p class=\"bb_paragraph\" >\ud83d\udd6f\ufe0f \u4e16\u754c\u89c2</p><p class=\"bb_paragraph\" >\u7ec8\u5b9a\u65f6\u523b\u6b63\u5728\u6084\u7136\u903c\u8fd1\u3002\u4e2d\u5ead\u4e4b\u5730\uff0c\u4e00\u7247\u6218\u706b\u4e0e\u4fe1\u4ef0\u4ea4\u7ec7\u7684\u5927\u5730\uff0c\u6210\u4e3a\u4e86\u8bf8\u795e\u535a\u5f08\u7684\u68cb\u76d8\u3002\u7942\u4eec\u7684\u610f\u5fd7\u6e17\u900f\u81f3\u6bcf\u4e00\u5bf8\u571f\u5730\uff0c\u6df7\u4e71\u3001\u6218\u4e89\u3001\u8840\u8165\u548c\u6b7b\u4ea1\u5728\u5404\u56fd\u8086\u8650\u3002\u4f60\u542c\u89c1\u4e86\u53ec\u5524\uff0c\u8de8\u8d8a\u96fe\u6d77\u800c\u6765\uff0c\u5c65\u884c\u90a3\u53e4\u8001\u7684\u5951\u7ea6\u3002\u4f60\u7684\u4f7f\u547d\uff0c\u4fbf\u662f\u5bfb\u56de\u90a3\u4f17\u795e\u5931\u7a83\u4e4b\u706b\uff0c\u5728\u8fd9\u7247\u65e9\u5df2\u6ca1\u6709\u5584\u6076\u4e4b\u5206\u7684\u571f\u5730\u4e0a\uff0c\u5bfb\u627e\u81ea\u5df1\u7684\u7b54\u6848\u3002</p><p class=\"bb_paragraph\" >\u2694\ufe0f \u6838\u5fc3\u73a9\u6cd5</p><p class=\"bb_paragraph\" >\ud83d\udd39 \u5f00\u653e\u4e16\u754c\u63a2\u7d22 \u2014\u2014 \u5e9f\u589f\u4e4b\u4e0a\uff0c\u57cb\u85cf\u7740\u88ab\u9057\u5fd8\u7684\u5386\u53f2</p><p class=\"bb_paragraph\" >\u7a7f\u8d8a\u585e\u7f57\u5766\u4e9a\u738b\u56fd\u56db\u5883\uff0c\u63a2\u7d22\u9057\u8ff9\u3001\u5e7d\u6697\u68ee\u6797\u3001\u88ab\u5c01\u7981\u7684\u53e4\u9053\uff0c\u6bcf\u4e00\u5904\u7686\u85cf\u6709\u79d8\u8f9b\u3002\u4ea4\u8c08\u3001\u8c03\u67e5\u3001\u8ffd\u8e2a\uff0c\u62fc\u51d1\u7834\u788e\u7684\u5386\u53f2\uff0c\u89e3\u5f00\u9690\u85cf\u5728\u5404\u56fd\u52a8\u4e71\u80cc\u540e\u7684\u771f\u76f8\u3002</p><p class=\"bb_paragraph\" >\ud83d\udd39 \u7ecf\u6d4e\u7cfb\u7edf \u2014\u2014 \u6289\u62e9\u4f60\u7684\u751f\u5b58\u4e4b\u9053</p><p class=\"bb_paragraph\" >\u5b8c\u6210\u59d4\u6258\uff1a\u5728\u57ce\u9547\u6267\u4e8b\u5904\u4e0e\u4f63\u5175\u516c\u4f1a\u63a5\u53d6\u4efb\u52a1\uff0c\u4f46\u9700\u5c0f\u5fc3\uff0c\u6267\u4e8b\u5904\u7684\u4efb\u52a1\u5f80\u5f80\u4f34\u968f\u7740\u5371\u9669\u3002\u53c8\u6216\u8005\u524d\u5f80\u90a3\u4e9b\u53e4\u8001\u9057\u8ff9\u4e0e\u7981\u5fcc\u4e4b\u5730\u4e2d\uff0c\u6536\u96c6\u73cd\u8d35\u4e4b\u7269\uff0c\u5356\u7ed9\u5404\u5730\u5546\u8d29\uff0c\u4e0d\u4ec5\u80fd\u8d5a\u5f97\u76c6\u6ee1\u94b5\u6ee1\uff0c\u8fd8\u80fd\u63d0\u5347\u4f60\u7684\u540d\u8a89\u3002</p><p class=\"bb_paragraph\" >\ud83d\udd39 \u89d2\u8272\u6210\u957f \u2014\u2014 \u4f60\u7684\u6280\u827a\uff0c\u51b3\u5b9a\u4f60\u7684\u751f\u6b7b</p><p class=\"bb_paragraph\" >\u65e0\u7b49\u7ea7\u7cfb\u7edf\uff0c\u4f9d\u8d56\u6b66\u5668\u4e0e\u6280\u80fd\u7684\u638c\u63e1\uff0c\u4f60\u7684\u6210\u957f\u7531\u4f60\u7684\u9009\u62e9\u51b3\u5b9a\u3002\u4e09\u5927\u7c7b\u6b66\u5668\uff0c\u4e03\u79cd\u6280\u80fd\u4f53\u7cfb\uff0c\u5728\u5404\u5730\u5bfb\u627e\u540d\u5e08\uff0c\u5b66\u4e60\u72ec\u7279\u6280\u827a\uff0c\u6210\u4e3a\u771f\u6b63\u7684\u6218\u672f\u5927\u5e08\u3002</p><p class=\"bb_paragraph\" >\ud83d\udd39 \u6218\u672f\u56de\u5408\u5236\u6218\u6597 \u2014\u2014 \u5728\u7406\u667a\u5d29\u6e83\u524d\uff0c\u5236\u5b9a\u4f60\u7684\u7b56\u7565</p><p class=\"bb_paragraph\" >\u654c\u4eba\u591a\u6837\u5316\uff1a\u9ed1\u6697\u751f\u7269\u3001\u90aa\u6559\u5f92\u3001\u5f02\u517d\u3001\u4ea1\u9ab8\uff0c\u6bcf\u79cd\u654c\u4eba\u90fd\u9700\u4e0d\u540c\u7b56\u7565\u5e94\u5bf9\u3002</p><p class=\"bb_paragraph\" >\u6218\u672f\u8003\u91cf\uff1a\u643a\u5e26\u7279\u5b9a\u9053\u5177\u907f\u514d\u5371\u9669\uff1f\u8fd8\u662f\u76f4\u63a5\u5229\u7528\u6280\u80fd\u6253\u65ad\u5bf9\u65b9\uff1f\u4f60\u7684\u4e00\u6b65\uff0c\u51b3\u5b9a\u751f\u6b7b\u3002</p><p class=\"bb_paragraph\" >\ud83d\udcd6 \u8ba1\u5212\u4e2d\u7684\u66f4\u65b0</p><p class=\"bb_paragraph\" >\ud83d\udcdd \u4f5c\u8005\u5bc4\u8bed</p><p class=\"bb_paragraph\" >\u54c8\u55bd\uff0c\u5927\u5bb6\u597d\uff0c\u6211\u662f\u300a\u5f02\u4e16\u7b14\u5f55\u300b\u7684\u4f5c\u8005\uff0c\u4e00\u4e2a\u504f\u6267\u3001\u72c2\u70ed\u7684\u7406\u60f3\u4e3b\u4e49\u8005\u3002\u5728\u4e8c\u5341\u5c81\u7684\u67d0\u4e2a\u591c\u665a\uff0c\u6211\u7b2c\u4e00\u6b21\u8bda\u5b9e\u5730\u9762\u5bf9\u81ea\u5df1\u7684\u6b32\u671b\u548c\u6e34\u6c42\uff0c\u51b3\u5b9a\u5c06\u6bd5\u751f\u7684\u65f6\u95f4\u4e0e\u7cbe\u529b\uff0c\u6295\u5165\u5230\u5236\u4f5c 37 \u6b3e\u6e38\u620f \u4e4b\u4e2d\u3002\u8fd9\u662f\u4e00\u573a\u957f\u9014\u8dcb\u6d89\uff0c\u4f46\u6211\u59cb\u7ec8\u575a\u4fe1\uff0c\u552f\u6709\u575a\u6301\u624d\u80fd\u8ba9\u6211\u8131\u79bb\u540d\u4e3a\u5e73\u51e1\u7684\u6df1\u6e0a\u3002</p><p class=\"bb_paragraph\" >\u5173\u4e8e\u300a\u5f02\u4e16\u7b14\u5f55\u300b</p><p class=\"bb_paragraph\" >\u6700\u7ec8\u76ee\u6807\uff1a\u5b8c\u6574\u6253\u9020\u4e2d\u5ead\u4e4b\u5730\uff0c\u5305\u62ec\u56db\u4e2a\u56fd\u5bb6\u7684\u5168\u56fe\u5185\u5bb9\u3002\u8fd9\u662f\u4e00\u4e2a\u5e9e\u5927\u7684\u5de5\u7a0b\uff0c\u9884\u8ba1\u9700\u8981\u6570\u5e74\u65f6\u95f4\u5b8c\u6210\u3002</p><p class=\"bb_paragraph\" >\u672c\u4f5c\u5185\u5bb9\uff1a\u76ee\u524d\u5c06\u5448\u73b0\u585e\u7f57\u5766\u4e9a\u738b\u56fd\u7684\u6587\u6cfd\u4e0e\u94f6\u514b\u8fbe\u5c14\u4e24\u5883\uff0c\u540e\u7eed\u533a\u57df\u5c06\u4ee5 DLC \u548c\u7eed\u4f5c\u5f62\u5f0f\u63a8\u51fa\u3002\u8bf7\u653e\u5fc3\uff0c\u5b83\u4f1a\u4e00\u76f4\u66f4\u65b0\u5b8c\u5584\u7684\u3002</p><p class=\"bb_paragraph\" >\u9ad8\u5854\u4f2b\u7acb\u4e8e\u7fa4\u661f\u4e4b\u4e0b\uff0c\u795e\u706b\u5728\u541b\u738b\u7684\u738b\u5ea7\u4e0a\u71c3\u70e7\u3002 \u8fd9\u4e00\u9875\uff0c\u4e66\u5199\u7740\u4f60\u7684\u547d\u8fd0......</p><p class=\"bb_paragraph\" >\u5173\u4e8e\u6211\u4eec</p><p class=\"bb_paragraph\" ></p>",
    "about_the_game": "<p class=\"bb_paragraph\" >\ud83d\udd6f\ufe0f \u4e16\u754c\u89c2</p><p class=\"bb_paragraph\" >\u7ec8\u5b9a\u65f6\u523b\u6b63\u5728\u6084\u7136\u903c\u8fd1\u3002\u4e2d\u5ead\u4e4b\u5730\uff0c\u4e00\u7247\u6218\u706b\u4e0e\u4fe1\u4ef0\u4ea4\u7ec7\u7684\u5927\u5730\uff0c\u6210\u4e3a\u4e86\u8bf8\u795e\u535a\u5f08\u7684\u68cb\u76d8\u3002\u7942\u4eec\u7684\u610f\u5fd7\u6e17\u900f\u81f3\u6bcf\u4e00\u5bf8\u571f\u5730\uff0c\u6df7\u4e71\u3001\u6218\u4e89\u3001\u8840\u8165\u548c\u6b7b\u4ea1\u5728\u5404\u56fd\u8086\u8650\u3002\u4f60\u542c\u89c1\u4e86\u53ec\u5524\uff0c\u8de8\u8d8a\u96fe\u6d77\u800c\u6765\uff0c\u5c65\u884c\u90a3\u53e4\u8001\u7684\u5951\u7ea6\u3002\u4f60\u7684\u4f7f\u547d\uff0c\u4fbf\u662f\u5bfb\u56de\u90a3\u4f17\u795e\u5931\u7a83\u4e4b\u706b\uff0c\u5728\u8fd9\u7247\u65e9\u5df2\u6ca1\u6709\u5584\u6076\u4e4b\u5206\u7684\u571f\u5730\u4e0a\uff0c\u5bfb\u627e\u81ea\u5df1\u7684\u7b54\u6848\u3002</p><p class=\"bb_paragraph\" >\u2694\ufe0f \u6838\u5fc3\u73a9\u6cd5</p><p class=\"bb_paragraph\" >\ud83d\udd39 \u5f00\u653e\u4e16\u754c\u63a2\u7d22 \u2014\u2014 \u5e9f\u589f\u4e4b\u4e0a\uff0c\u57cb\u85cf\u7740\u88ab\u9057\u5fd8\u7684\u5386\u53f2</p><p class=\"bb_paragraph\" >\u7a7f\u8d8a\u585e\u7f57\u5766\u4e9a\u738b\u56fd\u56db\u5883\uff0c\u63a2\u7d22\u9057\u8ff9\u3001\u5e7d\u6697\u68ee\u6797\u3001\u88ab\u5c01\u7981\u7684\u53e4\u9053\uff0c\u6bcf\u4e00\u5904\u7686\u85cf\u6709\u79d8\u8f9b\u3002\u4ea4\u8c08\u3001\u8c03\u67e5\u3001\u8ffd\u8e2a\uff0c\u62fc\u51d1\u7834\u788e\u7684\u5386\u53f2\uff0c\u89e3\u5f00\u9690\u85cf\u5728\u5404\u56fd\u52a8\u4e71\u80cc\u540e\u7684\u771f\u76f8\u3002</p><p class=\"bb_paragraph\" >\ud83d\udd39 \u7ecf\u6d4e\u7cfb\u7edf \u2014\u2014 \u6289\u62e9\u4f60\u7684\u751f\u5b58\u4e4b\u9053</p><p class=\"bb_paragraph\" >\u5b8c\u6210\u59d4\u6258\uff1a\u5728\u57ce\u9547\u6267\u4e8b\u5904\u4e0e\u4f63\u5175\u516c\u4f1a\u63a5\u53d6\u4efb\u52a1\uff0c\u4f46\u9700\u5c0f\u5fc3\uff0c\u6267\u4e8b\u5904\u7684\u4efb\u52a1\u5f80\u5f80\u4f34\u968f\u7740\u5371\u9669\u3002\u53c8\u6216\u8005\u524d\u5f80\u90a3\u4e9b\u53e4\u8001\u9057\u8ff9\u4e0e\u7981\u5fcc\u4e4b\u5730\u4e2d\uff0c\u6536\u96c6\u73cd\u8d35\u4e4b\u7269\uff0c\u5356\u7ed9\u5404\u5730\u5546\u8d29\uff0c\u4e0d\u4ec5\u80fd\u8d5a\u5f97\u76c6\u6ee1\u94b5\u6ee1\uff0c\u8fd8\u80fd\u63d0\u5347\u4f60\u7684\u540d\u8a89\u3002</p><p class=\"bb_paragraph\" >\ud83d\udd39 \u89d2\u8272\u6210\u957f \u2014\u2014 \u4f60\u7684\u6280\u827a\uff0c\u51b3\u5b9a\u4f60\u7684\u751f\u6b7b</p><p class=\"bb_paragraph\" >\u65e0\u7b49\u7ea7\u7cfb\u7edf\uff0c\u4f9d\u8d56\u6b66\u5668\u4e0e\u6280\u80fd\u7684\u638c\u63e1\uff0c\u4f60\u7684\u6210\u957f\u7531\u4f60\u7684\u9009\u62e9\u51b3\u5b9a\u3002\u4e09\u5927\u7c7b\u6b66\u5668\uff0c\u4e03\u79cd\u6280\u80fd\u4f53\u7cfb\uff0c\u5728\u5404\u5730\u5bfb\u627e\u540d\u5e08\uff0c\u5b66\u4e60\u72ec\u7279\u6280\u827a\uff0c\u6210\u4e3a\u771f\u6b63\u7684\u6218\u672f\u5927\u5e08\u3002</p><p class=\"bb_paragraph\" >\ud83d\udd39 \u6218\u672f\u56de\u5408\u5236\u6218\u6597 \u2014\u2014 \u5728\u7406\u667a\u5d29\u6e83\u524d\uff0c\u5236\u5b9a\u4f60\u7684\u7b56\u7565</p><p class=\"bb_paragraph\" >\u654c\u4eba\u591a\u6837\u5316\uff1a\u9ed1\u6697\u751f\u7269\u3001\u90aa\u6559\u5f92\u3001\u5f02\u517d\u3001\u4ea1\u9ab8\uff0c\u6bcf\u79cd\u654c\u4eba\u90fd\u9700\u4e0d\u540c\u7b56\u7565\u5e94\u5bf9\u3002</p><p class=\"bb_paragraph\" >\u6218\u672f\u8003\u91cf\uff1a\u643a\u5e26\u7279\u5b9a\u9053\u5177\u907f\u514d\u5371\u9669\uff1f\u8fd8\u662f\u76f4\u63a5\u5229\u7528\u6280\u80fd\u6253\u65ad\u5bf9\u65b9\uff1f\u4f60\u7684\u4e00\u6b65\uff0c\u51b3\u5b9a\u751f\u6b7b\u3002</p><p class=\"bb_paragraph\" >\ud83d\udcd6 \u8ba1\u5212\u4e2d\u7684\u66f4\u65b0</p><p class=\"bb_paragraph\" >\ud83d\udcdd \u4f5c\u8005\u5bc4\u8bed</p><p class=\"bb_paragraph\" >\u54c8\u55bd\uff0c\u5927\u5bb6\u597d\uff0c\u6211\u662f\u300a\u5f02\u4e16\u7b14\u5f55\u300b\u7684\u4f5c\u8005\uff0c\u4e00\u4e2a\u504f\u6267\u3001\u72c2\u70ed\u7684\u7406\u60f3\u4e3b\u4e49\u8005\u3002\u5728\u4e8c\u5341\u5c81\u7684\u67d0\u4e2a\u591c\u665a\uff0c\u6211\u7b2c\u4e00\u6b21\u8bda\u5b9e\u5730\u9762\u5bf9\u81ea\u5df1\u7684\u6b32\u671b\u548c\u6e34\u6c42\uff0c\u51b3\u5b9a\u5c06\u6bd5\u751f\u7684\u65f6\u95f4\u4e0e\u7cbe\u529b\uff0c\u6295\u5165\u5230\u5236\u4f5c 37 \u6b3e\u6e38\u620f \u4e4b\u4e2d\u3002\u8fd9\u662f\u4e00\u573a\u957f\u9014\u8dcb\u6d89\uff0c\u4f46\u6211\u59cb\u7ec8\u575a\u4fe1\uff0c\u552f\u6709\u575a\u6301\u624d\u80fd\u8ba9\u6211\u8131\u79bb\u540d\u4e3a\u5e73\u51e1\u7684\u6df1\u6e0a\u3002</p><p class=\"bb_paragraph\" >\u5173\u4e8e\u300a\u5f02\u4e16\u7b14\u5f55\u300b</p><p class=\"bb_paragraph\" >\u6700\u7ec8\u76ee\u6807\uff1a\u5b8c\u6574\u6253\u9020\u4e2d\u5ead\u4e4b\u5730\uff0c\u5305\u62ec\u56db\u4e2a\u56fd\u5bb6\u7684\u5168\u56fe\u5185\u5bb9\u3002\u8fd9\u662f\u4e00\u4e2a\u5e9e\u5927\u7684\u5de5\u7a0b\uff0c\u9884\u8ba1\u9700\u8981\u6570\u5e74\u65f6\u95f4\u5b8c\u6210\u3002</p><p class=\"bb_paragraph\" >\u672c\u4f5c\u5185\u5bb9\uff1a\u76ee\u524d\u5c06\u5448\u73b0\u585e\u7f57\u5766\u4e9a\u738b\u56fd\u7684\u6587\u6cfd\u4e0e\u94f6\u514b\u8fbe\u5c14\u4e24\u5883\uff0c\u540e\u7eed\u533a\u57df\u5c06\u4ee5 DLC \u548c\u7eed\u4f5c\u5f62\u5f0f\u63a8\u51fa\u3002\u8bf7\u653e\u5fc3\uff0c\u5b83\u4f1a\u4e00\u76f4\u66f4\u65b0\u5b8c\u5584\u7684\u3002</p><p class=\"bb_paragraph\" >\u9ad8\u5854\u4f2b\u7acb\u4e8e\u7fa4\u661f\u4e4b\u4e0b\uff0c\u795e\u706b\u5728\u541b\u738b\u7684\u738b\u5ea7\u4e0a\u71c3\u70e7\u3002 \u8fd9\u4e00\u9875\uff0c\u4e66\u5199\u7740\u4f60\u7684\u547d\u8fd0......</p><p class=\"bb_paragraph\" >\u5173\u4e8e\u6211\u4eec</p><p class=\"bb_paragraph\" ></p>",
    "short_description": "\u300a\u5f02\u4e16\u7b14\u5f55\u300b\u662f\u4ee5\u9ed1\u6697\u5947\u5e7b\u4e3a\u4e16\u754c\u89c2\u7684\u6587\u5b57\u5267\u60c5\u5411RPG\u6e38\u620f\u3002\u7a7f\u8d8a\u96fe\u6d77\u800c\u6765\u7684\u5e94\u9080\u4e4b\u4eba\uff0c\u6211\u8981\u6c42\u4f60\u5c65\u884c\u5951\u7ea6\uff0c\u5b8c\u6210\u4f7f\u547d\u3002\u524d\u5f80\u4e2d\u5ead\u4e4b\u5730\uff0c\u6500\u767b\u5206\u9694\u663c\u591c\u7684\u9ad8\u5854\uff0c\u593a\u56de\u541b\u738b\u7a83\u636e\u4e4b\u706b\uff0c\u89e3\u653e\u8bf8\u795e\u3002\u4f46\u8fd9\u91cc\u7684\u6218\u4e89\u672a\u66fe\u505c\u6b47\uff0c\u4fe1\u4ef0\u4e0e\u80cc\u53db\u4ea4\u7ec7\uff0c\u672a\u77e5\u7684\u6050\u6016\u5728\u9634\u5f71\u4e2d\u7aa5\u4f3a\u3002\u541b\u738b\u3001\u5b66\u8005\u3001\u5f02\u6559\u5f92\u3001\u96c7\u4f63\u5175\u2026\u2026\u4ed6\u4eec\u5728\u547d\u8fd0\u7684\u68cb\u76d8\u4e0a\u535a\u5f08\uff0c\u800c\u4f60\u53c8\u8be5\u5982\u4f55\u5728\u5386\u53f2\u7684\u6d6a\u6f6e\u4e2d\u6289\u62e9\uff1f",
