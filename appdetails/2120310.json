ysinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2120310/extras/4602476b27fb2dddf12647971948b0c3.poster.avif?t=1713367768\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2120310/extras/4602476b27fb2dddf12647971948b0c3.webm?t=1713367768\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2120310/extras/4602476b27fb2dddf12647971948b0c3.mp4?t=1713367768\" type=\"video/mp4\"></video></div>",
