red.akamai.steamstatic.com/store_item_assets/steam/apps/2110990/extras/c502bff0193314b769d2b8256ad1551d.mp4?t=1667487507\" type=\"video/mp4\"></video></div><br><br>Use physics to jump around the path.<br><br><div class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2110990/extras/e2366c5530ecec136bc5720cfc1882a0.poster.avif?t=1667487507\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2110990/extras/e2366c5530ecec136bc5720cfc1882a0.webm?t=1667487507\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2110990/extras/e2366c5530ecec136bc5720cfc1882a0.mp4?t=1667487507\" type=\"video/mp4\"></video></div><br><br>Some obstacles aren't happy to just stand still and take the hit.<br><br><div class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2110990/extras/ecf03be0af153d862f264db4240fdc13.poster.avif?t=1667487507\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2110990/extras/ecf03be0af153d862f264db4240fdc13.webm?t=1667487507\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2110990/extras/ecf03be0af153d862f264db4240fdc13.mp4?t=1667487507\" type=\"video/mp4\"></video></div><br><br>Go up to outer space!",
