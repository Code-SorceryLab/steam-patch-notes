extras/58bf7eed5d38b5e1c61e20856e45f179.poster.avif?t=1742554671\" width=600 height=338 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3047220/extras/58bf7eed5d38b5e1c61e20856e45f179.webm?t=1742554671\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3047220/extras/58bf7eed5d38b5e1c61e20856e45f179.mp4?t=1742554671\" type=\"video/mp4\"></video></span>",
