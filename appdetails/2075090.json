ss=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2075090/extras/b422728b998f3aabe355010dc8f9a1ec.poster.avif?t=1667385328\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2075090/extras/b422728b998f3aabe355010dc8f9a1ec.webm?t=1667385328\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2075090/extras/b422728b998f3aabe355010dc8f9a1ec.mp4?t=1667385328\" type=\"video/mp4\"></video></div>",
