    "detailed_description": "<h2 class=\"bb_tag\" ><strong><i><u>\u30b7\u30f3\u30d7\u30eb\u304b\u3064\u738b\u9053\u306a\u6b63\u7d71\u6d3e\u30b7\u30df\u30e5\u30ec\u30fc\u30b7\u30e7\u30f3RPG</u></i></strong></h2><p class=\"bb_paragraph\" >\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u90e8\u968a\u3092\u7387\u3044\u308b\u6307\u63ee\u5b98\u3068\u3057\u3066\u3001\u69d8\u3005\u306a\u500b\u6027\u3068\u80fd\u529b\u3092\u6301\u3064\u4ef2\u9593\u305f\u3061\u3092\u64cd\u4f5c\u3057\u3001\u6226\u5834\u3067\u306e\u52dd\u5229\u3092\u76ee\u6307\u3057\u307e\u3059\u3002\u52dd\u5229\u6761\u4ef6\u306b\u306f\u6575\u5c06\u306e\u6483\u7834\u4ee5\u5916\u306b\u3082\u3001\u62e0\u70b9\u306e\u5236\u5727\u3001\u96e2\u8131\u5730\u70b9\u3078\u306e\u5230\u9054\u3001\u7279\u5b9a\u306e\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306e\u8b77\u885b\u306a\u3069\u69d8\u3005\u3002</p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" ><strong><i><u>\u591a\u5f69\u306a\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3068\u738b\u9053\u306a\u6226\u8a18\u7269\u304c\u7e54\u308a\u306a\u3059\u4e88\u671f\u305b\u306c\u30b9\u30c8\u30fc\u30ea\u30fc</u></i></strong></h2><p class=\"bb_paragraph\" >\u672c\u4f5c\u306b\u306f\u3001\u69d8\u3005\u306a\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u304c\u767b\u5834\u3057\u307e\u3059\u3002\u305d\u308c\u305e\u308c\u304c\u7570\u306a\u3063\u305f\u7acb\u5834\u3084\u4e8b\u60c5\u3092\u62b1\u3048\u3001\u4ef2\u9593\u3068\u3044\u3046\u7acb\u5834\u3067\u306f\u306a\u304f\u3001\u6575\u3068\u3057\u3066\u73fe\u308c\u308b\u3053\u3068\u3082\u3042\u308a\u307e\u3059\u3002\u3057\u304b\u3057\u3001\u4ef2\u9593\u306b\u52a0\u5165\u3059\u308b\u6761\u4ef6\u3092\u6e80\u305f\u3059\u3053\u3068\u3067\u3001\u983c\u3082\u3057\u3044\u5473\u65b9\u3068\u3057\u3066\u6d3b\u8e8d\u3057\u3066\u304f\u308c\u307e\u3059\u3002\u307e\u305f\u3001\u4ef2\u9593\u4ee5\u5916\u306b\u3082\u69d8\u3005\u306a\u591a\u6570\u306e\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u304c\u5f37\u6575\u3068\u3057\u3066\u3001\u4e3b\u4eba\u516c\u9054\u306e\u524d\u306b\u7acb\u3061\u306f\u3060\u304b\u308a\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u3092\u82e6\u3057\u3081\u307e\u3059\u3002\u5f7c\u3089\u306e\u76ee\u7684\u3001\u305d\u3057\u3066\u3001\u6226\u4e71\u3092\u62db\u3044\u305f\u9ed2\u5e55\u306e\u6b63\u4f53\u3068\u306f\u2026</p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" ><strong><i><u>\u69d8\u3005\u306a\u30b2\u30fc\u30e0\u96e3\u6613\u5ea6</u></i></strong></h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u4ef2\u9593\u306e\u6210\u9577\u7387\u306a\u3069\u304c\u5927\u5e45\u306b\u4e0a\u6607\u3057\u3001\u723d\u5feb\u306a\u30d7\u30ec\u30a4\u304c\u53ef\u80fd\u306a\u300c\u7121\u53cc\u30e2\u30fc\u30c9\u300d</p></li></ul><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u5473\u65b9\u304c\u5012\u3055\u308c\u3066\u3082\u3001\u6b21\u7ae0\u3067\u5fa9\u5e30\u3059\u308b\u521d\u5fc3\u8005\u5411\u3051\u306e\u300c\u30ab\u30b8\u30e5\u30a2\u30eb\u300d</p></li><li><p class=\"bb_paragraph\" >\u5473\u65b9\u304c\u5012\u3055\u308c\u308b\u3068\u3001\u4e8c\u5ea6\u3068\u5fa9\u5e30\u3057\u306a\u3044\u719f\u7df4\u8005\u5411\u3051\u306e\u300c\u30ce\u30fc\u30de\u30eb\u300d\u300c\u30cf\u30fc\u30c9\u300d</p></li><li><p class=\"bb_paragraph\" >2\u5468\u76ee\u4ee5\u964d\u306b\u6311\u6226\u304c\u53ef\u80fd\u306a\u9ad8\u96e3\u6613\u5ea6\u300c\u30eb\u30ca\u30c6\u30a3\u30c3\u30af\u300d\u300c\u30a2\u30d3\u30b9\u300d</p></li></ul><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" ><strong><i><u>\u305d\u306e\u4ed6\u672c\u4f5c\u306e\u7279\u5fb4</u></i></strong></h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u6575\u304c\u6240\u6301\u3057\u3066\u3044\u308b\u6b66\u5668\u3092\u596a\u3046\u3053\u3068\u304c\u51fa\u6765\u308b\u53ce\u96c6\u6b32\u3092\u63bb\u304d\u7acb\u3066\u308b\u6355\u7e1b</p></li><li><p class=\"bb_paragraph\" >\u6240\u6709\u3057\u3066\u3044\u308b\u6b66\u5668\u3092\u5f37\u5316\u3067\u304d\u308b\u6b66\u5668\u932c\u6210\u3001\u5f37\u529b\u306a\u6b66\u5668\u3092\u751f\u6210\u3067\u304d\u308b\u6b66\u5668\u5408\u6210</p></li><li><p class=\"bb_paragraph\" >\u30ec\u30d9\u30eb\u304c\u4e0a\u304c\u308b\u969b\u306b\u69d8\u3005\u306a\u30b9\u30ad\u30eb\u3092\u53d6\u5f97\u3059\u308b\u500b\u6027\u3042\u308b50\u4eba\u4ee5\u4e0a\u306e\u4ef2\u9593\u30ad\u30e3\u30e9\u30af\u30bf\u30fc</p></li><li><p class=\"bb_paragraph\" >\u7279\u5b9a\u306e\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u540c\u58eb\u3067\u767a\u751f\u3059\u308b\u591a\u6570\u7528\u610f\u3055\u308c\u305f\u652f\u63f4\u4f1a\u8a71</p></li><li><p class=\"bb_paragraph\" >\u5404\u7ae0\u306b\u914d\u7f6e\u3055\u308c\u305f\u6575\u5c06\u3088\u308a\u5f37\u529b\u306a\u80fd\u529b\u3084\u30b9\u30ad\u30eb\u3092\u6301\u3064\u5f37\u6575</p></li><li><p class=\"bb_paragraph\" >\u3084\u308a\u3053\u307f\u30d7\u30ec\u30a4\u30e4\u30fc\u5411\u3051\u306e\u30ec\u30a2\u30e2\u30f3\u30b9\u30bf\u30fc\u3084\u30ec\u30a2\u30c9\u30ed\u30c3\u30d7</p></li><li><p class=\"bb_paragraph\" >\u60f3\u5b9a\u30af\u30ea\u30a2\u6642\u959370\u6642\u9593\u307b\u3069\u306e\u5927\u30dc\u30ea\u30e5\u30fc\u30e0\u306e\u30e1\u30a4\u30f3\u30b9\u30c8\u30fc\u30ea\u30fc</p></li><li><p class=\"bb_paragraph\" >\u30b9\u30c8\u30fc\u30ea\u30fc\u306e\u9032\u884c\u3068\u5171\u306b\u8ffd\u52a0\u3055\u308c\u308b\u8907\u6570\u306e\u80b2\u6210\u7528\u30d5\u30ea\u30fc\u30de\u30c3\u30d7</p></li><li><p class=\"bb_paragraph\" >2\u5468\u76ee\u4ee5\u964d\u4ef2\u9593\u306b\u3059\u308b\u3053\u3068\u304c\u51fa\u6765\u308b\u96a0\u3057\u30ad\u30e3\u30e9\u30af\u30bf\u30fc</p></li><li><p class=\"bb_paragraph\" >\u30af\u30ea\u30a2\u5f8c\u306b\u6311\u6226\u3067\u304d\u308b\u9ad8\u96e3\u6613\u5ea6\u306a\u30a8\u30af\u30b9\u30c8\u30e9\u30de\u30c3\u30d7</p></li><li><p class=\"bb_paragraph\" >\u7279\u5b9a\u6761\u4ef6\u3092\u6e80\u305f\u3059\u3053\u3068\u3067\u5230\u9054\u3067\u304d\u308b\u771f\u306e\u30a8\u30f3\u30c7\u30a3\u30f3\u30b0</p></li></ul>",
    "about_the_game": "<h2 class=\"bb_tag\" ><strong><i><u>\u30b7\u30f3\u30d7\u30eb\u304b\u3064\u738b\u9053\u306a\u6b63\u7d71\u6d3e\u30b7\u30df\u30e5\u30ec\u30fc\u30b7\u30e7\u30f3RPG</u></i></strong></h2><p class=\"bb_paragraph\" >\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u90e8\u968a\u3092\u7387\u3044\u308b\u6307\u63ee\u5b98\u3068\u3057\u3066\u3001\u69d8\u3005\u306a\u500b\u6027\u3068\u80fd\u529b\u3092\u6301\u3064\u4ef2\u9593\u305f\u3061\u3092\u64cd\u4f5c\u3057\u3001\u6226\u5834\u3067\u306e\u52dd\u5229\u3092\u76ee\u6307\u3057\u307e\u3059\u3002\u52dd\u5229\u6761\u4ef6\u306b\u306f\u6575\u5c06\u306e\u6483\u7834\u4ee5\u5916\u306b\u3082\u3001\u62e0\u70b9\u306e\u5236\u5727\u3001\u96e2\u8131\u5730\u70b9\u3078\u306e\u5230\u9054\u3001\u7279\u5b9a\u306e\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306e\u8b77\u885b\u306a\u3069\u69d8\u3005\u3002</p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" ><strong><i><u>\u591a\u5f69\u306a\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3068\u738b\u9053\u306a\u6226\u8a18\u7269\u304c\u7e54\u308a\u306a\u3059\u4e88\u671f\u305b\u306c\u30b9\u30c8\u30fc\u30ea\u30fc</u></i></strong></h2><p class=\"bb_paragraph\" >\u672c\u4f5c\u306b\u306f\u3001\u69d8\u3005\u306a\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u304c\u767b\u5834\u3057\u307e\u3059\u3002\u305d\u308c\u305e\u308c\u304c\u7570\u306a\u3063\u305f\u7acb\u5834\u3084\u4e8b\u60c5\u3092\u62b1\u3048\u3001\u4ef2\u9593\u3068\u3044\u3046\u7acb\u5834\u3067\u306f\u306a\u304f\u3001\u6575\u3068\u3057\u3066\u73fe\u308c\u308b\u3053\u3068\u3082\u3042\u308a\u307e\u3059\u3002\u3057\u304b\u3057\u3001\u4ef2\u9593\u306b\u52a0\u5165\u3059\u308b\u6761\u4ef6\u3092\u6e80\u305f\u3059\u3053\u3068\u3067\u3001\u983c\u3082\u3057\u3044\u5473\u65b9\u3068\u3057\u3066\u6d3b\u8e8d\u3057\u3066\u304f\u308c\u307e\u3059\u3002\u307e\u305f\u3001\u4ef2\u9593\u4ee5\u5916\u306b\u3082\u69d8\u3005\u306a\u591a\u6570\u306e\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u304c\u5f37\u6575\u3068\u3057\u3066\u3001\u4e3b\u4eba\u516c\u9054\u306e\u524d\u306b\u7acb\u3061\u306f\u3060\u304b\u308a\u3001\u30d7\u30ec\u30a4\u30e4\u30fc\u3092\u82e6\u3057\u3081\u307e\u3059\u3002\u5f7c\u3089\u306e\u76ee\u7684\u3001\u305d\u3057\u3066\u3001\u6226\u4e71\u3092\u62db\u3044\u305f\u9ed2\u5e55\u306e\u6b63\u4f53\u3068\u306f\u2026</p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" ><strong><i><u>\u69d8\u3005\u306a\u30b2\u30fc\u30e0\u96e3\u6613\u5ea6</u></i></strong></h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u4ef2\u9593\u306e\u6210\u9577\u7387\u306a\u3069\u304c\u5927\u5e45\u306b\u4e0a\u6607\u3057\u3001\u723d\u5feb\u306a\u30d7\u30ec\u30a4\u304c\u53ef\u80fd\u306a\u300c\u7121\u53cc\u30e2\u30fc\u30c9\u300d</p></li></ul><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u5473\u65b9\u304c\u5012\u3055\u308c\u3066\u3082\u3001\u6b21\u7ae0\u3067\u5fa9\u5e30\u3059\u308b\u521d\u5fc3\u8005\u5411\u3051\u306e\u300c\u30ab\u30b8\u30e5\u30a2\u30eb\u300d</p></li><li><p class=\"bb_paragraph\" >\u5473\u65b9\u304c\u5012\u3055\u308c\u308b\u3068\u3001\u4e8c\u5ea6\u3068\u5fa9\u5e30\u3057\u306a\u3044\u719f\u7df4\u8005\u5411\u3051\u306e\u300c\u30ce\u30fc\u30de\u30eb\u300d\u300c\u30cf\u30fc\u30c9\u300d</p></li><li><p class=\"bb_paragraph\" >2\u5468\u76ee\u4ee5\u964d\u306b\u6311\u6226\u304c\u53ef\u80fd\u306a\u9ad8\u96e3\u6613\u5ea6\u300c\u30eb\u30ca\u30c6\u30a3\u30c3\u30af\u300d\u300c\u30a2\u30d3\u30b9\u300d</p></li></ul><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" ><strong><i><u>\u305d\u306e\u4ed6\u672c\u4f5c\u306e\u7279\u5fb4</u></i></strong></h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u6575\u304c\u6240\u6301\u3057\u3066\u3044\u308b\u6b66\u5668\u3092\u596a\u3046\u3053\u3068\u304c\u51fa\u6765\u308b\u53ce\u96c6\u6b32\u3092\u63bb\u304d\u7acb\u3066\u308b\u6355\u7e1b</p></li><li><p class=\"bb_paragraph\" >\u6240\u6709\u3057\u3066\u3044\u308b\u6b66\u5668\u3092\u5f37\u5316\u3067\u304d\u308b\u6b66\u5668\u932c\u6210\u3001\u5f37\u529b\u306a\u6b66\u5668\u3092\u751f\u6210\u3067\u304d\u308b\u6b66\u5668\u5408\u6210</p></li><li><p class=\"bb_paragraph\" >\u30ec\u30d9\u30eb\u304c\u4e0a\u304c\u308b\u969b\u306b\u69d8\u3005\u306a\u30b9\u30ad\u30eb\u3092\u53d6\u5f97\u3059\u308b\u500b\u6027\u3042\u308b50\u4eba\u4ee5\u4e0a\u306e\u4ef2\u9593\u30ad\u30e3\u30e9\u30af\u30bf\u30fc</p></li><li><p class=\"bb_paragraph\" >\u7279\u5b9a\u306e\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u540c\u58eb\u3067\u767a\u751f\u3059\u308b\u591a\u6570\u7528\u610f\u3055\u308c\u305f\u652f\u63f4\u4f1a\u8a71</p></li><li><p class=\"bb_paragraph\" >\u5404\u7ae0\u306b\u914d\u7f6e\u3055\u308c\u305f\u6575\u5c06\u3088\u308a\u5f37\u529b\u306a\u80fd\u529b\u3084\u30b9\u30ad\u30eb\u3092\u6301\u3064\u5f37\u6575</p></li><li><p class=\"bb_paragraph\" >\u3084\u308a\u3053\u307f\u30d7\u30ec\u30a4\u30e4\u30fc\u5411\u3051\u306e\u30ec\u30a2\u30e2\u30f3\u30b9\u30bf\u30fc\u3084\u30ec\u30a2\u30c9\u30ed\u30c3\u30d7</p></li><li><p class=\"bb_paragraph\" >\u60f3\u5b9a\u30af\u30ea\u30a2\u6642\u959370\u6642\u9593\u307b\u3069\u306e\u5927\u30dc\u30ea\u30e5\u30fc\u30e0\u306e\u30e1\u30a4\u30f3\u30b9\u30c8\u30fc\u30ea\u30fc</p></li><li><p class=\"bb_paragraph\" >\u30b9\u30c8\u30fc\u30ea\u30fc\u306e\u9032\u884c\u3068\u5171\u306b\u8ffd\u52a0\u3055\u308c\u308b\u8907\u6570\u306e\u80b2\u6210\u7528\u30d5\u30ea\u30fc\u30de\u30c3\u30d7</p></li><li><p class=\"bb_paragraph\" >2\u5468\u76ee\u4ee5\u964d\u4ef2\u9593\u306b\u3059\u308b\u3053\u3068\u304c\u51fa\u6765\u308b\u96a0\u3057\u30ad\u30e3\u30e9\u30af\u30bf\u30fc</p></li><li><p class=\"bb_paragraph\" >\u30af\u30ea\u30a2\u5f8c\u306b\u6311\u6226\u3067\u304d\u308b\u9ad8\u96e3\u6613\u5ea6\u306a\u30a8\u30af\u30b9\u30c8\u30e9\u30de\u30c3\u30d7</p></li><li><p class=\"bb_paragraph\" >\u7279\u5b9a\u6761\u4ef6\u3092\u6e80\u305f\u3059\u3053\u3068\u3067\u5230\u9054\u3067\u304d\u308b\u771f\u306e\u30a8\u30f3\u30c7\u30a3\u30f3\u30b0</p></li></ul>",
    "short_description": "\u300c\u5b88\u8b77\u8005\u300d\u3068\u547c\u3070\u308c\u308b\u4eba\u667a\u3092\u8d85\u3048\u308b\u529b\u3092\u6301\u3064\u8005\u304c\u5b58\u5728\u3059\u308b\u30d5\u30a1\u30eb\u30cd\u30a2\u5927\u9678\u3092\u821e\u53f0\u306b\u3001\u5b88\u8b77\u8005\u306e\u606f\u5b50\u3067\u3042\u308b\u30a2\u30fc\u30bc\u30b9\u304c\u5927\u9678\u7d71\u4e00\u3092\u63b2\u3052\u308b\u30eb\u30bc\u30ed\u30a2\u5e1d\u56fd\u3068\u305d\u306e\u6226\u4e71\u306e\u4e2d\u3067\u6697\u8e8d\u3059\u308b\u8005\u9054\u3068\u306e\u6226\u3044\u3092\u63cf\u304f\u3001\u738b\u9053\u6226\u8a18\u7269\u30d5\u30a1\u30f3\u30bf\u30b8\u30fcSRPG",
