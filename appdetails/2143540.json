webm?t=1725000949\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2143540/extras/22a2cdcd90efb93791712eb1a9231a03.mp4?t=1725000949\" type=\"video/mp4\"></video></div><br>Select from three bespoke hand gestures (rock, paper or scissors) and strategically deploy them in battle!<br>Strike the target as you make your move!<h2 class=\"bb_tag\">Features</h2><ul class=\"bb_ul\"><li>Easy-to-understand fighting system<br></li><li>Five \u0336h\u0336a\u0336r\u0336e\u0336m\u0336 \u0336m\u0336e\u0336m\u0336b\u0336e\u0336r\u0336s\u0336 boss characters with five different attributes<br></li><li>Sixteen animated H-scenes</li></ul><h2 class=\"bb_tag\">Characters</h2><div class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline crossorigin=\"anonymous\" poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2143540/extras/253567afb64036c40858fcbee5a9b7bc.poster.avif?t=1725000949\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2143540/extras/253567afb64036c40858fcbee5a9b7bc.webm?t=1725000949\" type=\"video/webm; codecs=vp9\"></video></div><br><div class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline crossorigin=\"anonymous\" poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2143540/extras/ae3961588c3347ae3012c5b7c581c969.poster.avif?t=1725000949\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2143540/extras/ae3961588c3347ae3012c5b7c581c969.webm?t=1725000949\" type=\"video/webm; codecs=vp9\"></video></div><br><div class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline crossorigin=\"anonymous\" poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2143540/extras/35414b6de7453887dddc0838e6567d68.poster.avif?t=1725000949\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2143540/extras/3