_tag\" ><strong>\u672a\u6765\u613f\u666f\uff1a</strong> <br>\u6211\u4eec\u7684\u76ee\u6807\u662f\u5c06\u8fd9\u6b3e\u6e38\u620f\u6253\u9020\u4e3a\u4e00\u6b3e<strong>\u6df1\u5ea6\u5341\u8db3\u3001\u5185\u5bb9\u4e30\u5bcc\u3001\u91cd\u73a9\u6027\u6781\u9ad8\u7684Roguelike\u5361\u724c\u4f73\u4f5c</strong>\u3002\u867d\u7136\u73b0\u5728\u53ea\u662f\u8d77\u70b9\uff0c\u4f46\u6211\u4eec\u5145\u6ee1\u70ed\u60c5\uff0c\u5e76\u81f4\u529b\u4e8e\u901a\u8fc7\u6301\u7eed\u4e0d\u65ad\u7684\u66f4\u65b0\u548c\u4f18\u5316\uff0c\u8ba9\u5b83\u9010\u6e10\u7efd\u653e\u5149\u5f69\u3002</h2><h2 class=\"bb_tag\" ><strong>\u8bda\u9080\u53c2\u4e0e\uff1a</strong> <br>\u5982\u679c\u60a8\u70ed\u7231\u5361\u724c\u6784\u7b51\u548cRoguelike\u6311\u6218\uff0c\u6b22\u8fce\u73b0\u5728\u5c31\u52a0\u5165\u62a2\u5148\u4f53\u9a8c\uff01\u60a8\u7684\u652f\u6301\u4e0e\u53cd\u9988\u5c06\u76f4\u63a5\u52a9\u529b\u6e38\u620f\u7684\u6210\u957f\uff0c\u5171\u540c\u5851\u9020\u8fd9\u4e2a\u6fc0\u52a8\u4eba\u5fc3\u7684\u722c\u5854\u4e16\u754c\u3002</h2>",
    "about_the_game": "<h2 class=\"bb_tag\" >\u8e0f\u4e0a\u7b56\u7565\u6784\u7b51\u7684\u722c\u5854\u4e4b\u65c5\uff01 \u8fd9\u662f\u4e00\u6b3eRoguelike\u5361\u724c\u6e38\u620f\u3002\u76ee\u524d\u5904\u4e8e\u62a2\u5148\u4f53\u9a8c\u9636\u6bb5\uff0c\u60a8\u5c06\u63a2\u7d22\u9996\u4e2a\u7cbe\u5fc3\u8bbe\u8ba1\u7684\u5173\u5361\uff0c\u6311\u6218\u72ec\u7279\u7684\u654c\u4eba\uff0c\u5e76\u6784\u7b51\u60a8\u7684\u5f3a\u529b\u5361\u7ec4\u3002\u5f00\u53d1\u8005\u627f\u8bfa\u6bcf\u4e24\u5468\u81f3\u5c11\u66f4\u65b0\u4e00\u6b21\uff0c\u6301\u7eed\u5e26\u6765\u65b0\u5730\u56fe\u3001\u65b0\u5361\u724c\u3001\u65b0\u654c\u4eba\uff0c\u76ee\u6807\u662f\u6253\u9020\u4e00\u4e2a\u4e30\u5bcc\u591a\u53d8\u3001\u5145\u6ee1\u6311\u6218\u7684\u722c\u5854\u4f53\u9a8c\u3002\u52a0\u5165\u6211\u4eec\uff0c\u89c1\u8bc1\u6e38\u620f\u7684\u6210\u957f\uff01</h2><h2 class=\"bb_tag\" ><strong>\u6838\u5fc3\u4f53\u9a8c\uff1a</strong></h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>Roguelike\u5361\u724c\u6784\u7b51\uff1a</strong> \u6bcf\u4e00\u6b21\u722c\u5854\u90fd\u662f\u5168\u65b0\u7684\u65c5\u7a0b\uff01\u968f\u673a\u906d\u9047\u3001\u5361\u724c\u5956\u52b1\u548c\u672a\u77e5\u4e8b\u4ef6\uff0c\u5e26\u6765\u65e0\u9650\u7684\u53ef\u73a9\u6027\u3002</p></li><li><p class=\"bb_paragraph\" ><strong>\u7b56\u7565\u6027\u6218\u6597\uff1a</strong> \u7cbe\u5fc3\u8bbe\u8ba1\u654c\u4eba\u548cBoss\uff0c\u9700\u8981\u4f60\u7075\u6d3b\u8fd0\u7528\u5361\u724c\uff0c\u5236\u5b9a\u72ec\u7279\u7684\u6218\u6597\u7b56\u7565\u3002</p></li><li><p class=\"bb_paragraph\" ><strong>\u722c\u5854\u6311\u6218\uff1a</strong> \u5c42\u5c42\u6500\u767b\uff0c\u96be\u5ea6\u9012\u589e\uff0c\u8003\u9a8c\u4f60\u7684\u5361\u7ec4\u6784\u7b51\u548c\u4e34\u573a\u51b3\u7b56\u80fd\u529b\u3002</p></li></ul><h2 class=\"bb_tag\" ><strong>\u5f53\u524d\u7248\u672c (\u62a2\u5148\u4f53\u9a8c)\uff1a</strong></h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u9996\u4e2a\u5b8c\u6574\u53ef\u73a9\u5730\u56fe\u73b0\u5df2\u5f00\u653e\uff0c\u5305\u542b\u7cbe\u5fc3\u8bbe\u8ba1\u7684\u654c\u4eba\u9635\u5bb9\u548c\u521d\u59cb\u5361\u6c60\u3002</p></li><li><p class=\"bb_paragraph\" >\u57fa\u7840Roguelike\u5faa\u73af\uff08\u6218\u6597\u3001\u5956\u52b1\u3001\u6289\u62e9\u3001Boss\u6218\uff09\u5df2\u5b9e\u73b0\u3002</p></li></ul><h2 class=\"bb_tag\" ><strong>\u5f00\u53d1\u8def\u7ebf\u56fe\u4e0e\u627f\u8bfa\uff1a</strong></h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>\u9ad8\u9891\u66f4\u65b0\uff1a</strong> \u6211\u4eec\u627f\u8bfa<strong>\u6bcf\u4e24\u5468\u81f3\u5c11\u53d1\u5e03\u4e00\u6b21\u5185\u5bb9\u66f4\u65b0</strong>\uff0c\u786e\u4fdd\u6e38\u620f\u6301\u7eed\u8fdb\u5316\u3002</p></li><li><p class=\"bb_paragraph\" ><strong>\u4e30\u5bcc\u5185\u5bb9\uff1a</strong> \u66f4\u65b0\u7684\u6838\u5fc3\u5c06\u805a\u7126\u4e8e\uff1a</p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>\u65b0\u5730\u56fe\u4e0e\u73af\u5883\uff1a</strong> \u62d3\u5c55\u722c\u5854\u7684\u4e16\u754c\uff0c\u5e26\u6765\u622a\u7136\u4e0d\u540c\u7684\u6311\u6218\u573a\u666f\u3002</p></li><li><p class=\"bb_paragraph\" ><strong>\u6d77\u91cf\u65b0\u5361\u724c\uff1a</strong> \u4e0d\u65ad\u6269\u5145\u5361\u6c60\uff0c\u89e3\u9501\u66f4\u591a\u6d41\u6d3e\u4e0e\u6218\u672f\u7ec4\u5408\u3002</p></li><li><p class=\"bb_paragraph\" ><strong>\u591a\u6837\u65b0\u654c\u4eba\u4e0eBoss\uff1a</strong> \u5927\u5e45\u589e\u52a0\u654c\u4eba\u79cd\u7c7b\u548c\u72ec\u7279\u673a\u5236\uff0c\u4fdd\u8bc1\u6218\u6597\u7684\u6df1\u5ea6\u4e0e\u65b0\u9c9c\u611f\u3002\u6211\u4eec\u6df1\u77e5\uff0c\u4e30\u5bcc\u7684\u654c\u4eba\u5e93\u662f\u4f18\u79c0\u8089\u9e3d\u4f53\u9a8c\u7684\u6838\u5fc3\uff01</p></li></ul></li><li><p class=\"bb_paragraph\" ><strong>\u503e\u542c\u793e\u533a\uff1a</strong> \u73a9\u5bb6\u7684\u53cd\u9988\u81f3\u5173\u91cd\u8981\uff01\u6211\u4eec\u5c06\u5bc6\u5207\u5173\u6ce8\u793e\u533a\u5efa\u8bae\uff0c\u8ba9\u6e38\u620f\u5728\u5927\u5bb6\u7684\u5e2e\u52a9\u4e0b\u53d8\u5f97\u66f4\u597d\u3002</p></li></ul><h2 class=\"bb_tag\" ><strong>\u672a\u6765\u613f\u666f\uff1a</strong> <br>\u6211\u4eec\u7684\u76ee\u6807\u662f\u5c06\u8fd9\u6b3e\u6e38\u620f\u6253\u9020\u4e3a\u4e00\u6b3e<strong>\u6df1\u5ea6\u5341\u8db3\u3001\u5185\u5bb9\u4e30\u5bcc\u3001\u91cd\u73a9\u6027\u6781\u9ad8\u7684Roguelike\u5361\u724c\u4f73\u4f5c</strong>\u3002\u867d\u7136\u73b0\u5728\u53ea\u662f\u8d77\u70b9\uff0c\u4f46\u6211\u4eec\u5145\u6ee1\u70ed\u60c5\uff0c\u5e76\u81f4\u529b\u4e8e\u901a\u8fc7\u6301\u7eed\u4e0d\u65ad\u7684\u66f4\u65b0\u548c\u4f18\u5316\uff0c\u8ba9\u5b83\u9010\u6e10\u7efd\u653e\u5149\u5f69\u3002</h2><h2 class=\"bb_tag\" ><strong>\u8bda\u9080\u53c2\u4e0e\uff1a</strong> <br>\u5982\u679c\u60a8\u70ed\u7231\u5361\u724c\u6784\u7b51\u548cRoguelike\u6311\u6218\uff0c\u6b22\u8fce\u73b0\u5728\u5c31\u52a0\u5165\u62a2\u5148\u4f53\u9a8c\uff01\u60a8\u7684\u652f\u6301\u4e0e\u53cd\u9988\u5c06\u76f4\u63a5\u52a9\u529b\u6e38\u620f\u7684\u6210\u957f\uff0c\u5171\u540c\u5851\u9020\u8fd9\u4e2a\u6fc0\u52a8\u4eba\u5fc3\u7684\u722c\u5854\u4e16\u754c\u3002</h2>",
