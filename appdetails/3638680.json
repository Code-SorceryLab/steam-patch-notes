{
    "type": "game",
    "name": "\u4e0b\u4e00\u7ad9\u9752\u57ce",
    "steam_appid": 3638680,
    "required_age": "13",
    "is_free": false,
    "detailed_description": "<p class=\"bb_paragraph\" >\u6211\u6709\u4e00\u5251\uff0c\u53ef\u642c\u5c71\u3001\u5fa1\u98ce\u3001\u51fa\u5165\u9752\u51a5\u3001\u7ffb\u8f6c\u795e\u9b54\uff01</p><p class=\"bb_paragraph\" >\u6211\u6709\u4e00\u57ce\uff0c\u53ef\u5c01\u7985\u3001\u796d\u7940\u3001\u78a7\u843d\u9ec4\u6cc9\u3001\u9547\u538b\u5996\u9b3c\uff01</p><p class=\"bb_paragraph\" >\u6211\u5bfb\u9f99\u70b9\u7a74\u3001\u8e0f\u7f61\u5e03\u6597\uff0c\u70bc\u5c06\u81e3\u65f1\u9b43\u3001\u7ea2\u5c18\u900d\u9065\uff01</p><p class=\"bb_paragraph\" >\u6211\u89c2\u661f\u671b\u6c14\u3001\u865a\u7a7a\u753b\u7b26\uff0c\u9a6d\u5996\u9b3c\u90aa\u795f\u3001\u5929\u5e08\u6b63\u6cd5\uff01</p><p class=\"bb_paragraph\" >\u6709\u90a3\u519c\u5bb6\u5b50\uff0c\u7ec7\u6851\u5f04\u9526\u3001\u4e00\u5339\u8700\u7ee3\u5c55\u5c71\u6cb3\u4e07\u91cc\uff0c</p><p class=\"bb_paragraph\" >\u4e5f\u6709\u90a3\u6e14\u592b\u8d70\u5352\uff0c\u56f4\u7089\u73cd\u9990\u3001\u65b9\u5bf8\u4e4b\u95f4\u54c1\u70df\u706b\u4eba\u95f4\u3002</p><p class=\"bb_paragraph\" >\u3002\u3002\u3002</p><p class=\"bb_paragraph\" >\u9752\u57ce\uff0c\u662f\u6211\u4eec\u5de5\u4f5c\u5ba4\u5236\u4f5c\u7684\u7b2c\u4e09\u4ee3\u5f00\u653e\u4e16\u754c\u3001\u56fd\u98ce\u795e\u8bdd\u5355\u673a\uff0c\u4e5f\u662f\u552f\u4e00\u4e00\u6b3e\u8001\u6eda5\u3001GTA like\u7684\u5927\u578b\u56fd\u98ce\u5355\u673a! \u9664\u5f00\u4f20\u7edf\u5f00\u653e\u4e16\u754c\u73a9\u6cd5\u5185\u5bb9\u5916\uff0c\u5728\u8fd9\u4e2a\u65e0\u7f1d\u5927\u4e16\u754c\u91cc\uff1a\u4e0a\u6709\u4e09\u95e8\u201c\u5251\u4ed9\u51fa\u5165\u9752\u51a5\u3001\u5112\u8005\u9f50\u5bb6\u6cbb\u56fd\u3001\u4f5b\u9640\u884c\u8d70\u4eba\u95f4\u201d\uff0c\u4e0b\u6709\u504f\u95e8\u4e5d\u6d41\u201c\u95ee\u535c\u3001\u70bc\u5c38\u3001\u9a6d\u9b3c\u3001\u5deb\u86ca\u3001\u5316\u5996\u3001\u673a\u5173\u3001\u5bfb\u9f99\u5012\u6597\uff1a\u3001\u8e0f\u7f61\u5e03\u9635\u3001\u6446\u575b\u8d77\u7b26\u201d\u7b49\u7b49\u3002</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\u4e00\u3001\u6838\u5fc3\u7279\u8272</p><p class=\"bb_paragraph\" >1.\uff08\u5bfb\u4ed9\uff09\u4e0a\u4e09\u95e8\uff1a</p><p class=\"bb_paragraph\" ><strong><u>1)\u9752\u57ce\u5251\u4ed9\uff1a\u53ef\u4ee5\u6c14\u5fa1\u5251\u3001\u53ef\u4eba\u5251\u5408\u4e00\u3001\u53ef\u4e0e\u504f\u95e8\u201c\u8e0f\u7f61\u5e03\u9635\u201d\u7ed3\u5408\u5e03\u4e13\u5c5e\u5251\u9635</u></strong></p><p class=\"bb_paragraph\" >2)\u5112\u95e8\u4e66\u751f\uff1a\u53ef\u8d70\u79d1\u4e3e\uff08\u671d\u5802\uff09\u3001\u6587\u4f1a\uff08\u6c5f\u6e56\uff09\u7b49\u8def\u7ebf\uff0c\u4e0e\u4e3b\u7ebf\u6df1\u5ea6\u7ed3\u5408\uff0c\u53ef\u4fee\u6d69\u7136\u6b63\u6c14\u4e13\u514b\u5996\u9b54\uff01\u53ef\u4e0e\u5e02\u4e95\u767e\u4e1a\u8bf8\u591a\u6587\u5316\u4f20\u627f\u6df1\u5ea6\u7ed3\u5408\u6bd4\u5982\u201c\u8700\u7ee3\u3001\u82cf\u9526\u3001\u5efa\u76cf\u3001\u5927\u6f06\u201d\uff0c\u6bd4\u5982\u8700\u7ee3-\u5343\u91cc\u6c5f\u5c71 vs \u795e\u8bdd-\u8bdb\u4ed9\u5251\u9635\uff01</p><p class=\"bb_paragraph\" >3)\u4f20\u4e16\u4f5b\u5f92\uff1a\u4fe1\u4ef0\u4f20\u627f\u4e0e\u4fe1\u5f92\u4e4b\u4e89\uff0c\u53ef\u4e0e\u8bf8\u52bf\u529b\u4e00\u8d77\u5f00\u542f\u95e8\u6d3e\u73a9\u6cd5\u201c\u4e13\u5c5e\u5267\u60c5\u3001\u795e\u901a\u6cd5\u5b9d\u3001\u95e8\u6d3e\u7ecf\u8425\u3001\u4e16\u754c\u5360\u9886\u3001\u5730\u56fe\u5efa\u9020\u3001\u6700\u7ec8\u7684\u95e8\u6d3e\u5f81\u4f10\u201d</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >2.\uff08\u8d85\u51e1\uff09\u4e0b\u4e5d\u6d41\uff08\u504f\u95e8\uff09\uff1a</p><p class=\"bb_paragraph\" >1)\u76f8\u5e08\uff1a\u53ef\u95ee\u535c\u5360\u661f\uff0c\u53ef\u64cd\u4f5c\u5929\u8c61\uff08\u8282\u6c14\u3001\u98ce\u96f7\u7b49\u7b49\uff09</p><p class=\"bb_paragraph\" ><strong><u>2)\u70bc\u5c38\uff1a\u8305\u5c71\u9053\u58eb\u4f20\u627f\u7ed3\u5408\u6e58\u897f\u5f02\u672f\u201c\u5907\u5c38\u3001\u5bfb\u7a74\u3001\u70bc\u5236\u3001\u5929\u52ab\u201d</u></strong></p><p class=\"bb_paragraph\" >3)\u9a6d\u9b3c\uff1a\u9634\u9633\u5148\u751f\u4f20\u627f\u7ed3\u5408\u795e\u79d8\u590d\u82cf</p><p class=\"bb_paragraph\" >4)\u5deb\u86ca\uff1a\u4e94\u4ed9\u6559\u3001\u4e94\u6bd2\u6559\u3001\u795e\u79d8\u65cf\u7fa4\u6765\u81ea\u4e0a\u53e4\u5deb\u796d\u7684\u4f20\u627f</p><p class=\"bb_paragraph\" >5)\u5316\u5996\uff1a\u90e8\u5206\u5929\u8d4b\u4fee\u58eb\uff0c\u53ef\u6536\u96c6\u65f6\u95f4\u5927\u5996\u8840\u8109\u53d8\u8eab\u4e3a\u5de8\u5996\u5f81\u6218\u5929\u5730\uff08\u6ce8\uff1a\u6b64\u73a9\u6cd5\u4f1a\u4f34\u968f\u7740\u8d44\u6599\u7247\u6301\u7eed\u66f4\u65b0\u3001\u56e0\u4e3a\u6bcf\u79cd\u8840\u8109\u53d8\u8eab\u7684\u52a8\u4f5c\u6218\u6597\u64cd\u4f5c\u90fd\u7b49\u540c\u4e8e\u8c03\u8bd5\u4e00\u4e2a\u65b0boss\uff09</p><p class=\"bb_paragraph\" >6)\u673a\u5173\uff1a\u90e8\u5206\u5929\u8d4b\u4fee\u58eb\uff0c\u53ef\u5c06\u5e02\u4e95\u6728\u5de5\u4e0e\u4e0a\u53e4\u58a8\u5bb6\u673a\u5173\u3001\u516c\u8f93\u5f02\u672f\u7ed3\u5408\u8d77\u6765\u5f62\u6210\u5a01\u529b\u5de8\u5927\u7684\u795e\u673a\u767e\u70bc\uff08\u8be5\u6574\u4f53\u4f53\u7cfb\u4f5c\u4e3a\u4eca\u5e74\u53d1\u5e03\u540e\u7684\u7b2c\u4e00\u4e2a\u6708\u7b2c\u4e00\u4e2a\u8d44\u6599\u7247\u66f4\u65b0\u7ed9\u5927\u5bb6\uff09</p><p class=\"bb_paragraph\" ><strong><u>7)\u5bfb\u9f99\u5012\u6597\uff1a\u90e8\u5206\u5929\u8d4b\u4fee\u58eb\uff0c\u53ef\u5c06\u76f8\u5e08\u5f02\u672f\u4e0e\u98ce\u6c34\u7ed3\u5408\u201c\u5bfb\u9f99\u70b9\u7a74\uff0c\u89e3\u5bc6\u5012\u6597\u201d</u></strong></p><p class=\"bb_paragraph\" ><strong><u>8)\u8e0f\u7f61\u5e03\u9635\uff1a\u8e0f\u7f61\u5e03\u6597\u3001\u70bc\u9635\u5e03\u9635\uff1b\u90e8\u5206\u5929\u8d4b\u4fee\u58eb\u53ef\u5c06\u5176\u4e0e\u9752\u57ce\u5251\u4ed9\u4e00\u8109\u4f20\u627f\u7ed3\u5408\u6210\u201c\u5251\u9635\u4e4b\u9053\u201d</u></strong></p><p class=\"bb_paragraph\" >9)\u6446\u644a\u8d77\u7b26\uff1a\u90e8\u5206\u5929\u8d4b\u4fee\u58eb\u53ef\u5c06\u8305\u5c71\u3001\u9634\u9633\u7b49\u8d85\u51e1\u4f20\u627f\u4e0e\u5e02\u4e95\u767e\u6001\u7684\u6587\u5316\u4f20\u627f\u5982\u201c\u5927\u6f06\u3001\u9020\u7eb8\u3001\u6731\u7802\u7b49\u201d\u7ed3\u5408\u5f62\u6210\u4e13\u5c5e\u7684\u901a\u5929\u7b26\u7bc6\u6548\u679c</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >3.\uff08\u4eba\u4e16\u95f4\uff09\u5e02\u4e95\u767e\u4e1a\uff1a</p><p class=\"bb_paragraph\" >1)\u666e\u901a\uff1a<strong><u>\u5de5\u5320\u3001\u519c\u592b\u3001\u6728\u5320\u3001\u6e14\u6c11\u3001\u5b98\u5e9c\u3001\u7eff\u6797</u></strong>\u3001\u9556\u5e08\u7b49\u7b49</p><p class=\"bb_paragraph\" >2)\u975e\u9057\uff1a\u7ee3\u5a18\uff08<strong><u>\u8700\u7ee3</u></strong>\u3001\u82cf\u9526\uff09\u3001\u58a8\u5bb6\uff08\u673a\u5173\u3001\u69ab\u536f\u7b49\uff09\u7b49\u7b49\uff08<strong><u>\u7b2c\u4e00\u4e2a\u7248\u672c\u5927\u6982\u5728\u4e09\u5341\u591a\u79cd\u76f8\u5173\u6280\u672f\u5de5\u827a</u></strong>\uff09</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\u4e8c\u3001<strong><u>\u73a9\u6cd5</u></strong>\uff08\u5e38\u89c4\u5f00\u653e\u4e16\u754c\u73a9\u6cd5\uff09\uff1a</p><p class=\"bb_paragraph\" >1.<strong><u>\u51fa\u8eab</u></strong>\uff1a\u66f4\u591a\u7684\u4eba\u751f\u53ef\u9009\u9879\uff0c\u4e0d\u540c\u7684\u7cbe\u5f69\u6545\u4e8b\uff08\u5982\u540c\u6211\u4eec\u4e0a\u4e00\u4ee3\u4f5c\u54c1\u7684\u5267\u60c5\u4e3b\u89d2\u51fa\u8eab\uff09</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >2.<strong><u>\u771f\u5b9e</u></strong>\uff1a</p><p class=\"bb_paragraph\" >1)\u8eab\u4efd\u4eba\u751f:\u8d4b\u4e88\u5927\u4e16\u754c\u4e0d\u540c\u7684\u89d2\u8272\u4e0d\u540c\u7684\u8eab\u4efd\u4e0e\u4e0d\u540c\u7684\u4eba\u751f\u6545\u4e8b</p><p class=\"bb_paragraph\" >2)\u4e16\u754c\u54cd\u5e94\uff1a\u5728\u4e0a\u4e00\u4f5c\u4e2d\uff0c\u4e3b\u89d2\u7684\u6240\u62e5\u6709\u7684\u5e02\u4e95\u8eab\u4efd\u73a9\u6cd5\u53ca\u89c4\u5219\u5c06\u5f52\u5c5e\u5230\u6bcf\u4e00\u4e2aNPC\u8eab\u4e0a\uff1a\u519c\u6c11\u65e5\u51fa\u800c\u4f5c\u65e5\u843d\u800c\u606f\u3001\u6e14\u6c11\u5f52\u6765\u5356\u9c7c\u6cbd\u9152\u3001\u6446\u644a\u5f52\u6765\u7684\u4e08\u592b\u5728\u70c2\u9189\u7ea6\u8d4c\uff1b\u6bcf\u4e00\u4e2aNPC\u90fd\u5c06\u62e5\u6709\u81ea\u5df1\u7684\u8eab\u4efd\u53ca\u751f\u6d3b\uff0c\u6700\u540e\u4e0e\u73a9\u5bb6\u4ea4\u4e92\u51fa\u72ec\u4e00\u65e0\u4e8c\u7684\u4e16\u754c\u4f53\u9a8c\u3002</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >3.<strong><u>\u7269\u7406</u></strong>\uff1a\u672c\u4f5c\u5c06\u5f15\u5165\u771f\u5b9e\u7684\u7269\u7406\u78b0\u649e\u4e0e\u7279\u6027</p><p class=\"bb_paragraph\" >1)\u4e8c\u5341\u56db\u8282\u6c14\u6d41\u8f6c\u3001\u5929\u8c61\u4e0e\u573a\u666f\u3001\u73a9\u6cd5\u6df1\u5ea6\u7ed3\u5408</p><p class=\"bb_paragraph\" >2)\u52a0\u5165\u771f\u5b9e\u7684\u7269\u7406\u7b97\u6cd5\u5305\u62ec\u60ef\u6027\u7b49\u7b49</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >4.<strong><u>\u6c99\u76d2</u></strong>\uff1a\u65e0\u7f1d\u5927\u5730\u56fe\u3001\u6c99\u76d2\u5192\u9669\u63a2\u7d22\u5305\u62ec\u591a\u6837\u5316\u7684\u5267\u60c5\u53ca\u7ed3\u5c40\uff0c\u591a\u6837\u5316\u7684\u89d2\u8272BD\u8def\u7ebf\u7b49</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >5.<strong><u>\u52bf\u529b</u></strong>\uff1a</p><p class=\"bb_paragraph\" >1)\u4e13\u5c5e\u52bf\u529b\u5267\u60c5\u3001\u795e\u901a\u6cd5\u5b9d\u3001\u664b\u5347\u4f53\u7cfb</p><p class=\"bb_paragraph\" >2)\u6a21\u62df\u7ecf\u8425\u3001\u53d1\u5c55\u751f\u5b58</p><p class=\"bb_paragraph\" >3)\u9886\u571f\u5360\u9886\u3001\u4e16\u754c\u5efa\u9020</p><p class=\"bb_paragraph\" >4)\u52bf\u529b\u653b\u4f10\u3001\u9a91\u9a6c\u780d\u6740</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >6.<strong><u>\u4ea4\u4e92</u></strong>\uff1a</p><p class=\"bb_paragraph\" >1)\u4eba\u4e0enpc\u4e4b\u95f4\u53ef\u4ee5\u4ea4\u4e92</p><p class=\"bb_paragraph\" >2)Npc\u4e0e\u81ea\u7136\u4e4b\u95f4\u53ef\u4ee5\u4ea4\u4e92</p><p class=\"bb_paragraph\" >3)\u4eba\u4e0e\u81ea\u7136\u4e4b\u95f4\u53ef\u4ee5\u4ea4\u4e92</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\u4e09\u3001\u6700\u540e\uff1a</p><p class=\"bb_paragraph\" >1.\u4eca\u5e74\uff0c\u6211\u4eec\u5c06\u5728\u6e38\u620f\u53d1\u5e03\u4e4b\u524d\u901a\u8fc72-3\u4e2a\u5b9e\u5f55PV\u9010\u6b65\u4ecb\u7ecd\u9752\u57ce\uff1a</p><p class=\"bb_paragraph\" ><strong><u>1)\u4ee5\u4e0a\u6709\u4e0b\u5212\u7ebf\u7684\u7248\u672c\u90e8\u5206\u5c06\u5728\u9996\u53d1\u7248\u672c\u4e2d\u5373\u53ef\u4f53\u9a8c\uff08\u5305\u62eccj\u53ca\u4e4b\u540e\u7684\u7ebf\u4e0b\u5c55\u4f1a\uff09</u></strong></p><p class=\"bb_paragraph\" >2)\u56e0\u6b64\uff0c\u540c\u4e0a\u4f5c\u4e00\u6837\uff0c\u9752\u57ce\u4e5f\u5c06\u62e5\u6709\u6570\u5341\u4e2a\u8d44\u6599\u7247\u9ad8\u9891\u7387\u66f4\u65b0\u8ba1\u5212</p><p class=\"bb_paragraph\" >3)\u4e0d\u8fc7\uff0c\u4e0e\u4e0a\u4f5c\u4e0d\u540c\uff0c\u9752\u57ce\u662f\u5c06\u6bcf\u4e00\u4e2a\u4f53\u7cfb\u505a\u5230\u8db3\u591f\u6df1\u5165\u540e\u518d\u901a\u8fc7\u72ec\u7acb\u7684\u5168\u65b0\u8d44\u6599\u7247\u5f00\u542f\u4e0b\u4e00\u4e2a\u73a9\u6cd5\u4f53\u7cfb\uff08\u524d\u4f5c\u4e00\u53e3\u6c14\u653e\u51fa\u6765\u6240\u6709\u73a9\u6cd5\u4f53\u7cfb\uff0c\u4f46\u662f\u8fc7\u4e8e\u5355\u8584\uff0c\u4f53\u9a8c\u4e0d\u597d\uff01\u4e14\u4e25\u91cd\u5f71\u54cd\u65b0\u624b\u4f53\u9a8c\u53ca\u540e\u671f\u6c89\u6d78\uff09</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >2.\u6211\u4eec\u4e0a\u4e00\u4ee3\u4f5c\u54c1\u81f3\u4eca\u5df2\u4e00\u5e74\uff0c\u5386\u7ecf11\u4e2a\u5927\u578b\u73a9\u6cd5\u8d44\u6599\u7247\u3001120\u591a\u6b21\u66f4\u65b0\uff01\u4eca\u5e74\u3001\u660e\u5e74\u4e5f\u8fd8\u6709\u5341\u51e0\u4e2a\u8d44\u6599\u7247\u7684\u89c4\u5212\uff01\u4f46\u662f\u53d7\u9650\u4e8e\u5f53\u65f6\u7684\u5f15\u64ce\u6280\u672f\uff08u3d2021\uff09\u3001\u5e95\u5c42\u6846\u67b6\u3001\u56e2\u961f\u89c4\u6a21\uff0c\u5f88\u591a\u6211\u4eec\u60f3\u5728\u6e38\u620f\u91cc\u5b9e\u73b0\u7684\u73a9\u6cd5\u4f9d\u7136\u53ea\u80fd\u6210\u4e3a\u9057\u61be\uff0c\u6211\u4eec\u60f3\u5728\u8fd9\u4e00\u4ee3\uff0c\u8865\u8db3\u90e8\u5206\u9057\u61be\uff1a</p><p class=\"bb_paragraph\" >1)\u4e0a\u4f5c\u5927\u5bb6\u5410\u69fd\u7684\uff1a\u4e16\u754c\u751f\u6001\u4e0d\u591f\uff0cNPC\u50f5\u786c\uff01\u8fd9\u4e00\u4f5c\uff0c\u6211\u4eec\u6362UE,\u5c1d\u8bd5\u5f15\u5165AI\uff01</p><p class=\"bb_paragraph\" >2)\u4e0a\u4f5c\u5927\u5bb6\u5410\u69fd\u7684\uff1a\u4ea4\u4e92\u5f88\u751f\u786c\uff01\u8fd9\u6b21\u6211\u4eec\u5f15\u5165\u771f\u5b9e\u7684\u7269\u7406\u78b0\u649e\u4e0e\u7279\u6027\uff0c\u8ba9\u4e16\u754c\u7684\u6bcf\u4e00\u90e8\u5206\u90fd\u80fd\u771f\u5b9e\u4ea4\u4e92\uff0c\u4e0d\u7ba1\u662f\u865a\u62df\u7684\u5929\u6c14\u8fd8\u662f\u5b9e\u9645\u7684\u5efa\u7b51\uff01</p><p class=\"bb_paragraph\" >3)\u4e0a\u4f5c\u5927\u5bb6\u5410\u69fd\u7684\u7f8e\u672f\uff1a\u6211\u4eec\u627f\u8bfa\u4e86\uff0c\u8fd9\u4e00\u4f5c\uff0c\u63d0\u5347\u767e\u5206\u4e4b\u4e00\u767e\uff01\u8bf7\u770b\u5b9e\u5f55</p><p class=\"bb_paragraph\" >4)\u4e0a\u4f5c\u5927\u5bb6\u5410\u69fd\u7684\u64cd\u4f5c\uff1a\u6211\u4eec\u8d4b\u4e88\u52a8\u4f5c\u4e0e\u64cd\u4f5c\u66f4\u591a\u7684\u610f\u4e49\uff0c\u6765\u5f25\u8865\u6211\u4eec\u52a8\u4f5c\u6253\u51fb\u611f\u7684\u4e0d\u8db3</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >3.\u5927\u5bb6\u7ed9\u6211\u4eec\u4e00\u70b9\u65f6\u95f4\uff0c\u6211\u4eec\u4e00\u4ee3\u4e00\u4ee3\u3001\u4e00\u4e2a\u8d44\u6599\u7247\u4e00\u4e2a\u8d44\u6599\u7247\u7684\u8fed\u4ee3\uff01</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p>",
    "about_the_game": "<p class=\"bb_paragraph\" >\u6211\u6709\u4e00\u5251\uff0c\u53ef\u642c\u5c71\u3001\u5fa1\u98ce\u3001\u51fa\u5165\u9752\u51a5\u3001\u7ffb\u8f6c\u795e\u9b54\uff01</p><p class=\"bb_paragraph\" >\u6211\u6709\u4e00\u57ce\uff0c\u53ef\u5c01\u7985\u3001\u796d\u7940\u3001\u78a7\u843d\u9ec4\u6cc9\u3001\u9547\u538b\u5996\u9b3c\uff01</p><p class=\"bb_paragraph\" >\u6211\u5bfb\u9f99\u70b9\u7a74\u3001\u8e0f\u7f61\u5e03\u6597\uff0c\u70bc\u5c06\u81e3\u65f1\u9b43\u3001\u7ea2\u5c18\u900d\u9065\uff01</p><p class=\"bb_paragraph\" >\u6211\u89c2\u661f\u671b\u6c14\u3001\u865a\u7a7a\u753b\u7b26\uff0c\u9a6d\u5996\u9b3c\u90aa\u795f\u3001\u5929\u5e08\u6b63\u6cd5\uff01</p><p class=\"bb_paragraph\" >\u6709\u90a3\u519c\u5bb6\u5b50\uff0c\u7ec7\u6851\u5f04\u9526\u3001\u4e00\u5339\u8700\u7ee3\u5c55\u5c71\u6cb3\u4e07\u91cc\uff0c</p><p class=\"bb_paragraph\" >\u4e5f\u6709\u90a3\u6e14\u592b\u8d70\u5352\uff0c\u56f4\u7089\u73cd\u9990\u3001\u65b9\u5bf8\u4e4b\u95f4\u54c1\u70df\u706b\u4eba\u95f4\u3002</p><p class=\"bb_paragraph\" >\u3002\u3002\u3002</p><p class=\"bb_paragraph\" >\u9752\u57ce\uff0c\u662f\u6211\u4eec\u5de5\u4f5c\u5ba4\u5236\u4f5c\u7684\u7b2c\u4e09\u4ee3\u5f00\u653e\u4e16\u754c\u3001\u56fd\u98ce\u795e\u8bdd\u5355\u673a\uff0c\u4e5f\u662f\u552f\u4e00\u4e00\u6b3e\u8001\u6eda5\u3001GTA like\u7684\u5927\u578b\u56fd\u98ce\u5355\u673a! \u9664\u5f00\u4f20\u7edf\u5f00\u653e\u4e16\u754c\u73a9\u6cd5\u5185\u5bb9\u5916\uff0c\u5728\u8fd9\u4e2a\u65e0\u7f1d\u5927\u4e16\u754c\u91cc\uff1a\u4e0a\u6709\u4e09\u95e8\u201c\u5251\u4ed9\u51fa\u5165\u9752\u51a5\u3001\u5112\u8005\u9f50\u5bb6\u6cbb\u56fd\u3001\u4f5b\u9640\u884c\u8d70\u4eba\u95f4\u201d\uff0c\u4e0b\u6709\u504f\u95e8\u4e5d\u6d41\u201c\u95ee\u535c\u3001\u70bc\u5c38\u3001\u9a6d\u9b3c\u3001\u5deb\u86ca\u3001\u5316\u5996\u3001\u673a\u5173\u3001\u5bfb\u9f99\u5012\u6597\uff1a\u3001\u8e0f\u7f61\u5e03\u9635\u3001\u6446\u575b\u8d77\u7b26\u201d\u7b49\u7b49\u3002</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\u4e00\u3001\u6838\u5fc3\u7279\u8272</p><p class=\"bb_paragraph\" >1.\uff08\u5bfb\u4ed9\uff09\u4e0a\u4e09\u95e8\uff1a</p><p class=\"bb_paragraph\" ><strong><u>1)\u9752\u57ce\u5251\u4ed9\uff1a\u53ef\u4ee5\u6c14\u5fa1\u5251\u3001\u53ef\u4eba\u5251\u5408\u4e00\u3001\u53ef\u4e0e\u504f\u95e8\u201c\u8e0f\u7f61\u5e03\u9635\u201d\u7ed3\u5408\u5e03\u4e13\u5c5e\u5251\u9635</u></strong></p><p class=\"bb_paragraph\" >2)\u5112\u95e8\u4e66\u751f\uff1a\u53ef\u8d70\u79d1\u4e3e\uff08\u671d\u5802\uff09\u3001\u6587\u4f1a\uff08\u6c5f\u6e56\uff09\u7b49\u8def\u7ebf\uff0c\u4e0e\u4e3b\u7ebf\u6df1\u5ea6\u7ed3\u5408\uff0c\u53ef\u4fee\u6d69\u7136\u6b63\u6c14\u4e13\u514b\u5996\u9b54\uff01\u53ef\u4e0e\u5e02\u4e95\u767e\u4e1a\u8bf8\u591a\u6587\u5316\u4f20\u627f\u6df1\u5ea6\u7ed3\u5408\u6bd4\u5982\u201c\u8700\u7ee3\u3001\u82cf\u9526\u3001\u5efa\u76cf\u3001\u5927\u6f06\u201d\uff0c\u6bd4\u5982\u8700\u7ee3-\u5343\u91cc\u6c5f\u5c71 vs \u795e\u8bdd-\u8bdb\u4ed9\u5251\u9635\uff01</p><p class=\"bb_paragraph\" >3)\u4f20\u4e16\u4f5b\u5f92\uff1a\u4fe1\u4ef0\u4f20\u627f\u4e0e\u4fe1\u5f92\u4e4b\u4e89\uff0c\u53ef\u4e0e\u8bf8\u52bf\u529b\u4e00\u8d77\u5f00\u542f\u95e8\u6d3e\u73a9\u6cd5\u201c\u4e13\u5c5e\u5267\u60c5\u3001\u795e\u901a\u6cd5\u5b9d\u3001\u95e8\u6d3e\u7ecf\u8425\u3001\u4e16\u754c\u5360\u9886\u3001\u5730\u56fe\u5efa\u9020\u3001\u6700\u7ec8\u7684\u95e8\u6d3e\u5f81\u4f10\u201d</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >2.\uff08\u8d85\u51e1\uff09\u4e0b\u4e5d\u6d41\uff08\u504f\u95e8\uff09\uff1a</p><p class=\"bb_paragraph\" >1)\u76f8\u5e08\uff1a\u53ef\u95ee\u535c\u5360\u661f\uff0c\u53ef\u64cd\u4f5c\u5929\u8c61\uff08\u8282\u6c14\u3001\u98ce\u96f7\u7b49\u7b49\uff09</p><p class=\"bb_paragraph\" ><strong><u>2)\u70bc\u5c38\uff1a\u8305\u5c71\u9053\u58eb\u4f20\u627f\u7ed3\u5408\u6e58\u897f\u5f02\u672f\u201c\u5907\u5c38\u3001\u5bfb\u7a74\u3001\u70bc\u5236\u3001\u5929\u52ab\u201d</u></strong></p><p class=\"bb_paragraph\" >3)\u9a6d\u9b3c\uff1a\u9634\u9633\u5148\u751f\u4f20\u627f\u7ed3\u5408\u795e\u79d8\u590d\u82cf</p><p class=\"bb_paragraph\" >4)\u5deb\u86ca\uff1a\u4e94\u4ed9\u6559\u3001\u4e94\u6bd2\u6559\u3001\u795e\u79d8\u65cf\u7fa4\u6765\u81ea\u4e0a\u53e4\u5deb\u796d\u7684\u4f20\u627f</p><p class=\"bb_paragraph\" >5)\u5316\u5996\uff1a\u90e8\u5206\u5929\u8d4b\u4fee\u58eb\uff0c\u53ef\u6536\u96c6\u65f6\u95f4\u5927\u5996\u8840\u8109\u53d8\u8eab\u4e3a\u5de8\u5996\u5f81\u6218\u5929\u5730\uff08\u6ce8\uff1a\u6b64\u73a9\u6cd5\u4f1a\u4f34\u968f\u7740\u8d44\u6599\u7247\u6301\u7eed\u66f4\u65b0\u3001\u56e0\u4e3a\u6bcf\u79cd\u8840\u8109\u53d8\u8eab\u7684\u52a8\u4f5c\u6218\u6597\u64cd\u4f5c\u90fd\u7b49\u540c\u4e8e\u8c03\u8bd5\u4e00\u4e2a\u65b0boss\uff09</p><p class=\"bb_paragraph\" >6)\u673a\u5173\uff1a\u90e8\u5206\u5929\u8d4b\u4fee\u58eb\uff0c\u53ef\u5c06\u5e02\u4e95\u6728\u5de5\u4e0e\u4e0a\u53e4\u58a8\u5bb6\u673a\u5173\u3001\u516c\u8f93\u5f02\u672f\u7ed3\u5408\u8d77\u6765\u5f62\u6210\u5a01\u529b\u5de8\u5927\u7684\u795e\u673a\u767e\u70bc\uff08\u8be5\u6574\u4f53\u4f53\u7cfb\u4f5c\u4e3a\u4eca\u5e74\u53d1\u5e03\u540e\u7684\u7b2c\u4e00\u4e2a\u6708\u7b2c\u4e00\u4e2a\u8d44\u6599\u7247\u66f4\u65b0\u7ed9\u5927\u5bb6\uff09</p><p class=\"bb_paragraph\" ><strong><u>7)\u5bfb\u9f99\u5012\u6597\uff1a\u90e8\u5206\u5929\u8d4b\u4fee\u58eb\uff0c\u53ef\u5c06\u76f8\u5e08\u5f02\u672f\u4e0e\u98ce\u6c34\u7ed3\u5408\u201c\u5bfb\u9f99\u70b9\u7a74\uff0c\u89e3\u5bc6\u5012\u6597\u201d</u></strong></p><p class=\"bb_paragraph\" ><strong><u>8)\u8e0f\u7f61\u5e03\u9635\uff1a\u8e0f\u7f61\u5e03\u6597\u3001\u70bc\u9635\u5e03\u9635\uff1b\u90e8\u5206\u5929\u8d4b\u4fee\u58eb\u53ef\u5c06\u5176\u4e0e\u9752\u57ce\u5251\u4ed9\u4e00\u8109\u4f20\u627f\u7ed3\u5408\u6210\u201c\u5251\u9635\u4e4b\u9053\u201d</u></strong></p><p class=\"bb_paragraph\" >9)\u6446\u644a\u8d77\u7b26\uff1a\u90e8\u5206\u5929\u8d4b\u4fee\u58eb\u53ef\u5c06\u8305\u5c71\u3001\u9634\u9633\u7b49\u8d85\u51e1\u4f20\u627f\u4e0e\u5e02\u4e95\u767e\u6001\u7684\u6587\u5316\u4f20\u627f\u5982\u201c\u5927\u6f06\u3001\u9020\u7eb8\u3001\u6731\u7802\u7b49\u201d\u7ed3\u5408\u5f62\u6210\u4e13\u5c5e\u7684\u901a\u5929\u7b26\u7bc6\u6548\u679c</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >3.\uff08\u4eba\u4e16\u95f4\uff09\u5e02\u4e95\u767e\u4e1a\uff1a</p><p class=\"bb_paragraph\" >1)\u666e\u901a\uff1a<strong><u>\u5de5\u5320\u3001\u519c\u592b\u3001\u6728\u5320\u3001\u6e14\u6c11\u3001\u5b98\u5e9c\u3001\u7eff\u6797</u></strong>\u3001\u9556\u5e08\u7b49\u7b49</p><p class=\"bb_paragraph\" >2)\u975e\u9057\uff1a\u7ee3\u5a18\uff08<strong><u>\u8700\u7ee3</u></strong>\u3001\u82cf\u9526\uff09\u3001\u58a8\u5bb6\uff08\u673a\u5173\u3001\u69ab\u536f\u7b49\uff09\u7b49\u7b49\uff08<strong><u>\u7b2c\u4e00\u4e2a\u7248\u672c\u5927\u6982\u5728\u4e09\u5341\u591a\u79cd\u76f8\u5173\u6280\u672f\u5de5\u827a</u></strong>\uff09</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\u4e8c\u3001<strong><u>\u73a9\u6cd5</u></strong>\uff08\u5e38\u89c4\u5f00\u653e\u4e16\u754c\u73a9\u6cd5\uff09\uff1a</p><p class=\"bb_paragraph\" >1.<strong><u>\u51fa\u8eab</u></strong>\uff1a\u66f4\u591a\u7684\u4eba\u751f\u53ef\u9009\u9879\uff0c\u4e0d\u540c\u7684\u7cbe\u5f69\u6545\u4e8b\uff08\u5982\u540c\u6211\u4eec\u4e0a\u4e00\u4ee3\u4f5c\u54c1\u7684\u5267\u60c5\u4e3b\u89d2\u51fa\u8eab\uff09</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >2.<strong><u>\u771f\u5b9e</u></strong>\uff1a</p><p class=\"bb_paragraph\" >1)\u8eab\u4efd\u4eba\u751f:\u8d4b\u4e88\u5927\u4e16\u754c\u4e0d\u540c\u7684\u89d2\u8272\u4e0d\u540c\u7684\u8eab\u4efd\u4e0e\u4e0d\u540c\u7684\u4eba\u751f\u6545\u4e8b</p><p class=\"bb_paragraph\" >2)\u4e16\u754c\u54cd\u5e94\uff1a\u5728\u4e0a\u4e00\u4f5c\u4e2d\uff0c\u4e3b\u89d2\u7684\u6240\u62e5\u6709\u7684\u5e02\u4e95\u8eab\u4efd\u73a9\u6cd5\u53ca\u89c4\u5219\u5c06\u5f52\u5c5e\u5230\u6bcf\u4e00\u4e2aNPC\u8eab\u4e0a\uff1a\u519c\u6c11\u65e5\u51fa\u800c\u4f5c\u65e5\u843d\u800c\u606f\u3001\u6e14\u6c11\u5f52\u6765\u5356\u9c7c\u6cbd\u9152\u3001\u6446\u644a\u5f52\u6765\u7684\u4e08\u592b\u5728\u70c2\u9189\u7ea6\u8d4c\uff1b\u6bcf\u4e00\u4e2aNPC\u90fd\u5c06\u62e5\u6709\u81ea\u5df1\u7684\u8eab\u4efd\u53ca\u751f\u6d3b\uff0c\u6700\u540e\u4e0e\u73a9\u5bb6\u4ea4\u4e92\u51fa\u72ec\u4e00\u65e0\u4e8c\u7684\u4e16\u754c\u4f53\u9a8c\u3002</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >3.<strong><u>\u7269\u7406</u></strong>\uff1a\u672c\u4f5c\u5c06\u5f15\u5165\u771f\u5b9e\u7684\u7269\u7406\u78b0\u649e\u4e0e\u7279\u6027</p><p class=\"bb_paragraph\" >1)\u4e8c\u5341\u56db\u8282\u6c14\u6d41\u8f6c\u3001\u5929\u8c61\u4e0e\u573a\u666f\u3001\u73a9\u6cd5\u6df1\u5ea6\u7ed3\u5408</p><p class=\"bb_paragraph\" >2)\u52a0\u5165\u771f\u5b9e\u7684\u7269\u7406\u7b97\u6cd5\u5305\u62ec\u60ef\u6027\u7b49\u7b49</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >4.<strong><u>\u6c99\u76d2</u></strong>\uff1a\u65e0\u7f1d\u5927\u5730\u56fe\u3001\u6c99\u76d2\u5192\u9669\u63a2\u7d22\u5305\u62ec\u591a\u6837\u5316\u7684\u5267\u60c5\u53ca\u7ed3\u5c40\uff0c\u591a\u6837\u5316\u7684\u89d2\u8272BD\u8def\u7ebf\u7b49</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >5.<strong><u>\u52bf\u529b</u></strong>\uff1a</p><p class=\"bb_paragraph\" >1)\u4e13\u5c5e\u52bf\u529b\u5267\u60c5\u3001\u795e\u901a\u6cd5\u5b9d\u3001\u664b\u5347\u4f53\u7cfb</p><p class=\"bb_paragraph\" >2)\u6a21\u62df\u7ecf\u8425\u3001\u53d1\u5c55\u751f\u5b58</p><p class=\"bb_paragraph\" >3)\u9886\u571f\u5360\u9886\u3001\u4e16\u754c\u5efa\u9020</p><p class=\"bb_paragraph\" >4)\u52bf\u529b\u653b\u4f10\u3001\u9a91\u9a6c\u780d\u6740</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >6.<strong><u>\u4ea4\u4e92</u></strong>\uff1a</p><p class=\"bb_paragraph\" >1)\u4eba\u4e0enpc\u4e4b\u95f4\u53ef\u4ee5\u4ea4\u4e92</p><p class=\"bb_paragraph\" >2)Npc\u4e0e\u81ea\u7136\u4e4b\u95f4\u53ef\u4ee5\u4ea4\u4e92</p><p class=\"bb_paragraph\" >3)\u4eba\u4e0e\u81ea\u7136\u4e4b\u95f4\u53ef\u4ee5\u4ea4\u4e92</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\u4e09\u3001\u6700\u540e\uff1a</p><p class=\"bb_paragraph\" >1.\u4eca\u5e74\uff0c\u6211\u4eec\u5c06\u5728\u6e38\u620f\u53d1\u5e03\u4e4b\u524d\u901a\u8fc72-3\u4e2a\u5b9e\u5f55PV\u9010\u6b65\u4ecb\u7ecd\u9752\u57ce\uff1a</p><p class=\"bb_paragraph\" ><strong><u>1)\u4ee5\u4e0a\u6709\u4e0b\u5212\u7ebf\u7684\u7248\u672c\u90e8\u5206\u5c06\u5728\u9996\u53d1\u7248\u672c\u4e2d\u5373\u53ef\u4f53\u9a8c\uff08\u5305\u62eccj\u53ca\u4e4b\u540e\u7684\u7ebf\u4e0b\u5c55\u4f1a\uff09</u></strong></p><p class=\"bb_paragraph\" >2)\u56e0\u6b64\uff0c\u540c\u4e0a\u4f5c\u4e00\u6837\uff0c\u9752\u57ce\u4e5f\u5c06\u62e5\u6709\u6570\u5341\u4e2a\u8d44\u6599\u7247\u9ad8\u9891\u7387\u66f4\u65b0\u8ba1\u5212</p><p class=\"bb_paragraph\" >3)\u4e0d\u8fc7\uff0c\u4e0e\u4e0a\u4f5c\u4e0d\u540c\uff0c\u9752\u57ce\u662f\u5c06\u6bcf\u4e00\u4e2a\u4f53\u7cfb\u505a\u5230\u8db3\u591f\u6df1\u5165\u540e\u518d\u901a\u8fc7\u72ec\u7acb\u7684\u5168\u65b0\u8d44\u6599\u7247\u5f00\u542f\u4e0b\u4e00\u4e2a\u73a9\u6cd5\u4f53\u7cfb\uff08\u524d\u4f5c\u4e00\u53e3\u6c14\u653e\u51fa\u6765\u6240\u6709\u73a9\u6cd5\u4f53\u7cfb\uff0c\u4f46\u662f\u8fc7\u4e8e\u5355\u8584\uff0c\u4f53\u9a8c\u4e0d\u597d\uff01\u4e14\u4e25\u91cd\u5f71\u54cd\u65b0\u624b\u4f53\u9a8c\u53ca\u540e\u671f\u6c89\u6d78\uff09</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >2.\u6211\u4eec\u4e0a\u4e00\u4ee3\u4f5c\u54c1\u81f3\u4eca\u5df2\u4e00\u5e74\uff0c\u5386\u7ecf11\u4e2a\u5927\u578b\u73a9\u6cd5\u8d44\u6599\u7247\u3001120\u591a\u6b21\u66f4\u65b0\uff01\u4eca\u5e74\u3001\u660e\u5e74\u4e5f\u8fd8\u6709\u5341\u51e0\u4e2a\u8d44\u6599\u7247\u7684\u89c4\u5212\uff01\u4f46\u662f\u53d7\u9650\u4e8e\u5f53\u65f6\u7684\u5f15\u64ce\u6280\u672f\uff08u3d2021\uff09\u3001\u5e95\u5c42\u6846\u67b6\u3001\u56e2\u961f\u89c4\u6a21\uff0c\u5f88\u591a\u6211\u4eec\u60f3\u5728\u6e38\u620f\u91cc\u5b9e\u73b0\u7684\u73a9\u6cd5\u4f9d\u7136\u53ea\u80fd\u6210\u4e3a\u9057\u61be\uff0c\u6211\u4eec\u60f3\u5728\u8fd9\u4e00\u4ee3\uff0c\u8865\u8db3\u90e8\u5206\u9057\u61be\uff1a</p><p class=\"bb_paragraph\" >1)\u4e0a\u4f5c\u5927\u5bb6\u5410\u69fd\u7684\uff1a\u4e16\u754c\u751f\u6001\u4e0d\u591f\uff0cNPC\u50f5\u786c\uff01\u8fd9\u4e00\u4f5c\uff0c\u6211\u4eec\u6362UE,\u5c1d\u8bd5\u5f15\u5165AI\uff01</p><p class=\"bb_paragraph\" >2)\u4e0a\u4f5c\u5927\u5bb6\u5410\u69fd\u7684\uff1a\u4ea4\u4e92\u5f88\u751f\u786c\uff01\u8fd9\u6b21\u6211\u4eec\u5f15\u5165\u771f\u5b9e\u7684\u7269\u7406\u78b0\u649e\u4e0e\u7279\u6027\uff0c\u8ba9\u4e16\u754c\u7684\u6bcf\u4e00\u90e8\u5206\u90fd\u80fd\u771f\u5b9e\u4ea4\u4e92\uff0c\u4e0d\u7ba1\u662f\u865a\u62df\u7684\u5929\u6c14\u8fd8\u662f\u5b9e\u9645\u7684\u5efa\u7b51\uff01</p><p class=\"bb_paragraph\" >3)\u4e0a\u4f5c\u5927\u5bb6\u5410\u69fd\u7684\u7f8e\u672f\uff1a\u6211\u4eec\u627f\u8bfa\u4e86\uff0c\u8fd9\u4e00\u4f5c\uff0c\u63d0\u5347\u767e\u5206\u4e4b\u4e00\u767e\uff01\u8bf7\u770b\u5b9e\u5f55</p><p class=\"bb_paragraph\" >4)\u4e0a\u4f5c\u5927\u5bb6\u5410\u69fd\u7684\u64cd\u4f5c\uff1a\u6211\u4eec\u8d4b\u4e88\u52a8\u4f5c\u4e0e\u64cd\u4f5c\u66f4\u591a\u7684\u610f\u4e49\uff0c\u6765\u5f25\u8865\u6211\u4eec\u52a8\u4f5c\u6253\u51fb\u611f\u7684\u4e0d\u8db3</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >3.\u5927\u5bb6\u7ed9\u6211\u4eec\u4e00\u70b9\u65f6\u95f4\uff0c\u6211\u4eec\u4e00\u4ee3\u4e00\u4ee3\u3001\u4e00\u4e2a\u8d44\u6599\u7247\u4e00\u4e2a\u8d44\u6599\u7247\u7684\u8fed\u4ee3\uff01</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p>",
    "short_description": "\u201c\u4e0b\u4e00\u7ad9\u9752\u57ce\u201d\u662f\u767d\u7389\u4eac\u5de5\u4f5c\u5ba4\u7684\u7b2c\u4e09\u4ee3\u5355\u673a\u4ea7\u54c1\uff0c\u4e5f\u662f\u7b2c\u4e00\u6b3e\u56fd\u98ce\u795e\u8bdd\u5f00\u653e\u4e16\u754c\u6e38\u620f\uff01\u9664\u5f00\u4f20\u7edf\u5f00\u653e\u4e16\u754c\u73a9\u6cd5\u5185\u5bb9\u5916\uff0c\u5728\u8fd9\u4e2a\u65e0\u7f1d\u5927\u4e16\u754c\u91cc\uff1a\u4e0a\u6709\u4e09\u95e8\u201c\u5251\u4ed9\u51fa\u5165\u9752\u51a5\u3001\u5112\u8005\u9f50\u5bb6\u6cbb\u56fd\u3001\u4f5b\u9640\u884c\u8d70\u4eba\u95f4\u201d\uff0c\u4e0b\u6709\u504f\u95e8\u4e5d\u6d41\u201c\u95ee\u535c\u3001\u70bc\u5c38\u3001\u9a6d\u9b3c\u3001\u517b\u86ca\u3001\u5316\u5996\u3001\u673a\u5173\u3001\u5bfb\u9f99\u70b9\u7a74\u3001\u8e0f\u7f61\u5e03\u9635\u3001\u6446\u575b\u8d77\u7b26\u201d\u7b49\u7b49\u3002",
