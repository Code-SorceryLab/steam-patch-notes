ted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1813120/extras/a646f106793f403e3afaa6c6b1613eec.poster.avif?t=1675442150\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1813120/extras/a646f106793f403e3afaa6c6b1613eec.webm?t=1675442150\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1813120/extras/a646f106793f403e3afaa6c6b1613eec.mp4?t=1675442150\" type=\"video/mp4\"></video></div>",
