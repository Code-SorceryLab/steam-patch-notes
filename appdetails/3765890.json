    "detailed_description": "<p class=\"bb_paragraph\" >\u3000\u3000\u6211\u5011 \u88ab\u7b11\uff0c</p><p class=\"bb_paragraph\" >\u3000\u3000\u6211\u5011 \u4e0d\u88ab\u770b\u597d\uff0c</p><p class=\"bb_paragraph\" >\u3000\u3000\u4f46\u6211\u5011 \u4e0d\u6015\uff01</p><p class=\"bb_paragraph\" >\u3000\u3000\u6211\u5011\u90fd\u9700\u8981\u300c\u52c7\u6c23Online\u300d...</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\u300c\u52c7\u6c23Online\u300d\u662f\u4e00\u6b3e\u7531  \u958b\u767c\u7684 2D \u5947\u5e7b MMORPG \u904a\u6232\uff0c\u514d\u8cbb\u958b\u73a9\u3002</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\u904a\u6232\u80cc\u666f\u8a2d\u5b9a\u5728\u7fa4\u96c4\u5272\u64da\u7684\u300c\u6230\u570b\u4e03\u96c4\u300d\u6642\u671f\u3002\u6230\u706b\u7d1b\u98db\u4e4b\u4e0b\uff0c\u9f4a\u3001\u97d3\u3001\u8d99\u3001\u9b4f\u3001\u79e6\u3001\u695a\u3001\u71d5\u4e03\u570b\u722d\u9738\u4e0d\u4f11\uff0c\u5929\u4e0b\u52d5\u76ea\u3002\u800c\u4e00\u5834\u4f86\u81ea\u5929\u5916\u7684\u795e\u79d8\u5929\u77f3\u649e\u64ca\uff0c\u63ed\u958b\u4e86\u57cb\u85cf\u5343\u5e74\u7684\u79d8\u5bc6\uff0c\u559a\u9192\u4e86\u6c89\u7761\u7684\u5996\u9b54\uff0c\u4e5f\u9ede\u71c3\u4e86\u4eba\u9593\u7149\u7344\u7684\u5e8f\u7ae0\u3002</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\u73a9\u5bb6\u5c07\u5728\u6eab\u99a8\u53ef\u611b\u7684\u6771\u65b9\u6b66\u4fe0\u756b\u98a8\u4e2d\uff0c\u626e\u6f14\u4e00\u4f4d\u8eab\u8ca0\u4f7f\u547d\u7684\u82f1\u96c4\uff0c\u9ad4\u9a57\u4ed7\u528d\u5929\u4e0b\u3001\u65ac\u5996\u9664\u9b54\u7684\u71b1\u8840\u65c5\u7a0b\uff0c\u6216\u662f\u5728\u570b\u6230\u6c99\u5834\u4e0a\u6210\u5c31\u4e00\u65b9\u9738\u696d\uff01\u642d\u914d\u8d85\u840c\u5bf5\u7269\u3001\u9177\u70ab\u5750\u9a0e\u3001\u6eab\u99a8\u9580\u6d3e\u548c\u71b1\u8840\u90e8\u843d\uff0c\u5c55\u958b\u4eff 3D \u5373\u6642\u6230\u9b25\u3001\u968a\u4f0d\u7fa4P\u3001\u90e8\u843d\u6230\u722d\u3001\u570b\u6230\u722d\u9738\u7b49\u591a\u5143\u73a9\u6cd5\u3002</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\uff0a\u904a\u6232\u7279\u8272\uff0a</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\u9580\u6d3e\u7cfb\u7d71\uff1a\u591a\u7a2e\u591a\u6a23\u7684\u9580\u6d3e\u8a2d\u5b9a\uff0c\u5f9e\u525b\u731b\u7684\u7981\u885b\u8ecd\u3001\u5805\u97cc\u7684\u6843\u82b1\u6e90\uff0c\u5230\u8a6d\u8b4e\u7684\u5510\u9580\u3001\u9748\u6cd5\u4e26\u65bd\u7684\u8700\u5c71\uff0c\u4ee5\u53ca\u5c08\u7cbe\u8f14\u52a9\u8207\u6cd5\u8853\u7684\u96f2\u5922\u6fa4\u3001\u8305\u5c71\u8207\u5d11\u5d19\u5c71\uff0c\u6eff\u8db3\u5404\u985e\u73a9\u5bb6\u7684\u6230\u9b25\u98a8\u683c\u8207\u8077\u696d\u559c\u597d\u3002</p><p class=\"bb_paragraph\" >\u5bf5\u7269\u7cfb\u7d71\uff1a\u6355\u6349\u602a\u7269\u70ba\u5bf5\u7269\uff0c\u4e26\u57f9\u990a\u7260\u5011\u6210\u9577\uff0c\u5e6b\u52a9\u60a8\u5fb5\u6230\u6c99\u5834\u3002</p><p class=\"bb_paragraph\" >\u5a5a\u59fb\u7cfb\u7d71\uff1a\u8207\u4f34\u4fb6\u5171\u540c\u63a2\u96aa\uff0c\u9ad4\u9a57\u6d6a\u6f2b\u7684\u5192\u96aa\u65c5\u7a0b\u3002</p><p class=\"bb_paragraph\" >\u6b66\u5668\u88fd\u4f5c\uff1a\u88fd\u4f5c\u8d85\u7d1a\u6b66\u5668\uff0c\u935b\u9020\u5347\u661f\u3001\u9472\u5d4c\u5bf6\u77f3\u63d0\u5347\u5c6c\u6027\u3002</p><p class=\"bb_paragraph\" >\u90e8\u843d\u6230\u722d\u3001\u570b\u6230\u722d\u9738\uff1a\u73a9\u5bb6\u53ef\u900f\u904e\u50f1\u7528\u50ad\u5175\u6230\u58eb\u3001\u5efa\u9020\u7bad\u6a13\u7b49\u65b9\u5f0f\u64f4\u5c55\u81ea\u8eab\u5be6\u529b\uff0c\u5728\u5e6b\u6703\u6230\u722d\u4e2d\u722d\u53d6\u66f4\u591a\u5229\u76ca\uff0c\u9ad4\u9a57 DOTA \u7684\u7b56\u7565\u8207\u5c0d\u6297\u517c\u5177\u7684\u5927\u578b\u6230\u5834\u6a02\u8da3\u3002</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\uff0a\u4e03\u5927\u9580\u6d3e\uff0a</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\u7981\u885b\u8ecd\uff1a\u504f\u91cd\u7269\u7406\u653b\u64ca\u7684\u9580\u6d3e\uff0c\u64c5\u9577\u4f7f\u7528\u69cd\u8207\u68cd\u70ba\u6b66\u5668\uff0c\u653b\u52e2\u51cc\u53b2\u3002</p><p class=\"bb_paragraph\" >\u6843\u82b1\u6e90\uff1a\u8fd1\u8eab\u8089\u640f\u578b\u9580\u6d3e\uff0c\u64c1\u6709\u5168\u9580\u6d3e\u4e2d\u6700\u9ad8\u7684\u9632\u79a6\u529b\uff0c\u4f7f\u7528\u62f3\u5957\u4f5c\u6230\u3002</p><p class=\"bb_paragraph\" >\u5510\u9580\uff1a\u64c5\u9577\u9060\u7a0b\u7269\u7406\u653b\u64ca\uff0c\u4ee5\u8eab\u6cd5\u9748\u6d3b\u8457\u7a31\uff0c\u4ee5\u6697\u5668\u8207\u6bd2\u7269\u70ba\u4e3b\u8981\u6b66\u5668\u3002</p><p class=\"bb_paragraph\" >\u8700\u5c71\uff1a\u517c\u5177\u7269\u7406\u8207\u6cd5\u8853\u653b\u64ca\u80fd\u529b\uff0c\u6b66\u5668\u5206\u70ba\u5200\u8207\u528d\u5169\u7a2e\uff0c\u842c\u6cd5\u6b78\u4e00\u3002</p><p class=\"bb_paragraph\" >\u96f2\u5922\u6fa4\uff1a\u64c5\u9577\u56de\u5fa9\u8207\u589e\u76ca\u6cd5\u8853\u7684\u8f14\u52a9\u9580\u6d3e\uff0c\u4f7f\u7528\u528d\u4f5c\u70ba\u6b66\u5668\u3002</p><p class=\"bb_paragraph\" >\u8305\u5c71\uff1a\u5c08\u6ce8\u65bc\u9b3c\u795e\u53ec\u559a\u8207\u6cd5\u8853\u653b\u64ca\uff0c\u4ee5\u528d\u5f62\u6cd5\u5668\u65bd\u5c55\u5404\u7a2e\u8853\u6cd5\u3002</p><p class=\"bb_paragraph\" >\u5d11\u5d19\u5c71\uff1a\u4ee5\u5f37\u529b\u6cd5\u8853\u653b\u64ca\u898b\u9577\uff0c\u64c1\u6709\u8c50\u5bcc\u591a\u6a23\u7684\u6cd5\u8853\u6280\u80fd\uff0c\u6b66\u5668\u70ba\u528d\u3002</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\u99ac\u4e0a\u52a0\u5165\u300c\u52c7\u6c23Online\u300d\uff0d\uff0d\u6230\u570b\u7684\u50b3\u8aaa\uff0c\u7531\u4f60\u89aa\u624b\u66f8\u5beb\uff01</p><p class=\"bb_paragraph\" ></p>",
    "about_the_game": "<p class=\"bb_paragraph\" >\u3000\u3000\u6211\u5011 \u88ab\u7b11\uff0c</p><p class=\"bb_paragraph\" >\u3000\u3000\u6211\u5011 \u4e0d\u88ab\u770b\u597d\uff0c</p><p class=\"bb_paragraph\" >\u3000\u3000\u4f46\u6211\u5011 \u4e0d\u6015\uff01</p><p class=\"bb_paragraph\" >\u3000\u3000\u6211\u5011\u90fd\u9700\u8981\u300c\u52c7\u6c23Online\u300d...</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\u300c\u52c7\u6c23Online\u300d\u662f\u4e00\u6b3e\u7531  \u958b\u767c\u7684 2D \u5947\u5e7b MMORPG \u904a\u6232\uff0c\u514d\u8cbb\u958b\u73a9\u3002</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\u904a\u6232\u80cc\u666f\u8a2d\u5b9a\u5728\u7fa4\u96c4\u5272\u64da\u7684\u300c\u6230\u570b\u4e03\u96c4\u300d\u6642\u671f\u3002\u6230\u706b\u7d1b\u98db\u4e4b\u4e0b\uff0c\u9f4a\u3001\u97d3\u3001\u8d99\u3001\u9b4f\u3001\u79e6\u3001\u695a\u3001\u71d5\u4e03\u570b\u722d\u9738\u4e0d\u4f11\uff0c\u5929\u4e0b\u52d5\u76ea\u3002\u800c\u4e00\u5834\u4f86\u81ea\u5929\u5916\u7684\u795e\u79d8\u5929\u77f3\u649e\u64ca\uff0c\u63ed\u958b\u4e86\u57cb\u85cf\u5343\u5e74\u7684\u79d8\u5bc6\uff0c\u559a\u9192\u4e86\u6c89\u7761\u7684\u5996\u9b54\uff0c\u4e5f\u9ede\u71c3\u4e86\u4eba\u9593\u7149\u7344\u7684\u5e8f\u7ae0\u3002</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\u73a9\u5bb6\u5c07\u5728\u6eab\u99a8\u53ef\u611b\u7684\u6771\u65b9\u6b66\u4fe0\u756b\u98a8\u4e2d\uff0c\u626e\u6f14\u4e00\u4f4d\u8eab\u8ca0\u4f7f\u547d\u7684\u82f1\u96c4\uff0c\u9ad4\u9a57\u4ed7\u528d\u5929\u4e0b\u3001\u65ac\u5996\u9664\u9b54\u7684\u71b1\u8840\u65c5\u7a0b\uff0c\u6216\u662f\u5728\u570b\u6230\u6c99\u5834\u4e0a\u6210\u5c31\u4e00\u65b9\u9738\u696d\uff01\u642d\u914d\u8d85\u840c\u5bf5\u7269\u3001\u9177\u70ab\u5750\u9a0e\u3001\u6eab\u99a8\u9580\u6d3e\u548c\u71b1\u8840\u90e8\u843d\uff0c\u5c55\u958b\u4eff 3D \u5373\u6642\u6230\u9b25\u3001\u968a\u4f0d\u7fa4P\u3001\u90e8\u843d\u6230\u722d\u3001\u570b\u6230\u722d\u9738\u7b49\u591a\u5143\u73a9\u6cd5\u3002</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\uff0a\u904a\u6232\u7279\u8272\uff0a</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\u9580\u6d3e\u7cfb\u7d71\uff1a\u591a\u7a2e\u591a\u6a23\u7684\u9580\u6d3e\u8a2d\u5b9a\uff0c\u5f9e\u525b\u731b\u7684\u7981\u885b\u8ecd\u3001\u5805\u97cc\u7684\u6843\u82b1\u6e90\uff0c\u5230\u8a6d\u8b4e\u7684\u5510\u9580\u3001\u9748\u6cd5\u4e26\u65bd\u7684\u8700\u5c71\uff0c\u4ee5\u53ca\u5c08\u7cbe\u8f14\u52a9\u8207\u6cd5\u8853\u7684\u96f2\u5922\u6fa4\u3001\u8305\u5c71\u8207\u5d11\u5d19\u5c71\uff0c\u6eff\u8db3\u5404\u985e\u73a9\u5bb6\u7684\u6230\u9b25\u98a8\u683c\u8207\u8077\u696d\u559c\u597d\u3002</p><p class=\"bb_paragraph\" >\u5bf5\u7269\u7cfb\u7d71\uff1a\u6355\u6349\u602a\u7269\u70ba\u5bf5\u7269\uff0c\u4e26\u57f9\u990a\u7260\u5011\u6210\u9577\uff0c\u5e6b\u52a9\u60a8\u5fb5\u6230\u6c99\u5834\u3002</p><p class=\"bb_paragraph\" >\u5a5a\u59fb\u7cfb\u7d71\uff1a\u8207\u4f34\u4fb6\u5171\u540c\u63a2\u96aa\uff0c\u9ad4\u9a57\u6d6a\u6f2b\u7684\u5192\u96aa\u65c5\u7a0b\u3002</p><p class=\"bb_paragraph\" >\u6b66\u5668\u88fd\u4f5c\uff1a\u88fd\u4f5c\u8d85\u7d1a\u6b66\u5668\uff0c\u935b\u9020\u5347\u661f\u3001\u9472\u5d4c\u5bf6\u77f3\u63d0\u5347\u5c6c\u6027\u3002</p><p class=\"bb_paragraph\" >\u90e8\u843d\u6230\u722d\u3001\u570b\u6230\u722d\u9738\uff1a\u73a9\u5bb6\u53ef\u900f\u904e\u50f1\u7528\u50ad\u5175\u6230\u58eb\u3001\u5efa\u9020\u7bad\u6a13\u7b49\u65b9\u5f0f\u64f4\u5c55\u81ea\u8eab\u5be6\u529b\uff0c\u5728\u5e6b\u6703\u6230\u722d\u4e2d\u722d\u53d6\u66f4\u591a\u5229\u76ca\uff0c\u9ad4\u9a57 DOTA \u7684\u7b56\u7565\u8207\u5c0d\u6297\u517c\u5177\u7684\u5927\u578b\u6230\u5834\u6a02\u8da3\u3002</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\uff0a\u4e03\u5927\u9580\u6d3e\uff0a</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\u7981\u885b\u8ecd\uff1a\u504f\u91cd\u7269\u7406\u653b\u64ca\u7684\u9580\u6d3e\uff0c\u64c5\u9577\u4f7f\u7528\u69cd\u8207\u68cd\u70ba\u6b66\u5668\uff0c\u653b\u52e2\u51cc\u53b2\u3002</p><p class=\"bb_paragraph\" >\u6843\u82b1\u6e90\uff1a\u8fd1\u8eab\u8089\u640f\u578b\u9580\u6d3e\uff0c\u64c1\u6709\u5168\u9580\u6d3e\u4e2d\u6700\u9ad8\u7684\u9632\u79a6\u529b\uff0c\u4f7f\u7528\u62f3\u5957\u4f5c\u6230\u3002</p><p class=\"bb_paragraph\" >\u5510\u9580\uff1a\u64c5\u9577\u9060\u7a0b\u7269\u7406\u653b\u64ca\uff0c\u4ee5\u8eab\u6cd5\u9748\u6d3b\u8457\u7a31\uff0c\u4ee5\u6697\u5668\u8207\u6bd2\u7269\u70ba\u4e3b\u8981\u6b66\u5668\u3002</p><p class=\"bb_paragraph\" >\u8700\u5c71\uff1a\u517c\u5177\u7269\u7406\u8207\u6cd5\u8853\u653b\u64ca\u80fd\u529b\uff0c\u6b66\u5668\u5206\u70ba\u5200\u8207\u528d\u5169\u7a2e\uff0c\u842c\u6cd5\u6b78\u4e00\u3002</p><p class=\"bb_paragraph\" >\u96f2\u5922\u6fa4\uff1a\u64c5\u9577\u56de\u5fa9\u8207\u589e\u76ca\u6cd5\u8853\u7684\u8f14\u52a9\u9580\u6d3e\uff0c\u4f7f\u7528\u528d\u4f5c\u70ba\u6b66\u5668\u3002</p><p class=\"bb_paragraph\" >\u8305\u5c71\uff1a\u5c08\u6ce8\u65bc\u9b3c\u795e\u53ec\u559a\u8207\u6cd5\u8853\u653b\u64ca\uff0c\u4ee5\u528d\u5f62\u6cd5\u5668\u65bd\u5c55\u5404\u7a2e\u8853\u6cd5\u3002</p><p class=\"bb_paragraph\" >\u5d11\u5d19\u5c71\uff1a\u4ee5\u5f37\u529b\u6cd5\u8853\u653b\u64ca\u898b\u9577\uff0c\u64c1\u6709\u8c50\u5bcc\u591a\u6a23\u7684\u6cd5\u8853\u6280\u80fd\uff0c\u6b66\u5668\u70ba\u528d\u3002</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\u99ac\u4e0a\u52a0\u5165\u300c\u52c7\u6c23Online\u300d\uff0d\uff0d\u6230\u570b\u7684\u50b3\u8aaa\uff0c\u7531\u4f60\u89aa\u624b\u66f8\u5beb\uff01</p><p class=\"bb_paragraph\" ></p>",
    "short_description": "\u6211\u5011 \u88ab\u7b11\uff0c\u6211\u5011 \u4e0d\u88ab\u770b\u597d\uff0c\u4f46\u6211\u5011 \u4e0d\u6015\uff01\u6211\u5011\u90fd\u9700\u8981\u300c\u52c7\u6c23Online\u300d... \u300c\u52c7\u6c23Online\u300d\u662f\u4e00\u6b3e 2D \u5947\u5e7b MMORPG \u904a\u6232\uff0c\u514d\u8cbb\u958b\u73a9\u3002 \u73a9\u5bb6\u5c07\u5728\u6eab\u99a8\u53ef\u611b\u7684\u6771\u65b9\u6b66\u4fe0\u756b\u98a8\u4e2d\uff0c\u626e\u6f14\u4e00\u4f4d\u8eab\u8ca0\u4f7f\u547d\u7684\u82f1\u96c4\uff0c \u9ad4\u9a57\u4ed7\u528d\u5929\u4e0b\u3001\u65ac\u5996\u9664\u9b54\u7684\u71b1\u8840\u65c5\u7a0b\uff0c\u6216\u662f\u5728\u570b\u6230\u6c99\u5834\u4e0a\u6210\u5c31\u4e00\u65b9\u9738\u696d\uff01 \u642d\u914d\u8d85\u840c\u5bf5\u7269\u3001\u9177\u70ab\u5750\u9a0e\u3001\u6eab\u99a8\u9580\u6d3e\u548c\u71b1\u8840\u90e8\u843d\uff0c \u5c55\u958b\u4eff 3D \u5373\u6642\u6230\u9b25\u3001\u968a\u4f0d\u7fa4P\u3001\u90e8\u843d\u6230\u722d\u3001\u570b\u6230\u722d\u9738\u7b49\u591a\u5143\u73a9\u6cd5\u3002",
