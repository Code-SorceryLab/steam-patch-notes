{
    "type": "game",
    "name": "\u5e1d\u56fd\uff1a\u6743\u6756\u4e0e\u6587\u660e",
    "steam_appid": 3486430,
    "required_age": 0,
    "is_free": true,
    "detailed_description": "<p class=\"bb_paragraph\" >\u8fd9\u6b3e\u7814\u53d1\u8017\u65f63\u5e74\u4e4b\u4e45\uff0c\u98a0\u8986\u4f20\u7edfSLG\u7684\u5927\u4f5c\uff0c\u5373\u5c06\u8981\u548c\u9886\u4e3b\u4eec\u89c1\u9762\u4e86\uff01\u4e3a\u4e86\u80fd\u8fbe\u5230\u9886\u4e3b\u4eec\u7684\u671f\u5f85\uff0c\u7814\u53d1\u56e2\u961f\u53ef\u8c13\u536f\u8db3\u4e86\u52b2\uff0c\u5929\u5929\u7206\u809d\u3002\u5728\u6b64\u6211\u4eec\u627f\u8bfa\uff0c\u5728\u300a\u5e1d\u56fd\uff1a\u6743\u6756\u4e0e\u6587\u660e\u300b\u4e2d\uff0c\u8981\u628a\u62bd\u5361\u7684\u4ef7\u683c\u6253\u4e0b\u6765\uff0c\u964d\u809d\u51cf\u8d1f\u518d\u5347\u7ea7\uff0c\u7ed9\u9886\u4e3b\u4eec\u5e26\u6765\u66f4\u52a0\u7eaf\u7cb9\u7684\u7b56\u7565\u6e38\u620f\u4f53\u9a8c\u3002 </p><p class=\"bb_paragraph\" >\u3010\u5f3a\u8c0b\u7565\uff0c\u771f\u7279\u6027\u3011 </p><p class=\"bb_paragraph\" >\u4ece\u8fdc\u53e4\u65f6\u4ee3\u5f00\u59cb\uff0c\u6587\u660e\u5c31\u5982\u540c\u4e00\u5217\u52c7\u5f80\u76f4\u524d\u3001\u6c38\u4e0d\u505c\u7184\u7684\u706b\u8f66\uff0c\u7a7f\u8d8a\u65f6\u95f4\u7684\u96a7\u9053\uff0c\u4e0d\u65ad\u524d\u884c\u3002\u5b83\u4ece\u8499\u6627\u91ce\u86ee\u7684\u8fdc\u53e4\u65f6\u4ee3\u542f\u7a0b\uff0c\u9010\u6e10\u6f14\u8fdb\u5230\u7480\u74a8\u8f89\u714c\u7684\u9752\u94dc\u65f6\u4ee3\uff0c\u7136\u540e\u8fc8\u5165\u94c1\u5668\u65f6\u4ee3\u7684\u7e41\u8363\uff0c\u63a5\u7740\u7ecf\u5386\u4e86\u706b\u5668\u65f6\u4ee3\u7684\u6fc0\u8361\uff0c\u6700\u7ec8\u8fdb\u5165\u5230\u673a\u5668\u8f70\u9e23\u7684\u5de5\u4e1a\u65f6\u4ee3\u2026\u2026\u5728\u300a\u5e1d\u56fd\uff1a\u6743\u6756\u4e0e\u6587\u660e\u300b\u4e2d\uff0c\u4f60\u5c06\u5f15\u9886\u5f31\u5c0f\u8d70\u5411\u5f3a\u5927\uff0c\u5f15\u9886\u8d2b\u7620\u8d70\u5411\u7e41\u76db\uff0c\u5f15\u9886\u4eba\u7c7b\u8de8\u8d8a\u65f6\u4ee3\u548c\u5c71\u6d77\uff0c\u4f60\u5c06\u6253\u9020\u6700\u4f1f\u5927\u7684\u5947\u8ff9\u2014\u2014\u5f15\u9886\u6587\u660e\u5d1b\u8d77\uff01 </p><p class=\"bb_paragraph\" >\u3010\u65e0\u6697\u6539\uff0c\u771f\u5361\u6c60\u3011 </p><p class=\"bb_paragraph\" >\u60f3\u8981\u6210\u4e3a\u73a9\u5bb6\u4eec\u5fc3\u76ee\u4e2d\u201c\u6700\u826f\u5fc3\u7684SLG\u6e38\u620f\u201d\uff0c\u6211\u4eec\u51b3\u5b9a\u629b\u5f03\u5e02\u9762\u4e0a\u5927\u591a\u6570\u4f20\u7edfSLG\u6e38\u620f\u7684\u201c\u5c0f\u5361\u6c60\u653e\u65b0\u5361\u201d\u7684\u8bbe\u5b9a\uff0c\u5361\u6c60\u7684\u5b9a\u4f4d\u4e5f\u4f1a\u66f4\u504f\u5411\u4e8e\u8ffd\u6c42\u7279\u5b9a\u5361\u6216\u5347\u7ea2\uff0c\u4e14\u521d\u59cb\u5927\u5361\u6c60\u5c31\u53ef\u4ee5\u62bd\u5168\u6240\u6709\u6b66\u5c06\u3002\u5728\u300a\u5e1d\u56fd\uff1a\u6743\u6756\u4e0e\u6587\u660e\u300b\u4e2d\uff0c\u6211\u4eec\u6df1\u77e5\u82f1\u96c4\u89d2\u8272\u7684\u57f9\u517b\u5bf9\u73a9\u5bb6\u7684\u91cd\u8981\u6027\uff0c\u540c\u65f6\u4e5f\u5927\u5e45\u5ea6\u964d\u4f4e\u4e86\u62bd\u5361\u7684\u4ef7\u683c\uff0c\u5e76\u4fdd\u8bc1\u62bd\u5361\u7cfb\u7edf\u7684\u516c\u6b63\u6027\u548c\u968f\u673a\u6027\uff0c\u786e\u4fdd\u6bcf\u4e00\u4f4d\u73a9\u5bb6\u90fd\u80fd\u66f4\u5bb9\u6613\u83b7\u5f97\u559c\u6b22\u7684\u82f1\u96c4\u89d2\u8272\uff0c\u90fd\u80fd\u5728\u540c\u4e00\u8d77\u8dd1\u7ebf\u4e0a\u5c55\u5f00\u6fc0\u52b1\u7684\u7ade\u4e89\u4f53\u9a8c\u3002\u8bf7\u76f8\u4fe1\u6211\u4eec\u53ef\u4ee5\u6253\u9020\u51fa\u66f4\u52a0\u591a\u5143\u3001\u5145\u6ee1\u7b56\u7565\u6027\u548c\u8da3\u5473\u6027\u7684\u6218\u573a\u73af\u5883\uff01 </p><p class=\"bb_paragraph\" >\u3010\u6613\u4e0a\u624b\uff0c\u771f\u964d\u6c2a\u3011 </p><p class=\"bb_paragraph\" >\u5982\u679c\u201c\u809d\u201d\u662f\u8fdb\u5165\u6e38\u620f\u7684\u963b\u788d\uff0c\u6211\u4eec\u5c31\u201c\u964d\u809d\u51cf\u8d1f\u201d\uff0c\u8ba9\u7b56\u7565\u6e38\u620f\u597d\u73a9\u4e0d\u7d2f\uff1b\u5982\u679c\u201c\u6c2a\u201d\u662f\u65e0\u6cd5\u6301\u7eed\u73a9SLG\u7684\u7406\u7531\uff0c\u90a3\u6211\u4eec\u5c31\u201c\u5927\u5e45\u51cf\u6c2a\u201d\u3002\u73b0\u5728\uff0c\u6211\u4eec\u53ef\u4ee5\u5728\u8fd9\u91cc\u5927\u58f0\u8bf4\uff1a\u548c\u300a\u5e1d\u56fd\uff1a\u6743\u6756\u4e0e\u6587\u660e\u300b\u54c1\u8d28\u76f8\u8fd1\u7684\u6587\u660e\u7b56\u7565\u6e38\u620f\uff0c\u6ca1\u6709\u6211\u4eec\u6027\u4ef7\u6bd4\u9ad8\uff1b\u548c\u6211\u4eec\u4ef7\u683c\u76f8\u4f3c\u7684\u6ca1\u6709\u6211\u4eec\u597d\u73a9\u3002\u603b\u800c\u8a00\u4e4b\uff0c\u4e0d\u662f\u5176\u4ed6\u6587\u660e\u7b56\u7565\u6e38\u620f\u73a9\u4e0d\u8d77\uff0c\u800c\u662f\u6211\u4eec\u66f4\u6709\u6027\u4ef7\u6bd4\uff01\u8fd9\u4e00\u6b21\uff0c\u8ba9\u6211\u4eec\u4e00\u8d77\u5c06SLG\u7684\u4ef7\u683c\u6253\u4e0b\u6765\uff01\u964d\u6c2a\u51cf\u8d1f\u8fd9\u53e5\u8bdd\uff0c\u300a\u5e1d\u56fd\uff1a\u6743\u6756\u4e0e\u6587\u660e\u300b\u4e0d\u53ea\u662f\u8bf4\u8bf4\u800c\u5df2\uff0c\u6211\u4eec\u66f4\u60f3\u4e3a\u73a9\u5bb6\u4eec\u5efa\u7acb\u4e00\u4e2a\u5065\u5eb7\u3001\u53ef\u6301\u7eed\u7684\u6e38\u620f\u73af\u5883\uff0c\u8ba9\u66f4\u591a\u4eba\u4f53\u9a8c\u5230\u7b56\u7565\u6e38\u620f\u7684\u9b45\u529b\u3002</p><p class=\"bb_paragraph\" >\u3010\u5f00\u5546\u8def\uff0c\u771f\u8d38\u6613\u3011</p><p class=\"bb_paragraph\" > \u5728\u4f20\u7edfSLG\u6e38\u620f\u7684\u5185\u6838\u57fa\u7840\u4e0a\uff0c\u300a\u5e1d\u56fd\uff1a\u6743\u6756\u4e0e\u6587\u660e\u300b\u5f88\u597d\u7684\u5c06\u5f88\u591a\u6587\u660e\u5143\u7d20\u5730\u878d\u5408\u4e86\u8fdb\u53bb\uff0c\u6bd4\u5982\u57ce\u5e02\u8d38\u6613\uff0c\u73a9\u5bb6\u95f4\u53ef\u4ee5\u8fdb\u884c\u8d38\u6613\uff0c\u653b\u4e0b\u57ce\u5e02\u540e\u4e5f\u80fd\u4e0e\u57ce\u5e02\u8fdb\u884c\u8d38\u6613\u3002 \u6e38\u620f\u9f13\u52b1\u73a9\u5bb6\u901a\u8fc7\u6d77\u6218\u63a2\u7d22\u672a\u77e5\u6d77\u57df\uff0c\u79ef\u7d2f\u8d22\u5bcc\u4e0e\u8363\u8000\u3002\u73a9\u5bb6\u53ef\u4ee5\u7a7f\u68ad\u4e8e\u5404\u5927\u6e2f\u53e3\u4e4b\u95f4\uff0c\u8fdb\u884c\u8d38\u6613\u5f80\u6765\uff0c\u79ef\u7d2f\u8d22\u5bcc\u548c\u8d44\u6e90\u3002\u4e5f\u53ef\u4ee5\u88ad\u51fb\u654c\u5bf9\u52bf\u529b\u7684\u5546\u8239\u548c\u8230\u961f\uff0c\u63a0\u593a\u73cd\u8d35\u7684\u8d27\u7269\u548c\u5b9d\u7269\u3002\u8fd9\u79cd\u5145\u6ee1\u523a\u6fc0\u4e0e\u98ce\u9669\u7684\u8d38\u6613\u4e0e\u52ab\u63a0\u4f53\u9a8c\uff0c\u5c06\u8ba9\u73a9\u5bb6\u5728\u8ffd\u6c42\u8363\u8000\u4e0e\u8d22\u5bcc\u7684\u540c\u65f6\uff0c\u611f\u53d7\u5230\u5927\u822a\u6d77\u65f6\u4ee3\u6d77\u4e0a\u7684\u53d8\u5e7b\u98ce\u4e91\u3002 </p>",
    "about_the_game": "<p class=\"bb_paragraph\" >\u8fd9\u6b3e\u7814\u53d1\u8017\u65f63\u5e74\u4e4b\u4e45\uff0c\u98a0\u8986\u4f20\u7edfSLG\u7684\u5927\u4f5c\uff0c\u5373\u5c06\u8981\u548c\u9886\u4e3b\u4eec\u89c1\u9762\u4e86\uff01\u4e3a\u4e86\u80fd\u8fbe\u5230\u9886\u4e3b\u4eec\u7684\u671f\u5f85\uff0c\u7814\u53d1\u56e2\u961f\u53ef\u8c13\u536f\u8db3\u4e86\u52b2\uff0c\u5929\u5929\u7206\u809d\u3002\u5728\u6b64\u6211\u4eec\u627f\u8bfa\uff0c\u5728\u300a\u5e1d\u56fd\uff1a\u6743\u6756\u4e0e\u6587\u660e\u300b\u4e2d\uff0c\u8981\u628a\u62bd\u5361\u7684\u4ef7\u683c\u6253\u4e0b\u6765\uff0c\u964d\u809d\u51cf\u8d1f\u518d\u5347\u7ea7\uff0c\u7ed9\u9886\u4e3b\u4eec\u5e26\u6765\u66f4\u52a0\u7eaf\u7cb9\u7684\u7b56\u7565\u6e38\u620f\u4f53\u9a8c\u3002 </p><p class=\"bb_paragraph\" >\u3010\u5f3a\u8c0b\u7565\uff0c\u771f\u7279\u6027\u3011 </p><p class=\"bb_paragraph\" >\u4ece\u8fdc\u53e4\u65f6\u4ee3\u5f00\u59cb\uff0c\u6587\u660e\u5c31\u5982\u540c\u4e00\u5217\u52c7\u5f80\u76f4\u524d\u3001\u6c38\u4e0d\u505c\u7184\u7684\u706b\u8f66\uff0c\u7a7f\u8d8a\u65f6\u95f4\u7684\u96a7\u9053\uff0c\u4e0d\u65ad\u524d\u884c\u3002\u5b83\u4ece\u8499\u6627\u91ce\u86ee\u7684\u8fdc\u53e4\u65f6\u4ee3\u542f\u7a0b\uff0c\u9010\u6e10\u6f14\u8fdb\u5230\u7480\u74a8\u8f89\u714c\u7684\u9752\u94dc\u65f6\u4ee3\uff0c\u7136\u540e\u8fc8\u5165\u94c1\u5668\u65f6\u4ee3\u7684\u7e41\u8363\uff0c\u63a5\u7740\u7ecf\u5386\u4e86\u706b\u5668\u65f6\u4ee3\u7684\u6fc0\u8361\uff0c\u6700\u7ec8\u8fdb\u5165\u5230\u673a\u5668\u8f70\u9e23\u7684\u5de5\u4e1a\u65f6\u4ee3\u2026\u2026\u5728\u300a\u5e1d\u56fd\uff1a\u6743\u6756\u4e0e\u6587\u660e\u300b\u4e2d\uff0c\u4f60\u5c06\u5f15\u9886\u5f31\u5c0f\u8d70\u5411\u5f3a\u5927\uff0c\u5f15\u9886\u8d2b\u7620\u8d70\u5411\u7e41\u76db\uff0c\u5f15\u9886\u4eba\u7c7b\u8de8\u8d8a\u65f6\u4ee3\u548c\u5c71\u6d77\uff0c\u4f60\u5c06\u6253\u9020\u6700\u4f1f\u5927\u7684\u5947\u8ff9\u2014\u2014\u5f15\u9886\u6587\u660e\u5d1b\u8d77\uff01 </p><p class=\"bb_paragraph\" >\u3010\u65e0\u6697\u6539\uff0c\u771f\u5361\u6c60\u3011 </p><p class=\"bb_paragraph\" >\u60f3\u8981\u6210\u4e3a\u73a9\u5bb6\u4eec\u5fc3\u76ee\u4e2d\u201c\u6700\u826f\u5fc3\u7684SLG\u6e38\u620f\u201d\uff0c\u6211\u4eec\u51b3\u5b9a\u629b\u5f03\u5e02\u9762\u4e0a\u5927\u591a\u6570\u4f20\u7edfSLG\u6e38\u620f\u7684\u201c\u5c0f\u5361\u6c60\u653e\u65b0\u5361\u201d\u7684\u8bbe\u5b9a\uff0c\u5361\u6c60\u7684\u5b9a\u4f4d\u4e5f\u4f1a\u66f4\u504f\u5411\u4e8e\u8ffd\u6c42\u7279\u5b9a\u5361\u6216\u5347\u7ea2\uff0c\u4e14\u521d\u59cb\u5927\u5361\u6c60\u5c31\u53ef\u4ee5\u62bd\u5168\u6240\u6709\u6b66\u5c06\u3002\u5728\u300a\u5e1d\u56fd\uff1a\u6743\u6756\u4e0e\u6587\u660e\u300b\u4e2d\uff0c\u6211\u4eec\u6df1\u77e5\u82f1\u96c4\u89d2\u8272\u7684\u57f9\u517b\u5bf9\u73a9\u5bb6\u7684\u91cd\u8981\u6027\uff0c\u540c\u65f6\u4e5f\u5927\u5e45\u5ea6\u964d\u4f4e\u4e86\u62bd\u5361\u7684\u4ef7\u683c\uff0c\u5e76\u4fdd\u8bc1\u62bd\u5361\u7cfb\u7edf\u7684\u516c\u6b63\u6027\u548c\u968f\u673a\u6027\uff0c\u786e\u4fdd\u6bcf\u4e00\u4f4d\u73a9\u5bb6\u90fd\u80fd\u66f4\u5bb9\u6613\u83b7\u5f97\u559c\u6b22\u7684\u82f1\u96c4\u89d2\u8272\uff0c\u90fd\u80fd\u5728\u540c\u4e00\u8d77\u8dd1\u7ebf\u4e0a\u5c55\u5f00\u6fc0\u52b1\u7684\u7ade\u4e89\u4f53\u9a8c\u3002\u8bf7\u76f8\u4fe1\u6211\u4eec\u53ef\u4ee5\u6253\u9020\u51fa\u66f4\u52a0\u591a\u5143\u3001\u5145\u6ee1\u7b56\u7565\u6027\u548c\u8da3\u5473\u6027\u7684\u6218\u573a\u73af\u5883\uff01 </p><p class=\"bb_paragraph\" >\u3010\u6613\u4e0a\u624b\uff0c\u771f\u964d\u6c2a\u3011 </p><p class=\"bb_paragraph\" >\u5982\u679c\u201c\u809d\u201d\u662f\u8fdb\u5165\u6e38\u620f\u7684\u963b\u788d\uff0c\u6211\u4eec\u5c31\u201c\u964d\u809d\u51cf\u8d1f\u201d\uff0c\u8ba9\u7b56\u7565\u6e38\u620f\u597d\u73a9\u4e0d\u7d2f\uff1b\u5982\u679c\u201c\u6c2a\u201d\u662f\u65e0\u6cd5\u6301\u7eed\u73a9SLG\u7684\u7406\u7531\uff0c\u90a3\u6211\u4eec\u5c31\u201c\u5927\u5e45\u51cf\u6c2a\u201d\u3002\u73b0\u5728\uff0c\u6211\u4eec\u53ef\u4ee5\u5728\u8fd9\u91cc\u5927\u58f0\u8bf4\uff1a\u548c\u300a\u5e1d\u56fd\uff1a\u6743\u6756\u4e0e\u6587\u660e\u300b\u54c1\u8d28\u76f8\u8fd1\u7684\u6587\u660e\u7b56\u7565\u6e38\u620f\uff0c\u6ca1\u6709\u6211\u4eec\u6027\u4ef7\u6bd4\u9ad8\uff1b\u548c\u6211\u4eec\u4ef7\u683c\u76f8\u4f3c\u7684\u6ca1\u6709\u6211\u4eec\u597d\u73a9\u3002\u603b\u800c\u8a00\u4e4b\uff0c\u4e0d\u662f\u5176\u4ed6\u6587\u660e\u7b56\u7565\u6e38\u620f\u73a9\u4e0d\u8d77\uff0c\u800c\u662f\u6211\u4eec\u66f4\u6709\u6027\u4ef7\u6bd4\uff01\u8fd9\u4e00\u6b21\uff0c\u8ba9\u6211\u4eec\u4e00\u8d77\u5c06SLG\u7684\u4ef7\u683c\u6253\u4e0b\u6765\uff01\u964d\u6c2a\u51cf\u8d1f\u8fd9\u53e5\u8bdd\uff0c\u300a\u5e1d\u56fd\uff1a\u6743\u6756\u4e0e\u6587\u660e\u300b\u4e0d\u53ea\u662f\u8bf4\u8bf4\u800c\u5df2\uff0c\u6211\u4eec\u66f4\u60f3\u4e3a\u73a9\u5bb6\u4eec\u5efa\u7acb\u4e00\u4e2a\u5065\u5eb7\u3001\u53ef\u6301\u7eed\u7684\u6e38\u620f\u73af\u5883\uff0c\u8ba9\u66f4\u591a\u4eba\u4f53\u9a8c\u5230\u7b56\u7565\u6e38\u620f\u7684\u9b45\u529b\u3002</p><p class=\"bb_paragraph\" >\u3010\u5f00\u5546\u8def\uff0c\u771f\u8d38\u6613\u3011</p><p class=\"bb_paragraph\" > \u5728\u4f20\u7edfSLG\u6e38\u620f\u7684\u5185\u6838\u57fa\u7840\u4e0a\uff0c\u300a\u5e1d\u56fd\uff1a\u6743\u6756\u4e0e\u6587\u660e\u300b\u5f88\u597d\u7684\u5c06\u5f88\u591a\u6587\u660e\u5143\u7d20\u5730\u878d\u5408\u4e86\u8fdb\u53bb\uff0c\u6bd4\u5982\u57ce\u5e02\u8d38\u6613\uff0c\u73a9\u5bb6\u95f4\u53ef\u4ee5\u8fdb\u884c\u8d38\u6613\uff0c\u653b\u4e0b\u57ce\u5e02\u540e\u4e5f\u80fd\u4e0e\u57ce\u5e02\u8fdb\u884c\u8d38\u6613\u3002 \u6e38\u620f\u9f13\u52b1\u73a9\u5bb6\u901a\u8fc7\u6d77\u6218\u63a2\u7d22\u672a\u77e5\u6d77\u57df\uff0c\u79ef\u7d2f\u8d22\u5bcc\u4e0e\u8363\u8000\u3002\u73a9\u5bb6\u53ef\u4ee5\u7a7f\u68ad\u4e8e\u5404\u5927\u6e2f\u53e3\u4e4b\u95f4\uff0c\u8fdb\u884c\u8d38\u6613\u5f80\u6765\uff0c\u79ef\u7d2f\u8d22\u5bcc\u548c\u8d44\u6e90\u3002\u4e5f\u53ef\u4ee5\u88ad\u51fb\u654c\u5bf9\u52bf\u529b\u7684\u5546\u8239\u548c\u8230\u961f\uff0c\u63a0\u593a\u73cd\u8d35\u7684\u8d27\u7269\u548c\u5b9d\u7269\u3002\u8fd9\u79cd\u5145\u6ee1\u523a\u6fc0\u4e0e\u98ce\u9669\u7684\u8d38\u6613\u4e0e\u52ab\u63a0\u4f53\u9a8c\uff0c\u5c06\u8ba9\u73a9\u5bb6\u5728\u8ffd\u6c42\u8363\u8000\u4e0e\u8d22\u5bcc\u7684\u540c\u65f6\uff0c\u611f\u53d7\u5230\u5927\u822a\u6d77\u65f6\u4ee3\u6d77\u4e0a\u7684\u53d8\u5e7b\u98ce\u4e91\u3002 </p>",
    "short_description": "\u5728\u4f60\u7684\u773c\u91cc\uff0c\u6587\u660e\u662f\u600e\u4e48\u6837\u7684\uff1f\u662f\u77f3\u5934\u957f\u77db\u5230\u98de\u673a\u5bfc\u5f39\u7684\u8de8\u65f6\u4ee3\u6218\u573a\uff0c\u8fd8\u662f\u4ece\u4e09\u56fd\u65f6\u4ee3\u5230\u9a91\u58eb\u4e4b\u5251\u7684\u5730\u57df\u65f6\u7a7a\u8de8\u8d8a\uff0c\u4ea6\u6216\u662f\u548c\u65e0\u6570\u5386\u53f2\u82f1\u96c4\u4e00\u8d77\u80a9\u5e76\u80a9\u4f5c\u6218\u548c\u51b3\u7b56\u7684\u673a\u4f1a\uff0c\u66f4\u662f\u4ece\u751f\u547d\u6700\u521d\u7684\u840c\u82bd\uff0c\u5230\u6700\u4f1f\u5927\u6587\u660e\u7684\u8270\u8f9b\u8fdb\u5316\u65c5\u7a0b\u00b7\u00b7\u00b7\u00b7\u00b7\u00b7 \u8fd9\u4e00\u5207\uff0c\u76f8\u4fe1\u5728\u300a\u5e1d\u56fd\uff1a\u6743\u6756\u4e0e\u6587\u660e\u300b\u4e2d\uff0c\u90fd\u80fd\u627e\u5230\u5c5e\u4e8e\u4f60\u7684\u7b54\u6848\u3002",
