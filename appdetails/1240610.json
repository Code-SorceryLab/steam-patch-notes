=1671791113\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1240610/extras/dd532da0966e7a6f694dd404a6a64158.mp4?t=1671791113\" type=\"video/mp4\"></video></div><br>You can also gain different achievements and titles to increase your ability.<br><div class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1240610/extras/7c4511e9fb899d5305b63fd7c9883dce.poster.avif?t=1671791113\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1240610/extras/7c4511e9fb899d5305b63fd7c9883dce.webm?t=1671791113\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1240610/extras/7c4511e9fb899d5305b63fd7c9883dce.mp4?t=1671791113\" type=\"video/mp4\"></video></div><br><br>=========[Content Expansion - Treasure Seizing Adventure]=========<br>[Buy a shovel to dig and find treasures]<br><div class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1240610/extras/b2f6395e86efc88ff836c9224516ef02.poster.avif?t=1671791113\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1240610/extras/b2f6395e86efc88ff836c9224516ef02.webm?t=1671791113\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1240610/extras/b2f6395e86efc88ff836c9224516ef02.mp4?t=1671791113\" type=\"video/mp4\"></video></div><br><br>[Defeat Wulin experts and fight for the treasure map fragments]<br><div class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline crossorigin=\"anonymous\" poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1240610/extras/5522a94a2e52343ba633d88d97a362c5.poster.avif?t=1671791113\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1240610/extras/5522a94a2e52343ba633d88d97a362c5.webm?t=1671791113\" type=\"video/webm; codecs=vp9\"></video></div><br><br>[Search for the earth's veins and decipher them]<br><div class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1240610/extras/c3aee1067f6895a27e9b8fc8ecf09ad6.poster.avif?t=1671791113\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1240610/extras/c3aee1067f6895a27e9b8fc8ecf09ad6.webm?t=1671791113\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1240610/extras/c3aee1067f6895a27e9b8fc8ecf09ad6.mp4?t=1671791113\" type=\"video/mp4\"></video></div><br><div class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1240610/extras/60f82c07bc967dd4c9a7eb8c1a118881.poster.avif?t=1671791113\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1240610/extras/60f82c07bc967dd4c9a7eb8c1a118881.webm?t=1671791113\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1240610/extras/60f82c07bc967dd4c9a7eb8c1a118881.mp4?t=1671791113\" type=\"video/mp4\"></video></div><br><br>[Win mythical items and unlock the ending of the branch line]<br><div class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1240610/extras/db0dfda28ae549c3f110f79e7a35eb75.poster.avif?t=1671791113\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1240610/extras/db0dfda28ae549c3f110f79e7a35eb75.webm?t=1671791113\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1240610/extras/db0dfda28ae549c3f110f79e7a35eb75.mp4?t=1671791113\" type=\"video/mp4\"></video></div><br><div class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1240610/extras/df9ff1d51a86de049c63210e6b0a801a.poster.avif?t=1671791113\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1240610/extras/df9ff1d51a86de049c63210e6b0a801a.webm?t=1671791113\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1240610/extras/df9ff1d51a86de049c63210e6b0a801a.mp4?t=1671791113\" type=\"video/mp4\"></video></div>",
