caa5f3c0.webm?t=1751392617\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3771770/extras/19febbb2e3f2d74be74e8df4caa5f3c0.mp4?t=1751392617\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3771770/extras/e3c62fc1de2f608061ff06fda23f8206.avif?t=1751392617\" width=670 height=50 /></span></p><p class=\"bb_paragraph\" ><strong>Official reports</strong> do not explain what exactly happened.<br>The recordings cut off abruptly, the signal vanished, and the operator never re-established contact.<br><strong>The room remains locked from the inside.</strong> No signs of struggle, no bodies.<br>Now you are here. In front of the same screens. With the same task.</p><p class=\"bb_paragraph\" ><strong>Watch closely.</strong> Miss nothing.<br>And try not to follow in their footsteps.</p>",
