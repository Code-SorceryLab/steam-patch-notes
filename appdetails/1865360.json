ttps://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1865360/extras/b6539b708a1d911453128b50d20bf2ba.webm?t=1727871527\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1865360/extras/b6539b708a1d911453128b50d20bf2ba.mp4?t=1727871527\" type=\"video/mp4\"></video></div><h2 class=\"bb_tag\">FEATURES:</h2><ul class=\"bb_ul\"><li>Many unique minions<br></li><li>3 special Bosses<br></li><li>Explore new biomes<br></li><li>Unlock new abilities<br></li><li>Shoot 'em all up</li></ul>",
