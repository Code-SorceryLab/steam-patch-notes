    "detailed_description": "<p class=\"bb_paragraph\">\u4e1c\u4e4b\u5927\u5730\u5f25\u6f2b\u7740\u6d53\u96fe\uff0c\u6b7b\u8005\u4eec\u518d\u5ea6\u82cf\u9192\u3002</p><p class=\"bb_paragraph\">\u6218\u4e89\uff0c\u6218\u4e89\uff0c\u65e0\u5c3d\u7684\u6218\u4e89\u3002</p><p class=\"bb_paragraph\">\u73b0\u5728\u662f\u80dc\u8005\u4eec\u4ed8\u51fa\u4ee3\u4ef7\u7684\u65f6\u5019\u4e86\u3002</p><p class=\"bb_paragraph\">\u4f60\u662f\u4e00\u4f4d\u6765\u81ea\u7f57\u4f2f\u91cc\u4e9a\u738b\u56fd\u7684\u52c7\u8005\uff0c\u4f60\u8981\u7ec8\u7ed3\u8fd9\u573a\u7531\u3010\u4ea1\u7075\u4e4b\u90fd\u3011\u51e1\u5c14\u987f\u738b\u56fd\u5e26\u6765\u7684\u707e\u96be\u3002</p><p class=\"bb_paragraph\">\u6216\u8005..........\u8fd9\u5176\u5b9e\u5e76\u4e0d\u91cd\u8981\uff1f</p><p class=\"bb_paragraph\"></p><p class=\"bb_paragraph\">\u5e0c\u671b\u4f60\u80fd\u65a9\u65ad\u8fd9\u60b2\u54c0\u7684\u8f6e\u56de\u3002</p><p class=\"bb_paragraph\"></p><p class=\"bb_paragraph\">\u203bwin10\u6216\u8005win11\u7528\u6237\u5728\u8fdb\u884c\u6e38\u620f\u65f6\uff0c\u53ef\u80fd\u4f1a\u51fa\u73b0\u6e38\u620f\u901f\u5ea6\u5f02\u5e38\u7684\u95ee\u9898\uff0c\u53ef\u4ee5\u901a\u8fc7\u8fdb\u5165 \u7cfb\u7edf\u2192\u5c4f\u5e55\u2192\u9ad8\u7ea7\u663e\u793a\u5668\u8bbe\u7f6e \u5c06\u9009\u62e9\u5237\u65b0\u7387\u8c03\u6574\u4e3a60hz\u89e3\u51b3\u3002</p><p class=\"bb_paragraph\">\u203b\u73a9\u5bb6\u4ea4\u6d41Q\u7fa4\uff1a974464175</p><p class=\"bb_paragraph\">\u203b\u6e38\u620f\u653b\u7565\u4e0e\u8ba8\u8bba\uff1a\u641c\u7d22 \u52c7\u8005\u4e0e\u4ea1\u7075\u4e4b\u90fd\u5427</p>",
    "about_the_game": "<p class=\"bb_paragraph\">\u4e1c\u4e4b\u5927\u5730\u5f25\u6f2b\u7740\u6d53\u96fe\uff0c\u6b7b\u8005\u4eec\u518d\u5ea6\u82cf\u9192\u3002</p><p class=\"bb_paragraph\">\u6218\u4e89\uff0c\u6218\u4e89\uff0c\u65e0\u5c3d\u7684\u6218\u4e89\u3002</p><p class=\"bb_paragraph\">\u73b0\u5728\u662f\u80dc\u8005\u4eec\u4ed8\u51fa\u4ee3\u4ef7\u7684\u65f6\u5019\u4e86\u3002</p><p class=\"bb_paragraph\">\u4f60\u662f\u4e00\u4f4d\u6765\u81ea\u7f57\u4f2f\u91cc\u4e9a\u738b\u56fd\u7684\u52c7\u8005\uff0c\u4f60\u8981\u7ec8\u7ed3\u8fd9\u573a\u7531\u3010\u4ea1\u7075\u4e4b\u90fd\u3011\u51e1\u5c14\u987f\u738b\u56fd\u5e26\u6765\u7684\u707e\u96be\u3002</p><p class=\"bb_paragraph\">\u6216\u8005..........\u8fd9\u5176\u5b9e\u5e76\u4e0d\u91cd\u8981\uff1f</p><p class=\"bb_paragraph\"></p><p class=\"bb_paragraph\">\u5e0c\u671b\u4f60\u80fd\u65a9\u65ad\u8fd9\u60b2\u54c0\u7684\u8f6e\u56de\u3002</p><p class=\"bb_paragraph\"></p><p class=\"bb_paragraph\">\u203bwin10\u6216\u8005win11\u7528\u6237\u5728\u8fdb\u884c\u6e38\u620f\u65f6\uff0c\u53ef\u80fd\u4f1a\u51fa\u73b0\u6e38\u620f\u901f\u5ea6\u5f02\u5e38\u7684\u95ee\u9898\uff0c\u53ef\u4ee5\u901a\u8fc7\u8fdb\u5165 \u7cfb\u7edf\u2192\u5c4f\u5e55\u2192\u9ad8\u7ea7\u663e\u793a\u5668\u8bbe\u7f6e \u5c06\u9009\u62e9\u5237\u65b0\u7387\u8c03\u6574\u4e3a60hz\u89e3\u51b3\u3002</p><p class=\"bb_paragraph\">\u203b\u73a9\u5bb6\u4ea4\u6d41Q\u7fa4\uff1a974464175</p><p class=\"bb_paragraph\">\u203b\u6e38\u620f\u653b\u7565\u4e0e\u8ba8\u8bba\uff1a\u641c\u7d22 \u52c7\u8005\u4e0e\u4ea1\u7075\u4e4b\u90fd\u5427</p>",
