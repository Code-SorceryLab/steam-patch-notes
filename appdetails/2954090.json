90/extras/d141b22ec7fb2258276c2ee50a2cf45a.mp4?t=1755084714\" type=\"video/mp4\"></video></span></p><h2 class=\"bb_tag\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2954090/extras/1dbee1790f580e0b3a59773940ca5331.avif?t=1755084714\" width=297 height=67 /></span></h2><p class=\"bb_paragraph\" >Face ever-growing hordes of enemies and battle until you're ready for the boss.</p><p class=\"bb_paragraph\" >Beat all 9 levels and bosses within a limited time to escape the city!</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2954090/extras/b4dc2f400b08d550e7afe0dbbc4a416c.poster.avif?t=1755084714\" width=500 height=150 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2954090/extras/b4dc2f400b08d550e7afe0dbbc4a416c.webm?t=1755084714\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2954090/extras/b4dc2f400b08d550e7afe0dbbc4a416c.mp4?t=1755084714\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2954090/extras/cfeb2ceb0c2ae08f64b330153330987b.poster.avif?t=1755084714\" width=500 height=150 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2954090/extras/cfeb2ceb0c2ae08f64b330153330987b.webm?t=1755084714\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2954090/extras/cfeb2ceb0c2ae08f64b330153330987b.mp4?t=1755084714\" type=\"video/mp4\"></video></span></p><h2 class=\"bb_tag\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2954090/extras/a9177905840364716e2e0f0fe18110d8.avif?t=1755084714\" width=297 height=67 /></span></h2><p class=\"bb_paragraph\" >Defeated enemies drop valuable materials,</p><p class=\"bb_paragraph\" >which you can trade between escape attempts for over 100 different ship modules.</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2954090/extras/470dbc888ba7c1c8e9c3b51a5b85889f.poster.avif?t=1755084714\" width=500 height=208 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2954090/extras/470dbc888ba7c1c8e9c3b51a5b85889f.webm?t=1755084714\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2954090/extras/470dbc888ba7c1c8e9c3b51a5b85889f.mp4?t=1755084714\" type=\"video/mp4\"></video></span></p>",
