{
    "type": "game",
    "name": "NINJA SLAYER NEO-SAITAMA IN FLAMES(\u30cb\u30f3\u30b8\u30e3\u30b9\u30ec\u30a4\u30e4\u30fc \u30cd\u30aa\u30b5\u30a4\u30bf\u30de\u708e\u4e0a)",
    "steam_appid": 2752330,
