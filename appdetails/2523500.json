m; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2523500/extras/98cb6afdc0a4dad1c0c055eb4a581b2d.mp4?t=1735341017\" type=\"video/mp4\"></video></span><br><br><strong>Quirky Dialogue</strong><br>Stroll through walkable levels and connect with the locals.<br><br><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2523500/extras/0256317a1f7dd8383a99d5bc961e6046.poster.avif?t=1735341017\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2523500/extras/0256317a1f7dd8383a99d5bc961e6046.webm?t=1735341017\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2523500/extras/0256317a1f7dd8383a99d5bc961e6046.mp4?t=1735341017\" type=\"video/mp4\"></video></span><br><br><strong>Little Slices of Life</strong><br>Unlock cozy dioramas and charming lore through achievements and story progression.<br><br><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2523500/extras/09b72b8c049cbd85f866ffb71bf06ab8.poster.avif?t=1735341017\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2523500/extras/09b72b8c049cbd85f866ffb71bf06ab8.webm?t=1735341017\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2523500/extras/09b72b8c049cbd85f866ffb71bf06ab8.mp4?t=1735341017\" type=\"video/mp4\"></video></span>",
