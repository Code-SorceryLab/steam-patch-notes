oop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3048670/extras/558645267493f0c42368fcc3d3716858.poster.avif?t=1747574230\" width=600 height=82 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3048670/extras/558645267493f0c42368fcc3d3716858.webm?t=1747574230\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3048670/extras/558645267493f0c42368fcc3d3716858.mp4?t=1747574230\" type=\"video/mp4\"></video></span></p>",
