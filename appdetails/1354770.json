ous\" poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1354770/extras/4f872c3930cad26c6ee07055589563e6.poster.avif?t=1747723876\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1354770/extras/4f872c3930cad26c6ee07055589563e6.webm?t=1747723876\" type=\"video/webm; codecs=vp9\"></video></div>",
