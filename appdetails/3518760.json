    "detailed_description": "<p class=\"bb_paragraph\" >\u6e38\u620f\u7b80\u4ecb</p><p class=\"bb_paragraph\" >\u6e38\u620f\u4e2d\u73a9\u5bb6\u867d\u7136\u51fa\u8eab\u5e73\u51e1\uff0c\u4f46\u4ed6\u70ed\u7231\u4fee\u884c\u3001\u65e0\u6240\u754f\u60e7\uff0c\u5728\u6d2a\u8352\u4e4b\u5b50\u7684\u6c14\u8fd0\u52a0\u6301\u4e4b\u4e0b\uff0c\u4e00\u8def\u900d\u9065\u95ef\u8361\uff0c\u6210\u4e3a\u8fd9\u7247\u5927\u9646\u4e0a\u6700\u7279\u7acb\u72ec\u884c\u7684\u609f\u9053\u8005\u3002\u5927\u9646\u5185\u6bcf\u4e2a\u5730\u70b9\u6d3b\u52a8\u90fd\u6709\u4e0d\u540c\u6311\u6218\u7b49\u7740\u4f60\uff0c\u968f\u7740\u5883\u754c\u7b49\u7ea7\u3001\u6218\u529b\u7684\u63d0\u5347\u4f18\u5316\u5956\u52b1\u548c\u83b7\u5f97\u66f4\u591a\u7ecf\u9a8c\u503c\uff0c\u80fd\u591f\u66f4\u597d\u4f53\u9a8c\u6e38\u620f\u3002\u6e38\u620f\u5185\u4e30\u5bcc\u7684\u6210\u957f\u578b\u7cfb\u7edf\u8bf8\u5982\u5f02\u517d\u3001\u6cd5\u5b9d\u3001\u5883\u754c\u3001\u5347\u9636\u3001\u795e\u6212\u7b49\u80fd\u4e3a\u73a9\u5bb6\u5e26\u6765\u4e0e\u4f17\u4e0d\u540c\u7684\u4fee\u4ed9\u609f\u9053\u4f53\u9a8c\u3002\u540c\u65f6\u6e38\u620f\u4e2d\u591a\u79cdPVP\u3001PVE\u6218\u6597\u6a21\u5f0f\uff0c\u4e0d\u505c\u523a\u6fc0\u73a9\u5bb6\u6218\u6597\u6b32\u671b\u3002\u753b\u9762\u7cbe\u7f8e\u3001\u6548\u679c\u903c\u771f\uff0c\u4f1a\u4ee4\u73a9\u5bb6\u7231\u4e0d\u91ca\u624b\uff0c\u5feb\u6765\u4f53\u9a8c\u5427\uff01</p><p class=\"bb_paragraph\" >\u65e5\u5e38\u4efb\u52a1</p><p class=\"bb_paragraph\" >1.\u7cfb\u7edf\u5165\u53e3</p><p class=\"bb_paragraph\" >\u4f4d\u4e8e\u754c\u9762\u4e0a\u65b9\u7684\u65e5\u5e38</p><p class=\"bb_paragraph\" > </p><p class=\"bb_paragraph\" >2.\u7cfb\u7edf\u73a9\u6cd5</p><p class=\"bb_paragraph\" >\u65e5\u5e38\u4e2d\u5171\u6709\u4e24\u4e2a\u9875\u7b7e\uff1a</p><p class=\"bb_paragraph\" >\u6d3b\u8dc3\uff1b</p><p class=\"bb_paragraph\" >\u6d3b\u52a8\u5927\u5385\u3002</p><p class=\"bb_paragraph\" >2.1\u6d3b\u8dc3</p><p class=\"bb_paragraph\" >\u5b8c\u6210\u5176\u4e2d\u7684\u65e5\u5e38\u4efb\u52a1\uff0c\u53ef\u4ee5\u83b7\u5f97\u6d3b\u8dc3\u5ea6</p><p class=\"bb_paragraph\" >\u6d3b\u8dc3\u5ea6\u79ef\u6512\u5230\u4e00\u5b9a\u7a0b\u5ea6\u53ef\u4ee5\u9886\u53d6\u5b9d\u7bb1\uff0c\u5b9d\u7bb1\u4e2d\u6709\u5927\u91cf\u65e5\u5e38\u8d44\u6e90</p><p class=\"bb_paragraph\" >\u6d3b\u8dc3\u5ea6\u548c\u4efb\u52a1\u6bcf\u65e5\u5237\u65b0\uff0c\u8bb0\u5f97\u53ca\u65f6\u9886\u53d6</p><p class=\"bb_paragraph\" > </p><p class=\"bb_paragraph\" >2.2\u6d3b\u52a8\u5927\u5385</p><p class=\"bb_paragraph\" >\u6d3b\u52a8\u5927\u5385\u4e5f\u53ef\u901a\u8fc7\u6b64\u5165\u53e3\u8fdb\u5165</p><p class=\"bb_paragraph\" > </p><p class=\"bb_paragraph\" >\u53ef\u4ee5\u5728\u6b64\u5904\u67e5\u770b\u6bcf\u65e5\u7684\u5927\u578b\u6d3b\u52a8\uff0c\u4ee5\u53ca\u6d3b\u52a8\u7684\u89c4\u5219\u548c\u5185\u5bb9</p><p class=\"bb_paragraph\" >\u6d3b\u52a8\u5f00\u542f\u65f6\uff0c\u53f3\u4e0b\u89d2\u8fd8\u4f1a\u6709\u5f39\u7a97\u53ef\u4ee5\u76f4\u63a5\u8df3\u8fdb\u76f8\u5173\u9875\u9762</p><p class=\"bb_paragraph\" > </p><p class=\"bb_paragraph\" >\u8f6c\u751f</p><p class=\"bb_paragraph\" >1.\u5165\u53e3</p><p class=\"bb_paragraph\" >  </p><p class=\"bb_paragraph\" >\u901a\u8fc7\u70b9\u51fb\u4e3b\u754c\u9762\u4e0b\u65b9-\u89d2\u8272\u5165\u53e3\u56fe\u6807\u8fdb\u5165\u89d2\u8272\u754c\u9762\u540e\uff0c\u9009\u62e9\u8f6c\u751f\u9875\u7b7e\u3002</p><p class=\"bb_paragraph\" >2.\u4e3b\u754c\u9762</p><p class=\"bb_paragraph\" > </p><p class=\"bb_paragraph\" >3.\u7cfb\u7edf\u4ecb\u7ecd</p><p class=\"bb_paragraph\" >1\uff09\u901a\u8fc7\u83b7\u53d6\u4fee\u4e3a\u548c\u94f6\u952d\u63d0\u5347\u8f6c\u751f\u7b49\u7ea7\uff0c\u63d0\u9ad8\u5c5e\u6027\u548c\u8f6c\u751f\u6280\u80fd\u7b49\u7ea7\uff1b</p><p class=\"bb_paragraph\" >2\uff09\u65e5\u5e38\u53ef\u901a\u8fc7\u754c\u9762\u5185\u8d2d\u4e70\u548c\u91ce\u5916BOSS\u6389\u843d\u83b7\u5f97\u4fee\u4e3a\u4e39\uff0c\u4f7f\u7528\u4fee\u4e3a\u4e39\u5373\u53ef\u83b7\u53d6\u4fee\u4e3a\uff1b</p><p class=\"bb_paragraph\" >3\uff09\u8f6c\u751f\u6280\u80fd\u53ef\u5728PVP\u6218\u6597\u65f6\u539f\u5730\u590d\u6d3b\u5e76\u6062\u590d\u4e00\u5b9a\u8840\u91cf\uff0c\u6280\u80fd\u51b7\u5374\u65f6\u95f4\u8f83\u957f\u3002\u8f6c\u751f\u7b49\u7ea7\u8d8a\u9ad8\uff0c\u6280\u80fd\u7b49\u7ea7\u8d8a\u9ad8\uff0c\u51b7\u5374\u65f6\u95f4\u8d8a\u77ed\uff0c\u6062\u590d\u8840\u91cf\u8d8a\u591a\u3002</p><p class=\"bb_paragraph\" >\u6fc0\u6218BOSS\u2014\u91ce\u5916BOSS</p><p class=\"bb_paragraph\" >1.\u5165\u53e3</p><p class=\"bb_paragraph\" > \u754c\u9762\u53f3\u4e0a\u89d2BOSS\u5927\u6bbf\u56fe\u6807\u3002</p><p class=\"bb_paragraph\" >2.\u4e3b\u754c\u9762</p><p class=\"bb_paragraph\" > </p><p class=\"bb_paragraph\" >3.\u7cfb\u7edf\u8bf4\u660e</p><p class=\"bb_paragraph\" >1\uff09\u6bcf\u4e2a\u9875\u7b7e\u5bf9\u5e94\u4e00\u4e2aBOSS\u7b49\u7ea7\uff0c\u63d0\u5347\u8f6c\u751f\u7b49\u7ea7\u540e\u89e3\u9501\u65b0\u7684\u9875\u7b7e\uff1b</p><p class=\"bb_paragraph\" >2\uff09\u6bcf\u4e2a\u9875\u7b7e\u51713\u5f20\u5730\u56fe\uff0c\u6bcf\u5f20\u5730\u56fe\u7684\u8fdb\u5165\u6761\u4ef6\u3001\u6389\u843d\u7684\u88c5\u5907\u9636\u6570\u3001\u9053\u5177\u4e0d\u540c\uff0c\u73a9\u5bb6\u53ef\u81ea\u7531\u9009\u62e9\u4e0d\u540c\u7684\u5730\u56fe\u6302\u673a\uff1b</p><p class=\"bb_paragraph\" >3\uff09\u6bcf\u4e2a\u5730\u56fe\u5bf9\u5e942\u79cd\u7c7b\u578b\u7684\u602a\uff0c\u6bcf\u79cd\u602a\u7684\u6570\u91cf\u4e0d\u540c\uff0c\u96be\u5ea6\u8d8a\u9ad8\u7684\u602a\u6389\u7387\u8d8a\u591a\uff1b</p><p class=\"bb_paragraph\" >4\uff09\u4ea7\u51fa\uff1a\u4eba\u7269\u88c5\u5907\u3001\u7ecf\u9a8c\u4e39\u3001\u6cd5\u5b9d\u5347\u9636\u6750\u6599\u3001\u8f6c\u751f\u4fee\u4e3a\u4e39\u3001\u94f6\u952d\u7b49\u3002</p><p class=\"bb_paragraph\" ></p>",
    "about_the_game": "<p class=\"bb_paragraph\" >\u6e38\u620f\u7b80\u4ecb</p><p class=\"bb_paragraph\" >\u6e38\u620f\u4e2d\u73a9\u5bb6\u867d\u7136\u51fa\u8eab\u5e73\u51e1\uff0c\u4f46\u4ed6\u70ed\u7231\u4fee\u884c\u3001\u65e0\u6240\u754f\u60e7\uff0c\u5728\u6d2a\u8352\u4e4b\u5b50\u7684\u6c14\u8fd0\u52a0\u6301\u4e4b\u4e0b\uff0c\u4e00\u8def\u900d\u9065\u95ef\u8361\uff0c\u6210\u4e3a\u8fd9\u7247\u5927\u9646\u4e0a\u6700\u7279\u7acb\u72ec\u884c\u7684\u609f\u9053\u8005\u3002\u5927\u9646\u5185\u6bcf\u4e2a\u5730\u70b9\u6d3b\u52a8\u90fd\u6709\u4e0d\u540c\u6311\u6218\u7b49\u7740\u4f60\uff0c\u968f\u7740\u5883\u754c\u7b49\u7ea7\u3001\u6218\u529b\u7684\u63d0\u5347\u4f18\u5316\u5956\u52b1\u548c\u83b7\u5f97\u66f4\u591a\u7ecf\u9a8c\u503c\uff0c\u80fd\u591f\u66f4\u597d\u4f53\u9a8c\u6e38\u620f\u3002\u6e38\u620f\u5185\u4e30\u5bcc\u7684\u6210\u957f\u578b\u7cfb\u7edf\u8bf8\u5982\u5f02\u517d\u3001\u6cd5\u5b9d\u3001\u5883\u754c\u3001\u5347\u9636\u3001\u795e\u6212\u7b49\u80fd\u4e3a\u73a9\u5bb6\u5e26\u6765\u4e0e\u4f17\u4e0d\u540c\u7684\u4fee\u4ed9\u609f\u9053\u4f53\u9a8c\u3002\u540c\u65f6\u6e38\u620f\u4e2d\u591a\u79cdPVP\u3001PVE\u6218\u6597\u6a21\u5f0f\uff0c\u4e0d\u505c\u523a\u6fc0\u73a9\u5bb6\u6218\u6597\u6b32\u671b\u3002\u753b\u9762\u7cbe\u7f8e\u3001\u6548\u679c\u903c\u771f\uff0c\u4f1a\u4ee4\u73a9\u5bb6\u7231\u4e0d\u91ca\u624b\uff0c\u5feb\u6765\u4f53\u9a8c\u5427\uff01</p><p class=\"bb_paragraph\" >\u65e5\u5e38\u4efb\u52a1</p><p class=\"bb_paragraph\" >1.\u7cfb\u7edf\u5165\u53e3</p><p class=\"bb_paragraph\" >\u4f4d\u4e8e\u754c\u9762\u4e0a\u65b9\u7684\u65e5\u5e38</p><p class=\"bb_paragraph\" > </p><p class=\"bb_paragraph\" >2.\u7cfb\u7edf\u73a9\u6cd5</p><p class=\"bb_paragraph\" >\u65e5\u5e38\u4e2d\u5171\u6709\u4e24\u4e2a\u9875\u7b7e\uff1a</p><p class=\"bb_paragraph\" >\u6d3b\u8dc3\uff1b</p><p class=\"bb_paragraph\" >\u6d3b\u52a8\u5927\u5385\u3002</p><p class=\"bb_paragraph\" >2.1\u6d3b\u8dc3</p><p class=\"bb_paragraph\" >\u5b8c\u6210\u5176\u4e2d\u7684\u65e5\u5e38\u4efb\u52a1\uff0c\u53ef\u4ee5\u83b7\u5f97\u6d3b\u8dc3\u5ea6</p><p class=\"bb_paragraph\" >\u6d3b\u8dc3\u5ea6\u79ef\u6512\u5230\u4e00\u5b9a\u7a0b\u5ea6\u53ef\u4ee5\u9886\u53d6\u5b9d\u7bb1\uff0c\u5b9d\u7bb1\u4e2d\u6709\u5927\u91cf\u65e5\u5e38\u8d44\u6e90</p><p class=\"bb_paragraph\" >\u6d3b\u8dc3\u5ea6\u548c\u4efb\u52a1\u6bcf\u65e5\u5237\u65b0\uff0c\u8bb0\u5f97\u53ca\u65f6\u9886\u53d6</p><p class=\"bb_paragraph\" > </p><p class=\"bb_paragraph\" >2.2\u6d3b\u52a8\u5927\u5385</p><p class=\"bb_paragraph\" >\u6d3b\u52a8\u5927\u5385\u4e5f\u53ef\u901a\u8fc7\u6b64\u5165\u53e3\u8fdb\u5165</p><p class=\"bb_paragraph\" > </p><p class=\"bb_paragraph\" >\u53ef\u4ee5\u5728\u6b64\u5904\u67e5\u770b\u6bcf\u65e5\u7684\u5927\u578b\u6d3b\u52a8\uff0c\u4ee5\u53ca\u6d3b\u52a8\u7684\u89c4\u5219\u548c\u5185\u5bb9</p><p class=\"bb_paragraph\" >\u6d3b\u52a8\u5f00\u542f\u65f6\uff0c\u53f3\u4e0b\u89d2\u8fd8\u4f1a\u6709\u5f39\u7a97\u53ef\u4ee5\u76f4\u63a5\u8df3\u8fdb\u76f8\u5173\u9875\u9762</p><p class=\"bb_paragraph\" > </p><p class=\"bb_paragraph\" >\u8f6c\u751f</p><p class=\"bb_paragraph\" >1.\u5165\u53e3</p><p class=\"bb_paragraph\" >  </p><p class=\"bb_paragraph\" >\u901a\u8fc7\u70b9\u51fb\u4e3b\u754c\u9762\u4e0b\u65b9-\u89d2\u8272\u5165\u53e3\u56fe\u6807\u8fdb\u5165\u89d2\u8272\u754c\u9762\u540e\uff0c\u9009\u62e9\u8f6c\u751f\u9875\u7b7e\u3002</p><p class=\"bb_paragraph\" >2.\u4e3b\u754c\u9762</p><p class=\"bb_paragraph\" > </p><p class=\"bb_paragraph\" >3.\u7cfb\u7edf\u4ecb\u7ecd</p><p class=\"bb_paragraph\" >1\uff09\u901a\u8fc7\u83b7\u53d6\u4fee\u4e3a\u548c\u94f6\u952d\u63d0\u5347\u8f6c\u751f\u7b49\u7ea7\uff0c\u63d0\u9ad8\u5c5e\u6027\u548c\u8f6c\u751f\u6280\u80fd\u7b49\u7ea7\uff1b</p><p class=\"bb_paragraph\" >2\uff09\u65e5\u5e38\u53ef\u901a\u8fc7\u754c\u9762\u5185\u8d2d\u4e70\u548c\u91ce\u5916BOSS\u6389\u843d\u83b7\u5f97\u4fee\u4e3a\u4e39\uff0c\u4f7f\u7528\u4fee\u4e3a\u4e39\u5373\u53ef\u83b7\u53d6\u4fee\u4e3a\uff1b</p><p class=\"bb_paragraph\" >3\uff09\u8f6c\u751f\u6280\u80fd\u53ef\u5728PVP\u6218\u6597\u65f6\u539f\u5730\u590d\u6d3b\u5e76\u6062\u590d\u4e00\u5b9a\u8840\u91cf\uff0c\u6280\u80fd\u51b7\u5374\u65f6\u95f4\u8f83\u957f\u3002\u8f6c\u751f\u7b49\u7ea7\u8d8a\u9ad8\uff0c\u6280\u80fd\u7b49\u7ea7\u8d8a\u9ad8\uff0c\u51b7\u5374\u65f6\u95f4\u8d8a\u77ed\uff0c\u6062\u590d\u8840\u91cf\u8d8a\u591a\u3002</p><p class=\"bb_paragraph\" >\u6fc0\u6218BOSS\u2014\u91ce\u5916BOSS</p><p class=\"bb_paragraph\" >1.\u5165\u53e3</p><p class=\"bb_paragraph\" > \u754c\u9762\u53f3\u4e0a\u89d2BOSS\u5927\u6bbf\u56fe\u6807\u3002</p><p class=\"bb_paragraph\" >2.\u4e3b\u754c\u9762</p><p class=\"bb_paragraph\" > </p><p class=\"bb_paragraph\" >3.\u7cfb\u7edf\u8bf4\u660e</p><p class=\"bb_paragraph\" >1\uff09\u6bcf\u4e2a\u9875\u7b7e\u5bf9\u5e94\u4e00\u4e2aBOSS\u7b49\u7ea7\uff0c\u63d0\u5347\u8f6c\u751f\u7b49\u7ea7\u540e\u89e3\u9501\u65b0\u7684\u9875\u7b7e\uff1b</p><p class=\"bb_paragraph\" >2\uff09\u6bcf\u4e2a\u9875\u7b7e\u51713\u5f20\u5730\u56fe\uff0c\u6bcf\u5f20\u5730\u56fe\u7684\u8fdb\u5165\u6761\u4ef6\u3001\u6389\u843d\u7684\u88c5\u5907\u9636\u6570\u3001\u9053\u5177\u4e0d\u540c\uff0c\u73a9\u5bb6\u53ef\u81ea\u7531\u9009\u62e9\u4e0d\u540c\u7684\u5730\u56fe\u6302\u673a\uff1b</p><p class=\"bb_paragraph\" >3\uff09\u6bcf\u4e2a\u5730\u56fe\u5bf9\u5e942\u79cd\u7c7b\u578b\u7684\u602a\uff0c\u6bcf\u79cd\u602a\u7684\u6570\u91cf\u4e0d\u540c\uff0c\u96be\u5ea6\u8d8a\u9ad8\u7684\u602a\u6389\u7387\u8d8a\u591a\uff1b</p><p class=\"bb_paragraph\" >4\uff09\u4ea7\u51fa\uff1a\u4eba\u7269\u88c5\u5907\u3001\u7ecf\u9a8c\u4e39\u3001\u6cd5\u5b9d\u5347\u9636\u6750\u6599\u3001\u8f6c\u751f\u4fee\u4e3a\u4e39\u3001\u94f6\u952d\u7b49\u3002</p><p class=\"bb_paragraph\" ></p>",
    "short_description": "\u300a\u5f02\u517d\u6d2a\u8352\u300b\u662f\u4e00\u6b3e\u6781\u5177\u4ed9\u4fa0\u6c14\u606f\u7684\u5927\u578b\u52a8\u4f5c\u89d2\u8272\u626e\u6f14\u7c7b\u6e38\u620f\uff0c\u795e\u79d8\u7684\u6545\u4e8b\u8ba9\u4eba\u4f53\u4f1a\u5230\u4ed9\u4fa0\u7684\u795e\u5947\u548c\u6027\u683c\u9b45\u529b\u3002\u5728\u8fd9\u6b3e\u4ed9\u4fa0\u7c7b\u6e38\u620f\u4e2d\uff0c\u73a9\u5bb6\u5c06\u5728\u4e0a\u53e4\u6d2a\u8352\u4e16\u754c\u4e2d\u63a2\u7d22\u795e\u79d8\u7684\u5f02\u517d\u4e4b\u5730\u3002",
