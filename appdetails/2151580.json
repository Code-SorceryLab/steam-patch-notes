0490b661af34711e32502e58cc04915a.poster.avif?t=1686854591\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2151580/extras/0490b661af34711e32502e58cc04915a.webm?t=1686854591\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2151580/extras/0490b661af34711e32502e58cc04915a.mp4?t=1686854591\" type=\"video/mp4\"></video></div>",
