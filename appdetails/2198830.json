ai.steamstatic.com/store_item_assets/steam/apps/2198830/extras/0d57508fb82f430b8e14ef263594d172.mp4?t=1751112498\" type=\"video/mp4\"></video></div></p><p class=\"bb_paragraph\"> </p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\"><strong>MEET THE CREW:</strong> A colorful cast of over 15 characters of all stripes and creeds!</p></li><li><p class=\"bb_paragraph\"><strong>AGE OF EXPLORATION:</strong> Move freely through the interactive locations of the ship!</p></li><li><p class=\"bb_paragraph\"><strong>EROTIC ESCAPADES:</strong> Indulge in animated sex scenes as your relationships mature!</p></li><li><p class=\"bb_paragraph\"><strong>ALL HANDS ON DECK:</strong> A number of exciting and fun minigames to discover! </p></li></ul><p class=\"bb_paragraph\"></p><p class=\"bb_paragraph\"><div class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2198830/extras/22af96603d98d47a2600f11234382bfd.poster.avif?t=1751112498\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2198830/extras/22af96603d98d47a2600f11234382bfd.webm?t=1751112498\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2198830/extras/22af96603d98d47a2600f11234382bfd.mp4?t=1751112498\" type=\"video/mp4\"></video></div></p>",
