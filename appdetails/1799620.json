red.akamai.steamstatic.com/store_item_assets/steam/apps/1799620/extras/e4b4688a096e8d1a08f05999875ec8bc.poster.avif?t=1695813425\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1799620/extras/e4b4688a096e8d1a08f05999875ec8bc.webm?t=1695813425\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1799620/extras/e4b4688a096e8d1a08f05999875ec8bc.mp4?t=1695813425\" type=\"video/mp4\"></video></div><br><strong>!!! PLEASE DON'T FORGET TO FOLLOW AND ADD THE GAME TO YOUR WISHLIST !!!</strong>",
