{
    "type": "game",
    "name": "Requiem Song",
    "steam_appid": 3247800,
    "required_age": 0,
    "is_free": false,
    "controller_support": "full",
    "detailed_description": "<p class=\"bb_paragraph\" >\u300a\u9547\u9b42\u6b4c\u300b\u662f\u7531\u6728\u6728\u7684\u5a49\u7ea6\u98ce\u5de5\u4f5c\u5ba4\u521b\u4f5c\u7684\u89c6\u89c9\u5c0f\u8bf4\u3002</p><p class=\"bb_paragraph\" >\u201c\u566c\u9b42\u72f1\u201d\u5b88\u62a4\u8005\u83ab\u540d\u5931\u8e2a\uff0c\u4e00\u573a\u8165\u98ce\u8840\u96e8\u5373\u5c06\u6765\u4e34\uff0c\u8fde\u63a5\u5730\u72f1\u4e0e\u4eba\u95f4\u7684\u901a\u9053\u5728\u5347\u7075\u4eea\u5f0f\u4e4b\u65f6\u6253\u5f00\uff0c\u8fd9\u4e00\u6b21\u8c01\u6765\u5b88\u62a4\u4eba\u95f4\uff1f</p><p class=\"bb_paragraph\" >\u58a8\u77b3\u83ab\u540d\u5176\u5999\u7684\u6210\u4e3a\u4e86\u5b88\u62a4\u8005\uff0c\u5728\u201c\u98ce\u94c3\u97f3\u201d\u7684\u6307\u5f15\u4e0b\uff0c\u5f00\u59cb\u63a5\u624b\u5de5\u4f5c\u3002</p><p class=\"bb_paragraph\" >\u201c\u5347\u7075\u4eea\u5f0f\u201d\u5f53\u5929\uff0c\u5374\u662f\u53d1\u751f\u4e86\u4ee4\u4eba\u610f\u60f3\u4e0d\u5230\u7684\u7a81\u53d1\u4e8b\u6545\u3002</p><p class=\"bb_paragraph\" >\u4f8d\u9b42\u6765\u88ad\uff0c\u5947\u602a\u7684\u7ef7\u5e26\u7537\uff0c\u8fc7\u53bb\u524d\u8f88\u7684\u6d88\u5931\uff0c\u8c1c\u56e2\u5982\u96fe\u4e00\u822c\u7b3c\u7f69\u5f00\u6765\u3002</p><p class=\"bb_paragraph\" >\u4e3a\u4e86\u89e3\u5f00\u5fc3\u4e2d\u7684\u7591\u60d1\uff0c\u58a8\u77b3\u8ddf\u968f\u201d\u98ce\u94c3\u97f3\u201c\u6b65\u5165\u4e86\u201d\u566c\u9b42\u72f1\u201c\u5f53\u4e2d\u3002</p><p class=\"bb_paragraph\" >\u6b7b\u800c\u590d\u751f\u7684\u4f20\u95fb\uff0c\u7a76\u7adf\u662f\u5426\u5c5e\u5b9e\uff1f</p><p class=\"bb_paragraph\" >\u8fd9\u662f\u5173\u4e8e\u9752\u6625\u4e0e\u7231\u7684\u6551\u8d4e\u4e4b\u6b4c\uff01</p>",
    "about_the_game": "<p class=\"bb_paragraph\" >\u300a\u9547\u9b42\u6b4c\u300b\u662f\u7531\u6728\u6728\u7684\u5a49\u7ea6\u98ce\u5de5\u4f5c\u5ba4\u521b\u4f5c\u7684\u89c6\u89c9\u5c0f\u8bf4\u3002</p><p class=\"bb_paragraph\" >\u201c\u566c\u9b42\u72f1\u201d\u5b88\u62a4\u8005\u83ab\u540d\u5931\u8e2a\uff0c\u4e00\u573a\u8165\u98ce\u8840\u96e8\u5373\u5c06\u6765\u4e34\uff0c\u8fde\u63a5\u5730\u72f1\u4e0e\u4eba\u95f4\u7684\u901a\u9053\u5728\u5347\u7075\u4eea\u5f0f\u4e4b\u65f6\u6253\u5f00\uff0c\u8fd9\u4e00\u6b21\u8c01\u6765\u5b88\u62a4\u4eba\u95f4\uff1f</p><p class=\"bb_paragraph\" >\u58a8\u77b3\u83ab\u540d\u5176\u5999\u7684\u6210\u4e3a\u4e86\u5b88\u62a4\u8005\uff0c\u5728\u201c\u98ce\u94c3\u97f3\u201d\u7684\u6307\u5f15\u4e0b\uff0c\u5f00\u59cb\u63a5\u624b\u5de5\u4f5c\u3002</p><p class=\"bb_paragraph\" >\u201c\u5347\u7075\u4eea\u5f0f\u201d\u5f53\u5929\uff0c\u5374\u662f\u53d1\u751f\u4e86\u4ee4\u4eba\u610f\u60f3\u4e0d\u5230\u7684\u7a81\u53d1\u4e8b\u6545\u3002</p><p class=\"bb_paragraph\" >\u4f8d\u9b42\u6765\u88ad\uff0c\u5947\u602a\u7684\u7ef7\u5e26\u7537\uff0c\u8fc7\u53bb\u524d\u8f88\u7684\u6d88\u5931\uff0c\u8c1c\u56e2\u5982\u96fe\u4e00\u822c\u7b3c\u7f69\u5f00\u6765\u3002</p><p class=\"bb_paragraph\" >\u4e3a\u4e86\u89e3\u5f00\u5fc3\u4e2d\u7684\u7591\u60d1\uff0c\u58a8\u77b3\u8ddf\u968f\u201d\u98ce\u94c3\u97f3\u201c\u6b65\u5165\u4e86\u201d\u566c\u9b42\u72f1\u201c\u5f53\u4e2d\u3002</p><p class=\"bb_paragraph\" >\u6b7b\u800c\u590d\u751f\u7684\u4f20\u95fb\uff0c\u7a76\u7adf\u662f\u5426\u5c5e\u5b9e\uff1f</p><p class=\"bb_paragraph\" >\u8fd9\u662f\u5173\u4e8e\u9752\u6625\u4e0e\u7231\u7684\u6551\u8d4e\u4e4b\u6b4c\uff01</p>",
