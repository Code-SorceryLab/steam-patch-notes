er=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1314000/extras/c5b94bab98f3e2896294a922596d6ac7.poster.avif?t=1747210248\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1314000/extras/c5b94bab98f3e2896294a922596d6ac7.webm?t=1747210248\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1314000/extras/c5b94bab98f3e2896294a922596d6ac7.mp4?t=1747210248\" type=\"video/mp4\"></video></div></p>",
