    "detailed_description": "<h2 class=\"bb_tag\" ><strong>\u6e38\u620f\u6982\u8ff0</strong></h2><p class=\"bb_paragraph\" >\u300a\u5883\u754c\u52c7\u58eb\u300b\u662f\u4e00\u6b3e\u4ee5\u4e09\u56fd\u5386\u53f2\u4e3a\u80cc\u666f\u7684\u7ad6\u7248\u653e\u7f6e\u5854\u9632\u6e38\u620f\uff0c\u878d\u5408\u4e86\u7b56\u7565\u517b\u6210\u4e0e\u8f7b\u677e\u4f11\u95f2\u7684\u73a9\u6cd5\u3002\u73a9\u5bb6\u5c06\u626e\u6f14\u4e00\u4f4d\u541b\u4e3b\uff0c\u62db\u52df\u5e76\u57f9\u517b\u4e09\u56fd\u540d\u5c06\uff0c\u901a\u8fc7\u5854\u9632\u6218\u6597\u3001\u8de8\u670d\u7ade\u6280\u548c\u591a\u6837\u5316\u7684\u517b\u6210\u7cfb\u7edf\uff0c\u4f53\u9a8c\u7fa4\u96c4\u9010\u9e7f\u7684\u4e09\u56fd\u4e71\u4e16\u3002\u6e38\u620f\u4ee5\u4e2d\u56fd\u98ce\u7f8e\u672f\u4e3a\u6838\u5fc3\uff0c\u6ce8\u91cd\u788e\u7247\u5316\u65f6\u95f4\u73a9\u6cd5\uff0c\u9002\u5408\u559c\u6b22\u8f7b\u677e\u64cd\u4f5c\u4f46\u8ffd\u6c42\u6df1\u5ea6\u7b56\u7565\u7684\u73a9\u5bb6\u3002</p><h2 class=\"bb_tag\" ><strong>\u6e38\u620f\u6838\u5fc3\u7279\u8272</strong></h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>\u4e09\u56fd\u80cc\u666f\u4e0e\u5854\u9632\u73a9\u6cd5</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u4ee5\u4e1c\u6c49\u672b\u5e74\u4e09\u56fd\u65f6\u671f\u4e3a\u80cc\u666f\uff0c\u73a9\u5bb6\u901a\u8fc7\u5854\u9632\u6218\u6597\u4f53\u9a8c\u7fa4\u96c4\u5272\u636e\u7684\u4e71\u4e16\u3002</p></li><li><p class=\"bb_paragraph\" >\u73a9\u5bb6\u53ef\u4ee5\u62db\u52df\u5e76\u57f9\u517b\u6570\u767e\u4f4d\u4e09\u56fd\u540d\u5c06\uff0c\u5305\u62ec\u7a00\u6709\u7684\u9b54\u00b7\u5415\u5e03\u3001\u795e\u00b7\u8bf8\u845b\u4eae\u7b49\u5f3a\u529b\u6b66\u5c06\u3002</p></li></ul></li><li><p class=\"bb_paragraph\" ><strong>\u4f18\u7f8e\u753b\u98ce\u4e0e\u8f7b\u677e\u73a9\u6cd5</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u91c7\u7528\u7ec6\u817b\u5199\u5b9e\u7684\u4e2d\u56fd\u98ce\u7f8e\u672f\u98ce\u683c\uff0c\u4eba\u7269\u3001\u573a\u666f\u548c\u9053\u5177\u8bbe\u8ba1\u7b26\u5408\u4e2d\u56fd\u73a9\u5bb6\u5ba1\u7f8e\u3002</p></li><li><p class=\"bb_paragraph\" >\u8f7b\u677e\u653e\u7f6e\u73a9\u6cd5\uff0c\u4e00\u952e\u9886\u53d6\u8d44\u6e90\uff0c\u968f\u73a9\u968f\u505c\uff0c\u544a\u522b\u5197\u957f\u65e5\u5e38\u4efb\u52a1\u3002</p></li></ul></li><li><p class=\"bb_paragraph\" ><strong>\u9ad8\u798f\u5229\u4e0e\u9ad8\u6027\u4ef7\u6bd4</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u75af\u72c210\u8fde\u62bd\u3001\u58d5\u6c14100\u62bd\u3001\u9996\u51456\u5143\u9001SSS\u6b66\u5c06\u7b49\u798f\u5229\uff0c\u52a9\u529b\u73a9\u5bb6\u5feb\u901f\u6210\u957f\u3002</p></li><li><p class=\"bb_paragraph\" >\u793c\u5305\u7279\u67430\u6c2a\u4eab\u6709\uff0c\u5c0fR\u793c\u5305\u6027\u4ef7\u6bd4\u8d85\u9ad8\uff0c\u9002\u5408\u5404\u7c7b\u73a9\u5bb6\u3002</p></li></ul></li><li><p class=\"bb_paragraph\" ><strong>\u591a\u6837\u5316\u7684\u517b\u6210\u4e0e\u7b56\u7565</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u6b66\u5c06\u7cfb\u7edf\uff1a\u901a\u8fc7\u805a\u8d24\u5e84\u5b9a\u5411\u62bd\u53d6\u7a00\u6709\u6b66\u5c06\uff0c\u6bcf\u4e2a\u6b66\u5c06\u90fd\u6709\u72ec\u7279\u7684\u6280\u80fd\u548c\u5b9a\u4f4d\u3002</p></li><li><p class=\"bb_paragraph\" >\u5854\u9632PVP\uff1a\u8bf8\u845b\u4eae\u7684\u7fa4\u4f53\u63a7\u5236\u3001\u9b54\u5415\u5e03\u7684\u5f3a\u529bAOE\u3001\u8d75\u4e91\u7684\u524d\u6392\u627f\u4f24\u7b49\uff0c\u63d0\u4f9b\u4e30\u5bcc\u7684\u7b56\u7565\u7ec4\u5408\u3002</p></li><li><p class=\"bb_paragraph\" >\u5c06\u5370\u4e0e\u88c5\u5907\uff1a\u4e2d\u540e\u671f\u6838\u5fc3\u517b\u6210\uff0c\u63d0\u4f9b\u66b4\u51fb\u7387\u3001\u66b4\u51fb\u4f24\u5bb3\u3001\u901f\u5ea6\u7b49\u5173\u952e\u5c5e\u6027\uff0c\u4ee5\u53ca\u804c\u4e1a\u5957\u88c5\u548c\u94f8\u9b42\u7cfb\u7edf\u3002</p></li></ul></li><li><p class=\"bb_paragraph\" ><strong>\u4e30\u5bcc\u7684\u73a9\u6cd5\u7cfb\u7edf</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>\u4e3b\u7ebf\u5f81\u6218</strong>\uff1a\u901a\u8fc7\u526f\u672c\u5267\u60c5\u63a8\u8fdb\uff0c\u83b7\u5f97\u8d44\u6e90\u548c\u7ecf\u9a8c\u3002</p></li><li><p class=\"bb_paragraph\" ><strong>\u86ee\u65cf\u5165\u4fb5</strong>\uff1a\u8de8\u670d\u6218\u573a\u73a9\u6cd5\uff0c\u4f53\u9a8c\u7fa4\u96c4\u9010\u9e7f\u7684\u4e50\u8da3\u3002</p></li><li><p class=\"bb_paragraph\" ><strong>\u519b\u56e2\u7cfb\u7edf</strong>\uff1a\u52a0\u5165\u519b\u56e2\u53c2\u4e0e\u6d3b\u52a8\uff0c\u63d0\u5347\u6218\u529b\u548c\u6d3b\u8dc3\u5ea6\u3002</p></li><li><p class=\"bb_paragraph\" ><strong>\u9650\u65f6\u6d3b\u52a8</strong>\uff1a\u805a\u8d24\u5e84\u3001\u6b66\u5c06\u7279\u60e0\u7b49\u6d3b\u52a8\uff0c\u63d0\u4f9b\u5b9a\u5411\u62bd\u53d6\u548c\u9ad8\u6027\u4ef7\u6bd4\u793c\u5305\u3002</p></li></ul></li></ul><h2 class=\"bb_tag\" ><strong>\u6e38\u620f\u73a9\u6cd5\u8be6\u89e3</strong></h2><h2 class=\"bb_tag\" ><strong>\u6b66\u5c06\u7cfb\u7edf</strong></h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>\u5f3a\u529b\u9635\u5bb9\u63a8\u8350</strong>\uff1a</p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>\u6700\u5f3a\u9635\u5bb9</strong>\uff1a\u9b54\u00b7\u5415\u5e03\u3001\u9b54\u00b7\u8c82\u8749\u3001\u795e\u00b7\u8bf8\u845b\u4eae\u3001\u795e\u00b7\u8d75\u4e91\u3001\u795e\u00b7\u5f20\u8fbd\u3001\u795e\u00b7\u66f9\u64cd\u3002</p></li><li><p class=\"bb_paragraph\" ><strong>\u5c0fR\u9635\u5bb9</strong>\uff1a\u7518\u5b81\u3001\u8d75\u4e91\u3001\u7504\u59ec\u3001\u5b59\u7b56\u3001\u9646\u900a\u3001\u8537\u8587\u5c0f\u4e54\u3002</p></li></ul></li><li><p class=\"bb_paragraph\" ><strong>\u6b66\u5c06\u5b9a\u4f4d</strong>\uff1a</p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u9b54\u00b7\u5415\u5e03\uff1a\u5355\u4f53\u79d2\u6740\u517c\u7fa4\u4f53\u8f93\u51fa\uff0c\u5f53\u524d\u7248\u672c\u6700\u5f3a\u731b\u5c06\u3002</p></li><li><p class=\"bb_paragraph\" >\u795e\u00b7\u8bf8\u845b\u4eae\uff1a\u7fa4\u4f53\u63a7\u5236\uff0c\u80dc\u8d1f\u5173\u952e\u3002</p></li><li><p class=\"bb_paragraph\" >\u795e\u00b7\u8d75\u4e91\uff1a\u6700\u5f3a\u524d\u6392\uff0c\u4e0d\u53ef\u66ff\u4ee3\u3002</p></li><li><p class=\"bb_paragraph\" >\u795e\u00b7\u5f20\u8fbd\uff1a\u79d2\u6740\u4e00\u5217\u82f1\u96c4\uff0c\u9020\u6210\u8d85\u9ad8\u7fa4\u4f53\u4f24\u5bb3\u3002</p></li><li><p class=\"bb_paragraph\" >\u795e\u00b7\u66f9\u64cd\uff1a\u63f4\u519b\u4f4d\u5fc5\u5907\uff0c\u9488\u5bf9\u4e0d\u540c\u804c\u4e1a\u589e\u52a0\u5c5e\u6027\u3002</p></li></ul></li></ul><h2 class=\"bb_tag\" ><strong>\u5854\u9632\u73a9\u6cd5</strong></h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>\u6838\u5fc3\u82f1\u96c4</strong>\uff1a</p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u8bf8\u845b\u4eae\uff1a\u7fa4\u4f53\u63a7\u5236\uff0c\u63a7\u5236\u5bf9\u65b9\u591a\u4e2a\u82f1\u96c4\u3002</p></li><li><p class=\"bb_paragraph\" >\u9b54\u5415\u5e03\uff1a\u5f3a\u529b\u5168\u5c4fAOE\uff0c\u5355\u4f53\u79d2\u6740\u3002</p></li><li><p class=\"bb_paragraph\" >\u8d75\u4e91\uff1a\u5854\u9632PVP\u53cc\u5f3a\u529b\uff0c\u524d\u6392\u627f\u4f24\u3002</p></li><li><p class=\"bb_paragraph\" >\u7518\u5b81+\u5468\u745c\uff1a\u70b9\u706b+\u5168\u5c4f\u5f3a\u529b\u7ec4\u5408\u3002</p></li></ul></li></ul><h2 class=\"bb_tag\" ><strong>\u798f\u5229\u4e0e\u793c\u5305</strong></h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>\u9996\u5145\u798f\u5229</strong>\uff1a6\u5143\u8d60\u9001SSS\u66b4\u529b\u8f93\u51fa\u6b66\u5c06\u3002</p></li><li><p class=\"bb_paragraph\" ><strong>\u6bcf\u65e5\u7279\u60e0</strong>\uff1a18\u5143\u793c\u5305\u63d0\u4f9b\u9ad8\u62bd\u5238\u3001\u6b66\u5c06\u7ecf\u9a8c\u3001\u91d1\u5e01\u7b49\u3002</p></li><li><p class=\"bb_paragraph\" ><strong>\u9650\u65f6\u793c\u5305</strong>\uff1a\u6bcf\u5408\u6210\u4e00\u4e2a5\u661f\u6b66\u5c06\u540e\u5f39\u51fa\u5bf9\u5e94\u661f\u7ea7\u793c\u5305\uff0c\u63d0\u4f9b\u8d85\u7ea7\u591a\u7684\u6b66\u5c06\u7ecf\u9a8c\u3001\u91d1\u5e01\u548c\u9ad8\u62bd\u5238\u3002</p></li><li><p class=\"bb_paragraph\" ><strong>\u805a\u8d24\u5e84</strong>\uff1a\u5b9a\u5411\u62bd\u53d6\u7a00\u6709\u6b66\u5c06\uff0c\u500d\u7387\u63d0\u9ad8\u3002</p></li></ul><h2 class=\"bb_tag\" ><strong>\u4e2d\u540e\u671f\u517b\u6210</strong></h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>\u5c06\u5370\u7cfb\u7edf</strong>\uff1a\u63d0\u4f9b\u66b4\u51fb\u7387\u3001\u66b4\u51fb\u4f24\u5bb3\u3001\u901f\u5ea6\u7b49\u5173\u952e\u5c5e\u6027\uff0c\u4ee5\u53ca\u8d85\u7ea7\u51c0\u5316\u3001\u8d85\u7ea7\u91cd\u751f\u7b49\u8d28\u53d8\u6280\u80fd\u3002</p></li><li><p class=\"bb_paragraph\" ><strong>\u88c5\u5907\u7cfb\u7edf</strong>\uff1a\u804c\u4e1a\u5957\u88c5\u6fc0\u6d3b\u767e\u5206\u6bd4\u5c5e\u6027\uff0c\u8ffd\u52a0\u94f8\u9b42\u63d0\u5347\u6280\u80fd\u7b49\u7ea7\u3002</p></li></ul><h2 class=\"bb_tag\" ><strong>\u73a9\u5bb6\u653b\u7565\u5efa\u8bae</strong></h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>\u524d\u671f\u57f9\u517b</strong>\uff1a</p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u4f18\u5148\u57f9\u517b\u4e3b\u529b\u82f1\u96c4\uff0c\u96c6\u4e2d\u8d44\u6e90\u63d0\u5347\u4e00\u4e2a\u82f1\u96c4\u7684\u6536\u76ca\u66f4\u9ad8\u3002</p></li><li><p class=\"bb_paragraph\" >\u7518\u5b81\u3001\u8d75\u4e91\u3001\u7504\u59ec\u3001\u5b59\u7b56\u7b49\u82f1\u96c4\u53ef\u4f5c\u4e3a\u524d\u671f\u8fc7\u6e21\u9635\u5bb9\u3002</p></li></ul></li><li><p class=\"bb_paragraph\" ><strong>\u793c\u5305\u9009\u62e9</strong>\uff1a</p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u5fc5\u4e7018\u5143\u626b\u8361\u793c\u5305\uff0c\u4fdd\u8bc1\u7b49\u7ea7\u4e0d\u843d\u540e\u3002</p></li><li><p class=\"bb_paragraph\" >\u9650\u65f6\u6b66\u5c06\u793c\u5305\u5fc5\u4e70\uff0c\u7b2c\u4e00\u68af\u961f\u6b66\u5c06\u5982\u5415\u5e03\u3001\u8bf8\u845b\u4eae\u5728\u6b64\u83b7\u53d6\u3002</p></li><li><p class=\"bb_paragraph\" >\u5408\u6210\u6b66\u5c06\u540e\u5f39\u51fa\u7684\u793c\u5305\u52a1\u5fc5\u5148\u8d2d\u4e70\u518d\u7ee7\u7eed\u5408\u6210\u3002</p></li></ul></li><li><p class=\"bb_paragraph\" ><strong>\u6d3b\u52a8\u53c2\u4e0e</strong>\uff1a</p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u5173\u6ce8\u805a\u8d24\u5e84\u6d3b\u52a8\uff0c\u5b9a\u5411\u62bd\u53d6\u7a00\u6709\u6b66\u5c06\u3002</p></li><li><p class=\"bb_paragraph\" >\u6bcf\u65e518\u5143\u7279\u60e0\u793c\u5305\u6b21\u6570\u6709\u9650\uff0c\u5c3d\u91cf\u4e0d\u9519\u8fc7\u3002</p></li></ul></li><li><p class=\"bb_paragraph\" ><strong>\u4e2d\u540e\u671f\u7b56\u7565</strong>\uff1a</p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u5c06\u5370\u548c\u88c5\u5907\u662f\u7ffb\u76d8\u5173\u952e\uff0c\u4f18\u5148\u8ffd\u6c42\u7ea2\u8272\u5c06\u5370\u548c\u804c\u4e1a\u5957\u88c5\u3002</p></li><li><p class=\"bb_paragraph\" >\u6839\u636e\u6d3b\u52a8\u65f6\u95f4\u5408\u7406\u89c4\u5212\u8d44\u6e90\uff0c\u6253\u9020\u5c5e\u4e8e\u81ea\u5df1\u7684\u5f3a\u529b\u9635\u5bb9\u3002</p></li></ul></li></ul>",
    "about_the_game": "<h2 class=\"bb_tag\" ><strong>\u6e38\u620f\u6982\u8ff0</strong></h2><p class=\"bb_paragraph\" >\u300a\u5883\u754c\u52c7\u58eb\u300b\u662f\u4e00\u6b3e\u4ee5\u4e09\u56fd\u5386\u53f2\u4e3a\u80cc\u666f\u7684\u7ad6\u7248\u653e\u7f6e\u5854\u9632\u6e38\u620f\uff0c\u878d\u5408\u4e86\u7b56\u7565\u517b\u6210\u4e0e\u8f7b\u677e\u4f11\u95f2\u7684\u73a9\u6cd5\u3002\u73a9\u5bb6\u5c06\u626e\u6f14\u4e00\u4f4d\u541b\u4e3b\uff0c\u62db\u52df\u5e76\u57f9\u517b\u4e09\u56fd\u540d\u5c06\uff0c\u901a\u8fc7\u5854\u9632\u6218\u6597\u3001\u8de8\u670d\u7ade\u6280\u548c\u591a\u6837\u5316\u7684\u517b\u6210\u7cfb\u7edf\uff0c\u4f53\u9a8c\u7fa4\u96c4\u9010\u9e7f\u7684\u4e09\u56fd\u4e71\u4e16\u3002\u6e38\u620f\u4ee5\u4e2d\u56fd\u98ce\u7f8e\u672f\u4e3a\u6838\u5fc3\uff0c\u6ce8\u91cd\u788e\u7247\u5316\u65f6\u95f4\u73a9\u6cd5\uff0c\u9002\u5408\u559c\u6b22\u8f7b\u677e\u64cd\u4f5c\u4f46\u8ffd\u6c42\u6df1\u5ea6\u7b56\u7565\u7684\u73a9\u5bb6\u3002</p><h2 class=\"bb_tag\" ><strong>\u6e38\u620f\u6838\u5fc3\u7279\u8272</strong></h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>\u4e09\u56fd\u80cc\u666f\u4e0e\u5854\u9632\u73a9\u6cd5</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u4ee5\u4e1c\u6c49\u672b\u5e74\u4e09\u56fd\u65f6\u671f\u4e3a\u80cc\u666f\uff0c\u73a9\u5bb6\u901a\u8fc7\u5854\u9632\u6218\u6597\u4f53\u9a8c\u7fa4\u96c4\u5272\u636e\u7684\u4e71\u4e16\u3002</p></li><li><p class=\"bb_paragraph\" >\u73a9\u5bb6\u53ef\u4ee5\u62db\u52df\u5e76\u57f9\u517b\u6570\u767e\u4f4d\u4e09\u56fd\u540d\u5c06\uff0c\u5305\u62ec\u7a00\u6709\u7684\u9b54\u00b7\u5415\u5e03\u3001\u795e\u00b7\u8bf8\u845b\u4eae\u7b49\u5f3a\u529b\u6b66\u5c06\u3002</p></li></ul></li><li><p class=\"bb_paragraph\" ><strong>\u4f18\u7f8e\u753b\u98ce\u4e0e\u8f7b\u677e\u73a9\u6cd5</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u91c7\u7528\u7ec6\u817b\u5199\u5b9e\u7684\u4e2d\u56fd\u98ce\u7f8e\u672f\u98ce\u683c\uff0c\u4eba\u7269\u3001\u573a\u666f\u548c\u9053\u5177\u8bbe\u8ba1\u7b26\u5408\u4e2d\u56fd\u73a9\u5bb6\u5ba1\u7f8e\u3002</p></li><li><p class=\"bb_paragraph\" >\u8f7b\u677e\u653e\u7f6e\u73a9\u6cd5\uff0c\u4e00\u952e\u9886\u53d6\u8d44\u6e90\uff0c\u968f\u73a9\u968f\u505c\uff0c\u544a\u522b\u5197\u957f\u65e5\u5e38\u4efb\u52a1\u3002</p></li></ul></li><li><p class=\"bb_paragraph\" ><strong>\u9ad8\u798f\u5229\u4e0e\u9ad8\u6027\u4ef7\u6bd4</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u75af\u72c210\u8fde\u62bd\u3001\u58d5\u6c14100\u62bd\u3001\u9996\u51456\u5143\u9001SSS\u6b66\u5c06\u7b49\u798f\u5229\uff0c\u52a9\u529b\u73a9\u5bb6\u5feb\u901f\u6210\u957f\u3002</p></li><li><p class=\"bb_paragraph\" >\u793c\u5305\u7279\u67430\u6c2a\u4eab\u6709\uff0c\u5c0fR\u793c\u5305\u6027\u4ef7\u6bd4\u8d85\u9ad8\uff0c\u9002\u5408\u5404\u7c7b\u73a9\u5bb6\u3002</p></li></ul></li><li><p class=\"bb_paragraph\" ><strong>\u591a\u6837\u5316\u7684\u517b\u6210\u4e0e\u7b56\u7565</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u6b66\u5c06\u7cfb\u7edf\uff1a\u901a\u8fc7\u805a\u8d24\u5e84\u5b9a\u5411\u62bd\u53d6\u7a00\u6709\u6b66\u5c06\uff0c\u6bcf\u4e2a\u6b66\u5c06\u90fd\u6709\u72ec\u7279\u7684\u6280\u80fd\u548c\u5b9a\u4f4d\u3002</p></li><li><p class=\"bb_paragraph\" >\u5854\u9632PVP\uff1a\u8bf8\u845b\u4eae\u7684\u7fa4\u4f53\u63a7\u5236\u3001\u9b54\u5415\u5e03\u7684\u5f3a\u529bAOE\u3001\u8d75\u4e91\u7684\u524d\u6392\u627f\u4f24\u7b49\uff0c\u63d0\u4f9b\u4e30\u5bcc\u7684\u7b56\u7565\u7ec4\u5408\u3002</p></li><li><p class=\"bb_paragraph\" >\u5c06\u5370\u4e0e\u88c5\u5907\uff1a\u4e2d\u540e\u671f\u6838\u5fc3\u517b\u6210\uff0c\u63d0\u4f9b\u66b4\u51fb\u7387\u3001\u66b4\u51fb\u4f24\u5bb3\u3001\u901f\u5ea6\u7b49\u5173\u952e\u5c5e\u6027\uff0c\u4ee5\u53ca\u804c\u4e1a\u5957\u88c5\u548c\u94f8\u9b42\u7cfb\u7edf\u3002</p></li></ul></li><li><p class=\"bb_paragraph\" ><strong>\u4e30\u5bcc\u7684\u73a9\u6cd5\u7cfb\u7edf</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>\u4e3b\u7ebf\u5f81\u6218</strong>\uff1a\u901a\u8fc7\u526f\u672c\u5267\u60c5\u63a8\u8fdb\uff0c\u83b7\u5f97\u8d44\u6e90\u548c\u7ecf\u9a8c\u3002</p></li><li><p class=\"bb_paragraph\" ><strong>\u86ee\u65cf\u5165\u4fb5</strong>\uff1a\u8de8\u670d\u6218\u573a\u73a9\u6cd5\uff0c\u4f53\u9a8c\u7fa4\u96c4\u9010\u9e7f\u7684\u4e50\u8da3\u3002</p></li><li><p class=\"bb_paragraph\" ><strong>\u519b\u56e2\u7cfb\u7edf</strong>\uff1a\u52a0\u5165\u519b\u56e2\u53c2\u4e0e\u6d3b\u52a8\uff0c\u63d0\u5347\u6218\u529b\u548c\u6d3b\u8dc3\u5ea6\u3002</p></li><li><p class=\"bb_paragraph\" ><strong>\u9650\u65f6\u6d3b\u52a8</strong>\uff1a\u805a\u8d24\u5e84\u3001\u6b66\u5c06\u7279\u60e0\u7b49\u6d3b\u52a8\uff0c\u63d0\u4f9b\u5b9a\u5411\u62bd\u53d6\u548c\u9ad8\u6027\u4ef7\u6bd4\u793c\u5305\u3002</p></li></ul></li></ul><h2 class=\"bb_tag\" ><strong>\u6e38\u620f\u73a9\u6cd5\u8be6\u89e3</strong></h2><h2 class=\"bb_tag\" ><strong>\u6b66\u5c06\u7cfb\u7edf</strong></h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>\u5f3a\u529b\u9635\u5bb9\u63a8\u8350</strong>\uff1a</p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>\u6700\u5f3a\u9635\u5bb9</strong>\uff1a\u9b54\u00b7\u5415\u5e03\u3001\u9b54\u00b7\u8c82\u8749\u3001\u795e\u00b7\u8bf8\u845b\u4eae\u3001\u795e\u00b7\u8d75\u4e91\u3001\u795e\u00b7\u5f20\u8fbd\u3001\u795e\u00b7\u66f9\u64cd\u3002</p></li><li><p class=\"bb_paragraph\" ><strong>\u5c0fR\u9635\u5bb9</strong>\uff1a\u7518\u5b81\u3001\u8d75\u4e91\u3001\u7504\u59ec\u3001\u5b59\u7b56\u3001\u9646\u900a\u3001\u8537\u8587\u5c0f\u4e54\u3002</p></li></ul></li><li><p class=\"bb_paragraph\" ><strong>\u6b66\u5c06\u5b9a\u4f4d</strong>\uff1a</p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u9b54\u00b7\u5415\u5e03\uff1a\u5355\u4f53\u79d2\u6740\u517c\u7fa4\u4f53\u8f93\u51fa\uff0c\u5f53\u524d\u7248\u672c\u6700\u5f3a\u731b\u5c06\u3002</p></li><li><p class=\"bb_paragraph\" >\u795e\u00b7\u8bf8\u845b\u4eae\uff1a\u7fa4\u4f53\u63a7\u5236\uff0c\u80dc\u8d1f\u5173\u952e\u3002</p></li><li><p class=\"bb_paragraph\" >\u795e\u00b7\u8d75\u4e91\uff1a\u6700\u5f3a\u524d\u6392\uff0c\u4e0d\u53ef\u66ff\u4ee3\u3002</p></li><li><p class=\"bb_paragraph\" >\u795e\u00b7\u5f20\u8fbd\uff1a\u79d2\u6740\u4e00\u5217\u82f1\u96c4\uff0c\u9020\u6210\u8d85\u9ad8\u7fa4\u4f53\u4f24\u5bb3\u3002</p></li><li><p class=\"bb_paragraph\" >\u795e\u00b7\u66f9\u64cd\uff1a\u63f4\u519b\u4f4d\u5fc5\u5907\uff0c\u9488\u5bf9\u4e0d\u540c\u804c\u4e1a\u589e\u52a0\u5c5e\u6027\u3002</p></li></ul></li></ul><h2 class=\"bb_tag\" ><strong>\u5854\u9632\u73a9\u6cd5</strong></h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>\u6838\u5fc3\u82f1\u96c4</strong>\uff1a</p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u8bf8\u845b\u4eae\uff1a\u7fa4\u4f53\u63a7\u5236\uff0c\u63a7\u5236\u5bf9\u65b9\u591a\u4e2a\u82f1\u96c4\u3002</p></li><li><p class=\"bb_paragraph\" >\u9b54\u5415\u5e03\uff1a\u5f3a\u529b\u5168\u5c4fAOE\uff0c\u5355\u4f53\u79d2\u6740\u3002</p></li><li><p class=\"bb_paragraph\" >\u8d75\u4e91\uff1a\u5854\u9632PVP\u53cc\u5f3a\u529b\uff0c\u524d\u6392\u627f\u4f24\u3002</p></li><li><p class=\"bb_paragraph\" >\u7518\u5b81+\u5468\u745c\uff1a\u70b9\u706b+\u5168\u5c4f\u5f3a\u529b\u7ec4\u5408\u3002</p></li></ul></li></ul><h2 class=\"bb_tag\" ><strong>\u798f\u5229\u4e0e\u793c\u5305</strong></h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>\u9996\u5145\u798f\u5229</strong>\uff1a6\u5143\u8d60\u9001SSS\u66b4\u529b\u8f93\u51fa\u6b66\u5c06\u3002</p></li><li><p class=\"bb_paragraph\" ><strong>\u6bcf\u65e5\u7279\u60e0</strong>\uff1a18\u5143\u793c\u5305\u63d0\u4f9b\u9ad8\u62bd\u5238\u3001\u6b66\u5c06\u7ecf\u9a8c\u3001\u91d1\u5e01\u7b49\u3002</p></li><li><p class=\"bb_paragraph\" ><strong>\u9650\u65f6\u793c\u5305</strong>\uff1a\u6bcf\u5408\u6210\u4e00\u4e2a5\u661f\u6b66\u5c06\u540e\u5f39\u51fa\u5bf9\u5e94\u661f\u7ea7\u793c\u5305\uff0c\u63d0\u4f9b\u8d85\u7ea7\u591a\u7684\u6b66\u5c06\u7ecf\u9a8c\u3001\u91d1\u5e01\u548c\u9ad8\u62bd\u5238\u3002</p></li><li><p class=\"bb_paragraph\" ><strong>\u805a\u8d24\u5e84</strong>\uff1a\u5b9a\u5411\u62bd\u53d6\u7a00\u6709\u6b66\u5c06\uff0c\u500d\u7387\u63d0\u9ad8\u3002</p></li></ul><h2 class=\"bb_tag\" ><strong>\u4e2d\u540e\u671f\u517b\u6210</strong></h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>\u5c06\u5370\u7cfb\u7edf</strong>\uff1a\u63d0\u4f9b\u66b4\u51fb\u7387\u3001\u66b4\u51fb\u4f24\u5bb3\u3001\u901f\u5ea6\u7b49\u5173\u952e\u5c5e\u6027\uff0c\u4ee5\u53ca\u8d85\u7ea7\u51c0\u5316\u3001\u8d85\u7ea7\u91cd\u751f\u7b49\u8d28\u53d8\u6280\u80fd\u3002</p></li><li><p class=\"bb_paragraph\" ><strong>\u88c5\u5907\u7cfb\u7edf</strong>\uff1a\u804c\u4e1a\u5957\u88c5\u6fc0\u6d3b\u767e\u5206\u6bd4\u5c5e\u6027\uff0c\u8ffd\u52a0\u94f8\u9b42\u63d0\u5347\u6280\u80fd\u7b49\u7ea7\u3002</p></li></ul><h2 class=\"bb_tag\" ><strong>\u73a9\u5bb6\u653b\u7565\u5efa\u8bae</strong></h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>\u524d\u671f\u57f9\u517b</strong>\uff1a</p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u4f18\u5148\u57f9\u517b\u4e3b\u529b\u82f1\u96c4\uff0c\u96c6\u4e2d\u8d44\u6e90\u63d0\u5347\u4e00\u4e2a\u82f1\u96c4\u7684\u6536\u76ca\u66f4\u9ad8\u3002</p></li><li><p class=\"bb_paragraph\" >\u7518\u5b81\u3001\u8d75\u4e91\u3001\u7504\u59ec\u3001\u5b59\u7b56\u7b49\u82f1\u96c4\u53ef\u4f5c\u4e3a\u524d\u671f\u8fc7\u6e21\u9635\u5bb9\u3002</p></li></ul></li><li><p class=\"bb_paragraph\" ><strong>\u793c\u5305\u9009\u62e9</strong>\uff1a</p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u5fc5\u4e7018\u5143\u626b\u8361\u793c\u5305\uff0c\u4fdd\u8bc1\u7b49\u7ea7\u4e0d\u843d\u540e\u3002</p></li><li><p class=\"bb_paragraph\" >\u9650\u65f6\u6b66\u5c06\u793c\u5305\u5fc5\u4e70\uff0c\u7b2c\u4e00\u68af\u961f\u6b66\u5c06\u5982\u5415\u5e03\u3001\u8bf8\u845b\u4eae\u5728\u6b64\u83b7\u53d6\u3002</p></li><li><p class=\"bb_paragraph\" >\u5408\u6210\u6b66\u5c06\u540e\u5f39\u51fa\u7684\u793c\u5305\u52a1\u5fc5\u5148\u8d2d\u4e70\u518d\u7ee7\u7eed\u5408\u6210\u3002</p></li></ul></li><li><p class=\"bb_paragraph\" ><strong>\u6d3b\u52a8\u53c2\u4e0e</strong>\uff1a</p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u5173\u6ce8\u805a\u8d24\u5e84\u6d3b\u52a8\uff0c\u5b9a\u5411\u62bd\u53d6\u7a00\u6709\u6b66\u5c06\u3002</p></li><li><p class=\"bb_paragraph\" >\u6bcf\u65e518\u5143\u7279\u60e0\u793c\u5305\u6b21\u6570\u6709\u9650\uff0c\u5c3d\u91cf\u4e0d\u9519\u8fc7\u3002</p></li></ul></li><li><p class=\"bb_paragraph\" ><strong>\u4e2d\u540e\u671f\u7b56\u7565</strong>\uff1a</p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u5c06\u5370\u548c\u88c5\u5907\u662f\u7ffb\u76d8\u5173\u952e\uff0c\u4f18\u5148\u8ffd\u6c42\u7ea2\u8272\u5c06\u5370\u548c\u804c\u4e1a\u5957\u88c5\u3002</p></li><li><p class=\"bb_paragraph\" >\u6839\u636e\u6d3b\u52a8\u65f6\u95f4\u5408\u7406\u89c4\u5212\u8d44\u6e90\uff0c\u6253\u9020\u5c5e\u4e8e\u81ea\u5df1\u7684\u5f3a\u529b\u9635\u5bb9\u3002</p></li></ul></li></ul>",
