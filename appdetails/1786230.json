utoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1786230/extras/0c0a10ce0bdc5e099fcb261f22729331.poster.avif?t=1744042448\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1786230/extras/0c0a10ce0bdc5e099fcb261f22729331.webm?t=1744042448\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1786230/extras/0c0a10ce0bdc5e099fcb261f22729331.mp4?t=1744042448\" type=\"video/mp4\"></video></div><br><br><div class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1786230/extras/7179821f7b3fe776a10a9a06a37c7ca4.poster.avif?t=1744042448\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1786230/extras/7179821f7b3fe776a10a9a06a37c7ca4.webm?t=1744042448\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1786230/extras/7179821f7b3fe776a10a9a06a37c7ca4.mp4?t=1744042448\" type=\"video/mp4\"></video></div><br><br><div class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline crossorigin=\"anonymous\" poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1786230/extras/bbe669cda85c2baf4e8e30be4f028c0d.poster.avif?t=1744042448\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1786230/extras/bbe669cda85c2baf4e8e30be4f028c0d.webm?t=1744042448\" type=\"video/webm; codecs=vp9\"></video></div><br><br><div class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1786230/extras/484f53b34ad0882ba5ec7fb6b450810a.poster.avif?t=1744042448\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1786230/extras/484f53b34ad0882ba5ec7fb6b450810a.webm?t=1744042448