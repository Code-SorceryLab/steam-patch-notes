{
    "type": "game",
    "name": "UpRunner",
    "steam_appid": 2449210,
    "required_age": 0,
    "is_free": true,
    "controller_support": "full",
    "detailed_description": "<p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline crossorigin=\"anonymous\" poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2449210/extras/606631a4f84fae58d6d2cfd971108668.poster.avif?t=1728980539\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2449210/extras/606631a4f84fae58d6d2cfd971108668.webm?t=1728980539\" type=\"video/webm; codecs=vp9\"></video></span></p><p class=\"bb_paragraph\" ><strong><i>Uprunner</i></strong> is a free-to-play MMO vertical speedrunner. </p><p class=\"bb_paragraph\" >Win lobbies or create your own maps to earn coins and buy unique randomly generated skins!</p><h2 class=\"bb_tag\" >Game Features</h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >Lobby with all the players on the same map changing every 5 minutes!</p></li><li><p class=\"bb_paragraph\" >Level editor with many blocks and skins to try</p></li><li><p class=\"bb_paragraph\" >Hundreds of community maps already available!</p></li><li><p class=\"bb_paragraph\" >Climb the leaderboard and show the world your skills!</p></li><li><p class=\"bb_paragraph\" >Unique skin generation inspired by CS:GO</p></li><li><p class=\"bb_paragraph\" >Unlock new profile customization elements by playing!</p></li><li><p class=\"bb_paragraph\" >Unique level up system based on players trading</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2449210/extras/b3617d28e92f64d9726169b15d39ad2d.avif?t=1728980539\" data-has-big /></span></p></li></ul>",
    "about_the_game": "<p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline crossorigin=\"anonymous\" poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2449210/extras/606631a4f84fae58d6d2cfd971108668.poster.avif?t=1728980539\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2449210/extras/606631a4f84fae58d6d2cfd971108668.webm?t=1728980539\" type=\"video/webm; codecs=vp9\"></video></span></p><p class=\"bb_paragraph\" ><strong><i>Uprunner</i></strong> is a free-to-play MMO vertical speedrunner. </p><p class=\"bb_paragraph\" >Win lobbies or create your own maps to earn coins and buy unique randomly generated skins!</p><h2 class=\"bb_tag\" >Game Features</h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >Lobby with all the players on the same map changing every 5 minutes!</p></li><li><p class=\"bb_paragraph\" >Level editor with many blocks and skins to try</p></li><li><p class=\"bb_paragraph\" >Hundreds of community maps already available!</p></li><li><p class=\"bb_paragraph\" >Climb the leaderboard and show the world your skills!</p></li><li><p class=\"bb_paragraph\" >Unique skin generation inspired by CS:GO</p></li><li><p class=\"bb_paragraph\" >Unlock new profile customization elements by playing!</p></li><li><p class=\"bb_paragraph\" >Unique level up system based on players trading</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2449210/extras/b3617d28e92f64d9726169b15d39ad2d.avif?t=1728980539\" data-has-big /></span></p></li></ul>",
