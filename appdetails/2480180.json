9b432c167d785386416e7d6c2d818f5d.poster.avif?t=1720816990\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2480180/extras/9b432c167d785386416e7d6c2d818f5d.webm?t=1720816990\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2480180/extras/9b432c167d785386416e7d6c2d818f5d.mp4?t=1720816990\" type=\"video/mp4\"></video></span>",
