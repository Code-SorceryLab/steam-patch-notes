d.akamai.steamstatic.com/store_item_assets/steam/apps/955550/extras/886de82b013c9f1f7601e3ca68edd5af.webm?t=1698522817\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/955550/extras/886de82b013c9f1f7601e3ca68edd5af.mp4?t=1698522817\" type=\"video/mp4\"></video></div>",
