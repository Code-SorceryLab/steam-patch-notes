ed8244ad7e.poster.avif?t=1745767955\" width=652 height=366 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3283860/extras/b8dfaadb28867893026eceed8244ad7e.webm?t=1745767955\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3283860/extras/b8dfaadb28867893026eceed8244ad7e.mp4?t=1745767955\" type=\"video/mp4\"></video></span></p></li><li><p class=\"bb_paragraph\" ><strong>Minimalist Design </strong>- One gun, one shot to kill.</p><h2 class=\"bb_tag\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3283860/extras/2b26fc7652f85b56977b1524d4b37e23.poster.avif?t=1745767955\" width=800 height=450 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3283860/extras/2b26fc7652f85b56977b1524d4b37e23.webm?t=1745767955\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3283860/extras/2b26fc7652f85b56977b1524d4b37e23.mp4?t=1745767955\" type=\"video/mp4\"></video></span><strong>Experience a new kind of shooter. Wishlist REPEATER today.</strong></h2></li></ul>",
