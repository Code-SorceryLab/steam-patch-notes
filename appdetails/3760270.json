    "detailed_description": "<h2 class=\"bb_tag\" ><strong><i>\u30b2\u30fc\u30e0\u6982\u8981</i></strong></h2><p class=\"bb_paragraph\" >\u3068\u304b\u3052\u30e1\u30c8\u30edGB\u306f\u3001GBStudio\u88fd\u306e\u7121\u6599\u3067\u904a\u3079\u308b\u3086\u308b\u3044\u30e1\u30c8\u30ed\u30a4\u30c9\u30f4\u30a1\u30cb\u30a2\u3067\u3059\u3002</p><p class=\"bb_paragraph\" >\u63a2\u7d22\u306e\u306a\u304b\u3067\u5c11\u3057\u305a\u3064\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u80fd\u529b\u304c\u89e3\u653e\u3055\u308c\u3066\u3044\u304d\u3001\u3055\u3089\u306b\u63a2\u7d22\u7bc4\u56f2\u304c\u5e83\u304c\u3063\u3066\u3044\u304d\u307e\u3059\u3002</p><p class=\"bb_paragraph\" >\u3086\u308b\u3044\u30e1\u30c8\u30ed\u30a4\u30c9\u30f4\u30a1\u30cb\u30a2\u306e\u540d\u306e\u901a\u308a\u3001\u8907\u96d1\u3059\u304e\u306a\u3044\u30de\u30c3\u30d7\u69cb\u6210\u306b\u306a\u308b\u3088\u3046\u306b\u5fc3\u304c\u3051\u3066\u3044\u307e\u3059\u3002</p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" ><strong><i>\u3042\u3089\u3059\u3058</i></strong></h2><p class=\"bb_paragraph\" >\u3042\u308b\u65e5\u306e\u3053\u3068\u3002\u3068\u304b\u3052\u65cf\u306e\u3052\u3063\u3061\u306f\u3001\u4f1a\u8b70\u5ba4\u306b\u547c\u3073\u51fa\u3055\u308c\u307e\u3059\u3002</p><p class=\"bb_paragraph\" >\u305d\u306e\u4e0a\u53f8\u3044\u308f\u304f\u3002</p><p class=\"bb_paragraph\" >\u53d6\u5f15\u5148\u306e\u300c\u306f\u3080\u3057\u98df\u54c1\u300d\u304b\u3089\u7d0d\u54c1\u3055\u308c\u308b\u308c\u3044\u3068\u3046\u30d5\u30fc\u30c9\u306e\u7d0d\u54c1\u304c\u6ede\u3063\u3066\u3044\u308b\u3068\u3044\u3046\u306e\u3067\u3059\u3002</p><p class=\"bb_paragraph\" >\u3052\u3063\u3061\u306f\u4e0a\u53f8\u306b\u547d\u4ee4\u3055\u308c\u3001\u9045\u5ef6\u306e\u539f\u56e0\u3092\u7a81\u304d\u6b62\u3081\u308b\u305f\u3081\u3001\u306f\u3080\u3057\u98df\u54c1\u306b\u5411\u304b\u3046\u3053\u3068\u306b\u306a\u308a\u307e\u3059\u3002</p><p class=\"bb_paragraph\" >\u3060\u3051\u3069\u3001\u306f\u3080\u3057\u98df\u54c1\u3067\u306f\u72c2\u66b4\u5316\u3057\u305f\u8d64\u30b3\u30aa\u30ed\u30ae\u304c\u66b4\u308c\u307e\u308f\u3063\u3066\u3044\u3066\u2026\u2026\uff1f</p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" ><strong><i>\u30bb\u30fc\u30eb\u30b9\u30dd\u30a4\u30f3\u30c8</i></strong></h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u7121\u6599\u304b\u3064\u30b7\u30e7\u30fc\u30c8\u30d7\u30ec\u30a4 <br>\u4e00\u822c\u7684\u306a\u30e1\u30c8\u30ed\u30a4\u30c9\u30f4\u30a1\u30cb\u30a2\u306b\u6bd4\u3079\u3066\u3001\u8907\u96d1\u3059\u304e\u306a\u3044\u30de\u30c3\u30d7\u69cb\u6210\u306b\u306a\u308b\u3088\u3046\u306b\u3057\u3066\u3044\u307e\u3059\u3002</p></li><li><p class=\"bb_paragraph\" >GBStudio\u88fd <br>\u672c\u4f5c\u306fGBStudio\u306b\u3088\u3063\u3066\u88fd\u4f5c\u3055\u308c\u3001\u5b9f\u969b\u306b\u30b2\u30fc\u30e0\u30dc\u30fc\u30a4\u30ab\u30e9\u30fc\u3084\u4e92\u63db\u6a5f\u3001 <br>AnaloguePocket\u3067\u3082\u52d5\u4f5c\u3055\u305b\u3089\u308c\u307e\u3059\u3002steam\u7248\u306f\u30b9\u30bf\u30f3\u30c9\u30a2\u30ed\u30f3\u3067\u52d5\u4f5c\u3057\u307e\u3059\u3002</p></li><li><p class=\"bb_paragraph\" >\u624b\u306b\u306a\u3058\u3080\u64cd\u4f5c\u611f <br>\u64cd\u4f5c\u611f\u306f\u8efd\u5feb\u3067\u3001 <br>\u7e70\u308a\u8fd4\u3057\u904a\u3073\u305f\u304f\u306a\u308b\u3088\u3046\u306b\u7d30\u304b\u304f\u79fb\u52d5\u3084\u30b8\u30e3\u30f3\u30d7\u306e\u6319\u52d5\u3092\u8abf\u6574\u3057\u3066\u3044\u307e\u3059\u3002</p></li><li><p class=\"bb_paragraph\" >\u96a0\u3057\u901a\u8def\u3092\u767a\u898b\u3059\u308b\u9a5a\u304d\u3068\u559c\u3073 <br>\u30b9\u30c6\u30fc\u30b8\u5185\u90e8\u306b\u306f\u3001\u53ce\u96c6\u30a2\u30a4\u30c6\u30e0\u3067\u3042\u308b\u300c\u304a\u3084\u3064\u300d\u304c\u3001\u304b\u306a\u308a\u5de7\u5999\u306b\u96a0\u3055\u308c\u3066\u3044\u307e\u3059\u3002 <br>\u602a\u3057\u3044\u30dd\u30a4\u30f3\u30c8\u304c\u306a\u3044\u304b\u3042\u3061\u3053\u3061\u8abf\u3079\u306a\u304c\u3089\u304a\u3084\u3064\u56f3\u9451\u3092\u5b8c\u6210\u3055\u305b\u307e\u3057\u3087\u3046\u3002</p></li></ul>",
    "about_the_game": "<h2 class=\"bb_tag\" ><strong><i>\u30b2\u30fc\u30e0\u6982\u8981</i></strong></h2><p class=\"bb_paragraph\" >\u3068\u304b\u3052\u30e1\u30c8\u30edGB\u306f\u3001GBStudio\u88fd\u306e\u7121\u6599\u3067\u904a\u3079\u308b\u3086\u308b\u3044\u30e1\u30c8\u30ed\u30a4\u30c9\u30f4\u30a1\u30cb\u30a2\u3067\u3059\u3002</p><p class=\"bb_paragraph\" >\u63a2\u7d22\u306e\u306a\u304b\u3067\u5c11\u3057\u305a\u3064\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u80fd\u529b\u304c\u89e3\u653e\u3055\u308c\u3066\u3044\u304d\u3001\u3055\u3089\u306b\u63a2\u7d22\u7bc4\u56f2\u304c\u5e83\u304c\u3063\u3066\u3044\u304d\u307e\u3059\u3002</p><p class=\"bb_paragraph\" >\u3086\u308b\u3044\u30e1\u30c8\u30ed\u30a4\u30c9\u30f4\u30a1\u30cb\u30a2\u306e\u540d\u306e\u901a\u308a\u3001\u8907\u96d1\u3059\u304e\u306a\u3044\u30de\u30c3\u30d7\u69cb\u6210\u306b\u306a\u308b\u3088\u3046\u306b\u5fc3\u304c\u3051\u3066\u3044\u307e\u3059\u3002</p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" ><strong><i>\u3042\u3089\u3059\u3058</i></strong></h2><p class=\"bb_paragraph\" >\u3042\u308b\u65e5\u306e\u3053\u3068\u3002\u3068\u304b\u3052\u65cf\u306e\u3052\u3063\u3061\u306f\u3001\u4f1a\u8b70\u5ba4\u306b\u547c\u3073\u51fa\u3055\u308c\u307e\u3059\u3002</p><p class=\"bb_paragraph\" >\u305d\u306e\u4e0a\u53f8\u3044\u308f\u304f\u3002</p><p class=\"bb_paragraph\" >\u53d6\u5f15\u5148\u306e\u300c\u306f\u3080\u3057\u98df\u54c1\u300d\u304b\u3089\u7d0d\u54c1\u3055\u308c\u308b\u308c\u3044\u3068\u3046\u30d5\u30fc\u30c9\u306e\u7d0d\u54c1\u304c\u6ede\u3063\u3066\u3044\u308b\u3068\u3044\u3046\u306e\u3067\u3059\u3002</p><p class=\"bb_paragraph\" >\u3052\u3063\u3061\u306f\u4e0a\u53f8\u306b\u547d\u4ee4\u3055\u308c\u3001\u9045\u5ef6\u306e\u539f\u56e0\u3092\u7a81\u304d\u6b62\u3081\u308b\u305f\u3081\u3001\u306f\u3080\u3057\u98df\u54c1\u306b\u5411\u304b\u3046\u3053\u3068\u306b\u306a\u308a\u307e\u3059\u3002</p><p class=\"bb_paragraph\" >\u3060\u3051\u3069\u3001\u306f\u3080\u3057\u98df\u54c1\u3067\u306f\u72c2\u66b4\u5316\u3057\u305f\u8d64\u30b3\u30aa\u30ed\u30ae\u304c\u66b4\u308c\u307e\u308f\u3063\u3066\u3044\u3066\u2026\u2026\uff1f</p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" ><strong><i>\u30bb\u30fc\u30eb\u30b9\u30dd\u30a4\u30f3\u30c8</i></strong></h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u7121\u6599\u304b\u3064\u30b7\u30e7\u30fc\u30c8\u30d7\u30ec\u30a4 <br>\u4e00\u822c\u7684\u306a\u30e1\u30c8\u30ed\u30a4\u30c9\u30f4\u30a1\u30cb\u30a2\u306b\u6bd4\u3079\u3066\u3001\u8907\u96d1\u3059\u304e\u306a\u3044\u30de\u30c3\u30d7\u69cb\u6210\u306b\u306a\u308b\u3088\u3046\u306b\u3057\u3066\u3044\u307e\u3059\u3002</p></li><li><p class=\"bb_paragraph\" >GBStudio\u88fd <br>\u672c\u4f5c\u306fGBStudio\u306b\u3088\u3063\u3066\u88fd\u4f5c\u3055\u308c\u3001\u5b9f\u969b\u306b\u30b2\u30fc\u30e0\u30dc\u30fc\u30a4\u30ab\u30e9\u30fc\u3084\u4e92\u63db\u6a5f\u3001 <br>AnaloguePocket\u3067\u3082\u52d5\u4f5c\u3055\u305b\u3089\u308c\u307e\u3059\u3002steam\u7248\u306f\u30b9\u30bf\u30f3\u30c9\u30a2\u30ed\u30f3\u3067\u52d5\u4f5c\u3057\u307e\u3059\u3002</p></li><li><p class=\"bb_paragraph\" >\u624b\u306b\u306a\u3058\u3080\u64cd\u4f5c\u611f <br>\u64cd\u4f5c\u611f\u306f\u8efd\u5feb\u3067\u3001 <br>\u7e70\u308a\u8fd4\u3057\u904a\u3073\u305f\u304f\u306a\u308b\u3088\u3046\u306b\u7d30\u304b\u304f\u79fb\u52d5\u3084\u30b8\u30e3\u30f3\u30d7\u306e\u6319\u52d5\u3092\u8abf\u6574\u3057\u3066\u3044\u307e\u3059\u3002</p></li><li><p class=\"bb_paragraph\" >\u96a0\u3057\u901a\u8def\u3092\u767a\u898b\u3059\u308b\u9a5a\u304d\u3068\u559c\u3073 <br>\u30b9\u30c6\u30fc\u30b8\u5185\u90e8\u306b\u306f\u3001\u53ce\u96c6\u30a2\u30a4\u30c6\u30e0\u3067\u3042\u308b\u300c\u304a\u3084\u3064\u300d\u304c\u3001\u304b\u306a\u308a\u5de7\u5999\u306b\u96a0\u3055\u308c\u3066\u3044\u307e\u3059\u3002 <br>\u602a\u3057\u3044\u30dd\u30a4\u30f3\u30c8\u304c\u306a\u3044\u304b\u3042\u3061\u3053\u3061\u8abf\u3079\u306a\u304c\u3089\u304a\u3084\u3064\u56f3\u9451\u3092\u5b8c\u6210\u3055\u305b\u307e\u3057\u3087\u3046\u3002</p></li></ul>",
