ai.steamstatic.com/store_item_assets/steam/apps/3444830/extras/93e732ba7826f8518deee1febf58c0fa.mp4?t=1755303703\" type=\"video/mp4\"></video></span></p><h2 class=\"bb_tag\" ><strong>Adapt and overcome the ever-changing challenges</strong></h2><p class=\"bb_paragraph\" >With each level of the pyramid, guardians with unique traits will appear, requiring an unconventional approach. Don't underestimate their defensive abilities, they can cause a lot of havoc on the field and mess up your plans.</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3444830/extras/2f19ce088165369401186b0ed9496c50.poster.avif?t=1755303703\" width=616 height=256 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3444830/extras/2f19ce088165369401186b0ed9496c50.webm?t=1755303703\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3444830/extras/2f19ce088165369401186b0ed9496c50.mp4?t=1755303703\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" >But with a well-thought-out strategy, Guardians can even work in your favor.</p><h2 class=\"bb_tag\" ><strong>Explore the ultimate collection of powerful artifact</strong></h2><p class=\"bb_paragraph\" >Collect your ultimate collection of powerful artifacts. Each one of them will change the way you play the game. Choose them carefully to create your unique build. Figure out how they all work together with each other and with the rest of the game's mechanics.</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3444830/extras/c7c84f96d21b2680491eaadc1aa5afbf.poster.avif?t=1755303703\" width=616 height=256 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3444830/extras/c7c84f96d21b2680491eaadc1aa5afbf.webm?t=1755303703\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3444830/extras/c7c84f96d21b2680491eaadc1aa5afbf.mp4?t=1755303703\" type=\"video/mp4\"></video></span></p><h2 class=\"bb_tag\" ><strong>Choose the best crafting recipes that suit your gaming style</strong></h2><p class=\"bb_paragraph\" >Crafting recipes sealed in magic crystals allows you to change cards in your hand right during the middle of a game round, giving you unique flexibility when deciding on your next move. No matching card in your hand and not enough of the right kind of enchantment? No problem, just use the cards you have as ingredients to create the ones you need. And don't be afraid to experiment, because at the end of the round, all the created cards will return to their original form.</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3444830/extras/df9012ff26d8dd5511e5ac2f7f1cf801.poster.avif?t=1755303703\" width=616 height=256 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3444830/extras/df9012ff26d8dd5511e5ac2f7f1cf801.webm?t=1755303703\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3444830/extras/df9012ff26d8dd5511e5ac2f7f1cf801.mp4?t=1755303703\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" >Unlock new possibilities with each playthrough. Plan the most powerful and lengthy combos, using your magical deck to its fullest potential.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p>",
