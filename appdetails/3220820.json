store_item_assets/steam/apps/3220820/extras/932cd87d9ce72ab815fc46ee38cb9739.mp4?t=1741619595\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ><strong>Review words with spaced repetition</strong></p><h2 class=\"bb_tag\" ><strong>THIS IS NOT A TEST...</strong></h2><p class=\"bb_paragraph\" ><strong>REVEAL A RANDOM LETTER</strong></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3220820/extras/84f5278808b1e69bb5315b3d8b1b05d0.poster.avif?t=1741619595\" width=800 height=450 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3220820/extras/84f5278808b1e69bb5315b3d8b1b05d0.webm?t=1741619595\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3220820/extras/84f5278808b1e69bb5315b3d8b1b05d0.mp4?t=1741619595\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><strong>REVEAL A CHOSEN LETTER</strong></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3220820/extras/cb1886f5245a438e0365c833085422d7.poster.avif?t=1741619595\" width=800 height=450 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3220820/extras/cb1886f5245a438e0365c833085422d7.webm?t=1741619595\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3220820/extras/cb1886f5245a438e0365c833085422d7.mp4?t=1741619595\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><strong>REVEAL A RANDOM WORD</strong></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamst