paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3007310/extras/62fb8060b3fdf4d01ead4bffd6440f0a.poster.avif?t=1754404527\" width=616 height=344 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3007310/extras/62fb8060b3fdf4d01ead4bffd6440f0a.webm?t=1754404527\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3007310/extras/62fb8060b3fdf4d01ead4bffd6440f0a.mp4?t=1754404527\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p></li></ul>",
