class=\"bb_paragraph\"><div class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1394880/extras/5092cde228b6f144b1170b6a44f8baff.poster.avif?t=1738157526\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1394880/extras/5092cde228b6f144b1170b6a44f8baff.webm?t=1738157526\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1394880/extras/5092cde228b6f144b1170b6a44f8baff.mp4?t=1738157526\" type=\"video/mp4\"></video></div></p><p class=\"bb_paragraph\"><div class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1394880/extras/a7e678f7ff5086097e6c737068705905.webp?t=1738157526\" /></div></p><p class=\"bb_paragraph\"><div class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1394880/extras/fc3f6d7ef68d1fbd26196bb21e3d9a12.webp?t=1738157526\" /></div></p>",
