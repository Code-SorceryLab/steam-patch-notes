uted loop playsinline crossorigin=\"anonymous\" poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2479240/extras/b9faba9eb233a00c75ab38f46000b708.poster.avif?t=1746658554\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2479240/extras/b9faba9eb233a00c75ab38f46000b708.webm?t=1746658554\" type=\"video/webm; codecs=vp9\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p>",
