    "name": "\u30d1\u30c1\u3063\u3068\u30d2\u30d1\u30c1\u30fc \u304b\u3051\u3060\u305b\uff01\u30d1\u30c1\u30d1\u30c1\u3068\u304d\u3081\u304d\u82b1\u706b\u5927\u4f1a\uff01",
