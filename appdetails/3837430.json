    "steam_appid": 3837430,
    "required_age": 0,
    "is_free": false,
    "detailed_description": "<p class=\"bb_paragraph\" >\u203b Brief Description \u203b</p><p class=\"bb_paragraph\" >You\u2019re trapped in an endless maze of alleys.  </p><p class=\"bb_paragraph\" >Carefully observe your surroundings and complete the Bagua to escape the infinite labyrinth!</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\u203b Alley Rules \u203b</p><p class=\"bb_paragraph\" >1. Hold Shift to run.  </p><p class=\"bb_paragraph\" >2. Press ESC to open the menu.  </p><p class=\"bb_paragraph\" >3. If no anomalies are detected, proceed forward.  </p><p class=\"bb_paragraph\" >4. If you encounter anything unusual, turn back immediately.  </p><p class=\"bb_paragraph\" >5. Illuminate all the lights on the Bagua to complete your path.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\u203b Game Overview \u203b</p><p class=\"bb_paragraph\" >Bagua Alley is a short walking simulator set in a medieval East Asian-inspired world, inspired by Exit 8.  </p><p class=\"bb_paragraph\" >The game supports Korean, English, Chinese, and Japanese languages.  </p><p class=\"bb_paragraph\" >Discover a total of 36 unique gimmicks and complete the Bagua.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\u203b Game Info \u203b</p><p class=\"bb_paragraph\" >[Play Time]  </p><p class=\"bb_paragraph\" >15-60 minutes</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >[Content]  </p><p class=\"bb_paragraph\" >34 anomalies and 2 endings</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >[Game Mode]  </p><p class=\"bb_paragraph\" >Single Player</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >[Controls]  </p><p class=\"bb_paragraph\" >Mouse &amp; Keyboard</p>",
    "about_the_game": "<p class=\"bb_paragraph\" >\u203b Brief Description \u203b</p><p class=\"bb_paragraph\" >You\u2019re trapped in an endless maze of alleys.  </p><p class=\"bb_paragraph\" >Carefully observe your surroundings and complete the Bagua to escape the infinite labyrinth!</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\u203b Alley Rules \u203b</p><p class=\"bb_paragraph\" >1. Hold Shift to run.  </p><p class=\"bb_paragraph\" >2. Press ESC to open the menu.  </p><p class=\"bb_paragraph\" >3. If no anomalies are detected, proceed forward.  </p><p class=\"bb_paragraph\" >4. If you encounter anything unusual, turn back immediately.  </p><p class=\"bb_paragraph\" >5. Illuminate all the lights on the Bagua to complete your path.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\u203b Game Overview \u203b</p><p class=\"bb_paragraph\" >Bagua Alley is a short walking simulator set in a medieval East Asian-inspired world, inspired by Exit 8.  </p><p class=\"bb_paragraph\" >The game supports Korean, English, Chinese, and Japanese languages.  </p><p class=\"bb_paragraph\" >Discover a total of 36 unique gimmicks and complete the Bagua.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\u203b Game Info \u203b</p><p class=\"bb_paragraph\" >[Play Time]  </p><p class=\"bb_paragraph\" >15-60 minutes</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >[Content]  </p><p class=\"bb_paragraph\" >34 anomalies and 2 endings</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >[Game Mode]  </p><p class=\"bb_paragraph\" >Single Player</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >[Controls]  </p><p class=\"bb_paragraph\" >Mouse &amp; Keyboard</p>",
