uted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2721440/extras/e0d02c382e05e5a9f3f0d46e817bfb7a.poster.avif?t=1746160043\" width=614 height=170 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2721440/extras/e0d02c382e05e5a9f3f0d46e817bfb7a.webm?t=1746160043\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2721440/extras/e0d02c382e05e5a9f3f0d46e817bfb7a.mp4?t=1746160043\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p>",
