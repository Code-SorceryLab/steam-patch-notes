d.akamai.steamstatic.com/store_item_assets/steam/apps/589780/extras/82a357d7c898b433ead8d3b53da791bb.mp4?t=1728690203\" type=\"video/mp4\"></video></div></h2><h2 class=\"bb_tag\">Psychological Bartending</h2>Read your customer's\u2019 mood and mix the perfect cocktail to manipulate the client's emotions in order to gather the information you want and progress your agenda of stopping Supercontinent's plans.<h2 class=\"bb_tag\"><div class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/589780/extras/2a0b8d72109e1654521ccf0e6763ab53.poster.avif?t=1728690203\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/589780/extras/2a0b8d72109e1654521ccf0e6763ab53.webm?t=1728690203\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/589780/extras/2a0b8d72109e1654521ccf0e6763ab53.mp4?t=1728690203\" type=\"video/mp4\"></video></div></h2><h2 class=\"bb_tag\">Genetic Implant Pottery</h2>Design genetic implants at a high-tech lathe to change the attitude and direction of the corporation\u2019s most influential executives.<h2 class=\"bb_tag\"><div class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/589780/extras/fb31103f0b55e608516eaae8425f6b83.poster.avif?t=1728690203\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/589780/extras/fb31103f0b55e608516eaae8425f6b83.webm?t=1728690203\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/589780/extras/fb31103f0b55e608516eaae8425f6b83.mp4?t=1728690203\" type=\"video/mp4\"></video></div></h2><h2 class=\"bb_tag\">Vocal Corporate Espionage</h2>Assume the voice of important figures in the Social Psyche Welfare project and play their own motivations against eac