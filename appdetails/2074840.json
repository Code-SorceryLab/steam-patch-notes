=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline crossorigin=\"anonymous\" poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2074840/extras/5cae7f09e02b55360465faaed35030c1.poster.avif?t=1747471471\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2074840/extras/5cae7f09e02b55360465faaed35030c1.webm?t=1747471471\" type=\"video/webm; codecs=vp9\"></video></div>",
