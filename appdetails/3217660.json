ight=342 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3217660/extras/79c0f869c34784380e7704be2045fe0e.webm?t=1753891509\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3217660/extras/79c0f869c34784380e7704be2045fe0e.mp4?t=1753891509\" type=\"video/mp4\"></video></span>",
