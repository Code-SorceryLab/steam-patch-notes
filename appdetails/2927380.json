    "detailed_description": "<p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2927380/extras/2c68e4dbfee81abec6e7e8e01d9a9bdf.poster.avif?t=1737123861\" width=426 height=240 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2927380/extras/2c68e4dbfee81abec6e7e8e01d9a9bdf.webm?t=1737123861\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2927380/extras/2c68e4dbfee81abec6e7e8e01d9a9bdf.mp4?t=1737123861\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ><strong>Welcome to Paw Pirates!</strong></p><p class=\"bb_paragraph\" > </p><p class=\"bb_paragraph\" ><strong>Paw Pirates</strong> is a multiplayer party game for friends and family! Compete for glory on the high seas as you work together to destroy your opponents' boat! </p><p class=\"bb_paragraph\" > </p><p class=\"bb_paragraph\" >Who Will Win: <i><strong>cats</strong></i> Or <i><strong>dogs</strong></i>?</p><p class=\"bb_paragraph\" > </p><p class=\"bb_paragraph\" >Tackle Your Opponents to Send them Flying!</p><p class=\"bb_paragraph\" > </p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2927380/extras/f28136ae7cfa5b5a2f331dcd03ed30da.poster.avif?t=1737123861\" width=426 height=240 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2927380/extras/f28136ae7cfa5b5a2f331dcd03ed30da.webm?t=1737123861\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2927380/extras/f28136ae7cfa5b5a2f331dcd03ed30da.mp4?t=1737123861\" type=\"video/mp4\"></video></span></p>",
    "about_the_game": "<p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2927380/extras/2c68e4dbfee81abec6e7e8e01d9a9bdf.poster.avif?t=1737123861\" width=426 height=240 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2927380/extras/2c68e4dbfee81abec6e7e8e01d9a9bdf.webm?t=1737123861\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2927380/extras/2c68e4dbfee81abec6e7e8e01d9a9bdf.mp4?t=1737123861\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ><strong>Welcome to Paw Pirates!</strong></p><p class=\"bb_paragraph\" > </p><p class=\"bb_paragraph\" ><strong>Paw Pirates</strong> is a multiplayer party game for friends and family! Compete for glory on the high seas as you work together to destroy your opponents' boat! </p><p class=\"bb_paragraph\" > </p><p class=\"bb_paragraph\" >Who Will Win: <i><strong>cats</strong></i> Or <i><strong>dogs</strong></i>?</p><p class=\"bb_paragraph\" > </p><p class=\"bb_paragraph\" >Tackle Your Opponents to Send them Flying!</p><p class=\"bb_paragraph\" > </p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2927380/extras/f28136ae7cfa5b5a2f331dcd03ed30da.poster.avif?t=1737123861\" width=426 height=240 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2927380/extras/f28136ae7cfa5b5a2f331dcd03ed30da.webm?t=1737123861\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2927380/extras/f28136ae7cfa5b5a2f331dcd03ed30da.mp4?t=1737123861\" type=\"video/mp4\"></video></span></p>",
