    "detailed_description": "<h1>\u5165\u7fa4\u9886\u798f\u5229</h1><p><p class=\"bb_paragraph\" >\u5b98\u65b93\u7fa4\uff1a1059699939\uff08\u706b\u7206\u52a0\u5165\u4e2d\uff09</p><p class=\"bb_paragraph\" >\u5b98\u65b92\u7fa4\uff1a740804230\uff08\u5df2\u6ee1\uff0c\u52ff\u52a0\uff09</p><p class=\"bb_paragraph\" >\u5b98\u65b91\u7fa4\uff1a1043310866\uff08\u5df2\u6ee1\uff0c\u52ff\u52a0\uff09</p><p class=\"bb_paragraph\" >\u53ef\u9886\u53d6\u591a\u4e2a\u793c\u5305\u798f\u5229\uff0c\u4e0d\u5b9a\u671f\u53d1\u653e\u65b0\u7684\u793c\u5305\u3002\u6709\u4efb\u4f55\u7591\u96be\u95ee\u9898\u53ef\u4ee5\u968f\u65f6\u4e0e\u7ba1\u7406\u5458\u8fdb\u884c\u6c9f\u901a\uff0c\u5e76\u83b7\u53d6\u7b2c\u4e00\u624b\u66f4\u65b0\u8d44\u6599</p></p><br><h1>About the Game</h1><p class=\"bb_paragraph\" >\u7ecf\u51781.80\u7248\u91cd\u73b0\uff0c\u7ecf\u4e45\u4e0d\u8870\uff0c\u88c5\u5907\u65e0\u9650\u81ea\u7531\u6253\uff0c\u795e\u88c5\u6ee1\u5730\u7206\uff01\u5728\u8fd9\u6b3e\u539f\u6c41\u539f\u5473\u7684MMORPG\u6e38\u620f\u4e2d\uff0c\u4f60\u5c06\u4e0e\u540c\u4f34\u5c3d\u60c5\u5192\u9669\uff0c\u6210\u5c31\u4e00\u6bb5\u5f3a\u8005\u7684\u4f20\u5947\u6210\u957f\u4e4b\u8def\u3002</p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" >\u3010\u6e38\u620f\u7279\u8272\u3011</h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u7ecf\u5178\u4e09\u804c\u4e1a\u8bbe\u5b9a</p></li></ul><p class=\"bb_paragraph\" >\u25c7\u6218\u58eb\uff1a\u8fd1\u6218\u65e0\u654c\u4e00\u6837\u7684\u5b58\u5728\uff01\u70c8\u706b\u5251\u6cd5\uff0c\u9010\u65e5\u5251\u6cd5\uff0c\u5f00\u5929\u65a9\u8ba9\u4f60\u5982\u795e\u4e00\u822c\u5b58\u5728\uff01</p><p class=\"bb_paragraph\" >\u25c7\u9053\u58eb\uff1a\u4e0a\u7ebf\u53cc\u795e\u517d\uff0c\u53ef\u5347\u7ea7\u5230\u5723\u517d\u2014&gt;\u7075\u517d\u2014&gt;\u6708\u7075\u2014&gt;\u706b\u7075\u2014&gt;\u96f7\u7075\uff0c\u914d\u5408\u7fa4\u653b\u9053\u672f\u98d3\u98ce\u7834\u4e0e\u7fa4\u4f53\u65bd\u6bd2\u672f\uff0c\u53ef\u6311\u6218\u4efb\u4f55BOSS</p><p class=\"bb_paragraph\" >\u25c7\u6cd5\u5e08\uff1a\u64c5\u957f\u8fdc\u7a0b\u6cd5\u672f\u653b\u51fb\uff0c\u6d41\u661f\u706b\u96e8\u5237\u602a\u8d85\u723d\uff0c\u8bf1\u60d1\u4e4b\u5149\u53ef\u8bf1\u60d15\u53ea\u5b9d\u5b9d\uff0c\u795e\u6321\u6740\u795e\uff0c\u4f5b\u6321\u6740\u4f5b\uff01\u5ba0\u7269\u53ef\u5728\u5404\u5927\u4e3b\u57ce\u53ef\u5bfb\u627e\u5230\u3002</p><p class=\"bb_paragraph\" ></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u798f\u5229\u7cfb\u7edf</p></li></ul><p class=\"bb_paragraph\" >\u88c5\u5907\u5168\u9760\u6253\uff0c\u7075\u7b26\u5143\u5b9d\u5168\u90fd\u7206\uff01\u53ea\u8981\u662f\u6e38\u620f\u5185\u9700\u8981\u7528\u5230\u7684\u8d44\u6e90\uff0c\u5747\u53ef\u901a\u8fc7\u51fb\u6740BOSS\u3001\u53c2\u4e0e\u6d3b\u52a8\u6765\u83b7\u53d6\uff01\u8fd8\u4e13\u95e8\u4e3a\u5404\u4f4d\u73a9\u5bb6\u51c6\u5907\u4e86\u5404\u7c7b\u798f\u5229\u6d3b\u52a8\u3002</p><p class=\"bb_paragraph\" >\u25c7\u9996\u6740\u5956\u52b1\uff1a\u5b8c\u6210\u6240\u5728\u670d\u52a1\u5668\u6307\u5b9aBOSS\u7684\u9996\u4e2a\u51fb\u6740\uff0c\u53ef\u4ee5\u83b7\u5f97\u5956\u52b1</p><p class=\"bb_paragraph\" >\u25c7\u9996\u7206\u5956\u52b1\uff1a\u7b2c\u4e00\u4e2a\u6253\u5230\u6307\u5b9a\u88c5\u5907\u7684\u73a9\u5bb6\uff0c\u53ef\u4ee5\u83b7\u5f97\u5143\u5b9d\u4e0e\u771f\u5b9e\u5145\u503c\u5361\u5956\u52b1</p><p class=\"bb_paragraph\" >\u25c7\u5f15\u5bfc\u4efb\u52a1\uff1a\u5b8c\u6210\u540e\u53ef\u83b7\u5f97\u5f3a\u529b\u7684\u5c5e\u6027\u52a0\u6210</p><p class=\"bb_paragraph\" >\u25c7\u5386\u7ec3\u4efb\u52a1\uff1a\u51fb\u6740\u6307\u5b9aBOSS\uff0c\u53ef\u83b7\u5f97\u5200\u5200\u5207\u5272\u4f24\u5bb3\u63d0\u5347</p><p class=\"bb_paragraph\" >\u25c7\u4e03\u65e5\u8c6a\u793c\uff1a\u6bcf\u65e5\u9886\u53d6\u5927\u91cf\u793c\u7269\uff0c\u8fd8\u6709\u771f\u5b9e\u5145\u503c\u5361\u53ef\u4ee5\u83b7\u53d6\u5230</p><p class=\"bb_paragraph\" >\u25c7\u6bcf\u65e5\u6276\u6301\uff1a\u53ef\u83b7\u5f97\u5927\u91cf\u5956\u52b1</p><p class=\"bb_paragraph\" >\u25c7\u6276\u6301\u6708\u5361\uff1a\u6bcf\u65e5\u514d\u8d39\u9886\u53d6\u5404\u7c7b\u8d44\u6e90</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\u6e38\u620f\u7cfb\u7edf</p><p class=\"bb_paragraph\" >\u25c7\u6280\u80fd\u5927\u5e08\uff1a\u53ef\u4ee5\u5f3a\u5316\u73b0\u6709\u6280\u80fd\u4e0e\u5b66\u4e60\u9ad8\u7ea7\u6280\u80fd</p><p class=\"bb_paragraph\" >\u25c7\u79d8\u5b9d\u7cfb\u7edf\uff1a\u5e26\u4e0a\u540e\u53ef\u4ee5\u5728\u653b\u51fb\u8fc7\u7a0b\u4e2d\u4e00\u5b9a\u6982\u7387\u89e6\u53d1\u7279\u6b8a\u6548\u679c\uff0c\u4f8b\u5982\u4f24\u5bb3\u63d0\u5347\u7b49</p><p class=\"bb_paragraph\" >\u25c7\u795e\u88c5\u5750\u9a91\uff1a\u62e5\u6709\u5750\u9a91\u540e\uff0c\u53ef\u4ee5\u83b7\u5f97\u9ad8\u901f\u884c\u9a76\u7684\u80fd\u529b</p><p class=\"bb_paragraph\" >\u25c7\u795e\u5a01\u5927\u5e08\uff1a\u6709\u591a\u4e2a\u795e\u5a01\u80fd\u529b\u53ef\u4ee5\u63d0\u5347\uff0c\u6bcf\u4e2a\u795e\u5a01\u90fd\u6709\u72ec\u7279\u7684\u529f\u80fd</p><p class=\"bb_paragraph\" >\u25c7\u5f02\u517d\u5f55\uff1a\u5206\u4e3a\u4f18\u79c0\u3001\u7a00\u6709\u3001\u53f2\u8bd7\u3001\u4f20\u8bf4\u3001\u795e\u8bdd\u4e94\u4e2a\u7b49\u7ea7\u7684\u5c71\u6d77\u7ecf\u5f02\u517d\uff1b\u5355\u4e2a\u5f02\u517d\u56fe\u9274\u7b49\u7ea7\u63d0\u5347\uff0c\u53ef\u4ee5\u83b7\u5f97\u5c5e\u6027\u4e0a\u7684\u63d0\u5347\uff0c\u5f62\u6210\u5361\u7ec4\u7f81\u7eca\u6548\u679c\u4e4b\u540e\u8fd8\u6709\u989d\u5916\u7684\u5957\u88c5\u5c5e\u6027\u63d0\u5347\u3002</p><p class=\"bb_paragraph\" >\u25c7\u4e94\u884c\u89c9\u9192\uff1aPVP\u4e13\u5c5e\u5c5e\u6027\uff0c\u653b\u51fb\u6bd4\u4e94\u884c\u76f8\u514b\u7684\u5176\u4ed6\u73a9\u5bb6\uff0c\u5982\u679c\u5bf9\u65b9\u4e94\u884c\u7b49\u7ea7\u4f4e\u4e8e\u81ea\u8eab\uff0c\u5c06\u83b7\u5f97\u5c5e\u6027\u52a0\u6210\uff01</p><p class=\"bb_paragraph\" >\u25c7\u5251\u9b42\u5408\u6210\uff1a\u5251\u9b42\u4e0e\u76fe\u724c\u7684\u9ad8\u7ea7\u5408\u6210\u3002\u4f69\u6234\u5251\u9b42\u540e\u653b\u51fb\u65f6\u6709\u6982\u7387\u79d2\u6740\u602a\u7269\u4e00\u5b9a\u6bd4\u4f8b\u8840\u91cf\uff1b\u4f69\u6234\u76fe\u724c\u540e\u53ef\u4ee5\u5927\u5e45\u5ea6\u63d0\u5347\u9632\u5fa1\u80fd\u529b\u3002</p><p class=\"bb_paragraph\" >\u25c7\u7279\u6b8a\u94f8\u9020\uff1a\u53ef\u4ee5\u8fdb\u884c\u6597\u7b20\uff0c\u5723\u83b2\u4e0e\u8840\u77f3\u7684\u9ad8\u7ea7\u5408\u6210</p><p class=\"bb_paragraph\" >\u25c7\u5e78\u8fd0\u9879\u94fe\uff1a\u9879\u94fe\u6700\u9ad8\u53ef\u52a0\u5230\u5e78\u8fd03\uff0c\u73a9\u5bb6\u5168\u8eab\u6ee1\u5e78\u8fd0\u4e3a10\uff0c\u5e78\u8fd0max\u540e\u6bcf\u6b21\u90fd\u662f\u6700\u5927\u653b\u51fb\u6548\u679c</p><p class=\"bb_paragraph\" >\u25c7\u6982\u7387\u5370\u7ae0\uff1a\u8d8a\u9ad8\u7ea7\u7684\u5370\u7ae0\u5e26\u6765\u7684\u5c5e\u6027\u8d8a\u5f3a\u5927</p><p class=\"bb_paragraph\" >\u25c7\u6781\u54c1\u953b\u9020\uff1a\u628a\u88c5\u5907\u953b\u9020\u540e\uff0c\u53ef\u4ee5\u83b7\u5f97\u5f3a\u5927\u7684\u5c5e\u6027</p><p class=\"bb_paragraph\" >\u25c7\u6b66\u5668\u89e3\u5c01\uff1a\u628a\u6307\u5b9a\u6b66\u5668\u89e3\u5c01\u540e\uff0c\u6709\u6982\u7387\u83b7\u5f97\u66f4\u5f3a\u5927\u7684\u540c\u4e2a\u6b66\u5668</p><p class=\"bb_paragraph\" >\u25c7\u5c01\u53f7\u664b\u5347\uff1a\u664b\u5347\u540e\u53ef\u83b7\u5f97\u5929\u8d4b\u70b9\uff0c\u53ef\u81ea\u7531\u5206\u914d\u5230\u6240\u9700\u8981\u7684\u5c5e\u6027\u4e0a\uff0c\u5305\u62ec\u4e0d\u9650\u4e8e\u5bf9\u602a\u7684\u51fb\u6740\u80fd\u529b\uff0c\u6297\u51fb\u6253\u80fd\u529b\uff0c\u6389\u5b9d\u7387\u7b49</p><p class=\"bb_paragraph\" >\u25c7\u5b9d\u7269\u89c9\u9192\uff1a\u89c9\u9192\u5b9d\u7269\u540e\u80fd\u83b7\u5f97\u53ca\u5176\u5f3a\u5927\u7684\u5b9e\u529b\u63d0\u5347</p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" >\u3010\u6e38\u620f\u73a9\u6cd5\u3011</h2><p class=\"bb_paragraph\" >\u6e38\u620f\u4e13\u95e8\u4e3a\u5404\u4f4d\u73a9\u5bb6\u51c6\u5907\u4e86\u4e30\u5bcc\u7684\u5185\u5bb9\uff0c\u5305\u62ec\u6bcf\u65e5\u9650\u65f6\u6d3b\u52a8\u4e0e\u65e5\u5e38\u73a9\u6cd5\uff0c\u53ef\u4ee5\u5c3d\u60c5\u9886\u7565\u7ecf\u5178\u7684\u4f20\u5947\u73a9\u6cd5\u4e0e\u65b0\u9896\u7684MMO\u5185\u5bb9</p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u6bcf\u65e5\u6d3b\u52a8</p></li></ul><p class=\"bb_paragraph\" >\u25c7\u5947\u9047BOSS\uff1a\u6d3b\u52a8\u5730\u56fe\u5185\u968f\u673a\u5237\u65b0\u4e00\u4e2a\u5947\u9047BOSS\uff0c\u7206\u7387\u8d85\u9ad8\uff0c\u9002\u5408\u6253\u5b9d</p><p class=\"bb_paragraph\" >\u25c7\u5929\u964d\u8d22\u5b9d\uff1a\u6d3b\u52a8\u5f00\u59cb\u540e\uff0c\u571f\u57ce\u968f\u673a\u6389\u843d\u5927\u91cf\u5143\u5b9d</p><p class=\"bb_paragraph\" >\u25c7\u91d1\u732a\u9001\u793c\uff1a\u6d3b\u52a8\u5730\u56fe\u5185\u5c06\u5237\u65b0\u5927\u91cf\u91d1\u732a\uff0c\u51fb\u6740\u540e\u53ef\u4ee5\u83b7\u5f97\u7075\u7b26\u4e0e\u5143\u5b9d</p><p class=\"bb_paragraph\" >\u25c7\u593a\u5b9d\u5947\u5175\uff1a\u6d3b\u52a8\u5730\u56fe\u5185\u5237\u65b0\u591a\u5b9d\u9b54\u795e\uff0c\u51fb\u6740\u540e\u53ef\u4ee5\u83b7\u5f97\u5b9d\u7bb1\u4e0e\u9ad8\u7ea7\u88c5\u5907\uff0c\u5b88\u62a4\u5b9d\u7bb1200\u79d2\uff0c\u5c06\u83b7\u5f97\u7075\u7b2688+\u968f\u673a\u56fe\u9274</p><p class=\"bb_paragraph\" >\u25c7\u9b54\u9f99\u964d\u4e34\uff1a\u51fb\u6740\u6df7\u6c8c\u9b54\u9f99\uff0c\u6709\u6982\u7387\u83b7\u5f97\u5143\u5b9d\u4e0e\u9ad8\u7ea7\u88c5\u5907</p><p class=\"bb_paragraph\" >\u25c7\u8840\u8272\u90ca\u5916\uff1a\u6d3b\u52a8\u5f00\u59cb\u540e\uff0c\u5730\u56fe\u4e2d\u5237\u65b0\u5927\u91cf\u643a\u5e26\u5143\u5b9d\u7684\u602a\u7269\uff0c\u51fb\u6740\u540e\u53ef\u4ee5\u901f\u8bb0\u83b7\u5f97\u5927\u91cf\u5143\u5b9d</p><p class=\"bb_paragraph\" >\u25c7\u5929\u68af\u7ade\u6280\uff1a\u51fb\u6740\u5929\u68af\u602a\u53ef\u83b7\u5f9710-100\u79ef\u5206\uff0c\u51fb\u6740\u5176\u4ed6\u73a9\u5bb6\u53ef\u83b7\u5f9710-100\u79ef\u5206\uff0c\u79ef\u5206\u53ef\u5728\u5355\u72ec\u7684\u5546\u57ce\u8d2d\u4e70\u73cd\u60dc\u9053\u5177</p><p class=\"bb_paragraph\" >\u25c7\u6ce1\u70b9\u7075\u6c14\uff1a\u6d3b\u52a8\u671f\u95f4\u53ef\u5728\u6ce1\u70b9\u5730\u56fe\u83b7\u5f97\u7075\u6c14</p><p class=\"bb_paragraph\" >\u25c7\u6fc0\u60c5\u8dd1\u9177\uff1a\u6d3b\u52a8\u5f00\u542f\u540e\uff0c\u73a9\u5bb6\u5728\u571f\u57ce\u5b89\u5168\u533a\u8fdb\u884c\u8dd1\u52a8\u5373\u53ef\u968f\u673a\u83b7\u5f97\u5927\u91cf\u8d44\u6e90</p><p class=\"bb_paragraph\" >\u25c7\u7075\u6c14\u8c6a\u9001\uff1a\u6d3b\u52a8\u5730\u56fe\u4f1a\u5237\u65b0\u5927\u91cf\u7075\u6c14\u602a\u7269\uff0c\u6210\u529f\u51fb\u6740\u540e\u53ef\u83b7\u5f97\u5927\u91cf\u7075\u6c14\u503c</p><p class=\"bb_paragraph\" >\u25c7\u884c\u4f1a\u4e89\u9738\uff1a\u6210\u529f\u5360\u9886\u884c\u4f1a\u56fe\u817e\uff0c\u4f1a\u957f\u4e0e\u884c\u4f1a\u6210\u5458\u53ef\u83b7\u5f97\u5143\u5b9d\u4e0e\u7075\u7b26</p><p class=\"bb_paragraph\" ></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u65e5\u5e38\u73a9\u6cd5</p></li></ul><p class=\"bb_paragraph\" >\u25c7\u5251\u6307\u6c99\u57ce\uff1a\u653b\u5360\u6c99\u57ce\u4e4b\u540e\u53ef\u4ee5\u83b7\u5f97\u5927\u91cf\u7075\u7b26\u7684\u5956\u52b1\uff01\u7075\u7b26\u4e3a\u5145\u503c\u83b7\u53d6\u7684\u73cd\u8d35\u9053\u5177</p><p class=\"bb_paragraph\" >\u25c7\u9b54\u795e\u964d\u4e34\uff1a\u6bcf\u5929\u6709\u4e0d\u540c\u5c5e\u6027\u7684\u9b54\u795e\u53ef\u4ee5\u6311\u6218\uff0c\u6839\u636e\u4f24\u5bb3\u53ef\u4ee5\u83b7\u5f97\u5956\u52b1\uff0c\u83b7\u5f97\u524d5\u540d\u7684\u73a9\u5bb6\u8fd8\u53ef\u4ee5\u83b7\u5f97\u989d\u5916\u5956\u52b1</p><p class=\"bb_paragraph\" >\u25c7\u8bd5\u70bc\u4e4b\u5730\uff1a\u5206\u4e3a\u6218\u6cd5\u9053\u4e09\u7c7b\u8bd5\u70bc\uff0c\u901a\u5173\u540e\u6839\u636e\u51fb\u6740\u6570\u91cf\u53ef\u83b7\u5f97\u7075\u7b26\u4e0e\u5143\u5b9d\uff0c\u8fd8\u6709\u5bf9\u5e94\u7684\u6210\u5c31\u5956\u52b1\u53ef\u4ee5\u9886\u53d6</p><p class=\"bb_paragraph\" >\u25c7\u795e\u517d\u6218\u573a\uff1a\u73a9\u5bb6\u4eec\u4e00\u8d77\u4e89\u593a\u5237\u65b0\u7684\u795e\u517d\uff0c\u795e\u517d\u62e5\u6709\u8d85\u9ad8\u7684\u7206\u7387</p><p class=\"bb_paragraph\" >\u25c7\u8de8\u670d\u9886\u4e3b\uff1a\u51fb\u6740\u540e\u53ef\u4ee5\u83b7\u5f97\u5927\u91cf\u5143\u5b9d\uff0c\u7075\u7b26\uff0c\u88c5\u5907\u6750\u6599\u7b49\uff0c\u540c\u884c\u4f1a\u6210\u5458\u5747\u53ef\u62fe\u53d6</p><p class=\"bb_paragraph\" >\u25c7\u4e16\u754cBOSS\uff1a\u6bcf\u4e2a\u5927\u9646\u90fd\u62e5\u6709\u6781\u4e3a\u5f3a\u5927\u7684\u4e16\u754cBOSS\u53ef\u4ee5\u6311\u6218\uff0c\u4e16\u754cBOSS\u62e5\u6709\u5f53\u524d\u5927\u9646\u6700\u9ad8\u7684\u7206\u7387\uff0c\u5f53\u7136\u4e5f\u662f\u6700\u9ad8\u7684\u96be\u5ea6\uff01</p><p class=\"bb_paragraph\" >\u25c7\u9501\u5996\u5854\uff1a\u4e00\u517110\u5c42\uff0c\u7b49\u7ea7\u8d8a\u9ad8BOSS\u8d8a\u5f3a\u5927\uff0c\u7ec8\u6781BOSS\u6709\u6982\u7387\u6389\u843d\u6700\u9876\u7ea7\u88c5\u5907</p><p class=\"bb_paragraph\" >\u25c7\u4e2a\u4ebaBOSS\uff1a\u6bcf\u5929\u5747\u53ef\u6311\u6218\uff0cBOSS\u7b49\u7ea7\u4e0d\u540c\uff0c\u6389\u843d\u88c5\u5907\u6709\u6240\u4e0d\u540c</p><p class=\"bb_paragraph\" >\u25c7\u6311\u6218\u79d8\u5883\uff1a\u9700\u8981\u51fb\u67403\u6ce2\u602a\u7269\u624d\u7b97\u901a\u5173\u3002\u6709\u591a\u4e2a\u79d8\u5883\u53ef\u4ee5\u9009\u62e9\u3002</p><p class=\"bb_paragraph\" >\u25c7\u6076\u9b54\u5e7f\u573a\uff1a\u5206\u4e3a4\u4e2a\u7b49\u7ea7\uff0c\u5efa\u8bae\u7ec4\u961f\u8fdb\u5165\uff0c\u88c5\u5907\u6389\u7387\u8f83\u9ad8</p><p class=\"bb_paragraph\" >\u25c7\u5c01\u795e\u5854\u6311\u6218\uff1a\u53ef\u4ee5\u83b7\u5f97\u6240\u6709\u5b9d\u7269\u7684\u89c9\u9192\u6750\u6599\uff0c\u96be\u5ea6\u8d8a\u9ad8\u7206\u7387\u8d8a\u9ad8</p><p class=\"bb_paragraph\" >\u25c7\u739b\u6cd5\u5371\u673a\uff1a\u9ad8\u7206\u7387\u5730\u56fe\uff0c\u6240\u6709\u88c5\u5907\u5747\u6709\u53ef\u80fd\u83b7\u53d6</p><p class=\"bb_paragraph\" >\u25c7\u7075\u6c14\u5730\u56fe\uff1a\u5206\u4e3a\u4e09\u4e2a\u6863\u6b21\uff0c\u5143\u5b9d\u4e0e\u7075\u6c14\u7684\u83b7\u53d6\u662f\u5176\u4ed6\u91ce\u5916\u5730\u56fe\u7684\u51e0\u5341\u500d</p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" >\u3010\u4f20\u5947\u5927\u9646\u3011</h2><p class=\"bb_paragraph\" >\u6e38\u620f\u4e2d\u4e00\u5171\u6709\u4e94\u4e2a\u5927\u9646\uff0c\u6bcf\u4e2a\u5927\u9646\u90fd\u4f1a\u89e3\u9501\u5168\u65b0\u7684\u7cfb\u7edf\u4e0e\u73a9\u6cd5\u3002</p><p class=\"bb_paragraph\" >\u25c7\u7b2c\u4e00\u5927\u9646\uff1a\u73a9\u5bb6\u6700\u5f00\u59cb\u63a5\u89e6\u7684\u4e16\u754c\uff0c\u5c5e\u4e8e\u65b0\u624b\u6751\uff0c\u53ef\u4ee5\u63a5\u89e6\u5230\u5404\u7c7b\u6838\u5fc3\u7cfb\u7edf\u4e0e\u73a9\u6cd5</p><p class=\"bb_paragraph\" >\u25c7\u7b2c\u4e8c\u5927\u9646\uff1a60\u7ea7\u540e\u53ef\u4ee5\u524d\u5f80\uff0c\u73a9\u5bb6\u53ef\u4ee5\u5728\u8fd9\u91cc\u8fdb\u4e00\u6b65\u63d0\u5347\u4e2a\u4eba\u80fd\u529b\uff0c\u8fd8\u6709\u4f7f\u7528\u7075\u6c14\u5c06\u7b49\u7ea7\u7a81\u7834\u523070\u7ea7</p><p class=\"bb_paragraph\" >\u25c7\u7b2c\u4e09\u5927\u9646\uff1a70\u53ca\u540e\u53ef\u4ee5\u524d\u5f80\uff0c\u5c06\u89e3\u9501\u8f83\u591a\u7684\u65b0\u7cfb\u7edf</p><p class=\"bb_paragraph\" >\u25c7\u7b2c\u56db\u5927\u9646\uff1a\u5f00\u670d10\u5929\u540e\uff0c\u4e14\u6fc0\u6d3b\u4e86\u72c2\u66b4\u4e4b\u529b\u3002\u73a9\u5bb6\u9700\u8981\u5728\u8fd9\u91cc\u5927\u5e45\u5ea6\u63d0\u5347\u4e2a\u4eba\u80fd\u529b\uff0c\u5e76\u5c06\u7b49\u7ea7\u63d0\u5347\u523074\uff0c\u8fd9\u6837\u624d\u5177\u5907\u524d\u5f80\u7b2c\u4e94\u5927\u9646\u7684\u80fd\u529b</p><p class=\"bb_paragraph\" >\u25c7\u7b2c\u4e94\u5927\u9646\uff1a\u5f00\u670d30\u5929\uff0c\u4e14\u7b49\u7ea7\u572874\u7ea7\u4ee5\u4e0a\u3002\u5168\u65b0\u7684\u6311\u6218\uff0c\u5168\u65b0\u7684\u73a9\u6cd5\uff0c\u8fd9\u662f\u4f20\u5947\u4e16\u754c\u7684\u65b0\u8d77\u70b9\uff01</p>",
    "about_the_game": "<p class=\"bb_paragraph\" >\u7ecf\u51781.80\u7248\u91cd\u73b0\uff0c\u7ecf\u4e45\u4e0d\u8870\uff0c\u88c5\u5907\u65e0\u9650\u81ea\u7531\u6253\uff0c\u795e\u88c5\u6ee1\u5730\u7206\uff01\u5728\u8fd9\u6b3e\u539f\u6c41\u539f\u5473\u7684MMORPG\u6e38\u620f\u4e2d\uff0c\u4f60\u5c06\u4e0e\u540c\u4f34\u5c3d\u60c5\u5192\u9669\uff0c\u6210\u5c31\u4e00\u6bb5\u5f3a\u8005\u7684\u4f20\u5947\u6210\u957f\u4e4b\u8def\u3002</p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" >\u3010\u6e38\u620f\u7279\u8272\u3011</h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u7ecf\u5178\u4e09\u804c\u4e1a\u8bbe\u5b9a</p></li></ul><p class=\"bb_paragraph\" >\u25c7\u6218\u58eb\uff1a\u8fd1\u6218\u65e0\u654c\u4e00\u6837\u7684\u5b58\u5728\uff01\u70c8\u706b\u5251\u6cd5\uff0c\u9010\u65e5\u5251\u6cd5\uff0c\u5f00\u5929\u65a9\u8ba9\u4f60\u5982\u795e\u4e00\u822c\u5b58\u5728\uff01</p><p class=\"bb_paragraph\" >\u25c7\u9053\u58eb\uff1a\u4e0a\u7ebf\u53cc\u795e\u517d\uff0c\u53ef\u5347\u7ea7\u5230\u5723\u517d\u2014&gt;\u7075\u517d\u2014&gt;\u6708\u7075\u2014&gt;\u706b\u7075\u2014&gt;\u96f7\u7075\uff0c\u914d\u5408\u7fa4\u653b\u9053\u672f\u98d3\u98ce\u7834\u4e0e\u7fa4\u4f53\u65bd\u6bd2\u672f\uff0c\u53ef\u6311\u6218\u4efb\u4f55BOSS</p><p class=\"bb_paragraph\" >\u25c7\u6cd5\u5e08\uff1a\u64c5\u957f\u8fdc\u7a0b\u6cd5\u672f\u653b\u51fb\uff0c\u6d41\u661f\u706b\u96e8\u5237\u602a\u8d85\u723d\uff0c\u8bf1\u60d1\u4e4b\u5149\u53ef\u8bf1\u60d15\u53ea\u5b9d\u5b9d\uff0c\u795e\u6321\u6740\u795e\uff0c\u4f5b\u6321\u6740\u4f5b\uff01\u5ba0\u7269\u53ef\u5728\u5404\u5927\u4e3b\u57ce\u53ef\u5bfb\u627e\u5230\u3002</p><p class=\"bb_paragraph\" ></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u798f\u5229\u7cfb\u7edf</p></li></ul><p class=\"bb_paragraph\" >\u88c5\u5907\u5168\u9760\u6253\uff0c\u7075\u7b26\u5143\u5b9d\u5168\u90fd\u7206\uff01\u53ea\u8981\u662f\u6e38\u620f\u5185\u9700\u8981\u7528\u5230\u7684\u8d44\u6e90\uff0c\u5747\u53ef\u901a\u8fc7\u51fb\u6740BOSS\u3001\u53c2\u4e0e\u6d3b\u52a8\u6765\u83b7\u53d6\uff01\u8fd8\u4e13\u95e8\u4e3a\u5404\u4f4d\u73a9\u5bb6\u51c6\u5907\u4e86\u5404\u7c7b\u798f\u5229\u6d3b\u52a8\u3002</p><p class=\"bb_paragraph\" >\u25c7\u9996\u6740\u5956\u52b1\uff1a\u5b8c\u6210\u6240\u5728\u670d\u52a1\u5668\u6307\u5b9aBOSS\u7684\u9996\u4e2a\u51fb\u6740\uff0c\u53ef\u4ee5\u83b7\u5f97\u5956\u52b1</p><p class=\"bb_paragraph\" >\u25c7\u9996\u7206\u5956\u52b1\uff1a\u7b2c\u4e00\u4e2a\u6253\u5230\u6307\u5b9a\u88c5\u5907\u7684\u73a9\u5bb6\uff0c\u53ef\u4ee5\u83b7\u5f97\u5143\u5b9d\u4e0e\u771f\u5b9e\u5145\u503c\u5361\u5956\u52b1</p><p class=\"bb_paragraph\" >\u25c7\u5f15\u5bfc\u4efb\u52a1\uff1a\u5b8c\u6210\u540e\u53ef\u83b7\u5f97\u5f3a\u529b\u7684\u5c5e\u6027\u52a0\u6210</p><p class=\"bb_paragraph\" >\u25c7\u5386\u7ec3\u4efb\u52a1\uff1a\u51fb\u6740\u6307\u5b9aBOSS\uff0c\u53ef\u83b7\u5f97\u5200\u5200\u5207\u5272\u4f24\u5bb3\u63d0\u5347</p><p class=\"bb_paragraph\" >\u25c7\u4e03\u65e5\u8c6a\u793c\uff1a\u6bcf\u65e5\u9886\u53d6\u5927\u91cf\u793c\u7269\uff0c\u8fd8\u6709\u771f\u5b9e\u5145\u503c\u5361\u53ef\u4ee5\u83b7\u53d6\u5230</p><p class=\"bb_paragraph\" >\u25c7\u6bcf\u65e5\u6276\u6301\uff1a\u53ef\u83b7\u5f97\u5927\u91cf\u5956\u52b1</p><p class=\"bb_paragraph\" >\u25c7\u6276\u6301\u6708\u5361\uff1a\u6bcf\u65e5\u514d\u8d39\u9886\u53d6\u5404\u7c7b\u8d44\u6e90</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\u6e38\u620f\u7cfb\u7edf</p><p class=\"bb_paragraph\" >\u25c7\u6280\u80fd\u5927\u5e08\uff1a\u53ef\u4ee5\u5f3a\u5316\u73b0\u6709\u6280\u80fd\u4e0e\u5b66\u4e60\u9ad8\u7ea7\u6280\u80fd</p><p class=\"bb_paragraph\" >\u25c7\u79d8\u5b9d\u7cfb\u7edf\uff1a\u5e26\u4e0a\u540e\u53ef\u4ee5\u5728\u653b\u51fb\u8fc7\u7a0b\u4e2d\u4e00\u5b9a\u6982\u7387\u89e6\u53d1\u7279\u6b8a\u6548\u679c\uff0c\u4f8b\u5982\u4f24\u5bb3\u63d0\u5347\u7b49</p><p class=\"bb_paragraph\" >\u25c7\u795e\u88c5\u5750\u9a91\uff1a\u62e5\u6709\u5750\u9a91\u540e\uff0c\u53ef\u4ee5\u83b7\u5f97\u9ad8\u901f\u884c\u9a76\u7684\u80fd\u529b</p><p class=\"bb_paragraph\" >\u25c7\u795e\u5a01\u5927\u5e08\uff1a\u6709\u591a\u4e2a\u795e\u5a01\u80fd\u529b\u53ef\u4ee5\u63d0\u5347\uff0c\u6bcf\u4e2a\u795e\u5a01\u90fd\u6709\u72ec\u7279\u7684\u529f\u80fd</p><p class=\"bb_paragraph\" >\u25c7\u5f02\u517d\u5f55\uff1a\u5206\u4e3a\u4f18\u79c0\u3001\u7a00\u6709\u3001\u53f2\u8bd7\u3001\u4f20\u8bf4\u3001\u795e\u8bdd\u4e94\u4e2a\u7b49\u7ea7\u7684\u5c71\u6d77\u7ecf\u5f02\u517d\uff1b\u5355\u4e2a\u5f02\u517d\u56fe\u9274\u7b49\u7ea7\u63d0\u5347\uff0c\u53ef\u4ee5\u83b7\u5f97\u5c5e\u6027\u4e0a\u7684\u63d0\u5347\uff0c\u5f62\u6210\u5361\u7ec4\u7f81\u7eca\u6548\u679c\u4e4b\u540e\u8fd8\u6709\u989d\u5916\u7684\u5957\u88c5\u5c5e\u6027\u63d0\u5347\u3002</p><p class=\"bb_paragraph\" >\u25c7\u4e94\u884c\u89c9\u9192\uff1aPVP\u4e13\u5c5e\u5c5e\u6027\uff0c\u653b\u51fb\u6bd4\u4e94\u884c\u76f8\u514b\u7684\u5176\u4ed6\u73a9\u5bb6\uff0c\u5982\u679c\u5bf9\u65b9\u4e94\u884c\u7b49\u7ea7\u4f4e\u4e8e\u81ea\u8eab\uff0c\u5c06\u83b7\u5f97\u5c5e\u6027\u52a0\u6210\uff01</p><p class=\"bb_paragraph\" >\u25c7\u5251\u9b42\u5408\u6210\uff1a\u5251\u9b42\u4e0e\u76fe\u724c\u7684\u9ad8\u7ea7\u5408\u6210\u3002\u4f69\u6234\u5251\u9b42\u540e\u653b\u51fb\u65f6\u6709\u6982\u7387\u79d2\u6740\u602a\u7269\u4e00\u5b9a\u6bd4\u4f8b\u8840\u91cf\uff1b\u4f69\u6234\u76fe\u724c\u540e\u53ef\u4ee5\u5927\u5e45\u5ea6\u63d0\u5347\u9632\u5fa1\u80fd\u529b\u3002</p><p class=\"bb_paragraph\" >\u25c7\u7279\u6b8a\u94f8\u9020\uff1a\u53ef\u4ee5\u8fdb\u884c\u6597\u7b20\uff0c\u5723\u83b2\u4e0e\u8840\u77f3\u7684\u9ad8\u7ea7\u5408\u6210</p><p class=\"bb_paragraph\" >\u25c7\u5e78\u8fd0\u9879\u94fe\uff1a\u9879\u94fe\u6700\u9ad8\u53ef\u52a0\u5230\u5e78\u8fd03\uff0c\u73a9\u5bb6\u5168\u8eab\u6ee1\u5e78\u8fd0\u4e3a10\uff0c\u5e78\u8fd0max\u540e\u6bcf\u6b21\u90fd\u662f\u6700\u5927\u653b\u51fb\u6548\u679c</p><p class=\"bb_paragraph\" >\u25c7\u6982\u7387\u5370\u7ae0\uff1a\u8d8a\u9ad8\u7ea7\u7684\u5370\u7ae0\u5e26\u6765\u7684\u5c5e\u6027\u8d8a\u5f3a\u5927</p><p class=\"bb_paragraph\" >\u25c7\u6781\u54c1\u953b\u9020\uff1a\u628a\u88c5\u5907\u953b\u9020\u540e\uff0c\u53ef\u4ee5\u83b7\u5f97\u5f3a\u5927\u7684\u5c5e\u6027</p><p class=\"bb_paragraph\" >\u25c7\u6b66\u5668\u89e3\u5c01\uff1a\u628a\u6307\u5b9a\u6b66\u5668\u89e3\u5c01\u540e\uff0c\u6709\u6982\u7387\u83b7\u5f97\u66f4\u5f3a\u5927\u7684\u540c\u4e2a\u6b66\u5668</p><p class=\"bb_paragraph\" >\u25c7\u5c01\u53f7\u664b\u5347\uff1a\u664b\u5347\u540e\u53ef\u83b7\u5f97\u5929\u8d4b\u70b9\uff0c\u53ef\u81ea\u7531\u5206\u914d\u5230\u6240\u9700\u8981\u7684\u5c5e\u6027\u4e0a\uff0c\u5305\u62ec\u4e0d\u9650\u4e8e\u5bf9\u602a\u7684\u51fb\u6740\u80fd\u529b\uff0c\u6297\u51fb\u6253\u80fd\u529b\uff0c\u6389\u5b9d\u7387\u7b49</p><p class=\"bb_paragraph\" >\u25c7\u5b9d\u7269\u89c9\u9192\uff1a\u89c9\u9192\u5b9d\u7269\u540e\u80fd\u83b7\u5f97\u53ca\u5176\u5f3a\u5927\u7684\u5b9e\u529b\u63d0\u5347</p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" >\u3010\u6e38\u620f\u73a9\u6cd5\u3011</h2><p class=\"bb_paragraph\" >\u6e38\u620f\u4e13\u95e8\u4e3a\u5404\u4f4d\u73a9\u5bb6\u51c6\u5907\u4e86\u4e30\u5bcc\u7684\u5185\u5bb9\uff0c\u5305\u62ec\u6bcf\u65e5\u9650\u65f6\u6d3b\u52a8\u4e0e\u65e5\u5e38\u73a9\u6cd5\uff0c\u53ef\u4ee5\u5c3d\u60c5\u9886\u7565\u7ecf\u5178\u7684\u4f20\u5947\u73a9\u6cd5\u4e0e\u65b0\u9896\u7684MMO\u5185\u5bb9</p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u6bcf\u65e5\u6d3b\u52a8</p></li></ul><p class=\"bb_paragraph\" >\u25c7\u5947\u9047BOSS\uff1a\u6d3b\u52a8\u5730\u56fe\u5185\u968f\u673a\u5237\u65b0\u4e00\u4e2a\u5947\u9047BOSS\uff0c\u7206\u7387\u8d85\u9ad8\uff0c\u9002\u5408\u6253\u5b9d</p><p class=\"bb_paragraph\" >\u25c7\u5929\u964d\u8d22\u5b9d\uff1a\u6d3b\u52a8\u5f00\u59cb\u540e\uff0c\u571f\u57ce\u968f\u673a\u6389\u843d\u5927\u91cf\u5143\u5b9d</p><p class=\"bb_paragraph\" >\u25c7\u91d1\u732a\u9001\u793c\uff1a\u6d3b\u52a8\u5730\u56fe\u5185\u5c06\u5237\u65b0\u5927\u91cf\u91d1\u732a\uff0c\u51fb\u6740\u540e\u53ef\u4ee5\u83b7\u5f97\u7075\u7b26\u4e0e\u5143\u5b9d</p><p class=\"bb_paragraph\" >\u25c7\u593a\u5b9d\u5947\u5175\uff1a\u6d3b\u52a8\u5730\u56fe\u5185\u5237\u65b0\u591a\u5b9d\u9b54\u795e\uff0c\u51fb\u6740\u540e\u53ef\u4ee5\u83b7\u5f97\u5b9d\u7bb1\u4e0e\u9ad8\u7ea7\u88c5\u5907\uff0c\u5b88\u62a4\u5b9d\u7bb1200\u79d2\uff0c\u5c06\u83b7\u5f97\u7075\u7b2688+\u968f\u673a\u56fe\u9274</p><p class=\"bb_paragraph\" >\u25c7\u9b54\u9f99\u964d\u4e34\uff1a\u51fb\u6740\u6df7\u6c8c\u9b54\u9f99\uff0c\u6709\u6982\u7387\u83b7\u5f97\u5143\u5b9d\u4e0e\u9ad8\u7ea7\u88c5\u5907</p><p class=\"bb_paragraph\" >\u25c7\u8840\u8272\u90ca\u5916\uff1a\u6d3b\u52a8\u5f00\u59cb\u540e\uff0c\u5730\u56fe\u4e2d\u5237\u65b0\u5927\u91cf\u643a\u5e26\u5143\u5b9d\u7684\u602a\u7269\uff0c\u51fb\u6740\u540e\u53ef\u4ee5\u901f\u8bb0\u83b7\u5f97\u5927\u91cf\u5143\u5b9d</p><p class=\"bb_paragraph\" >\u25c7\u5929\u68af\u7ade\u6280\uff1a\u51fb\u6740\u5929\u68af\u602a\u53ef\u83b7\u5f9710-100\u79ef\u5206\uff0c\u51fb\u6740\u5176\u4ed6\u73a9\u5bb6\u53ef\u83b7\u5f9710-100\u79ef\u5206\uff0c\u79ef\u5206\u53ef\u5728\u5355\u72ec\u7684\u5546\u57ce\u8d2d\u4e70\u73cd\u60dc\u9053\u5177</p><p class=\"bb_paragraph\" >\u25c7\u6ce1\u70b9\u7075\u6c14\uff1a\u6d3b\u52a8\u671f\u95f4\u53ef\u5728\u6ce1\u70b9\u5730\u56fe\u83b7\u5f97\u7075\u6c14</p><p class=\"bb_paragraph\" >\u25c7\u6fc0\u60c5\u8dd1\u9177\uff1a\u6d3b\u52a8\u5f00\u542f\u540e\uff0c\u73a9\u5bb6\u5728\u571f\u57ce\u5b89\u5168\u533a\u8fdb\u884c\u8dd1\u52a8\u5373\u53ef\u968f\u673a\u83b7\u5f97\u5927\u91cf\u8d44\u6e90</p><p class=\"bb_paragraph\" >\u25c7\u7075\u6c14\u8c6a\u9001\uff1a\u6d3b\u52a8\u5730\u56fe\u4f1a\u5237\u65b0\u5927\u91cf\u7075\u6c14\u602a\u7269\uff0c\u6210\u529f\u51fb\u6740\u540e\u53ef\u83b7\u5f97\u5927\u91cf\u7075\u6c14\u503c</p><p class=\"bb_paragraph\" >\u25c7\u884c\u4f1a\u4e89\u9738\uff1a\u6210\u529f\u5360\u9886\u884c\u4f1a\u56fe\u817e\uff0c\u4f1a\u957f\u4e0e\u884c\u4f1a\u6210\u5458\u53ef\u83b7\u5f97\u5143\u5b9d\u4e0e\u7075\u7b26</p><p class=\"bb_paragraph\" ></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u65e5\u5e38\u73a9\u6cd5</p></li></ul><p class=\"bb_paragraph\" >\u25c7\u5251\u6307\u6c99\u57ce\uff1a\u653b\u5360\u6c99\u57ce\u4e4b\u540e\u53ef\u4ee5\u83b7\u5f97\u5927\u91cf\u7075\u7b26\u7684\u5956\u52b1\uff01\u7075\u7b26\u4e3a\u5145\u503c\u83b7\u53d6\u7684\u73cd\u8d35\u9053\u5177</p><p class=\"bb_paragraph\" >\u25c7\u9b54\u795e\u964d\u4e34\uff1a\u6bcf\u5929\u6709\u4e0d\u540c\u5c5e\u6027\u7684\u9b54\u795e\u53ef\u4ee5\u6311\u6218\uff0c\u6839\u636e\u4f24\u5bb3\u53ef\u4ee5\u83b7\u5f97\u5956\u52b1\uff0c\u83b7\u5f97\u524d5\u540d\u7684\u73a9\u5bb6\u8fd8\u53ef\u4ee5\u83b7\u5f97\u989d\u5916\u5956\u52b1</p><p class=\"bb_paragraph\" >\u25c7\u8bd5\u70bc\u4e4b\u5730\uff1a\u5206\u4e3a\u6218\u6cd5\u9053\u4e09\u7c7b\u8bd5\u70bc\uff0c\u901a\u5173\u540e\u6839\u636e\u51fb\u6740\u6570\u91cf\u53ef\u83b7\u5f97\u7075\u7b26\u4e0e\u5143\u5b9d\uff0c\u8fd8\u6709\u5bf9\u5e94\u7684\u6210\u5c31\u5956\u52b1\u53ef\u4ee5\u9886\u53d6</p><p class=\"bb_paragraph\" >\u25c7\u795e\u517d\u6218\u573a\uff1a\u73a9\u5bb6\u4eec\u4e00\u8d77\u4e89\u593a\u5237\u65b0\u7684\u795e\u517d\uff0c\u795e\u517d\u62e5\u6709\u8d85\u9ad8\u7684\u7206\u7387</p><p class=\"bb_paragraph\" >\u25c7\u8de8\u670d\u9886\u4e3b\uff1a\u51fb\u6740\u540e\u53ef\u4ee5\u83b7\u5f97\u5927\u91cf\u5143\u5b9d\uff0c\u7075\u7b26\uff0c\u88c5\u5907\u6750\u6599\u7b49\uff0c\u540c\u884c\u4f1a\u6210\u5458\u5747\u53ef\u62fe\u53d6</p><p class=\"bb_paragraph\" >\u25c7\u4e16\u754cBOSS\uff1a\u6bcf\u4e2a\u5927\u9646\u90fd\u62e5\u6709\u6781\u4e3a\u5f3a\u5927\u7684\u4e16\u754cBOSS\u53ef\u4ee5\u6311\u6218\uff0c\u4e16\u754cBOSS\u62e5\u6709\u5f53\u524d\u5927\u9646\u6700\u9ad8\u7684\u7206\u7387\uff0c\u5f53\u7136\u4e5f\u662f\u6700\u9ad8\u7684\u96be\u5ea6\uff01</p><p class=\"bb_paragraph\" >\u25c7\u9501\u5996\u5854\uff1a\u4e00\u517110\u5c42\uff0c\u7b49\u7ea7\u8d8a\u9ad8BOSS\u8d8a\u5f3a\u5927\uff0c\u7ec8\u6781BOSS\u6709\u6982\u7387\u6389\u843d\u6700\u9876\u7ea7\u88c5\u5907</p><p class=\"bb_paragraph\" >\u25c7\u4e2a\u4ebaBOSS\uff1a\u6bcf\u5929\u5747\u53ef\u6311\u6218\uff0cBOSS\u7b49\u7ea7\u4e0d\u540c\uff0c\u6389\u843d\u88c5\u5907\u6709\u6240\u4e0d\u540c</p><p class=\"bb_paragraph\" >\u25c7\u6311\u6218\u79d8\u5883\uff1a\u9700\u8981\u51fb\u67403\u6ce2\u602a\u7269\u624d\u7b97\u901a\u5173\u3002\u6709\u591a\u4e2a\u79d8\u5883\u53ef\u4ee5\u9009\u62e9\u3002</p><p class=\"bb_paragraph\" >\u25c7\u6076\u9b54\u5e7f\u573a\uff1a\u5206\u4e3a4\u4e2a\u7b49\u7ea7\uff0c\u5efa\u8bae\u7ec4\u961f\u8fdb\u5165\uff0c\u88c5\u5907\u6389\u7387\u8f83\u9ad8</p><p class=\"bb_paragraph\" >\u25c7\u5c01\u795e\u5854\u6311\u6218\uff1a\u53ef\u4ee5\u83b7\u5f97\u6240\u6709\u5b9d\u7269\u7684\u89c9\u9192\u6750\u6599\uff0c\u96be\u5ea6\u8d8a\u9ad8\u7206\u7387\u8d8a\u9ad8</p><p class=\"bb_paragraph\" >\u25c7\u739b\u6cd5\u5371\u673a\uff1a\u9ad8\u7206\u7387\u5730\u56fe\uff0c\u6240\u6709\u88c5\u5907\u5747\u6709\u53ef\u80fd\u83b7\u53d6</p><p class=\"bb_paragraph\" >\u25c7\u7075\u6c14\u5730\u56fe\uff1a\u5206\u4e3a\u4e09\u4e2a\u6863\u6b21\uff0c\u5143\u5b9d\u4e0e\u7075\u6c14\u7684\u83b7\u53d6\u662f\u5176\u4ed6\u91ce\u5916\u5730\u56fe\u7684\u51e0\u5341\u500d</p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" >\u3010\u4f20\u5947\u5927\u9646\u3011</h2><p class=\"bb_paragraph\" >\u6e38\u620f\u4e2d\u4e00\u5171\u6709\u4e94\u4e2a\u5927\u9646\uff0c\u6bcf\u4e2a\u5927\u9646\u90fd\u4f1a\u89e3\u9501\u5168\u65b0\u7684\u7cfb\u7edf\u4e0e\u73a9\u6cd5\u3002</p><p class=\"bb_paragraph\" >\u25c7\u7b2c\u4e00\u5927\u9646\uff1a\u73a9\u5bb6\u6700\u5f00\u59cb\u63a5\u89e6\u7684\u4e16\u754c\uff0c\u5c5e\u4e8e\u65b0\u624b\u6751\uff0c\u53ef\u4ee5\u63a5\u89e6\u5230\u5404\u7c7b\u6838\u5fc3\u7cfb\u7edf\u4e0e\u73a9\u6cd5</p><p class=\"bb_paragraph\" >\u25c7\u7b2c\u4e8c\u5927\u9646\uff1a60\u7ea7\u540e\u53ef\u4ee5\u524d\u5f80\uff0c\u73a9\u5bb6\u53ef\u4ee5\u5728\u8fd9\u91cc\u8fdb\u4e00\u6b65\u63d0\u5347\u4e2a\u4eba\u80fd\u529b\uff0c\u8fd8\u6709\u4f7f\u7528\u7075\u6c14\u5c06\u7b49\u7ea7\u7a81\u7834\u523070\u7ea7</p><p class=\"bb_paragraph\" >\u25c7\u7b2c\u4e09\u5927\u9646\uff1a70\u53ca\u540e\u53ef\u4ee5\u524d\u5f80\uff0c\u5c06\u89e3\u9501\u8f83\u591a\u7684\u65b0\u7cfb\u7edf</p><p class=\"bb_paragraph\" >\u25c7\u7b2c\u56db\u5927\u9646\uff1a\u5f00\u670d10\u5929\u540e\uff0c\u4e14\u6fc0\u6d3b\u4e86\u72c2\u66b4\u4e4b\u529b\u3002\u73a9\u5bb6\u9700\u8981\u5728\u8fd9\u91cc\u5927\u5e45\u5ea6\u63d0\u5347\u4e2a\u4eba\u80fd\u529b\uff0c\u5e76\u5c06\u7b49\u7ea7\u63d0\u5347\u523074\uff0c\u8fd9\u6837\u624d\u5177\u5907\u524d\u5f80\u7b2c\u4e94\u5927\u9646\u7684\u80fd\u529b</p><p class=\"bb_paragraph\" >\u25c7\u7b2c\u4e94\u5927\u9646\uff1a\u5f00\u670d30\u5929\uff0c\u4e14\u7b49\u7ea7\u572874\u7ea7\u4ee5\u4e0a\u3002\u5168\u65b0\u7684\u6311\u6218\uff0c\u5168\u65b0\u7684\u73a9\u6cd5\uff0c\u8fd9\u662f\u4f20\u5947\u4e16\u754c\u7684\u65b0\u8d77\u70b9\uff01</p>",
    "short_description": "\u7ecf\u51781.80\u7248\u91cd\u73b0\uff0c\u7ecf\u4e45\u4e0d\u8870\uff0c\u88c5\u5907\u65e0\u9650\u81ea\u7531\u6253\uff0c\u795e\u88c5\u6ee1\u5730\u7206\uff01\u5728\u8fd9\u6b3e\u539f\u6c41\u539f\u5473\u7684MMORPG\u6e38\u620f\u4e2d\uff0c\u4f60\u5c06\u4e0e\u540c\u4f34\u5c3d\u60c5\u5192\u9669\uff0c\u6210\u5c31\u4e00\u6bb5\u5f3a\u8005\u7684\u4f20\u5947\u6210\u957f\u4e4b\u8def\u3002",
