{
    "type": "game",
    "name": "\u6c99\u76d8\u6218\u4e89\uff1a\u4e09\u56fd",
    "steam_appid": 3885930,
    "required_age": 0,
    "is_free": false,
    "detailed_description": "<p class=\"bb_paragraph\" ><strong>\u5b98\u65b9\u4ea4\u6d41QQ\u4e00\u7fa4\uff1a912495951(\u5df2\u6ee1) \u4e8c\u7fa4\uff1a1054806466\u00a0\u8fdb\u7fa4\u62a2\u5148\u4f53\u9a8cDemo\uff01</strong></p><p class=\"bb_paragraph\" ><strong>\u5c0f\u9ed1\u76d2\u3001B\u7ad9\u3001Taptap\u5b98\u65b9\u8d26\u53f7\uff1a\u53e4\u73a9\u5de5\u4f5c\u5ba4</strong></p><p class=\"bb_paragraph\" >\u6e38\u620f\u76ee\u524d\u4ecd\u5904\u4e8e\u5f00\u53d1\u9636\u6bb5\uff0c\u5982\u679c\u60a8\u9047\u5230\u4e00\u4e9b\u95ee\u9898\u6216\u6709\u4efb\u4f55\u610f\u89c1\u5efa\u8bae\uff0c\u53ef\u4ee5\u4ece\u4e0a\u8ff0\u6e20\u9053\u8fdb\u884c\u4ea4\u6d41\u53cd\u9988\uff0c\u6211\u4eec\u4f1a\u8ba4\u771f\u503e\u542c\u6bcf\u4e00\u4f4d\u73a9\u5bb6\u7684\u58f0\u97f3\uff01</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3885930/extras/780c50f32f12feae84f6b3631c0647b3.avif?t=1754888475\" width=480 height=270 /></span></p><p class=\"bb_paragraph\" >\u300a\u6c99\u76d8\u6218\u4e89\uff1a\u4e09\u56fd\u300b\u662f\u4e00\u6b3e\u8bbe\u5b9a\u5728\u4e09\u56fd\u65f6\u671f\u7684\u6218\u7565\u6a21\u62df\u6e38\u620f\uff0c\u5728\u8fd9\u91cc\u4f60\u53ef\u4ee5\u626e\u6f14\u4e09\u56fd\u5386\u53f2\u4e0a\u7684\u5404\u79cd\u52bf\u529b\u653b\u57ce\u7565\u5730\uff0c\u7edf\u4e00\u5929\u4e0b\u3002\u4e30\u5bcc\u7684\u5386\u53f2\u6b66\u5c06\u548c\u5267\u672c\uff0c\u684c\u6e38\u822c\u7684\u4f53\u9a8c\uff0c\u5feb\u6765\u5174\u590d\u6c49\u5ba4\u5427\uff01</p><h2 class=\"bb_tag\" ><strong>\u6e38\u620f\u7279\u8272</strong></h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >160+\u5730\u533a\u57ce\u6c60\uff0c\u5927\u6218\u7565\u5730\u56fe\u4f9b\u60a8\u5f81\u4f10</p></li></ul><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >400+\u5386\u53f2\u6b66\u5c06\uff0c\u4e0a\u767e\u79cd\u4e30\u5bcc\u7684\u7279\u6027\uff0c\u62db\u52df\u548c\u4efb\u547d\u6b66\u5c06\uff0c\u52a0\u5feb\u57ce\u6c60\u53d1\u5c55\u901f\u5ea6</p></li><li><p class=\"bb_paragraph\" >100+\u7269\u54c1\u88c5\u5907\uff0c\u63d0\u9ad8\u6b66\u5c06\u7684\u5c5e\u6027\u548c\u80fd\u529b</p></li><li><p class=\"bb_paragraph\" >20+\u5730\u533a\u5efa\u7b51\uff0c\u5efa\u9020\u53d1\u5c55\u751f\u4ea7\u529b</p></li><li><p class=\"bb_paragraph\" >10+\u53ef\u9009\u62e9\u52bf\u529b\uff0c\u7279\u8272\u9c9c\u660e\u73a9\u6cd5\u591a\u6837</p></li><li><p class=\"bb_paragraph\" >\u591a\u4e2a\u5386\u53f2\u5267\u672c\uff0c\u589e\u52a0\u5386\u53f2\u4ee3\u5165\u611f</p></li><li><p class=\"bb_paragraph\" >\u7ba1\u7406\u5730\u533a\u5185\u653f\u548c\u519b\u653f\uff0c\u8c03\u6574\u8d4b\u7a0e\u548c\u5175\u5f79\uff0c\u5e73\u8861\u4ea7\u51fa\u548c\u6cbb\u5b89</p></li><li><p class=\"bb_paragraph\" >\u53d1\u5c55\u83b7\u5f97\u653f\u4ee4\uff0c\u4e0d\u65ad\u63d0\u5347\u548c\u52a0\u5f3a\u52bf\u529b</p></li><li><p class=\"bb_paragraph\" >\u5728\u5408\u9002\u7684\u65f6\u673a\u6267\u884c\u79d8\u7b56\uff0c\u6539\u53d8\u6218\u5c40</p></li></ul>",
    "about_the_game": "<p class=\"bb_paragraph\" ><strong>\u5b98\u65b9\u4ea4\u6d41QQ\u4e00\u7fa4\uff1a912495951(\u5df2\u6ee1) \u4e8c\u7fa4\uff1a1054806466\u00a0\u8fdb\u7fa4\u62a2\u5148\u4f53\u9a8cDemo\uff01</strong></p><p class=\"bb_paragraph\" ><strong>\u5c0f\u9ed1\u76d2\u3001B\u7ad9\u3001Taptap\u5b98\u65b9\u8d26\u53f7\uff1a\u53e4\u73a9\u5de5\u4f5c\u5ba4</strong></p><p class=\"bb_paragraph\" >\u6e38\u620f\u76ee\u524d\u4ecd\u5904\u4e8e\u5f00\u53d1\u9636\u6bb5\uff0c\u5982\u679c\u60a8\u9047\u5230\u4e00\u4e9b\u95ee\u9898\u6216\u6709\u4efb\u4f55\u610f\u89c1\u5efa\u8bae\uff0c\u53ef\u4ee5\u4ece\u4e0a\u8ff0\u6e20\u9053\u8fdb\u884c\u4ea4\u6d41\u53cd\u9988\uff0c\u6211\u4eec\u4f1a\u8ba4\u771f\u503e\u542c\u6bcf\u4e00\u4f4d\u73a9\u5bb6\u7684\u58f0\u97f3\uff01</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3885930/extras/780c50f32f12feae84f6b3631c0647b3.avif?t=1754888475\" width=480 height=270 /></span></p><p class=\"bb_paragraph\" >\u300a\u6c99\u76d8\u6218\u4e89\uff1a\u4e09\u56fd\u300b\u662f\u4e00\u6b3e\u8bbe\u5b9a\u5728\u4e09\u56fd\u65f6\u671f\u7684\u6218\u7565\u6a21\u62df\u6e38\u620f\uff0c\u5728\u8fd9\u91cc\u4f60\u53ef\u4ee5\u626e\u6f14\u4e09\u56fd\u5386\u53f2\u4e0a\u7684\u5404\u79cd\u52bf\u529b\u653b\u57ce\u7565\u5730\uff0c\u7edf\u4e00\u5929\u4e0b\u3002\u4e30\u5bcc\u7684\u5386\u53f2\u6b66\u5c06\u548c\u5267\u672c\uff0c\u684c\u6e38\u822c\u7684\u4f53\u9a8c\uff0c\u5feb\u6765\u5174\u590d\u6c49\u5ba4\u5427\uff01</p><h2 class=\"bb_tag\" ><strong>\u6e38\u620f\u7279\u8272</strong></h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >160+\u5730\u533a\u57ce\u6c60\uff0c\u5927\u6218\u7565\u5730\u56fe\u4f9b\u60a8\u5f81\u4f10</p></li></ul><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >400+\u5386\u53f2\u6b66\u5c06\uff0c\u4e0a\u767e\u79cd\u4e30\u5bcc\u7684\u7279\u6027\uff0c\u62db\u52df\u548c\u4efb\u547d\u6b66\u5c06\uff0c\u52a0\u5feb\u57ce\u6c60\u53d1\u