mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2342690/extras/bbd47c18e4a9a1fcd173dfcf67a58e0f.poster.avif?t=1744553284\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2342690/extras/bbd47c18e4a9a1fcd173dfcf67a58e0f.webm?t=1744553284\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2342690/extras/bbd47c18e4a9a1fcd173dfcf67a58e0f.mp4?t=1744553284\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p>",
