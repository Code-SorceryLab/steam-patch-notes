    "detailed_description": "<p class=\"bb_paragraph\" >\u4e0d\u601d\u8b70\u306a\u4e16\u754c\u306e\u89b3\u5149\u65e5\u8a18\u7b2c\uff12\u5f3e\uff01\u3000</p><p class=\"bb_paragraph\" >\u524d\u56de\u306f\u30af\u30ea\u30a2\u307e\u306750\u6642\u9593\u304b\u304b\u3063\u3066</p><p class=\"bb_paragraph\" >\u30af\u30ea\u30a2\u51fa\u6765\u305f\u4eba\u304c10\u4eba\u306b\uff11\u4eba\u3067\u3057\u305f\u304c\u3001</p><p class=\"bb_paragraph\" >\u4eca\u56de\u306f\uff13\u6642\u9593\u304f\u3089\u3044\u3067\u30b5\u30af\u30c3\u3068\u904a\u3079\u308b\u304a\u624b\u8efd\u30b2\u30fc\u30e0\u306b\u3057\u307e\u3057\u305f\uff01\u3081\u3067\u305f\u3044\uff01</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\u30b9\u30c8\u30fc\u30ea\u30fc\u306f\u6b21\u56de\u4f5c\u3001</p><p class=\"bb_paragraph\" >\uff13\u4f5c\u76ee\u306e\u300e\u3072\u3088\u306e\u304a\u5b9d\u5927\u5192\u967a\u300f\u306e\u6d3b\u8e8d\u306b\u3088\u3063\u3066</p><p class=\"bb_paragraph\" >\u4e3b\u4eba\u516c\u306e\u30ca\u30ca\u30ca\u306e\u4f5c\u3063\u3066\u3044\u308b</p><p class=\"bb_paragraph\" >\u300c\u4e0d\u601d\u8b70\u306a\u4e16\u754c\u306e\u89b3\u5149\u65e5\u8a18\u300d\u3068\u3044\u3046\u4f5c\u54c1\u304c</p><p class=\"bb_paragraph\" >\u30b2\u30fc\u30e0\u306b\u306a\u308a\u307e\u3057\u305f\u3002</p><p class=\"bb_paragraph\" >\u4eca\u65e5\u306f\u305d\u308c\u3092\u30d7\u30ec\u30a4\u3057\u3088\u3046\uff01</p><p class=\"bb_paragraph\" >\u3068\u30ca\u30ca\u30ca\u3068\u3072\u3088\u304c</p><p class=\"bb_paragraph\" >\u30b2\u30fc\u30e0\u5185\u3067\u81ea\u5206\u306e\u4f5c\u54c1\u306e\u30b2\u30fc\u30e0\u3092\u3057\u3066\u3044\u304f\u6240\u304b\u3089</p><p class=\"bb_paragraph\" >\u7269\u8a9e\u304c\u59cb\u307e\u3063\u3066\u3044\u304d\u307e\u3059\u3002</p><p class=\"bb_paragraph\" >\u2026\u8aac\u660e\u304c\u5206\u304b\u308a\u306b\u304f\u3044\u3067\u3059\u304c\u3001\u30b9\u30c8\u30fc\u30ea\u30fc\u306f\u3042\u307e\u308a\u6c17\u306b\u3057\u306a\u304f\u3066\u3082\u3044\u3044\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u3002</p><p class=\"bb_paragraph\" >\u5927\u4e8b\u306a\u306e\u306f\u809d\u5fc3\u306e\u30b2\u30fc\u30e0\u5185\u5bb9\u3067\u3059\uff01</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\u3068\u3044\u3046\u3053\u3068\u3067\u3001\u6b21\u306f\u30d7\u30ec\u30a4\u5185\u5bb9\uff01</p><p class=\"bb_paragraph\" >\u3053\u306e\u30b2\u30fc\u30e0\u306b\u306f\u69d8\u3005\u306a\u30b8\u30e3\u30f3\u30eb\u304c\u5165\u3063\u3066\u3044\u307e\u3059\uff01</p><p class=\"bb_paragraph\" >\u30af\u30ea\u30c3\u30ab\u30fc\u3001\u91e3\u308a\u3001\u5bff\u53f8\u30ea\u30ba\u30e0\u3001\u77ac\u9593\u30a2\u30af\u30b7\u30e7\u30f3\u3001</p><p class=\"bb_paragraph\" >\u30ab\u30fc\u30c1\u30a7\u30a4\u30b9\u3001\u30b7\u30e5\u30fc\u30c6\u30a3\u30f3\u30b0\u3001\u63a8\u7406&amp;\u8a18\u61b6\u3001\u4f5c\u696d</p><p class=\"bb_paragraph\" >\u30b9\u30ed\u30c3\u30c8\u3001\u80b2\u6210\u3001\uff32\uff30\uff27\u3001\u5fcd\u8005\u3001\u30a2\u30af\u30b7\u30e7\u30f3\u3001\u305d\u3057\u3066\u907f\u3051\u30b2\u30fc\uff01</p><p class=\"bb_paragraph\" >\u9762\u767d\u3044\uff01\u3000\u5b9f\u306b\u9762\u767d\u3044\uff01\u3000\u914d\u4fe1\u8005\u3082\u3069\u3093\u3068\u3053\u3044\uff01\u3000</p><p class=\"bb_paragraph\" >\u203b\u914d\u4fe1\u8005\u30e2\u30fc\u30c9\u3092\u30d7\u30ec\u30a4\u3055\u308c\u308b\u65b9\u306f</p><p class=\"bb_paragraph\" >\u3000\u6700\u5f8c\u307e\u3067\u30d7\u30ec\u30a4\u3057\u3066\u306d\uff01</p><p class=\"bb_paragraph\" >\u3000\u3088\u304f\u3068\u3061\u3085\u3046\u3067\u3052\u30fc\u3080\u3092\u3084\u3081\u308b\u3072\u3068\u306f</p><p class=\"bb_paragraph\" >\u300c\u3053\u3069\u30e2\u30fc\u30c9\u300d\u3060\u3068</p><p class=\"bb_paragraph\" >\u3000\u3089\u304f\u3089\u304f\u30af\u30ea\u30a2\u3067\u304d\u308b\u304b\u3089\u305d\u3063\u3061\u3067\u3042\u305d\u307c\u3046\u306d\uff01</p><p class=\"bb_paragraph\" >\u305d\u3057\u3066\uff11\u4f5c\u54c1\u76ee\u3068\u540c\u69d8</p><p class=\"bb_paragraph\" >\u8272\u3093\u306a\u30d1\u30ed\u30c7\u30a3\u304c\u3061\u308a\u3070\u3081\u3089\u308c\u3066\u3044\u307e\u3059\uff01</p><p class=\"bb_paragraph\" >\u305d\u3093\u306a\u30d1\u30ed\u30c7\u30a3\u3092\u307e\u308b\u3063\u3068\u304a\u898b\u901a\u305b\u308b\u5b9f\u529b\u8005\u30ab\u30e2\u30f3\uff01</p><p class=\"bb_paragraph\" >\u30a8\u30f3\u30c7\u30a3\u30f3\u30b0\u306f\u3044\u3064\u3082\u4e00\u3064\uff01</p><p class=\"bb_paragraph\" >\u3058\u3063\u3061\u3083\u3093\u3082\u305d\u3046\u8a00\u3063\u3066\u308b\uff01</p><p class=\"bb_paragraph\" >\u3048\uff5e\u30ca\u30ca\u30ca\u3067\u3057\u305f\uff5e</p><p class=\"bb_paragraph\" >\u203b\u9762\u767d\u304b\u3063\u305f\u3089\u4ed6\u306e\u4f5c\u54c1\u3082\u8cb7\u3063\u3066\u306d\uff01</p>",
    "about_the_game": "<p class=\"bb_paragraph\" >\u4e0d\u601d\u8b70\u306a\u4e16\u754c\u306e\u89b3\u5149\u65e5\u8a18\u7b2c\uff12\u5f3e\uff01\u3000</p><p class=\"bb_paragraph\" >\u524d\u56de\u306f\u30af\u30ea\u30a2\u307e\u306750\u6642\u9593\u304b\u304b\u3063\u3066</p><p class=\"bb_paragraph\" >\u30af\u30ea\u30a2\u51fa\u6765\u305f\u4eba\u304c10\u4eba\u306b\uff11\u4eba\u3067\u3057\u305f\u304c\u3001</p><p class=\"bb_paragraph\" >\u4eca\u56de\u306f\uff13\u6642\u9593\u304f\u3089\u3044\u3067\u30b5\u30af\u30c3\u3068\u904a\u3079\u308b\u304a\u624b\u8efd\u30b2\u30fc\u30e0\u306b\u3057\u307e\u3057\u305f\uff01\u3081\u3067\u305f\u3044\uff01</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\u30b9\u30c8\u30fc\u30ea\u30fc\u306f\u6b21\u56de\u4f5c\u3001</p><p class=\"bb_paragraph\" >\uff13\u4f5c\u76ee\u306e\u300e\u3072\u3088\u306e\u304a\u5b9d\u5927\u5192\u967a\u300f\u306e\u6d3b\u8e8d\u306b\u3088\u3063\u3066</p><p class=\"bb_paragraph\" >\u4e3b\u4eba\u516c\u306e\u30ca\u30ca\u30ca\u306e\u4f5c\u3063\u3066\u3044\u308b</p><p class=\"bb_paragraph\" >\u300c\u4e0d\u601d\u8b70\u306a\u4e16\u754c\u306e\u89b3\u5149\u65e5\u8a18\u300d\u3068\u3044\u3046\u4f5c\u54c1\u304c</p><p class=\"bb_paragraph\" >\u30b2\u30fc\u30e0\u306b\u306a\u308a\u307e\u3057\u305f\u3002</p><p class=\"bb_paragraph\" >\u4eca\u65e5\u306f\u305d\u308c\u3092\u30d7\u30ec\u30a4\u3057\u3088\u3046\uff01</p><p class=\"bb_paragraph\" >\u3068\u30ca\u30ca\u30ca\u3068\u3072\u3088\u304c</p><p class=\"bb_paragraph\" >\u30b2\u30fc\u30e0\u5185\u3067\u81ea\u5206\u306e\u4f5c\u54c1\u306e\u30b2\u30fc\u30e0\u3092\u3057\u3066\u3044\u304f\u6240\u304b\u3089</p><p class=\"bb_paragraph\" >\u7269\u8a9e\u304c\u59cb\u307e\u3063\u3066\u3044\u304d\u307e\u3059\u3002</p><p class=\"bb_paragraph\" >\u2026\u8aac\u660e\u304c\u5206\u304b\u308a\u306b\u304f\u3044\u3067\u3059\u304c\u3001\u30b9\u30c8\u30fc\u30ea\u30fc\u306f\u3042\u307e\u308a\u6c17\u306b\u3057\u306a\u304f\u3066\u3082\u3044\u3044\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u3002</p><p class=\"bb_paragraph\" >\u5927\u4e8b\u306a\u306e\u306f\u809d\u5fc3\u306e\u30b2\u30fc\u30e0\u5185\u5bb9\u3067\u3059\uff01</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\u3068\u3044\u3046\u3053\u3068\u3067\u3001\u6b21\u306f\u30d7\u30ec\u30a4\u5185\u5bb9\uff01</p><p class=\"bb_paragraph\" >\u3053\u306e\u30b2\u30fc\u30e0\u306b\u306f\u69d8\u3005\u306a\u30b8\u30e3\u30f3\u30eb\u304c\u5165\u3063\u3066\u3044\u307e\u3059\uff01</p><p class=\"bb_paragraph\" >\u30af\u30ea\u30c3\u30ab\u30fc\u3001\u91e3\u308a\u3001\u5bff\u53f8\u30ea\u30ba\u30e0\u3001\u77ac\u9593\u30a2\u30af\u30b7\u30e7\u30f3\u3001</p><p class=\"bb_paragraph\" >\u30ab\u30fc\u30c1\u30a7\u30a4\u30b9\u3001\u30b7\u30e5\u30fc\u30c6\u30a3\u30f3\u30b0\u3001\u63a8\u7406&amp;\u8a18\u61b6\u3001\u4f5c\u696d</p><p class=\"bb_paragraph\" >\u30b9\u30ed\u30c3\u30c8\u3001\u80b2\u6210\u3001\uff32\uff30\uff27\u3001\u5fcd\u8005\u3001\u30a2\u30af\u30b7\u30e7\u30f3\u3001\u305d\u3057\u3066\u907f\u3051\u30b2\u30fc\uff01</p><p class=\"bb_paragraph\" >\u9762\u767d\u3044\uff01\u3000\u5b9f\u306b\u9762\u767d\u3044\uff01\u3000\u914d\u4fe1\u8005\u3082\u3069\u3093\u3068\u3053\u3044\uff01\u3000</p><p class=\"bb_paragraph\" >\u203b\u914d\u4fe1\u8005\u30e2\u30fc\u30c9\u3092\u30d7\u30ec\u30a4\u3055\u308c\u308b\u65b9\u306f</p><p class=\"bb_paragraph\" >\u3000\u6700\u5f8c\u307e\u3067\u30d7\u30ec\u30a4\u3057\u3066\u306d\uff01</p><p class=\"bb_paragraph\" >\u3000\u3088\u304f\u3068\u3061\u3085\u3046\u3067\u3052\u30fc\u3080\u3092\u3084\u3081\u308b\u3072\u3068\u306f</p><p class=\"bb_paragraph\" >\u300c\u3053\u3069\u30e2\u30fc\u30c9\u300d\u3060\u3068</p><p class=\"bb_paragraph\" >\u3000\u3089\u304f\u3089\u304f\u30af\u30ea\u30a2\u3067\u304d\u308b\u304b\u3089\u305d\u3063\u3061\u3067\u3042\u305d\u307c\u3046\u306d\uff01</p><p class=\"bb_paragraph\" >\u305d\u3057\u3066\uff11\u4f5c\u54c1\u76ee\u3068\u540c\u69d8</p><p class=\"bb_paragraph\" >\u8272\u3093\u306a\u30d1\u30ed\u30c7\u30a3\u304c\u3061\u308a\u3070\u3081\u3089\u308c\u3066\u3044\u307e\u3059\uff01</p><p class=\"bb_paragraph\" >\u305d\u3093\u306a\u30d1\u30ed\u30c7\u30a3\u3092\u307e\u308b\u3063\u3068\u304a\u898b\u901a\u305b\u308b\u5b9f\u529b\u8005\u30ab\u30e2\u30f3\uff01</p><p class=\"bb_paragraph\" >\u30a8\u30f3\u30c7\u30a3\u30f3\u30b0\u306f\u3044\u3064\u3082\u4e00\u3064\uff01</p><p class=\"bb_paragraph\" >\u3058\u3063\u3061\u3083\u3093\u3082\u305d\u3046\u8a00\u3063\u3066\u308b\uff01</p><p class=\"bb_paragraph\" >\u3048\uff5e\u30ca\u30ca\u30ca\u3067\u3057\u305f\uff5e</p><p class=\"bb_paragraph\" >\u203b\u9762\u767d\u304b\u3063\u305f\u3089\u4ed6\u306e\u4f5c\u54c1\u3082\u8cb7\u3063\u3066\u306d\uff01</p>",
