    "detailed_description": "<p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" ><strong>\u5173\u4e8e\u672c\u4f5c\u6545\u4e8b\u2014\u2014</strong></h2><p class=\"bb_paragraph\" >\u63a5\u7eed\u524d\u4f5c\u300a\u661f\u68072\u300b\uff0c\u5728\u8bfa\u66fc\u7279\u4e00\u884c\u4eba\u60e8\u906d\u80cc\u53db\uff0c\u961f\u4f0d\u51e0\u8fd1\u5168\u706d\u4e4b\u9645\uff0c\u5948\u514b\u65af\u4e3a\u4f17\u4eba\u7559\u4e0b\u7684\u4f0f\u5175\u3010\u661f\u6807\u519b\u3011\u8d77\u4e86\u81f3\u5173\u91cd\u8981\u7684\u4f5c\u7528\uff0c\u5c06\u4ed6\u4eec\u4ece\u6bc1\u706d\u8fb9\u7f18\u62ef\u6551\u51fa\u6765\u3002</p><p class=\"bb_paragraph\" >\u53e6\u4e00\u65b9\u9762\uff0c\u501f\u8bfa\u66fc\u7279\u7b49\u4eba\u4e4b\u624b\u9664\u6389\u5948\u514b\u65af\u8fd9\u4e00\u6700\u5927\u7684\u5a01\u80c1\u540e\uff0c\u661f\u7075\u4e5f\u8d70\u5411\u4e86\u524d\u53f0\uff0c\u7531\u5979\u7387\u9886\u4eba\u7c7b\u53d1\u8d77\u4e86\u4e00\u573a\u9488\u5bf9\u963f\u6bd4\u65af\u4e43\u81f3\u975e\u4eba\u7c7b\u7269\u79cd\u7684\u6b8b\u9177\u9547\u538b\uff0c\u4e3a\u4e86\u66ff\u901d\u53bb\u7684\u6218\u53cb\u62a5\u4ec7\uff0c\u66f4\u4e3a\u4e86\u8ba9\u4e9a\u5c14\u6cf0\u4e9a\u65af\u91cd\u5f52\u548c\u5e73\uff0c\u3010\u661f\u6807\u519b\u3011\u4e58\u5750\u7740\u540d\u4e3a\u3010\u5965\u5fb7\u8d5b\u53f7\u3011\u7684\u5de8\u5927\u6218\u8230\u5f00\u59cb\u4e86\u6700\u540e\u7684\u53cd\u6297\u2026\u2026</p><p class=\"bb_paragraph\" >\u00a0</p><h2 class=\"bb_tag\" ><strong>\u672c\u4f5c\u7279\u8272</strong></h2><h2 class=\"bb_tag\" ><i>\u25cb\u5347\u7ea7\u7248\u7684\u7cbe\u5f69\u6f14\u51fa</i></h2><p class=\"bb_paragraph\" >\u5728\u7b2c\u4e8c\u90e8\u6218\u6597\u6f14\u51fa\u7684\u57fa\u7840\u4e0a\u65b0\u589e\u4e86\u5408\u4f53\u6280\u7c7b\u578b\uff0c\u8bf7\u4e0e\u7279\u5b9a\u4f19\u4f34\u4eec\u5728\u6218\u6597\u4e2d\u8054\u624b\u4f7f\u51fa\u5a01\u529b\u6781\u9ad8\u7684\u5408\u4f53\u5fc5\u6740\u6280\u5427\uff01 </p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" ><i>\u25cb\u7ecf\u5178\u7684JRPG\u53d9\u4e8b\u98ce\u683c+\u4e30\u5bcc\u7684\u5267\u60c5</i></h2><p class=\"bb_paragraph\" >\u5728\u524d\u4e24\u4f5c\u7684\u4e16\u754c\u89c2\u57fa\u7840\u4e0a\uff0c\u8fdb\u4e00\u6b65\u6269\u5c55\u5168\u65b0\u8981\u7d20\uff0c\u5448\u73b0\u51fa\u591a\u5f69\u7684\u4e16\u754c\u89c2\uff0c\u8db3\u591f\u7684\u6e38\u620f\u65f6\u957f\u4e0e\u5267\u60c5\u4f53\u9a8c\u4e5f\u80fd\u8ba9\u4f60\u6c89\u6d78\u4e8e\u6e38\u620f\u4e16\u754c\u4e2d\u96be\u4ee5\u81ea\u62d4\uff01</p><h2 class=\"bb_tag\" >\u00a0<i>\u25cb\u8f85\u52a9\u7cfb\u7edf\u518d\u5347\u7ea7</i></h2><p class=\"bb_paragraph\" >\u5728\u524d\u4f5c\u57fa\u7840\u4e0a\uff0c\u65b0\u589e\u6218\u8230\u7cfb\u7edf\uff0c\u521d\u671f\u5373\u53ef\u64cd\u63a7\u6218\u8230\u81ea\u7531\u5de1\u822a\u5230\u5404\u4e2a\u533a\u57df\uff01</p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" ><i>\u25cb\u89d2\u8272\u5b9a\u5236\u5316\u7cfb\u7edf</i></h2><p class=\"bb_paragraph\" >\u4ece\u73b0\u5728\u8d77\uff0c\u73a9\u5bb6\u53ef\u4ee5\u8ba9\u89d2\u8272\u901a\u8fc7\u6d88\u8017SP\u70b9\u6570\u5b66\u4e60\u4e0d\u540c\u7684\u5c5e\u6027\u52a0\u6210\u548c\u88ab\u52a8\u6548\u679c\uff0c\u540c\u65f6\u4e30\u5bcc\u7684\u6cdb\u7528\u6280\u80fd\u4e5f\u80fd\u5927\u5e45\u6269\u5c55\u89d2\u8272\u7684\u6218\u6597\u98ce\u683c\uff0c\u6839\u636e\u6218\u51b5\u9700\u8981\u4f7f\u7528\u7279\u5b9a\u6280\u80fd\u6253\u7834\u50f5\u5c40\uff0c\u521b\u9020\u51fa\u53ea\u5c5e\u4e8e\u4f60\u7684\u6218\u6597\u98ce\u683c\u4e0e\u89d2\u8272\u5427\uff01</p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" ><i>\u25cb\u5f3a\u5316\u88c5\u5907\u7cfb\u7edf</i></h2><p class=\"bb_paragraph\" >\u5728\u4fdd\u7559\u524d\u4f5c\u7b80\u6613\u88c5\u5907\u7cfb\u7edf\u7684\u57fa\u7840\u4e0a\uff0c\u65b0\u589e\u4e86\u88c5\u5907\u5f3a\u5316\u3001\u5347\u7ea7\u4e0e\u9644\u9b54\u7b49\u64cd\u4f5c\uff0c\u8fdb\u4e00\u6b65\u964d\u4f4e\u6e38\u620f\u96be\u5ea6\uff0c\u540c\u65f6\u591a\u6837\u5316\u7684\u88c5\u5907\u4e0e\u8bcd\u6761\u901a\u8fc7\u7279\u6b8a\u642d\u914d\u4e5f\u80fd\u53d1\u6325\u51fa\u65e0\u4e0e\u4f26\u6bd4\u7684\u6218\u6597\u529b\uff01</p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" ><i>\u25cb\u9644\u8d60\u6e38\u620f</i></h2><p class=\"bb_paragraph\" >\u5bf9\u4e8e\u60f3\u4e86\u89e3\u524d\u4f5c\u7684\u73a9\u5bb6\uff0c\u53ef\u5728\u6807\u9898\u754c\u9762\u4e0b\u8f7d\u524d\u4e24\u90e8\u4f5c\u54c1\u8fdb\u884c\u6e38\u73a9\uff0c\u5f53\u7136\u8fd9\u4e5f\u662f\u514d\u8d39\u7684\u3002</p><p class=\"bb_paragraph\" >*\u63a8\u8350\u81f3\u5c11\u6e38\u73a9\u8fc7\u7b2c\u4e8c\u90e8\u7684\u771f\u7ed3\u5c40\u540e\u518d\u6e38\u73a9\u672c\u6e38\u620f\u3002</p>",
    "about_the_game": "<p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" ><strong>\u5173\u4e8e\u672c\u4f5c\u6545\u4e8b\u2014\u2014</strong></h2><p class=\"bb_paragraph\" >\u63a5\u7eed\u524d\u4f5c\u300a\u661f\u68072\u300b\uff0c\u5728\u8bfa\u66fc\u7279\u4e00\u884c\u4eba\u60e8\u906d\u80cc\u53db\uff0c\u961f\u4f0d\u51e0\u8fd1\u5168\u706d\u4e4b\u9645\uff0c\u5948\u514b\u65af\u4e3a\u4f17\u4eba\u7559\u4e0b\u7684\u4f0f\u5175\u3010\u661f\u6807\u519b\u3011\u8d77\u4e86\u81f3\u5173\u91cd\u8981\u7684\u4f5c\u7528\uff0c\u5c06\u4ed6\u4eec\u4ece\u6bc1\u706d\u8fb9\u7f18\u62ef\u6551\u51fa\u6765\u3002</p><p class=\"bb_paragraph\" >\u53e6\u4e00\u65b9\u9762\uff0c\u501f\u8bfa\u66fc\u7279\u7b49\u4eba\u4e4b\u624b\u9664\u6389\u5948\u514b\u65af\u8fd9\u4e00\u6700\u5927\u7684\u5a01\u80c1\u540e\uff0c\u661f\u7075\u4e5f\u8d70\u5411\u4e86\u524d\u53f0\uff0c\u7531\u5979\u7387\u9886\u4eba\u7c7b\u53d1\u8d77\u4e86\u4e00\u573a\u9488\u5bf9\u963f\u6bd4\u65af\u4e43\u81f3\u975e\u4eba\u7c7b\u7269\u79cd\u7684\u6b8b\u9177\u9547\u538b\uff0c\u4e3a\u4e86\u66ff\u901d\u53bb\u7684\u6218\u53cb\u62a5\u4ec7\uff0c\u66f4\u4e3a\u4e86\u8ba9\u4e9a\u5c14\u6cf0\u4e9a\u65af\u91cd\u5f52\u548c\u5e73\uff0c\u3010\u661f\u6807\u519b\u3011\u4e58\u5750\u7740\u540d\u4e3a\u3010\u5965\u5fb7\u8d5b\u53f7\u3011\u7684\u5de8\u5927\u6218\u8230\u5f00\u59cb\u4e86\u6700\u540e\u7684\u53cd\u6297\u2026\u2026</p><p class=\"bb_paragraph\" >\u00a0</p><h2 class=\"bb_tag\" ><strong>\u672c\u4f5c\u7279\u8272</strong></h2><h2 class=\"bb_tag\" ><i>\u25cb\u5347\u7ea7\u7248\u7684\u7cbe\u5f69\u6f14\u51fa</i></h2><p class=\"bb_paragraph\" >\u5728\u7b2c\u4e8c\u90e8\u6218\u6597\u6f14\u51fa\u7684\u57fa\u7840\u4e0a\u65b0\u589e\u4e86\u5408\u4f53\u6280\u7c7b\u578b\uff0c\u8bf7\u4e0e\u7279\u5b9a\u4f19\u4f34\u4eec\u5728\u6218\u6597\u4e2d\u8054\u624b\u4f7f\u51fa\u5a01\u529b\u6781\u9ad8\u7684\u5408\u4f53\u5fc5\u6740\u6280\u5427\uff01 </p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" ><i>\u25cb\u7ecf\u5178\u7684JRPG\u53d9\u4e8b\u98ce\u683c+\u4e30\u5bcc\u7684\u5267\u60c5</i></h2><p class=\"bb_paragraph\" >\u5728\u524d\u4e24\u4f5c\u7684\u4e16\u754c\u89c2\u57fa\u7840\u4e0a\uff0c\u8fdb\u4e00\u6b65\u6269\u5c55\u5168\u65b0\u8981\u7d20\uff0c\u5448\u73b0\u51fa\u591a\u5f69\u7684\u4e16\u754c\u89c2\uff0c\u8db3\u591f\u7684\u6e38\u620f\u65f6\u957f\u4e0e\u5267\u60c5\u4f53\u9a8c\u4e5f\u80fd\u8ba9\u4f60\u6c89\u6d78\u4e8e\u6e38\u620f\u4e16\u754c\u4e2d\u96be\u4ee5\u81ea\u62d4\uff01</p><h2 class=\"bb_tag\" >\u00a0<i>\u25cb\u8f85\u52a9\u7cfb\u7edf\u518d\u5347\u7ea7</i></h2><p class=\"bb_paragraph\" >\u5728\u524d\u4f5c\u57fa\u7840\u4e0a\uff0c\u65b0\u589e\u6218\u8230\u7cfb\u7edf\uff0c\u521d\u671f\u5373\u53ef\u64cd\u63a7\u6218\u8230\u81ea\u7531\u5de1\u822a\u5230\u5404\u4e2a\u533a\u57df\uff01</p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" ><i>\u25cb\u89d2\u8272\u5b9a\u5236\u5316\u7cfb\u7edf</i></h2><p class=\"bb_paragraph\" >\u4ece\u73b0\u5728\u8d77\uff0c\u73a9\u5bb6\u53ef\u4ee5\u8ba9\u89d2\u8272\u901a\u8fc7\u6d88\u8017SP\u70b9\u6570\u5b66\u4e60\u4e0d\u540c\u7684\u5c5e\u6027\u52a0\u6210\u548c\u88ab\u52a8\u6548\u679c\uff0c\u540c\u65f6\u4e30\u5bcc\u7684\u6cdb\u7528\u6280\u80fd\u4e5f\u80fd\u5927\u5e45\u6269\u5c55\u89d2\u8272\u7684\u6218\u6597\u98ce\u683c\uff0c\u6839\u636e\u6218\u51b5\u9700\u8981\u4f7f\u7528\u7279\u5b9a\u6280\u80fd\u6253\u7834\u50f5\u5c40\uff0c\u521b\u9020\u51fa\u53ea\u5c5e\u4e8e\u4f60\u7684\u6218\u6597\u98ce\u683c\u4e0e\u89d2\u8272\u5427\uff01</p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" ><i>\u25cb\u5f3a\u5316\u88c5\u5907\u7cfb\u7edf</i></h2><p class=\"bb_paragraph\" >\u5728\u4fdd\u7559\u524d\u4f5c\u7b80\u6613\u88c5\u5907\u7cfb\u7edf\u7684\u57fa\u7840\u4e0a\uff0c\u65b0\u589e\u4e86\u88c5\u5907\u5f3a\u5316\u3001\u5347\u7ea7\u4e0e\u9644\u9b54\u7b49\u64cd\u4f5c\uff0c\u8fdb\u4e00\u6b65\u964d\u4f4e\u6e38\u620f\u96be\u5ea6\uff0c\u540c\u65f6\u591a\u6837\u5316\u7684\u88c5\u5907\u4e0e\u8bcd\u6761\u901a\u8fc7\u7279\u6b8a\u642d\u914d\u4e5f\u80fd\u53d1\u6325\u51fa\u65e0\u4e0e\u4f26\u6bd4\u7684\u6218\u6597\u529b\uff01</p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" ><i>\u25cb\u9644\u8d60\u6e38\u620f</i></h2><p class=\"bb_paragraph\" >\u5bf9\u4e8e\u60f3\u4e86\u89e3\u524d\u4f5c\u7684\u73a9\u5bb6\uff0c\u53ef\u5728\u6807\u9898\u754c\u9762\u4e0b\u8f7d\u524d\u4e24\u90e8\u4f5c\u54c1\u8fdb\u884c\u6e38\u73a9\uff0c\u5f53\u7136\u8fd9\u4e5f\u662f\u514d\u8d39\u7684\u3002</p><p class=\"bb_paragraph\" >*\u63a8\u8350\u81f3\u5c11\u6e38\u73a9\u8fc7\u7b2c\u4e8c\u90e8\u7684\u771f\u7ed3\u5c40\u540e\u518d\u6e38\u73a9\u672c\u6e38\u620f\u3002</p>",
