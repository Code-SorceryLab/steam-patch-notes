 poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2440320/extras/2c42a96fbc8e81211f3ebbcf47291bb9.poster.avif?t=1734104464\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2440320/extras/2c42a96fbc8e81211f3ebbcf47291bb9.webm?t=1734104464\" type=\"video/webm; codecs=vp9\"></video></span><br><br><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2440320/extras/4fa6b97a45d45d5bda0780848ff60f29.avif?t=1734104464\" /></span>",
