    "required_age": 0,
    "is_free": false,
    "controller_support": "full",
    "detailed_description": "<p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2766810/extras/66553ccbabd94592773c7a7fe4a627d5.poster.avif?t=1751336215\" width=800 height=450 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2766810/extras/66553ccbabd94592773c7a7fe4a627d5.webm?t=1751336215\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2766810/extras/66553ccbabd94592773c7a7fe4a627d5.mp4?t=1751336215\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><strong>Scuttle</strong> is a high-speed <strong>third-person platformer</strong> with <strong>rhythm game</strong> elements that blends music and momentum across vibrant, ocean-inspired worlds. In this genre-bending adventure, you play as a crab on a musical journey, gaining speed by hitting notes on beat and racing across a vibrant, dancing shoreline.</p><p class=\"bb_paragraph\" >\u00a0</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2766810/extras/2755c31447be036a0c54a37ba5cbef50.poster.avif?t=1751336215\" width=800 height=208 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2766810/extras/2755c31447be036a0c54a37ba5cbef50.webm?t=1751336215\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2766810/extras/2755c31447be036a0c54a37ba5cbef50.mp4?t=1751336215\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >Jump, boost, and dash in rhythm, creating music as you race through a musically synchronized world. Encounter turtles, seagulls, and other beach creatures as you dance toward the secrets of this curious beach!</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2766810/extras/0ef63824bf4f73073258242b991b84f3.poster.avif?t=1751336215\" width=800 height=450 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2766810/extras/0ef63824bf4f73073258242b991b84f3.webm?t=1751336215\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2766810/extras/0ef63824bf4f73073258242b991b84f3.mp4?t=1751336215\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><strong>Run to the Beat of a Soulful Adventure!</strong></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2766810/extras/11290f844f2529668ff4e06eed4643f8.poster.avif?t=1751336215\" width=800 height=450 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2766810/extras/11290f844f2529668ff4e06eed4643f8.webm?t=1751336215\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2766810/extras/11290f844f2529668ff4e06eed4643f8.mp4?t=1751336215\" type=\"video/mp4\"></video></span></p>",
    "about_the_game": "<p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2766810/extras/66553ccbabd94592773c7a7fe4a627d5.poster.avif?t=1751336215\" width=800 height=450 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2766810/extras/66553ccbabd94592773c7a7fe4a627d5.webm?t=1751336215\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2766810/extras/66553ccbabd94592773c7a7fe4a627d5.mp4?t=1751336215\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><strong>Scuttle</strong> is a high-speed <strong>third-person platformer</strong> with <strong>rhythm game</strong> elements that blends music and momentum across vibrant, ocean-inspired worlds. In this genre-bending adventure, you play as a crab on a musical journey, gaining speed by hitting notes on beat and racing across a vibrant, dancing shoreline.</p><p class=\"bb_paragraph\" >\u00a0</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2766810/extras/2755c31447be036a0c54a37ba5cbef50.poster.avif?t=1751336215\" width=800 height=208 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2766810/extras/2755c31447be036a0c54a37ba5cbef50.webm?t=1751336215\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2766810/extras/2755c31447be036a0c54a37ba5cbef50.mp4?t=1751336215\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >Jump, boost, and dash in rhythm, creating music as you race through a musically synchronized world. Encounter turtles, seagulls, and other beach creatures as you dance toward the secrets of this curious beach!</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2766810/extras/0ef63824bf4f73073258242b991b84f3.poster.avif?t=1751336215\" width=800 height=450 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2766810/extras/0ef63824bf4f73073258242b991b84f3.webm?t=1751336215\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2766810/extras/0ef63824bf4f73073258242b991b84f3.mp4?t=1751336215\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><strong>Run to the Beat of a Soulful Adventure!</strong></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2766810/extras/11290f844f2529668ff4e06eed4643f8.poster.avif?t=1751336215\" width=800 height=450 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2766810/extras/11290f844f2529668ff4e06eed4643f8.webm?t=1751336215\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2766810/extras/11290f844f2529668ff4e06eed4643f8.mp4?t=1751336215\" type=\"video/mp4\"></video></span></p>",
