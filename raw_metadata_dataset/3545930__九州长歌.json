    "detailed_description": "<h2 class=\"bb_tag\" ><strong>\u300a\u4e5d\u5dde\u957f\u6b4c\u300b\u5f00\u542f\u4e1c\u65b9\u7384\u5e7b\u6b66\u4fa0\u65b0\u7eaa\u5143\uff0c\u4ee5\u9707\u64bc\u4e1a\u754c\u7684\u6b21\u4e16\u4ee3\u5f15\u64ce\u6280\u672f\uff0c\u6253\u9020\u6a2a\u8de8\u5341\u4e07\u516b\u5343\u91cc\u7684\u6d69\u701a\u65e0\u7f1d\u4e16\u754c\uff01\u5c71\u5ddd\u6cb3\u6d77\u77ac\u606f\u4e07\u53d8\uff0c\u4e91\u6d77\u7ffb\u6d8c\u95f4\u53ef\u89c1\u4e0a\u53e4\u9057\u8ff9\u82e5\u9690\u82e5\u73b0\uff0c\u6bcf\u4e00\u6b21\u5fa1\u5251\u98de\u884c\u90fd\u5c06\u8de8\u8d8a\u622a\u7136\u4e0d\u540c\u7684\u751f\u6001\u5947\u89c2\u3002</strong></h2><h2 class=\"bb_tag\" ><strong>\u3010\u98a0\u8986\u60f3\u8c61\u7684\u4e1c\u65b9\u5e7b\u57df\u3011</strong></h2><p class=\"bb_paragraph\" ><strong>\u91c7\u7528\u9769\u65b0\u6027\u7684\u300c\u7075\u6c14\u7c92\u5b50\u300d\u6e32\u67d3\u6280\u672f\uff0c\u6668\u9732\u6298\u5c04\u7740\u5251\u8292\u6d41\u8f6c\uff0c\u66b4\u96ea\u4e2d\u8863\u8882\u7ffb\u6d8c\u7684\u7269\u7406\u7ec6\u8282\u7ea4\u6beb\u6bd5\u73b0\u3002\u72ec\u521b\u663c\u591c\u4ea4\u66ff\u65f6\u7684\u300c\u9634\u9633\u5012\u8f6c\u300d\u5947\u89c2\uff0c\u5b50\u65f6\u6708\u534e\u503e\u6cfb\u5524\u9192\u6c89\u7761\u53e4\u795e\uff0c\u536f\u65f6\u65ed\u65e5\u4e1c\u5347\u5219\u4e07\u7269\u91cd\u7115\u751f\u673a\uff01</strong></p><h2 class=\"bb_tag\" ><strong>\u3010\u7f14\u9020\u5c5e\u4e8e\u4f60\u7684\u5929\u9053\u6cd5\u5219\u3011</strong></h2><p class=\"bb_paragraph\" ><strong>\u72ec\u521b\u300c\u56e0\u679c\u8f6e\u56de\u300d\u7cfb\u7edf\u8ba9\u6bcf\u4e2a\u6289\u62e9\u90fd\u64bc\u52a8\u4e7e\u5764\uff01\u91c7\u7075\u836f\u53ef\u5f15\u53d1\u7075\u8109\u55b7\u6d8c\uff0c\u8bdb\u51f6\u517d\u6216\u62db\u81f4\u767e\u5996\u590d\u4ec7\uff0c\u751a\u81f3\u4e0eNPC\u7684\u9082\u9005\u90fd\u53ef\u80fd\u89e6\u53d1\u738b\u671d\u66f4\u8fed\u3002\u5728\u8fd9\u91cc\uff0c\u4f60\u5c31\u662f\u8c31\u5199\u53f2\u8bd7\u7684\u6267\u7b14\u4eba\uff01</strong></p><h2 class=\"bb_tag\" ><strong>\u3010\u7834\u754c\u4e09\u5343\u7684\u7384\u5999\u6218\u6597\u3011</strong></h2><p class=\"bb_paragraph\" ><strong>\u878d\u5408\u4e94\u884c\u76f8\u751f\u4e0e\u5947\u95e8\u9041\u7532\u7684\u6218\u6597\u4f53\u7cfb\uff0c\u72ec\u521b\u300c\u795e\u901a\u8fde\u643a\u300d\u673a\u5236\u3002\u6307\u5c16\u8f7b\u5212\u53ef\u4ee4\u706b\u51e4\u71ce\u539f\u63a5\u7eed\u51b0\u9f99\u7834\u6653\uff0c\u7b26\u7b93\u4e0e\u5251\u8bc0\u78b0\u649e\u6fc0\u53d1\u5929\u5730\u5f02\u8c61\uff0c\u767e\u4eba\u540c\u5c4f\u6fc0\u6218\u66f4\u53ef\u89e6\u53d1\u6bc1\u5929\u706d\u5730\u7684\u8bdb\u4ed9\u5251\u9635\uff01</strong></p><h2 class=\"bb_tag\" ><strong>\u3010\u4e07\u8c61\u7531\u5fc3\u7684\u8d85\u51e1\u8715\u53d8\u3011</strong></h2><p class=\"bb_paragraph\" ><strong>\u4ece\u53d1\u4e1d\u7eb9\u8def\u5230\u672c\u547d\u6cd5\u5b9d\u7686\u53ef\u81ea\u5b9a\u4e49\u7684\u300c\u7075\u97f5\u5851\u9020\u300d\u7cfb\u7edf\uff0c\u767e\u4e07\u79cd\u5916\u89c2\u7ec4\u5408\u642d\u914d\u9b42\u5668\u5171\u9e23\u5149\u6548\u3002\u66f4\u53ef\u89c9\u9192\u592a\u53e4\u8840\u8109\uff0c\u5728\u6218\u6597\u4e2d\u5e7b\u5316\u4e5d\u5c3e\u5929\u72d0\u3001\u91d1\u7fc5\u5927\u9e4f\u7b49\u4f20\u8bf4\u6cd5\u76f8\uff0c\u6210\u5c31\u4e09\u754c\u72ec\u5c0a\u7684\u4ed9\u59ff\uff01</strong></p><h2 class=\"bb_tag\" ><strong>\u3010\u900d\u9065\u4e07\u754c\u7684\u4fee\u884c\u771f\u8c1b\u3011</strong></h2><p class=\"bb_paragraph\" ><strong>\u9664\u5374\u5fa1\u517d\u70bc\u4e39\u3001\u673a\u5173\u9020\u7269\u7b49\u4f20\u7edf\u4ed9\u827a\uff0c\u66f4\u6709\u77ac\u606f\u5343\u53d8\u7684\u300c\u5929\u673a\u68cb\u5c40\u300d\u3001\u9006\u8f6c\u65f6\u7a7a\u7684\u300c\u8f6e\u56de\u79d8\u5883\u300d\u7b49\u5341\u4e8c\u91cd\u7384\u5999\u73a9\u6cd5\u3002\u5076\u7136\u89e6\u53d1\u84ec\u83b1\u4ed9\u5bb4\u53ef\u7fbd\u5316\u767b\u4ed9\uff0c\u8bef\u5165\u9146\u90fd\u9b3c\u5e02\u5219\u9700\u667a\u6597\u5b5f\u5a46\uff0c\u6bcf\u4e00\u6b21\u63a2\u7d22\u90fd\u662f\u9053\u5fc3\u5386\u7ec3\uff01</strong></p>",
    "about_the_game": "<h2 class=\"bb_tag\" ><strong>\u300a\u4e5d\u5dde\u957f\u6b4c\u300b\u5f00\u542f\u4e1c\u65b9\u7384\u5e7b\u6b66\u4fa0\u65b0\u7eaa\u5143\uff0c\u4ee5\u9707\u64bc\u4e1a\u754c\u7684\u6b21\u4e16\u4ee3\u5f15\u64ce\u6280\u672f\uff0c\u6253\u9020\u6a2a\u8de8\u5341\u4e07\u516b\u5343\u91cc\u7684\u6d69\u701a\u65e0\u7f1d\u4e16\u754c\uff01\u5c71\u5ddd\u6cb3\u6d77\u77ac\u606f\u4e07\u53d8\uff0c\u4e91\u6d77\u7ffb\u6d8c\u95f4\u53ef\u89c1\u4e0a\u53e4\u9057\u8ff9\u82e5\u9690\u82e5\u73b0\uff0c\u6bcf\u4e00\u6b21\u5fa1\u5251\u98de\u884c\u90fd\u5c06\u8de8\u8d8a\u622a\u7136\u4e0d\u540c\u7684\u751f\u6001\u5947\u89c2\u3002</strong></h2><h2 class=\"bb_tag\" ><strong>\u3010\u98a0\u8986\u60f3\u8c61\u7684\u4e1c\u65b9\u5e7b\u57df\u3011</strong></h2><p class=\"bb_paragraph\" ><strong>\u91c7\u7528\u9769\u65b0\u6027\u7684\u300c\u7075\u6c14\u7c92\u5b50\u300d\u6e32\u67d3\u6280\u672f\uff0c\u6668\u9732\u6298\u5c04\u7740\u5251\u8292\u6d41\u8f6c\uff0c\u66b4\u96ea\u4e2d\u8863\u8882\u7ffb\u6d8c\u7684\u7269\u7406\u7ec6\u8282\u7ea4\u6beb\u6bd5\u73b0\u3002\u72ec\u521b\u663c\u591c\u4ea4\u66ff\u65f6\u7684\u300c\u9634\u9633\u5012\u8f6c\u300d\u5947\u89c2\uff0c\u5b50\u65f6\u6708\u534e\u503e\u6cfb\u5524\u9192\u6c89\u7761\u53e4\u795e\uff0c\u536f\u65f6\u65ed\u65e5\u4e1c\u5347\u5219\u4e07\u7269\u91cd\u7115\u751f\u673a\uff01</strong></p><h2 class=\"bb_tag\" ><strong>\u3010\u7f14\u9020\u5c5e\u4e8e\u4f60\u7684\u5929\u9053\u6cd5\u5219\u3011</strong></h2><p class=\"bb_paragraph\" ><strong>\u72ec\u521b\u300c\u56e0\u679c\u8f6e\u56de\u300d\u7cfb\u7edf\u8ba9\u6bcf\u4e2a\u6289\u62e9\u90fd\u64bc\u52a8\u4e7e\u5764\uff01\u91c7\u7075\u836f\u53ef\u5f15\u53d1\u7075\u8109\u55b7\u6d8c\uff0c\u8bdb\u51f6\u517d\u6216\u62db\u81f4\u767e\u5996\u590d\u4ec7\uff0c\u751a\u81f3\u4e0eNPC\u7684\u9082\u9005\u90fd\u53ef\u80fd\u89e6\u53d1\u738b\u671d\u66f4\u8fed\u3002\u5728\u8fd9\u91cc\uff0c\u4f60\u5c31\u662f\u8c31\u5199\u53f2\u8bd7\u7684\u6267\u7b14\u4eba\uff01</strong></p><h2 class=\"bb_tag\" ><strong>\u3010\u7834\u754c\u4e09\u5343\u7684\u7384\u5999\u6218\u6597\u3011</strong></h2><p class=\"bb_paragraph\" ><strong>\u878d\u5408\u4e94\u884c\u76f8\u751f\u4e0e\u5947\u95e8\u9041\u7532\u7684\u6218\u6597\u4f53\u7cfb\uff0c\u72ec\u521b\u300c\u795e\u901a\u8fde\u643a\u300d\u673a\u5236\u3002\u6307\u5c16\u8f7b\u5212\u53ef\u4ee4\u706b\u51e4\u71ce\u539f\u63a5\u7eed\u51b0\u9f99\u7834\u6653\uff0c\u7b26\u7b93\u4e0e\u5251\u8bc0\u78b0\u649e\u6fc0\u53d1\u5929\u5730\u5f02\u8c61\uff0c\u767e\u4eba\u540c\u5c4f\u6fc0\u6218\u66f4\u53ef\u89e6\u53d1\u6bc1\u5929\u706d\u5730\u7684\u8bdb\u4ed9\u5251\u9635\uff01</strong></p><h2 class=\"bb_tag\" ><strong>\u3010\u4e07\u8c61\u7531\u5fc3\u7684\u8d85\u51e1\u8715\u53d8\u3011</strong></h2><p class=\"bb_paragraph\" ><strong>\u4ece\u53d1\u4e1d\u7eb9\u8def\u5230\u672c\u547d\u6cd5\u5b9d\u7686\u53ef\u81ea\u5b9a\u4e49\u7684\u300c\u7075\u97f5\u5851\u9020\u300d\u7cfb\u7edf\uff0c\u767e\u4e07\u79cd\u5916\u89c2\u7ec4\u5408\u642d\u914d\u9b42\u5668\u5171\u9e23\u5149\u6548\u3002\u66f4\u53ef\u89c9\u9192\u592a\u53e4\u8840\u8109\uff0c\u5728\u6218\u6597\u4e2d\u5e7b\u5316\u4e5d\u5c3e\u5929\u72d0\u3001\u91d1\u7fc5\u5927\u9e4f\u7b49\u4f20\u8bf4\u6cd5\u76f8\uff0c\u6210\u5c31\u4e09\u754c\u72ec\u5c0a\u7684\u4ed9\u59ff\uff01</strong></p><h2 class=\"bb_tag\" ><strong>\u3010\u900d\u9065\u4e07\u754c\u7684\u4fee\u884c\u771f\u8c1b\u3011</strong></h2><p class=\"bb_paragraph\" ><strong>\u9664\u5374\u5fa1\u517d\u70bc\u4e39\u3001\u673a\u5173\u9020\u7269\u7b49\u4f20\u7edf\u4ed9\u827a\uff0c\u66f4\u6709\u77ac\u606f\u5343\u53d8\u7684\u300c\u5929\u673a\u68cb\u5c40\u300d\u3001\u9006\u8f6c\u65f6\u7a7a\u7684\u300c\u8f6e\u56de\u79d8\u5883\u300d\u7b49\u5341\u4e8c\u91cd\u7384\u5999\u73a9\u6cd5\u3002\u5076\u7136\u89e6\u53d1\u84ec\u83b1\u4ed9\u5bb4\u53ef\u7fbd\u5316\u767b\u4ed9\uff0c\u8bef\u5165\u9146\u90fd\u9b3c\u5e02\u5219\u9700\u667a\u6597\u5b5f\u5a46\uff0c\u6bcf\u4e00\u6b21\u63a2\u7d22\u90fd\u662f\u9053\u5fc3\u5386\u7ec3\uff01</strong></p>",
