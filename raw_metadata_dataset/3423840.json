    "type": "game",
    "name": "\u82b1\u672d\u306e\u864e",
    "steam_appid": 3423840,
    "required_age": 0,
    "is_free": false,
    "detailed_description": "<p class=\"bb_paragraph\" >\u30ed\u30fc\u30b0\u30e9\u30a4\u30af\u30fb\u30c7\u30c3\u30ad\u30d3\u30eb\u30c9\u30fb\u30cf\u30a4\u30d1\u30fc\u30a4\u30f3\u30d5\u30ec\u30fb\u82b1\u672d\u30d0\u30c8\u30eb\u3001\u305d\u308c\u304c\u300c\u82b1\u672d\u306e\u864e\u300d\uff01</p><p class=\"bb_paragraph\" >\u300c\u82b1\u672d\u306e\u864e\u300d\u306f\u82b1\u672d\u306b\u30c7\u30c3\u30ad\u69cb\u7bc9\u578b\u30ed\u30fc\u30b0\u30e9\u30a4\u30c8\u3092\u639b\u3051\u5408\u308f\u305b\u305f\u30b2\u30fc\u30e0\u3067\u3059\u3002</p><p class=\"bb_paragraph\" >\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u9078\u629e\u6b21\u7b2c\u3067\u7acb\u3061\u306f\u3060\u304b\u308b\u5f37\u6575\u3078\u306e\u52dd\u7387\u304c\u5909\u308f\u308a\u307e\u3059\u3002</p><p class=\"bb_paragraph\" >\u25a0\u3044\u3056\u3001\u82b1\u672d\u30d0\u30c8\u30eb</p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u6575\u3078\u306e\u30c0\u30e1\u30fc\u30b8\uff1a\u82b1\u672d\u3067\u63c3\u3048\u305f\u5f79\u306e\u70b9\u6570\u306b\u69d8\u3005\u306a\u500d\u7387\u3092\u639b\u3051\u305f\u30dd\u30a4\u30f3\u30c8\u304c\u6575\u3078\u306e\u30c0\u30e1\u30fc\u30b8\u306b\u3064\u306a\u304c\u308a\u307e\u3059\u3002</p></li><li><p class=\"bb_paragraph\" >\u52dd\u8ca0 or \u3053\u3044\u3053\u3044\uff1a\u5f79\u3092\u63c3\u3048\u305f\u3089\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u52dd\u8ca0\u304b\u3053\u3044\u3053\u3044\u3092\u9078\u629e\u3057\u306a\u3051\u308c\u3070\u306a\u308a\u307e\u305b\u3093\u3002\u3000\u52dd\u8ca0\u306a\u3089\u6575\u306b\u30c0\u30e1\u30fc\u30b8\u3092\u4e0e\u3048\u3001\u3053\u3044\u3053\u3044\u306a\u3089\u82b1\u672d\u30d0\u30c8\u30eb\u3092\u7d9a\u3051\u3089\u308c\u307e\u3059\u3002\u3053\u3044\u3053\u3044\u3092\u3057\u305f\u5834\u5408\u3001\u5225\u306e\u5f79\u3092\u63c3\u3048\u3066\u3055\u3089\u306a\u308b\u30c0\u30e1\u30fc\u30b8\u5897\u52a0\u3092\u72d9\u3046\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002</p></li><li><p class=\"bb_paragraph\" >\u30b8\u30e3\u30c3\u30af\u30dd\u30c3\u30c8\uff1a\u3053\u3044\u3053\u3044\u3057\u305f\u3068\u304d\u306b\u6e9c\u307e\u308b\u30ab\u30a6\u30f3\u30c8\u3067\u30c0\u30e1\u30fc\u30b8\u8a08\u7b97\u6642\u306e\u500d\u7387\u3068\u3057\u3066\u6271\u308f\u308c\u308b\u3002\u305f\u3060\u3057\u3001\u6575\u304c\u4e0a\u304c\u308b\u6642\u306e\u30c0\u30e1\u30fc\u30b8\u8a08\u7b97\u306b\u3082\u9069\u7528\u3055\u308c\u308b\u306e\u6ce8\u610f\u304c\u5fc5\u8981\u3067\u3059\u3002</p></li></ul><p class=\"bb_paragraph\" >\u25a0\u30b7\u30e7\u30c3\u30d7\u3067\u5f37\u5316\u3057\u3088\u3046</p><p class=\"bb_paragraph\" >\u30b7\u30e7\u30c3\u30d7\u3067\u82b1\u672d\u3092\u5f37\u5316\u3059\u308b\u30ab\u30fc\u30c9\u3092\u8cfc\u5165\u3057\u3066\u30d0\u30c8\u30eb\u306e\u52dd\u7387\u3092\u4e0a\u3052\u307e\u3057\u3087\u3046\u3002</p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u672d\u306e\u70b9\u6570\u3092\u5897\u52a0\uff1a\u5404\u672d\u306e\u6301\u3064\u70b9\u6570\u3092\u5897\u3084\u3057\u3066\u30c0\u30e1\u30fc\u30b8\u3092\u5e95\u4e0a\u3052\u3067\u304d\u307e\u3059\u3002</p></li><li><p class=\"bb_paragraph\" >\u672d\u306b\u7d75\u67c4\u3092\u8ffd\u52a0\uff1a\u6708\u3084\u9e7f\u306e\u7d75\u3092\u4ed6\u306e\u672d\u306b\u8ffd\u52a0\u3059\u308b\u3053\u3068\u3067\u5f79\u304c\u63c3\u3044\u3084\u3059\u304f\u306a\u308a\u307e\u3059\u3002\u4e00\u3064\u306e\u672d\u306b\u732a\u3001\u9e7f\u3001\u8776\u3092\u8ffd\u52a0\u3059\u308c\u3070\u3001\u4e00\u679a\u3067\u732a\u9e7f\u8776\u3092\u63c3\u3048\u308b\u3053\u3068\u3082\u53ef\u80fd\u3002</p></li><li><p class=\"bb_paragraph\" >\u5f79\u306e\u30ec\u30d9\u30eb\u30a2\u30c3\u30d7\uff1a\u5f79\u306e\u30ec\u30d9\u30eb\u304c\u4e0a\u304c\u308b\u3068\u5f79\u304c\u6301\u3064\u70b9\u6570\u304c\u4e0a\u304c\u308a\u3001\u30c0\u30e1\u30fc\u30b8\u5897\u52a0\u306b\u3064\u306a\u304c\u308a\u307e\u3059\u3002</p></li></ul><p class=\"bb_paragraph\" >\u25a0\u52d5\u7269\u30ab\u30fc\u30c9</p><p class=\"bb_paragraph\" >\u30b7\u30e7\u30c3\u30d7\u3067\u306f\u304b\u308f\u3044\u3044\u52d5\u7269\u30ab\u30fc\u30c9\u3082\u8cfc\u5165\u3067\u304d\u307e\u3059\u3002</p><p class=\"bb_paragraph\" >\u30c0\u30e1\u30fc\u30b8\u500d\u7387\u30a2\u30c3\u30d7\u3084\u52dd\u5229\u6642\u306e\u53d6\u5f97\uff04\u30a2\u30c3\u30d7\u306a\u3069\u69d8\u3005\u306a\u52b9\u679c\u3092\u6301\u3063\u3066\u3044\u307e\u3059\u3002</p><p class=\"bb_paragraph\" >\u52b9\u679c\u3092\u7d44\u307f\u5408\u308f\u305b\u308b\u3053\u3068\u3067\u3069\u3093\u306a\u5f37\u6575\u306b\u3082\u7acb\u3061\u5411\u304b\u3046\u3053\u3068\u304c\u3067\u304d\u308b\u306e\u3067\u3001\u3042\u306a\u305f\u3060\u3051\u306e\u7d44\u307f\u5408\u308f\u305b\u3092\u898b\u3064\u3051\u307e\u3057\u3087\u3046\u3002</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\u672d\u3084\u5f79\u3092\u5f37\u5316\u3057\u3066\u3001\u52d5\u7269\u30ab\u30fc\u30c9\u306e\u52b9\u679c\u3092\u7d44\u307f\u5408\u308f\u305b\u308b\u3053\u3068\u3067\u3069\u3093\u3069\u3093\u5f37\u304f\u306a\u3063\u3066\u3044\u304d\u307e\u3059\u3002</p><p class=\"bb_paragraph\" >1\u5146\u70b9\u3082\u306e\u5927\u30c0\u30e1\u30fc\u30b8\u3092\u305f\u305f\u304d\u51fa\u3059\u3053\u3068\u3082\u3001\u65e2\u5b58\u306e\u82b1\u672d\u3067\u306f\u898b\u305f\u3053\u3068\u306a\u3044\u672a\u77e5\u306a\u308b\u5f79\u3092\u63c3\u3048\u308b\u3053\u3068\u3082\u5922\u3067\u306f\u3042\u308a\u307e\u305b\u3093\u3002</p><p class=\"bb_paragraph\" >\u3042\u306a\u305f\u306f\u3069\u308c\u3060\u3051\u306e\u30c0\u30e1\u30fc\u30b8\u3092\u51fa\u305b\u307e\u3059\u304b\u30fb\u30fb\u30fb</p>",
    "about_the_game": "<p class=\"bb_paragraph\" >\u30ed\u30fc\u30b0\u30e9\u30a4\u30af\u30fb\u30c7\u30c3\u30ad\u30d3\u30eb\u30c9\u30fb\u30cf\u30a4\u30d1\u30fc\u30a4\u30f3\u30d5\u30ec\u30fb\u82b1\u672d\u30d0\u30c8\u30eb\u3001\u305d\u308c\u304c\u300c\u82b1\u672d\u306e\u864e\u300d\uff01</p><p class=\"bb_paragraph\" >\u300c\u82b1\u672d\u306e\u864e\u300d\u306f\u82b1\u672d\u306b\u30c7\u30c3\u30ad\u69cb\u7bc9\u578b\u30ed\u30fc\u30b0\u30e9\u30a4\u30c8\u3092\u639b\u3051\u5408\u308f\u305b\u305f\u30b2\u30fc\u30e0\u3067\u3059\u3002</p><p class=\"bb_paragraph\" >\u30d7\u30ec\u30a4\u30e4\u30fc\u306e\u9078\u629e\u6b21\u7b2c\u3067\u7acb\u3061\u306f\u3060\u304b\u308b\u5f37\u6575\u3078\u306e\u52dd\u7387\u304c\u5909\u308f\u308a\u307e\u3059\u3002</p><p class=\"bb_paragraph\" >\u25a0\u3044\u3056\u3001\u82b1\u672d\u30d0\u30c8\u30eb</p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u6575\u3078\u306e\u30c0\u30e1\u30fc\u30b8\uff1a\u82b1\u672d\u3067\u63c3\u3048\u305f\u5f79\u306e\u70b9\u6570\u306b\u69d8\u3005\u306a\u500d\u7387\u3092\u639b\u3051\u305f\u30dd\u30a4\u30f3\u30c8\u304c\u6575\u3078\u306e\u30c0\u30e1\u30fc\u30b8\u306b\u3064\u306a\u304c\u308a\u307e\u3059\u3002</p></li><li><p class=\"bb_paragraph\" >\u52dd\u8ca0 or \u3053\u3044\u3053\u3044\uff1a\u5f79\u3092\u63c3\u3048\u305f\u3089\u30d7\u30ec\u30a4\u30e4\u30fc\u306f\u52dd\u8ca0\u304b\u3053\u3044\u3053\u3044\u3092\u9078\u629e\u3057\u306a\u3051\u308c\u3070\u306a\u308a\u307e\u305b\u3093\u3002\u3000\u52dd\u8ca0\u306a\u3089\u6575\u306b\u30c0\u30e1\u30fc\u30b8\u3092\u4e0e\u3048\u3001\u3053\u3044\u3053\u3044\u306a\u3089\u82b1\u672d\u30d0\u30c8\u30eb\u3092\u7d9a\u3051\u3089\u308c\u307e\u3059\u3002\u3053\u3044\u3053\u3044\u3092\u3057\u305f\u5834\u5408\u3001\u5225\u306e\u5f79\u3092\u63c3\u3048\u3066\u3055\u3089\u306a\u308b\u30c0\u30e1\u30fc\u30b8\u5897\u52a0\u3092\u72d9\u3046\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002</p></li><li><p class=\"bb_paragraph\" >\u30b8\u30e3\u30c3\u30af\u30dd\u30c3\u30c8\uff1a\u3053\u3044\u3053\u3044\u3057\u305f\u3068\u304d\u306b\u6e9c\u307e\u308b\u30ab\u30a6\u30f3\u30c8\u3067\u30c0\u30e1\u30fc\u30b8\u8a08\u7b97\u6642\u306e\u500d\u7387\u3068\u3057\u3066\u6271\u308f\u308c\u308b\u3002\u305f\u3060\u3057\u3001\u6575\u304c\u4e0a\u304c\u308b\u6642\u306e\u30c0\u30e1\u30fc\u30b8\u8a08\u7b97\u306b\u3082\u9069\u7528\u3055\u308c\u308b\u306e\u6ce8\u610f\u304c\u5fc5\u8981\u3067\u3059\u3002</p></li></ul><p class=\"bb_paragraph\" >\u25a0\u30b7\u30e7\u30c3\u30d7\u3067\u5f37\u5316\u3057\u3088\u3046</p><p class=\"bb_paragraph\" >\u30b7\u30e7\u30c3\u30d7\u3067\u82b1\u672d\u3092\u5f37\u5316\u3059\u308b\u30ab\u30fc\u30c9\u3092\u8cfc\u5165\u3057\u3066\u30d0\u30c8\u30eb\u306e\u52dd\u7387\u3092\u4e0a\u3052\u307e\u3057\u3087\u3046\u3002</p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u672d\u306e\u70b9\u6570\u3092\u5897\u52a0\uff1a\u5404\u672d\u306e\u6301\u3064\u70b9\u6570\u3092\u5897\u3084\u3057\u3066\u30c0\u30e1\u30fc\u30b8\u3092\u5e95\u4e0a\u3052\u3067\u304d\u307e\u3059\u3002</p></li><li><p class=\"bb_paragraph\" >\u672d\u306b\u7d75\u67c4\u3092\u8ffd\u52a0\uff1a\u6708\u3084\u9e7f\u306e\u7d75\u3092\u4ed6\u306e\u672d\u306b\u8ffd\u52a0\u3059\u308b\u3053\u3068\u3067\u5f79\u304c\u63c3\u3044\u3084\u3059\u304f\u306a\u308a\u307e\u3059\u3002\u4e00\u3064\u306e\u672d\u306b\u732a\u3001\u9e7f\u3001\u8776\u3092\u8ffd\u52a0\u3059\u308c\u3070\u3001\u4e00\u679a\u3067\u732a\u9e7f\u8776\u3092\u63c3\u3048\u308b\u3053\u3068\u3082\u53ef\u80fd\u3002</p></li><li><p class=\"bb_paragraph\" >\u5f79\u306e\u30ec\u30d9\u30eb\u30a2\u30c3\u30d7\uff1a\u5f79\u306e\u30ec\u30d9\u30eb\u304c\u4e0a\u304c\u308b\u3068\u5f79\u304c\u6301\u3064\u70b9\u6570\u304c\u4e0a\u304c\u308a\u3001\u30c0\u30e1\u30fc\u30b8\u5897\u52a0\u306b\u3064\u306a\u304c\u308a\u307e\u3059\u3002</p></li></ul><p class=\"bb_paragraph\" >\u25a0\u52d5\u7269\u30ab\u30fc\u30c9</p><p class=\"bb_paragraph\" >\u30b7\u30e7\u30c3\u30d7\u3067\u306f\u304b\u308f\u3044\u3044\u52d5\u7269\u30ab\u30fc\u30c9\u3082\u8cfc\u5165\u3067\u304d\u307e\u3059\u3002</p><p class=\"bb_paragraph\" >\u30c0\u30e1\u30fc\u30b8\u500d\u7387\u30a2\u30c3\u30d7\u3084\u52dd\u5229\u6642\u306e\u53d6\u5f97\uff04\u30a2\u30c3\u30d7\u306a\u3069\u69d8\u3005\u306a\u52b9\u679c\u3092\u6301\u3063\u3066\u3044\u307e\u3059\u3002</p><p class=\"bb_paragraph\" >\u52b9\u679c\u3092\u7d44\u307f\u5408\u308f\u305b\u308b\u3053\u3068\u3067\u3069\u3093\u306a\u5f37\u6575\u306b\u3082\u7acb\u3061\u5411\u304b\u3046\u3053\u3068\u304c\u3067\u304d\u308b\u306e\u3067\u3001\u3042\u306a\u305f\u3060\u3051\u306e\u7d44\u307f\u5408\u308f\u305b\u3092\u898b\u3064\u3051\u307e\u3057\u3087\u3046\u3002</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\u672d\u3084\u5f79\u3092\u5f37\u5316\u3057\u3066\u3001\u52d5\u7269\u30ab\u30fc\u30c9\u306e\u52b9\u679c\u3092\u7d44\u307f\u5408\u308f\u305b\u308b\u3053\u3068\u3067\u3069\u3093\u3069\u3093\u5f37\u304f\u306a\u3063\u3066\u3044\u304d\u307e\u3059\u3002</p><p class=\"bb_paragraph\" >1\u5146\u70b9\u3082\u306e\u5927\u30c0\u30e1\u30fc\u30b8\u3092\u305f\u305f\u304d\u51fa\u3059\u3053\u3068\u3082\u3001\u65e2\u5b58\u306e\u82b1\u672d\u3067\u306f\u898b\u305f\u3053\u3068\u306a\u3044\u672a\u77e5\u306a\u308b\u5f79\u3092\u63c3\u3048\u308b\u3053\u3068\u3082\u5922\u3067\u306f\u3042\u308a\u307e\u305b\u3093\u3002</p><p class=\"bb_paragraph\" >\u3042\u306a\u305f\u306f\u3069\u308c\u3060\u3051\u306e\u30c0\u30e1\u30fc\u30b8\u3092\u51fa\u305b\u307e\u3059\u304b\u30fb\u30fb\u30fb</p>",
    "short_description": "\u300c\u82b1\u672d\u306e\u864e\u300d\u306f\u82b1\u672d\u306b\u30c7\u30c3\u30ad\u69cb\u7bc9\u578b\u30ed\u30fc\u30b0\u30e9\u30a4\u30c8\u3092\u639b\u3051\u5408\u308f\u305b\u305f\u30b2\u30fc\u30e0\u3067\u3059\u3002\u672d\u3084\u5f79\u3092\u5f37\u5316\u3057\u3066\u3001\u52d5\u7269\u30ab\u30fc\u30c9\u3092\u96c6\u3081\u3066\u6575\u306b\u81a8\u5927\u306a\u30c0\u30e1\u30fc\u30b8\u3092\u53e9\u304d\u8fbc\u307f\u307e\u3057\u3087\u3046\u3002\u30ed\u30fc\u30b0\u30e9\u30a4\u30af\u30fb\u30c7\u30c3\u30ad\u30d3\u30eb\u30c9\u30fb\u30cf\u30a4\u30d1\u30fc\u30a4\u30f3\u30d5\u30ec\u30fb\u82b1\u672d\u30d0\u30c8\u30eb\u306e\u4e16\u754c\u3092\u582a\u80fd\u3057\u3066\u304f\u3060\u3055\u3044\u3002",
