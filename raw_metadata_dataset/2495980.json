ss=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2495980/extras/bc34c902db6a7dc54074de1a82c98067.poster.avif?t=1692526835\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2495980/extras/bc34c902db6a7dc54074de1a82c98067.webm?t=1692526835\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2495980/extras/bc34c902db6a7dc54074de1a82c98067.mp4?t=1692526835\" type=\"video/mp4\"></video></span><br><br>Music by Ben Esdor",
