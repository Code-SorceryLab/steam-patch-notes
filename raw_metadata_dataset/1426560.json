 src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1426560/extras/2b5bb5fa2eb5a651976c9368d47ae5ee.mp4?t=1750035958\" type=\"video/mp4\"></video></div></p><p class=\"bb_paragraph\">A variety of brain-teasing puzzles</p><p class=\"bb_paragraph\"><div class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1426560/extras/39990d617c457dad79d5b6f36e780bea.poster.avif?t=1750035958\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1426560/extras/39990d617c457dad79d5b6f36e780bea.webm?t=1750035958\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1426560/extras/39990d617c457dad79d5b6f36e780bea.mp4?t=1750035958\" type=\"video/mp4\"></video></div></p><p class=\"bb_paragraph\">Unexpected and cleverly crafted plot twists</p><p class=\"bb_paragraph\"><div class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1426560/extras/3afde9c7851776b24e8c742ae326197c.poster.avif?t=1750035958\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1426560/extras/3afde9c7851776b24e8c742ae326197c.webm?t=1750035958\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1426560/extras/3afde9c7851776b24e8c742ae326197c.mp4?t=1750035958\" type=\"video/mp4\"></video></div></p>",
