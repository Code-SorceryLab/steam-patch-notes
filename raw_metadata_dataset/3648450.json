ed loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3648450/extras/4c2fce2c7fe9c0b6c387dbc1fdc854c9.poster.avif?t=1755442938\" width=960 height=540 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3648450/extras/4c2fce2c7fe9c0b6c387dbc1fdc854c9.webm?t=1755442938\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3648450/extras/4c2fce2c7fe9c0b6c387dbc1fdc854c9.mp4?t=1755442938\" type=\"video/mp4\"></video></span></p>",
