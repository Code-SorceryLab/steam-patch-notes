tore_item_assets/steam/apps/1833770/extras/b017a896d5ed79b3d1f010c441141147.poster.avif?t=1674049627\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1833770/extras/b017a896d5ed79b3d1f010c441141147.webm?t=1674049627\" type=\"video/webm; codecs=vp9\"></video></div>",
