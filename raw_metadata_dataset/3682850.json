cba33b5288f2b076db6a68.poster.avif?t=1752277227\" width=444 height=560 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3682850/extras/c7a3790045cba33b5288f2b076db6a68.webm?t=1752277227\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3682850/extras/c7a3790045cba33b5288f2b076db6a68.mp4?t=1752277227\" type=\"video/mp4\"></video></span></p>",
