ic.com/store_item_assets/steam/apps/3551540/extras/8b9812472e0b82dbba413a6db6ebd6cd.webm?t=1755686640\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3551540/extras/8b9812472e0b82dbba413a6db6ebd6cd.mp4?t=1755686640\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p>",
