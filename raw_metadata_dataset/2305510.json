y muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2305510/extras/4bcf0fa9f650f05b7347617141e9be17.poster.avif?t=1731262969\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2305510/extras/4bcf0fa9f650f05b7347617141e9be17.webm?t=1731262969\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2305510/extras/4bcf0fa9f650f05b7347617141e9be17.mp4?t=1731262969\" type=\"video/mp4\"></video></span>",
