    "detailed_description": "<h2 class=\"bb_tag\" ><strong>\u6e38\u620f\u793c\u5305\u53ca\u6e38\u620f\u798f\u5229\u8bf7\u52a0\u5ba2\u670dQQ\uff1a 3951285802\uff0c\u6dfb\u52a0\u9700\u5907\u6ce8\u300a\u4e5d\u5dde\u5251\u6b4c\u300b</strong></h2><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\u300a\u4e5d\u5dde\u5251\u6b4c\u300b\u662f\u4e00\u6b3e3D\u6b66\u4fa0MMORPG\uff0c\u4ee5\u9876\u5c16\u7684\u6b21\u4e16\u4ee3\u6280\u672f\u6253\u9020\u6700\u771f\u5b9e\u7684\u7384\u5e7b\u6b66\u4fa0\u4e16\u754c\u3002\u5feb\u610f\u6069\u4ec7\u7684\u5e9e\u5927\u6c5f\u6e56\uff0c\u5320\u5fc3\u6253\u9020\u7684\u6c89\u6d78\u5f0f\u5730\u56fe\uff0c\u51cc\u5389\u5199\u610f\u7684\u8f7b\u529f\uff0c\u6311\u6218\u6570\u4e4b\u4e0d\u5c3d\u7684\u5947\u73cd\u5f02\u517d\uff0c\u7cbe\u5f69\u7edd\u4f26\u7684\u534e\u5c71\u8bba\u5251\u548c\u5d69\u5c71\u4e89\u9738\uff0c\u6253\u9020\u53ea\u5c5e\u4e8e\u4f60\u7684\u72ec\u4e00\u65e0\u4e8c\u7684\u6c5f\u6e56\u68a6\uff01</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\u3010\u4e30\u5bcc\u73a9\u6cd5 \u8da3\u5473\u6b66\u4fa0\u6210\u957f\u4e4b\u8def\u3011</p><p class=\"bb_paragraph\" >\u300a\u4e5d\u5dde\u5251\u6b4c\u300b\u62e5\u6709\u4e30\u5bcc\u7684PVE\u73a9\u6cd5\uff0c\u5355\u4eba\u8fdb\u5165\u65e0\u8d1f\u62c5\u5237\u672c\uff0c\u591a\u4eba\u7ec4\u961f\u5171\u4eab\u4e30\u539a\u5956\u52b1\uff0c\u8f7b\u677e\u83b7\u53d6\u7ecf\u9a8c\u3001\u91d1\u5e01\u3001\u88c5\u5907\u7b49\u6210\u957f\u8d44\u6e90\uff0c\u4e3a\u73a9\u5bb6\u63d0\u4f9b\u8f7b\u677e\u6709\u8da3\u7684\u65e5\u5e38\u6e38\u620f\u4f53\u9a8c\u3002\u6d77\u91cf\u7ecf\u9a8c\u52a9\u529b\u5feb\u901f\u5347\u7ea7\u7684\u8fbe\u6469\u6697\u6bbf\u3001\u901a\u5173\u4e00\u6b21\u91d1\u5e01\u7206\u68da\u7684\u91d1\u94b1\u6bbf\u3001\u7ec4\u961f\u89e3\u9501\u5927\u91cf\u795e\u88c5\u7684\u5251\u9b54\u5e7b\u5883\uff0c\u591a\u6837\u73a9\u6cd5\u675c\u7edd\u4e4f\u5473~</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\u3010\u88c5\u5907\u94f8\u6210 \u953b\u9020\u795e\u5251\u53f1\u54a4\u6c5f\u6e56\u3011</p><p class=\"bb_paragraph\" >\u884c\u8d70\u6c5f\u6e56\uff0c\u9664\u4e86\u8981\u7cbe\u901a\u5185\u529b\u5fc3\u6cd5\uff0c\u4e00\u8eab\u7cbe\u5fc3\u6253\u9020\u7684\u88c5\u5907\u4e5f\u4e0d\u53ef\u6216\u7f3a\u3002\u300a\u4e5d\u5dde\u5251\u6b4c\u300b\u7684\u88c5\u5907\u953b\u9020\u7cfb\u7edf\u4e2d\u5305\u542b\u6709\u88c5\u5907\u5f3a\u5316\u3001\u7bc6\u523b\u53ca\u5b9d\u77f3\u9576\u5d4c\u7b49\u591a\u79cd\u953b\u9020\u9014\u5f84\uff0c\u96c6\u9f50\u4e00\u5957\u540c\u9636\u5957\u88c5\u66f4\u53ef\u6fc0\u6d3b\u88c5\u5907\u5171\u9e23\uff0c\u540e\u671f\u8fd8\u80fd\u901a\u8fc7\u5408\u6210\u73a9\u6cd5\u6253\u9020\u4e2a\u4eba\u4e13\u5c5e\u9ad8\u9636\u88c5\u5907\uff0c\u6218\u529b\u66b4\u6da8\u6a2a\u884c\u6b66\u6797\uff0c\u6210\u4e3a\u4e00\u4ee3\u4fa0\u5ba2\u4e0d\u662f\u68a6\uff01</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\u3010BOSS\u4e89\u593a \u6311\u6218\u6b66\u6797\u98ce\u4e91\u4eba\u7269\u3011</p><p class=\"bb_paragraph\" >BOSS\u73a9\u6cd5\u662f\u300a\u4e5d\u5dde\u5251\u6b4c\u300b\u7684\u73cd\u7a00\u6750\u6599\u4e3b\u8981\u6765\u6e90\u4e4b\u4e00\uff0c\u73a9\u5bb6\u53ef\u4ee5\u901a\u8fc7\u4e16\u754cBOSS\u3001BOSS\u4e4b\u5bb6\u548c\u4e2a\u4ebaBOSS\u7b49\u73a9\u6cd5\u8fdb\u5165\u526f\u672c\uff0c\u5411\u6c5f\u6e56\u4f20\u8bf4\u4e2d\u7684\u5927\u4fa0\u53d1\u8d77\u6311\u6218\uff0c\u6311\u6218\u6210\u529f\u5373\u53ef\u83b7\u53d6\u6d77\u91cf\u5927\u795e\u6389\u843d\u7684\u968f\u8eab\u88c5\u5907\uff0c\u8fd8\u6709\u51e0\u7387\u83b7\u5f97\u73cd\u8d35\u7684\u7fc5\u8180\u53ca\u6697\u5668\u5916\u663e\u3002</p>",
    "about_the_game": "<h2 class=\"bb_tag\" ><strong>\u6e38\u620f\u793c\u5305\u53ca\u6e38\u620f\u798f\u5229\u8bf7\u52a0\u5ba2\u670dQQ\uff1a 3951285802\uff0c\u6dfb\u52a0\u9700\u5907\u6ce8\u300a\u4e5d\u5dde\u5251\u6b4c\u300b</strong></h2><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\u300a\u4e5d\u5dde\u5251\u6b4c\u300b\u662f\u4e00\u6b3e3D\u6b66\u4fa0MMORPG\uff0c\u4ee5\u9876\u5c16\u7684\u6b21\u4e16\u4ee3\u6280\u672f\u6253\u9020\u6700\u771f\u5b9e\u7684\u7384\u5e7b\u6b66\u4fa0\u4e16\u754c\u3002\u5feb\u610f\u6069\u4ec7\u7684\u5e9e\u5927\u6c5f\u6e56\uff0c\u5320\u5fc3\u6253\u9020\u7684\u6c89\u6d78\u5f0f\u5730\u56fe\uff0c\u51cc\u5389\u5199\u610f\u7684\u8f7b\u529f\uff0c\u6311\u6218\u6570\u4e4b\u4e0d\u5c3d\u7684\u5947\u73cd\u5f02\u517d\uff0c\u7cbe\u5f69\u7edd\u4f26\u7684\u534e\u5c71\u8bba\u5251\u548c\u5d69\u5c71\u4e89\u9738\uff0c\u6253\u9020\u53ea\u5c5e\u4e8e\u4f60\u7684\u72ec\u4e00\u65e0\u4e8c\u7684\u6c5f\u6e56\u68a6\uff01</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\u3010\u4e30\u5bcc\u73a9\u6cd5 \u8da3\u5473\u6b66\u4fa0\u6210\u957f\u4e4b\u8def\u3011</p><p class=\"bb_paragraph\" >\u300a\u4e5d\u5dde\u5251\u6b4c\u300b\u62e5\u6709\u4e30\u5bcc\u7684PVE\u73a9\u6cd5\uff0c\u5355\u4eba\u8fdb\u5165\u65e0\u8d1f\u62c5\u5237\u672c\uff0c\u591a\u4eba\u7ec4\u961f\u5171\u4eab\u4e30\u539a\u5956\u52b1\uff0c\u8f7b\u677e\u83b7\u53d6\u7ecf\u9a8c\u3001\u91d1\u5e01\u3001\u88c5\u5907\u7b49\u6210\u957f\u8d44\u6e90\uff0c\u4e3a\u73a9\u5bb6\u63d0\u4f9b\u8f7b\u677e\u6709\u8da3\u7684\u65e5\u5e38\u6e38\u620f\u4f53\u9a8c\u3002\u6d77\u91cf\u7ecf\u9a8c\u52a9\u529b\u5feb\u901f\u5347\u7ea7\u7684\u8fbe\u6469\u6697\u6bbf\u3001\u901a\u5173\u4e00\u6b21\u91d1\u5e01\u7206\u68da\u7684\u91d1\u94b1\u6bbf\u3001\u7ec4\u961f\u89e3\u9501\u5927\u91cf\u795e\u88c5\u7684\u5251\u9b54\u5e7b\u5883\uff0c\u591a\u6837\u73a9\u6cd5\u675c\u7edd\u4e4f\u5473~</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\u3010\u88c5\u5907\u94f8\u6210 \u953b\u9020\u795e\u5251\u53f1\u54a4\u6c5f\u6e56\u3011</p><p 