r><div class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1722820/extras/a100a30983338665ecc2a7eeaa118cd0.avif?t=1689094668\" /></div>",
