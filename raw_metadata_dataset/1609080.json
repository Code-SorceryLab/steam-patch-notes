deo class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1609080/extras/c7a0535d3a2b89f49fce65e828bd0d05.poster.avif?t=1727617283\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1609080/extras/c7a0535d3a2b89f49fce65e828bd0d05.webm?t=1727617283\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1609080/extras/c7a0535d3a2b89f49fce65e828bd0d05.mp4?t=1727617283\" type=\"video/mp4\"></video></div>",
