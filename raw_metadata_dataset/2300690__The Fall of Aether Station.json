8ec96b2668b57e29.webm?t=1725035993\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2300690/extras/135f6a9d2643cfd08ec96b2668b57e29.mp4?t=1725035993\" type=\"video/mp4\"></video></span><br><br><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2300690/extras/6e103729d5cef5ff00fd6c24b2a1f428.avif?t=1725035993\" /></span><br><strong><ul class=\"bb_ul\"><li>Move your ships to their optimal location!<br></li><li>Command entire wings of ships at one time!<br></li><li>Level up your units with veterancy skills to fit your playstyle!</li></ul></strong><br><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2300690/extras/4cab34047230fb746628df1ced9fa606.poster.avif?t=1725035993\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2300690/extras/4cab34047230fb746628df1ced9fa606.webm?t=1725035993\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2300690/extras/4cab34047230fb746628df1ced9fa606.mp4?t=1725035993\" type=\"video/mp4\"></video></span><br><br><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2300690/extras/ed29574fdbfd421f8d7761703299fd0b.avif?t=1725035993\" /></span><br><strong><ul class=\"bb_ul\"><li>15 Unique Levels<br></li><li>Challenging system effects to test even the most strategic minds<br></li><li>Modified wave progression for each level</li></ul></strong><br><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2300690/extras/20a1f820a445d450df31fb609320a065.poster.avif?t=1725035993\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_a