82e44e54e8f18c4755173ad50.poster.avif?t=1739018378\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1164690/extras/7f6d0a582e44e54e8f18c4755173ad50.webm?t=1739018378\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1164690/extras/7f6d0a582e44e54e8f18c4755173ad50.mp4?t=1739018378\" type=\"video/mp4\"></video></div><br><br><strong>Special attacks</strong><br>Crush your foes with devastating special attacks that will give you the upper hand in a battle.<br><br><div class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1164690/extras/540f1843411cfd1a3240af4448bd4102.poster.avif?t=1739018378\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1164690/extras/540f1843411cfd1a3240af4448bd4102.webm?t=1739018378\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1164690/extras/540f1843411cfd1a3240af4448bd4102.mp4?t=1739018378\" type=\"video/mp4\"></video></div><br><br><strong>Preternatural skills</strong><br>Unleash various up-gradable preternatural abilities that will aid you in battle, either defensively or offensively.",
