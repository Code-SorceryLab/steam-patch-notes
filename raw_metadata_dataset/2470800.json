86a679a01afedc051fd0011a322.poster.avif?t=1715633229\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2470800/extras/3001286a679a01afedc051fd0011a322.webm?t=1715633229\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2470800/extras/3001286a679a01afedc051fd0011a322.mp4?t=1715633229\" type=\"video/mp4\"></video></span>",
