    "detailed_description": "<h2 class=\"bb_tag\" >\u521b\u4f5c\u80cc\u666f\uff1a</h2><p class=\"bb_paragraph\" >\u300a\u5e1d\u738b\u62c6\u8fc1\u529e\u300b\u662f\u4e00\u6b3e\u57fa\u4e8e\u539f\u4f5c\u6e38\u620f\u300a\u4ee3\u53f7\u9e22\u300b\u521b\u4f5c\u7684\u9088\u5e7fCP\u5411\u5267\u60c5\u89e3\u8c1c\u7c7bRPG\u540c\u4eba\u6e38\u620f\u3002</p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" >\u6545\u4e8b\u5185\u5bb9\uff1a</h2><p class=\"bb_paragraph\" >\u4e1c\u6d77\u518d\u5f80\u4e1c\uff0c\u4f1a\u6709\u9c9b\u4eba\u5417\uff1f\u9c7c\u5c3e\u5f88\u597d\u5403\u7684\u3002\u54ed\u51fa\u6765\u7684\u73cd\u73e0\u78e8\u6210\u7c89\uff0c\u80af\u5b9a\u5f88\u663e\u767d\u5427\u3002\u5e74\u5c11\u65f6\u4f60\u4eec\u6324\u5728\u6cb3\u8fb9\u95f2\u8c08\uff0c\u7eb5\u662f\u4e71\u4e16\uff0c\u4eb2\u4fe1\u597d\u53cb\u90fd\u5728\u8eab\u8fb9\uff0c\u4e5f\u80fd\u5077\u5f97\u51e0\u5206\u6e05\u95f2\u3002</p><p class=\"bb_paragraph\" >\u540e\u6765\u4f60\u6210\u4e3a\u4e86\u5929\u547d\u6240\u5f52\uff0c\u53ef\u8eab\u8fb9\u518d\u4e5f\u4e0d\u89c1\u65e7\u65e5\u5e76\u80a9\u800c\u7acb\u7684\u8eab\u5f71\u3002\u4e1c\u6d77\u4e0d\u89c1\u9c9b\u4eba\uff0c\u53ea\u89c1\u5217\u5217\u6210\u884c\u7684\u5546\u8239\u548c\u6218\u8239\u3002</p><p class=\"bb_paragraph\" >\u53f2\u4e66\u4e0a\u8bf4\uff0c\u6587\u6c49\u5929\u5973\uff0c\u627f\u8f7d\u5929\u547d\uff0c\u5f00\u521b\u4e00\u4ee3\u76db\u4e16\u3002</p><p class=\"bb_paragraph\" >\u53ef\u8df3\u51fa\u547d\u6570\u4e0e\u8eab\u4efd\u7684\u6846\u67b6\uff0c\u6216\u8bb8\u7559\u5728\u53f2\u4e66\u4e0a\u7684\u7ed3\u5c40\u5e76\u4e0d\u662f\u5c5e\u4e8e\u4f60\u771f\u6b63\u7684\u7ed3\u5c40\u3002</p><p class=\"bb_paragraph\" >\u524d\u811a\u521a\u4e0b\u4e86\u8fd9\u8f88\u5b50\u7684\u73ed\uff0c\u540e\u811a\u5c31\u5728\u5730\u5e9c\u9886\u5230\u4e86\u65b0\u4efb\u52a1......\u8fd8\u597d\u8fd8\u597d\uff0c \u8fd9\u6b21\u4e0d\u6253\u4ed7\u4e0d\u653f\u53d8\uff0c\u53ea\u5728\u5730\u5e9c\u89c2\u5149\uff0c \u597d\u6d88\u606f\u662f\uff0c\u8001\u670b\u53cb\u8fd8\u5728\u7b49\u4f60\uff0c\u574f\u6d88\u606f\u662f\u2026\u2026\u55ef\uff0c\u4ed6\u53ef\u80fd\u8bb0\u5f97\u6bd4\u4f60\u8fd8\u6e05\u695a\u3002 </p><p class=\"bb_paragraph\" >\u662f\u8bef\u4f1a\u3001\u6267\u5ff5\uff0c\u8fd8\u662f\u2026\u2026\u4e00\u70b9\u70b9\u6ca1\u8bf4\u51fa\u53e3\u7684\u5c0f\u5fc3\u601d\uff1f\u8c01\u77e5\u9053\u5462\uff0c\u53cd\u6b63\u4f60\u4eec\u4fe9\u73b0\u5728\u90fd\u8d70\u4e0d\u6389\u4e86\u3002</p><p class=\"bb_paragraph\" >\u8c0b\u58eb\u7b49\u592a\u4e45\u90fd\u7b49\u8fc7\u671f\u4e86\uff0c\u4e0d\u4e0a\u94a9\u600e\u4e48\u529e\uff1f\u62ff\u88c5\u8fc7\u73cd\u73e0\u7c89\u7684\u7897\u6765\u635e\u4e00\u4e0b\uff01</p><h2 class=\"bb_tag\" >\u58f0\u660e\uff1a</h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u672c\u4f5c\u4e3a\u6e38\u620f\u7231\u597d\u8005\u57fa\u4e8e\u5bf9\u89d2\u8272\u7684\u559c\u7231\u548c\u6b23\u8d4f\u5236\u4f5c\u7684\u514d\u8d39\u540c\u4eba\u6e38\u620f\uff0c\u4ec5\u4f9b\u4ea4\u6d41\u5206\u4eab\uff0c\u975e\u76c8\u5229\u6027\u9879\u76ee\u3002\u540c\u65f6\u4e0d\u6d89\u53ca\u4efb\u4f55\u5546\u4e1a\u7528\u9014\u4e0e\u76c8\u5229\u884c\u4e3a\u3002</p></li><li><p class=\"bb_paragraph\" >\u90e8\u5206\u573a\u666f\u6a21\u578b\u7d20\u6750\u6765\u81ea\u4e92\u8054\u7f51\u516c\u5f00\u5206\u4eab\u3002\u5982\u65e0\u610f\u95f4\u4fb5\u72af\u5230\u60a8\u7684\u6743\u76ca\uff0c\u8bf7\u53ca\u65f6\u4e0e\u6211\u4eec\u8054\u7cfb\uff0c\u6211\u4eec\u5c06\u5728\u7b2c\u4e00\u65f6\u95f4\u4fee\u6539\uff0c\u5e76\u5728\u6b64\u5411\u60a8\u81f4\u4ee5\u8bda\u631a\u7684\u6b49\u610f\u3002</p></li><li><p class=\"bb_paragraph\" >\u672c\u4f5c\u4e3a\u540c\u4eba\u521b\u4f5c\uff0c\u4e0d\u4ee3\u8868\u4efb\u4f55\u7acb\u573a\u6216\u89c2\u70b9\uff0c\u4ea6\u65e0\u610f\u5f71\u54cd\u539f\u4f5c\u8bbe\u5b9a\u53ca\u5267\u60c5\u6216\u89d2\u8272\u89e3\u8bfb\u3002</p></li></ul><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" >\u5236\u4f5c\u4eba\u5458\uff1a</h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u73a9\u6cd5\uff1a\u4e38\u5c71\u5947\u8ff9 &amp; \u51b2\u6d6a\u5438\u732b</p></li><li><p class=\"bb_paragraph\" >\u7a0b\u5e8f\uff1a\u51b2\u6d6a\u5438\u732b</p></li><li><p class=\"bb_paragraph\" >\u5267\u672c\uff1a\u4e38\u5c71\u5947\u8ff9</p></li><li><p class=\"bb_paragraph\" >\u89d2\u8272\u6a21\u578b\uff1a\u51b2\u6d6a\u5438\u732b</p></li><li><p class=\"bb_paragraph\" >\u6a21\u578b\u52a8\u753b\uff1a\u51b2\u6d6a\u5438\u732b</p></li><li><p class=\"bb_paragraph\" >\u89d2\u8272\u7acb\u7ed8\uff1a\u51b2\u6d6a\u5438\u732b</p></li><li><p class=\"bb_paragraph\" >\u6e38\u620fCG\uff1a\u51b2\u6d6a\u5438\u732b</p></li><li><p class=\"bb_paragraph\" >\u6e38\u620f\u56fe\u6807\uff1a\u4e38\u5c71\u5947\u8ff9</p></li><li><p class=\"bb_paragraph\" >\u4e3b\u754c\u9762\uff1a\u4e38\u5c71\u5947\u8ff9</p></li><li><p class=\"bb_paragraph\" >Steam\u6210\u5c31\uff1a\u4e38\u5c71\u5947\u8ff9</p></li><li><p class=\"bb_paragraph\" >\u9b42\u9b42\u7acb\u7ed8\uff1a\u4e38\u5c71\u5947\u8ff9</p></li><li><p class=\"bb_paragraph\" >\u6e38\u620f\u6d4b\u8bd5\uff08\u6309\u5b8c\u6210\u987a\u5e8f\u6392\u540d\uff09\uff1a\u51b2\u6d6a\u5438\u732b\u3001\u4e16\u754c\u8170\u690e\u4fdd\u62a4\u534f\u4f1a &amp; \u6050\u6016\u9f20\u3001\u4e38\u5c71\u5947\u8ff9\u3001\u6a59\u5b50\u3001\u6155\u5bb9\u96ea\u73c2\u3001Bunnye\u53f6\u3001\u7267\u53ef</p></li></ul><p class=\"bb_paragraph\" ></p>",
    "about_the_game": "<h2 class=\"bb_tag\" >\u521b\u4f5c\u80cc\u666f\uff1a</h2><p class=\"bb_paragraph\" >\u300a\u5e1d\u738b\u62c6\u8fc1\u529e\u300b\u662f\u4e00\u6b3e\u57fa\u4e8e\u539f\u4f5c\u6e38\u620f\u300a\u4ee3\u53f7\u9e22\u300b\u521b\u4f5c\u7684\u9088\u5e7fCP\u5411\u5267\u60c5\u89e3\u8c1c\u7c7bRPG\u540c\u4eba\u6e38\u620f\u3002</p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" >\u6545\u4e8b\u5185\u5bb9\uff1a</h2><p class=\"bb_paragraph\" >\u4e1c\u6d77\u518d\u5f80\u4e1c\uff0c\u4f1a\u6709\u9c9b\u4eba\u5417\uff1f\u9c7c\u5c3e\u5f88\u597d\u5403\u7684\u3002\u54ed\u51fa\u6765\u7684\u73cd\u73e0\u78e8\u6210\u7c89\uff0c\u80af\u5b9a\u5f88\u663e\u767d\u5427\u3002\u5e74\u5c11\u65f6\u4f60\u4eec\u6324\u5728\u6cb3\u8fb9\u95f2\u8c08\uff0c\u7eb5\u662f\u4e71\u4e16\uff0c\u4eb2\u4fe1\u597d\u53cb\u90fd\u5728\u8eab\u8fb9\uff0c\u4e5f\u80fd\u5077\u5f97\u51e0\u5206\u6e05\u95f2\u3002</p><p class=\"bb_paragraph\" >\u540e\u6765\u4f60\u6210\u4e3a\u4e86\u5929\u547d\u6240\u5f52\uff0c\u53ef\u8eab\u8fb9\u518d\u4e5f\u4e0d\u89c1\u65e7\u65e5\u5e76\u80a9\u800c\u7acb\u7684\u8eab\u5f71\u3002\u4e1c\u6d77\u4e0d\u89c1\u9c9b\u4eba\uff0c\u53ea\u89c1\u5217\u5217\u6210\u884c\u7684\u5546\u8239\u548c\u6218\u8239\u3002</p><p class=\"bb_paragraph\" >\u53f2\u4e66\u4e0a\u8bf4\uff0c\u6587\u6c49\u5929\u5973\uff0c\u627f\u8f7d\u5929\u547d\uff0c\u5f00\u521b\u4e00\u4ee3\u76db\u4e16\u3002</p><p class=\"bb_paragraph\" >\u53ef\u8df3\u51fa\u547d\u6570\u4e0e\u8eab\u4efd\u7684\u6846\u67b6\uff0c\u6216\u8bb8\u7559\u5728\u53f2\u4e66\u4e0a\u7684\u7ed3\u5c40\u5e76\u4e0d\u662f\u5c5e\u4e8e\u4f60\u771f\u6b63\u7684\u7ed3\u5c40\u3002</p><p class=\"bb_paragraph\" >\u524d\u811a\u521a\u4e0b\u4e86\u8fd9\u8f88\u5b50\u7684\u73ed\uff0c\u540e\u811a\u5c31\u5728\u5730\u5e9c\u9886\u5230\u4e86\u65b0\u4efb\u52a1......\u8fd8\u597d\u8fd8\u597d\uff0c \u8fd9\u6b21\u4e0d\u6253\u4ed7\u4e0d\u653f\u53d8\uff0c\u53ea\u5728\u5730\u5e9c\u89c2\u5149\uff0c \u597d\u6d88\u606f\u662f\uff0c\u8001\u670b\u53cb\u8fd8\u5728\u7b49\u4f60\uff0c\u574f\u6d88\u606f\u662f\u2026\u2026\u55ef\uff0c\u4ed6\u53ef\u80fd\u8bb0\u5f97\u6bd4\u4f60\u8fd8\u6e05\u695a\u3002 </p><p class=\"bb_paragraph\" >\u662f\u8bef\u4f1a\u3001\u6267\u5ff5\uff0c\u8fd8\u662f\u2026\u2026\u4e00\u70b9\u70b9\u6ca1\u8bf4\u51fa\u53e3\u7684\u5c0f\u5fc3\u601d\uff1f\u8c01\u77e5\u9053\u5462\uff0c\u53cd\u6b63\u4f60\u4eec\u4fe9\u73b0\u5728\u90fd\u8d70\u4e0d\u6389\u4e86\u3002</p><p class=\"bb_paragraph\" >\u8c0b\u58eb\u7b49\u592a\u4e45\u90fd\u7b49\u8fc7\u671f\u4e86\uff0c\u4e0d\u4e0a\u94a9\u600e\u4e48\u529e\uff1f\u62ff\u88c5\u8fc7\u73cd\u73e0\u7c89\u7684\u7897\u6765\u635e\u4e00\u4e0b\uff01</p><h2 class=\"bb_tag\" >\u58f0\u660e\uff1a</h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u672c\u4f5c\u4e3a\u6e38\u620f\u7231\u597d\u8005\u57fa\u4e8e\u5bf9\u89d2\u8272\u7684\u559c\u7231\u548c\u6b23\u8d4f\u5236\u4f5c\u7684\u514d\u8d39\u540c\u4eba\u6e38\u620f\uff0c\u4ec5\u4f9b\u4ea4\u6d41\u5206\u4eab\uff0c\u975e\u76c8\u5229\u6027\u9879\u76ee\u3002\u540c\u65f6\u4e0d\u6d89\u53ca\u4efb\u4f55\u5546\u4e1a\u7528\u9014\u4e0e\u76c8\u5229\u884c\u4e3a\u3002</p></li><li><p class=\"bb_paragraph\" >\u90e8\u5206\u573a\u666f\u6a21\u578b\u7d20\u6750\u6765\u81ea\u4e92\u8054\u7f51\u516c\u5f00\u5206\u4eab\u3002\u5982\u65e0\u610f\u95f4\u4fb5\u72af\u5230\u60a8\u7684\u6743\u76ca\uff0c\u8bf7\u53ca\u65f6\u4e0e\u6211\u4eec\u8054\u7cfb\uff0c\u6211\u4eec\u5c06\u5728\u7b2c\u4e00\u65f6\u95f4\u4fee\u6539\uff0c\u5e76\u5728\u6b64\u5411\u60a8\u81f4\u4ee5\u8bda\u631a\u7684\u6b49\u610f\u3002</p></li><li><p class=\"bb_paragraph\" >\u672c\u4f5c\u4e3a\u540c\u4eba\u521b\u4f5c\uff0c\u4e0d\u4ee3\u8868\u4efb\u4f55\u7acb\u573a\u6216\u89c2\u70b9\uff0c\u4ea6\u65e0\u610f\u5f71\u54cd\u539f\u4f5c\u8bbe\u5b9a\u53ca\u5267\u60c5\u6216\u89d2\u8272\u89e3\u8bfb\u3002</p></li></ul><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" >\u5236\u4f5c\u4eba\u5458\uff1a</h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u73a9\u6cd5\uff1a\u4e38\u5c71\u5947\u8ff9 &amp; \u51b2\u6d6a\u5438\u732b</p></li><li><p class=\"bb_paragraph\" >\u7a0b\u5e8f\uff1a\u51b2\u6d6a\u5438\u732b</p></li><li><p class=\"bb_paragraph\" >\u5267\u672c\uff1a\u4e38\u5c71\u5947\u8ff9</p></li><li><p class=\"bb_paragraph\" >\u89d2\u8272\u6a21\u578b\uff1a\u51b2\u6d6a\u5438\u732b</p></li><li><p class=\"bb_paragraph\" >\u6a21\u578b\u52a8\u753b\uff1a\u51b2\u6d6a\u5438\u732b</p></li><li><p class=\"bb_paragraph\" >\u89d2\u8272\u7acb\u7ed8\uff1a\u51b2\u6d6a\u5438\u732b</p></li><li><p class=\"bb_paragraph\" >\u6e38\u620fCG\uff1a\u51b2\u6d6a\u5438\u732b</p></li><li><p class=\"bb_paragraph\" >\u6e38\u620f\u56fe\u6807\uff1a\u4e38\u5c71\u5947\u8ff9</p></li><li><p class=\"bb_paragraph\" >\u4e3b\u754c\u9762\uff1a\u4e38\u5c71\u5947\u8ff9</p></li><li><p class=\"bb_paragraph\" >Steam\u6210\u5c31\uff1a\u4e38\u5c71\u5947\u8ff9</p></li><li><p class=\"bb_paragraph\" >\u9b42\u9b42\u7acb\u7ed8\uff1a\u4e38\u5c71\u5947\u8ff9</p></li><li><p class=\"bb_paragraph\" >\u6e38\u620f\u6d4b\u8bd5\uff08\u6309\u5b8c\u6210\u987a\u5e8f\u6392\u540d\uff09\uff1a\u51b2\u6d6a\u5438\u732b\u3001\u4e16\u754c\u8170\u690e\u4fdd\u62a4\u534f\u4f1a &amp; \u6050\u6016\u9f20\u3001\u4e38\u5c71\u5947\u8ff9\u3001\u6a59\u5b50\u3001\u6155\u5bb9\u96ea\u73c2\u3001Bunnye\u53f6\u3001\u7267\u53ef</p></li></ul><p class=\"bb_paragraph\" ></p>",
