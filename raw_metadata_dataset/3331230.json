{
    "type": "game",
    "name": "\u89c0\u5858 | Kwun Tong",
    "steam_appid": 3331230,
    "required_age": 0,
    "is_free": false,
    "detailed_description": "<p class=\"bb_paragraph\" ><strong>Made in Hong Kong. By Unreal Engine 5.5.4.</strong></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><strong>Map data from the Land Dept of the government of the HKSAR. </strong></p><p class=\"bb_paragraph\" ><strong>(Open3Dhk)</strong></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><strong>Background:</strong></p><p class=\"bb_paragraph\" >Kwun Tong is a short horror game that take place in an industrial district. People become soulless after economic collapse. Wandering on streets. Looking for money......</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><strong>Features:</strong></p><p class=\"bb_paragraph\" >- Game is about 60mins in length</p><p class=\"bb_paragraph\" >- Challenging boss fights</p><p class=\"bb_paragraph\" >- Minimal text and no document to read</p><p class=\"bb_paragraph\" >- Based on actual geometry</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><strong>Gameplay:</strong></p><p class=\"bb_paragraph\" >- 1st POV</p><p class=\"bb_paragraph\" >- Story with several chapters</p><p class=\"bb_paragraph\" >- Linear gameplay</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><strong>Settings:</strong></p><p class=\"bb_paragraph\" >- Supports Full Screen / Windowed Mode</p><p class=\"bb_paragraph\" >- Supports TSR</p><p class=\"bb_paragraph\" >- Supports HDR</p><p class=\"bb_paragraph\" >- No save feature. You can access different chapters freely from main menu</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >By Unreal Engine 5.5.4.</p>",
    "about_the_game": "<p class=\"bb_paragraph\" ><strong>Made in Hong Kong. By Unreal Engine 5.5.4.</strong></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><strong>Map data from the Land Dept of the government of the HKSAR. </strong></p><p class=\"bb_paragraph\" ><strong>(Open3Dhk)</strong></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><strong>Background:</strong></p><p class=\"bb_paragraph\" >Kwun Tong is a short horror game that take place in an industrial district. People become soulless after economic collapse. Wandering on streets. Looking for money......</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><strong>Features:</strong></p><p class=\"bb_paragraph\" >- Game is about 60mins in length</p><p class=\"bb_paragraph\" >- Challenging boss fights</p><p class=\"bb_paragraph\" >- Minimal text and no document to read</p><p class=\"bb_paragraph\" >- Based on actual geometry</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><strong>Gameplay:</strong></p><p class=\"bb_paragraph\" >- 1st POV</p><p class=\"bb_paragraph\" >- Story with several chapters</p><p class=\"bb_paragraph\" >- Linear gameplay</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><strong>Settings:</strong></p><p class=\"bb_paragraph\" >- Supports Full Screen / Windowed Mode</p><p class=\"bb_paragraph\" >- Supports TSR</p><p class=\"bb_paragraph\" >- Supports HDR</p><p class=\"bb_paragraph\" >- No save feature. You can access different chapters freely from main menu</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >By Unreal Engine 5.5.4.</p>",
