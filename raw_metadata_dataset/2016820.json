o class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2016820/extras/92d58f1a2a570a7c4509d5f99422741f.poster.avif?t=1741698655\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2016820/extras/92d58f1a2a570a7c4509d5f99422741f.webm?t=1741698655\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2016820/extras/92d58f1a2a570a7c4509d5f99422741f.mp4?t=1741698655\" type=\"video/mp4\"></video></div></p>",
