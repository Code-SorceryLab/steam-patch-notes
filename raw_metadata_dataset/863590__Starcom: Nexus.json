c=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/863590/extras/a3aa05e0f6b16bc0ca9f79d99a2528ed.webm?t=1723657109\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/863590/extras/a3aa05e0f6b16bc0ca9f79d99a2528ed.mp4?t=1723657109\" type=\"video/mp4\"></video></div>",
