type=\"video/mp4\"></video></div><br><br><div class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2106280/extras/954e4914ec69a9aa549e90ba10adb341.avif?t=1722710563\" /></div><br><div class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2106280/extras/d4ad5e4a6c4bdbecb6363d8c6fe9c1e4.avif?t=1722710563\" /></div>",
