661422f872.poster.avif?t=1715716618\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/347460/extras/0bba628360126f2873f349661422f872.webm?t=1715716618\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/347460/extras/0bba628360126f2873f349661422f872.mp4?t=1715716618\" type=\"video/mp4\"></video></div>",
