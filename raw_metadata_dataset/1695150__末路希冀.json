    "detailed_description": "<strong><h2 class=\"bb_tag\">\u6e38\u620f\u6982\u8ff0</h2></strong><br><br>\u300a\u672b\u8def\u5e0c\u5180\u300b\u662f\u4e00\u6b3e\u8bbe\u5b9a\u5728\u672b\u4e16\u540e\u7684\u751f\u5b58\u5192\u9669\u6e38\u620f\u3002\u4f60\u5c06\u4e3a\u4e86\u5728\u51f6\u9669\u7684\u672b\u4e16\u751f\u5b58\u800c\u7aed\u5c3d\u5168\u529b\uff0c\u5e76\u4e3a\u4e86\u751f\u5b58\u4e0b\u6765\u7684\u5e0c\u5180\u800c\u8e0f\u4e0a\u5192\u9669\u7684\u65c5\u9014\u3002\u6574\u7406\u597d\u4f60\u7684\u88c5\u5907\uff0c\u9009\u62e9\u4f60\u5728\u672b\u4e16\u751f\u5b58\u7684\u9053\u5177\uff0c\u672b\u4e16\u7684\u65c5\u9014\u5728\u5c31\u811a\u4e0b\uff01<br><br><strong><h2 class=\"bb_tag\">\u6e38\u620f\u7279\u70b9</h2></strong><br><br>\u00b7\u642d\u914d\u4f18\u826f\u7684\u97f3\u4e50\u97f3\u6548\uff0c\u6c89\u6d78\u5728\u63a2\u7d22\u3001\u6218\u6597\u3001\u751f\u5b58\u4e2d\u3002<br><br>\u00b7\u6574\u7406\u81ea\u5df1\u80cc\u5305\u5185\u7684\u751f\u5b58\u7269\u8d44\uff0c\u786e\u4fdd\u81ea\u5df1\u7684\u72b6\u6001\u826f\u597d\u53ef\u4ee5\u8fdb\u884c\u5192\u9669\u6218\u6597\u3002<br><br>\u00b7\u63a2\u7d22\u5730\u56fe\uff0c\u89e3\u9501\u65b0\u7684\u5730\u70b9\u4e0eNPC\u89d2\u8272\u3002<br><br>\u00b7\u4e0eNPC\u5bf9\u8bdd\u63a8\u8fdb\u5267\u60c5\uff0c\u7528\u624b\u4e2d\u7684\u5783\u573e\u6750\u6599\u548c\u4ed6\u4eec\u6362\u53d6\u751f\u5b58\u7269\u8d44\u3002<br><br>\u00b7\u505a\u51fa\u4f60\u7684\u9009\u62e9\uff0c\u4e0e\u4e27\u5c38\u3001\u53d8\u5f02\u602a\u7269\u95f4\u8fdb\u884c\u6218\u6597\u8fd8\u662f\u9003\u8d70\u3002<br><br>\u00b7\u83b7\u53d6\u66f4\u52a0\u5f3a\u529b\u7684\u88c5\u5907\uff0c\u63d0\u5347\u81ea\u5df1\u7684\u5c5e\u6027\u66f4\u597d\u7684\u5728\u672b\u4e16\u73af\u5883\u4e0b\u751f\u5b58\u3002<br><br>\u66f4\u591a\u6e38\u620f\u6700\u65b0\u6d88\u606f\u53ef\u4ee5\u52a0\u5165Q\u7fa4\u8fdb\u884c\u4e86\u89e3\u3002<br>\u5b98\u65b9Q\u7fa4-\u5c0f\u6e14\u573a\uff1a827921840",
