d3f7963c17cd9efa.poster.avif?t=1740751212\" width=600 height=240 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3503390/extras/5b4c561a654ab73cd3f7963c17cd9efa.webm?t=1740751212\" type=\"video/webm; codecs=vp9\"></video></span></p><h2 class=\"bb_tag\" >Win the intense race!</h2><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3503390/extras/1de683890a0effafc2e34fa6c72af3d4.poster.avif?t=1740751212\" width=600 height=240 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3503390/extras/1de683890a0effafc2e34fa6c72af3d4.webm?t=1740751212\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3503390/extras/1de683890a0effafc2e34fa6c72af3d4.mp4?t=1740751212\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" >The more your car explodes, the better you get.</p><p class=\"bb_paragraph\" >Can you become the legendary <strong>DRIVING MASTER D</strong>?</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >Features</p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >20 challenging stages.</p></li><li><p class=\"bb_paragraph\" >100 epic unlockable cars.</p></li><li><p class=\"bb_paragraph\" >100 achievements.</p></li><li><p class=\"bb_paragraph\" >5 colors for each car.</p></li><li><p class=\"bb_paragraph\" >3 collectable stars for each stage.<br>(Orange - Don't touch cones. Purple - Touch purple star. Yellow - Time attack.)</p></li><li><p class=\"bb_paragraph\" >Cool music.</p></li><li><p class=\"bb_paragraph\" >Ending. (If you're worthy.)</p></li><li><p class=\"bb_paragraph\" >Full Xbox Controller Support.</p></li></ul>",
