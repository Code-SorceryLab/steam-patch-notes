_assets/steam/apps/3531920/extras/caa6beec5f594cc096501ec1521bf336.poster.avif?t=1754333222\" width=640 height=480 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3531920/extras/caa6beec5f594cc096501ec1521bf336.webm?t=1754333222\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3531920/extras/caa6beec5f594cc096501ec1521bf336.mp4?t=1754333222\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3531920/extras/23bfeddce9edbf454cfbf270712b43db.avif?t=1754333222\" width=614 height=80 /></span></p><p class=\"bb_paragraph\" ><strong>Different groups with their own beliefs and goals. Who will you trust?</strong></p><p class=\"bb_paragraph\" >You\u2019ll cross paths with people driven by conflicting agendas.<br>Some might help you. Others\u2026 will use you.<br>Your choices will have consequences, and there won\u2019t always be a \u201cright\u201d one.<br>Sometimes, the scariest things aren\u2019t the monsters \u2014 they\u2019re the humans.</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3531920/extras/0b63c70166bfa46c14e61135f75ef4f8.poster.avif?t=1754333222\" width=576 height=720 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3531920/extras/0b63c70166bfa46c14e61135f75ef4f8.webm?t=1754333222\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3531920/extras/0b63c70166bfa46c14e61135f75ef4f8.mp4?t=1754333222\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop play