    "detailed_description": "<h2 class=\"bb_tag\" ><strong>\u5267\u60c5\uff1a</strong></h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u6a59\u5b50\u548c\u4ed6\u7684\u54e5\u54e5\u5c0f\u767d\uff0c\u4ee5\u53ca\u81ea\u5df1\u7684\u5a03\u5a03\u548c\u5ba0\u7269\u72d7\u88ab\u5377\u5165\u4e86\u5947\u602a\u7684\u4e8b\u4ef6\u4e4b\u4e2d\u3002\u4e00\u884c\u4eba\u4e00\u8def\u5410\u69fd\u7740\u51fb\u8d25\u4f5c\u4e1a\u4e4b\u795e\u624b\u4e0b\u7684\u52c7\u8005\u4eec\uff0c\u62ef\u6551\u4e16\u754c(?)\u7684\u6076\u641e\u5410\u69fd\u5411RPG\u3002</p></li><li><p class=\"bb_paragraph\" >\u987a\u4fbf\u5076\u5c14\u9047\u5230\u4e00\u4e9b\u7a00\u5947\u53e4\u602a\u7684\u654c\u4eba\uff0c\u5927\u6218\u83ab\u540d\u5176\u5999\u590d\u6d3b\u7684\u540d\u4eba\uff0c\u52c7\u95ef\u89c4\u5219\u6027\u602a\u8c08\u5b66\u6821\uff0c\u906d\u9047\u8be1\u5f02\u7684\u8425\u9500\u53f7\uff0c\u88ab\u66b4\u9732\u7684\u808c\u8089\u798f\u745e\u5413\u51fa\u516b\u7ea7\u5185\u4f24\u7b49\u7b49\u3002</p></li><li><p class=\"bb_paragraph\" ><i>\u76f8\u4e92\u7406\u89e3\u800c\u53c8\u4e0d\u80fd\u76f8\u4e92\u7406\u89e3\u7684\u4eba\u4eec\u7684\u53f9\u606f\u65e0\u4eba\u53ef\u95fb\u3002</i></p></li></ul><h2 class=\"bb_tag\" ><strong>\u7279\u8272\uff1a</strong></h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u6781\u5ea6\u4f20\u7edf\u3001\u590d\u53e4\u7684\u56de\u5408\u5236RPG\u4f53\u9a8c\uff0c\u5f3a\u8c03\u6218\u672f\uff0c\u4f7f\u7528\u6027\u80fd\u5404\u5f02\u7684\u89d2\u8272\uff0c\u642d\u914d\u5404\u79cd\u6548\u679c\u7684\u88c5\u5907\u548c\u6280\u80fd\uff0c\u5229\u7528\u6709\u5410\u69fd\u6709\u6897\u7684\u602a\u7269\u56fe\u9274\u9488\u5bf9\u6bcf\u4e2a\u654c\u4eba\u7684\u7279\u70b9\u4e0e\u654c\u4eba\u6218\u6597\u3002</p></li><li><p class=\"bb_paragraph\" >\u4f20\u9001\u3001\u9047\u654c\u7981\u7528\u3001\u6218\u6597\u5feb\u8fdb\u3001\u9003\u8dd1\u65f6100%\u6210\u529f\u3001\u9635\u4ea1\u89d2\u8272\u4ecd\u80fd\u83b7\u5f97\u7ecf\u9a8c\u7b49\u5927\u91cf\u65b9\u4fbf\u673a\u5236\u3002</p></li><li><p class=\"bb_paragraph\" ><span class=\"bb_strike\">\u4f46\u6211\u7279\u610f\u4fdd\u7559\u4e86\u4e00\u90e8\u5206\u4f20\u7edfRPG\u7684\u7cdf\u7c95\uff0c\u8fd9\u6837\u4f60\u624d\u80fd\u77e5\u9053\u4f60\u73a9\u7684\u662f\u4f20\u7edfRPG\u3002</span>(\u88ab\u6253\u98de\uff0c\u5f53\u7136\u6ca1\u6709\uff0c\u80af\u5b9a\u4e0d\u4f1a\u628a\u4e5d\u8f6c\u5927\u80a0\u7aef\u4e0a\u6765\u7684\u5566\u2665\ufe0f)</p></li><li><p class=\"bb_paragraph\" >\u4e2a\u6027\u9c9c\u660e\u7684\u89d2\u8272\u4eec\u3002</p></li><li><p class=\"bb_paragraph\" ><span class=\"bb_strike\">\u592a\u8fc7\u9c9c\u660e\u4e86\u4ee5\u81f3\u4e8e\u6709\u4e9b\u753b\u9762\u4e0d\u80fd\u653e\u51fa\u6765\u3002</span></p></li><li><p class=\"bb_paragraph\" >\u968f\u5904\u53ef\u89c1\u7684\u5410\u69fd\u548c\u51fa\u751f\u3002</p></li><li><p class=\"bb_paragraph\" >\u8131\u7ebf\u800c\u53c8\u8c1c\u4e4b\u5408\u7406\u7684\u5267\u60c5\u548c\u80cc\u666f\u6545\u4e8b\uff0c\u8fd9\u4e00\u70b9\u53ef\u80fd\u8fd8\u8981\u5305\u62ec\u654c\u4eba\u3002</p></li><li><p class=\"bb_paragraph\" ><span class=\"bb_strike\">\u4e0e\u6574\u4e2a\u4e16\u754c\u4e3a\u654c\u3002</span></p></li><li><p class=\"bb_paragraph\" >4\u5c0f\u65f6+\u6e38\u620f\u65f6\u957f\u3002\u5b8c\u7f8e\u901a\u5173\u4e5f\u8bb8\u8fd8\u9700\u8981\u66f4\u4e45\u3002</p></li><li><p class=\"bb_paragraph\" ><i>\u201c\u523a\u732c\u6548\u5e94\u201d\u2014\u2014\u4e24\u53ea\u523a\u732c\u76f8\u4e92\u4f9d\u504e\u53d6\u6696\uff0c\u4f46\u5982\u679c\u8ddd\u79bb\u592a\u8fd1\u5c31\u4f1a\u88ab\u624e\u5f97\u6d51\u8eab\u9c9c\u8840\u3002\u6709\u65f6\uff0c\u9002\u5f53\u4fdd\u6301\u8ddd\u79bb\u4e5f\u662f\u597d\u4e8b\u3002\u5c3d\u7ba1\u8fd9\u542c\u8d77\u6765\u5f88\u626d\u66f2\u3002</i></p></li></ul><h2 class=\"bb_tag\" ><strong><i>\u5907\u6ce8\uff1a</i></strong></h2><p class=\"bb_paragraph\" ><i>\u672c\u6e38\u620f\u672c\u4f53\u514d\u8d39\uff0c\u4ed8\u8d39dlc\u5305\u542b\u4e8c\u5468\u76ee\u3001\u5176\u4f59\u7ed3\u5c40\u3001\u56f0\u96be\u6a21\u5f0f\u548c\u4e00\u4e9b\u8ffd\u52a0\u5267\u60c5\u3002\u5177\u4f53\u53ef\u89c1dlc\u9875\u9762