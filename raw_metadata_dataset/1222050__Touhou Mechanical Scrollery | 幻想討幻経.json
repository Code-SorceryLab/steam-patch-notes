ai.steamstatic.com/store_item_assets/steam/apps/1222050/extras/5503afcf70f6bb6a5ff101eb7273995f.poster.avif?t=1710782124\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1222050/extras/5503afcf70f6bb6a5ff101eb7273995f.webm?t=1710782124\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1222050/extras/5503afcf70f6bb6a5ff101eb7273995f.mp4?t=1710782124\" type=\"video/mp4\"></video></div><br><br>The story is set after the events of Forbidden Scrollery and Legacy of Lunatic Kingdom, but you don't have to be familiar with either of those stories to enjoy this one!<h2 class=\"bb_tag\">\u25ceKeyboard Operation Settings</h2><div class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1222050/extras/8d121770ea09fc915d9f42afe847818e.avif?t=1710782124\" /></div><br><div class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1222050/extras/e143bbced112dbee65ac2ab4ebb6f4f7.avif?t=1710782124\" /></div>",
