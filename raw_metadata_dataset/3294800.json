    "detailed_description": "<p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3294800/extras/18b3e2fcd31cda3845d7e87a1d0fb240.webp?t=1749104404\" width=640 height=56 /></span></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3294800/extras/6778cb779db42be9c65b8956eaf00aa4.webp?t=1749104404\" width=800 height=45 /></span></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3294800/extras/d45c984a38ae735a3e0299e24a7736fd.poster.avif?t=1749104404\" width=640 height=360 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3294800/extras/d45c984a38ae735a3e0299e24a7736fd.webm?t=1749104404\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3294800/extras/d45c984a38ae735a3e0299e24a7736fd.mp4?t=1749104404\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" ><strong>Chloe's adventure story!</strong></h2><p class=\"bb_paragraph\" ><i>'Astra Village'</i> is a heartful game about a cheerful girl named Chloe who sets out to restore a ruined village and inn.</p><p class=\"bb_paragraph\" >Chloe will explore the areas around the village, farming and crafting essential items, helping the locals, and uncovering the hidden secrets that lie beneath the village's peaceful surface.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3294800/extras/18b3e2fcd31cda3845d7e87a1d0fb240.webp?t=1749104404\" width=640 height=56 /></span><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3294800/extras/c439d2566f25a165db3e82261f20cf85.webp?t=1749104404\" width=800 height=45 /></span></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3294800/extras/b2a45d04b9aaf6b956311bd76892b3b6.poster.avif?t=1749104404\" width=640 height=360 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3294800/extras/b2a45d04b9aaf6b956311bd76892b3b6.webm?t=1749104404\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3294800/extras/b2a45d04b9aaf6b956311bd76892b3b6.mp4?t=1749104404\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" ><strong>Farming &amp; Gathering</strong></h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >To rebuild the village and inn, you\u2019ll need plenty of materials.</p></li><li><p class=\"bb_paragraph\" >Gather resources through farming and foraging, then use them to repair and improve your surroundings! </p></li></ul><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3294800/extras/18b3e2fcd31cda3845d7e87a1d0fb240.webp?t=1749104404\" width=640 height=56 /></span></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3294800/extras/2658f506b8c7b106400043395638a6dc.webp?t=1749104404\" width=800 height=45 /></span></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3294800/extras/3596e390df98bca84dfa96d64c40ba19.poster.avif?t=1749104404\" width=640 height=360 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3294800/extras/3596e390df98bca84dfa96d64c40ba19.webm?t=1749104404\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3294800/extras/3596e390df98bca84dfa96d64c40ba19.mp4?t=1749104404\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" ><strong>Adventure &amp; Story</strong></h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >Venture beyond the village and discover new environments and monsters!</p></li><li><p class=\"bb_paragraph\" >Explore every corner to uncover hidden secrets and collect rare, valuable items.</p></li></ul><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3294800/extras/18b3e2fcd31cda3845d7e87a1d0fb240.webp?t=1749104404\" width=640 height=56 /></span></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3294800/extras/b8358fd71d0445fde8ed2a11e7afdb8e.webp?t=1749104404\" width=800 height=45 /></span></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3294800/extras/4adfb2904aa79d48bb6c2daeff4399fd.poster.avif?t=1749104404\" width=640 height=360 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3294800/extras/4adfb2904aa79d48bb6c2daeff4399fd.webm?t=1749104404\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3294800/extras/4adfb2904aa79d48bb6c2daeff4399fd.mp4?t=1749104404\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" ><strong>Crafting</strong></h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >Need tools to help restore the village? There\u2019s a crafting system for that!</p></li><li><p class=\"bb_paragraph\" >At Astra Village\u2019s special workstations, toss in your materials and see what unique tools or weapons you can create. (Hopefully something amazing!)</p></li></ul><h2 class=\"bb_tag\" ></h2><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3294800/extras/18b3e2fcd31cda3845d7e87a1d0fb240.webp?t=1749104404\" width=640 height=56 /></span></p><p class=\"bb_paragraph\" > <br>  </p><p class=\"bb_paragraph\" ></p>",
    "about_the_game": "<p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3294800/extras/18b3e2fcd31cda3845d7e87a1d0fb240.webp?t=1749104404\" width=640 height=56 /></span></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3294800/extras/6778cb779db42be9c65b8956eaf00aa4.webp?t=1749104404\" width=800 height=45 /></span></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3294800/extras/d45c984a38ae735a3e0299e24a7736fd.poster.avif?t=1749104404\" width=640 height=360 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3294800/extras/d45c984a38ae735a3e0299e24a7736fd.webm?t=1749104404\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3294800/extras/d45c984a38ae735a3e0299e24a7736fd.mp4?t=1749104404\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" ><strong>Chloe's adventure story!</strong></h2><p class=\"bb_paragraph\" ><i>'Astra Village'</i> is a heartful game about a cheerful girl named Chloe who sets out to restore a ruined village and inn.</p><p class=\"bb_paragraph\" >Chloe will explore the areas around the village, farming and crafting essential items, helping the locals, and uncovering the hidden secrets that lie beneath the village's peaceful surface.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3294800/extras/18b3e2fcd31cda3845d7e87a1d0fb240.webp?t=1749104404\" width=640 height=56 /></span><span class=\"bb_img_ctn\"><img class=\"bb_i