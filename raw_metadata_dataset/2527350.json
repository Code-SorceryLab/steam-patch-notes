    "detailed_description": "<h2 class=\"bb_tag\" ><a href=\"mailto:BUG\u53cd\u9988\uff1a602466023@qq.com\">BUG\u53cd\u9988\uff1a602466023@qq.com</a></h2><p class=\"bb_paragraph\" >\u9047\u5230bug\u6216\u8005\u5361\u5173\u9700\u8981\u5e2e\u52a9\u90fd\u53ef\u4ee5\u53d1\u9001\u90ae\u4ef6\uff0c\u4f1a\u5728\u6536\u52301-2\u5929\u5185\u56de\u590d\uff01\uff08\u53d1\u5728\u793e\u533a\u53ef\u80fd\u6211\u6ca1\u6cd5\u53ca\u65f6\u770b\u5230T T...\uff09</p><p class=\"bb_paragraph\" >\u56e0\u4e3a\u672c\u4eba\u4ee3\u7801\u65e0\u80fd\u4e14\u6ca1\u627e\u5230\u80fd\u7528\u7684\u63d2\u4ef6\uff0c\u76ee\u524d\u63d0\u5230\u6bd4\u8f83\u591a\u4f46\u662f\u6682\u65e0\u6cd5\u5904\u7406\u7684\u95ee\u9898\u5728\u8fd9\u91cc\u505a\u4e00\u4e2a\u9884\u8b66\uff0c\u786e\u5b9e\u975e\u5e38\u62b1\u6b49\u3010\u6ed1\u8dea</p><p class=\"bb_paragraph\" >steam\u5bf9\u63a5\u76f8\u5173\uff1a\u6ca1\u6709steam\u6210\u5c31\uff0cF12\u622a\u56fe</p><p class=\"bb_paragraph\" >\u6e38\u620f\u5185\u5bb9\u76f8\u5173\uff1a\u6ca1\u6709\u5bf9\u8bdd\u56de\u987e\u529f\u80fd\uff0c\u4e0d\u652f\u6301\u591a\u8bed\u8a00</p><p class=\"bb_paragraph\" >\u5982\u679c\u4e0d\u5c0f\u5fc3\u6309\u5feb\u8df3\u8fc7\u4e86\u5bf9\u8bdd\u53c8\u60f3\u770b\uff0c\u53ef\u4ee5\u5728b\u7ad9\u641c\u7d22\u6c34\u6bcd\u4e4b\u591c\uff0c\u6709\u672c\u4eba\u5f55\u5236\u7684\u6d41\u7a0b\u5b9e\u51b5\uff08\u5361\u5173\u4e86\u4e5f\u53ef\u4ee5\u67e5\u770b\uff0c\u8fd1\u671f\u4f1a\u7ed9\u5b9e\u51b5\u5206p\u5e76\u66f4\u65b0\u5230\u548c\u6e38\u620f\u5185\u5bb9\u5b8c\u5168\u4e00\u81f4\uff09</p><p class=\"bb_paragraph\" > </p><h2 class=\"bb_tag\" >\u80cc\u666f\u4ecb\u7ecd\uff1a</h2><p class=\"bb_paragraph\" >\u6b22\u8fce\u6765\u5230\u7279\u91cc\u6258\u666e\u65af\u6d77\u6d0b\u4e50\u56ed\uff01\u8fd9\u91cc\u5c55\u51fa\u4e00\u53ea\u62e5\u6709\u6c38\u6052\u751f\u547d\u7684\u201c\u7ea2\u591c\u6c34\u6bcd\u201d\uff0c\u662f\u57ce\u5e02\u7684\u8457\u540d\u4eba\u6c14\u666f\u70b9\u3002 </p><p class=\"bb_paragraph\" >\u7136\u800c\uff0c\u4e0d\u4e3a\u4eba\u77e5\u7684\u662f\uff0c\u8fd9\u91cc\u4e5f\u662f\u4e16\u754c\u4e0a\u552f\u4e00\u4e00\u6240\u5206\u88c2\u4f53\u751f\u4ea7\u5de5\u5382\u3002 </p><p class=\"bb_paragraph\" >\u6bcf\u5f53\u591c\u5e55\u964d\u4e34\uff0c\u6c34\u6bcd\u4ea7\u751f\u7684\u5947\u5f02\u751f\u7269\u201c\u5206\u88c2\u4f53\u201d\u5c31\u4f1a\u51fa\u73b0\u5728\u6e38\u4e50\u56ed\u4e2d\uff0c\u4e0e\u8fd9\u4e9b\u751f\u7269\u6218\u6597\uff0c\u4fbf\u662f\u201c\u56de\u6536\u5458\u201d\u7684\u5de5\u4f5c\u3002 </p><p class=\"bb_paragraph\" >\u5728\u6545\u4e8b\u4e2d\uff0c\u65b0\u4eba\u56de\u6536\u5458\u591a\u5c14\u5c3c\u5c06\u4e0e\u961f\u53cb\u4eec\u4e00\u8d77\uff0c\u5c55\u5f00\u5728\u6e38\u4e50\u56ed\u7684\u5de5\u4f5c\u4e0e\u5192\u9669\u751f\u6d3b\uff0c\u5e76\u63a2\u7d22\u5173\u4e8e\u6e38\u4e50\u56ed\u548c\u81ea\u8eab\u7684\u66f4\u591a\u771f\u76f8\uff01</p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" >\u64cd\u4f5c\uff1a</h2><p class=\"bb_paragraph\" >\u4f7f\u7528\u65b9\u5411\u952e\u79fb\u52a8\uff0c\u6309\u4f4fshift\u8dd1\u6b65\u3002 </p><p class=\"bb_paragraph\" >Z\u6216\u56de\u8f66\u952e\u8c03\u67e5\uff0cX\u6216ESC\u663e\u793a\u83dc\u5355\u3002 </p><p class=\"bb_paragraph\" >\u9700\u6309\u7167\u6307\u5f15\u8c03\u67e5\u5e76\u63a8\u8fdb\u5bf9\u8bdd\u5373\u53ef\u3002 </p><p class=\"bb_paragraph\" >\u5305\u542b\u56de\u5408\u5236\u6218\u6597\uff0c\u6709\u771f\u7ed3\u5c40\u548c\u4e24\u4e2a\u5c0f\u7684\u5206\u652f\u7ed3\u5c40\u3002</p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" >\u5173\u4e8e\u6e38\u620f\uff1a</h2><p class=\"bb_paragraph\" >\u300a\u6c34\u6bcd\u4e4b\u591c\u300b\u662f\u4e00\u6b3e\u5267\u60c5\u5411\u7684rpg\u5c0f\u6e38\u620f\uff0c\u65e8\u5728\u7ed9oc\u5b8c\u6574\u7684\u4e00\u751f\uff01</p><p class=\"bb_paragraph\" >\u672c\u8d28\u5c5e\u4e8e\u5206\u4eaboc\u6545\u4e8b\u6240\u4ee5\u4e0d\u5f00\u653e\u5c0f\u8bf4\uff0c\u6f2b\u753b\u7b49\u9898\u6750\u7684\u4e8c\u521b\u4ee5\u53cacosplay\uff08\u786e\u5b9e\u662f\u6709\u4eba\u95ee\u4e86\u6240\u4ee5\u63d0\u4e00\u53e5\uff0c\u660e\u767d\u5927\u5bb6\u4e5f\u662f\u51fa\u4e8e\u559c\u7231\u6240\u4ee5\u8fd8\u662f\u975e\u5e38\u611f\u8c22...\uff09</p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" >\u5173\u4e8e\u5b9e\u51b5\u5f55\u5236\uff1a</h2><p class=\"bb_paragraph\" >\u975e\u5e38\u6b22\u8fce\u5927\u5bb6\u5f55\u5236\u6e38\u620f\u5b9e\u51b5\uff01\u6211\u5f88\u60f3\u770b\uff01 </p><p class=\"bb_paragraph\" >\u4f46\u662f\u8bf7\u4e0d\u8981\u5728\u89c6\u9891\u5c01\u9762\u548c\u6807\u9898\u6dfb\u52a0\u6d89\u53ca\u540e\u534a\u6bb5\u5267\u60c5\u7684\u5185\u5bb9\uff0c\u5267\u900f\u53ef\u80fd\u4f1a\u7ed9\u5176\u4ed6\u73a9\u5bb6\u5e26\u6765\u4e0d\u597d\u7684\u4f53\u9a8c\u3002 </p><p class=\"bb_paragraph\" >\u611f\u8c22\u5927\u5bb6\u7684\u8c05\u89e3\uff01</p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" ></h2>",
    "about_the_game": "<h2 class=\"bb_tag\" ><a href=\"mailto:BUG\u53cd\u9988\uff1a602466023@qq.com\">BUG\u53cd\u9988\uff1a602466023@qq.com</a></h2><p class=\"bb_paragraph\" >\u9047\u5230bug\u6216\u8005\u5361\u5173\u9700\u8981\u5e2e\u52a9\u90fd\u53ef\u4ee5\u53d1\u9001\u90ae\u4ef6\uff0c\u4f1a\u5728\u6536\u52301-2\u5929\u5185\u56de\u590d\uff01\uff08\u53d1\u5728\u793e\u533a\u53ef\u80fd\u6211\u6ca1\u6cd5\u53ca\u65f6\u770b\u5230T T...\uff09</p><p class=\"bb_paragraph\" >\u56e0\u4e3a\u672c\u4eba\u4ee3\u7801\u65e0\u80fd\u4e14\u6ca1\u627e\u5230\u80fd\u7528\u7684\u63d2\u4ef6\uff0c\u76ee\u524d\u63d0\u5230\u6bd4\u8f83\u591a\u4f46\u662f\u6682\u65e0\u6cd5\u5904\u7406\u7684\u95ee\u9898\u5728\u8fd9\u91cc\u505a\u4e00\u4e2a\u9884\u8b66\uff0c\u786e\u5b9e\u975e\u5e38\u62b1\u6b49\u3010\u6ed1\u8dea</p><p class=\"bb_paragraph\" >steam\u5bf9\u63a5\u76f8\u5173\uff1a\u6ca1\u6709steam\u6210\u5c31\uff0cF12\u622a\u56fe</p><p class=\"bb_paragraph\" >\u6e38\u620f\u5185\u5bb9\u76f8\u5173\uff1a\u6ca1\u6709\u5bf9\u8bdd\u56de\u987e\u529f\u80fd\uff0c\u4e0d\u652f\u6301\u591a\u8bed\u8a00</p><p class=\"bb_paragraph\" >\u5982\u679c\u4e0d\u5c0f\u5fc3\u6309\u5feb\u8df3\u8fc7\u4e86\u5bf9\u8bdd\u53c8\u60f3\u770b\uff0c\u53ef\u4ee5\u5728b\u7ad9\u641c\u7d22\u6c34\u6bcd\u4e4b\u591c\uff0c\u6709\u672c\u4eba\u5f55\u5236\u7684\u6d41\u7a0b\u5b9e\u51b5\uff08\u5361\u5173\u4e86\u4e5f\u53ef\u4ee5\u67e5\u770b\uff0c\u8fd1\u671f\u4f1a\u7ed9\u5b9e\u51b5\u5206p\u5e76\u66f4\u65b0\u5230\u548c\u6e38\u620f\u5185\u5bb9\u5b8c\u5168\u4e00\u81f4\uff09</p><p class=\"bb_paragraph\" > </p><h2 class=\"bb_tag\" >\u80cc\u666f\u4ecb\u7ecd\uff1a</h2><p class=\"bb_paragraph\" >\u6b22\u8fce\u6765\u5230\u7279\u91cc\u6258\u666e\u65af\u6d77\u6d0b\u4e50\u56ed\uff01\u8fd9\u91cc\u5c55\u51fa\u4e00\u53ea\u62e5\u6709\u6c38\u6052\u751f\u547d\u7684\u201c\u7ea2\u591c\u6c34\u6bcd\u201d\uff0c\u662f\u57ce\u5e02\u7684\u8457\u540d\u4eba\u6c14\u666f\u70b9\u3002 </p><p class=\"bb_paragraph\" >\u7136\u800c\uff0c\u4e0d\u4e3a\u4eba\u77e5\u7684\u662f\uff0c\u8fd9\u91cc\u4e5f\u662f\u4e16\u754c\u4e0a\u552f\u4e00\u4e00\u6240\u5206\u88c2\u4f53\u751f\u4ea7\u5de5\u5382\u3002 </p><p class=\"bb_paragraph\" >\u6bcf\u5f53\u591c\u5e55\u964d\u4e34\uff0c\u6c34\u6bcd\u4ea7\u751f\u7684\u5947\u5f02\u751f\u7269\u201c\u5206\u88c2\u4f53\u201d\u5c31\u4f1a\u51fa\u73b0\u5728\u6e38\u4e50\u56ed\u4e2d\uff0c\u4e0e\u8fd9\u4e9b\u751f\u7269\u6218\u6597\uff0c\u4fbf\u662f\u201c\u56de\u6536\u5458\u201d\u7684\u5de5\u4f5c\u3002 </p><p class=\"bb_paragraph\" >\u5728\u6545\u4e8b\u4e2d\uff0c\u65b0\u4eba\u56de\u6536\u5458\u591a\u5c14\u5c3c\u5c06\u4e0e\u961f\u53cb\u4eec\u4e00\u8d77\uff0c\u5c55\u5f00\u5728\u6e38\u4e50\u56ed\u7684\u5de5\u4f5c\u4e0e\u5192\u9669\u751f\u6d3b\uff0c\u5e76\u63a2\u7d22\u5173\u4e8e\u6e38\u4e50\u56ed\u548c\u81ea\u8eab\u7684\u66f4\u591a\u771f\u76f8\uff01</p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" >\u64cd\u4f5c\uff1a</h2><p class=\"bb_paragraph\" >\u4f7f\u7528\u65b9\u5411\u952e\u79fb\u52a8\uff0c\u6309\u4f4fshift\u8dd1\u6b65\u3002 </p><p class=\"bb_paragraph\" >Z\u6216\u56de\u8f66\u952e\u8c03\u67e5\uff0cX\u6216ESC\u663e\u793a\u83dc\u5355\u3002 </p><p class=\"bb_paragraph\" >\u9700\u6309\u7167\u6307\u5f15\u8c03\u67e5\u5e76\u63a8\u8fdb\u5bf9\u8bdd\u5373\u53ef\u3002 </p><p class=\"bb_paragraph\" >\u5305\u542b\u56de\u5408\u5236\u6218\u6597\uff0c\u6709\u771f\u7ed3\u5c40\u548c\u4e24\u4e2a\u5c0f\u7684\u5206\u652f\u7ed3\u5c40\u3002</p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" >\u5173\u4e8e\u6e38\u620f\uff1a</h2><p class=\"bb_paragraph\" >\u300a\u6c34\u6bcd\u4e4b\u591c\u300b\u662f\u4e00\u6b3e\u5267\u60c5\u5411\u7684rpg\u5c0f\u6e38\u620f\uff0c\u65e8\u5728\u7ed9oc\u5b8c\u6574\u7684\u4e00\u751f\uff01</p><p class=\"bb_paragraph\" >\u672c\u8d28\u5c5e\u4e8e\u5206\u4eaboc\u6545\u4e8b\u6240\u4ee5\u4e0d\u5f00\u653e\u5c0f\u8bf4\uff0c\u6f2b\u753b\u7b49\u9898\u6750\u7684\u4e8c\u521b\u4ee5\u53cacosplay\uff08\u786e\u5b9e\u662f\u6709\u4eba\u95ee\u4e86\u6240\u4ee5\u63d0\u4e00\u53e5\uff0c\u660e\u767d\u5927\u5bb6\u4e5f\u662f\u51fa\u4e8e\u559c\u7231\u6240\u4ee5\u8fd8\u662f\u975e\u5e38\u611f\u8c22...\uff09</p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" >\u5173\u4e8e\u5b9e\u51b5\u5f55\u5236\uff1a</h2><p class=\"bb_paragraph\" >\u975e\u5e38\u6b22\u8fce\u5927\u5bb6\u5f55\u5236\u6e38\u620f\u5b9e\u51b5\uff01\u6211\u5f88\u60f3\u770b\uff01 </p><p class=\"bb_paragraph\" >\u4f46\u662f\u8bf7\u4e0d\u8981\u5728\u89c6\u9891\u5c01\u9762\u548c\u6807\u9898\u6dfb\u52a0\u6d89\u53ca\u540e\u534a\u6bb5\u5267\u60c5\u7684\u5185\u5bb9\uff0c\u5267\u900f\u53ef\u80fd\u4f1a\u7ed9\u5176\u4ed6\u73a9\u5bb6\u5e26\u6765\u4e0d\u597d\u7684\u4f53\u9a8c\u3002 </p><p class=\"bb_paragraph\" >\u611f\u8c22\u5927\u5bb6\u7684\u8c05\u89e3\uff01</p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" ></h2>",
