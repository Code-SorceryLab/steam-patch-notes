{
    "type": "game",
    "name": "RopeBot",
    "steam_appid": 2478560,
    "required_age": 0,
    "is_free": false,
    "detailed_description": "<p class=\"bb_paragraph\" >RopeBot is a third-person puzzle platformer built around realistic rope physics. Use your Rope Arm to shoot, control, and manipulate ropes as you navigate through challenging levels.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><strong>Key Features:</strong> <br>    </p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>Rope Arm:</strong> Shoot ropes from your Rope Arm, adjust their length in real-time, and fire both ends to connect objects together.</p><p class=\"bb_paragraph\" > </p></li><li><p class=\"bb_paragraph\" >    </p><p class=\"bb_paragraph\" ><strong>Satisfying Swinging:</strong> Ropes have a slight bounce that adds depth to the swinging mechanics, rewarding players who master the timing and momentum. </p><p class=\"bb_paragraph\" ></p></li><li><p class=\"bb_paragraph\" ><strong>Rope Belt:</strong> Connect to multiple objects simultaneously, drag several items at once, or carry objects while keeping your Rope Arm free for swinging and interaction. </p><p class=\"bb_paragraph\" ></p></li><li><p class=\"bb_paragraph\" >    <strong>Interactive Physics Objects:</strong> Manipulate Hinge Platforms, Drawer Platforms, and Pivot Platforms using your ropes to solve environmental puzzles.</p><p class=\"bb_paragraph\" ></p></li><li><p class=\"bb_paragraph\" ><strong>Electric Rope System:</strong> Electrify your ropes by connecting to Electric Generators, then power doors, platforms, and other devices through repeaters and receivers.</p></li></ul>",
    "about_the_game": "<p class=\"bb_paragraph\" >RopeBot is a third-person puzzle platformer built around realistic rope physics. Use your Rope Arm to shoot, control, and manipulate ropes as you navigate through challenging levels.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><strong>Key Features:</strong> <br>    </p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>Rope Arm:</strong> Shoot ropes from your Rope Arm, adjust their length in real-time, and fire both ends to connect objects together.</p><p class=\"bb_paragraph\" > </p></li><li><p class=\"bb_paragraph\" >    </p><p class=\"bb_paragraph\" ><strong>Satisfying Swinging:</strong> Ropes have a slight bounce that adds depth to the swinging mechanics, rewarding players who master the timing and momentum. </p><p class=\"bb_paragraph\" ></p></li><li><p class=\"bb_paragraph\" ><strong>Rope Belt:</strong> Connect to multiple objects simultaneously, drag several items at once, or carry objects while keeping your Rope Arm free for swinging and interaction. </p><p class=\"bb_paragraph\" ></p></li><li><p class=\"bb_paragraph\" >    <strong>Interactive Physics Objects:</strong> Manipulate Hinge Platforms, Drawer Platforms, and Pivot Platforms using your ropes to solve environmental puzzles.</p><p class=\"bb_paragraph\" ></p></li><li><p class=\"bb_paragraph\" ><strong>Electric Rope System:</strong> Electrify your ropes by connecting to Electric Generators, then power doors, platforms, and other devices through repeaters and receivers.</p></li></ul>",
    "short_description": "RopeBot gives you unparalleled control over dynamic, realistic ropes in this physics-based 3D platformer. Create, lengthen, throw, and deactivate ropes at will to overcome challenges and solve puzzles. How will you untangle this adventure?",
    "supported_languages": "English<strong>*</strong><br><strong>*</strong>languages with full audio support",
