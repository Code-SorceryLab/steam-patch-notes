4\uc744 \uc9c4\ud589\ud569\ub2c8\ub2e4.<br>\ud37c\uc990 \ubb38\uc81c\ub294 \ud604\uc2e4 \ud30c\ud2b8\uc640 \uafc8 \ud30c\ud2b8\ub85c \uad6c\ubd84\ud560 \uc218 \uc788\uc73c\uba70, \ud604\uc2e4 \ud30c\ud2b8\uc5d0\uc11c\ub294 \ubb38\uc81c\ub97c \ud2c0\ub824\ub3c4 \ubcc4\ub2e4\ub978 \ud398\ub110\ud2f0 \uc5c6\uc774 \uc9c4\ud589\uc774 \ub418\uc9c0\ub9cc, \uafc8 \ud30c\ud2b8\uc5d0\uc11c\ub294 \uc8fc\uc5b4\uc9c4 \uae30\ud68c \ub3d9\uc548 \ubb38\uc81c\ub97c \ub9de\ud788\uc9c0 \ubabb\ud558\uba74 \uac8c\uc784 \uc624\ubc84\uac00 \ub429\ub2c8\ub2e4.<br><br>\uc2a4\ud1a0\ub9ac \uc9c4\ud589 \u2192 \ud37c\uc990 \ubb38\uc81c \u2192 \uc2a4\ud1a0\ub9ac \uc9c4\ud589 \u2192 \ud37c\uc990 \ubb38\uc81c \u2192 \u2026\u2026 \u2192 \uc2a4\ud1a0\ub9ac \uc9c4\ud589 \u2192 \uacb0\ub9d0<br><br>\uc544\ubb34\ub9ac \uace0\ubbfc\ud574\ub3c4 \ubabb \ud480\uaca0\ub2e4\uba74 \u300e\uc815\ub2f5 \ubcf4\uae30\u300f\uae30\ub2a5\uc744 \uc0ac\uc6a9\ud558\uc5ec \ud574\ub2f9 \ubb38\uc81c\ub97c \uc2a4\ud0b5\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. (\uc815\ub2f5 \ubcf4\uae30 \uae30\ub2a5\uc744 \uc0ac\uc6a9\ud560 \uc218 \uc788\ub294 \ud69f\uc218\ub294 \ud55c\uc815\ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4.)<br>\uc815\ub2f5 \ubcf4\uae30 \uae30\ub2a5\uc744 \ubaa8\ub450 \uc0ac\uc6a9\ud588\ub294\ub370\ub3c4 \uc9c4\ud589\uc774 \ub9c9\ud614\ub2e4\uba74 \uc778\ud130\ub137 \uac80\uc0c9\uc744 \uc774\uc6a9\ud574\uc8fc\uc138\uc694.<br>\uadf8\ub807\uc9c0\ub9cc, \ub9c8\uc774\ub108\ud55c \uac8c\uc784\uc774\ub77c\uc11c \uac80\uc0c9\uc744 \ud574\ub3c4 \ub2f5\uc744 \ucc3e\uc9c0 \ubabb\ud560 \uac00\ub2a5\uc131\uc774 \ub192\uc2b5\ub2c8\ub2e4. \uadf8\ub7f4 \ub54c\ub294 C's earth \uc81c\uc791 \uce74\ud398\uc5d0 \ubb38\uc758\ud574\uc8fc\uc138\uc694. (\uc0c1\uc810 \ud398\uc774\uc9c0 \uc624\ub978\ucabd\uc758 \uc6f9\uc0ac\uc774\ud2b8 \ubc29\ubb38 \uae30\ub2a5\uc744 \ucc38\uc870)<br>\uac00\ub2a5\ud558\uba74, \uac8c\uc784\uc758 \uacf5\ub7b5 \ubc29\ubc95\uc744 \uc81c\uc791\uc790 \uc2a4\uc2a4\ub85c \uc124\uba85\ud558\ub294 \uc11c\uae00\ud508 \uc77c\u