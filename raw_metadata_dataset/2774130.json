    "detailed_description": "<p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2774130/extras/181dad3359418595576eed89149534ed.poster.avif?t=1753600351\" width=600 height=338 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2774130/extras/181dad3359418595576eed89149534ed.webm?t=1753600351\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2774130/extras/181dad3359418595576eed89149534ed.mp4?t=1753600351\" type=\"video/mp4\"></video></span></p><h2 class=\"bb_tag\" >Explore a long forgotten world</h2><p class=\"bb_paragraph\" ><i>It has been 100 years since a malevolent plague spewed from the earth and extinguished almost all life. Travel to decrepit villages and find out how to prevent the next coming of the plague!</i></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2774130/extras/980551ff8c04f18668cf833b95836cc9.poster.avif?t=1753600351\" width=600 height=338 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2774130/extras/980551ff8c04f18668cf833b95836cc9.webm?t=1753600351\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2774130/extras/980551ff8c04f18668cf833b95836cc9.mp4?t=1753600351\" type=\"video/mp4\"></video></span></p><h2 class=\"bb_tag\" >Gather your allies</h2><p class=\"bb_paragraph\" ><i>Find the source of the plague with up to 10 players as you fight your way through hordes of infected creatures. You are plagueborn!</i> </p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2774130/extras/ca8827d21edc027ce4c872fa5ebf2270.poster.avif?t=1753600351\" width=600 height=338 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2774130/extras/ca8827d21edc027ce4c872fa5ebf2270.webm?t=1753600351\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2774130/extras/ca8827d21edc027ce4c872fa5ebf2270.mp4?t=1753600351\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p>",
    "about_the_game": "<p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2774130/extras/181dad3359418595576eed89149534ed.poster.avif?t=1753600351\" width=600 height=338 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2774130/extras/181dad3359418595576eed89149534ed.webm?t=1753600351\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2774130/extras/181dad3359418595576eed89149534ed.mp4?t=1753600351\" type=\"video/mp4\"></video></span></p><h2 class=\"bb_tag\" >Explore a long forgotten world</h2><p class=\"bb_paragraph\" ><i>It has been 100 years since a malevolent plague spewed from the earth and extinguished almost all life. Travel to decrepit villages and find out how to prevent the next coming of the plague!</i></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2774130/extras/980551ff8c04f18668cf833b95836cc9.poster.avif?t=1753600351\" width=600 height=338 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2774130/extras/980551ff8c04f18668cf833b95836cc9.webm?t=1753600351\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2774130/extras/980551ff8c04f18668cf833b95836cc9.mp4?t=1753600351\" type=\"video/mp4\"></video></span></p><h2 class=\"bb_tag\" >Gather your allies</h2><p class=\"bb_paragraph\" ><i>Find the source of the plague with up to 10 players as you fight your way through hordes of infected creatures. You are plagueborn!</i> </p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2774130/extras/ca8827d21edc027ce4c872fa5ebf2270.poster.avif?t=1753600351\" width=600 height=338 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2774130/extras/ca8827d21edc027ce4c872fa5ebf2270.webm?t=1753600351\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2774130/extras/ca8827d21edc027ce4c872fa5ebf2270.mp4?t=1753600351\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p>",
