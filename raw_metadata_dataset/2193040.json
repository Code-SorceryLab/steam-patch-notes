muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2193040/extras/51aed973ac2608742fe21e673be7189b.poster.avif?t=1698541261\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2193040/extras/51aed973ac2608742fe21e673be7189b.webm?t=1698541261\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2193040/extras/51aed973ac2608742fe21e673be7189b.mp4?t=1698541261\" type=\"video/mp4\"></video></div>",
