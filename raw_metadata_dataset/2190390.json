s/2190390/extras/a5af61930f4f4b14392e063515fdf405.webm?t=1686765782\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2190390/extras/a5af61930f4f4b14392e063515fdf405.mp4?t=1686765782\" type=\"video/mp4\"></video></div><br><br><strong>DECORATE YOUR HOME THE WAY YOU LIKE IT</strong><br><div class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2190390/extras/30c5e416ce73584e900bfbbd6cabf73f.poster.avif?t=1686765782\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2190390/extras/30c5e416ce73584e900bfbbd6cabf73f.webm?t=1686765782\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2190390/extras/30c5e416ce73584e900bfbbd6cabf73f.mp4?t=1686765782\" type=\"video/mp4\"></video></div><br><br><div class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2190390/extras/b9fdfed5d85957f8d7387655aea0d95a.avif?t=1686765782\" /></div><br><ul class=\"bb_ul\"><li> <strong>OPEN WORLD</strong>: Explore a tropical island with many interactive locations.<br></li><li> <strong>ADVANCED BUILDING SYSTEM</strong>: Build the home of your dreams, from foundations and walls, to electrical wiring, painting walls and furnishing rooms.<br></li><li> <strong>CRAFT</strong>: The game has the mining and processing of resources, the craft of game items, the repair of worn out items.<br></li><li> <strong>TRANSPORT</strong>: There are several types of cars in the game - from muscle cars to pickups and trucks, there is a public train, as well as a train that you can drive yourself.<br></li><li> <strong>BUSINESS AND EARNINGS</strong>: Earn money the way you want - you can deliver parcels or cargo, mine and sell resources, or you can open your own store and sell goods to the inhabitants of the island.</li></ul><br>Explore a large island that has become your new home. Get resources on the island and use them to build your house. Earn money and expand your estate, buy new furniture and renovate your house - everything is available from painting the walls and wallpapering to installing your own elevator. Buy new cars for the convenience of moving around the island and earning money.",
