.akamai.steamstatic.com/store_item_assets/steam/apps/1753440/extras/bfe8332191be54fad66ab3002f2fcf87.mp4?t=1735310591\" type=\"video/mp4\"></video></div><h2 class=\"bb_tag\">Satisfying</h2>Kromaticube is a really good game for training your brain reflexes. It's all about learning patterns while discovering new atmospheres. Each level is about one ne particular feeling like joy, sadness or fear for example.<br><br><div class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1753440/extras/28eca782fef4d343f27e8e839a7e8fc3.poster.avif?t=1735310591\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1753440/extras/28eca782fef4d343f27e8e839a7e8fc3.webm?t=1735310591\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1753440/extras/28eca782fef4d343f27e8e839a7e8fc3.mp4?t=1735310591\" type=\"video/mp4\"></video></div>",
