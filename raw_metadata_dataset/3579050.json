    "detailed_description": "<p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\u201c\u6240\u4ee5\u8bf4\uff0c\u4f60\u5230\u5e95\u4e70\u4e86\u4ec0\u4e48\u4e1c\u897f\u554a\u3002\u201d</p><p class=\"bb_paragraph\" >\u201c\u54ce\u5440\uff0c\u5148\u62c6\u5f00\u770b\u770b\u561b\uff01\u201d</p><p class=\"bb_paragraph\" ><strong>\u6765\u8def\u4e0d\u660e\u7684\u6e38\u620f\u673a\uff0c\u7279\u522b\u6807\u6ce8\u7684\u9650\u5b9a\u6e38\u620f\uff0c\u7a81\u5982\u5176\u6765\u7684\u5c0f\u4e8b\u6545\uff1f</strong></p><p class=\"bb_paragraph\" >\u201c\u2026\u2026\u5f00\u59cb\u6e38\u620f\u7684\u65f6\u5019\u4e5f\u6ca1\u8bf4\u4f1a\u8fd9\u6837\u554a\uff01\u201d</p><p class=\"bb_paragraph\" >\u201c\u54ce\u5440\u2026\u2026\u90a3\u4e5f\u53ea\u80fd\u7167\u7740\u5b83\u8bf4\u7684\u505a\u4e86\u5427\u3002\u201d</p><p class=\"bb_paragraph\" ><strong>\u610f\u5916\u95ef\u5165\u6e38\u620f\u4e16\u754c\uff0c\u8981\u5982\u4f55\u624d\u80fd\u56de\u5230\u73b0\u5b9e\u4e2d\u6765\uff1f</strong></p><p class=\"bb_paragraph\" >.......</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\u7231\u5e0ccp\u5411\u540c\u4eba\u6e38\u620f\u300a\u8349\u8393\u5de7\u514b\u529b\u300b\uff08\u539f\u4f5cBanG Dream!\uff09\u73b0\u5df2\u4e0a\u7ebf\uff01</p><p class=\"bb_paragraph\" ></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u5728\u300a\u8349\u8393\u5de7\u514b\u529b\u300b\u7684\u4e16\u754c\u4e2d\uff0c\u73a9\u5bb6\u5c06\u82b1\u8d392-3\u5c0f\u65f6\u4f53\u9a8c\u7eb7\u7e41\u7684\u7c73\u6b47\u5c14\u6e38\u620f\u4e16\u754c\uff0c\u5728\u7ade\u901f\uff0c\u79cd\u690d\uff0c\u97f3\u4e50\u6e38\u620f\u7b49\u8bf8\u591a\u79cd\u7c7b\u7684\u5c0f\u6e38\u620f\u91cc\u64cd\u7eb5\u4e8c\u4eba\u7a81\u51fa\u91cd\u56f4\uff0c\u4eab\u53d7\u53cc\u5f71\u5947\u5883\u4e00\u822c\u7684\u98ce\u683c\u53d8\u6362\u2026\u2026\u7b49\u4e00\u4e0b\uff0c\u6211\u4eec\u4e0d\u662f\u9633\u5149\u5065\u5eb7\u79ef\u6781\u5411\u4e0a\u7684\u5408\u5bb6\u6b22\u4f01\u5212\u5417\uff1f</p></li><li><p class=\"bb_paragraph\" >\u7531\u732b\u53c8\u732b\u8001\u5e08\u7cbe\u5fc3\u7ed8\u5236\u7684\u5341\u4f59\u5f20cg\u56fe\u7247\u4ee5\u53ca\u53ef\u7231\u7684\u7acb\u7ed8\uff0c\u6765\u6b23\u8d4f\u4e24\u4eba\u7684\u6709\u7231\u7684\u4e92\u52a8\u5427\u3002</p></li><li><p class=\"bb_paragraph\" >\u540c\u62c5\u8001\u5e08\u521b\u4f5c\u7684\u72ec\u7279\u539f\u521b\u66f2\u76ee\u3002</p></li><li><p class=\"bb_paragraph\" >\u652f\u6301\u5355/\u53cc\u4eba\u6e38\u73a9\u3002\u5982\u540c\u300a\u68ee\u6797\u51b0\u706b\u4eba\u300b\u4e00\u822c\uff0c\u7531\u4e00\u4eba\u64cd\u4f5c\u690e\u540d\u7acb\u5e0c\uff0c\u4e00\u4eba\u64cd\u4f5c\u5343\u65e9\u7231\u97f3\uff0c\u53ef\u4ee5\u4f5c\u4e3a\u6d3e\u5bf9\u6e38\u620f\u7684\u597d\u9009\u62e9\uff01</p></li></ul><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\u5236\u4f5c\u56e2\u961f\uff1a\u6cb3\u8c5a\u751f\u6001\u6551\u52a9\u5c0f\u7ec4</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >Sora</p><p class=\"bb_paragraph\" >\u8d5b\u535a\u6570\u636e\u732b</p><p class=\"bb_paragraph\" >\u963f\u5361\u8428\u5947\u5976\u725b\u732b</p><p class=\"bb_paragraph\" >\u7075\u5e08\u7237</p><p class=\"bb_paragraph\" >\u8857\u706f</p><p class=\"bb_paragraph\" >\u51b0\u7ffc\u4e54\u6cb3</p><p class=\"bb_paragraph\" >\u76ae\u76ae</p><p class=\"bb_paragraph\" >\u7279\u522b\u9e23\u8c22\uff1a\u732b\u53c8\u732b</p>",
