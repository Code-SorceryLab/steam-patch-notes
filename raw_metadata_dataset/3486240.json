    "detailed_description": "<p class=\"bb_paragraph\" ><strong>\u6e38\u620f\u540d: \u6700\u540e\u7684\u4fee\u4ed9\u8005</strong></p><p class=\"bb_paragraph\" ><strong>\u5173\u4e8e\u672c\u6e38\u620f</strong></p><p class=\"bb_paragraph\" >\u300a\u6700\u540e\u7684\u4fee\u4ed9\u8005\u300b\u662f\u4e00\u6b3e\u878d\u5408\u89d2\u8272\u626e\u6f14\u3001\u7b56\u7565\u548c\u5192\u9669\u7684\u4fee\u4ed9\u7c7b\u6e38\u620f\u3002\u5728\u8fd9\u7247\u795e\u79d8\u7684\u4fee\u4ed9\u4e16\u754c\u4e2d\uff0c\u73a9\u5bb6\u5c06\u626e\u6f14\u4e00\u540d\u52c7\u6562\u7684\u4fee\u884c\u8005\uff0c\u7ecf\u5386\u8270\u96be\u7684\u4fee\u70bc\u4e4b\u8def\uff0c\u63a2\u7d22\u672a\u77e5\u7684\u79d8\u5883\uff0c\u6311\u6218\u5f3a\u5927\u7684\u654c\u4eba\uff0c\u8ffd\u6c42\u65e0\u4e0a\u7684\u4fee\u4ed9\u4e4b\u9053\u3002</p><p class=\"bb_paragraph\" >\u8d2d\u4e70\u672c\u6e38\u620f\uff0c\u73a9\u5bb6\u53ef\u83b7\u5f97\u7684\u529f\u80fd\u4e0e\u5185\u5bb9\uff1a</p><p class=\"bb_paragraph\" >\u89d2\u8272\u5b9a\u5236</p><p class=\"bb_paragraph\" >   - \u81ea\u5b9a\u4e49\u89d2\u8272\u7684\u5916\u89c2\u3001\u6027\u522b\u548c\u804c\u4e1a\uff0c\u9009\u62e9\u4e0d\u540c\u7684\u4fee\u4ed9\u6d41\u6d3e\uff0c\u5851\u9020\u72ec\u7279\u7684\u89d2\u8272\u5f62\u8c61\u3002</p><p class=\"bb_paragraph\" >\u6280\u80fd\u7cfb\u7edf</p><p class=\"bb_paragraph\" >   - \u638c\u63e1\u591a\u79cd\u6cd5\u672f\u4e0e\u6280\u80fd\uff0c\u5408\u7406\u642d\u914d\u4ee5\u5e94\u5bf9\u4e0d\u540c\u7684\u6218\u6597\u573a\u666f\uff0c\u901a\u8fc7\u5347\u7ea7\u89e3\u9501\u66f4\u5f3a\u5927\u7684\u6280\u80fd\u3002</p><p class=\"bb_paragraph\" >\u63a2\u7d22\u5730\u56fe</p><p class=\"bb_paragraph\" >   - \u5728\u591a\u4e2a\u7cbe\u7f8e\u7684\u573a\u666f\u4e2d\u63a2\u9669\uff0c\u5305\u62ec\u7075\u5c71\u3001\u836f\u8c37\u3001\u5929\u5751\u7b49\uff0c\u6bcf\u4e2a\u573a\u666f\u90fd\u6709\u72ec\u7279\u7684\u4efb\u52a1\u4e0e\u79d8\u5bc6\u7b49\u5f85\u53d1\u73b0\u3002</p><p class=\"bb_paragraph\" >\u88c5\u5907\u7cfb\u7edf</p><p class=\"bb_paragraph\" >   - \u6536\u96c6\u3001\u5347\u7ea7\u548c\u6253\u9020\u5404\u79cd\u88c5\u5907\uff0c\u4ece\u666e\u901a\u7269\u54c1\u5230\u4f20\u5947\u795e\u5668\uff0c\u589e\u5f3a\u89d2\u8272\u5c5e\u6027\u4e0e\u6218\u6597\u529b\u3002</p><p class=\"bb_paragraph\" >\u6210\u5c31\u7cfb\u7edf</p><p class=\"bb_paragraph\" >   - \u901a\u8fc7\u5b8c\u6210\u4efb\u52a1\u548c\u6311\u6218\u83b7\u5f97\u6210\u5c31\uff0c\u89e3\u9501\u72ec\u7279\u5956\u52b1\uff0c\u63d0\u5347\u6e38\u620f\u4e50\u8da3\u548c\u6210\u5c31\u611f\u3002</p><p class=\"bb_paragraph\" >\u5b9a\u671f\u5185\u5bb9\u66f4\u65b0</p><p class=\"bb_paragraph\" >   - \u6e38\u620f\u5c06\u4e0d\u5b9a\u671f\u63a8\u51fa\u65b0\u89d2\u8272\u3001\u65b0\u573a\u666f\u3001\u65b0\u4efb\u52a1\u548c\u65b0\u6d3b\u52a8\uff0c\u4fdd\u6301\u6e38\u620f\u7684\u65b0\u9c9c\u611f\u4e0e\u6311\u6218\u6027\u3002</p><p class=\"bb_paragraph\" ><strong>\u7acb\u5373\u8d2d\u4e70\u300a\u6700\u540e\u7684\u4fee\u4ed9\u8005\u300b\uff0c\u5f00\u59cb\u4f60\u7684\u4fee\u4ed9\u4e4b\u65c5\uff0c\u4e66\u5199\u5c5e\u4e8e\u4f60\u7684\u6545\u4e8b\uff01</strong></p><p class=\"bb_paragraph\" ></p>",
    "about_the_game": "<p class=\"bb_paragraph\" ><strong>\u6e38\u620f\u540d: \u6700\u540e\u7684\u4fee\u4ed9\u8005</strong></p><p class=\"bb_paragraph\" ><strong>\u5173\u4e8e\u672c\u6e38\u620f</strong></p><p class=\"bb_paragraph\" >\u300a\u6700\u540e\u7684\u4fee\u4ed9\u8005\u300b\u662f\u4e00\u6b3e\u878d\u5408\u89d2\u8272\u626e\u6f14\u3001\u7b56\u7565\u548c\u5192\u9669\u7684\u4fee\u4ed9\u7c7b\u6e38\u620f\u3002\u5728\u8fd9\u7247\u795e\u79d8\u7684\u4fee\u4ed9\u4e16\u754c\u4e2d\uff0c\u73a9\u5bb6\u5c06\u626e\u6f14\u4e00\u540d\u52c7\u6562\u7684\u4fee\u884c\u8005\uff0c\u7ecf\u5386\u8270\u96be\u7684\u4fee\u70bc\u4e4b\u8def\uff0c\u63a2\u7d22\u672a\u77e5\u7684\u79d8\u5883\uff0c\u6311\u6218\u5f3a\u5927\u7684\u654c\u4eba\uff0c\u8ffd\u6c42\u65e0\u4e0a\u7684\u4fee\u4ed9\u4e4b\u9053\u3002</p><p class=\"bb_paragraph\" >\u8d2d\u4e70\u672c\u6e38\u620f\uff0c\u73a9\u5bb6\u53ef\u83b7\u5f97\u7684\u529f\u80fd\u4e0e\u5185\u5bb9\uff1a</p><p class=\"bb_paragraph\" >\u89d2\u8272\u5b9a\u5236</p><p class=\"bb_paragraph\" >   - \u81ea\u5b9a\u4e49\u89d2\u8272\u7684\u5916\u89c2\u3001\u6027\u522b\u548c\u804c\u4e1a\uff0c\u9009\u62e9\u4e0d\u540c\u7684\u4fee\u4ed9\u6d41\u6d3e\uff0c\u5851\u9020\u72ec\u7279\u7684\u89d2\u8272\u5f62\u8c61\u3002</p><p class=\"bb_paragraph\" >\u6280\u80fd\u7cfb\u7edf</p><p class=\"bb_paragraph\" >   - \u638c\u63e1\u591a\u79cd\u6cd5\u672f\u4e0e\u6280\u80fd\uff0c\u5408\u7406\u642d\u914d\u4ee5\u5e94\u5bf9\u4e0d\u540c\u7684\u6218\u6597\u573a\u666f\uff0c\u901a\u8fc7\u5347\u7ea7\u89e3\u9501\u66f4\u5f3a\u5927\u7684\u6280\u80fd\u3002</p><p class=\"bb_paragraph\" >\u63a2\u7d22\u5730\u56fe</p><p class=\"bb_paragraph\" >   - \u5728\u591a\u4e2a\u7cbe\u7f8e\u7684\u573a\u666f\u4e2d\u63a2\u9669\uff0c\u5305\u62ec\u7075\u5c71\u3001\u836f\u8c37\u3001\u5929\u5751\u7b49\uff0c\u6bcf\u4e2a\u573a\u666f\u90fd\u6709\u72ec\u7279\u7684\u4efb\u52a1\u4e0e\u79d8\u5bc6\u7b49\u5f85\u53d1\u73b0\u3002</p><p class=\"bb_paragraph\" >\u88c5\u5907\u7cfb\u7edf</p><p class=\"bb_paragraph\" >   - \u6536\u96c6\u3001\u5347\u7ea7\u548c\u6253\u9020\u5404\u79cd\u88c5\u5907\uff0c\u4ece\u666e\u901a\u7269\u54c1\u5230\u4f20\u5947\u795e\u5668\uff0c\u589e\u5f3a\u89d2\u8272\u5c5e\u6027\u4e0e\u6218\u6597\u529b\u3002</p><p class=\"bb_paragraph\" >\u6210\u5c31\u7cfb\u7edf</p><p class=\"bb_paragraph\" >   - \u901a\u8fc7\u5b8c\u6210\u4efb\u52a1\u548c\u6311\u6218\u83b7\u5f97\u6210\u5c31\uff0c\u89e3\u9501\u72ec\u7279\u5956\u52b1\uff0c\u63d0\u5347\u6e38\u620f\u4e50\u8da3\u548c\u6210\u5c31\u611f\u3002</p><p class=\"bb_paragraph\" >\u5b9a\u671f\u5185\u5bb9\u66f4\u65b0</p><p class=\"bb_paragraph\" >   - \u6e38\u620f\u5c06\u4e0d\u5b9a\u671f\u63a8\u51fa\u65b0\u89d2\u8272\u3001\u65b0\u573a\u666f\u3001\u65b0\u4efb\u52a1\u548c\u65b0\u6d3b\u52a8\uff0c\u4fdd\u6301\u6e38\u620f\u7684\u65b0\u9c9c\u611f\u4e0e\u6311\u6218\u6027\u3002</p><p class=\"bb_paragraph\" ><strong>\u7acb\u5373\u8d2d\u4e70\u300a\u6700\u540e\u7684\u4fee\u4ed9\u8005\u300b\uff0c\u5f00\u59cb\u4f60\u7684\u4fee\u4ed9\u4e4b\u65c5\uff0c\u4e66\u5199\u5c5e\u4e8e\u4f60\u7684\u6545\u4e8b\uff01</strong></p><p class=\"bb_paragraph\" ></p>",
