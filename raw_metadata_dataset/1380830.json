0fbc8ead91e.poster.avif?t=1698569225\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1380830/extras/7aab04377b474ac1a06590fbc8ead91e.webm?t=1698569225\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1380830/extras/7aab04377b474ac1a06590fbc8ead91e.mp4?t=1698569225\" type=\"video/mp4\"></video></div><br><br>",
