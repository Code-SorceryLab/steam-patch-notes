ght=210 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2978550/extras/e7a84e0fa49a1d7a480557f9c0a01220.webm?t=1725659056\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2978550/extras/e7a84e0fa49a1d7a480557f9c0a01220.mp4?t=1725659056\" type=\"video/mp4\"></video></span>",
