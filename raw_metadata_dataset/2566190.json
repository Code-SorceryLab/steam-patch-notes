p playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2566190/extras/d643e41c3c1363885a3ec62f364cb05e.poster.avif?t=1744105927\" width=610 height=256 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2566190/extras/d643e41c3c1363885a3ec62f364cb05e.webm?t=1744105927\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2566190/extras/d643e41c3c1363885a3ec62f364cb05e.mp4?t=1744105927\" type=\"video/mp4\"></video></span></p><h2 class=\"bb_tag\" ><strong>Stop to admire the solved puzzle</strong></h2><p class=\"bb_paragraph\" >Use the view rotation to enjoy the completed puzzle that comes to life.</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2566190/extras/43c149534587ad92b421023fa9de0b1b.poster.avif?t=1744105927\" width=614 height=256 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2566190/extras/43c149534587ad92b421023fa9de0b1b.webm?t=1744105927\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2566190/extras/43c149534587ad92b421023fa9de0b1b.mp4?t=1744105927\" type=\"video/mp4\"></video></span></p>",
