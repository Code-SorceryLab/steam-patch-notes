20/extras/7b42d972598657f7a697d7b8831175f5.poster.avif?t=1684723658\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2365220/extras/7b42d972598657f7a697d7b8831175f5.webm?t=1684723658\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2365220/extras/7b42d972598657f7a697d7b8831175f5.mp4?t=1684723658\" type=\"video/mp4\"></video></span>",
