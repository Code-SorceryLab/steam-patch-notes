<source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1045610/extras/af14c4110be34a80908edb89ddfa381c.webm?t=1727200932\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1045610/extras/af14c4110be34a80908edb89ddfa381c.mp4?t=1727200932\" type=\"video/mp4\"></video></div></li></ul>",
