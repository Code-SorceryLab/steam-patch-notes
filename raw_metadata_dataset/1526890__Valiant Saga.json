ai.steamstatic.com/store_item_assets/steam/apps/1526890/extras/d71e6ee4ac6f2faf0eb680ba93955579.webm?t=1748471611\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1526890/extras/d71e6ee4ac6f2faf0eb680ba93955579.mp4?t=1748471611\" type=\"video/mp4\"></video></div></p><p class=\"bb_paragraph\"> <br><div class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1526890/extras/ffd5919c39a1330f57b31a12f28848ba.avif?t=1748471611\" /></div>Solve challenging puzzles, help villagers, and overcome deadly dungeons traps. </p><p class=\"bb_paragraph\"></p><p class=\"bb_paragraph\"><div class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1526890/extras/e3b1005016622b946424773c266b5771.poster.avif?t=1748471611\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1526890/extras/e3b1005016622b946424773c266b5771.webm?t=1748471611\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1526890/extras/e3b1005016622b946424773c266b5771.mp4?t=1748471611\" type=\"video/mp4\"></video></div></p><p class=\"bb_paragraph\"> <br><div class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1526890/extras/df233425ec3b38cc2f73af36f9b33b0b.avif?t=1748471611\" /></div></p><p class=\"bb_paragraph\"></p><p class=\"bb_paragraph\">Feel the battle through a fully original and immersive power metal soundtrack.</p><p class=\"bb_paragraph\"></p><p class=\"bb_paragraph\"> </p>",
