    "controller_support": "full",
    "detailed_description": "<p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline crossorigin=\"anonymous\" poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2780690/extras/adeea24e3dd84b81855d46ed1a4f0508.poster.avif?t=1753204833\" width=800 height=435 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2780690/extras/adeea24e3dd84b81855d46ed1a4f0508.webm?t=1753204833\" type=\"video/webm; codecs=vp9\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >The beautiful city of Rio de Janeiro! And we have many cats to find!</p><p class=\"bb_paragraph\" ><strong>A cozy and wholesome experience in the most recognizable city in Brazil!</strong> Start with a Beautiful monochromatic scenario, relax, and find all the cats to reveal the final colored art. </p><p class=\"bb_paragraph\" > </p><p class=\"bb_paragraph\" ></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>More than 920 hidden objects to find!!! </strong></p></li><li><p class=\"bb_paragraph\" ><strong>Find the cats and paint the city.</strong></p></li><li><p class=\"bb_paragraph\" ><strong>Look for special cats and unlock bonus levels.</strong></p></li><li><p class=\"bb_paragraph\" ><strong>Discover Rio's Landmarks.</strong></p></li><li><p class=\"bb_paragraph\" >Collect many cards and earn achievements.</p></li><li><p class=\"bb_paragraph\" >Use the radar to help search for cats.</p></li><li><p class=\"bb_paragraph\" >Dynamic Sound FX</p></li><li><p class=\"bb_paragraph\" >Exclusive Soundtrack</p><p class=\"bb_paragraph\" ></p></li></ul><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline crossorigin=\"anonymous\" poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2780690/extras/dd2b91a5d26f7961f30ebe2a092955d3.poster.avif?t=1753204833\" width=800 height=223 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2780690/extras/dd2b91a5d26f7961f30ebe2a092955d3.webm?t=1753204833\" type=\"video/webm; codecs=vp9\"></video></span></p><h2 class=\"bb_tag\" ><strong>Main Level - Rio de Janeiro</strong></h2><p class=\"bb_paragraph\" > </p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >200 cats to find.</p></li><li><p class=\"bb_paragraph\" >12 Special Cats that unlock bonus levels and give hints. </p></li><li><p class=\"bb_paragraph\" > 20 city people to help you earn radar hints.</p></li></ul><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" ><strong>Bonus Levels</strong></h2><p class=\"bb_paragraph\" >Levels with different sizes and numbers of kittens to find.  </p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>Bar: </strong>50 kittens</p></li><li><p class=\"bb_paragraph\" ><strong>Cable Car:</strong> 50 kittens</p></li><li><p class=\"bb_paragraph\" ><strong>Grocery Store:</strong> 50 kittens</p></li><li><p class=\"bb_paragraph\" ><strong>Community:</strong> 75 kittens</p></li><li><p class=\"bb_paragraph\" ><strong>Maracan\u00e3:</strong> 100 kittens</p></li><li><p class=\"bb_paragraph\" ><strong>Botanical Garden</strong>: 100 kittens</p></li><li><p class=\"bb_paragraph\" ><strong>Carnival:</strong> 100 kittens + 50 people</p></li></ul><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" >Accessibility</h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >Dark Mode</p></li><li><p class=\"bb_paragraph\" >Invert Mouse Zoom</p></li><li><p class=\"bb_paragraph\" >Mouse Drag Sensitivity</p></li><li><p class=\"bb_paragraph\" >Edge Screen Scrolling</p></li><li><p class=\"bb_paragraph\" >Color Blindness</p></li></ul><p class=\"bb_paragraph\" > </p>",
    "about_the_game": "<p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline crossorigin=\"anonymous\" poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2780690/extras/adeea24e3dd84b81855d46ed1a4f0508.poster.avif?t=1753204833\" width=800 height=435 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2780690/extras/adeea24e3dd84b81855d46ed1a4f0508.webm?t=1753204833\" type=\"video/webm; codecs=vp9\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >The beautiful city of Rio de Janeiro! And we have many cats to find!</p><p class=\"bb_paragraph\" ><strong>A cozy and wholesome experience in the most recognizable city in Brazil!</strong> Start with a Beautiful monochromatic scenario, relax, and find all the cats to reveal the final colored art. </p><p class=\"bb_paragraph\" > </p><p class=\"bb_paragraph\" ></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>More than 920 hidden objects to find!!! </strong></p></li><li><p class=\"bb_paragraph\" ><strong>Find the cats and paint the city.</strong></p></li><li><p class=\"bb_paragraph\" ><strong>Look for special cats and unlock bonus levels.</strong></p></li><li><p class=\"bb_paragraph\" ><strong>Discover Rio's Landmarks.</strong></p></li><li><p class=\"bb_paragraph\" >Collect many cards and earn achievements.</p></li><li><p class=\"bb_paragraph\" >Use the radar to help search for cats.</p></li><li><p class=\"bb_paragraph\" >Dynamic Sound FX</p></li><li><p class=\"bb_paragraph\" >Exclusive Soundtrack</p><p class=\"bb_paragraph\" ></p></li></ul><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline crossorigin=\"anonymous\" poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2780690/extras/dd2b91a5d26f7961f30ebe2a092955d3.poster.avif?t=1753204833\" width=800 height=223 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2780690/extras/dd2b91a5d26f7961f30ebe2a092955d3.webm?t=1753204833\" type=\"video/webm; codecs=vp9\"></video></span></p><h2 class=\"bb_tag\" ><strong>Main Level - Rio de Janeiro</strong></h2><p class=\"bb_paragraph\" > </p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >200 cats to find.</p></li><li><p class=\"bb_paragraph\" >12 Special Cats that unlock bonus levels and give hints. </p></li><li><p class=\"bb_paragraph\" > 20 city people to help you earn radar hints.</p></li></ul><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" ><strong>Bonus Levels</strong></h2><p class=\"bb_paragraph\" >Levels with different sizes and numbers of kittens to find.  </p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>Bar: </strong>50 kittens</p></li><li><p class=\"bb_paragraph\" ><strong>Cable Car:</strong> 50 kittens</p></li><li><p class=\"bb_paragraph\" ><strong>Grocery Store:</strong> 50 kittens</p></li><li><p class=\"bb_paragraph\" ><strong>Community:</strong> 75 kittens</p></li><li><p class=\"bb_paragraph\" ><strong>Maracan\u00e3:</strong> 100 kittens</p></li><li><p class=\"bb_paragraph\" ><strong>Botanical Garden</strong>: 100 kittens</p></li><li><p class=\"bb_paragraph\" ><strong>Carnival:</strong> 100 kittens + 50 people</p></li></ul><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" >Accessibility</h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >Dark Mode</p></li><li><p class=\"bb_paragraph\" >Invert Mouse Zoom</p></li><li><p class=\"bb_paragraph\" >Mouse Drag Sensitivity</p></li><li><p class=\"bb_paragraph\" >Edge Screen Scrolling</p></li><li><p class=\"bb_paragraph\" >Color Blindness</p></li></ul><p class=\"bb_paragraph\" > </p>",
