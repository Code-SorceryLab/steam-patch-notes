{
    "type": "game",
    "name": "Life's Short \u4eba\u751f\u82e6\u77ed",
    "steam_appid": 3290460,
    "required_age": 0,
    "is_free": false,
    "detailed_description": "<p class=\"bb_paragraph\" >This is not a game, </p><p class=\"bb_paragraph\" >but an unrepeatable survival simulation.</p><p class=\"bb_paragraph\" >The global average lifespan is 74 years:</p><p class=\"bb_paragraph\" >26,900 days</p><p class=\"bb_paragraph\" > 645,612 hours </p><p class=\"bb_paragraph\" >38,736,720 minutes</p><p class=\"bb_paragraph\" >2,324,203,200 seconds.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >Enter your age to see how much time remains in your life,<br>then make it extraordinary!</p><h2 class=\"bb_tag\" >\u200b<strong>Basic Controls</strong></h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >Click the small radio on the desktop to play random music; click again to turn it off.</p></li><li><p class=\"bb_paragraph\" >Click the window to observe seasonal changes outside.</p></li><li><p class=\"bb_paragraph\" >Shift+Del to force reset (for age correction or switching users).</p></li></ul>",
    "about_the_game": "<p class=\"bb_paragraph\" >This is not a game, </p><p class=\"bb_paragraph\" >but an unrepeatable survival simulation.</p><p class=\"bb_paragraph\" >The global average lifespan is 74 years:</p><p class=\"bb_paragraph\" >26,900 days</p><p class=\"bb_paragraph\" > 645,612 hours </p><p class=\"bb_paragraph\" >38,736,720 minutes</p><p class=\"bb_paragraph\" >2,324,203,200 seconds.</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >Enter your age to see how much time remains in your life,<br>then make it extraordinary!</p><h2 class=\"bb_tag\" >\u200b<strong>Basic Controls</strong></h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >Click the small radio on the desktop to play random music; click again to turn it off.</p></li><li><p class=\"bb_paragraph\" >Click the window to observe seasonal changes outside.</p></li><li><p class=\"bb_paragraph\" >Shift+Del to force reset (for age correction or switching users).</p></li></ul>",
    "short_description": "&quot;We clung to the illusion of life's infinite respawns, until time's grinding gears revealed the corroded save button beyond salvation.&quot;",
