    "detailed_description": "<p class=\"bb_paragraph\" >\u5168\u65b0\u9ad8\u7206\u8d85\u53d8\u6001\u4f20\u5947\u6e38\u620f\u7ecf\u5178\u5de8\u4f5c\u9707\u64bc\u6765\u88ad\uff0c\u738b\u8005\u5f52\u6765\uff01</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\u6e38\u620f\u7ee7\u627f\u7ecf\u5178\u4f20\u5947\u4e16\u754c\u6838\u5fc3\u73a9\u6cd5\uff0c\u8fd8\u539f\u5347\u7ea7\u653b\u6c99\u7206\u795e\u88c5\u7b49\u7ecf\u5178\u7cfb\u7edf\u3002\u521b\u65b0\u4fee\u4ed9\u73a9\u6cd5\u3001\u653e\u7f6e\u6302\u673a\uff0c\u5168\u65b0\u5927\u5730\u56fe\u795e\u9b54\u5927\u9646\u3002\u6a2a\u7248\u64cd\u4f5c\uff0c\u8d85\u52b2\u7206\u7684\u6253\u51fb\u5feb\u611f\uff0c\u8d85\u9ad8\u7206\u7387\u75af\u72c2\u6536\u5272\u3002</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\u6765\u4e86\u5c31\u662f\u5927\u54e5\uff0c\u4e00\u5200\u79f0\u9738\u5168\u670d\u3002\u518d\u7eed\u5144\u5f1f\u60c5\u4e49\uff0c\u6210\u5c31\u4f20\u5947\u9738\u4e1a\uff01</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >3D\u84dd\u5149\u753b\u8d28\uff0c\u88ab\u73a9\u5bb6\u8bc4\u8bba\u4e3a\u753b\u9762\u6700\u597d\u770b\u7684\u4f20\u5947\u6e38\u620f\uff0c\u4e0d\u5982\u8fdb\u670d\u770b\u770b\uff0c\u4e0d\u8981\u7b49\u5f85\uff0c\u8981\u723d\u5c31\u73b0\u5728\uff01 </p><h2 class=\"bb_tag\" >\u3010\u6e38\u620f\u7279\u8272\u3011</h2><p class=\"bb_paragraph\" > \u4e00\u3001\u65b0\u5355\u804c\u4e1a\uff0c\u5168\u65b0\u73a9\u6cd5 </p><p class=\"bb_paragraph\" >\u6218\u6cd5\u9053\u4e09\u804c\u4e1a\u4e09\u5408\u4e00\uff0cPK\u6253\u602a\u66f4\u516c\u5e73\uff0c\u88c5\u5907\u5168\u9760\u6253\uff0c\u4e0d\u6c2a\u4e0d\u809d\u9760\u5b9e\u529b\uff01</p><p class=\"bb_paragraph\" > </p><p class=\"bb_paragraph\" >\u4e8c\u3001\u6e38\u620f\u5f00\u6302\uff0c\u79f0\u9738\u5929\u4e0b </p><p class=\"bb_paragraph\" >\u5e2e\u6d3e\u6350\u732e\u53ef\u5f97\u9006\u5929BUFF\uff0c\u52a9\u60a8\u5f81\u6218\u739b\u6cd5\u5927\u9646\uff0c\u795e\u9b54\u5927\u9646\uff0c\u4e00\u7edf\u4f20\u4e16\u9738\u4e1a\uff01</p><p class=\"bb_paragraph\" > </p><p class=\"bb_paragraph\" >\u4e09\u3001\u6302\u673a\u73a9\u6cd5\uff0c\u81ea\u52a8\u56de\u6536 </p><p class=\"bb_paragraph\" >\u5168\u65b0\u6302\u673a\u80cc\u5305\u4e0d\u6ee1\u73a9\u6cd5\uff0c\u88c5\u5907\u81ea\u52a8\u56de\u6536\uff0c\u89e3\u653e\u53cc\u624b\uff0c\u4e0a\u73ed\u6302\u673a\u5668\uff0c\u4e0b\u73ed\u73a9\u6e38\u620f\uff01</p><p class=\"bb_paragraph\" > </p><p class=\"bb_paragraph\" >\u56db\u3001\u6218\u5ba0\u6218\u5c06\uff0c\u6253\u67b6\u5e2e\u624b </p><p class=\"bb_paragraph\" >\u6218\u5ba0\u524d\u671f\u6253\u602a\uff0c\u53ef\u8fdb\u9636\u81f3\u6218\uff0c\u5c06\u53c2\u4e0ePK\uff0c\u5b9e\u73b0\u7fa4\u653b\u9ebb\u75f9\uff01\u8fd8\u6709\u8ddf\u73ed\u8f85\u52a9\u73a9\u5bb6\u62fe\u53d6\u9053\u5177\u3001\u6269\u5145\u80cc\u5305\u3001\u53cc\u500d\u6536\u76ca\uff0c\u6280\u672f\u9769\u65b0\uff0c\u56de\u5fc6\u4f9d\u65e7\uff01</p><p class=\"bb_paragraph\" > </p><p class=\"bb_paragraph\" >\u4e94\u3001\u4e0b\u73ed\u56de\u5bb6\uff0c\u6fc0\u60c5\u653b\u6c99 </p><p class=\"bb_paragraph\" >\u6bcf\u5468\u7684\u6c99\u5df4\u514b\u653b\u57ce\u6218\u3001\u4e3b\u5bb0\u9f99\u57ce\uff0c\u57ce\u4e3b\u62a2\u593a\u7cbe\u5f69\u7eb7\u5448\uff0c\u7fa4\u96c4\u4e89\u9738\uff0c\u4e00\u8d77\u6765\u6fc0\u60c5PK\uff01</p><p class=\"bb_paragraph\" > </p><p class=\"bb_paragraph\" >\u516d\u3001\u9b54\u5200\u5723\u5251\uff0c\u8d85\u5f3a\u6536\u5272 </p><p class=\"bb_paragraph\" >\u9b54\u5200\u5728\u624b\uff0c\u5200\u5200\u5f31\u70b9\uff0cBOSS\u8d8a\u5f3a\uff0c\u780d\u5f97\u8d8a\u723d\u3002\u8d85\u6d41\u7545\u7684\u64cd\u4f5c\u4f53\u9a8c\uff0c\u8d85\u52b2\u7206\u7684\u6253\u51fb\u5feb\u611f\uff0c\u8d85\u9ad8\u7206\u7387\u75af\u72c2\u6536\u5272\uff01</p><p class=\"bb_paragraph\" > </p><p class=\"bb_paragraph\" >\u4e03\u3001\u767e\u500d\u7206\u7387\uff0c\u88c5\u5907\u56de\u6536 </p><p class=\"bb_paragraph\" >\u5168\u5c4f\u5237\u602a\uff0c\u8d85\u9ad8\u7206\u7387\uff0c\u6ee1\u5c4f\u6389\u843d\uff0c\u88c5\u5907\u56de\u6536\uff0c\u7ecf\u9a8c\u5143\u5b9d\u8d5a\u4e0d\u505c\uff01\u5bc4\u552e\u7cfb\u7edf\uff0c\u81ea\u7531\u4ea4\u6613\uff01</p><p class=\"bb_paragraph\" > </p><p class=\"bb_paragraph\" >\u516b\u3001\u5144\u5f1f\u518d\u805a\uff0c\u53cb\u60c5\u5c81\u6708 </p><p class=\"bb_paragraph\" >\u6253\u5b9d\u3001\u6253\u91d1\u3001PK\u3001\u5237\u56fe\u3001\u6536\u96c6\u3001\u516c\u4f1a\u6218\uff01\u60a8\u4e0d\u662f\u4e00\u4e2a\u4eba\u5728\u6218\u6597\uff01\u767e\u4e07\u884c\u4f1a\uff0c\u5343\u4e07\u5144\u5f1f\uff0c\u4e00\u547c\u767e\u5e94\uff01\u5144\u5f1f\u9f50\u5fc3\uff0c\u79f0\u9738\u5929\u4e0b\uff01\u83b7\u53d6\u6307\u5c16\u5feb\u611f\uff0c\u518d\u7eed\u5144\u5f1f\u60c5\u4e49\uff01</p>",
    "about_the_game": "<p class=\"bb_paragraph\" >\u5168\u65b0\u9ad8\u7206\u8d85\u53d8\u6001\u4f20\u5947\u6e38\u620f\u7ecf\u5178\u5de8\u4f5c\u9707\u64bc\u6765\u88ad\uff0c\u738b\u8005\u5f52\u6765\uff01</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\u6e38\u620f\u7ee7\u627f\u7ecf\u5178\u4f20\u5947\u4e16\u754c\u6838\u5fc3\u73a9\u6cd5\uff0c\u8fd8\u539f\u5347\u7ea7\u653b\u6c99\u7206\u795e\u88c5\u7b49\u7ecf\u5178\u7cfb\u7edf\u3002\u521b\u65b0\u4fee\u4ed9\u73a9\u6cd5\u3001\u653e\u7f6e\u6302\u673a\uff0c\u5168\u65b0\u5927\u5730\u56fe\u795e\u9b54\u5927\u9646\u3002\u6a2a\u7248\u64cd\u4f5c\uff0c\u8d85\u52b2\u7206\u7684\u6253\u51fb\u5feb\u611f\uff0c\u8d85\u9ad8\u7206\u7387\u75af\u72c2\u6536\u5272\u3002</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\u6765\u4e86\u5c31\u662f\u5927\u54e5\uff0c\u4e00\u5200\u79f0\u9738\u5168\u670d\u3002\u518d\u7eed\u5144\u5f1f\u60c5\u4e49\uff0c\u6210\u5c31\u4f20\u5947\u9738\u4e1a\uff01</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >3D\u84dd\u5149\u753b\u8d28\uff0c\u88ab\u73a9\u5bb6\u8bc4\u8bba\u4e3a\u753b\u9762\u6700\u597d\u770b\u7684\u4f20\u5947\u6e38\u620f\uff0c\u4e0d\u5982\u8fdb\u670d\u770b\u770b\uff0c\u4e0d\u8981\u7b49\u5f85\uff0c\u8981\u723d\u5c31\u73b0\u5728\uff01 </p><h2 class=\"bb_tag\" >\u3010\u6e38\u620f\u7279\u8272\u3011</h2><p class=\"bb_paragraph\" > \u4e00\u3001\u65b0\u5355\u804c\u4e1a\uff0c\u5168\u65b0\u73a9\u6cd5 </p><p class=\"bb_paragraph\" >\u6218\u6cd5\u9053\u4e09\u804c\u4e1a\u4e09\u5408\u4e00\uff0cPK\u6253\u602a\u66f4\u516c\u5e73\uff0c\u88c5\u5907\u5168\u9760\u6253\uff0c\u4e0d\u6c2a\u4e0d\u809d\u9760\u5b9e\u529b\uff01</p><p class=\"bb_paragraph\" > </p><p class=\"bb_paragraph\" >\u4e8c\u3001\u6e38\u620f\u5f00\u6302\uff0c\u79f0\u9738\u5929\u4e0b </p><p class=\"bb_paragraph\" >\u5e2e\u6d3e\u6350\u732e\u53ef\u5f97\u9006\u5929BUFF\uff0c\u52a9\u60a8\u5f81\u6218\u739b\u6cd5\u5927\u9646\uff0c\u795e\u9b54\u5927\u9646\uff0c\u4e00\u7edf\u4f20\u4e16\u9738\u4e1a\uff01</p><p class=\"bb_paragraph\" > </p><p class=\"bb_paragraph\" >\u4e09\u3001\u6302\u673a\u73a9\u6cd5\uff0c\u81ea\u52a8\u56de\u6536 </p><p class=\"bb_paragraph\" >\u5168\u65b0\u6302\u673a\u80cc\u5305\u4e0d\u6ee1\u73a9\u6cd5\uff0c\u88c5\u5907\u81ea\u52a8\u56de\u6536\uff0c\u89e3\u653e\u53cc\u624b\uff0c\u4e0a\u73ed\u6302\u673a\u5668\uff0c\u4e0b\u73ed\u73a9\u6e38\u620f\uff01</p><p class=\"bb_paragraph\" > </p><p class=\"bb_paragraph\" >\u56db\u3001\u6218\u5ba0\u6218\u5c06\uff0c\u6253\u67b6\u5e2e\u624b </p><p class=\"bb_paragraph\" >\u6218\u5ba0\u524d\u671f\u6253\u602a\uff0c\u53ef\u8fdb\u9636\u81f3\u6218\uff0c\u5c06\u53c2\u4e0ePK\uff0c\u5b9e\u73b0\u7fa4\u653b\u9ebb\u75f9\uff01\u8fd8\u6709\u8ddf\u73ed\u8f85\u52a9\u73a9\u5bb6\u62fe\u53d6\u9053\u5177\u3001\u6269\u5145\u80cc\u5305\u3001\u53cc\u500d\u6536\u76ca\uff0c\u6280\u672f\u9769\u65b0\uff0c\u56de\u5fc6\u4f9d\u65e7\uff01</p><p class=\"bb_paragraph\" > </p><p class=\"bb_paragraph\" >\u4e94\u3001\u4e0b\u73ed\u56de\u5bb6\uff0c\u6fc0\u60c5\u653b\u6c99 </p><p class=\"bb_paragraph\" >\u6bcf\u5468\u7684\u6c99\u5df4\u514b\u653b\u57ce\u6218\u3001\u4e3b\u5bb0\u9f99\u57ce\uff0c\u57ce\u4e3b\u62a2\u593a\u7cbe\u5f69\u7eb7\u5448\uff0c\u7fa4\u96c4\u4e89\u9738\uff0c\u4e00\u8d77\u6765\u6fc0\u60c5PK\uff01</p><p class=\"bb_paragraph\" > </p><p class=\"bb_paragraph\" >\u516d\u3001\u9b54\u5200\u5723\u5251\uff0c\u8d85\u5f3a\u6536\u5272 </p><p class=\"bb_paragraph\" >\u9b54\u5200\u5728\u624b\uff0c\u5200\u5200\u5f31\u70b9\uff0cBOSS\u8d8a\u5f3a\uff0c\u780d\u5f97\u8d8a\u723d\u3002\u8d85\u6d41\u7545\u7684\u64cd\u4f5c\u4f53\u9a8c\uff0c\u8d85\u52b2\u7206\u7684\u6253\u51fb\u5feb\u611f\uff0c\u8d85\u9ad8\u7206\u7387\u75af\u72c2\u6536\u5272\uff01</p><p class=\"bb_paragraph\" > </p><p class=\"bb_paragraph\" >\u4e03\u3001\u767e\u500d\u7206\u7387\uff0c\u88c5\u5907\u56de\u6536 </p><p class=\"bb_paragraph\" >\u5168\u5c4f\u5237\u602a\uff0c\u8d85\u9ad8\u7206\u7387\uff0c\u6ee1\u5c4f\u6389\u843d\uff0c\u88c5\u5907\u56de\u6536\uff0c\u7ecf\u9a8c\u5143\u5b9d\u8d5a\u4e0d\u505c\uff01\u5bc4\u552e\u7cfb\u