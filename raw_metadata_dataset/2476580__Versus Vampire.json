4c6c33cdf.poster.avif?t=1706994210\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2476580/extras/f5db81fee1a308a6864c2424c6c33cdf.webm?t=1706994210\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2476580/extras/f5db81fee1a308a6864c2424c6c33cdf.mp4?t=1706994210\" type=\"video/mp4\"></video></span><br></li><li>Team up with friends online and have fun slaying with style.</li></ul><br><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2476580/extras/ddc76f3174badc2e625b3c094a28ed18.poster.avif?t=1706994210\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2476580/extras/ddc76f3174badc2e625b3c094a28ed18.webm?t=1706994210\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2476580/extras/ddc76f3174badc2e625b3c094a28ed18.mp4?t=1706994210\" type=\"video/mp4\"></video></span><br><br><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2476580/extras/7110aa517eef715ff081fd018c3e2f00.avif?t=1706994210\" /></span>",
