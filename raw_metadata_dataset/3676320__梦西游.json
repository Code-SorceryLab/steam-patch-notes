    "detailed_description": "<p class=\"bb_paragraph\" >\u73a9\u5bb6\u4e00\u81f4\u63a8\u8350\uff0c\u56de\u5408\u5236\u4fee\u4ed9\u6302\u673a\u6e38\u620f\u300a\u68a6\u897f\u6e38\u300b\u7ee7\u627f\u826f\u5fc3\u516c\u5e73\uff0c\u7ecf\u5178\u56de\u5408\uff0c\u4eba\u4eba\u7231\u73a9\u7684\u521d\u5fc3\u4e0d\u6539\u3002\u65a9\u5996\u9664\u9b54\u3001\u7384\u5e7b\u897f\u6e38\uff0c\u5168\u65b0\u753b\u9762\uff0c\u89c6\u542c\u76db\u5bb4\uff0c\u878d\u5165\u6570\u5341\u4f59\u7c7b\u8da3\u5473\u73a9\u6cd5\u3002</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\u66f4\u6709\u795e\u517d\u4ed9\u5ba0\uff0c\u7eda\u4e3d\u98de\u5251\uff0c\u4eb2\u5bc6\u793e\u4ea4\uff0c\u624b\u6e38\u9ad8\u54c1\u8d28\u4e92\u52a8\u68a6\u5e7b\u5bb6\u56ed\u7b49\u591a\u79cd\u521b\u65b0\u73a9\u6cd5\uff0c\u7cbe\u7f8e\u6e05\u65b0\u7684\u753b\u98ce\uff0c\u7cbe\u7f8e\u7684\u4eba\u7269\u9020\u578b\uff0c\u5f15\u4eba\u5165\u80dc\u7684\u60c5\u8282\uff0c\u5e26\u7ed9\u73a9\u5bb6\u4e0d\u540c\u4ee5\u5f80\u7684\u5168\u65b0\u4f53\u9a8c\u3002</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\u767e\u53d8\u65f6\u88c5\uff0c\u7ed3\u5408\u591a\u79cd\u5143\u7d20\uff0c\u63d0\u4f9b\u6570\u767e\u5957\u7cbe\u7f8e\u68a6\u5e7b\u7684\u65f6\u88c5\uff0c\u6ee1\u8db3\u4f60\u7684\u6536\u96c6\u63a7\uff1b\u591a\u4eba\u540c\u5c4f,\u4e07\u4eba\u8de8\u670d\uff01\u5f3a\u52bf\u6df7\u6218\u3001\u70ab\u9177\u706b\u7206\u7684\u5bf9\u6218\u573a\u9762\uff0c\u91ca\u653e\u65e0\u9650\u6fc0\u60c5\u3002</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\u7cbe\u5fc3\u8bbe\u8ba1\u7684\u4e30\u5bcc\u573a\u666f\uff0c\u7eda\u4e3d\u7684\u6280\u80fd\u7279\u6548\uff0c\u795e\u5c06\u840c\u5ba0\u5750\u9a91\uff0c\u4f34\u4f60\u95ef\u8361\u4e09\u754c\u3002\u897f\u6e38\u4e0d\u505c\uff0c\u8ba9\u6211\u4eec\u6765\u4e00\u573a\u68a6\u5e7b\u7ecf\u5178\u7684\u897f\u6e38\u4fee\u4ed9\u4f53\u9a8c\u4e4b\u65c5\u5427\uff01</p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" >\u3010\u6e38\u620f\u7279\u8272\u3011</h2><p class=\"bb_paragraph\" >\u4e00\u3001\u591a\u79cd\u521b\u65b0\u73a9\u6cd5</p><p class=\"bb_paragraph\" >\u7b56\u7565\u6218\u6597\uff0c\u56e2\u961f\u6fc0\u6218\uff0c\u4f19\u4f34\u517b\u6210\uff0c\u840c\u5ba0\u7075\u517d\uff0c\u767e\u53d8\u9020\u578b\uff0c\u5feb\u4e50\u4ea4\u53cb\uff0c\u64cd\u4f5c\u7b80\u5355\u89e3\u653e\u53cc\u624b\uff0c\u4e0a\u73ed\u4e5f\u80fd\u62bd\u7a7a\u6302\u673a\u8f7b\u677e\u73a9\uff01</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\u4e8c\u3001\u5168\u65b0\u5750\u9a91\u767b\u573a</p><p class=\"bb_paragraph\" >\u8fd9\u662f\u4e00\u4e2a\u5145\u6ee1\u4e86\u7075\u6c14\u7684\u4e16\u754c\uff0c\u4e07\u7269\u90fd\u4f1a\u53d7\u5230\u5929\u5730\u95f4\u7075\u6c14\u7684\u5f71\u54cd\uff0c\u5c31\u8fde\u666e\u901a\u7684\u7269\u54c1\uff0c\u4e5f\u4f1a\u53d8\u6210\u751f\u7075\uff0c\u62e5\u6709\u81ea\u5df1\u7684\u610f\u8bc6\u3002\u4eba\u4eec\u53d1\u73b0\u5b83\u4eec\u540e\uff0c\u4fbf\u5c1d\u8bd5\u9a6f\u670d\u5b83\u4eec\uff0c\u4f7f\u4e4b\u6210\u4e3a\u4f19\u4f34\u751a\u81f3\u662f\u5750\u9a91\u3002\u966a\u4f60\u95ef\u8361\u4e09\u754c\uff01\u901a\u5929\u5165\u6d77\uff0c\u516b\u8352\u56db\u6d77\uff0c\u4e3a\u4f60\u800c\u6765\uff01</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\u4e09\u3001\u5feb\u4e50\u771f\u4eba\u793e\u4ea4</p><p class=\"bb_paragraph\" >\u5feb\u4e50\u4ea4\u53cb\u3001\u840c\u59b9\u76f8\u4f34\uff0c\u6253\u9020\u8f7b\u677e\u591a\u5143\u7684\u793e\u4ea4\u4f53\u7cfb\uff0c\u7434\u745f\u548c\u9e23\uff0c\u76f8\u6fe1\u4ee5\u6cab\u3002\u7384\u5929\u6708\u8001\uff0c\u7f18\u5b9a\u4e09\u751f\u3002\u7389\u5e26\u7f57\u88f3\u60a6\u541b\u5bb9\uff0c\u5171\u5ea6\u671d\u66ae\u4e24\u60c5\u957f\u3002\u5c82\u66f0\u65e0\u8863,\u4e0e\u5b50\u540c\u888d\u3002\u5404\u8def\u4ed9\u53cb\u643a\u624b\u540c\u884c\uff0c\u5171\u95ef\u897f\u6e38\u4ed9\u4fa0\u4e4b\u65c5\uff01</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\u300a\u68a6\u897f\u6e38\u300b\u966a\u4f34\u73a9\u5bb6\u5171\u540c\u770b\u5c3d\u6bcf\u4e00\u5e55\u98ce\u666f\uff0c\u8d70\u8fc7\u6bcf\u4e00\u4e2a\u56de\u5408\uff01</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\u6b22\u8fce\u6765\u5230\u68a6\u897f\u6e38\u7684\u5feb\u4e50\u4e16\u754c\uff0c\u795d\u4f60\u5f00\u5fc3\u6e38\u620f\u6bcf\u4e00\u5929\uff01</p>",
    "about_the_game": "<p class=\"bb_paragraph\" >\u73a9\u5bb6\u4e00\u81f4\u63a8\u8350\uff0c\u56de\u5408\u5236\u4fee\u4ed9\u6302\u673a\u6e38\u620f\u300a\u68a6\u897f\u6e38\u300b\u7ee7\u627f\u826f\u5fc3\u516c\u5e73\uff0c\u7ecf\u5178\u56de\u5408\uff0c\u4eba\u4eba\u7231\u73a9\u7684\u521d\u5fc3\u4e0d\u6539\u3002\u65a9\u5996\u9664\u9b54\u3001\u7384\u5e7b\u897f\u6e38\uff0c\u5168\u65b0\u753b\u9762\uff0c\u89c6\u542c\u76db\u5bb4\uff0c\u878d\u5165\u6570\u5341\u4f59\u7c7b\u8da3\u5473\u73a9\u6cd5\u3002</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\u66f4\u6709\u795e\u517d\u4ed9\u5ba0\uff0c\u7eda\u4e3d\u98de\u5251\uff0c\u4eb2\u5bc6\u793e\u4ea4\uff0c\u624b\u6e38\u9ad8\u54c1\u8d28\u4e92\u52a8\u68a6\u5e7b\u5bb6\u56ed\u7b49\u591a\u79cd\u521b\u65b0\u73a9\u6cd5\uff0c\u7cbe\u7f8e\u6e05\u65b0\u7684\u753b\u98ce\uff0c\u7cbe\u7f8e\u7684\u4eba\u7269\u9020\u578b\uff0c\u5f15\u4eba\u5165\u80dc\u7684\u60c5\u8282\uff0c\u5e26\u7ed9\u73a9\u5bb6\u4e0d\u540c\u4ee5\u5f80\u7684\u5168\u65b0\u4f53\u9a8c\u3002</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\u767e\u53d8\u65f6\u88c5\uff0c\u7ed3\u5408\u591a\u79cd\u5143\u7d20\uff0c\u63d0\u4f9b\u6570\u767e\u5957\u7cbe\u7f8e\u68a6\u5e7b\u7684\u65f6\u88c5\uff0c\u6ee1\u8db3\u4f60\u7684\u6536\u96c6\u63a7\uff1b\u591a\u4eba\u540c\u5c4f,\u4e07\u4eba\u8de8\u670d\uff01\u5f3a\u52bf\u6df7\u6218\u3001\u70ab\u9177\u706b\u7206\u7684\u5bf9\u6218\u573a\u9762\uff0c\u91ca\u653e\u65e0\u9650\u6fc0\u60c5\u3002</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\u7cbe\u5fc3\u8bbe\u8ba1\u7684\u4e30\u5bcc\u573a\u666f\uff0c\u7eda\u4e3d\u7684\u6280\u80fd\u7279\u6548\uff0c\u795e\u5c06\u840c\u5ba0\u5750\u9a91\uff0c\u4f34\u4f60\u95ef\u8361\u4e09\u754c\u3002\u897f\u6e38\u4e0d\u505c\uff0c\u8ba9\u6211\u4eec\u6765\u4e00\u573a\u68a6\u5e7b\u7ecf\u5178\u7684\u897f\u6e38\u4fee\u4ed9\u4f53\u9a8c\u4e4b\u65c5\u5427\uff01</p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" >\u3010\u6e38\u620f\u7279\u8272\u3011</h2><p class=\"bb_paragraph\" >\u4e00\u3001\u591a\u79cd\u521b\u65b0\u73a9\u6cd5</p><p class=\"bb_paragraph\" >\u7b56\u7565\u6218\u6597\uff0c\u56e2\u961f\u6fc0\u6218\uff0c\u4f19\u4f34\u517b\u6210\uff0c\u840c\u5ba0\u7075\u517d\uff0c\u767e\u53d8\u9020\u578b\uff0c\u5feb\u4e50\u4ea4\u53cb\uff0c\u64cd\u4f5c\u7b80\u5355\u89e3\u653e\u53cc\u624b\uff0c\u4e0a\u73ed\u4e5f\u80fd\u62bd\u7a7a\u6302\u673a\u8f7b\u677e\u73a9\uff01</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\u4e8c\u3001\u5168\u65b0\u5750\u9a91\u767b\u573a</p><p class=\"bb_paragraph\" >\u8fd9\u662f\u4e00\u4e2a\u5145\u6ee1\u4e86\u7075\u6c14\u7684\u4e16\u754c\uff0c\u4e07\u7269\u90fd\u4f1a\u53d7\u5230\u5929\u5730\u95f4\u7075\u6c14\u7684\u5f71\u54cd\uff0c\u5c31\u8fde\u666e\u901a\u7684\u7269\u54c1\uff0c\u4e5f\u4f1a\u53d8\u6210\u751f\u7075\uff0c\u62e5\u6709\u81ea\u5df1\u7684\u610f\u8bc6\u3002\u4eba\u4eec\u53d1\u73b0\u5b83\u4eec\u540e\uff0c\u4fbf\u5c1d\u8bd5\u9a6f\u670d\u5b83\u4eec\uff0c\u4f7f\u4e4b\u6210\u4e3a\u4f19\u4f34\u751a\u81f3\u662f\u5750\u9a91\u3002\u966a\u4f60\u95ef\u8361\u4e09\u754c\uff01\u901a\u5929\u5165\u6d77\uff0c\u516b\u8352\u56db\u6d77\uff0c\u4e3a\u4f60\u800c\u6765\uff01</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\u4e09\u3001\u5feb\u4e50\u771f\u4eba\u793e\u4ea4</p><p class=\"bb_paragraph\" >\u5feb\u4e50\u4ea4\u53cb\u3001\u840c\u59b9\u76f8\u4f34\uff0c\u6253\u9020\u8f7b\u677e\u591a\u5143\u7684\u793e\u4ea4\u4f53\u7cfb\uff0c\u7434\u745f\u548c\u9e23\uff0c\u76f8\u6fe1\u4ee5\u6cab\u3002\u7384\u5929\u6708\u8001\uff0c\u7f18\u5b9a\u4e09\u751f\u3002\u7389\u5e26\u7f57\u88f3\u60a6\u541b\u5bb9\uff0c\u5171\u5ea6\u671d\u66ae\u4e24\u60c5\u957f\u3002\u5c82\u66f0\u65e0\u8863,\u4e0e\u5b50\u540c\u888d\u3002\u5404\u8def\u4ed9\u53cb\u643a\u624b\u540c\u884c\uff0c\u5171\u95ef\u897f\u6e38\u4ed9\u4fa0\u4e4b\u65c5\uff01</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\u300a\u68a6\u897f\u6e38\u300b\u966a\u4f34\u73a9\u5bb6\u5171\u540c\u770b\u5c3d\u6bcf\u4e00\u5e55\u98ce\u666f\uff0c\u8d70\u8fc7\u6bcf\u4e00\u4e2a\u56de\u5408\uff01</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\u6b22\u8fce\u6765\u5230\u68a6\u897f\u6e38\u7684\u5feb\u4e50\u4e16\u754c\uff0c\u795d\u4f60\u5f00\u5fc3\u6e38\u620f\u6bcf\u4e00\u5929\uff01</p>",
    "short_description": "\u300a\u68a6\u897f\u6e38\u300b\u662f\u4e00\u6b3e\u897f\u6e38\u9898\u6750\u7684\u56de\u5408\u5236\u5361\u724c\u6e38\u620f\u3002\u4ee5\u300a\u897f\u6e38\u8bb0\u300b\u3001\u300a\u5c01\u795e\u699c\u300b\u3001\u300a\u5c71\u6d77\u7ecf\u300b\u7b49\u7ecf\u5178\u795e\u8bdd\u6545\u4e8b\u4e3a\u57fa\u7840\uff0c\u6c47\u96c6\u4e86\u795e\u754c\u3001\u4ed9\u754c\u3001\u4eba\u754c\u3001\u5996\u754c\u3001\u9b54\u754c\u3001\u51a5\u754c\uff0c\u6089\u6570\u5c06\u77e5\u540d\u795e\u8bdd\u4eba\u7269\u6545\u4e8b\u6536\u62e2\u6e38\u620f\u4e4b\u4e2d\uff0c\u73a9\u5bb6\u53ef\u81ea\u7531\u642d\u914d\u795e\u5c06\uff0c\u5f81\u6218\u795e\u8bdd\u516d\u754c\u3002",
