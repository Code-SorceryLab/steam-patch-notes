    "is_free": true,
    "detailed_description": "<p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><strong>\u300a\u602a\u7269\u8054\u840c\u300b</strong>\u662f\u4e00\u6b3e\u91c7\u7528Q\u7248\u653e\u7f6e\u98ce\u683c\u6253\u9020\u7684\u6e38\u620f\uff0c\u73a9\u5bb6\u8fdb\u5165\u6e38\u620f\u9700\u8981\u901a\u8fc7\u57f9\u517b\u82f1\u96c4\u5361\u724c\u6765\u6784\u5efa\u5f3a\u5927\u7684\u9635\u5bb9\u4f53\u7cfb\uff0c\u540c\u65f6\u5229\u7528\u4e3b\u57ce\u79d1\u6280\u7814\u7a76\u7cfb\u7edf\u8fdb\u884c\u4f11\u95f2\u517b\u6210\u3002\u6e38\u620f\u4ee5\u4f11\u95f2\u653e\u677e\u4e3a\u4e3b\u9898\uff0c\u8ba9\u73a9\u5bb6\u5728\u6109\u5feb\u7684\u6e38\u620f\u4f53\u9a8c\u4e2d\u6d88\u706d\u4e0d\u65ad\u6d8c\u6765\u7684\u6df1\u6e0a\u9b54\u7269\uff0c\u4eab\u53d7\u5272\u8349\u7684\u4e50\u8da3\u3002\u968f\u7740\u4e3b\u7ebf\u5173\u5361\u7684\u63a8\u8fdb\uff0c\u66f4\u591a\u7684\u5185\u5bb9\u5c06\u4f1a\u5448\u73b0\uff0c\u611f\u5174\u8da3\u7684\u4e0b\u8f7d\u4e0e\u597d\u53cb\u4e00\u540c\u63a2\u7d22\u5404\u79cd\u521b\u65b0\u73a9\u6cd5\u5427\uff01</p><h2 class=\"bb_tag\" >\u602a\u7269\u8054\u840c\u73a9\u6cd5</h2><p class=\"bb_paragraph\" >1\u3001\u4e3b\u7ebf\u5173\u5361</p><p class=\"bb_paragraph\" >\u6e38\u620f\u524d\u671f\u7684\u4e3b\u8981\u73a9\u6cd5\uff0c\u6bcf\u96945\u5173\u4f1a\u6709BOSS\u5173\u5361\uff0c\u6253\u8fc7\u540e\u53ef\u4ee5\u9886\u53d6\u4e30\u539a\u7684\u5956\u52b1\u3002\u6e38\u620f\u5185\u5927\u90e8\u5206\u73a9\u6cd5\u7684\u89e3\u9501\u6761\u4ef6\u662f\u548c\u4e3b\u7ebf\u5173\u5361\u8fdb\u5ea6\u6302\u94a9\u7684\uff0c\u524d\u671f\u5c3d\u5feb\u63a8\u8fdb\u4e3b\u7ebf\u8fdb\u5ea6\uff0c\u53ef\u4ee5\u66f4\u65e9\u89e3\u9501\u65b0\u73a9\u6cd5\uff0c\u5feb\u4eba\u4e00\u6b65\u4f53\u9a8c\u65b0\u5185\u5bb9\uff0c\u8d62\u53d6\u65b0\u5956\u52b1</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >2\u3001\u63a2\u7d22</p><p class=\"bb_paragraph\" >\u5728\u6302\u673a\u7684\u8fc7\u7a0b\u4e2d\uff0c\u4f1a\u83b7\u5f97\u63a2\u7d22\u70b9\u5956\u52b1\u3002\u901a\u8fc7\u6d88\u8017\u63a2\u7d22\u70b9\u6d3e\u9063\u82f1\u96c4\u8fdb\u884c\u63a2\u7d22\uff0c\u63a2\u7d22\u5b8c\u6210\u540e\u4f1a\u4e3a\u60a8\u5e26\u6765\u6307\u5b9a\u5956\u52b1\u3002\u8981\u6ce8\u610f\u63a2\u7d22\u70b9\u6570\u7684\u79ef\u6512\u662f\u6709\u4e0a\u9650\u7684\uff0c\u8d85\u51fa\u4e0a\u9650\u540e\u518d\u8fdb\u884c\u5feb\u901f\u6302\u673a\u4f1a\u6d6a\u8d39\u63a2\u7d22\u70b9\uff0c\u5148\u6d3e\u9063\u5b8c\u6bd5\u4e4b\u540e\u518d\u8fdb\u884c\u6302\u673a\u6bd4\u8f83\u5408\u9002\uff0c\u53e6\u5916\u63a2\u7d22\u662f\u53ef\u4ee5\u5237\u51fa\u7d2b\u8272\u9b42\u77f3\u3001\u5947\u8ff9\u5377\u7b49\u8d85\u7a00\u6709\u7269\u54c1\u7684\uff0c\u795d\u5927\u5bb6\u597d\u8fd0</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >3\u3001\u6218\u4e89\u5b66\u9662</p><p class=\"bb_paragraph\" >\u901a\u8fc7\u83b7\u53d6\u82f1\u96c4\u3001\u82f1\u96c4\u5347\u661f\u7b49\u65b9\u5f0f\uff0c\u5b8c\u6210\u4efb\u52a1\u83b7\u53d6\u94bb\u77f3\u548c\u96c6\u7ed3\u5b9d\u5178\u3002\u6d3b\u52a8\u957f\u671f\u5b58\u5728\uff0c\u5982\u679c\u9996\u6708\u5185\u8fbe\u52306000\u5206\u8fd8\u4f1a\u83b7\u5f97\u795e\u8bdd\u82f1\u96c4\u81ea\u9009\u5956\u52b1\u3002\u6b64\u5916\u9996\u6708\u8fd8\u4f1a\u5f00\u5c55\u6392\u540d\u6d3b\u52a8\uff0c\u6709\u9650\u5b9a\u79f0\u53f7\u548c\u5934\u50cf\u6846\uff0c\u8fd8\u6709\u5927\u91cf\u5947\u8ff9\u5238\u5956\u52b1\u54e6~\u5efa\u8bae\u9996\u6708\u5728\u8fbe\u52306000\u5206\u7684\u57fa\u7840\u4e0a\u5c3d\u53ef\u80fd\u51b2\u4e0b\u6392\u540d</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" >\u602a\u7269\u8054\u840c\u57f9\u517b\u6280\u5de7</h2><p class=\"bb_paragraph\" >1\u3001\u5185\u57ce\u57f9\u517b</p><p class=\"bb_paragraph\" >\u5185\u57ce\u4e2d\u9996\u5148\u662f4\u5927\u8d44\u6e90\u70b9\uff1a\u4e3b\u57ce\u83b7\u53d6\u4fe1\u8d56\u3001\u4f10\u6728\u573a\u83b7\u53d6\u6728\u5934\u3001\u91d1\u77ff\u83b7\u53d6\u91d1\u5e01\u3001\u94c1\u77ff\u83b7\u53d6\u94c1\u5757\uff0c\u5efa\u8bae\u5347\u7ea7\u987a\u5e8f\u662f\u4e3b\u57ce\u2192\u4f10\u6728\u573a\u2192\u94c1\u77ff\u2192\u91d1\u77ff</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >2\u3001\u5e78\u8fd0\u796d\u575b</p><p class=\"bb_paragraph\" >\u5e78\u8fd0\u796d\u575b\u5206\u4e3a\u5e78\u8fd0\u8f6c\u76d8\u548c\u5947\u8ff9\u8f6c\u76d8\uff0c\u6d88\u8017\u5bf9\u5e94\u5377\u8f74\u62bd\u53d6\u5956\u52b1\uff0c\u5237\u65b0\u5956\u6c60\u4e0d\u4f1a\u5237\u65b0\u4fdd\u5e95\u6b21\u6570\uff0c\u5efa\u8bae\u5de6\u4e0a\u89d2\u5927\u5956\u53ef\u4ee5\u5237\u65b0\u5230\u4e00\u4e2a\u5fc3\u4eea\u7684\u9053\u5177\u540e\u518d\u8fdb\u884c\u62bd\u53d6\u3002</p><p class=\"bb_paragraph\" >\u79d1\u6280\u9986\u5185\u968f\u7b49\u7ea7\u63d0\u5347\u83b7\u53d6\u79d1\u6280\u70b9\uff0c\u6d88\u8017\u79d1\u6280\u70b9\u5347\u7ea7\u79d1\u6280\uff0c\u83b7\u53d6\u5f3a\u529b\u6548\u679c\u3002</p><p class=\"bb_paragraph\" >\u7ade\u6280\u573a\u662f\u548c\u73a9\u5bb6\u5bf9\u6218\u7684\u5730\u65b9\uff0c\u83b7\u5f97\u8bf8\u591a\u5956\u52b1\u3002\u6bcf\u5468\u7ade\u6280\u573a\u6218\u6597\u8fbe\u5230\u6307\u5b9a\u573a\u6b21\u8fd8\u80fd\u83b7\u5f97\u804c\u4e1a\u5238\u3001\u5947\u8ff9\u5238\u7b49\u5956\u52b1\uff0c\u5343\u4e07\u4e0d\u8981\u9519\u8fc7~</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >3\u3001\u5171\u9e23\u6c34\u6676</p><p class=\"bb_paragraph\" >\u5171\u9e23\u6c34\u6676\u5728\u57ce\u5899\u8fbe\u5230160\u7ea7\u5f00\u542f\uff0c\u7b49\u7ea7\u6700\u9ad8\u76849\u4f4d\u82f1\u96c4\u5c06\u4e3a\u6c34\u6676\u5145\u80fd\uff0c\u5171\u9e23\u6c34\u6676\u5185\u7684\u82f1\u96c4\u4f1a\u81ea\u52a8\u540c\u6b65\u4f4d\u5145\u80fd\u82f1\u96c4\u4e2d\u7684\u6700\u4f4e\u7b49\u7ea7\u3002\u89e3\u51b3\u4f60\u6362\u82f1\u96c4\u7684\u70e6\u607c\u3002</p><p class=\"bb_paragraph\" >\u5728\u5171\u9e23\u6c34\u6676\u8fbe\u5230240\u7ea7\uff0c\u4e5f\u5c31\u662f\u540c\u65f6\u62e5\u67099\u4f4d240\u7ea7\u7684\u89d2\u8272\u540e\uff0c\u5c06\u5f00\u542f\u6c34\u6676\u7a81\u7834\u529f\u80fd\uff0c\u6d88\u8017\u7ecf\u9a8c\u548c\u8fdb\u9636\u77f3\u53ef\u4ee5\u7a81\u7834\u7b49\u7ea7\u4e0a\u9650\uff0c\u63d0\u5347\u5168\u4f53\u82f1\u96c4\u5c5e\u6027</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p>",
    "about_the_game": "<p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><strong>\u300a\u602a\u7269\u8054\u840c\u300b</strong>\u662f\u4e00\u6b3e\u91c7\u7528Q\u7248\u653e\u7f6e\u98ce\u683c\u6253\u9020\u7684\u6e38\u620f\uff0c\u73a9\u5bb6\u8fdb\u5165\u6e38\u620f\u9700\u8981\u901a\u8fc7\u57f9\u517b\u82f1\u96c4\u5361\u724c\u6765\u6784\u5efa\u5f3a\u5927\u7684\u9635\u5bb9\u4f53\u7cfb\uff0c\u540c\u65f6\u5229\u7528\u4e3b\u57ce\u79d1\u6280\u7814\u7a76\u7cfb\u7edf\u8fdb\u884c\u4f11\u95f2\u517b\u6210\u3002\u6e38\u620f\u4ee5\u4f11\u95f2\u653e\u677e\u4e3a\u4e3b\u9898\uff0c\u8ba9\u73a9\u5bb6\u5728\u6109\u5feb\u7684\u6e38\u620f\u4f53\u9a8c\u4e2d\u6d88\u706d\u4e0d\u65ad\u6d8c\u6765\u7684\u6df1\u6e0a\u9b54\u7269\uff0c\u4eab\u53d7\u5272\u8349\u7684\u4e50\u8da3\u3002\u968f\u7740\u4e3b\u7ebf\u5173\u5361\u7684\u63a8\u8fdb\uff0c\u66f4\u591a\u7684\u5185\u5bb9\u5c06\u4f1a\u5448\u73b0\uff0c\u611f\u5174\u8da3\u7684\u4e0b\u8f7d\u4e0e\u597d\u53cb\u4e00\u540c\u63a2\u7d22\u5404\u79cd\u521b\u65b0\u73a9\u6cd5\u5427\uff01</p><h2 class=\"bb_tag\" >\u602a\u7269\u8054\u840c\u73a9\u6cd5</h2><p class=\"bb_paragraph\" >1\u3001\u4e3b\u7ebf\u5173\u5361</p><p class=\"bb_paragraph\" >\u6e38\u620f\u524d\u671f\u7684\u4e3b\u8981\u73a9\u6cd5\uff0c\u6bcf\u96945\u5173\u4f1a\u6709BOSS\u5173\u5361\uff0c\u6253\u8fc7\u540e\u53ef\u4ee5\u9886\u53d6\u4e30\u539a\u7684\u5956\u52b1\u3002\u6e38\u620f\u5185\u5927\u90e8\u5206\u73a9\u6cd5\u7684\u89e3\u9501\u6761\u4ef6\u662f\u548c\u4e3b\u7ebf\u5173\u5361\u8fdb\u5ea6\u6302\u94a9\u7684\uff0c\u524d\u671f\u5c3d\u5feb\u63a8\u8fdb\u4e3b\u7ebf\u8fdb\u5ea6\uff0c\u53ef\u4ee5\u66f4\u65e9\u89e3\u9501\u65b0\u73a9\u6cd5\uff0c\u5feb\u4eba\u4e00\u6b65\u4f53\u9a8c\u65b0\u5185\u5bb9\uff0c\u8d62\u53d6\u65b0\u5956\u52b1</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >2\u3001\u63a2\u7d22</p><p class=\"bb_paragraph\" >\u5728\u6302\u673a\u7684\u8fc7\u7a0b\u4e2d\uff0c\u4f1a\u83b7\u5f97\u63a2\u7d22\u70b9\u5956\u52b1\u3002\u901a\u8fc7\u6d88\u8017\u63a2\u7d22\u70b9\u6d3e\u9063\u82f1\u96c4\u8fdb\u884c\u63a2\u7d22\uff0c\u63a2\u7d22\u5b8c\u6210\u540e\u4f1a\u4e3a\u60a8\u5e26\u6765\u6307\u5b9a\u5956\u52b1\u3002\u8981\u6ce8\u610f\u63a2\u7d22\u70b9\u6570\u7684\u79ef\u6512\u662f\u6709\u4e0a\u9650\u7684\uff0c\u8d85\u51fa\u4e0a\u9650\u540e\u518d\u8fdb\u884c\u5feb\u901f\u6302\u673a\u4f1a\u6d6a\u8d39\u63a2\u7d22\u70b9\uff0c\u5148\u6d3e\u9063\u5b8c\u6bd5\u4e4b\u540e\u518d\u8fdb\u884c\u6302\u673a\u6bd4\u8f83\u5408\u9002\uff0c\u53e6\u5916\u63a2\u7d22\u662f\u53ef\u4ee5\u5237\u51fa\u7d2b\u8272\u9b42\u77f3\u3001\u5947\u8ff9\u5377\u7b49\u8d85\u7a00\u6709\u7269\u54c1\u7684\uff0c\u795d\u5927\u5bb6\u597d\u8fd0</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >3\u3001\u6218\u4e89\u5b66\u9662</p><p class=\"bb_paragraph\" >\u901a\u8fc7\u83b7\u53d6\u82f1\u96c4\u3001\u82f1\u96c4\u5347\u661f\u7b49\u65b9\u5f0f\uff0c\u5b8c\u6210\u4efb\u52a1\u83b7\u53d6\u94bb\u77f3\u548c\u96c6\u7ed3\u5b9d\u5178\u3002\u6d3b\u52a8\u957f\u671f\u5b58\u5728\uff0c\u5982\u679c\u9996\u6708\u5185\u8fbe\u52306000\u5206\u8fd8\u4f1a\u83b7\u5f97\u795e\u8bdd\u82f1\u96c4\u81ea\u9009\u5956\u52b1\u3002\u6b64\u5916\u9996\u6708\u8fd8\u4f1a\u5f00\u5c55\u6392\u540d\u6d3b\u52a8\uff0c\u6709\u9650\u5b9a\u79f0\u53f7\u548c\u5934\u50cf\u6846\uff0c\u8fd8\u6709\u5927\u91cf\u5947\u8ff9\u5238\u5956\u52b1\u54e6~\u5efa\u8bae\u9996\u6708\u5728\u8fbe\u52306000\u5206\u7684\u57fa\u7840\u4e0a\u5c3d\u53ef\u80fd\u51b2\u4e0b\u6392\u540d</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" >\u602a\u7269\u8054\u840c\u57f9\u517b\u6280\u5de7</h2><p class=\"bb_paragraph\" >1\u3001\u5185\u57ce\u57f9\u517b</p><p class=\"bb_paragraph\" >\u5185\u57ce\u4e2d\u9996\u5148\u662f4\u5927\u8d44\u6e90\u70b9\uff1a\u4e3b\u57ce\u83b7\u53d6\u4fe1\u8d56\u3001\u4f10\u6728\u573a\u83b7\u53d6\u6728\u5934\u3001\u91d1\u77ff\u83b7\u53d6\u91d1\u5e01\u3001\u94c1\u77ff\u83b7\u53d6\u94c1\u5757\uff0c\u5efa\u8bae\u5347\u7ea7\u987a\u5e8f\u662f\u4e3b\u57ce\u2192\u4f10\u6728\u573a\u2192\u94c1\u77ff\u2192\u91d1\u77ff</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >2\u3001\u5e78\u8fd0\u796d\u575b</p><p class=\"bb_paragraph\" >\u5e78\u8fd0\u796d\u575b\u5206\u4e3a\u5e78\u8fd0\u8f6c\u76d8\u548c\u5947\u8ff9\u8f6c\u76d8\uff0c\u6d88\u8017\u5bf9\u5e94\u5377\u8f74\u62bd\u53d6\u5956\u52b1\uff0c\u5237\u65b0\u5956\u6c60\u4e0d\u4f1a\u5237\u65b0\u4fdd\u5e95\u6b21\u6570\uff0c\u5efa\u8bae\u5de6\u4e0a\u89d2\u5927\u5956\u53ef\u4ee5\u5237\u65b0\u5230\u4e00\u4e2a\u5fc3\u4eea\u7684\u9053\u5177\u540e\u518d\u8fdb\u884c\u62bd\u53d6\u3002</p><p class=\"bb_paragraph\" >\u79d1\u6280\u9986\u5185\u968f\u7b49\u7ea7\u63d0\u5347\u83b7\u53d6\u79d1\u6280\u70b9\uff0c\u6d88\u8017\u79d1\u6280\u70b9\u5347\u7ea7\u79d1\u6280\uff0c\u83b7\u53d6\u5f3a\u529b\u6548\u679c\u3002</p><p class=\"bb_paragraph\" >\u7ade\u6280\u573a\u662f\u548c\u73a9\u5bb6\u5bf9\u6218\u7684\u5730\u65b9\uff0c\u83b7\u5f97\u8bf8\u591a\u5956\u52b1\u3002\u6bcf\u5468\u7ade\u6280\u573a\u6218\u6597\u8fbe\u5230\u6307\u5b9a\u573a\u6b21\u8fd8\u80fd\u83b7\u5f97\u804c\u4e1a\u5238\u3001\u5947\u8ff9\u5238\u7b49\u5956\u52b1\uff0c\u5343\u4e07\u4e0d\u8981\u9519\u8fc7~</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >3\u3001\u5171\u9e23\u6c34\u6676</p><p class=\"bb_paragraph\" >\u5171\u9e23\u6c34\u6676\u5728\u57ce\u5899\u8fbe\u5230160\u7ea7\u5f00\u542f\uff0c\u7b49\u7ea7\u6700\u9ad8\u76849\u4f4d\u82f1\u96c4\u5c06\u4e3a\u6c34\u6676\u5145\u80fd\uff0c\u5171\u9e23\u6c34\u6676\u5185\u7684\u82f1\u96c4\u4f1a\u81ea\u52a8\u540c\u6b65\u4f4d\u5145\u80fd\u82f1\u96c4\u4e2d\u7684\u6700\u4f4e\u7b49\u7ea7\u3002\u89e3\u51b3\u4f60\u6362\u82f1\u96c4\u7684\u70e6\u607c\u3002</p><p class=\"bb_paragraph\" >\u5728\u5171\u9e23\u6c34\u6676\u8fbe\u5230240\u7ea7\uff0c\u4e5f\u5c31\u662f\u540c\u65f6\u62e5\u67099\u4f4d240\u7ea7\u7684\u89d2\u8272\u540e\uff0c\u5c06\u5f00\u542f\u6c34\u6676\u7a81\u7834\u529f\u80fd\uff0c\u6d88\u8017\u7ecf\u9a8c\u548c\u8fdb\u9636\u77f3\u53ef\u4ee5\u7a81\u7834\u7b49\u7ea7\u4e0a\u9650\uff0c\u63d0\u5347\u5168\u4f53\u82f1\u96c4\u5c5e\u6027</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p>",
