assets/steam/apps/3606970/extras/835fcbd649a228c632d1193649315076.poster.avif?t=1754979138\" width=720 height=404 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3606970/extras/835fcbd649a228c632d1193649315076.webm?t=1754979138\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3606970/extras/835fcbd649a228c632d1193649315076.mp4?t=1754979138\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><strong>BRASS RAIN</strong> delivers authentic locations, equipment, combatants, and tactics\u2014and knowing your history will give you an edge.</p><p class=\"bb_paragraph\" > </p><h2 class=\"bb_tag\" ><strong>Wishlist &amp; Follow BRASS RAIN today!</strong></h2><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3606970/extras/79ed6ec87f8862669b1e64626f1e7217.poster.avif?t=1754979138\" width=720 height=404 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3606970/extras/79ed6ec87f8862669b1e64626f1e7217.webm?t=1754979138\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3606970/extras/79ed6ec87f8862669b1e64626f1e7217.mp4?t=1754979138\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p>",
