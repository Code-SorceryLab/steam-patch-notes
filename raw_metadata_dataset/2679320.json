076c7590125cb47179052bba6a1.poster.avif?t=1700141580\" width=600 height=114 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2679320/extras/8f5bb076c7590125cb47179052bba6a1.webm?t=1700141580\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2679320/extras/8f5bb076c7590125cb47179052bba6a1.mp4?t=1700141580\" type=\"video/mp4\"></video></span><br>Be prepared to face frightening apparitions and hostile spectres who will try to prevent you from discovering the truth.",
