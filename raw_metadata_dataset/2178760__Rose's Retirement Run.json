tatic.com/store_item_assets/steam/apps/2178760/extras/31b941be9d9d03192f9dea5cba94a164.mp4?t=1736367935\" type=\"video/mp4\"></video></div><br><br><strong>Features</strong><br>\u2022\tOver 70 levels to start and extra chapters coming soon<br>\u2022\tSimple controls<br>\u2022\tGets challenging as you progress<br>\u2022\tA funny yet engaging story<br>\u2022\tUnlockable levels<br>\u2022\tunlockable costumes for Granny (yes, stealth can be done with style!)<br>\u2022\tA game that is as fun to play then it is to watch being played.<br><br><div class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2178760/extras/ba538235ca1ba3e54e01cb1aa5e9339f.poster.avif?t=1736367935\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2178760/extras/ba538235ca1ba3e54e01cb1aa5e9339f.webm?t=1736367935\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2178760/extras/ba538235ca1ba3e54e01cb1aa5e9339f.mp4?t=1736367935\" type=\"video/mp4\"></video></div>",
