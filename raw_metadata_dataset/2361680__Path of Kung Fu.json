autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2361680/extras/3d7ae6c572e1330d824acb00f68dc594.poster.avif?t=1752803784\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2361680/extras/3d7ae6c572e1330d824acb00f68dc594.webm?t=1752803784\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2361680/extras/3d7ae6c572e1330d824acb00f68dc594.mp4?t=1752803784\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p>",
