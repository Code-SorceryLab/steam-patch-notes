utoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2652600/extras/0c623ff64a7c701f0d301f8bc08b066c.poster.avif?t=1754616486\" width=386 height=274 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2652600/extras/0c623ff64a7c701f0d301f8bc08b066c.webm?t=1754616486\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2652600/extras/0c623ff64a7c701f0d301f8bc08b066c.mp4?t=1754616486\" type=\"video/mp4\"></video></span></h2><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" >Brisk combat</h2><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2652600/extras/7c053e7f1a163d92ff0400c0f86b6766.poster.avif?t=1754616486\" width=486 height=340 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2652600/extras/7c053e7f1a163d92ff0400c0f86b6766.webm?t=1754616486\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2652600/extras/7c053e7f1a163d92ff0400c0f86b6766.mp4?t=1754616486\" type=\"video/mp4\"></video></span></p>",
