/shared.akamai.steamstatic.com/store_item_assets/steam/apps/2446010/extras/d7d29b21780ed53da4b57d7feafac58f.poster.avif?t=1744192830\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2446010/extras/d7d29b21780ed53da4b57d7feafac58f.webm?t=1744192830\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2446010/extras/d7d29b21780ed53da4b57d7feafac58f.mp4?t=1744192830\" type=\"video/mp4\"></video></span></p></li></ul>",
