eo class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2420880/extras/283db9464fce5fdb95db00fb4b7d3e3a.poster.avif?t=1726250594\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2420880/extras/283db9464fce5fdb95db00fb4b7d3e3a.webm?t=1726250594\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2420880/extras/283db9464fce5fdb95db00fb4b7d3e3a.mp4?t=1726250594\" type=\"video/mp4\"></video></span><br><br><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2420880/extras/41689dd6a88bbaaf86aa55b6fcebfed8.poster.avif?t=1726250594\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2420880/extras/41689dd6a88bbaaf86aa55b6fcebfed8.webm?t=1726250594\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2420880/extras/41689dd6a88bbaaf86aa55b6fcebfed8.mp4?t=1726250594\" type=\"video/mp4\"></video></span>",
