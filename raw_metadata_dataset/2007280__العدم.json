    "controller_support": "full",
    "detailed_description": "\u0627\u0644\u0639\u062f\u0645, \u0647\u064a \u0644\u0639\u0628\u0629 \u0627\u0644\u063a\u0627\u0632 \u0648\u0647\u0646\u0627\u0643 15 \u0644\u063a\u0632 \u0648\u064a\u062c\u0628 \u0639\u0644\u064a\u0643 \u0641\u064a \u0643\u0644 \u0645\u0631\u0629 \u0625\u064a\u062c\u0627\u062f \u0627\u0644\u0645\u0641\u062a\u0627\u062d, \u0648\u0628\u0639\u062f \u0625\u064a\u062c\u0627\u062f \u0627\u0644\u0645\u0641\u062a\u0627\u062d \u0633\u0648\u0641 \u0646\u0639\u0631\u0636 \u0639\u0644\u064a\u0643 \u0627\u0633\u0626\u0644\u0629 <br />\r\n,\u0648\u0628\u0646\u0627\u0621\u0627 \u0639\u0644\u0649 \u0623\u062c\u0648\u0628\u062a\u0643 \u0633\u0648\u0641 \u064a\u062a\u0645 \u062a\u062d\u062f\u064a\u062f \u0646\u0647\u0627\u064a\u062a\u0643 \u0641\u064a \u0627\u0644\u0644\u0639\u0628\u0629. \u0648\u0644\u0627\u062a\u0646\u0633\u0649 \u0623\u0646 \u0647\u0646\u0627\u0643 \u0666 \u0646\u0647\u0627\u064a\u0627\u062a \u0645\u062e\u062a\u0644\u0641\u0629 \u0641\u064a \u0627\u0644\u0644\u0639\u0628\u0629, <br />\r\n\u0648\u062a\u0630\u0643\u0631 \u062f\u0627\u0626\u0645\u0627 \u0623\u0646\u062a \u0645\u0646 \u064a\u062d\u062f\u062f \u0646\u0647\u0627\u064a\u0629 \u0627\u0644\u0644\u0639\u0628\u0629.",
    "about_the_game": "\u0627\u0644\u0639\u062f\u0645, \u0647\u064a \u0644\u0639\u0628\u0629 \u0627\u0644\u063a\u0627\u0632 \u0648\u0647\u0646\u0627\u0643 15 \u0644\u063a\u0632 \u0648\u064a\u062c\u0628 \u0639\u0644\u064a\u0643 \u0641\u064a \u0643\u0644 \u0645\u0631\u0629 \u0625\u064a\u062c\u0627\u062f \u0627\u0644\u0645\u0641\u062a\u0627\u062d, \u0648\u0628\u0639\u062f \u0625\u064a\u062c\u0627\u062f \u0627\u0644\u0645\u0641\u062a\u0627\u062d \u0633\u0648\u0641 \u0646\u0639\u0631\u0636 \u0639\u0644\u064a\u0643 \u0627\u0633\u0626\u0644\u0629 <br />\r\n,\u0648\u0628\u0646\u0627\u0621\u0627 \u0639\u0644\u0649 \u0623\u062c\u0648\u0628\u062a\u0643 \u0633\u0648\u0641 \u064a\u062a\u0645 \u062a\u062d\u062f\u064a\u062f \u0646\u0647\u0627\u064a\u062a\u0643 \u0641\u064a \u0627\u0644\u0644\u0639\u0628\u0629. \u0648\u0644\u0627\u062a\u0646\u0633\u0649 \u0623\u0646 \u0647\u0646\u0627\u0643 \u0666 \u0646\u0647\u0627\u064a\u0627\u062a \u0645\u062e\u062a\u0644\u0641\u0629 \u0641\u064a \u0627\u0644\u0644\u0639\u0628\u0629, <br />\r\n\u0648\u062a\u0630\u0643\u0631 \u062f\u0627\u0626\u0645\u0627 \u0623\u0646\u062a \u0645\u0646 \u064a\u062d\u062f\u062f \u0646\u0647\u0627\u064a\u0629 \u0627\u0644\u0644\u0639\u0628\u0629.",
    "short_description": "\u0644\u0639\u0628\u0629 \u0627\u0644\u063a\u0627\u0632 \u0645\u0643\u0648\u0646\u0629 \u0645\u0646 \u0661\u0665 \u0644\u063a\u0632 , \u0648\u0628\u0639\u062f \u062d\u0644 \u0627\u0644\u0644\u063a\u0632 \u0633\u0648\u0641 \u062a\u0648\u0627\u062c\u0647 \u0627\u0633\u0626\u0644\u0629 \u0639\u0646 \u062d\u0627\u0644\u0629 \u0645\u0639\u064a\u0646\u0629 \u0648\u0628\u0646\u0627\u0621\u0627 \u0639\u0644\u0649 \u0625\u062c\u0627\u0628\u062a\u0643 \u062a\u0646\u062a\u0647\u064a \u0627\u0644\u0644\u0639\u0628\u0629, \u0648 \u064a\u0648\u062c\u062f \u0666 \u0646\u0647\u0627\u064a\u0627\u062a \u0644\u0644\u0639\u0628\u0629.",
