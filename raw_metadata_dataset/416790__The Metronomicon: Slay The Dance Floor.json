    "pc_requirements": {
        "minimum": "<strong>Minimum:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10<br></li><li><strong>Processor:</strong> 3rd Gen i3/AMD FX-4100 Series<br></li><li><strong>Memory:</strong> 4 GB RAM<br></li><li><strong>Graphics:</strong> Intel HD (Integrated), GeForce 6 Series/Radeon R7 Series<br></li><li><strong>Storage:</strong> 3 GB available space<br></li><li><strong>Sound Card:</strong> One that allows sound to come out of a sound maker</li></ul>",
        "recommended": "<strong>Recommended:</strong><br><ul class=\"bb_ul\"><li><strong>OS:</strong> Windows 10<br></li><li><strong>Processor:</strong> 5th Gen i3/1st Gen Ryzen (or better)<br></li><li><strong>Memory:</strong> 4 MB RAM<br></li><li><strong>Graphics:</strong> GeForce 7 Series /Radeon R7 Series (or better)<br></li><li><strong>Storage:</strong> 3 GB available space<br></li><li><strong>Additional Notes:</strong> You can use the following controllers for this game; M/K, Xbox 360 Controller, Xbox One Controller, PS3/PS4 controllers, PS3/4 Rock Band Guitars, XB Rock Band Guitars, our Custom &quot;The Metronomicon&quot; Dance Pad, plus the majority of USB Dance Pads (sadly we haven't tested them all so there is no guarantee on these)</li></ul>"
