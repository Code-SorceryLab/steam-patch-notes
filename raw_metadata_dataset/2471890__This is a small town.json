    "detailed_description": "<h2 class=\"bb_tag\" ><strong>\u4f5c\u8005\u63d0\u793a\uff1a\u672c\u6e38\u620f\u5c1a\u672a\u5b8c\u6210\uff0c\u8bf7\u8c28\u614e\u8d2d\u4e70</strong></h2><h2 class=\"bb_tag\" >\u5185\u5bb9\u4ecb\u7ecd\uff1a</h2><p class=\"bb_paragraph\" >\u8fd9\u662f\u4e00\u6b3e\u4ee5\u4f11\u95f2\u4e3a\u4e3b\u7684\u89d2\u8272\u626e\u6f14\u5c04\u53ea\u56e0\u6e38\u620f\u3002 </p><p class=\"bb_paragraph\" >\u4e3b\u4eba\u516c\u524d\u5f80\u4e00\u4e2a\u964c\u751f\u5c0f\u9547\u4efb\u804c\u5374\u610f\u5916\u9677\u5165\u4e86\u4e00\u573a\u9634\u8c0b\u5f53\u4e2d\u3002 </p><p class=\"bb_paragraph\" >\u4e3a\u6c42\u81ea\u4fdd\u4e3b\u4eba\u516c\u4e0d\u5f97\u4ee5\u53bb\u8c03\u67e5\u771f\u76f8\uff0c\u5374\u56e0\u6b64\u4e0e\u4e00\u4e9b\u7f8e\u5973\u4ea7\u751f\u4e86\u526a\u4e0d\u65ad\u7406\u8fd8\u4e71\u7684\u590d\u6742\u5173\u7cfb\u3002 </p><p class=\"bb_paragraph\" >\u9996\u5148\u4ece\u6000\u7591\u5bf9\u8c61\u7684\u5bb6\u4eba\u5165\u624b\uff0c\u6700\u7ec8\u8fbe\u6210\u5c06\u5404\u8def\u7f8e\u5973\u5c3d\u6570\u6536\u8fdb\u81ea\u5df1\u7684\u540e\u5bab\u7684\u6545\u4e8b\u3002 </p><p class=\"bb_paragraph\" >\u6e38\u620f\u76ee\u524d\u5c1a\u672a\u5236\u4f5c\u5b8c\u6210\uff0c\u5927\u5bb6\u60f3\u770b\u7684\u573a\u9762\u6bd4\u8f83\u5c11\uff0c\u8fd8\u5728\u72b9\u8c6b\u7684\u670b\u53cb\u53ef\u4ee5\u518d\u7b49\u7b49\u3002 </p><p class=\"bb_paragraph\" >\u672a\u6765\u4f1a\u6709\u5404\u79cd\u5404\u6837\u725b\u63b0\u7684\u5267\u60c5\u3002 </p><p class=\"bb_paragraph\" >\u6bcf\u4e2a\u62e5\u6709\u7acb\u7ed8\u7684\u5973\u6027\u89d2\u8272\u90fd\u5c06\u4f1a\u6709\u5979\u4eec\u81ea\u5df1\u72ec\u7279\u7684\u6545\u4e8b\u3002</p>",
