op playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3150040/extras/a4900438a4d83751132c4e6d5ba6f45e.poster.avif?t=1724858793\" width=600 height=338 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3150040/extras/a4900438a4d83751132c4e6d5ba6f45e.webm?t=1724858793\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3150040/extras/a4900438a4d83751132c4e6d5ba6f45e.mp4?t=1724858793\" type=\"video/mp4\"></video></span><br><br><br>Move: WASD<br>Press E to pick up useful items<br>Left click to use items</li></ul>",
