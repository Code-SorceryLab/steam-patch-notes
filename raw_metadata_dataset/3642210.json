//shared.akamai.steamstatic.com/store_item_assets/steam/apps/3642210/extras/c607c8d4e028cda44ecefdba09b5ccf4.poster.avif?t=1755622104\" width=600 height=324 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3642210/extras/c607c8d4e028cda44ecefdba09b5ccf4.webm?t=1755622104\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3642210/extras/c607c8d4e028cda44ecefdba09b5ccf4.mp4?t=1755622104\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><h2 class=\"bb_tag\" ><strong>A Story Woven in Sound</strong></h2><p class=\"bb_paragraph\" >Uncover a music-fueled mystery where the soundtrack isn\u2019t just background\u2014it\u2019s the key to saving a world ruled by rhythm.</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3642210/extras/81626ab328da5aca0a2c261c2fe206fe.avif?t=1755622104\" data-has-big width=1600 height=1200 /></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >Has controller support</p></li></ul>",
