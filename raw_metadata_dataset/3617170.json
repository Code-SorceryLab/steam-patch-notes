    "detailed_description": "<h2 class=\"bb_tag\" ><strong>\u5173\u4e8e\u8fd9\u6b3e\u6e38\u620f</strong></h2><p class=\"bb_paragraph\" >\u8fd9\u662f\u4e00\u90e8\u96c6\u6210\u4e86\u4e1c\u65b9\u6b63\u4f5c\u3001\u4e1c\u65b9\u65e7\u4f5c\u3001\u84ec\u83b1\u5c11\u5973\u7ed8\u5e7b\u60f3\u3001\u897f\u65b9\u7cfb\u5217\u7b49ZUN\u5404\u4e2a\u65f6\u671f\u7684\u4f5c\u54c1\u7684\u4e16\u754c\u89c2\uff0c\u4ee5\u4e5d\u4ee3\u963f\u793c\u5c11\u5973\u4e3a\u4e3b\uff0c\u4e1c\u65b9\u4f17\u751f\u76f8\u4e3a\u8f85\u5c55\u5f00\u7684\u5b8f\u5927\u53d9\u4e8b\u5411\u4e1c\u65b9\u540c\u4ebaRPG\uff1a </p><p class=\"bb_paragraph\" >\u62e5\u6709\u8fc7\u76ee\u4e0d\u5fd8\u80fd\u529b\u7684\u7a17\u7530\u963f\u6c42\u56e0\u4e00\u573a\u5669\u68a6\u4e27\u5931\u4e86\u6240\u6709\u524d\u4e16\u7684\u8bb0\u5fc6\u3002 </p><p class=\"bb_paragraph\" >\u4e3a\u4e86\u627e\u5bfb\u81ea\u5df1\u7684\u8bb0\u5fc6\uff0c\u7a17\u7530\u963f\u6c42\u8ddf\u968f\u5e7b\u60f3\u4e61\u4f17\u4eba\u8e0f\u904d\u5e7b\u60f3\u4e61\u7684\u6bcf\u4e00\u4e2a\u89d2\u843d\uff0c\u91cd\u65b0\u89c1\u8bc1\u5e7b\u60f3\u4e61\u7684\u5386\u53f2\u3002</p><p class=\"bb_paragraph\" >\u6e38\u620f\u6b64\u524d\u5df2\u5728steam\u53d1\u5e03\u5267\u60c5\u4f53\u9a8c\u7248\u672c\uff0c\u73b0\u7248\u672c\u4e3a\u6e38\u620f\u7684\u6b63\u5f0f\u7248\u672c\u3002</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3617170/extras/2fedceaa1eb8db7615c3647a7c5090ed.avif?t=1748571496\" width=486 height=117 /></span></p><p class=\"bb_paragraph\" >\u8fd9\u662f\u4e00\u90e8\u5c3d\u53ef\u80fd\u591a\u5730\u5c06\u4e1c\u65b9\u4e2d\u6d89\u53ca\u5230\u7684\u573a\u666f\u3001\u4e16\u754c\u89c2\uff0c\u8fd8\u539f\u4e00\u8bbe\u5e76\u65e0\u5dee\u522b\u5c55\u73b0\u7ed9\u73a9\u5bb6\u7684\u6e38\u620f\u3002</p><p class=\"bb_paragraph\" >\u6e38\u620f\u4e3b\u8981\u53d1\u751f\u5728\u7a17\u7530\u963f\u6c42\u6d3b\u52a8\u7684\u5e7b\u60f3\u4e61\u4e4b\u4e2d\uff08\u4e3b\u7ebf\uff09\uff0c\u4f46\u968f\u7740\u6e38\u620f\u7684\u8fdb\u5c55\uff0c\u5404\u4e2a\u52bf\u529b\u4e5f\u5c06\u5728\u81ea\u5df1\u7684\u821e\u53f0\u80cc\u666f\u5c55\u5f00\u884c\u52a8\u3002</p><p class=\"bb_paragraph\" >\u4ece\u5267\u60c5\u7ebf\u7cfb\u7edf\u4e2d\u9009\u62e9\u60f3\u8981\u524d\u5f80\u7684\u4e16\u754c\uff0c\u89c2\u770b\u81ea\u5df1\u611f\u5174\u8da3\u7684\u6545\u4e8b\u5427\uff01</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3617170/extras/1c13b2cd3a09902a82a485d049eec5dc.avif?t=1748571496\" width=486 height=117 /></span></p><p class=\"bb_paragraph\" >\u4ece\u9f99\u795e\u521b\u4e16\uff0c\u5230\u7a17\u7530\u963f\u793c\u7684\u8bde\u751f\uff1b\u4ece\u7ea2\u96fe\u5f02\u53d8\uff0c\u5230\u9526\u4e0a\u4eac\uff1b\u4ece\u79d8\u5c01\u672a\u6765\u4e16\u754c\u5230\u897f\u65b9Project\u2026\u2026</p><p class=\"bb_paragraph\" >\u5267\u60c5\u805a\u7126\u4e8e\u8fc7\u53bb\u3001\u73b0\u5728\u3001\u672a\u6765\u7684\u5e7b\u60f3\u4e61\u6545\u4e8b\uff0c\u7f16\u7ec7\u5b8f\u5927\u7684\u5e7b\u60f3\u4e61\u4e16\u754c\u89c2\u53d9\u4e8b\u3002</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3617170/extras/af7407e1b6618af1a3b4a7df833b021d.avif?t=1748571496\" width=486 height=117 /></span></p><p class=\"bb_paragraph\" >\u6218\u6597\u4e00\u6539\u4f20\u7edf\u56de\u5408\u5236\u7cfb\u7edf\uff0c\u8ba9\u73a9\u5bb6\u80fd\u591f\u4f53\u9a8c\u64cd\u7eb5\u6240\u6709\u4e1c\u65b9\u89d2\u8272\u7684\u5b9e\u611f\u3002</p><p class=\"bb_paragraph\" >\u4e00\u8def\u4e0a\u9047\u5230\u7684\u6240\u6709\u89d2\u8272\u3001\u654c\u4eba\u751a\u81f3npc\u90fd\u6709\u673a\u4f1a\u6210\u4e3a\u73a9\u5bb6\u53ef\u64cd\u7eb5\u7684\u81ea\u673a\u3002</p><p class=\"bb_paragraph\" >\u4eba\u7c7b\u3001\u5996\u7cbe\u3001\u5e7d\u7075\u3001\u795e\u660e\u3001\u5916\u661f\u4eba\uff08\uff1f\uff09\u2026\u2026\u5e26\u9886\u7740\u4f60\u7684\u5e7b\u60f3\u4e61\u5927\u519b\u5c3d\u60c5\u6218\u6597\u5427\uff01</p><h2 class=\"bb_tag\" ><strong>\u5982\u4f55\u64cd\u4f5c\uff1f</strong></h2><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3617170/extras/e82e2a147e909b07a1f5ead4d1eca3bf.avif?t=1748571496\" data-has-big width=800 height=450 /></span></p><h2 class=\"bb_tag\" ><strong>\u6218\u6597\u673a\u5236\u4ecb\u7ecd</strong></h2><p class=\"bb_paragraph\" >\u672c\u6e38\u620f\u4e3a\u56de\u5408\u5236\u6218\u6597\u3002</p><p class=\"bb_paragraph\" >\u7531\u73a9\u5bb6\u83b7\u5f97\u89d2\u8272\u5361\u724c\uff08\u5f0f\u795e\uff09\u8fdb\u884c\u7f16\u8f91\u6765\u4e0e\u654c\u4eba\u8fdb\u884c\u6218\u6597\u3002</p><p class=\"bb_paragraph\" >\u6218\u6597\u4e2d\u5b58\u5728\u591a\u79cd\u673a\u5236\uff0c\u7b49\u5f85\u73a9\u5bb6\u63a2\u7d22\u3002</p><h2 class=\"bb_tag\" ><strong>\u8bd5\u7528\u7248\u4e0e\u5b8c\u6574\u7248\u7684\u533a\u522b\uff1f</strong></h2><p class=\"bb_paragraph\" >\u6e38\u620f\u76ee\u524d\u4ec5\u53d1\u5e03\u4e86\u8bd5\u7528\u7248\uff0c\u4ece\u5267\u60c5\u4e0a\u8ba1\u7b97\u4ec5\u4e3a\u9884\u8ba1\u6700\u7ec8\u5b8c\u6210\u7248\u76845%\uff0c\u4e14\u8bb8\u591a\u529f\u80fd\u548cUI\u8fd8\u672a\u5b8c\u5584\u3002\u4f46\u4e0e\u6b63\u5f0f\u7248\u7684\u8bed\u8a00\u3001\u73a9\u5bb6\u6a21\u5f0f\u3001\u73a9\u6cd5\u3001\u673a\u5236\u5df2\u57fa\u672c\u76f8\u540c\u3002</p><h2 class=\"bb_tag\" ><strong>\u4f55\u65f6\u53d1\u5e03\u5b8c\u6574\u7248\uff1f</strong></h2><p class=\"bb_paragraph\" >\u6e38\u620f\u76ee\u524d\u4ec5\u53d1\u5e03\u4e86\u8bd5\u7528\u7248\uff0c\u4ece\u5267\u60c5\u4e0a\u8ba1\u7b97\u4ec5\u4e3a\u9884\u8ba1\u6700\u7ec8\u5b8c\u6210\u7248\u76845%\u3002 </p><p class=\"bb_paragraph\" >\u672c\u6e38\u620f\u5df2\u5728\u4e0a\u4e00\u6b3e\u6e38\u620f\u4e2d\u5b8c\u6210\u4e3b\u7ebf\u5267\u60c5\uff0c\u56e0\u6b64\u540e\u7eed\u7684\u5f00\u53d1\u8fdb\u5ea6\u76f8\u8f83\u4e8e\u5e73\u5e38\u4f1a\u66f4\u5feb\u3002</p><h2 class=\"bb_tag\" ><strong>\u6700\u540e\uff0c\u611f\u8c22\u60a8\u80fd\u9605\u8bfb\u6211\u60f3\u8bb2\u8ff0\u7684\u6545\u4e8b\u3002</strong></h2>",
    "about_the_game": "<h2 class=\"bb_tag\" ><strong>\u5173\u4e8e\u8fd9\u6b3e\u6e38\u620f</strong></h2><p class=\"bb_paragraph\" >\u8fd9\u662f\u4e00\u90e8\u96c6\u6210\u4e86\u4e1c\u65b9\u6b63\u4f5c\u3001\u4e1c\u65b9\u65e7\u4f5c\u3001\u84ec\u83b1\u5c11\u5973\u7ed8\u5e7b\u60f3\u3001\u897f\u65b9\u7cfb\u5217\u7b49ZUN\u5404\u4e2a\u65f6\u671f\u7684\u4f5c\u54c1\u7684\u4e16\u754c\u89c2\uff0c\u4ee5\u4e5d\u4ee3\u963f\u793c\u5c11\u5973\u4e3a\u4e3b\uff0c\u4e1c\u65b9\u4f17\u751f\u76f8\u4e3a\u8f85\u5c55\u5f00\u7684\u5b8f\u5927\u53d9\u4e8b\u5411\u4e1c\u65b9\u540c\u4ebaRPG\uff1a </p><p class=\"bb_paragraph\" >\u62e5\u6709\u8fc7\u76ee\u4e0d\u5fd8\u80fd\u529b\u7684\u7a17\u7530\u963f\u6c42\u56e0\u4e00\u573a\u5669\u68a6\u4e27\u5931\u4e86\u6240\u6709\u524d\u4e16\u7684\u8bb0\u5fc6\u3002 </p><p class=\"bb_paragraph\" >\u4e3a\u4e86\u627e\u5bfb\u81ea\u5df1\u7684\u8bb0\u5fc6\uff0c\u7a17\u7530\u963f\u6c42\u8ddf\u968f\u5e7b\u60f3\u4e61\u4f17\u4eba\u8e0f\u904d\u5e7b\u60f3\u4e61\u7684\u6bcf\u4e00\u4e2a\u89d2\u843d\uff0c\u91cd\u65b0\u89c1\u8bc1\u5e7b\u60f3\u4e61\u7684\u5386\u53f2\u3002</p><p class=\"bb_paragraph\" >\u6e38\u620f\u6b64\u524d\u5df2\u5728steam\u53d1\u5e03\u5267\u60c5\u4f53\u9a8c\u7248\u672c\uff0c\u73b0\u7248\u672c\u4e3a\u6e38\u620f\u7684\u6b63\u5f0f\u7248\u672c\u3002</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3617170/extras/2fedceaa1eb8db7615c3647a7c5090ed.avif?t=1748571496\" width=486 height=117 /></span></p><p class=\"bb_paragraph\" >\u8fd9\u662f\u4e00\u90e8\u5c3d\u53ef\u80fd\u591a\u5730\u5c06\u4e1c\u65b9\u4e2d\u6d89\u53ca\u5230\u7684\u573a\u666f\u3001\u4e16\u754c\u89c2\uff0c\u8fd8\u539f\u4e00\u8bbe\u5e76\u65e0\u5dee\u522b\u5c55\u73b0\u7ed9\u73a9\u5bb6\u7684\u6e38\u620f\u3002</p><p class=\"bb_paragraph\" >\u6e38\u620f\u4e3b\u8981\u53d1\u751f\u5728\u7a17\u7530\u963f\u6c42\u6d3b\u52a8\u7684\u5e7b\u60f3\u4e61\u4e4b\u4e2d\uff08\u4e3b\u7ebf\uff09\uff0c\u4f46\u968f\u7740\u6e38\u620f\u7684\u8fdb\u5c55\uff0c\u5404\u4e2a\u52bf\u529b\u4e5f\u5c06\u5728\u81ea\u5df1\u7684\u821e\u53f0\u80cc\u666f\u5c55\u5f00\u884c\u52a8\u3002</p><p class=\"bb_paragraph\" >\u4ece\u5267\u60c5\u7ebf\u7cfb\u7edf\u4e2d\u9009\u62e9\u60f3\u8981\u524d\u5f80\u7684\u4e16\u754c\uff0c\u89c2\u770b\u81ea\u5df1\u611f\u5174\u8da3\u7684\u6545\u4e8b\u5427\uff01</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3617170/extras/1c13b2cd3a09902a82a485d049eec5dc.avif?t=1748571496\" width=486 height=117 /></span></p><p class=\"bb_paragraph\" >\u4ece\u9f99\u795e\u521b\u4e16\uff0c\u5230\u7a17\u7530\u963f\u793c\u7684\u8bde\u751f\uff1b\u4ece\u7ea2\u96fe\u5f02\u53d8\uff0c\u5230\u9526\u4e0a\u4eac\uff1b\u4ece\u79d8\u5c01\u672a\u6765\u4e16\u754c\u5230\u897f\u65b9Project\u2026\u2026</p><p class=\"bb_paragraph\" >\u5267\u60c5\u805a\u7126\u4e8e\u8fc7\u53bb\u3001\u73b0\u5728\u3001\u672a\u6765\u7684\u5e7b\u60f3\u4e61\u6545\u4e8b\uff0c\u7f16\u7ec7\u5b8f\u5927\u7684\u5e7b\u60f3\u4e61\u4e16\u754c\u89c2\u53d9\u4e8b\u3002</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3617170/extras/af7407e1b6618af1a3b4a7df833b021d.avif?t=1748571496\" width=486 height=117 /></span></p><p class=\"bb_paragraph\" >\u6218\u6597\u4e00\u6539\u4f20\u7edf\u56de\u5408\u5236\u7cfb\u7edf\uff0c\u8ba9\u73a9\u5bb6\u80fd\u591f\u4f53\u9a8c\u64cd\u7eb5\u6240\u6709\u4e1c\u65b9\u89d2\u8272\u7684\u5b9e\u611f\u3002</p><p class=\"bb_paragraph\" >\u4e00\u8def\u4e0a\u9047\u5230\u7684\u6240\u6709\u89d2\u8272\u3001\u654c\u4eba\u751a\u81f3npc\u90fd\u6709\u673a\u4f1a\u6210\u4e3a\u73a9\u5bb6\u53ef\u64cd\u7eb5\u7684\u81ea\u673a\u3002</p><p class=\"bb_paragraph\" >\u4eba\u7c7b\u3001\u5996\u7cbe\u3001\u5e7d\u7075\u3001\u795e\u660e\u3001\u5916\u661f\u4eba\uff08\uff1f\uff09\u2026\u2026\u5e26\u9886\u7740\u4f60\u7684\u5e7b\u60f3\u4e61\u5927\u519b\u5c3d\u60c5\u6218\u6597\u5427\uff01</p><h2 class=\"bb_tag\" ><strong>\u5982\u4f55\u64cd\u4f5c\uff1f</strong></h2><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3617170/extras/e82e2a147e909b07a1f5ead4d1eca3bf.avif?t=1748571496\" data-has-big width=800 height=450 /></span></p><h2 class=\"bb_tag\" ><strong>\u6218\u6597\u673a\u5236\u4ecb\u7ecd</strong></h2><p class=\"bb_paragraph\" >\u672c\u6e38\u620f\u4e3a\u56de\u5408\u5236\u6218\u6597\u3002</p><p class=\"bb_paragraph\" >\u7531\u73a9\u5bb6\u83b7\u5f97\u89d2\u8272\u5361\u724c\uff08\u5f0f\u795e\uff09\u8fdb\u884c\u7f16\u8f91\u6765\u4e0e\u654c\u4eba\u8fdb\u884c\u6218\u6597\u3002</p><p class=\"bb_paragraph\" >\u6218\u6597\u4e2d\u5b58\u5728\u591a\u79cd\u673a\u5236\uff0c\u7b49\u5f85\u73a9\u5bb6\u63a2\u7d22\u3002</p><h2 class=\"bb_tag\" ><strong>\u8bd5\u7528\u7248\u4e0e\u5b8c\u6574\u7248\u7684\u533a\u522b\uff1f</strong></h2><p class=\"bb_paragraph\" >\u6e38\u620f\u76ee\u524d\u4ec5\u53d1\u5e03\u4e86\u8bd5\u7528\u7248\uff0c\u4ece\u5267\u60c5\u4e0a\u8ba1\u7b97\u4ec5\u4e3a\u9884\u8ba1\u6700\u7ec8\u5b8c\u6210\u7248\u76845%\uff0c\u4e14\u8bb8\u591a\u529f\u80fd\u548cUI\u8fd8\u672a\u5b8c\u5584\u3002\u4f46\u4e0e\u6b63\u5f0f\u7248\u7684\u8bed\u8a00\u3001\u73a9\u5bb6\u6a21\u5f0f\u3001\u73a9\u6cd5\u3001\u673a\u5236\u5df2\u57fa\u672c\u76f8\u540c\u3002</p><h2 class=\"bb_tag\" ><strong>\u4f55\u65f6\u53d1\u5e03\u5b8c\u6574\u7248\uff1f</strong></h2><p class=\"bb_paragraph\" >\u6e38\u620f\u76ee\u524d\u4ec5\u53d1\u5e03\u4e86\u8bd5\u7528\u7248\uff0c\u4ece\u5267\u60c5\u4e0a\u8ba1\u7b97\u4ec5\u4e3a\u9884\u8ba1\u6700\u7ec8\u5b8c\u6210\u7248\u76845%\u3002 </p><p class=\"bb_paragraph\" >\u672c\u6e38\u620f\u5df2\u5728\u4e0a\u4e00\u6b3e\u6e38\u620f\u4e2d\u5b8c\u6210\u4e3b\u7ebf\u5267\u60c5\uff0c\u56e0\u6b64\u540e\u7eed\u7684\u5f00\u53d1\u8fdb\u5ea6\u76f8\u8f83\u4e8e\u5e73\u5e38\u4f1a\u66f4\u5feb\u3002</p><h2 class=\"bb_tag\" ><strong>\u6700\u540e\uff0c\u611f\u8c22\u60a8\u80fd\u9605\u8bfb\u6211\u60f3\u8bb2\u8ff0\u7684\u6545\u4e8b\u3002</strong></h2>",
