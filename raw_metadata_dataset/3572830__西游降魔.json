    "detailed_description": "<h2 class=\"bb_tag\" ><strong>\u300a\u897f\u6e38\u964d\u9b54\u300b\u6e38\u620f\u6982\u8ff0</strong></h2><p class=\"bb_paragraph\" >\u300a\u897f\u6e38\u964d\u9b54\u300b\u662f\u4e00\u6b3e\u4ee5\u300a\u897f\u6e38\u8bb0\u300b\u4e3a\u80cc\u666f\u7684\u7384\u5e7b\u9898\u6750MMORPG\uff0c\u878d\u5408\u4e86\u7ecf\u5178\u795e\u8bdd\u89d2\u8272\u4e0e\u521b\u65b0\u73a9\u6cd5\u3002\u6e38\u620f\u4ee5\u201c\u53d8\u5316\u7cfb\u7edf\u201d\u4e3a\u6838\u5fc3\uff0c\u73a9\u5bb6\u53ef\u81ea\u7531\u5207\u6362\u5b59\u609f\u7a7a\u3001\u5927\u5723\u3001\u7d2b\u971e\u3001\u6768\u622c\u7b49\u7ecf\u5178\u89d2\u8272\u5f62\u6001\uff0c\u4f53\u9a8c\u4e0d\u540c\u6280\u80fd\u7ec4\u5408\u4e0e\u6218\u6597\u98ce\u683c\u3002\u901a\u8fc7\u4e30\u5bcc\u7684\u517b\u6210\u4f53\u7cfb\uff08\u5982\u8f6e\u56de\u3001\u88c5\u5907\u3001\u5143\u795e\u7b49\uff09\u548c\u793e\u4ea4\u73a9\u6cd5\uff08\u4ed9\u76df\u3001\u7ec4\u961f\uff09\uff0c\u73a9\u5bb6\u53ef\u9010\u6b65\u63d0\u5347\u5b9e\u529b\uff0c\u6311\u6218\u591a\u6837\u5316\u7684PVE\u526f\u672c\uff08\u5982\u901a\u5929\u5854\u3001\u4e16\u754cBOSS\uff09\u548cPVP\u6d3b\u52a8\uff08\u5982\u4ed9\u76df\u4e89\u9738\uff09\u3002\u6e38\u620f\u6ce8\u91cd\u7b56\u7565\u6027\u4e0e\u64cd\u4f5c\u611f\uff0c\u7ed3\u5408\u4e2d\u56fd\u53e4\u5178\u7f8e\u672f\u98ce\u683c\uff0c\u4e3a\u73a9\u5bb6\u63d0\u4f9b\u6c89\u6d78\u5f0f\u7684\u897f\u6e38\u5192\u9669\u4f53\u9a8c\u3002</p><h2 class=\"bb_tag\" ><strong>\u6838\u5fc3\u529f\u80fd\u4e0e\u7279\u8272\u73a9\u6cd5</strong></h2><h2 class=\"bb_tag\" ><strong>\u4e00\u3001\u6838\u5fc3\u7cfb\u7edf\uff1a\u53d8\u5316\u4e0e\u6280\u80fd</strong></h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>\u591a\u5f62\u6001\u5207\u6362</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u521d\u59cb\u89d2\u8272\u4e3a<strong>\u609f\u7a7a</strong>\uff0c\u53ef\u901a\u8fc7\u9053\u5177\u6fc0\u6d3b<strong>\u5927\u5723\u3001\u7d2b\u971e\u3001\u6768\u622c\u3001\u5929\u84ec\u3001\u5ae6\u5a25</strong>\u7b49\u5f62\u6001\uff0c\u6bcf\u4e2a\u5f62\u6001\u62e5\u6709\u72ec\u7acb\u6280\u80fd\u4e0e\u5916\u89c2\u3002</p></li><li><p class=\"bb_paragraph\" ><strong>\u5957\u88c5\u6548\u679c</strong>\uff1a\u6fc0\u6d3b\u5e76\u7a7f\u6234\u5168\u5957\u53d8\u5316\u88c5\u5907\uff08\u8db3\u8ff9\u3001\u79f0\u53f7\u3001\u6cd5\u5668\uff09\u53ef\u89e3\u9501\u989d\u5916\u6280\u80fd\uff08\u5982\u5927\u5723\u7684\u201c\u5b9a\u6d77\u795e\u9488\u201d\u79d2\u6740\u6982\u7387\uff09\u3002</p></li></ul></li><li><p class=\"bb_paragraph\" ><strong>\u7279\u8272\u6280\u80fd\u793a\u4f8b</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>\u609f\u7a7a</strong>\uff1a\u8fd1\u6218\u7206\u53d1\uff0c\u6280\u80fd\u5982\u201c\u5206\u6d77\u68cd\u201d\uff08\u84c4\u529b\u7a81\u523a\uff09\u3001\u201c\u94dc\u5934\u94c1\u81c2\u201d\uff08\u9632\u5fa1\u5f3a\u5316\uff09\u3002</p></li><li><p class=\"bb_paragraph\" ><strong>\u7d2b\u971e</strong>\uff1a\u8fdc\u7a0b\u63a7\u5236\uff0c\u6280\u80fd\u5982\u201c\u4e07\u5251\u5f52\u5b97\u201d\uff08\u8303\u56f4\u5251\u96e8\uff09\u3001\u201c\u7d2b\u9752\u53cc\u5251\u201d\uff08\u65e0\u654c\u4fdd\u547d\uff09\u3002</p></li><li><p class=\"bb_paragraph\" ><strong>\u6768\u622c</strong>\uff1a\u9ad8\u7206\u53d1\u8f93\u51fa\uff0c\u6280\u80fd\u5982\u201c\u4e09\u76ee\u5929\u773c\u201d\uff08\u6982\u7387\u79d2\u6740\u602a\u7269\uff09\u3001\u201c\u53ec\u5524\u5929\u72d7\u201d\uff08\u534f\u540c\u4f5c\u6218\uff09\u3002</p></li></ul></li></ul><h2 class=\"bb_tag\" ><strong>\u4e8c\u3001\u6df1\u5ea6\u517b\u6210\u4f53\u7cfb</strong></h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>\u7b49\u7ea7\u4e0e\u8f6e\u56de\u7cfb\u7edf</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>\u7b49\u7ea7\u7cfb\u7edf</strong>\uff1a\u901a\u8fc7\u4e3b\u7ebf\u4efb\u52a1\u3001\u6253\u602a\u3001\u7ecf\u9a8c\u526f\u672c\u63d0\u5347\u7b49\u7ea7\uff0c\u89e3\u9501\u65b0\u529f\u80fd\u3002</p></li><li><p class=\"bb_paragraph\" ><strong>\u8f6e\u56de\u7cfb\u7edf</strong>\uff1a110\u7ea7\u540e\u5f00\u542f\uff0c\u901a\u8fc7\u964d\u4f4e\u7b49\u7ea7\u5151\u6362\u4fee\u4e3a\uff0c\u7a7f\u6234\u9ad8\u9636\u8f6e\u56de\u88c5\u5907\uff0c\u63d0\u5347\u4f0f\u9b54\u503c\u4ee5\u6311\u6218\u66f4\u5f3a\u526f\u672c\u3002</p></li></ul></li><li><p class=\"bb_paragraph\" ><strong>\u88c5\u5907\u4e0e\u5f3a\u5316</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>\u8f6e\u56de\u88c5\u5907</strong>\uff1a\u5206\u9636\u7a7f\u6234\uff0c\u96c6\u9f50\u5957\u88c5\u53ef\u63d0\u5347\u5bf9\u602a\u4f24\u5bb3\u3002\u88c5\u5907\u53ef\u56de\u6536\u51b6\u70bc\uff0c\u5f3a\u5316\u5c5e\u6027\u7ee7\u627f\u81f3\u65b0\u88c5\u5907\u3002</p></li><li><p class=\"bb_paragraph\" ><strong>\u5f3a\u5316\u4e0e\u5b9d\u77f3</strong>\uff1a\u6d88\u8017\u4e4c\u94c1\u77ff\u5f3a\u5316\u88c5\u5907\u81f312\u7ea7\uff0c\u5168\u8eab\u5f3a\u5316\u89e6\u53d1\u989d\u5916\u5c5e\u6027\uff1b\u5b9d\u77f3\u9576\u5d4c\u63d0\u5347\u653b\u9632\uff0c\u9700\u6253\u5b54\u5668\u89e3\u9501\u5b54\u4f4d\u3002</p></li></ul></li><li><p class=\"bb_paragraph\" ><strong>\u8f85\u52a9\u7cfb\u7edf</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>\u5143\u795e/\u7ecf\u8109</strong>\uff1a\u62b5\u6d88\u73a9\u5bb6\u4f24\u5bb3\u3001\u63d0\u5347\u5c5e\u6027\uff0c\u901a\u8fc7\u4e39\u836f\u5347\u7ea7\u3002</p></li><li><p class=\"bb_paragraph\" ><strong>\u5ba0\u7269\u7cfb\u7edf</strong>\uff1a\u6218\u5ba0\uff08\u95ea\u907f+\u8f93\u51fa\uff09\u4e0e\u840c\u5ba0\uff08\u5c5e\u6027\u52a0\u6210\uff09\uff0c\u53ef\u5b66\u4e60\u6280\u80fd\u5982\u201c\u4e09\u500d\u653b\u51fb\u201d\u201c\u7ee7\u627f\u4e3b\u89d2\u5c5e\u6027\u201d\u3002</p></li><li><p class=\"bb_paragraph\" ><strong>\u5929\u4e66\u7cfb\u7edf</strong>\uff1a\u63d0\u4f9b\u7279\u6b8a\u6548\u679c\uff0c\u5982\u201c\u51b0\u5c01\u5929\u4e66\u201d\u51bb\u7ed3\u654c\u4eba\u3001\u201c\u8840\u9b44\u5929\u4e66\u201d\u653b\u51fb\u56de\u8840\u3002</p></li></ul></li></ul><h2 class=\"bb_tag\" ><strong>\u4e09\u3001\u793e\u4ea4\u4e0e\u4e92\u52a8\u73a9\u6cd5</strong></h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>\u4ed9\u76df\u7cfb\u7edf</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>\u521b\u5efa\u4e0e\u52a0\u5165</strong>\uff1a\u6d88\u8017300\u4ed9\u7389\u521b\u5efa\uff0c\u6216\u7533\u8bf7\u52a0\u5165\u73b0\u6709\u4ed9\u76df\uff0c\u804c\u4f4d\u5206\u76df\u4e3b\u3001\u526f\u76df\u4e3b\u7b49\u3002</p></li><li><p class=\"bb_paragraph\" ><strong>\u6838\u5fc3\u73a9\u6cd5</strong>\uff1a</p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>\u4ed9\u76df\u526f\u672c</strong>\uff1a\u6bcf\u65e5\u6311\u6218\uff0c\u83b7\u53d6\u8d21\u732e\u4e0e\u62cd\u5356\u5206\u7ea2\u3002</p></li><li><p class=\"bb_paragraph\" ><strong>\u4ed9\u76df\u4e89\u9738</strong>\uff1a\u6bcf\u5468\u4e09/\u516d\u5f00\u542f\uff0c\u5360\u9886\u53f7\u4ed9\u65d7\u4e89\u593a\u6392\u540d\u5956\u52b1\u3002</p></li></ul></li></ul></li><li><p class=\"bb_paragraph\" ><strong>\u7ecf\u6d4e\u4e0e\u4ea4\u6613</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>\u5bc4\u552e\u7cfb\u7edf</strong>\uff1a\u975e\u7ed1\u5b9a\u4ed9\u7389\u4ea4\u6613\u9053\u5177\uff0c\u652f\u6301\u4e0a\u67b6\u3001\u8d2d\u4e70\u4e0e\u9886\u53d6\u6536\u76ca\u3002</p></li><li><p class=\"bb_paragraph\" ><strong>\u5546\u57ce</strong>\uff1a\u5206\u70ed\u9500\u5546\u54c1\u3001\u6210\u957f\u53d8\u5f3a\u3001\u795e\u79d8\u5546\u5e97\u4e09\u7c7b\uff0c\u63d0\u4f9b\u65e5\u5e38\u6750\u6599\u4e0e\u968f\u673a\u6298\u6263\u9053\u5177\u3002</p></li></ul></li></ul><h2 class=\"bb_tag\" ><strong>\u56db\u3001\u7279\u8272\u6d3b\u52a8\u4e0e\u6311\u6218</strong></h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>PVE\u73a9\u6cd5</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>\u901a\u5929\u5854</strong>\uff1a\u9010\u5c42\u6311\u6218\u9650\u65f6\u526f\u672c\uff0c\u7d2f\u8ba1\u5956\u52b1\u968f\u5c42\u6570\u9012\u589e\u3002</p></li><li><p class=\"bb_paragraph\" ><strong>\u4e16\u754cBOSS</strong>\uff1a\u5168\u670d\u73a9\u5bb6\u534f\u4f5c\u51fb\u6740\uff0c\u6309\u4f24\u5bb3\u6392\u540d\u53d1\u653e\u5956\u52b1\uff0cBOSS\u5f3a\u5ea6\u52a8\u6001\u8c03\u6574\u3002</p></li><li><p class=\"bb_paragraph\" ><strong>\u7ecf\u9a8c\u5927\u7206</strong>\uff1a\u51fb\u6740\u602a\u7269\u6982\u7387\u89e6\u53d1\uff0c\u6389\u843d\u5927\u91cf\u7ecf\u9a8c\u4e39\u52a0\u901f\u5347\u7ea7\u3002</p></li></ul></li><li><p class=\"bb_paragraph\" ><strong>PVP\u4e0e\u9650\u65f6\u6d3b\u52a8</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>\u8363\u8000\u4e4b\u8def</strong>\uff1a\u9635\u8425\u5bf9\u6297\u73a9\u6cd5\uff0c\u51fb\u6740\u8f6c\u6362\u9635\u8425\uff0c\u6700\u7ec8\u79ef\u5206\u51b3\u5b9a\u5956\u52b1\u3002</p></li><li><p class=\"bb_paragraph\" ><strong>\u53cc\u500d\u62bc\u9556</strong>\uff1a\u62a4\u9001\u9556\u8f66\u83b7\u53d6\u7075\u77f3\uff0c\u53cc\u500d\u65f6\u95f4\u5956\u52b1\u7ffb\u500d\uff0c\u53ef\u8d2d\u4e70\u4fdd\u9669\u9632\u52ab\u9556\u3002</p></li></ul></li></ul><h2 class=\"bb_tag\" ><strong>\u4e94\u3001\u753b\u9762\u4e0e\u64cd\u4f5c</strong></h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>\u7f8e\u672f\u98ce\u683c</strong>\uff1a\u878d\u5408\u53e4\u5178\u795e\u8bdd\u4e0e\u73b0\u4ee3\u7384\u5e7b\uff0c\u89d2\u8272\u6280\u80fd\u7279\u6548\u534e\u4e3d\uff08\u5982\u7d2b\u971e\u7684\u5251\u96e8\u3001\u6768\u622c\u7684\u5929\u72d7\u53ec\u5524\uff09\u3002</p></li><li><p class=\"bb_paragraph\" ><strong>\u64cd\u4f5c\u9002\u914d</strong>\uff1a\u9488\u5bf9\u79fb\u52a8\u7aef\u4f18\u5316\uff0c\u652f\u6301\u81ea\u52a8\u5bfb\u8def\u3001\u65a9\u6740\u6280\u80fd\u81ea\u52a8\u89e6\u53d1\uff08\u9700\u5f00\u901a\u81f3\u5c0a\u6708\u5361\uff09\u3002</p></li></ul><p class=\"bb_paragraph\" > </p>",
    "about_the_game": "<h2 class=\"bb_tag\" ><strong>\u300a\u897f\u6e38\u964d\u9b54\u300b\u6e38\u620f\u6982\u8ff0</strong></h2><p class=\"bb_paragraph\" >\u300a\u897f\u6e38\u964d\u9b54\u300b\u662f\u4e00\u6b3e\u4ee5\u300a\u897f\u6e38\u8bb0\u300b\u4e3a\u80cc\u666f\u7684\u7384\u5e7b\u9898\u6750MMORPG\uff0c\u878d\u5408\u4e86\u7ecf\u5178\u795e\u8bdd\u89d2\u8272\u4e0e\u521b\u65b0\u73a9\u6cd5\u3002\u6e38\u620f\u4ee5\u201c\u53d8\u5316\u7cfb\u7edf\u201d\u4e3a\u6838\u5fc3\uff0c\u73a9\u5bb6\u53ef\u81ea\u7531\u5207\u6362\u5b59\u609f\u7a7a\u3001\u5927\u5723\u3001\u7d2b\u971e\u3001\u6768\u622c\u7b49\u7ecf\u5178\u89d2\u8272\u5f62\u6001\uff0c\u4f53\u9a8c\u4e0d\u540c\u6280\u80fd\u7ec4\u5408\u4e0e\u6218\u6597\u98ce\u683c\u3002\u901a\u8fc7\u4e30\u5bcc\u7684\u517b\u6210\u4f53\u7cfb\uff08\u5982\u8f6e\u56de\u3001\u88c5\u5907\u3001\u5143\u795e\u7b49\uff09\u548c\u793e\u4ea4\u73a9\u6cd5\uff08\u4ed9\u76df\u3001\u7ec4\u961f\uff09\uff0c\u73a9\u5bb6\u53ef\u9010\u6b65\u63d0\u5347\u5b9e\u529b\uff0c\u6311\u6218\u591a\u6837\u5316\u7684PVE\u526f\u672c\uff08\u5982\u901a\u5929\u5854\u3001\u4e16\u754cBOSS\uff09\u548cPVP\u6d3b\u52a8\uff08\u5982\u4ed9\u76df\u4e89\u9738\uff09\u3002\u6e38\u620f\u6ce8\u91cd\u7b56\u7565\u6027\u4e0e\u64cd\u4f5c\u611f\uff0c\u7ed3\u5408\u4e2d\u56fd\u53e4\u5178\u7f8e\u672f\u98ce\u683c\uff0c\u4e3a\u73a9\u5bb6\u63d0\u4f9b\u6c89\u6d78\u5f0f\u7684\u897f\u6e38\u5192\u9669\u4f53\u9a8c\u3002</p><h2 class=\"bb_tag\" ><strong>\u6838\u5fc3\u529f\u80fd\u4e0e\u7279\u8272\u73a9\u6cd5</strong></h2><h2 class=\"bb_tag\" ><strong>\u4e00\u3001\u6838\u5fc3\u7cfb\u7edf\uff1a\u53d8\u5316\u4e0e\u6280\u80fd</strong></h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>\u591a\u5f62\u6001\u5207\u6362</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u521d\u59cb\u89d2\u8272\u4e3a<strong>\u609f\u7a7a</strong>\uff0c\u53ef\u901a\u8fc7\u9053\u5177\u6fc0\u6d3b<strong>\u5927\u5723\u3001\u7d2b\u971e\u3001\u6768\u622c\u3001\u5929\u84ec\u3001\u5ae6\u5a25</strong>\u7b49\u5f62\u6001\uff0c\u6bcf\u4e2a\u5f62\u6001\u62e5\u6709\u72ec\u7acb\u6280\u80fd\u4e0e\u5916\u89c2\u3002</p></li><li><p class=\"bb_paragraph\" ><strong>\u5957\u88c5\u6548\u679c</strong>\uff1a\u6fc0\u6d3b\u5e76\u7a7f\u6234\u5168\u5957\u53d8\u5316\u88c5\u5907\uff08\u8db3\u8ff9\u3001\u79f0\u53f7\u3001\u6cd5\u5668\uff09\u53ef\u89e3\u9501\u989d\u5916\u6280\u80fd\uff08\u5982\u5927\u5723\u7684\u201c\u5b9a\u6d77\u795e\u9488\u201d\u79d2\u6740\u6982\u7387\uff09\u3002</p></li></ul></li><li><p class=\"bb_paragraph\" ><strong>\u7279\u8272\u6280\u80fd\u793a\u4f8b</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>\u609f\u7a7a</strong>\uff1a\u8fd1\u6218\u7206\u53d1\uff0c\u6280\u80fd\u5982\u201c\u5206\u6d77\u68cd\u201d\uff08\u84c4\u529b\u7a81\u523a\uff09\u3001\u201c\u94dc\u5934\u94c1\u81c2\u201d\uff08\u9632\u5fa1\u5f3a\u5316\uff09\u3002</p></li><li><p class=\"bb_paragraph\" ><strong>\u7d2b\u971e</strong>\uff1a\u8fdc\u7a0b\u63a7\u5236\uff0c\u6280\u80fd\u5982\u201c\u4e07\u5251\u5f52\u5b97\u201d\uff08\u8303\u56f4\u5251\u96e8\uff09\u3001\u201c\u7d2b\u9752\u53cc\u5251\u201d\uff08\u65e0\u654c\u4fdd\u547d\uff09\u3002</p></li><li><p class=\"bb_paragraph\" ><strong>\u6768\u622c</strong>\uff1a\u9ad8\u7206\u53d1\u8f93\u51fa\uff0c\u6280\u80fd\u5982\u201c\u4e09\u76ee\u5929\u773c\u201d\uff08\u6982\u7387\u79d2\u6740\u602a\u7269\uff09\u3001\u201c\u53ec\u5524\u5929\u72d7\u201d\uff08\u534f\u540c\u4f5c\u6218\uff09\u3002</p></li></ul></li></ul><h2 class=\"bb_tag\" ><strong>\u4e8c\u3001\u6df1\u5ea6\u517b\u6210\u4f53\u7cfb</strong></h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>\u7b49\u7ea7\u4e0e\u8f6e\u56de\u7cfb\u7edf</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>\u7b49\u7ea7\u7cfb\u7edf</strong>\uff1a\u901a\u8fc7\u4e3b\u7ebf\u4efb\u52a1\u3001\u6253\u602a\u3001\u7ecf\u9a8c\u526f\u672c\u63d0\u5347\u7b49\u7ea7\uff0c\u89e3\u9501\u65b0\u529f\u80fd\u3002</p></li><li><p class=\"bb_paragraph\" ><strong>\u8f6e\u56de\u7cfb\u7edf</strong>\uff1a110\u7ea7\u540e\u5f00\u542f\uff0c\u901a\u8fc7\u964d\u4f4e\u7b49\u7ea7\u5151\u6362\u4fee\u4e3a\uff0c\u7a7f\u6234\u9ad8\u9636\u8f6e\u56de\u88c5\u5907\uff0c\u63d0\u5347\u4f0f\u9b54\u503c\u4ee5\u6311\u6218\u66f4\u5f3a\u526f\u672c\u3002</p></li></ul></li><li><p class=\"bb_paragraph\" ><strong>\u88c5\u5907\u4e0e\u5f3a\u5316</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>\u8f6e\u56de\u88c5\u5907</strong>\uff1a\u5206\u9636\u7a7f\u6234\uff0c\u96c6\u9f50\u5957\u88c5\u53ef\u63d0\u5347\u5bf9\u602a\u4f24\u5bb3\u3002\u88c5\u5907\u53ef\u56de\u6536\u51b6\u70bc\uff0c\u5f3a\u5316\u5c5e\u6027\u7ee7\u627f\u81f3\u65b0\u88c5\u5907\u3002</p></li><li><p class=\"bb_paragraph\" ><strong>\u5f3a\u5316\u4e0e\u5b9d\u77f3</strong>\uff1a\u6d88\u8017\u4e4c\u94c1\u77ff\u5f3a\u5316\u88c5\u5907\u81f312\u7ea7\uff0c\u5168\u8eab\u5f3a\u5316\u89e6\u53d1\u989d\u5916\u5c5e\u6027\uff1b\u5b9d\u77f3\u9576\u5d4c\u63d0\u5347\u653b\u9632\uff0c\u9700\u6253\u5b54\u5668\u89e3\u9501\u5b54\u4f4d\u3002</p></li></ul></li><li><p class=\"bb_paragraph\" ><strong>\u8f85\u52a9\u7cfb\u7edf</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>\u5143\u795e/\u7ecf\u8109</strong>\uff1a\u62b5\u6d88\u73a9\u5bb6\u4f24\u5bb3\u3001\u63d0\u5347\u5c5e\u6027\uff0c\u901a\u8fc7\u4e39\u836f\u5347\u7ea7\u3002</p></li><li><p class=\"bb_paragraph\" ><strong>\u5ba0\u7269\u7cfb\u7edf</strong>\uff1a\u6218\u5ba0\uff08\u95ea\u907f+\u8f93\u51fa\uff09\u4e0e\u840c\u5ba0\uff08\u5c5e\u6027\u52a0\u6210\uff09\uff0c\u53ef\u5b66\u4e60\u6280\u80fd\u5982\u201c\u4e09\u500d\u653b\u51fb\u201d\u201c\u7ee7\u627f\u4e3b\u89d2\u5c5e\u6027\u201d\u3002</p></li><li><p class=\"bb_paragraph\" ><strong>\u5929\u4e66\u7cfb\u7edf</strong>\uff1a\u63d0\u4f9b\u7279\u6b8a\u6548\u679c\uff0c\u5982\u201c\u51b0\u5c01\u5929\u4e66\u201d\u51bb\u7ed3\u654c\u4eba\u3001\u201c\u8840\u9b44\u5929\u4e66\u201d\u653b\u51fb\u56de\u8840\u3002</p></li></ul></li></ul><h2 class=\"bb_tag\" ><strong>\u4e09\u3001\u793e\u4ea4\u4e0e\u4e92\u52a8\u73a9\u6cd5</strong></h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>\u4ed9\u76df\u7cfb\u7edf</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>\u521b\u5efa\u4e0e\u52a0\u5165</strong>\uff1a\u6d88\u8017300\u4ed9\u7389\u521b\u5efa\uff0c\u6216\u7533\u8bf7\u52a0\u5165\u73b0\u6709\u4ed9\u76df\uff0c\u804c\u4f4d\u5206\u76df\u4e3b\u3001\u526f\u76df\u4e3b\u7b49\u3002</p></li><li><p class=\"bb_paragraph\" ><strong>\u6838\u5fc3\u73a9\u6cd5</strong>\uff1a</p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>\u4ed9\u76df\u526f\u672c</strong>\uff1a\u6bcf\u65e5\u6311\u6218\uff0c\u83b7\u53d6\u8d21\u732e\u4e0e\u62cd\u5356\u5206\u7ea2\u3002</p></li><li><p class=\"bb_paragraph\" ><strong>\u4ed9\u76df\u4e89\u9738</strong>\uff1a\u6bcf\u5468\u4e09/\u516d\u5f00\u542f\uff0c\u5360\u9886\u53f7\u4ed9\u65d7\u4e89\u593a\u6392\u540d\u5956\u52b1\u3002</p></li></ul></li></ul></li><li><p class=\"bb_paragraph\" ><strong>\u7ecf\u6d4e\u4e0e\u4ea4\u6613</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>\u5bc4\u552e\u7cfb\u7edf</strong>\uff1a\u975e\u7ed1\u5b9a\u4ed9\u7389\u4ea4\u6613\u9053\u5177\uff0c\u652f\u6301\u4e0a\u67b6\u3001\u8d2d\u4e70\u4e0e\u9886\u53d6\u6536\u76ca\u3002</p></li><li><p class=\"bb_paragraph\" ><strong>\u5546\u57ce</strong>\uff1a\u5206\u70ed\u9500\u5546\u54c1\u3001\u6210\u957f\u53d8\u5f3a\u3001\u795e\u79d8\u5546\u5e97\u4e09\u7c7b\uff0c\u63d0\u4f9b\u65e5\u5e38\u6750\u6599\u4e0e\u968f\u673a\u6298\u6263\u9053\u5177\u3002</p></li></ul></li></ul><h2 class=\"bb_tag\" ><strong>\u56db\u3001\u7279\u8272\u6d3b\u52a8\u4e0e\u6311\u6218</strong></h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>PVE\u73a9\u6cd5</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>\u901a\u5929\u5854</strong>\uff1a\u9010\u5c42\u6311\u6218\u9650\u65f6\u526f\u672c\uff0c\u7d2f\u8ba1\u5956\u52b1\u968f\u5c42\u6570\u9012\u589e\u3002</p></li><li><p class=\"bb_paragraph\" ><strong>\u4e16\u754cBOSS</strong>\uff1a\u5168\u670d\u73a9\u5bb6\u534f\u4f5c\u51fb\u6740\uff0c\u6309\u4f24\u5bb3\u6392\u540d\u53d1\u653e\u5956\u52b1\uff0cBOSS\u5f3a\u5ea6\u52a8\u6001\u8c03\u6574\u3002</p></li><li><p class=\"bb_paragraph\" ><strong>\u7ecf\u9a8c\u5927\u7206</strong>\uff1a\u51fb\u6740\u602a\u7269\u6982\u7387\u89e6\u53d1\uff0c\u6389\u843d\u5927\u91cf\u7ecf\u9a8c\u4e39\u52a0\u901f\u5347\u7ea7\u3002</p></li></ul></li><li><p class=\"bb_paragraph\" ><strong>PVP\u4e0e\u9650\u65f6\u6d3b\u52a8</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>\u8363\u8000\u4e4b\u8def</strong>\uff1a\u9635\u8425\u5bf9\u6297\u73a9\u6cd5\uff0c\u51fb\u6740\u8f6c\u6362\u9635\u8425\uff0c\u6700\u7ec8\u79ef\u5206\u51b3\u5b9a\u5956\u52b1\u3002</p></li><li><p class=\"bb_paragraph\" ><strong>\u53cc\u500d\u62bc\u9556</strong>\uff1a\u62a4\u9001\u9556\u8f66\u83b7\u53d6\u7075\u77f3\uff0c\u53cc\u500d\u65f6\u95f4\u5956\u52b1\u7ffb\u500d\uff0c\u53ef\u8d2d\u4e70\u4fdd\u9669\u9632\u52ab\u9556\u3002</p></li></ul></li></ul><h2 class=\"bb_tag\" ><strong>\u4e94\u3001\u753b\u9762\u4e0e\u64cd\u4f5c</strong></h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>\u7f8e\u672f\u98ce\u683c</strong>\uff1a\u878d\u5408\u53e4\u5178\u795e\u8bdd\u4e0e\u73b0\u4ee3\u7384\u5e7b\uff0c\u89d2\u8272\u6280\u80fd\u7279\u6548\u534e\u4e3d\uff08\u5982\u7d2b\u971e\u7684\u5251\u96e8\u3001\u6768\u622c\u7684\u5929\u72d7\u53ec\u5524\uff09\u3002</p></li><li><p class=\"bb_paragraph\" ><strong>\u64cd\u4f5c\u9002\u914d</strong>\uff1a\u9488\u5bf9\u79fb\u52a8\u7aef\u4f18\u5316\uff0c\u652f\u6301\u81ea\u52a8\u5bfb\u8def\u3001\u65a9\u6740\u6280\u80fd\u81ea\u52a8\u89e6\u53d1\uff08\u9700\u5f00\u901a\u81f3\u5c0a\u6708\u5361\uff09\u3002</p></li></ul><p class=\"bb_paragraph\" > </p>",
