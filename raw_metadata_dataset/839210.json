839210/extras/632cd5e9a8f322599b4f2772dbedf66f.poster.avif?t=1572370196\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/839210/extras/632cd5e9a8f322599b4f2772dbedf66f.webm?t=1572370196\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/839210/extras/632cd5e9a8f322599b4f2772dbedf66f.mp4?t=1572370196\" type=\"video/mp4\"></video></div>",
    "short_description": "Professor Meme, a renowned 164-year-old genetic scientist, receives a mysterious call for help from his old friend Gustav, the head of the animal research base on Zerulia, an inhospitable planet inhabited by ancient aquatic creatures: the Seazogs.",
