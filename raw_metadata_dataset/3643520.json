    "detailed_description": "<h2 class=\"bb_tag\" ><strong>\u6e38\u620f\u6982\u8ff0</strong></h2><p class=\"bb_paragraph\" >\u300a\u5c11\u5e74\u540d\u5c06\u300b\u662f\u4e00\u6b3e\u4ee5\u4e09\u56fd\u9898\u6750\u4e3a\u80cc\u666f\u7684\u7ad6\u7248\u70ab\u6280\u5361\u724c\u7b56\u7565\u6e38\u620f\uff0c\u878d\u5408\u4e86\u653e\u7f6e\u517b\u6210\u4e0e\u7b56\u7565\u5bf9\u6218\u7684\u73a9\u6cd5\u3002\u73a9\u5bb6\u5c06\u901a\u8fc7\u62db\u52df\u548c\u57f9\u517b\u5f3a\u5927\u7684\u6b66\u5c06\uff0c\u642d\u914d\u72ec\u7279\u7684\u5143\u7d20\u7075\u77f3\u7cfb\u7edf\uff0c\u4f53\u9a8c\u4e09\u56fd\u4e71\u4e16\u7684\u4e89\u9738\u4e4b\u65c5\u3002\u6e38\u620f\u4ee5\u7cbe\u7f8e\u7684\u753b\u9762\u548c\u4e30\u5bcc\u7684\u73a9\u6cd5\u4e3a\u6838\u5fc3\uff0c\u63d0\u4f9b\u4e86\u591a\u79cd\u517b\u6210\u8def\u5f84\u548c\u7b56\u7565\u7ec4\u5408\uff0c\u8ba9\u73a9\u5bb6\u5728\u8f7b\u677e\u653e\u7f6e\u7684\u540c\u65f6\uff0c\u4e5f\u80fd\u4eab\u53d7\u6df1\u5ea6\u7684\u7b56\u7565\u5bf9\u6297\u3002</p><h2 class=\"bb_tag\" ><strong>\u6e38\u620f\u6838\u5fc3\u7279\u8272</strong></h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>\u4e09\u56fd\u9898\u6750\u4e0e\u5361\u724c\u7b56\u7565</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u4ee5\u7ecf\u5178\u4e09\u56fd\u6545\u4e8b\u4e3a\u80cc\u666f\uff0c\u73a9\u5bb6\u53ef\u4ee5\u62db\u52df\u5e76\u57f9\u517b\u6570\u767e\u4f4d\u5386\u53f2\u540d\u5c06\uff0c\u5305\u62ec\u7a00\u6709\u7684\u5929\u91d1\u795e\u5c06\u3002</p></li><li><p class=\"bb_paragraph\" >\u901a\u8fc7\u5de7\u5999\u7684\u6b66\u5c06\u642d\u914d\u548c\u5143\u7d20\u7075\u77f3\u7cfb\u7edf\uff0c\u89e3\u9501\u5168\u65b0\u7684\u5fa1\u7075\u4e4b\u672f\uff0c\u63d0\u5347\u6218\u6597\u529b\u3002</p></li></ul></li><li><p class=\"bb_paragraph\" ><strong>\u7ad6\u7248\u64cd\u4f5c\u4e0e\u8f7b\u677e\u653e\u7f6e</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u7ad6\u7248\u753b\u9762\u8bbe\u8ba1\uff0c\u9002\u5408\u5355\u624b\u64cd\u4f5c\uff0c\u968f\u65f6\u968f\u5730\u4eab\u53d7\u6e38\u620f\u3002</p></li><li><p class=\"bb_paragraph\" >\u653e\u7f6e\u73a9\u6cd5\u8ba9\u73a9\u5bb6\u5728\u79bb\u7ebf\u65f6\u4e5f\u80fd\u83b7\u5f97\u8d44\u6e90\u548c\u7ecf\u9a8c\uff0c\u8f7b\u677e\u517b\u6210\u5f3a\u529b\u6b66\u5c06\u3002</p></li></ul></li><li><p class=\"bb_paragraph\" ><strong>\u4e30\u5bcc\u7684\u798f\u5229\u4e0e\u5956\u52b1</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u767b\u5f55\u7b2c8\u5929\u8d60\u9001S+\u6838\u5fc3\u8f85\u52a9\u6b66\u5c06\u8bf8\u845b\u4eae\u3002</p></li><li><p class=\"bb_paragraph\" >\u4efb\u610f\u7d2f\u8ba1\u5145\u503c30\u5143\u5373\u53ef\u6fc0\u6d3b\u6708\u5361\uff0c\u6bcf\u65e5\u7279\u60e0\u793c\u5305\u63d0\u4f9b20\u500d\u8fd4\u5229\u3002</p></li><li><p class=\"bb_paragraph\" >\u7d2f\u8ba1\u767b\u5f5510\u5929\u53ef\u83b7\u5f97\u514d\u8d39110\u6b21\u62db\u52df\u673a\u4f1a\uff0c\u901a\u5173\u4e3b\u7ebf7-10\u9001\u540d\u5c06\u518c*5\u3002</p></li></ul></li><li><p class=\"bb_paragraph\" ><strong>\u591a\u6837\u5316\u7684\u73a9\u6cd5\u7cfb\u7edf</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>\u8bd5\u70bc\u526f\u672c</strong>\uff1a13\u7ea7\u5f00\u542f\uff0c\u5305\u542b\u94f6\u5e01\u3001\u7ecf\u9a8c\u3001\u88c5\u5907\u548c\u9526\u56ca\u526f\u672c\uff0c\u6bcf\u65e5\u53ef\u514d\u8d39\u626b\u83612\u6b21\u3002</p></li><li><p class=\"bb_paragraph\" ><strong>\u5b88\u536b\u8346\u5dde</strong>\uff1a25\u7ea7\u89e3\u9501\uff0c\u51fb\u8d25\u591a\u6ce2\u654c\u4eba\u83b7\u5f97\u6280\u80fd\u52a0\u6210\u548c\u4e30\u539a\u5956\u52b1\u3002</p></li><li><p class=\"bb_paragraph\" ><strong>\u9635\u8425\u593a\u9b41</strong>\uff1a\u5f00\u670d\u7b2c8\u5929\u5f00\u542f\uff0c\u73a9\u5bb6\u6839\u636e\u6700\u5f3a\u9635\u5bb9\u5206\u914d\u5230\u9b4f\u3001\u8700\u3001\u5434\u3001\u7fa4\u56db\u4e2a\u9635\u8425\uff0c\u53c2\u4e0e\u9884\u9009\u8d5b\u548c\u51b3\u8d5b\u4e89\u593a\u9738\u4e3b\u79f0\u53f7\u3002</p></li><li><p class=\"bb_paragraph\" ><strong>\u9010\u9e7f\u4e2d\u539f</strong>\uff1a\u5f00\u670d\u7b2c3\u30015\u30017\u5929\u5f00\u542f\uff0c\u91c7\u7528\u5355\u8d25\u6dd8\u6c70\u5236\uff0c\u51b3\u51fa\u51a0\u519b\u3001\u4e9a\u519b\u3001\u5b63\u519b\u548c\u6bbf\u519b\uff0c\u63d0\u4f9b\u4e30\u5bcc\u7684\u6392\u540d\u5956\u52b1\u548c\u7ade\u731c\u73a9\u6cd5\u3002</p></li></ul></li><li><p class=\"bb_paragraph\" ><strong>\u6df1\u5ea6\u7b56\u7565\u4e0e\u7ade\u6280\u4f53\u9a8c</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u6b66\u5c06\u6280\u80fd\u3001\u795e\u517d\u6548\u679c\u3001\u85cf\u54c1\u7f81\u7eca\u7b49\u591a\u79cd\u517b\u6210\u8def\u5f84\uff0c\u7b56\u7565\u7ec4\u5408\u4e30\u5bcc\u3002</p></li><li><p class=\"bb_paragraph\" >\u7ade\u6280\u573a\u3001\u8de8\u670d\u73a9\u6cd5\u7b49PVP\u5185\u5bb9\uff0c\u8003\u9a8c\u73a9\u5bb6\u7684\u9635\u5bb9\u642d\u914d\u548c\u64cd\u4f5c\u6280\u5de7\u3002</p></li></ul></li></ul><h2 class=\"bb_tag\" ><strong>\u6e38\u620f\u73a9\u6cd5\u8be6\u89e3</strong></h2><h2 class=\"bb_tag\" ><strong>\u8bd5\u70bc\u526f\u672c</strong></h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>\u5f00\u542f\u6761\u4ef6</strong>\uff1a13\u7ea7\uff08\u94f6\u5e01\u526f\u672c\uff09\u300116\u7ea7\uff08\u7ecf\u9a8c\u526f\u672c\uff09\u300122\u7ea7\uff08\u88c5\u5907\u526f\u672c\uff09\u300126\u7ea7\uff08\u9526\u56ca\u526f\u672c\uff09\u3002</p></li><li><p class=\"bb_paragraph\" ><strong>\u89c4\u5219</strong>\uff1a\u6311\u6218\u526f\u672c\u83b7\u5f97\u5bf9\u5e94\u517b\u6210\u9053\u5177\uff0c\u901a\u5173\u540e\u53ef\u626b\u8361\u3002\u6bcf\u65e5\u514d\u8d39\u626b\u83612\u6b21\uff0c\u4ed8\u8d391\u6b21\uff0cVIP\u7b49\u7ea7\u53ef\u589e\u52a0\u989d\u5916\u6b21\u6570\u3002</p></li></ul><h2 class=\"bb_tag\" ><strong>\u5b88\u536b\u8346\u5dde</strong></h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>\u5f00\u542f\u6761\u4ef6</strong>\uff1a25\u7ea7\u3002</p></li><li><p class=\"bb_paragraph\" ><strong>\u89c4\u5219</strong>\uff1a\u6bcf\u5173\u9047\u5230\u591a\u6ce2\u654c\u4eba\uff0c\u51fb\u8d25\u4e00\u5b9a\u6ce2\u6b21\u540e\u53ef\u9009\u62e9\u6280\u80fd\u52a0\u6210\u3002\u5173\u5361\u901a\u8fc7\u540e\u65e0\u6cd5\u91cd\u590d\u6311\u6218\uff0c\u63d0\u4f9b\u9996\u901a\u548c\u6ce2\u6b21\u5956\u52b1\u3002</p></li></ul><h2 class=\"bb_tag\" ><strong>\u9635\u8425\u593a\u9b41</strong></h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>\u5f00\u542f\u6761\u4ef6</strong>\uff1a\u5f00\u670d\u7b2c8\u5929\u3002</p></li><li><p class=\"bb_paragraph\" ><strong>\u89c4\u5219</strong>\uff1a\u6bcf\u5468\u4e00\u3001\u4e09\u3001\u4e94\u5f00\u542f\uff0c\u73a9\u5bb6\u6839\u636e\u9635\u5bb9\u5206\u914d\u5230\u56db\u4e2a\u9635\u8425\u3002\u9884\u9009\u8d5b20\u8f6e\u540e\uff0c\u524d8\u540d\u8fdb\u5165\u51b3\u8d5b\uff0c\u51b3\u51fa\u9635\u8425\u9738\u4e3b\u3002</p></li></ul><h2 class=\"bb_tag\" ><strong>\u9010\u9e7f\u4e2d\u539f</strong></h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>\u5f00\u542f\u6761\u4ef6</strong>\uff1a\u5f00\u670d\u7b2c3\u30015\u30017\u5929\u53ca\u540e\u7eed\u6bcf\u5468\u4e8c\u3001\u56db\u3001\u516d21:00\u3002</p></li><li><p class=\"bb_paragraph\" ><strong>\u89c4\u5219</strong>\uff1a\u5355\u8d25\u6dd8\u6c70\u5236\uff0c64\u5f3a\u73a9\u5bb6\u53c2\u4e0e\uff0c\u5206\u4e3a8\u4e2a\u8d5b\u533a\u8fdb\u884c8\u8f6e\u6bd4\u8d5b\u3002\u63d0\u4f9b\u8d5b\u524d\u7ade\u731c\u3001\u5b9e\u65f6\u7ade\u731c\u548c\u7ea2\u5305\u73a9\u6cd5\uff0c\u6700\u7ec8\u6392\u540d\u5956\u52b1\u5305\u62ec\u4e13\u5c5e\u5934\u50cf\u6846\u548c\u4e30\u539a\u9053\u5177\u3002</p></li></ul><h2 class=\"bb_tag\" ><strong>\u5176\u4ed6\u7279\u8272\u5185\u5bb9</strong></h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>\u795e\u9b54\u7cfb\u7edf</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u795e\u9b54\u6218\u4ee4\u63d0\u4f9b\u81ea\u9009\u7bb1\u5b50\uff0c\u53ef\u9009\u62e9\u65b0\u795e\u9b54\u6b66\u5c06\uff08\u7bb1\u5b50\u4f1a\u968f\u65b0\u795e\u9b54\u66f4\u65b0\uff09\u3002</p></li><li><p class=\"bb_paragraph\" >\u795e\u9b54\u94fe\u63a5\u53ef\u968f\u65f6\u66f4\u6362\uff0c\u4f46\u9700\u6d88\u8017100\u5143\u5b9d\u3002</p></li></ul></li><li><p class=\"bb_paragraph\" ><strong>\u519b\u56e2\u73a9\u6cd5</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u519b\u56e2\u526f\u672c\u901a\u8fc7\u540e\uff0c\u65e5\u5e38\u6311\u6218\u4efb\u52a1\u4ecd\u5b58\u5728\u3002</p></li><li><p class=\"bb_paragraph\" >\u519b\u56e2\u957f48\u5c0f\u65f6\u4e0d\u4e0a\u7ebf\u5c06\u81ea\u52a8\u8f6c\u8ba9\uff0c\u4f18\u5148\u526f\u56e2\u957f\u6216\u6309\u8d21\u732e\u5ea6\u6392\u5e8f\u3002</p></li></ul></li><li><p class=\"bb_paragraph\" ><strong>\u6280\u80fd\u4e0e\u673a\u5236</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u6b66\u5c06\u6280\u80fd\u548c\u5929\u8d4b\u6548\u679c\u591a\u6837\uff0c\u4f8b\u5982\u949f\u4f1a\u6280\u80fd\u57fa\u4e8e\u5168\u4f53\u6700\u5927\u751f\u547d\u503c\uff0c\u9b54\u8d75\u4e91\u7684\u8ffd\u51fb\u666e\u653b\u65e0\u6cd5\u89e6\u53d1\u5f20\u8fbd\u9526\u56ca\u3002</p></li><li><p class=\"bb_paragraph\" >\u7384\u6b66\u7684\u8d1f\u9762\u6548\u679c\u62b5\u6d88\u673a\u5236\u3001\u5973\u5a32\u62a4\u76fe\u4e0e\u9f99\u5492\u7684\u4ea4\u4e92\u7b49\uff0c\u589e\u52a0\u4e86\u7b56\u7565\u6df1\u5ea6\u3002</p></li></ul></li></ul><h2 class=\"bb_tag\" ><strong>\u603b\u7ed3</strong></h2><p class=\"bb_paragraph\" ></p>",
    "about_the_game": "<h2 class=\"bb_tag\" ><strong>\u6e38\u620f\u6982\u8ff0</strong></h2><p class=\"bb_paragraph\" >\u300a\u5c11\u5e74\u540d\u5c06\u300b\u662f\u4e00\u6b3e\u4ee5\u4e09\u56fd\u9898\u6750\u4e3a\u80cc\u666f\u7684\u7ad6\u7248\u70ab\u6280\u5361\u724c\u7b56\u7565\u6e38\u620f\uff0c\u878d\u5408\u4e86\u653e\u7f6e\u517b\u6210\u4e0e\u7b56\u7565\u5bf9\u6218\u7684\u73a9\u6cd5\u3002\u73a9\u5bb6\u5c06\u901a\u8fc7\u62db\u52df\u548c\u57f9\u517b\u5f3a\u5927\u7684\u6b66\u5c06\uff0c\u642d\u914d\u72ec\u7279\u7684\u5143\u7d20\u7075\u77f3\u7cfb\u7edf\uff0c\u4f53\u9a8c\u4e09\u56fd\u4e71\u4e16\u7684\u4e89\u9738\u4e4b\u65c5\u3002\u6e38\u620f\u4ee5\u7cbe\u7f8e\u7684\u753b\u9762\u548c\u4e30\u5bcc\u7684\u73a9\u6cd5\u4e3a\u6838\u5fc3\uff0c\u63d0\u4f9b\u4e86\u591a\u79cd\u517b\u6210\u8def\u5f84\u548c\u7b56\u7565\u7ec4\u5408\uff0c\u8ba9\u73a9\u5bb6\u5728\u8f7b\u677e\u653e\u7f6e\u7684\u540c\u65f6\uff0c\u4e5f\u80fd\u4eab\u53d7\u6df1\u5ea6\u7684\u7b56\u7565\u5bf9\u6297\u3002</p><h2 class=\"bb_tag\" ><strong>\u6e38\u620f\u6838\u5fc3\u7279\u8272</strong></h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>\u4e09\u56fd\u9898\u6750\u4e0e\u5361\u724c\u7b56\u7565</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u4ee5\u7ecf\u5178\u4e09\u56fd\u6545\u4e8b\u4e3a\u80cc\u666f\uff0c\u73a9\u5bb6\u53ef\u4ee5\u62db\u52df\u5e76\u57f9\u517b\u6570\u767e\u4f4d\u5386\u53f2\u540d\u5c06\uff0c\u5305\u62ec\u7a00\u6709\u7684\u5929\u91d1\u795e\u5c06\u3002</p></li><li><p class=\"bb_paragraph\" >\u901a\u8fc7\u5de7\u5999\u7684\u6b66\u5c06\u642d\u914d\u548c\u5143\u7d20\u7075\u77f3\u7cfb\u7edf\uff0c\u89e3\u9501\u5168\u65b0\u7684\u5fa1\u7075\u4e4b\u672f\uff0c\u63d0\u5347\u6218\u6597\u529b\u3002</p></li></ul></li><li><p class=\"bb_paragraph\" ><strong>\u7ad6\u7248\u64cd\u4f5c\u4e0e\u8f7b\u677e\u653e\u7f6e</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u7ad6\u7248\u753b\u9762\u8bbe\u8ba1\uff0c\u9002\u5408\u5355\u624b\u64cd\u4f5c\uff0c\u968f\u65f6\u968f\u5730\u4eab\u53d7\u6e38\u620f\u3002</p></li><li><p class=\"bb_paragraph\" >\u653e\u7f6e\u73a9\u6cd5\u8ba9\u73a9\u5bb6\u5728\u79bb\u7ebf\u65f6\u4e5f\u80fd\u83b7\u5f97\u8d44\u6e90\u548c\u7ecf\u9a8c\uff0c\u8f7b\u677e\u517b\u6210\u5f3a\u529b\u6b66\u5c06\u3002</p></li></ul></li><li><p class=\"bb_paragraph\" ><strong>\u4e30\u5bcc\u7684\u798f\u5229\u4e0e\u5956\u52b1</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u767b\u5f55\u7b2c8\u5929\u8d60\u9001S+\u6838\u5fc3\u8f85\u52a9\u6b66\u5c06\u8bf8\u845b\u4eae\u3002</p></li><li><p class=\"bb_paragraph\" >\u4efb\u610f\u7d2f\u8ba1\u5145\u503c30\u5143\u5373\u53ef\u6fc0\u6d3b\u6708\u5361\uff0c\u6bcf\u65e5\u7279\u60e0\u793c\u5305\u63d0\u4f9b20\u500d\u8fd4\u5229\u3002</p></li><li><p class=\"bb_paragraph\" >\u7d2f\u8ba1\u767b\u5f5510\u5929\u53ef\u83b7\u5f97\u514d\u8d39110\u6b21\u62db\u52df\u673a\u4f1a\uff0c\u901a\u5173\u4e3b\u7ebf7-10\u9001\u540d\u5c06\u518c*5\u3002</p></li></ul></li><li><p class=\"bb_paragraph\" ><strong>\u591a\u6837\u5316\u7684\u73a9\u6cd5\u7cfb\u7edf</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>\u8bd5\u70bc\u526f\u672c</strong>\uff1a13\u7ea7\u5f00\u542f\uff0c\u5305\u542b\u94f6\u5e01\u3001\u7ecf\u9a8c\u3001\u88c5\u5907\u548c\u9526\u56ca\u526f\u672c\uff0c\u6bcf\u65e5\u53ef\u514d\u8d39\u626b\u83612\u6b21\u3002</p></li><li><p class=\"bb_paragraph\" ><strong>\u5b88\u536b\u8346\u5dde</strong>\uff1a25\u7ea7\u89e3\u9501\uff0c\u51fb\u8d25\u591a\u6ce2\u654c\u4eba\u83b7\u5f97\u6280\u80fd\u52a0\u6210\u548c\u4e30\u539a\u5956\u52b1\u3002</p></li><li><p class=\"bb_paragraph\" ><strong>\u9635\u8425\u593a\u9b41</strong>\uff1a\u5f00\u670d\u7b2c8\u5929\u5f00\u542f\uff0c\u73a9\u5bb6\u6839\u636e\u6700\u5f3a\u9635\u5bb9\u5206\u914d\u5230\u9b4f\u3001\u8700\u3001\u5434\u3001\u7fa4\u56db\u4e2a\u9635\u8425\uff0c\u53c2\u4e0e\u9884\u9009\u8d5b\u548c\u51b3\u8d5b\u4e89\u593a\u9738\u4e3b\u79f0\u53f7\u3002</p></li><li><p class=\"bb_paragraph\" ><strong>\u9010\u9e7f\u4e2d\u539f</strong>\uff1a\u5f00\u670d\u7b2c3\u30015\u30017\u5929\u5f00\u542f\uff0c\u91c7\u7528\u5355\u8d25\u6dd8\u6c70\u5236\uff0c\u51b3\u51fa\u51a0\u519b\u3001\u4e9a\u519b\u3001\u5b63\u519b\u548c\u6bbf\u519b\uff0c\u63d0\u4f9b\u4e30\u5bcc\u7684\u6392\u540d\u5956\u52b1\u548c\u7ade\u731c\u73a9\u6cd5\u3002</p></li></ul></li><li><p class=\"bb_paragraph\" ><strong>\u6df1\u5ea6\u7b56\u7565\u4e0e\u7ade\u6280\u4f53\u9a8c</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u6b66\u5c06\u6280\u80fd\u3001\u795e\u517d\u6548\u679c\u3001\u85cf\u54c1\u7f81\u7eca\u7b49\u591a\u79cd\u517b\u6210\u8def\u5f84\uff0c\u7b56\u7565\u7ec4\u5408\u4e30\u5bcc\u3002</p></li><li><p class=\"bb_paragraph\" >\u7ade\u6280\u573a\u3001\u8de8\u670d\u73a9\u6cd5\u7b49PVP\u5185\u5bb9\uff0c\u8003\u9a8c\u73a9\u5bb6\u7684\u9635\u5bb9\u642d\u914d\u548c\u64cd\u4f5c\u6280\u5de7\u3002</p></li></ul></li></ul><h2 class=\"bb_tag\" ><strong>\u6e38\u620f\u73a9\u6cd5\u8be6\u89e3</strong></h2><h2 class=\"bb_tag\" ><strong>\u8bd5\u70bc\u526f\u672c</strong></h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>\u5f00\u542f\u6761\u4ef6</strong>\uff1a13\u7ea7\uff08\u94f6\u5e01\u526f\u672c\uff09\u300116\u7ea7\uff08\u7ecf\u9a8c\u526f\u672c\uff09\u300122\u7ea7\uff08\u88c5\u5907\u526f\u672c\uff09\u300126\u7ea7\uff08\u9526\u56ca\u526f\u672c\uff09\u3002</p></li><li><p class=\"bb_paragraph\" ><strong>\u89c4\u5219</strong>\uff1a\u6311\u6218\u526f\u672c\u83b7\u5f97\u5bf9\u5e94\u517b\u6210\u9053\u5177\uff0c\u901a\u5173\u540e\u53ef\u626b\u8361\u3002\u6bcf\u65e5\u514d\u8d39\u626b\u83612\u6b21\uff0c\u4ed8\u8d391\u6b21\uff0cVIP\u7b49\u7ea7\u53ef\u589e\u52a0\u989d\u5916\u6b21\u6570\u3002</p></li></ul><h2 class=\"bb_tag\" ><strong>\u5b88\u536b\u8346\u5dde</strong></h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>\u5f00\u542f\u6761\u4ef6</strong>\uff1a25\u7ea7\u3002</p></li><li><p class=\"bb_paragraph\" ><strong>\u89c4\u5219</strong>\uff1a\u6bcf\u5173\u9047\u5230\u591a\u6ce2\u654c\u4eba\uff0c\u51fb\u8d25\u4e00\u5b9a\u6ce2\u6b21\u540e\u53ef\u9009\u62e9\u6280\u80fd\u52a0\u6210\u3002\u5173\u5361\u901a\u8fc7\u540e\u65e0\u6cd5\u91cd\u590d\u6311\u6218\uff0c\u63d0\u4f9b\u9996\u901a\u548c\u6ce2\u6b21\u5956\u52b1\u3002</p></li></ul><h2 class=\"bb_tag\" ><strong>\u9635\u8425\u593a\u9b41</strong></h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>\u5f00\u542f\u6761\u4ef6</strong>\uff1a\u5f00\u670d\u7b2c8\u5929\u3002</p></li><li><p class=\"bb_paragraph\" ><strong>\u89c4\u5219</strong>\uff1a\u6bcf\u5468\u4e00\u3001\u4e09\u3001\u4e94\u5f00\u542f\uff0c\u73a9\u5bb6\u6839\u636e\u9635\u5bb9\u5206\u914d\u5230\u56db\u4e2a\u9635\u8425\u3002\u9884\u9009\u8d5b20\u8f6e\u540e\uff0c\u524d8\u540d\u8fdb\u5165\u51b3\u8d5b\uff0c\u51b3\u51fa\u9635\u8425\u9738\u4e3b\u3002</p></li></ul><h2 class=\"bb_tag\" ><strong>\u9010\u9e7f\u4e2d\u539f</strong></h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>\u5f00\u542f\u6761\u4ef6</strong>\uff1a\u5f00\u670d\u7b2c3\u30015\u30017\u5929\u53ca\u540e\u7eed\u6bcf\u5468\u4e8c\u3001\u56db\u3001\u516d21:00\u3002</p></li><li><p class=\"bb_paragraph\" ><strong>\u89c4\u5219</strong>\uff1a\u5355\u8d25\u6dd8\u6c70\u5236\uff0c64\u5f3a\u73a9\u5bb6\u53c2\u4e0e\uff0c\u5206\u4e3a8\u4e2a\u8d5b\u533a\u8fdb\u884c8\u8f6e\u6bd4\u8d5b\u3002\u63d0\u4f9b\u8d5b\u524d\u7ade\u731c\u3001\u5b9e\u65f6\u7ade\u731c\u548c\u7ea2\u5305\u73a9\u6cd5\uff0c\u6700\u7ec8\u6392\u540d\u5956\u52b1\u5305\u62ec\u4e13\u5c5e\u5934\u50cf\u6846\u548c\u4e30\u539a\u9053\u5177\u3002</p></li></ul><h2 class=\"bb_tag\" ><strong>\u5176\u4ed6\u7279\u8272\u5185\u5bb9</strong></h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" ><strong>\u795e\u9b54\u7cfb\u7edf</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u795e\u9b54\u6218\u4ee4\u63d0\u4f9b\u81ea\u9009\u7bb1\u5b50\uff0c\u53ef\u9009\u62e9\u65b0\u795e\u9b54\u6b66\u5c06\uff08\u7bb1\u5b50\u4f1a\u968f\u65b0\u795e\u9b54\u66f4\u65b0\uff09\u3002</p></li><li><p class=\"bb_paragraph\" >\u795e\u9b54\u94fe\u63a5\u53ef\u968f\u65f6\u66f4\u6362\uff0c\u4f46\u9700\u6d88\u8017100\u5143\u5b9d\u3002</p></li></ul></li><li><p class=\"bb_paragraph\" ><strong>\u519b\u56e2\u73a9\u6cd5</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u519b\u56e2\u526f\u672c\u901a\u8fc7\u540e\uff0c\u65e5\u5e38\u6311\u6218\u4efb\u52a1\u4ecd\u5b58\u5728\u3002</p></li><li><p class=\"bb_paragraph\" >\u519b\u56e2\u957f48\u5c0f\u65f6\u4e0d\u4e0a\u7ebf\u5c06\u81ea\u52a8\u8f6c\u8ba9\uff0c\u4f18\u5148\u526f\u56e2\u957f\u6216\u6309\u8d21\u732e\u5ea6\u6392\u5e8f\u3002</p></li></ul></li><li><p class=\"bb_paragraph\" ><strong>\u6280\u80fd\u4e0e\u673a\u5236</strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u6b66\u5c06\u6280\u80fd\u548c\u5929\u8d4b\u6548\u679c\u591a\u6837\uff0c\u4f8b\u5982\u949f\u4f1a\u6280\u80fd\u57fa\u4e8e\u5168\u4f53\u6700\u5927\u751f\u547d\u503c\uff0c\u9b54\u8d75\u4e91\u7684\u8ffd\u51fb\u666e\u653b\u65e0\u6cd5\u89e6\u53d1\u5f20\u8fbd\u9526\u56ca\u3002</p></li><li><p class=\"bb_paragraph\" >\u7384\u6b66\u7684\u8d1f\u9762\u6548\u679c\u62b5\u6d88\u673a\u5236\u3001\u5973\u5a32\u62a4\u76fe\u4e0e\u9f99\u5492\u7684\u4ea4\u4e92\u7b49\uff0c\u589e\u52a0\u4e86\u7b56\u7565\u6df1\u5ea6\u3002</p></li></ul></li></ul><h2 class=\"bb_tag\" ><strong>\u603b\u7ed3</strong></h2><p class=\"bb_paragraph\" ></p>",
    "short_description": "\u300a\u5c11\u5e74\u540d\u5c06\u300b\u662f\u4e00\u6b3e\u7ed3\u5408\u4e09\u56fd\u9898\u6750\u3001\u5361\u724c\u7b56\u7565\u4e0e\u653e\u7f6e\u517b\u6210\u7684\u521b\u65b0\u6e38\u620f\uff0c\u9002\u5408\u559c\u6b22\u8f7b\u677e\u64cd\u4f5c\u4f46\u8ffd\u6c42\u6df1\u5ea6\u7b56\u7565\u7684\u73a9\u5bb6\u3002\u901a\u8fc7\u4e30\u5bcc\u7684\u73a9\u6cd5\u7cfb\u7edf\u3001\u5f3a\u5927\u7684\u798f\u5229\u673a\u5236\u548c\u591a\u6837\u5316\u7684\u6b66\u5c06\u517b\u6210\uff0c\u73a9\u5bb6\u53ef\u4ee5\u5728\u4e09\u56fd\u4e71\u4e16\u4e2d\u4f53\u9a8c\u62db\u52df\u540d\u5c06\u3001\u653b\u57ce\u7565\u5730\u3001\u4e00\u7edf\u5929\u4e0b\u7684\u5feb\u611f\u3002\u65e0\u8bba\u662f\u5355\u4eba\u526f\u672c\u6311\u6218\u8fd8\u662f\u8de8\u670d\u7ade\u6280\u5bf9\u6297\uff0c\u6e38\u620f\u90fd\u80fd\u63d0\u4f9b\u6301\u7eed\u7684\u65b0\u9c9c\u611f\u548c\u6210\u5c31\u611f\u3002",
