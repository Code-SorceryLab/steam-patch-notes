/2cc5ae668df287c3059cacff403b9ec3.poster.avif?t=1709183291\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2385660/extras/2cc5ae668df287c3059cacff403b9ec3.webm?t=1709183291\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2385660/extras/2cc5ae668df287c3059cacff403b9ec3.mp4?t=1709183291\" type=\"video/mp4\"></video></span><br><br></li><li>Plan your strategy for each room in a preparation phase where you expend your resources and get ready to raid!<br><br><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2385660/extras/404284776db362240afd1f78e40e5a0f.poster.avif?t=1709183291\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2385660/extras/404284776db362240afd1f78e40e5a0f.webm?t=1709183291\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2385660/extras/404284776db362240afd1f78e40e5a0f.mp4?t=1709183291\" type=\"video/mp4\"></video></span></li></ul>",
