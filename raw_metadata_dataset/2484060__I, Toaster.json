fb05ed9579bbfe35bb.poster.avif?t=1690632119\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2484060/extras/f518028029a5b0fb05ed9579bbfe35bb.webm?t=1690632119\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2484060/extras/f518028029a5b0fb05ed9579bbfe35bb.mp4?t=1690632119\" type=\"video/mp4\"></video></span>",
