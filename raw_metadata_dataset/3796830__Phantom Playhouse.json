oop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3796830/extras/dd7b25cc396be34092bfbf418886ae25.poster.avif?t=1754779774\" width=616 height=264 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3796830/extras/dd7b25cc396be34092bfbf418886ae25.webm?t=1754779774\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3796830/extras/dd7b25cc396be34092bfbf418886ae25.mp4?t=1754779774\" type=\"video/mp4\"></video></span></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >Dare to enter Phantom Playhouse.</p><p class=\"bb_paragraph\" >Discover what you were never meant to find...</p><p class=\"bb_paragraph\" ></p>",
