c=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3723210/extras/301debc6f5128d8e3f2c6f76fe15526a.avif?t=1747122465\" data-has-big width=800 height=450 /></span><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3723210/extras/ff76dca83ac63e4aacf5f551748f0f6d.avif?t=1747122465\" data-has-big width=800 height=450 /></span><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3723210/extras/7679c85b60da613ccd5b03c6a526f436.avif?t=1747122465\" data-has-big width=800 height=450 /></span><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3723210/extras/6020e1544667c04252265c48793c7310.avif?t=1747122465\" data-has-big width=800 height=450 /></span><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3723210/extras/850d2bf157e2e5ea8473f36da31f5f2f.avif?t=1747122465\" data-has-big width=800 height=450 /></span></p>",
