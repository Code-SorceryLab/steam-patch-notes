{
    "type": "game",
    "name": "\u5f02\u80fd\u91cd\u7ec4",
    "steam_appid": 3594590,
    "required_age": 0,
    "is_free": false,
    "detailed_description": "<p class=\"bb_paragraph\" >\u4f60\uff0c\u7fa1\u6155\u6e38\u620f\u91ccboss\u7684\u80fd\u529b\u5417\uff1f</p><p class=\"bb_paragraph\" >\u5f88\u597d\uff01\u5728\u8fd9\u4e2a\u6e38\u620f\u91cc\uff0c\u4f60\u53ef\u4ee5\u628a\u654c\u4eba\u7684\u80fd\u529b\uff0c\u6280\u80fd\uff0c\u751a\u81f3\u968f\u4ece\uff0c\u5b8c\u5b8c\u6574\u6574\u62a2\u8fc7\u6765\uff01</p><p class=\"bb_paragraph\" >\u4e0d\u662f\u8bf4\u5728\u6218\u6597\u7ed3\u675f\u7684\u65f6\u5019\u83b7\u53d6\u7684\u6218\u5229\u54c1\u54e6\uff0c\u800c\u662f\u5728\u6218\u6597\u5f00\u59cb\u4e4b\u524d\uff0c\u4f60\u5c31\u53ef\u4ee5\u62a2\u8fc7\u6765\u3002</p><p class=\"bb_paragraph\" >\u4e5f\u5c31\u662f\u8bf4\uff0c\u5728\u8003\u8651\u593a\u53d6\u654c\u4eba\u80fd\u529b\u4e3a\u81ea\u5df1\u6784\u7b51\u7684\u540c\u65f6\uff0c\u8fd8\u8981\u8003\u8651\u7834\u574f\u654c\u4eba\u80fd\u529b\u7684combo\uff0c\u751a\u81f3\u662f\u628a\u654c\u4eba\u7684\u6280\u80fd\u90fd\u593a\u53d6\u4e86\u8ba9\u654c\u4eba\u6ca1\u6280\u80fd\u53ef\u7528\uff0c\u6211\u60f3\u8fd9\u4e00\u5b9a\u5f88\u6709\u610f\u601d\u5427\uff1f</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\u9664\u4e86\u6211\u4eec\u4e3b\u89d2\u7684\u593a\u53d6\u80fd\u529b\uff0c\u540e\u7eed\u8fd8\u4f1a\u89e3\u9501\u4e24\u4f4d\u73a9\u6cd5\u5b8c\u5168\u4e0d\u76f8\u540c\u7684\u89d2\u8272\u3002</p><p class=\"bb_paragraph\" >\u5206\u522b\u662f\u955c\u50cf\u590d\u5236\u7684\u80fd\u529b\uff0c\u4ee5\u53ca\u521b\u9020\u4e0e\u6bc1\u706d\u7684\u80fd\u529b\u3002</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\u5728\u6b63\u5e38\u7684\u95ef\u5173\u6a21\u5f0f\u4e4b\u540e\uff0c\u8fd8\u4f1a\u89e3\u9501\u5b8c\u5168\u4e0d\u540c\u4f53\u9a8c\u7684\u3010\u6597\u86d0\u86d0\u3011\u6a21\u5f0f\uff01</p><p class=\"bb_paragraph\" >\u5728\u8fd9\u4e2a\u6e38\u620f\u521a\u88ab\u8bbe\u8ba1\u51fa\u6765\u6211\u5c31\u4e00\u76f4\u5fc3\u5fc3\u5ff5\u5ff5\u60f3\u6dfb\u52a0\u8fd9\u4e48\u4e00\u4e2a\u6a21\u5f0f\u4e86\u3002</p><p class=\"bb_paragraph\" >\u8ba9\u90a3\u4e9b\u8001\u662f\u6765\u6253\u6211\u4eec\u7684boss\u4e92\u76f8\u6218\u6597\uff0c\u731c\u731c\u8c01\u66f4\u5389\u5bb3\uff0c\u60f3\u5fc5\u4e5f\u5f88\u6709\u610f\u601d\u5427\uff01</p>",
    "about_the_game": "<p class=\"bb_paragraph\" >\u4f60\uff0c\u7fa1\u6155\u6e38\u620f\u91ccboss\u7684\u80fd\u529b\u5417\uff1f</p><p class=\"bb_paragraph\" >\u5f88\u597d\uff01\u5728\u8fd9\u4e2a\u6e38\u620f\u91cc\uff0c\u4f60\u53ef\u4ee5\u628a\u654c\u4eba\u7684\u80fd\u529b\uff0c\u6280\u80fd\uff0c\u751a\u81f3\u968f\u4ece\uff0c\u5b8c\u5b8c\u6574\u6574\u62a2\u8fc7\u6765\uff01</p><p class=\"bb_paragraph\" >\u4e0d\u662f\u8bf4\u5728\u6218\u6597\u7ed3\u675f\u7684\u65f6\u5019\u83b7\u53d6\u7684\u6218\u5229\u54c1\u54e6\uff0c\u800c\u662f\u5728\u6218\u6597\u5f00\u59cb\u4e4b\u524d\uff0c\u4f60\u5c31\u53ef\u4ee5\u62a2\u8fc7\u6765\u3002</p><p class=\"bb_paragraph\" >\u4e5f\u5c31\u662f\u8bf4\uff0c\u5728\u8003\u8651\u593a\u53d6\u654c\u4eba\u80fd\u529b\u4e3a\u81ea\u5df1\u6784\u7b51\u7684\u540c\u65f6\uff0c\u8fd8\u8981\u8003\u8651\u7834\u574f\u654c\u4eba\u80fd\u529b\u7684combo\uff0c\u751a\u81f3\u662f\u628a\u654c\u4eba\u7684\u6280\u80fd\u90fd\u593a\u53d6\u4e86\u8ba9\u654c\u4eba\u6ca1\u6280\u80fd\u53ef\u7528\uff0c\u6211\u60f3\u8fd9\u4e00\u5b9a\u5f88\u6709\u610f\u601d\u5427\uff1f</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\u9664\u4e86\u6211\u4eec\u4e3b\u89d2\u7684\u593a\u53d6\u80fd\u529b\uff0c\u540e\u7eed\u8fd8\u4f1a\u89e3\u9501\u4e24\u4f4d\u73a9\u6cd5\u5b8c\u5168\u4e0d\u76f8\u540c\u7684\u89d2\u8272\u3002</p><p class=\"bb_paragraph\" >\u5206\u522b\u662f\u955c\u50cf\u590d\u5236\u7684\u80fd\u529b\uff0c\u4ee5\u53ca\u521b\u9020\u4e0e\u6bc1\u706d\u7684\u80fd\u529b\u3002</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\u5728\u6b63\u5e38\u7684\u95ef\u5173\u6a21\u5f0f\u4e4b\u540e\uff0c\u8fd8\u4f1a\u89e3\u9501\u5b8c\u5168\u4e0d\u540c\u4f53\u9a8c\u7684\u3010\u6597\u86d0\u86d0\u3011\u6a21\u5f0f\uff01</p><p class=\"bb_paragraph\" >\u5728\u8fd9\u4e2a\u6e38\u620f\u521a\u88ab\u8bbe\u8ba1\u51fa\u6765\u6211\u5c31\u4e00\u76f4\u5fc3\u5fc3\u5ff5\u5ff5\u60f3\u6dfb\u52a0\u8fd9\u4e48\u4e00\u4e2a\u6a21\u5f0f\u4e86\u3002</p><p class=\"bb_paragraph\" >\u8ba9\u90a3\u4e9b\u8001\u662f\u6765\u6253\u6211\u4eec\u7684boss\u4e92\u76f8\u6218\u6597\uff0c\u731c\u731c\u8c01\u66f4\u5389\u5bb3\uff0c\u60f3\u5fc5\u4e5f\u5f88\u6709\u610f\u601d\u5427\uff01</p>",
    "short_description": "\u300a\u5f02\u80fd\u91cd\u7ec4\u300b\u662f\u4e00\u6b3e\u56de\u5408\u5236\u7c7brogue\u6e38\u620f\u3002\u4f60\u7fa1\u6155\u6e38\u620f\u91ccboss\u7684\u80fd\u529b\u5417\uff1f\u5f88\u597d\uff01\u5728\u8fd9\u4e2a\u6e38\u620f\u91cc\uff0c\u4f60\u53ef\u4ee5\u628a\u654c\u4eba\u7684\u80fd\u529b\uff0c\u6280\u80fd\uff0c\u751a\u81f3\u968f\u4ece\uff0c\u5b8c\u5b8c\u6574\u6574\u62a2\u8fc7\u6765\uff01\u901a\u8fc7\u63a0\u593a\u7684\u624b\u6bb5\u6784\u7b51\u81ea\u5df1\u7684\u80fd\u529b\uff0c\u540c\u65f6\u7834\u574f\u654c\u4eba\u7684\u80fd\u529b\uff0c\u4f60\u80fd\u627e\u5230\u6700\u4f73\u7684\u9009\u62e9\u5417\uff1f\u968f\u7740\u8fdb\u5ea6\u73a9\u5bb6\u4e0e\u654c\u4eba\u7684\u5b9e\u529b\u5c06\u98de\u901f\u6210\u957f\uff0c\u6765\u4f53\u9a8c\u5b8c\u7f8ecombo\u5e26\u6765\u7684\u6570\u503c\u81a8\u80c0\u5427\uff01",
