hared.akamai.steamstatic.com/store_item_assets/steam/apps/3129400/extras/6b6e38b66fe6dc7074e8de7edb1888e2.webm?t=1730140030\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3129400/extras/6b6e38b66fe6dc7074e8de7edb1888e2.mp4?t=1730140030\" type=\"video/mp4\"></video></span>",
