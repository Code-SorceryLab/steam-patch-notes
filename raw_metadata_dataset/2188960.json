cec815e7e510e48e3c8bdde26ae.poster.avif?t=1693986928\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2188960/extras/085f3cec815e7e510e48e3c8bdde26ae.webm?t=1693986928\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2188960/extras/085f3cec815e7e510e48e3c8bdde26ae.mp4?t=1693986928\" type=\"video/mp4\"></video></div><br><br>Now YOU must choose a side.",
