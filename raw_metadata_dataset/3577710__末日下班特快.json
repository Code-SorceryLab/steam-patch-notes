    "short_description": "\u300a\u672b\u65e5\u4e0b\u73ed\u7279\u5feb\u300b\u662f\u4e00\u6b3e\u968f\u4ece\u6218\u6597Roguelike\u5361\u724c\u6784\u7b51\u6e38\u620f.\u53cb\u519b\u6b7b\u4ea1\u540e\u6210\u4e3a\u50f5\u5c38,\u767b\u573a\u5728\u654c\u65b9\u9635\u5730\u5e76\u4ea7\u751f\u4e30\u5bcc\u6548\u679c,\u9020\u5c31\u8d85\u591a\u8fde\u643a,\u6253\u51fa\u7206\u70b8\u4f24\u5bb3!\u83b7\u53d6\u72ec\u7279\u5347\u7ea7,\u63a2\u7d22\u4e0b\u73ed\u4e4b\u8def\u7684\u795e\u5947\u906d\u9047,\u9001\u4e58\u5ba2\u4eec\u5b89\u5168\u56de\u5bb6!",
