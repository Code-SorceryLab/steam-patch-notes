75abd028ba0217bc04d88e93.poster.avif?t=1752057325\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1863430/extras/177b55fc75abd028ba0217bc04d88e93.webm?t=1752057325\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1863430/extras/177b55fc75abd028ba0217bc04d88e93.mp4?t=1752057325\" type=\"video/mp4\"></video></div>",
