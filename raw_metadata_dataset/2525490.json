r=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2525490/extras/051b8d87aa57d87e98889e027e5c8bc9.poster.avif?t=1728291823\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2525490/extras/051b8d87aa57d87e98889e027e5c8bc9.webm?t=1728291823\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2525490/extras/051b8d87aa57d87e98889e027e5c8bc9.mp4?t=1728291823\" type=\"video/mp4\"></video></span>",
