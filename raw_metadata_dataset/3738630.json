    "detailed_description": "<h2 class=\"bb_tag\" ><strong>\u795e\u5df2\u6e0e\u804c\uff0c\u6211\u4eec\u5c06\u5e26\u6765\u8bf8\u795e\u9ec4\u660f\uff01</strong></h2><p class=\"bb_paragraph\" >\u4e5f\u8bb8\u4f60\u77e5\u9053\uff0c\u5728\u5149\u660e\u795e\u5df4\u5fb7\u5c14\u56e0\u4ed6\u7684\u76f2\u773c\u5144\u5f1f\u6240\u5c04\u51fa\u7684\u90a3\u4e00\u7bad\u6b7b\u53bb\u65f6\uff0c\u4e16\u754c\u5c31\u9677\u5165\u4e86\u6c38\u4e0d\u7ed3\u675f\u7684\u51ac\u5929\u3002</p><p class=\"bb_paragraph\" >\u8fd9\u573a\u88ab\u79f0\u4e3a\u82ac\u5e03\u5c14\u4e4b\u51ac\u7684\u53ef\u6015\u707e\u5384\u5e2d\u5377\u4e86\u4e16\u754c\uff0c\u81f4\u4f7f\u6574\u4e2a\u4e5d\u754c\u90fd\u9677\u5165\u4e86\u7edd\u671b\u3002\u5728\u8fd9\u6837\u7684\u672b\u65e5\u4e4b\u4e2d\uff0c\u8bf8\u795e\u5374\u65e0\u52a8\u4e8e\u8877\uff0c\u5bf9\u4ed6\u4eec\u7684\u4fe1\u4ef0\u65e9\u5df2\u88ab\u4eb5\u6e0e\u4e0e\u8df5\u8e0f\u3002</p><p class=\"bb_paragraph\" >\u800c\u4f60\uff0c\u53d7\u5230\u5973\u6b66\u795e\u4e0e\u547d\u8fd0\u7684\u53ec\u5524\uff0c\u51b3\u5b9a\u8e0f\u904d\u6240\u6709\u5815\u843d\u795e\u660e\u7684\u884c\u5bab\uff0c\u4e3a\u4ed6\u4eec\u4e5f\u5e26\u53bb\u672b\u65e5\u7684\u6ecb\u5473\u3002</p><p class=\"bb_paragraph\" >\u5728\u4e5d\u754c\u4e2d\u884c\u8d70\uff0c\u7ea0\u96c6\u4f19\u4f34\uff0c\u7ed3\u8bc6\u652f\u6301\u8005\uff0c\u8bc6\u7834\u9634\u8c0b...\u4e00\u573a\u6b63\u7edf\u7684\u53cd\u6297\u5192\u9669\u5373\u5c06\u5c55\u5f00\uff01</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\u5728\u6e38\u620f\u4e2d\uff0c\u4f60\u5c06\u626e\u6f14\u4e00\u4f4d\u53d7\u5230\u5973\u6b66\u795e\u53f7\u53ec\u7684\u4eba\u7c7b\u5192\u9669\u8005\u2014\u2014\u9b3c\u77e5\u9053\u5979\u4eec\u4e3a\u4ec0\u4e48\u8981\u53ec\u5524\u4f60\u3002\u4f5c\u4e3a\u4e00\u4e2a\u6b63\u7edf\u65e5\u7cfbRPG\u6e38\u620f\u7684\u4e3b\u89d2\uff0c\u4f60\u8981\u505a\u5728\u4efb\u4f55RPG\u6e38\u620f\u4e2d\u90fd\u4f1a\u505a\u7684\u4e8b\u3002</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\u4f60\u4f1a\u8ba4\u8bc6\u8bb8\u591a\u5f62\u5f62\u8272\u8272\u4e0d\u540c\u7684\u4eba\uff0c\u6709\u4e9b\u662f\u670b\u53cb\uff0c\u6709\u4e9b\u662f\u654c\u4eba\uff0c\u8fd9\u4e9b\u5bb6\u4f19\u53ef\u4e0d\u597d\u5e94\u4ed8\uff01</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\u4f60\u4f1a\u548c\u795e\u660e\u5c55\u5f00\u56de\u5408\u5236\u6218\u6597\uff0c\u5f53\u7136\uff0c\u4f46\u5728\u6b64\u4e4b\u524d\uff0c\u4f60\u8fd8\u8981\u548c\u5927\u6982999\u4e2a\u5c0f\u602a\u5148\u6253\u4e00\u904d\u3002</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\u4f60\u9700\u8981\u63d0\u5347\u81ea\u5df1\u7684\u529b\u91cf\uff0c\u5b66\u4e60\u65b0\u7684\u6280\u80fd\uff0c\u53d6\u5f97\u6216\u6253\u9020\u65b0\u7684\u88c5\u5907\uff0c\u5c06\u4f60\u4ece\u4e0d\u77e5\u4f55\u5904\u627e\u6765\u7684\u91d1\u5e01\u6362\u6210\u80fd\u652f\u6301\u4f60\u6218\u6597\u7684\u53ef\u9760\u540e\u63f4\u3002</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\u603b\u7684\u6765\u8bf4\uff0c\u5728\u6e38\u620f\u4e2d\uff0c\u4f60\u5c06\uff1a</p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u63a2\u7d22\u4e5d\u754c\u4e2d\u7684\u591a\u5ea7\u795e\u6bbf\u4e0e\u5e9f\u589f\uff0c\u89e3\u9501\u65b0\u7684\u5730\u56fe\u4e0e\u5267\u60c5</p></li><li><p class=\"bb_paragraph\" >\u4e0e\u591a\u4e2a\u62e5\u6709\u72ec\u7acb\u4e2a\u6027\u4e0e\u6545\u4e8b\u7684\u540c\u4f34\u76f8\u9047\u3001\u534f\u4f5c\u4e0e\u7f81\u7eca\u6210\u957f</p></li><li><p class=\"bb_paragraph\" >\u8fdb\u884c\u7b56\u7565\u578b\u7684\u56de\u5408\u5236\u6218\u6597\uff0c\u5229\u7528\u6280\u80fd\u3001\u5c5e\u6027\u4e0e\u6218\u672f\u51fb\u8d25\u654c\u4eba</p></li><li><p class=\"bb_paragraph\" >\u6536\u96c6\u6750\u6599\u3001\u6253\u9020\u88c5\u5907\uff0c\u5347\u7ea7\u89d2\u8272\u6280\u80fd\uff0c\u5f71\u54cd\u7ed3\u5c40\u8d70\u5411</p></li></ul><p class=\"bb_paragraph\" >\u5f53\u524d\u6e38\u620f\u7248\u672c\u5305\u542b\u7b2c\u4e00\u4e0e\u7b2c\u4e8c\u7ae0\u8282\uff0c\u603b\u8ba1\u7ea6\u5341+\u5c0f\u65f6\u7684\u5185\u5bb9\u3002\u5b8c\u6574\u7248\u672c\u8ba1\u5212\u5305\u542b\u516d\u7ae0\u5267\u60c5\uff0c\u5e76\u5c06\u5728\u672a\u6765\u6570\u6708\u5185\u6301\u7eed\u66f4\u65b0\u3002</p><p class=\"bb_paragraph\" >\u6240\u6709\u7cfb\u7edf\u673a\u5236\u5747\u5df2\u5b9e\u88c5\uff0c\u5305\u62ec\uff1a\u6218\u6597\u7cfb\u7edf\u3001\u63a2\u7d22\u7cfb\u7edf\u3001\u88c5\u5907\u7cfb\u7edf\u4e0e\u90e8\u5206\u89d2\u8272\u4e92\u52a8\u673a\u5236\u3002\u672a\u6765\u5c06\u6301\u7eed\u6269\u5c55\u5267\u60c5\u3001\u89d2\u8272\u5206\u652f\u4e0e\u65b0\u533a\u57df\u63a2\u7d22</p><p class=\"bb_paragraph\" >*\u63a8\u8350\u6e38\u73a9\u59ff\u52bf\uff1a\u8bf7\u628a\u4f60\u7684\u5de6\u624b\u653e\u5728WASD\u4e0a\uff0c\u53f3\u624b\u653e\u5728\u65b9\u5411\u952e\u4e0a\uff0c\u8ba9\u9f20\u6807\u4e00\u8fb9\u73a9\u53bb\u5427\u3002</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3738630/extras/d1873809960d91803d2d648a3949e41b.avif?t=1748938207\" data-has-big width=800 height=1132 /></span></p>",
    "about_the_game": "<h2 class=\"bb_tag\" ><strong>\u795e\u5df2\u6e0e\u804c\uff0c\u6211\u4eec\u5c06\u5e26\u6765\u8bf8\u795e\u9ec4\u660f\uff01</strong></h2><p class=\"bb_paragraph\" >\u4e5f\u8bb8\u4f60\u77e5\u9053\uff0c\u5728\u5149\u660e\u795e\u5df4\u5fb7\u5c14\u56e0\u4ed6\u7684\u76f2\u773c\u5144\u5f1f\u6240\u5c04\u51fa\u7684\u90a3\u4e00\u7bad\u6b7b\u53bb\u65f6\uff0c\u4e16\u754c\u5c31\u9677\u5165\u4e86\u6c38\u4e0d\u7ed3\u675f\u7684\u51ac\u5929\u3002</p><p class=\"bb_paragraph\" >\u8fd9\u573a\u88ab\u79f0\u4e3a\u82ac\u5e03\u5c14\u4e4b\u51ac\u7684\u53ef\u6015\u707e\u5384\u5e2d\u5377\u4e86\u4e16\u754c\uff0c\u81f4\u4f7f\u6574\u4e2a\u4e5d\u754c\u90fd\u9677\u5165\u4e86\u7edd\u671b\u3002\u5728\u8fd9\u6837\u7684\u672b\u65e5\u4e4b\u4e2d\uff0c\u8bf8\u795e\u5374\u65e0\u52a8\u4e8e\u8877\uff0c\u5bf9\u4ed6\u4eec\u7684\u4fe1\u4ef0\u65e9\u5df2\u88ab\u4eb5\u6e0e\u4e0e\u8df5\u8e0f\u3002</p><p class=\"bb_paragraph\" >\u800c\u4f60\uff0c\u53d7\u5230\u5973\u6b66\u795e\u4e0e\u547d\u8fd0\u7684\u53ec\u5524\uff0c\u51b3\u5b9a\u8e0f\u904d\u6240\u6709\u5815\u843d\u795e\u660e\u7684\u884c\u5bab\uff0c\u4e3a\u4ed6\u4eec\u4e5f\u5e26\u53bb\u672b\u65e5\u7684\u6ecb\u5473\u3002</p><p class=\"bb_paragraph\" >\u5728\u4e5d\u754c\u4e2d\u884c\u8d70\uff0c\u7ea0\u96c6\u4f19\u4f34\uff0c\u7ed3\u8bc6\u652f\u6301\u8005\uff0c\u8bc6\u7834\u9634\u8c0b...\u4e00\u573a\u6b63\u7edf\u7684\u53cd\u6297\u5192\u9669\u5373\u5c06\u5c55\u5f00\uff01</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\u5728\u6e38\u620f\u4e2d\uff0c\u4f60\u5c06\u626e\u6f14\u4e00\u4f4d\u53d7\u5230\u5973\u6b66\u795e\u53f7\u53ec\u7684\u4eba\u7c7b\u5192\u9669\u8005\u2014\u2014\u9b3c\u77e5\u9053\u5979\u4eec\u4e3a\u4ec0\u4e48\u8981\u53ec\u5524\u4f60\u3002\u4f5c\u4e3a\u4e00\u4e2a\u6b63\u7edf\u65e5\u7cfbRPG\u6e38\u620f\u7684\u4e3b\u89d2\uff0c\u4f60\u8981\u505a\u5728\u4efb\u4f55RPG\u6e38\u620f\u4e2d\u90fd\u4f1a\u505a\u7684\u4e8b\u3002</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\u4f60\u4f1a\u8ba4\u8bc6\u8bb8\u591a\u5f62\u5f62\u8272\u8272\u4e0d\u540c\u7684\u4eba\uff0c\u6709\u4e9b\u662f\u670b\u53cb\uff0c\u6709\u4e9b\u662f\u654c\u4eba\uff0c\u8fd9\u4e9b\u5bb6\u4f19\u53ef\u4e0d\u597d\u5e94\u4ed8\uff01</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\u4f60\u4f1a\u548c\u795e\u660e\u5c55\u5f00\u56de\u5408\u5236\u6218\u6597\uff0c\u5f53\u7136\uff0c\u4f46\u5728\u6b64\u4e4b\u524d\uff0c\u4f60\u8fd8\u8981\u548c\u5927\u6982999\u4e2a\u5c0f\u602a\u5148\u6253\u4e00\u904d\u3002</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\u4f60\u9700\u8981\u63d0\u5347\u81ea\u5df1\u7684\u529b\u91cf\uff0c\u5b66\u4e60\u65b0\u7684\u6280\u80fd\uff0c\u53d6\u5f97\u6216\u6253\u9020\u65b0\u7684\u88c5\u5907\uff0c\u5c06\u4f60\u4ece\u4e0d\u77e5\u4f55\u5904\u627e\u6765\u7684\u91d1\u5e01\u6362\u6210\u80fd\u652f\u6301\u4f60\u6218\u6597\u7684\u53ef\u9760\u540e\u63f4\u3002</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\u603b\u7684\u6765\u8bf4\uff0c\u5728\u6e38\u620f\u4e2d\uff0c\u4f60\u5c06\uff1a</p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u63a2\u7d22\u4e5d\u754c\u4e2d\u7684\u591a\u5ea7\u795e\u6bbf\u4e0e\u5e9f\u589f\uff0c\u89e3\u9501\u65b0\u7684\u5730\u56fe\u4e0e\u5267\u60c5</p></li><li><p class=\"bb_paragraph\" >\u4e0e\u591a\u4e2a\u62e5\u6709\u72ec\u7acb\u4e2a\u6027\u4e0e\u6545\u4e8b\u7684\u540c\u4f34\u76f8\u9047\u3001\u534f\u4f5c\u4e0e\u7f81\u7eca\u6210\u957f</p></li><li><p class=\"bb_paragraph\" >\u8fdb\u884c\u7b56\u7565\u578b\u7684\u56de\u5408\u5236\u6218\u6597\uff0c\u5229\u7528\u6280\u80fd\u3001\u5c5e\u6027\u4e0e\u6218\u672f\u51fb\u8d25\u654c\u4eba</p></li><li><p class=\"bb_paragraph\" >\u6536\u96c6\u6750\u6599\u3001\u6253\u9020\u88c5\u5907\uff0c\u5347\u7ea7\u89d2\u8272\u6280\u80fd\uff0c\u5f71\u54cd\u7ed3\u5c40\u8d70\u5411</p></li></ul><p class=\"bb_paragraph\" >\u5f53\u524d\u6e38\u620f\u7248\u672c\u5305\u542b\u7b2c\u4e00\u4e0e\u7b2c\u4e8c\u7ae0\u8282\uff0c\u603b\u8ba1\u7ea6\u5341+\u5c0f\u65f6\u7684\u5185\u5bb9\u3002\u5b8c\u6574\u7248\u672c\u8ba1\u5212\u5305\u542b\u516d\u7ae0\u5267\u60c5\uff0c\u5e76\u5c06\u5728\u672a\u6765\u6570\u6708\u5185\u6301\u7eed\u66f4\u65b0\u3002</p><p class=\"bb_paragraph\" >\u6240\u6709\u7cfb\u7edf\u673a\u5236\u5747\u5df2\u5b9e\u88c5\uff0c\u5305\u62ec\uff1a\u6218\u6597\u7cfb\u7edf\u3001\u63a2\u7d22\u7cfb\u7edf\u3001\u88c5\u5907\u7cfb\u7edf\u4e0e\u90e8\u5206\u89d2\u8272\u4e92\u52a8\u673a\u5236\u3002\u672a\u6765\u5c06\u6301\u7eed\u6269\u5c55\u5267\u60c5\u3001\u89d2\u8272\u5206\u652f\u4e0e\u65b0\u533a\u57df\u63a2\u7d22</p><p class=\"bb_paragraph\" >*\u63a8\u8350\u6e38\u73a9\u59ff\u52bf\uff1a\u8bf7\u628a\u4f60\u7684\u5de6\u624b\u653e\u5728WASD\u4e0a\uff0c\u53f3\u624b\u653e\u5728\u65b9\u5411\u952e\u4e0a\uff0c\u8ba9\u9f20\u6807\u4e00\u8fb9\u73a9\u53bb\u5427\u3002</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3738630/extras/d1873809960d91803d2d648a3949e41b.avif?t=1748938207\" data-has-big width=800 height=1132 /></span></p>",
