steamstatic.com/store_item_assets/steam/apps/2314160/extras/afc6f7b4f2837a0b76070fb07f553b6c.mp4?t=1748030799\" type=\"video/mp4\"></video></span></p><h2 class=\"bb_tag\" >30+ Detailed Weapons and Counting</h2><p class=\"bb_paragraph\" >Customize your loadout with tactical gear including vests, helmets, weapons, scopes, sights, grips, and breaching equipment.</p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2314160/extras/17b69e9c614d831d178835bba96d887c.poster.avif?t=1748030799\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2314160/extras/17b69e9c614d831d178835bba96d887c.webm?t=1748030799\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2314160/extras/17b69e9c614d831d178835bba96d887c.mp4?t=1748030799\" type=\"video/mp4\"></video></span></p><h2 class=\"bb_tag\" >Join the Discord and Find Your Squad</h2><h2 class=\"bb_tag\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2314160/extras/d6848e5b3792a931c21a10d439c41f83.poster.avif?t=1748030799\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2314160/extras/d6848e5b3792a931c21a10d439c41f83.webm?t=1748030799\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2314160/extras/d6848e5b3792a931c21a10d439c41f83.mp4?t=1748030799\" type=\"video/mp4\"></video></span></h2>",
