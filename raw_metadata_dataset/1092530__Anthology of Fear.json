static.com/store_item_assets/steam/apps/1092530/extras/dae6341cb9fe4ecbbcf4c24049eaaafc.mp4?t=1726695619\" type=\"video/mp4\"></video></div><br><br><div class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1092530/extras/c6022b2f15012e16894e5b5d2a237e83.webp?t=1726695619\" /></div><br><br>Avoid the dangers waiting for you on your way to the truth. Interact with your surroundings and take part in surreal experiences which may help you understand what happened.<br><br><div class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1092530/extras/4ff60df6c136a26e9281f947ab47ef63.poster.avif?t=1726695619\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1092530/extras/4ff60df6c136a26e9281f947ab47ef63.webm?t=1726695619\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1092530/extras/4ff60df6c136a26e9281f947ab47ef63.mp4?t=1726695619\" type=\"video/mp4\"></video></div>",
