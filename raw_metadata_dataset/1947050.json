/2646b969d632e0901c67d1e7b9f5d2de.poster.avif?t=1752324811\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1947050/extras/2646b969d632e0901c67d1e7b9f5d2de.webm?t=1752324811\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1947050/extras/2646b969d632e0901c67d1e7b9f5d2de.mp4?t=1752324811\" type=\"video/mp4\"></video></div><br><br><strong>Beware of the dangers of space \ud83d\udd73</strong><br><div class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1947050/extras/5d49bf1709e1d559fb6219d38e074206.poster.avif?t=1752324811\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1947050/extras/5d49bf1709e1d559fb6219d38e074206.webm?t=1752324811\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1947050/extras/5d49bf1709e1d559fb6219d38e074206.mp4?t=1752324811\" type=\"video/mp4\"></video></div><h2 class=\"bb_tag\">Features \ud83c\udf0c</h2><ul class=\"bb_ul\"><li>More than 70 unique levels, with 7 differents planets</li></ul><ul class=\"bb_ul\"><li>Various space obstacles to overcome</li></ul><ul class=\"bb_ul\"><li>Card-based movement with different choices to move your ship</li></ul><ul class=\"bb_ul\"><li>A challenge and relaxing experience</li></ul><ul class=\"bb_ul\"><li>Mouse only</li></ul>",
