op playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3057060/extras/5b43d00df1ec1b695c93be3712dcc8d9.poster.avif?t=1725465567\" width=600 height=182 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3057060/extras/5b43d00df1ec1b695c93be3712dcc8d9.webm?t=1725465567\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3057060/extras/5b43d00df1ec1b695c93be3712dcc8d9.mp4?t=1725465567\" type=\"video/mp4\"></video></span>",
