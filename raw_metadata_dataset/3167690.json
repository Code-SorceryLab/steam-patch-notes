{
    "type": "game",
    "name": "Being John Gogh",
    "steam_appid": 3167690,
    "required_age": 0,
    "is_free": false,
    "detailed_description": "<p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3167690/extras/57c8e55c661a887231ccea1c64e9d5d5.avif?t=1732620689\" width=600 height=338 /></span></p><p class=\"bb_paragraph\" >&quot;Being John Gogh&quot; is a 3rd person life simulation game where you help John regain his lost life on Bozca Island, focusing on improving relationships, health, and charisma through interactions that reflect the artistic style of Van Gogh's paintings. </p><p class=\"bb_paragraph\" >The game's characteristic is in its integration of art and life simulation, where players engage with a world rendered in the style of Van Gogh's masterpieces, aiming to make John happy by navigating through life's challenges.</p><p class=\"bb_paragraph\" >(This is a special texture version of our game Being john)</p>",
    "about_the_game": "<p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3167690/extras/57c8e55c661a887231ccea1c64e9d5d5.avif?t=1732620689\" width=600 height=338 /></span></p><p class=\"bb_paragraph\" >&quot;Being John Gogh&quot; is a 3rd person life simulation game where you help John regain his lost life on Bozca Island, focusing on improving relationships, health, and charisma through interactions that reflect the artistic style of Van Gogh's paintings. </p><p class=\"bb_paragraph\" >The game's characteristic is in its integration of art and life simulation, where players engage with a world rendered in the style of Van Gogh's masterpieces, aiming to make John happy by navigating through life's challenges.</p><p class=\"bb_paragraph\" >(This is a special texture version of our game Being john)</p>",
    "short_description": "&quot;Being John Gogh&quot; is a life simulation game where you play as John, navigating through a world rendered in the style of Van Gogh's paintings, focusing on improving relationships, managing health, and enhancing charisma to find happiness on Bozca Island.",
    "supported_languages": "English, German, Turkish",
