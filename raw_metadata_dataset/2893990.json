ai.steamstatic.com/store_item_assets/steam/apps/2893990/extras/473a4062e956b5777a5c556a8cacfb97.mp4?t=1754704291\" type=\"video/mp4\"></video></span><br><br><u>Paintball:</u><br>Attack the paintball to change it to your color. As the ball bounces around the map, it leaves a trail of color.<br><br><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2893990/extras/4f30904921d87839ac78d5d19346767a.poster.avif?t=1754704291\" width=450 height=252 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2893990/extras/4f30904921d87839ac78d5d19346767a.webm?t=1754704291\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2893990/extras/4f30904921d87839ac78d5d19346767a.mp4?t=1754704291\" type=\"video/mp4\"></video></span><br><br><br><strong>Items:</strong><br>Items are a part of every game mode and are an additional way to add or erase paint.<br><br><u>Paintbomb:</u><br>When the paintbomb makes contact with a wall or another player, it will explode into the color of the player who threw it. Hitting another ninja will splatter them.<br><br><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2893990/extras/37fa49a3bba7741e7127287d2f6f02fd.poster.avif?t=1754704291\" width=450 height=252 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2893990/extras/37fa49a3bba7741e7127287d2f6f02fd.webm?t=1754704291\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2893990/extras/37fa49a3bba7741e7127287d2f6f02fd.mp4?t=1754704291\" type=\"video/mp4\"></video></span><br><br><u>Shuriken:</u><br>When the shuriken makes contact with a wall, it will slowly spray paint onto the wall around it.<br><br><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2893990/extras/fc1f1c53b1f24c61c1b46fdf61331646.poster.avif?t=1754704291\" width=450 height=252 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2893990/extras/fc1f1c53b1f24c61c1b46fdf61331646.webm?t=1754704291\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2893990/extras/fc1f1c53b1f24c61c1b46fdf61331646.mp4?t=1754704291\" type=\"video/mp4\"></video></span><br><br><u>Mop:</u><br>The mop erases ALL paint in the area around it.<br><br><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2893990/extras/1e3ecae7d3a40b8899a839b95f02d7f6.poster.avif?t=1754704291\" width=450 height=252 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2893990/extras/1e3ecae7d3a40b8899a839b95f02d7f6.webm?t=1754704291\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2893990/extras/1e3ecae7d3a40b8899a839b95f02d7f6.mp4?t=1754704291\" type=\"video/mp4\"></video></span>",
