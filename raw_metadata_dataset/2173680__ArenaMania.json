if?t=1700243136\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2173680/extras/d2bb8dea0f6b9f7103faa71243a9b7f5.webm?t=1700243136\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2173680/extras/d2bb8dea0f6b9f7103faa71243a9b7f5.mp4?t=1700243136\" type=\"video/mp4\"></video></div><br><br><strong>- And exploding crowd, because why not!</strong><br><div class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2173680/extras/b27377d6bf53bdcd9d2b74846e3c14ed.poster.avif?t=1700243136\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2173680/extras/b27377d6bf53bdcd9d2b74846e3c14ed.webm?t=1700243136\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2173680/extras/b27377d6bf53bdcd9d2b74846e3c14ed.mp4?t=1700243136\" type=\"video/mp4\"></video></div><br><br><br>Have fun! - Sandor &amp; Norbi\u00far</strong>",
