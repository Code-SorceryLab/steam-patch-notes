steam/apps/2779180/extras/06d26f72c7bc8946745a95344b6c37a8.poster.avif?t=1710622871\" width=426 height=240 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2779180/extras/06d26f72c7bc8946745a95344b6c37a8.webm?t=1710622871\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2779180/extras/06d26f72c7bc8946745a95344b6c37a8.mp4?t=1710622871\" type=\"video/mp4\"></video></span><br></li><li>Unlock abilities throughout the game by collecting crystals</li></ul><br><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2779180/extras/a51ffc1f691a5b0e7c2ed339a31d4e4a.poster.avif?t=1710622871\" width=426 height=240 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2779180/extras/a51ffc1f691a5b0e7c2ed339a31d4e4a.webm?t=1710622871\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2779180/extras/a51ffc1f691a5b0e7c2ed339a31d4e4a.mp4?t=1710622871\" type=\"video/mp4\"></video></span><br><br>Encounter special characters, fight against challenging enemies and intimidating bosses, live a story that you'll enjoy (how could you not like a game about a kid who barely knows basic math going to fight a bloody warrior who's able to tear apart a whole Dimension?)<br><br><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2779180/extras/1941d1503566db84ea8b0de90a676801.poster.avif?t=1710622871\" width=426 height=240 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2779180/extras/1941d1503566db84ea8b0de90a676801.webm?t=1710622871\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2779180/extras/1941d150