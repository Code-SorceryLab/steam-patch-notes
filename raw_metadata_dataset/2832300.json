{
    "type": "game",
    "name": "Brave Glin in Fairyaria",
    "steam_appid": 2832300,
    "required_age": 0,
    "is_free": false,
    "controller_support": "full",
    "detailed_description": "<p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2832300/extras/bff949f48415654b5d04741bee90a8ec.avif?t=1753376439\" width=602 height=212 /></span></p><p class=\"bb_paragraph\" >Play as Brave Glin, a little magical creature that getting lost in a forest, nedding face dangers on the way to return home! </p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><strong>- Freatures -</strong>   </p><p class=\"bb_paragraph\" >\u220e Jump! Use enemies as platforms by jumping over their heads! Each enemy has a different reaction when they are trampled!  </p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\u220e Defend Yourself! Use a slingshot, a shield and even a stick to defend yourself from enemies! </p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" > </p><p class=\"bb_paragraph\" >\u220e Super Star! Collect tiny stars, defeat enemies, increasing the experience bar to can collect the great Shooting Stars! </p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\u220e 4 Thematic Worlds! Meet many charismatic characters, crossing the world of Fairyaria!</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\u220e Friends! The scarecrow Hans and the crow Crowie will help you on the journey! </p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2832300/extras/807a921d9948501f11b629d60aca30f4.poster.avif?t=1753376439\" width=800 height=450 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2832300/extras/807a921d9948501f11b629d60aca30f4.webm?t=1753376439\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2832300/extras/807a921d9948501f11b629d60aca30f4.mp4?t=1753376439\" type=\"video/mp4\"></video></span><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2832300/extras/95285610f7417b1b78e27b6a8949a7bf.poster.avif?t=1753376439\" width=800 height=450 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2832300/extras/95285610f7417b1b78e27b6a8949a7bf.webm?t=1753376439\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2832300/extras/95285610f7417b1b78e27b6a8949a7bf.mp4?t=1753376439\" type=\"video/mp4\"></video></span><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2832300/extras/48ad4e7e1c71e743cd1a384089438e59.poster.avif?t=1753376439\" width=800 height=450 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2832300/extras/48ad4e7e1c71e743cd1a384089438e59.webm?t=1753376439\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2832300/extras/48ad4e7e1c71e743cd1a384089438e59.mp4?t=1753376439\" type=\"video/mp4\"></video></span></p>",
    "about_the_game": "<p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2832300/extras/bff949f48415654b5d04741bee90a8ec.avif?t=1753376439\" width=602 height=212 /></span></p><p class=\"bb_paragraph\" >Play as Brave Glin, a little magical creature that getting lost in a forest, nedding face dangers on the way to return home! </p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ><strong>- Freatures -</strong>   </p><p class=\"bb_paragraph\" >\u220e Jump! Use enemies as platforms by jumping over their heads! Each enemy has a different reaction when they are trampled!  </p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\u220e Defend Yourself! Use a slingshot, a shield and even a stick to defend yourself from enemies! </p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" > </p><p class=\"bb_paragraph\" >\u220e Super Star! Collect tiny stars, defeat enemies, increasing the experience bar to can collect the great Shooting Stars! </p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\u220e 4 Thematic Worlds! Meet many charismatic characters, crossing the world of Fairyaria!</p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" ></p><p class=\"bb_paragraph\" >\u220e Friends! The scarecrow Hans and the crow Crowie will help you on the journey! </p><p class=\"bb_paragraph\" ><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2832300/extras/807a921d9948501f11b629d60aca30f4.poster.avif?t=1753376439\" width=800 height=450 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2832300/extras/807a921d9948501f11b629d60aca30f4.webm?t=1753376439\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2832300/extras/807a921d9948501f11b629d60aca30f4.mp4?t=1753376439\" type=\"video/mp4\"></video></span><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2832300/extras/95285610f7417b1b78e27b6a8949a7bf.poster.avif?t=1753376439\" width=800 height=450 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2832300/extras/95285610f7417b1b78e27b6a8949a7bf.webm?t=1753376439\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2832300/extras/95285610f7417b1b78e27b6a8949a7bf.mp4?t=1753376439\" type=\"video/mp4\"></video></span><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2832300/extras/48ad4e7e1c71e743cd1a384089438e59.poster.avif?t=1753376439\" width=800 height=450 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2832300/extras/48ad4e7e1c71e743cd1a384089438e59.webm?t=1753376439\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2832300/extras/48ad4e7e1c71e743cd1a384089438e59.mp4?t=1753376439\" type=\"video/mp4\"></video></span></p>",
