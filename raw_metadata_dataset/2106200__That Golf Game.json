f124e60.poster.avif?t=1660092409\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2106200/extras/7e8d4f9bcc6c51405dc13bf79f124e60.webm?t=1660092409\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2106200/extras/7e8d4f9bcc6c51405dc13bf79f124e60.mp4?t=1660092409\" type=\"video/mp4\"></video></div><h2 class=\"bb_tag\"><strong><u>Bombs away!</u></strong></h2><br><br>Pesky tree in your way? No problem! Hit around it with a fade or draw. Or turn that tree into kindling with Bomb Mode!<br><br>\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0<div class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2106200/extras/caf38f65e20b97c3dee56f00a3c42028.poster.avif?t=1660092409\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2106200/extras/caf38f65e20b97c3dee56f00a3c42028.webm?t=1660092409\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2106200/extras/caf38f65e20b97c3dee56f00a3c42028.mp4?t=1660092409\" type=\"video/mp4\"></video></div><h2 class=\"bb_tag\"><strong><u>Gopher the gold!</u></strong></h2><br><br>Gophers are an optional hazard. They'll tear up those greens, forcing you to plan your approach shots more carefully. And sometimes you'll have to ditch your putter and chip over those gopher burrows!<br><br>\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0<div class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2106200/extras/ff05605f52008eee59e17cfc72e016b8.avif?t=1660092409\" /></div><br><br>Zombie mode is also optional. Play your shots with precision, to keep your ball away from randomly placed zombie clusters.<br><br>Hit it too close and you'll have to fend them off before your next shot... or try a &quot;Quick Shot&quot; to get out of there as fast as possible, but at the cost of accuracy! Then again, you could always chip a bomb into their midst to clear 'em out, lickety-split!<br><br>\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0<div class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2106200/extras/150dd8264971b2ab8a7d8999c96d6db6.avif?t=1660092409\" /></div><h2 class=\"bb_tag\"><strong><u>Build-a-Golfer</u></strong></h2><br><br>Customize your golfer's look, with options including glasses, piercings, and facial hair. Click the &quot;Randomize Face&quot; button, or tweak your golfer's features with dozens of settings.<br><br>\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0\u00a0<div class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2106200/extras/1f785cb32362e2b964338eb7a919978b.poster.avif?t=1660092409\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2106200/extras/1f785cb32362e2b964338eb7a919978b.webm?t=1660092409\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2106200/extras/1f785cb32362e2b964338eb7a919978b.mp4?t=1660092409\" type=\"video/mp4\"