ne poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2718460/extras/ce90ed7e8f760e68613f9d594eb284bb.poster.avif?t=1721289517\" width=640 height=426 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2718460/extras/ce90ed7e8f760e68613f9d594eb284bb.webm?t=1721289517\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2718460/extras/ce90ed7e8f760e68613f9d594eb284bb.mp4?t=1721289517\" type=\"video/mp4\"></video></span>",
