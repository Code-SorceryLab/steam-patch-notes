/3190590/extras/18bdce2688dcb6e7fa224d9e6c6090fd.webm?t=1731144922\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3190590/extras/18bdce2688dcb6e7fa224d9e6c6090fd.mp4?t=1731144922\" type=\"video/mp4\"></video></span><h2 class=\"bb_tag\" >FIGHT GIANT WORMS</h2>Dont ask. The game doesnt have a specific theme or story, I just added what sounded fun.<br>And currently there are only 3 worm levels, but im planning on adding more in the future.<h2 class=\"bb_tag\" >AVOID MISSILES AND MINES... AND METEORS</h2><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3190590/extras/d694bce1ab72a035dd18ac9b1eeee558.poster.avif?t=1731144922\" width=720 height=480 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3190590/extras/d694bce1ab72a035dd18ac9b1eeee558.webm?t=1731144922\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3190590/extras/d694bce1ab72a035dd18ac9b1eeee558.mp4?t=1731144922\" type=\"video/mp4\"></video></span><br><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3190590/extras/ffdc2c65d6d6ffa4f986ee28f540e0c3.poster.avif?t=1731144922\" width=720 height=480 ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3190590/extras/ffdc2c65d6d6ffa4f986ee28f540e0c3.webm?t=1731144922\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3190590/extras/ffdc2c65d6d6ffa4f986ee28f540e0c3.mp4?t=1731144922\" type=\"video/mp4\"></video></span><br>80 LEVELS ON 7 DIFFERENT BIOMES<br><span class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/3190590/extras/af86e5f7