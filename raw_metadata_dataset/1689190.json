\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1689190/extras/e00f163e07c44188c814f26193e80ef3.poster.avif?t=1753358915\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1689190/extras/e00f163e07c44188c814f26193e80ef3.webm?t=1753358915\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1689190/extras/e00f163e07c44188c814f26193e80ef3.mp4?t=1753358915\" type=\"video/mp4\"></video></div>",
