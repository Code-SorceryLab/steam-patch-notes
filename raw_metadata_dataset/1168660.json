    "detailed_description": "<p class=\"bb_paragraph\"><div class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1168660/extras/5c6f99ac894375929965be1eaec1796e.avif?t=1742065115\" /></div><div class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1168660/extras/1b599a7a8c971719aef51b79606b428b.avif?t=1742065115\" /></div></p><p class=\"bb_paragraph\"></p><p class=\"bb_paragraph\"></p><p class=\"bb_paragraph\"><div class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1168660/extras/736914df762e97c3871212bfa1f87705.avif?t=1742065115\" /></div><div class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1168660/extras/20998404ffa6cc01c89ff39d12376992.avif?t=1742065115\" /></div></p><p class=\"bb_paragraph\"></p><p class=\"bb_paragraph\"></p><p class=\"bb_paragraph\">Barro 2020 is the sequel for Barro with 9 new challenging race tracks.</p><p class=\"bb_paragraph\"></p><p class=\"bb_paragraph\"><u><strong>Game modes:</strong></u></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\"><strong><i>Arcade:</i></strong> Do your best and finish the race as the winner.</p></li><li><p class=\"bb_paragraph\"><strong><i>Time trial:</i></strong> You against yourself, finish the laps as fastest as you can.</p></li><li><p class=\"bb_paragraph\"><strong><i>Multiplayer: </i></strong> Play the multiplayer (split screen) with a friend and have fun.</p></li></ul><p class=\"bb_paragraph\"></p><p class=\"bb_paragraph\"><strong><u>Game:</u></strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\">4 types of cars, choose the one that fits you better.</p></li><li><p class=\"bb_paragraph\">9 new race tracks</p></li><li><p class=\"bb_paragraph\"> Single player or up to 4 players local split screen </p></li><li><p class=\"bb_paragraph\"> New and improved time trial mode</p></li><li><p class=\"bb_paragraph\"> Up to 8 cars on the grid</p></li></ul>",
    "about_the_game": "<p class=\"bb_paragraph\"><div class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1168660/extras/5c6f99ac894375929965be1eaec1796e.avif?t=1742065115\" /></div><div class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1168660/extras/1b599a7a8c971719aef51b79606b428b.avif?t=1742065115\" /></div></p><p class=\"bb_paragraph\"></p><p class=\"bb_paragraph\"></p><p class=\"bb_paragraph\"><div class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1168660/extras/736914df762e97c3871212bfa1f87705.avif?t=1742065115\" /></div><div class=\"bb_img_ctn\"><img class=\"bb_img\" src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/1168660/extras/20998404ffa6cc01c89ff39d12376992.avif?t=1742065115\" /></div></p><p class=\"bb_paragraph\"></p><p class=\"bb_paragraph\"></p><p class=\"bb_paragraph\">Barro 2020 is the sequel for Barro with 9 new challenging race tracks.</p><p class=\"bb_paragraph\"></p><p class=\"bb_paragraph\"><u><strong>Game modes:</strong></u></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\"><strong><i>Arcade:</i></strong> Do your best and finish the race as the winner.</p></li><li><p class=\"bb_paragraph\"><strong><i>Time trial:</i></strong> You against yourself, finish the laps as fastest as you can.</p></li><li><p class=\"bb_paragraph\"><strong><i>Multiplayer: </i></strong> Play the multiplayer (split screen) with a friend and have fun.</p></li></ul><p class=\"bb_paragraph\"></p><p class=\"bb_paragraph\"><strong><u>Game:</u></strong></p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\">4 types of cars, choose the one that fits you better.</p></li><li><p class=\"bb_paragraph\">9 new race tracks</p></li><li><p class=\"bb_paragraph\"> Single player or up to 4 players local split screen </p></li><li><p class=\"bb_paragraph\"> New and improved time trial mode</p></li><li><p class=\"bb_paragraph\"> Up to 8 cars on the grid</p></li></ul>",
