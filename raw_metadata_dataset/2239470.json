ai.steamstatic.com/store_item_assets/steam/apps/2239470/extras/47899f78bff3ab29ccf0cd7259d4e1ea.poster.avif?t=1692465187\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2239470/extras/47899f78bff3ab29ccf0cd7259d4e1ea.webm?t=1692465187\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2239470/extras/47899f78bff3ab29ccf0cd7259d4e1ea.mp4?t=1692465187\" type=\"video/mp4\"></video></span></li></ul><h2 class=\"bb_tag\" >Upgrade</h2><ul class=\"bb_ul\"><li>Upgrade your weapons and modify their stats to fight your own way<br><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2239470/extras/619aaa1ee89f7beacd17a9f7d9e5ea0b.poster.avif?t=1692465187\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2239470/extras/619aaa1ee89f7beacd17a9f7d9e5ea0b.webm?t=1692465187\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2239470/extras/619aaa1ee89f7beacd17a9f7d9e5ea0b.mp4?t=1692465187\" type=\"video/mp4\"></video></span></li></ul><h2 class=\"bb_tag\" >Rescue</h2><ul class=\"bb_ul\"><li>Allied ships across different sectors are also under attack, help them <br>to increase your chances of winning<br><span class=\"bb_img_ctn\"><video class=\"bb_img\" autoplay muted loop playsinline poster=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2239470/extras/c6cff5c2c1ee111b24695ca387b42805.poster.avif?t=1692465187\" ><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2239470/extras/c6cff5c2c1ee111b24695ca387b42805.webm?t=1692465187\" type=\"video/webm; codecs=vp9\"><source src=\"https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/2239470/extras/c6cff5c2c1ee111b24695ca387b42805.mp4?t=1692465187\" type=\"video/mp4\"></video></span