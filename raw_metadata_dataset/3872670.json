    "detailed_description": "<h2 class=\"bb_tag\" ><strong>\u6c99\u57ce\u9738\u4e3b\u7248\u672c\u9707\u64bc\u4ecb\u7ecd\u2728</strong></h2><h2 class=\"bb_tag\" ><strong>\u7248\u672c\u4eae\u70b9\u603b\u89c8\ud83c\udf1f</strong></h2><p class=\"bb_paragraph\" >\u8017\u65f6\u4e24\u5e74\u7cbe\u5fc3\u96d5\u7422\uff0c\u503e\u5c3d\u5fc3\u8840\u6253\u9020\u8bda\u610f\u5de8\u732e\uff01\u300a\u6c99\u57ce\u9738\u4e3b\u300b\u4ee5\u539f\u521b\u5267\u60c5\u4e3a\u7075\u9b42\ud83d\udc7b\uff0c\u8d85\u7ea7\u5927\u9646\u4e3a\u821e\u53f0\ud83c\udf0f\uff0c\u79c9\u6301\u201c\u4e0d\u809d\u4e0d\u6c2a\u201d\u7684\u53cb\u597d\u7406\u5ff5\ud83e\udd70\uff0c\u4e3a\u73a9\u5bb6\u5f00\u542f\u4e00\u573a\u522b\u5177\u4e00\u683c\u7684\u4f20\u5947\u5192\u9669\u4e4b\u65c5\ud83d\ude80\u3002</p><h2 class=\"bb_tag\" ><strong>\u4e0a\u7ebf\u8c6a\u793c\u5927\u653e\u9001\ud83c\udf81</strong></h2><p class=\"bb_paragraph\" >\u73a9\u5bb6\u4e00\u4e0a\u7ebf\uff0c\u5373\u53ef\u4eab\u53d7\u56db\u5927\u8d34\u5fc3\u798f\u5229\ud83e\udd73\uff1a</p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u81ea\u52a8\u56de\u6536\ud83d\uddd1\ufe0f\uff1a\u89e3\u653e\u53cc\u624b\uff0c\u8f7b\u677e\u6574\u7406\u80cc\u5305\u3002</p></li><li><p class=\"bb_paragraph\" >\u81ea\u52a8\u62fe\u53d6\ud83e\udde4\uff1a\u4e0d\u9519\u8fc7\u4efb\u4f55\u73cd\u8d35\u9053\u5177\u3002</p></li><li><p class=\"bb_paragraph\" >\u81ea\u52a8\u7ecf\u9a8c\ud83d\udcc8\uff1a\u52a9\u529b\u5feb\u901f\u5347\u7ea7\u3002</p></li><li><p class=\"bb_paragraph\" >\u81ea\u52a8\u8d27\u5e01\ud83d\udcb0\uff1a\u8ba9\u8d22\u5bcc\u79ef\u7d2f\u65e0\u5fe7\u3002 <br>\u65e0\u9700\u7e41\u7410\u64cd\u4f5c\uff0c\u7545\u5feb\u5f00\u542f\u6e38\u620f\u4e4b\u65c5\ud83c\udf89\u3002</p></li></ul><h2 class=\"bb_tag\" ><strong>\u4e30\u5bcc\u73a9\u6cd5\uff0c\u4e50\u8da3\u65e0\u7a77\ud83c\udf8a</strong></h2><h2 class=\"bb_tag\" ><strong>\u7279\u8272\u5267\u60c5\u4e0e\u4e13\u5c5e BUFF\ud83c\udfad</strong></h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >100 + \u7279\u8272\u5267\u60c5\u81ea\u7531\u63a2\u7d22\ud83d\uddfa\ufe0f\uff0c\u6bcf\u4e00\u6bb5\u6545\u4e8b\u90fd\u5145\u6ee1\u60ca\u559c\u4e0e\u6311\u6218\ud83d\ude32\uff0c\u8ba9\u4f60\u6c89\u6d78\u5728\u5b8f\u5927\u7684\u6e38\u620f\u4e16\u754c\u4e2d\uff0c\u611f\u53d7\u8dcc\u5b95\u8d77\u4f0f\u7684\u4f20\u5947\u4eba\u751f\ud83d\udc4f\u3002</p></li><li><p class=\"bb_paragraph\" >300 + \u4e13\u5c5e BUFF \u4efb\u610f\u642d\u914d\ud83e\udde9\uff0c\u6839\u636e\u4e0d\u540c\u6218\u6597\u573a\u666f\u548c\u804c\u4e1a\u9700\u6c42\uff0c\u7075\u6d3b\u7ec4\u5408\uff0c\u6253\u9020\u72ec\u4e00\u65e0\u4e8c\u7684\u6218\u6597\u98ce\u683c\ud83d\udcaa\uff0c\u767e\u73a9\u4e0d\u817b\uff0c\u6bcf\u4e00\u6b21\u5192\u9669\u90fd\u6709\u65b0\u4f53\u9a8c\ud83e\udd73\u3002</p></li></ul><h2 class=\"bb_tag\" ><strong>\u88c5\u5907\u83b7\u53d6\u4e0e\u5237\u602a\u6a21\u5f0f\ud83d\udc7e</strong></h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u6240\u6709\u88c5\u5907\u5168\u9760\u7206\ud83d\udca5\uff01\u6e38\u620f\u6452\u5f03\u6697\u5751\u4e0e\u6bd2\u70b9\uff0c\u516c\u5e73\u516c\u6b63\uff0c\u8ba9\u6bcf\u4e00\u4f4d\u73a9\u5bb6\u90fd\u6709\u673a\u4f1a\u901a\u8fc7\u52aa\u529b\u83b7\u5f97\u9876\u7ea7\u88c5\u5907\ud83d\udc8e\u3002</p></li><li><p class=\"bb_paragraph\" >\u5168\u5927\u9646\u91c7\u7528\u4e00\u56fe\u4e00\u602a\u4e00\u4e13\u5c5e\u7684\u5237\u602a\u6a21\u5f0f\ud83d\uddfa\ufe0f\ud83d\udc7e\uff0c\u7206\u7387\u5168\u5f00\uff0c\u5149\u901f\u98de\u5347\u4e0d\u662f\u68a6\ud83d\ude80\u3002\u6bcf\u4e00\u6b21\u6311\u6218\u90fd\u662f\u4e0e\u4e13\u5c5e\u602a\u7269\u7684\u6fc0\u60c5\u5bf9\u51b3\ud83e\udd4a\uff0c\u6bcf\u4e00\u6b21\u80dc\u5229\u90fd\u53ef\u80fd\u6536\u83b7\u4e30\u539a\u5956\u52b1\ud83c\udf81\u3002</p></li></ul><h2 class=\"bb_tag\" ><strong>\u8d85\u7ea7\u5206\u8eab\u7cfb\u7edf\ud83d\udc65</strong></h2><p class=\"bb_paragraph\" >\u8d85\u7ea7\u5206\u8eab\u7d27\u5bc6\u8ddf\u968f\u4eba\u7269\u5c5e\u6027\ud83d\udcca\uff0c\u4e3a\u5237\u602a\u63d0\u4f9b\u5f3a\u5927\u52a9\u529b\ud83d\udcaa\uff0c\u8ba9\u4f60\u5237\u602a\u65e0\u538b\u529b\u3002\u6700\u591a\u53ef\u53ec\u5524 20 \u4e2a\u5206\u8eab\ud83d\udc65\ud83d\udc65\ud83d\udc65\u2026\u2026\u60f3\u8c61\u4e00\u4e0b\u4f17\u591a\u5206\u8eab\u4e0e\u4f60\u5e76\u80a9\u4f5c\u6218\u7684\u58ee\u89c2\u573a\u666f\ud83e\udd29\uff0c\u6218\u6597\u529b\u77ac\u95f4\u7206\u8868\uff01</p><h2 class=\"bb_tag\" ><strong>\u968f\u673a\u89e6\u53d1\u8d85\u5f3a\u6548\u679c\ud83d\udca5</strong></h2><p class=\"bb_paragraph\" >\u5728\u6218\u6597\u4e2d\uff0c\u968f\u673a\u89e6\u53d1\u65e0\u9650\u5200\u901f +999% \u7684\u9707\u64bc\u6548\u679c\ud83d\ude31\uff0c\u77ac\u95f4\u63d0\u5347\u8f93\u51fa\u80fd\u529b\uff0c\u8ba9\u654c\u4eba\u6beb\u65e0\u62db\u67b6\u4e4b\u529b\ud83e\udd4a\uff0c\u4f53\u9a8c\u6781\u81f4\u6218\u6597\u5feb\u611f\ud83c\udf89\u3002</p><h2 class=\"bb_tag\" ><strong>\u8be6\u7ec6\u73a9\u6cd5\u6307\u5357\ud83e\udded</strong></h2><h2 class=\"bb_tag\" ><strong>\u65b0\u4eba\u798f\u5229\ud83c\udf81</strong></h2><p class=\"bb_paragraph\" >\u65b0\u4eba\u4e0a\u7ebf\u5373\u53ef\u83b7\u5f97\u91d1\u5361\u73a9\u5bb6\u79f0\u53f7\ud83c\udfc6\uff0c\u8fd9\u4e00\u79f0\u53f7\u4e0d\u4ec5\u662f\u8eab\u4efd\u7684\u8c61\u5f81\ud83d\udc51\uff0c\u66f4\u662f\u798f\u5229\u7684\u94a5\u5319\ud83d\udd11\u3002\u52a0\u5165\u6e38\u620f\u7fa4\uff08413822706\uff09\ud83d\udc65 \u6216\u8005\u7ed9\u4e88\u6e38\u620f\u597d\u8bc4\ud83d\udc4d\uff0c\u5373\u53ef\u83b7\u5f97\u9996\u5145\u5956\u52b1\u4ee5\u53ca\u8d85\u591a\u4e13\u5c5e\u798f\u5229\ud83c\udf81\u3002\u5200\u5200\u7eff\u6bd2\u7684\u6301\u7eed\u4f24\u5bb3\ud83d\udc80\u4e0e\u8d85\u7ea7\u5207\u5272\u7684\u9ad8\u989d\u7206\u53d1\ud83d\udca5\uff0c\u8ba9\u4f60\u5728\u65b0\u624b\u671f\u5c31\u80fd\u8f7b\u677e\u5e94\u5bf9\u5404\u79cd\u602a\u7269\ud83d\udc7e\uff0c\u5feb\u901f\u6210\u957f\ud83d\udcc8\u3002</p><h2 class=\"bb_tag\" ><strong>\u4e3b\u7ebf\u4efb\u52a1\u4e0e\u6210\u957f\ud83c\udf31</strong></h2><p class=\"bb_paragraph\" >\u8ddf\u968f\u4e3b\u7ebf\u4efb\u52a1\u5237\u602a\ud83d\udc7e\uff0c\u662f\u63d0\u5347\u5b9e\u529b\u7684\u5fc5\u7ecf\u4e4b\u8def\ud83d\udee3\ufe0f\u3002\u5728\u5237\u602a\u8fc7\u7a0b\u4e2d\uff0c\u4e0d\u4ec5\u80fd\u63d0\u5347\u79f0\u53f7\ud83c\udfc6\u3001\u8f6c\u751f\ud83d\udd04\u548c\u7b49\u7ea7\ud83d\udcc8\uff0c\u8fd8\u80fd\u83b7\u5f97\u5927\u91cf\u5207\u5272\u5c5e\u6027\ud83d\udca5\u3002\u5207\u5272\u5c5e\u6027\u7684\u63d0\u5347\uff0c\u8ba9\u6253\u602a\u6548\u7387\u98d9\u5347\ud83d\ude80\uff0c\u602a\u7269\u5728\u4f60\u9762\u524d\u5982\u540c\u5f85\u5bb0\u7f94\u7f8a\ud83d\udc11\uff0c\u8f7b\u677e\u5b9e\u73b0\u5feb\u901f\u5347\u7ea7\u548c\u8d44\u6e90\u79ef\u7d2f\ud83d\udcb0\u3002</p><h2 class=\"bb_tag\" ><strong>\u4e00\u5927\u9646\u5267\u60c5\u4e0e\u5206\u8eab\u83b7\u53d6\ud83c\udfac</strong></h2><p class=\"bb_paragraph\" >\u8ba4\u771f\u5b8c\u6210\u4e00\u5927\u9646\u7684\u6240\u6709\u4e3b\u7ebf\u5267\u60c5\u4efb\u52a1\ud83d\udcdc\uff0c\u4f60\u5c06\u83b7\u5f97\u672c\u670d\u8d85\u7ea7\u5206\u8eab\ud83d\udc65\u3002\u8fd9\u4e2a\u5206\u8eab\u5c06\u6210\u4e3a\u4f60\u5192\u9669\u9014\u4e2d\u7684\u5f97\u529b\u52a9\u624b\ud83e\udd1d\u3002\u8fdb\u5165\u4e8c\u5927\u9646\u540e\uff0c\u53ef\u5bf9\u5206\u8eab\u8fdb\u884c\u5347\u7ea7\ud83d\udcc8\u548c\u878d\u5408\ud83d\udd04\u64cd\u4f5c\u3002\u5206\u8eab\u5347\u7ea7\u80fd\u589e\u5f3a\u5176\u81ea\u8eab\u5b9e\u529b\ud83d\udcaa\uff0c\u5206\u8eab\u878d\u5408\u5219\u53ef\u8fdb\u4e00\u6b65\u63d0\u5347\u4eba\u7269\u4f24\u5bb3\u548c\u5206\u8eab\u4f24\u5bb3\ud83d\udca5\uff0c\u8ba9\u4f60\u7684\u6218\u6597\u529b\u5b9e\u73b0\u8d28\u7684\u98de\u8dc3\ud83d\ude80\u3002</p><h2 class=\"bb_tag\" ><strong>\u5929\u5173\u6311\u6218\u4e0e\u798f\u5229\u83b7\u53d6\ud83c\udf81</strong></h2><p class=\"bb_paragraph\" >\u5f53\u4f60\u6709\u4e86\u4e00\u5b9a\u7684\u88c5\u5907\u57fa\u7840\u540e\ud83d\udc8e\uff0c\u571f\u57ce\u7684\u5929\u5173\u6311\u6218\u5c06\u6210\u4e3a\u4f60\u8bc1\u660e\u81ea\u5df1\u7684\u821e\u53f0\ud83c\udfad\u3002\u5728\u8fd9\u91cc\uff0c\u4f60\u5c06\u9762\u5bf9\u5404\u79cd\u5f3a\u5927\u7684\u654c\u4eba\ud83d\udc7f\uff0c\u4f46\u9996\u6740\u5956\u52b1\u4e5f\u6781\u4e3a\u4e30\u539a\ud83c\udf81\uff0c\u4f1a\u8d60\u9001\u8d85\u591a\u798f\u5229\uff0c\u52a9\u4f60\u5728\u6e38\u620f\u4e2d\u66f4\u4e0a\u4e00\u5c42\u697c\ud83e\uddd7\u200d\u2642\ufe0f\u3002</p><h2 class=\"bb_tag\" ><strong>\u514d\u8d39\u4f1a\u5458\u4e0e\u8d5e\u52a9\u4f53\u7cfb\ud83c\udd93</strong></h2><p class=\"bb_paragraph\" >\u672c\u670d\u4f1a\u5458\u3001\u8d5e\u52a9\u3001\u7d2f\u5145\u5168\u90e8\u514d\u8d39\uff01\ud83d\udc4f\u65e0\u9700\u82b1\u8d39\u4e00\u5206\u94b1\ud83d\udcb0\uff0c\u53ea\u9700\u6295\u5165\u65f6\u95f4\u548c\u7cbe\u529b\u23f3\uff0c\u901a\u8fc7\u6253\u602a\ud83d\udc7e\u3001\u5b8c\u6210\u5267\u60c5\u4efb\u52a1\ud83d\udcdc\u3001\u56de\u6536\u5b9e\u7269\ud83d\udce6\u7b49\u65b9\u5f0f\uff0c\u5c31\u80fd\u8f7b\u677e\u83b7\u5f97\u8fd9\u4e9b\u539f\u672c\u9700\u8981\u4ed8\u8d39\u624d\u80fd\u4eab\u53d7\u7684\u7279\u6743\ud83c\udf81\u3002\u771f\u6b63\u505a\u5230\u4e0d\u5145\u4e00\u5206\u94b1\u73a9\u901a\u5173\uff0c\u8ba9\u6bcf\u4e00\u4f4d\u73a9\u5bb6\u90fd\u80fd\u516c\u5e73\u7ade\u6280\ud83e\udd4a\uff0c\u4eab\u53d7\u6e38\u620f\u7684\u4e50\u8da3\ud83c\udf89\u3002</p><p class=\"bb_paragraph\" >\u300a\u6c99\u57ce\u9738\u4e3b\u300b\u4ee5\u5176\u4e30\u5bcc\u7684\u73a9\u6cd5\u3001\u516c\u5e73\u7684\u73af\u5883\u548c\u8d34\u5fc3\u7684\u798f\u5229\uff0c\u4e3a\u73a9\u5bb6\u6253\u9020\u4e86\u4e00\u4e2a\u5145\u6ee1\u6fc0\u60c5\u4e0e\u6311\u6218\u7684\u4f20\u5947\u4e16\u754c\ud83c\udf0f\u3002\u5feb\u6765\u52a0\u5165\u6211\u4eec\uff0c\u4e00\u8d77\u4e66\u5199\u5c5e\u4e8e\u81ea\u5df1\u7684\u4f20\u5947\u7bc7\u7ae0\ud83d\udcd6\uff01</p>",
    "about_the_game": "<h2 class=\"bb_tag\" ><strong>\u6c99\u57ce\u9738\u4e3b\u7248\u672c\u9707\u64bc\u4ecb\u7ecd\u2728</strong></h2><h2 class=\"bb_tag\" ><strong>\u7248\u672c\u4eae\u70b9\u603b\u89c8\ud83c\udf1f</strong></h2><p class=\"bb_paragraph\" >\u8017\u65f6\u4e24\u5e74\u7cbe\u5fc3\u96d5\u7422\uff0c\u503e\u5c3d\u5fc3\u8840\u6253\u9020\u8bda\u610f\u5de8\u732e\uff01\u300a\u6c99\u57ce\u9738\u4e3b\u300b\u4ee5\u539f\u521b\u5267\u60c5\u4e3a\u7075\u9b42\ud83d\udc7b\uff0c\u8d85\u7ea7\u5927\u9646\u4e3a\u821e\u53f0\ud83c\udf0f\uff0c\u79c9\u6301\u201c\u4e0d\u809d\u4e0d\u6c2a\u201d\u7684\u53cb\u597d\u7406\u5ff5\ud83e\udd70\uff0c\u4e3a\u73a9\u5bb6\u5f00\u542f\u4e00\u573a\u522b\u5177\u4e00\u683c\u7684\u4f20\u5947\u5192\u9669\u4e4b\u65c5\ud83d\ude80\u3002</p><h2 class=\"bb_tag\" ><strong>\u4e0a\u7ebf\u8c6a\u793c\u5927\u653e\u9001\ud83c\udf81</strong></h2><p class=\"bb_paragraph\" >\u73a9\u5bb6\u4e00\u4e0a\u7ebf\uff0c\u5373\u53ef\u4eab\u53d7\u56db\u5927\u8d34\u5fc3\u798f\u5229\ud83e\udd73\uff1a</p><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u81ea\u52a8\u56de\u6536\ud83d\uddd1\ufe0f\uff1a\u89e3\u653e\u53cc\u624b\uff0c\u8f7b\u677e\u6574\u7406\u80cc\u5305\u3002</p></li><li><p class=\"bb_paragraph\" >\u81ea\u52a8\u62fe\u53d6\ud83e\udde4\uff1a\u4e0d\u9519\u8fc7\u4efb\u4f55\u73cd\u8d35\u9053\u5177\u3002</p></li><li><p class=\"bb_paragraph\" >\u81ea\u52a8\u7ecf\u9a8c\ud83d\udcc8\uff1a\u52a9\u529b\u5feb\u901f\u5347\u7ea7\u3002</p></li><li><p class=\"bb_paragraph\" >\u81ea\u52a8\u8d27\u5e01\ud83d\udcb0\uff1a\u8ba9\u8d22\u5bcc\u79ef\u7d2f\u65e0\u5fe7\u3002 <br>\u65e0\u9700\u7e41\u7410\u64cd\u4f5c\uff0c\u7545\u5feb\u5f00\u542f\u6e38\u620f\u4e4b\u65c5\ud83c\udf89\u3002</p></li></ul><h2 class=\"bb_tag\" ><strong>\u4e30\u5bcc\u73a9\u6cd5\uff0c\u4e50\u8da3\u65e0\u7a77\ud83c\udf8a</strong></h2><h2 class=\"bb_tag\" ><strong>\u7279\u8272\u5267\u60c5\u4e0e\u4e13\u5c5e BUFF\ud83c\udfad</strong></h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >100 + \u7279\u8272\u5267\u60c5\u81ea\u7531\u63a2\u7d22\ud83d\uddfa\ufe0f\uff0c\u6bcf\u4e00\u6bb5\u6545\u4e8b\u90fd\u5145\u6ee1\u60ca\u559c\u4e0e\u6311\u6218\ud83d\ude32\uff0c\u8ba9\u4f60\u6c89\u6d78\u5728\u5b8f\u5927\u7684\u6e38\u620f\u4e16\u754c\u4e2d\uff0c\u611f\u53d7\u8dcc\u5b95\u8d77\u4f0f\u7684\u4f20\u5947\u4eba\u751f\ud83d\udc4f\u3002</p></li><li><p class=\"bb_paragraph\" >300 + \u4e13\u5c5e BUFF \u4efb\u610f\u642d\u914d\ud83e\udde9\uff0c\u6839\u636e\u4e0d\u540c\u6218\u6597\u573a\u666f\u548c\u804c\u4e1a\u9700\u6c42\uff0c\u7075\u6d3b\u7ec4\u5408\uff0c\u6253\u9020\u72ec\u4e00\u65e0\u4e8c\u7684\u6218\u6597\u98ce\u683c\ud83d\udcaa\uff0c\u767e\u73a9\u4e0d\u817b\uff0c\u6bcf\u4e00\u6b21\u5192\u9669\u90fd\u6709\u65b0\u4f53\u9a8c\ud83e\udd73\u3002</p></li></ul><h2 class=\"bb_tag\" ><strong>\u88c5\u5907\u83b7\u53d6\u4e0e\u5237\u602a\u6a21\u5f0f\ud83d\udc7e</strong></h2><ul class=\"bb_ul\"><li><p class=\"bb_paragraph\" >\u6240\u6709\u88c5\u5907\u5168\u9760\u7206\ud83d\udca5\uff01\u6e38\u620f\u6452\u5f03\u6697\u5751\u4e0e\u6bd2\u70b9\uff0c\u516c\u5e73\u516c\u6b63\uff0c\u8ba9\u6bcf\u4e00\u4f4d\u73a9\u5bb6\u90fd\u6709\u673a\u4f1a\u901a\u8fc7\u52aa\u529b\u83b7\u5f97\u9876\u7ea7\u88c5\u5907\ud83d\udc8e\u3002</p></li><li><p class=\"bb_paragraph\" >\u5168\u5927\u9646\u91c7\u7528\u4e00\u56fe\u4e00\u602a\u4e00\u4e13\u5c5e\u7684\u5237\u602a\u6a21\u5f0f\ud83d\uddfa\ufe0f\ud83d\udc7e\uff0c\u7206\u7387\u5168\u5f00\uff0c\u5149\u901f\u98de\u5347\u4e0d\u662f\u68a6\ud83d\ude80\u3002\u6bcf\u4e00\u6b21\u6311\u6218\u90fd\u662f\u4e0e\u4e13\u5c5e\u602a\u7269\u7684\u6fc0\u60c5\u5bf9\u51b3\ud83e\udd4a\uff0c\u6bcf\u4e00\u6b21\u80dc\u5229\u90fd\u53ef\u80fd\u6536\u83b7\u4e30\u539a\u5956\u52b1\ud83c\udf81\u3002</p></li></ul><h2 class=\"bb_tag\" ><strong>\u8d85\u7ea7\u5206\u8eab\u7cfb\u7edf\ud83d\udc65</strong></h2><p class=\"bb_paragraph\" >\u8d85\u7ea7\u5206\u8eab\u7d27\u5bc6\u8ddf\u968f\u4eba\u7269\u5c5e\u6027\ud83d\udcca\uff0c\u4e3a\u5237\u602a\u63d0\u4f9b\u5f3a\u5927\u52a9\u529b\ud83d\udcaa\uff0c\u8ba9\u4f60\u5237\u602a\u65e0\u538b\u529b\u3002\u6700\u591a\u53ef\u53ec\u5524 20 \u4e2a\u5206\u8eab\ud83d\udc65\ud83d\udc65\ud83d\udc65\u2026\u2026\u60f3\u8c61\u4e00\u4e0b\u4f17\u591a\u5206\u8eab\u4e0e\u4f60\u5e76\u80a9\u4f5c\u6218\u7684\u58ee\u89c2\u573a\u666f\ud83e\udd29\uff0c\u6218\u6597\u529b\u77ac\u95f4\u7206\u8868\uff01</p><h2 class=\"bb_tag\" ><strong>\u968f\u673a\u89e6\u53d1\u8d85\u5f3a\u6548\u679c\ud83d\udca5</strong></h2><p class=\"bb_paragraph\" >\u5728\u6218\u6597\u4e2d\uff0c\u968f\u673a\u89e6\u53d1\u65e0\u9650\u5200\u901f +999% \u7684\u9707\u64bc\u6548\u679c\ud83d\ude31\uff0c\u77ac\u95f4\u63d0\u5347\u8f93\u51fa\u80fd\u529b\uff0c\u8ba9\u654c\u4eba\u6beb\u65e0\u62db\u67b6\u4e4b\u529b\ud83e\udd4a\uff0c\u4f53\u9a8c\u6781\u81f4\u6218\u6597\u5feb\u611f\ud83c\udf89\u3002</p><h2 class=\"bb_tag\" ><strong>\u8be6\u7ec6\u73a9\u6cd5\u6307\u5357\ud83e\udded</strong></h2><h2 class=\"bb_tag\" ><strong>\u65b0\u4eba\u798f\u5229\ud83c\udf81</strong></h2><p class=\"bb_paragraph\" >\u65b0\u4eba\u4e0a\u7ebf\u5373\u53ef\u83b7\u5f97\u91d1\u5361\u73a9\u5bb6\u79f0\u53f7\ud83c\udfc6\uff0c\u8fd9\u4e00\u79f0\u53f7\u4e0d\u4ec5\u662f\u8eab\u4efd\u7684\u8c61\u5f81\ud83d\udc51\uff0c\u66f4\u662f\u798f\u5229\u7684\u94a5\u5319\ud83d\udd11\u3002\u52a0\u5165\u6e38\u620f\u7fa4\uff08413822706\uff09\ud83d\udc65 \u6216\u8005\u7ed9\u4e88\u6e38\u620f\u597d\u8bc4\ud83d\udc4d\uff0c\u5373\u53ef\u83b7\u5f97\u9996\u5145\u5956\u52b1\u4ee5\u53ca\u8d85\u591a\u4e13\u5c5e\u798f\u5229\ud83c\udf81\u3002\u5200\u5200\u7eff\u6bd2\u7684\u6301\u7eed\u4f24\u5bb3\ud83d\udc80\u4e0e\u8d85\u7ea7\u5207\u5272\u7684\u9ad8\u989d\u7206\u53d1\ud83d\udca5\uff0c\u8ba9\u4f60\u5728\u65b0\u624b\u671f\u5c31\u80fd\u8f7b\u677e\u5e94\u5bf9\u5404\u79cd\u602a\u7269\ud83d\udc7e\uff0c\u5feb\u901f\u6210\u957f\ud83d\udcc8\u3002</p><h2 class=\"bb_tag\" ><strong>\u4e3b\u7ebf\u4efb\u52a1\u4e0e\u6210\u957f\ud83c\udf31</strong></h2><p class=\"bb_paragraph\" >\u8ddf\u968f\u4e3b\u7ebf\u4efb\u52a1\u5237\u602a\ud83d\udc7e\uff0c\u662f\u63d0\u5347\u5b9e\u529b\u7684\u5fc5\u7ecf\u4e4b\u8def\ud83d\udee3\ufe0f\u3002\u5728\u5237\u602a\u8fc7\u7a0b\u4e2d\uff0c\u4e0d\u4ec5\u80fd\u63d0\u5347\u79f0\u53f7\ud83c\udfc6\u3001\u8f6c\u751f\ud83d\udd04\u548c\u7b49\u7ea7\ud83d\udcc8\uff0c\u8fd8\u80fd\u83b7\u5f97\u5927\u91cf\u5207\u5272\u5c5e\u6027\ud83d\udca5\u3002\u5207\u5272\u5c5e\u6027\u7684\u63d0\u5347\uff0c\u8ba9\u6253\u602a\u6548\u7387\u98d9\u5347\ud83d\ude80\uff0c\u602a\u7269\u5728\u4f60\u9762\u524d\u5982\u540c\u5f85\u5bb0\u7f94\u7f8a\ud83d\udc11\uff0c\u8f7b\u677e\u5b9e\u73b0\u5feb\u901f\u5347\u7ea7\u548c\u8d44\u6e90\u79ef\u7d2f\ud83d\udcb0\u3002</p><h2 class=\"bb_tag\" ><strong>\u4e00\u5927\u9646\u5267\u60c5\u4e0e\u5206\u8eab\u83b7\u53d6\ud83c\udfac</strong></h2><p class=\"bb_paragraph\" >\u8ba4\u771f\u5b8c\u6210\u4e00\u5927\u9646\u7684\u6240\u6709\u4e3b\u7ebf\u5267\u60c5\u4efb\u52a1\ud83d\udcdc\uff0c\u4f60\u5c06\u83b7\u5f97\u672c\u670d\u8d85\u7ea7\u5206\u8eab\ud83d\udc65\u3002\u8fd9\u4e2a\u5206\u8eab\u5c06\u6210\u4e3a\u4f60\u5192\u9669\u9014\u4e2d\u7684\u5f97\u529b\u52a9\u624b\ud83e\udd1d\u3002\u8fdb\u5165\u4e8c\u5927\u9646\u540e\uff0c\u53ef\u5bf9\u5206\u8eab\u8fdb\u884c\u5347\u7ea7\ud83d\udcc8\u548c\u878d\u5408\ud83d\udd04\u64cd\u4f5c\u3002\u5206\u8eab\u5347\u7ea7\u80fd\u589e\u5f3a\u5176\u81ea\u8eab\u5b9e\u529b\ud83d\udcaa\uff0c\u5206\u8eab\u878d\u5408\u5219\u53ef\u8fdb\u4e00\u6b65\u63d0\u5347\u4eba\u7269\u4f24\u5bb3\u548c\u5206\u8eab\u4f24\u5bb3\ud83d\udca5\uff0c\u8ba9\u4f60\u7684\u6218\u6597\u529b\u5b9e\u73b0\u8d28\u7684\u98de\u8dc3\ud83d\ude80\u3002</p><h2 class=\"bb_tag\" ><strong>\u5929\u5173\u6311\u6218\u4e0e\u798f\u5229\u83b7\u53d6\ud83c\udf81</strong></h2><p class=\"bb_paragraph\" >\u5f53\u4f60\u6709\u4e86\u4e00\u5b9a\u7684\u88c5\u5907\u57fa\u7840\u540e\ud83d\udc8e\uff0c\u571f\u57ce\u7684\u5929\u5173\u6311\u6218\u5c06\u6210\u4e3a\u4f60\u8bc1\u660e\u81ea\u5df1\u7684\u821e\u53f0\ud83c\udfad\u3002\u5728\u8fd9\u91cc\uff0c\u4f60\u5c06\u9762\u5bf9\u5404\u79cd\u5f3a\u5927\u7684\u654c\u4eba\ud83d\udc7f\uff0c\u4f46\u9996\u6740\u5956\u52b1\u4e5f\u6781\u4e3a\u4e30\u539a\ud83c\udf81\uff0c\u4f1a\u8d60\u9001\u8d85\u591a\u798f\u5229\uff0c\u52a9\u4f60\u5728\u6e38\u620f\u4e2d\u66f4\u4e0a\u4e00\u5c42\u697c\ud83e\uddd7\u200d\u2642\ufe0f\u3002</p><h2 class=\"bb_tag\" ><strong>\u514d\u8d39\u4f1a\u5458\u4e0e\u8d5e\u52a9\u4f53\u7cfb\ud83c\udd93</strong></h2><p class=\"bb_paragraph\" >\u672c\u670d\u4f1a\u5458\u3001\u8d5e\u52a9\u3001\u7d2f\u5145\u5168\u90e8\u514d\u8d39\uff01\ud83d\udc4f\u65e0\u9700\u82b1\u8d39\u4e00\u5206\u94b1\ud83d\udcb0\uff0c\u53ea\u9700\u6295\u5165\u65f6\u95f4\u548c\u7cbe\u529b\u23f3\uff0c\u901a\u8fc7\u6253\u602a\ud83d\udc7e\u3001\u5b8c\u6210\u5267\u60c5\u4efb\u52a1\ud83d\udcdc\u3001\u56de\u6536\u5b9e\u7269\ud83d\udce6\u7b49\u65b9\u5f0f\uff0c\u5c31\u80fd\u8f7b\u677e\u83b7\u5f97\u8fd9\u4e9b\u539f\u672c\u9700\u8981\u4ed8\u8d39\u624d\u80fd\u4eab\u53d7\u7684\u7279\u6743\ud83c\udf81\u3002\u771f\u6b63\u505a\u5230\u4e0d\u5145\u4e00\u5206\u94b1\u73a9\u901a\u5173\uff0c\u8ba9\u6bcf\u4e00\u4f4d\u73a9\u5bb6\u90fd\u80fd\u516c\u5e73\u7ade\u6280\ud83e\udd4a\uff0c\u4eab\u53d7\u6e38\u620f\u7684\u4e50\u8da3\ud83c\udf89\u3002</p><p class=\"bb_paragraph\" >\u300a\u6c99\u57ce\u9738\u4e3b\u300b\u4ee5\u5176\u4e30\u5bcc\u7684\u73a9\u6cd5\u3001\u516c\u5e73\u7684\u73af\u5883\u548c\u8d34\u5fc3\u7684\u798f\u5229\uff0c\u4e3a\u73a9\u5bb6\u6253\u9020\u4e86\u4e00\u4e2a\u5145\u6ee1\u6fc0\u60c5\u4e0e\u6311\u6218\u7684\u4f20\u5947\u4e16\u754c\ud83c\udf0f\u3002\u5feb\u6765\u52a0\u5165\u6211\u4eec\uff0c\u4e00\u8d77\u4e66\u5199\u5c5e\u4e8e\u81ea\u5df1\u7684\u4f20\u5947\u7bc7\u7ae0\ud83d\udcd6\uff01</p>",
    "short_description": "\u300a\u6c99\u57ce\u9738\u4e3b\u300b\u79c9\u6301\u201c\u4e0d\u809d\u4e0d\u6c2a\u201d\u7684\u7406\u5ff5\uff0c\u4e3a\u73a9\u5bb6\u51c6\u5907\u4e86\u4e30\u539a\u7684\u798f\u5229\u3002\u4e0a\u7ebf\u5373\u9001\u81ea\u52a8\u56de\u6536\u3001\u81ea\u52a8\u62fe\u53d6\u3001\u81ea\u52a8\u7ecf\u9a8c\u548c\u81ea\u52a8\u8d27\u5e01\u56db\u5927\u8d34\u5fc3\u798f\u5229\uff0c\u8ba9\u4f60\u544a\u522b\u7e41\u7410\u64cd\u4f5c\uff0c\u8f7b\u677e\u5f00\u542f\u6e38\u620f\u4e4b\u65c5\u3002\u65b0\u4eba\u4e0a\u7ebf\u8fd8\u53ef\u83b7\u5f97\u91d1\u5361\u73a9\u5bb6\u79f0\u53f7\uff0c\u901a\u8fc7\u5165\u7fa4\u6216\u597d\u8bc4\u80fd\u83b7\u5f97\u9996\u5145\u548c\u8d85\u591a\u4e13\u5c5e\u798f\u5229\uff0c\u5200\u5200\u7eff\u6bd2\u548c\u8d85\u7ea7\u5207\u5272\u8ba9\u4f60\u5728\u65b0\u624b\u671f\u5c31\u80fd\u5feb\u901f\u6210\u957f\u3002\u800c\u4e14\uff0c\u672c\u670d\u4f1a\u5458\u3001\u8d5e\u52a9\u3001\u7d2f\u5145\u5168\u90e8\u514d\u8d39\uff0c\u53ea\u9700\u82b1\u4e9b\u65f6\u95f4\u6253\u602a\u3001\u505a\u5267\u60c5\u3001\u56de\u6536\u5b9e\u7269\uff0c\u5c31\u80fd\u4e0d\u5145\u4e00\u5206\u94b1\u73a9\u901a\u5173\uff0c\u771f\u6b63\u505a\u5230\u4e86\u516c\u5e73\u516c\u6b63\uff0c\u8ba9\u6bcf\u4e00\u4f4d\u73a9\u5bb6\u90fd\u80fd\u5c3d\u60c5\u4eab\u53d7\u6e38\u620f\u7684\u4e50\u8da3\u3002",
