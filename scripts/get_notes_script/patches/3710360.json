        {
            "title": "Two new languages have been added, the AI has been updated, and the notes have b",
            "date": "2025-07-16 08:11:54",
            "url": "https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1805431065301950",
            "notes": "Two new languages have been added, the AI has been updated, and the notes have been refreshed."
        },
        {
            "title": "\"Language Plugin (Chinese, English), Note and AI Update",
            "date": "2025-07-16 07:48:17",
            "url": "https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1805431065301464",
            "notes": "Two new languages have been added: English and Chinese. The AI has been enhanced, and the notes have been updated."
        },
        {
            "title": "map and mechanics update",
            "date": "2025-07-14 04:13:19",
            "url": "https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1805065414325656",
            "notes": ".The game has been optimized, the fog in level 2 has been removed, dysfunctional rooms have been locked to simplify the game, and the enemy character has been updated, and the level 1 map has been enriched.\n"
        },
        {
            "title": "Map and narrative update",
            "date": "2025-07-13 06:07:20",
            "url": "https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1805065414296546",
            "notes": "\"Level 1 has been updated with more details. Empty and plain areas have been enhanced with new visuals, and the map is now displayed larger. Images supporting the game’s story have been added, and you can now also see these visuals within the game.\""
        },
        {
            "title": "level 1 rewizyon",
            "date": "2025-07-11 04:57:57",
            "url": "https://steamstore-a.akamaihd.net/news/externalpost/steam_community_announcements/1804977324442004",
            "notes": "\n\nThe map has been simplified.\n\nTwo non-functional rooms that caused confusion have been locked.\n\nItem locations have been moved to more visible spots.\n\nAudio and visual assets have been added."
        }
    ]
